Header
  + name := Swap_me
/*It is possible to assign several variables at once.
It is also possible for a function to return multiple results.


  */
  
Public
  
  - main <-
  ( + swap,me:String
    swap := "swap"
    me := "me"  
    (swap,me) := (me,swap)
    Out # swap # ' ' # me # '\n'
    (swap,me) := ("swap","me")
    Out # swap # ' ' # me # '\n'
  )
