Header
  + name := Pair_impair
/*
  Exemple de récursivité croisée
  */

Public
  
  - pair n:ℤ :Boolean <-
  ( + result:Boolean
    if (n = 0) then {
      result := True
    } else {
      result := impair(n - 1)
    }
    result
  )
  
  - impair n:ℤ :Boolean <-
  ( + result:Boolean
    if (n = 0) then {
      result := False
    } else {
      result := pair(n - 1)
    }
    result
  )
  
  - main <-
  ( + n:ℤ;  
    if (Command_args upper != 1) then {
      Out # "usage: " # Command_args.at 0 # " <n>" # '\n'
      System exit 1
    }
    n := Command_args at 1 .to_int
    Out # "pair(" # n # ")=" # (pair(n)) # '\n';
  );
  
