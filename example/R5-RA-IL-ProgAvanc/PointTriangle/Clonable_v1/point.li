Header
  + name := Point
Insert
  
  - parent_print:Print := Print
  
  - parent_clone:Clone := Clone
  
Public
  
  + x:Int
  
  + y:Int
  
  - set_x vx:Int <-
  (
    x := vx
  )
  
  - append_in b:String_buffer <-
  (
    "x=".append_in b ; x.append_in b ; ' '.append_in b
    "y=".append_in b ; y.append_in b 
  )
  
  - new:Self <- clone
  
  