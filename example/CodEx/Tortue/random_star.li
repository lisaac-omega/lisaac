Header
  + name := Random_star
/*
  Niveau 5 - Le hasard : étoiles aléatoires.

  @random.min @a max @b donne un entier au hasard entre @a et @b. On s'en
  sert pour le nombre d'étoiles, leur nombre de branches, leur taille,
  leur couleur (couleur_aupif) et leur position.

  Le calcul (random.min 1 max 10) est entre parenthèses : c'est à ce
  résultat que l'on envoie le message times.

  La méthode dessin est rappelée à chaque fois que la fenêtre doit être
  réaffichée : redimensionnez la fenêtre, le ciel change !
*/
Inherit

  + parent_tortue:Flat Tortue

Public

  - étoile nb_branches:Int taille l:Int <-
  (
    nb_branches.times {
      avance l ; recule l
      tourne (360 / nb_branches)
    }
  )

  - dessin <-
  (
    titre "Étoiles Aléatoires" départ (500, 500) taille (800, 800)
    fond black crayon (1, white)
    (random.min 1 max 10).times {
      épaisseur_trait (random.min 1 max 3)
      couleur_trait couleur_aupif
      étoile (random.min 4 max 14) taille (random.min 10 max 200)
      tourne (random.min 0 max 360)
      lève_crayon
      téléportation ((random.min 200 max 600).to_real32, (random.min 200 max 600).to_real32)
      baisse_crayon
    }
  )
