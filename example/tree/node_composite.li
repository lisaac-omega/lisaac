Header
  + name := Node_composite
/*
  The composite tree node.
  */
Inherit

  + parent_node:Flat Node

Public

  + children:Linked_list Node

  - add n:Node <-
  (
    children.add_last n
  )

  //
  // Creation.
  //

  - make lab:String <-
  (
    parent_node.make lab
    children := new Linked_list Node
  )

  //
  // Display.
  //

  - print <-
  (
    parent_node.print
    (children.is_empty).if_false {
      indent.append "  "
      (children.lower).to (children.upper) do { j:Int
        children.at j.print
      }
      indent.remove_tail 2
    }
  )
