Header
  + name := Node
/*
  The first program.
  */
Inherit

  - parent_clone:Clone := Clone

Public

  + label:String

  //
  // Creation.
  //

  - create lab:String :Self <-
  ( + result:Self
    result := clone
    result.make lab
    result
  )

  - make lab:String <-
  (
    label := lab
  )

  //
  // Display.
  //

  - print <-
  (
    indent.print
    label.print
    '\n'.print
  )

Private

  - indent:String_buffer := String_buffer.create 250
