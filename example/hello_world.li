Header
  + name := Hello_world
/*
  The basic and traditional "Hello World" program in Lisaac Ω. 
  
  To run this example in a terminal window:

  Step 1:
       cd lisaac/example

  Step 2:
       lisaac hello_world.li

  Step 3:
      ./hello_world     
  
   Or one single step on bash:
      run=hello_world ; lisaac ${run} -boost -q && ./${run%.li}    */
Public
  
  - main <-
  (
    print("Hello world!\n")
  )
  
  