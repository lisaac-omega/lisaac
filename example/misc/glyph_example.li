Header
  + name := Glyph_example
/*
  Glyphs in Lisaac Ω: the code is written as text, elit shows it as
  mathematics. For example 4.pow 2 is shown as 4², 4.sqrt as √4,
  1.div 2 as a fraction, gor / gxor as ∨ / ⊕, and the .sum of loop as Σ.
  Units such as 400 cm are also glyphs.

  Open this example in elit and play with the code to see how the
  glyphs are edited. Experts may also browse lisaac/lib/glyph/.

  To compile, as usual in a terminal:
  $ lisaac glyph_example -q -boost
  $ ./glyph_example
  */
Public
  
  - self:Self tri l:Real32 height h:Real32 :Real32 <-
  (
    (l * h).div 2 
  )
  
  - main <-
  ( + r:Real32
    + b:Boolean
    + s, n:Int
    r := 4 .pow 2
    r := 4 .sqrt
    r := 1.div 2
    b := b.gor (b.gxor False)
    
    
    r := self.tri (400 cm) height (2 cm)
    
    n := 1
    s := 1 .sum (5) of {i:Int; n := n + i;   n}
    s.println;
  )
