Header
  + name := Glyph_example
/*
  This example show how to use glyph in your code.
  Play with this code to understand how to edit the glyphs.
  */
Public
  
  - self:Self tri l:Real32 height h:Real32 :Real32 <-
  (
    (l * h).div 2 
  )
  
  - main <-
  ( + r:Real32
    + b:Boolean
    + s, n:Int
    r := 4 .pow 2
    r := 4 .sqrt
    r := 1.div 2
    b := b.gor (b.gxor False)
    
    
    r := self.tri (400 cm) height (2 cm)
    
    n := 1
    s := 1 .sum (5) of {i:Int; n := n + i;   n}
    s.println;
  )
