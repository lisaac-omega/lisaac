Header
  + name := Deprecated_example
Insert
  
  - parent_utils:Utils := Utils
  
Public
  
  - m1 <-
  [
    ? { deprecated False msg "You got one year to use another method." }
  ]
  (
    deprecated False msg "What the hell are you still doing here ?"
  )
  
  - m2 <-
  [
    ? { deprecated True msg "You must now use another method." }
  ]
  (
  )
  
  - main <-
  (
    m1
    m2
    // Also note that FALSE deprecated can be there in -boost mode.
  )
  
