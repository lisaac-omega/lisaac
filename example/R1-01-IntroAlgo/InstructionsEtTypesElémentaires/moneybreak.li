Header
  + name := Moneybreak
/*
  Décomposer une somme d'argent.

  Une somme lue au clavier est décomposée en billets de 50 € et 10 €,
  puis en pièces de 2 € et 1 €.
  / donne le quotient de la division entière et % son reste.
  Le programme lit au clavier : il se lance dans un terminal.
  */
Insert
  
  - french: French_corner := French_corner
  
Public
  
  - main <-
  ( 
    // Lexique:
    + somme:Int // somme à décomposer
    + b50:Int // nombre de billets de 50€
    + b10:Int // nombre de billets de 10€
    + p2:Int // nombre de pièces de 2€
    + p1:Int // nombre de pièces de 1€
    
    écrire("Somme à décomposer:")
    somme := lire_entier
    
    // Division entière:
    b50 := somme / 50
    
    // Reste de la division:
    somme := somme % 50
    
    b10 := somme / 10
    somme := somme % 10
    p2 := somme / 2
    p1 := somme % 2
    écrire("Billets de 50€ :" + b50.to_string + "\n")
    écrire("Billets de 10€ :" + b10.to_string + "\n")
    écrire("Pièces de 2€ :" + p2.to_string + "\n")
    écrire("Pièces de 1€ :" + p1.to_string + "\n")
  )
 