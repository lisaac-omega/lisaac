Header
  + name := Telepherique
/*
  Poly exercice 5 page 2.
  */
Insert
  
  - french: French_corner := French_corner
  
Public
   
  - main <-
  ( + poids_total, poids:Int 
    + nom_skieur, dernier:String
    
    poids_total := 0
    nom_skieur := ""
    tant_que {poids_total <= 5000} faire {
      dernier := nom_skieur
      écrire("Nom: ")
      nom_skieur := lire_chaine
      écrire("Poids: ")
      poids := lire_entier
      poids_total := poids_total + poids
    }  
    écrire("Dernier entré: ") ; écrire(dernier) ; écrire("\n")
  )
