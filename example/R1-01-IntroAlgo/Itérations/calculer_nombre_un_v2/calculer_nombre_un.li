Header
  + name := Calculer_nombre_un
/*
  Poly exercice 5 page 2.
  */
Insert
  
  - french: French_corner := French_corner
  
Public
  
  - calculer_nombre_de_un n:Int : Int <-
  ( + q,nb1:Int
    
    q := n
    nb1 := 0
    while { q != 0 } do {
      nb1 := nb1 + (q % 2)
      q := q .div 2
    }
    nb1
  )
  
  - main <-
  ( + n:Int
    
    n := argument 1 entier
    // Version plus compacte pour écrire sur l'écran:
    Out # "nombre de un: " # (calculer_nombre_de_un n) # '\n'
  )
