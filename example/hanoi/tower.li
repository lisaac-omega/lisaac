Header
  + name := Tower
Inherit
  - parent_clone:Clone := Clone

Private

  + t:Array Int

  + top:Int

Public

  - full n:Int :Self <-
  ( + result:Self
    result := clone
    result.full_make n
    result
  )

  - full_make n:Int <-
  ( ? {n >= 1}
    t := Array(Int).create n
    (n-1).downto 0 do { i:Int
      t.at i put (n-i)
    }
    top := n-1

    ? {nb+1 = n}
    ? {top = nb}
    ? {t.at top = 1}
  )

  - empty n:Int :Self <-
  ( + result:Self
    result := clone
    result.empty_make n
    result
  )

  - empty_make n:Int <-
  ( ? {n >= 1}
    t := Array(Int).create n
    top := 0
    ? {nb+1 = n}
    ? {top = 0}
  )

Hanoi

  - nb:Int <- t.upper

  - show_a_discus d:Int <-
  ( + nb_of_free_slots, nb_of_used_slots:Int
    ? {d.in_range d to nb}
    nb_of_used_slots := t.at d
    nb_of_free_slots := nb+1 - nb_of_used_slots
    nb_of_free_slots.downto 1 do { i:Int
      ' '.print
    }
    nb_of_used_slots.downto 1 do { i:Int
      '='.print
    }
    '|'.print
    nb_of_used_slots.downto 1 do { i:Int
      '='.print
    }
    nb_of_free_slots.downto 1 do { i:Int
      ' '.print
    }
  )

  - remove_discus:Int <-
  ( + result:Int
    result := t.at top
    t.at top put 0
    (top > 0).if {
      top := top - 1
    }
    ? { top >= 0}
    result
  )

  - add_discus d:Int <-
  (
    (t.at top > d).if {
      top := top + 1
      t.at top put d
    }
    (t.at top = 0).if {
      t.at top put d
    }
    ? { top <= nb }
  )
