Header
  + name := Parse_expr
/*
  Parse arithmetic expression.
  */


Private

  // Service and terminal parsing.


  - index:Int
  - source:String

  - last_character:Char

  - read_character car:Char :Boolean <-
  ( + result:Boolean
    if ((index <= source.upper) && {car = source.at index}) then {
      last_character := car
      index  := index + 1
      result := True
    }
    result
  )

  - last_constant:Real32

  - read_constant:Boolean <-
  ( + result:Boolean
    + div:Real32
    if ((index <= source.upper) && {source.at index .is_digit}) then {
      result := True
      last_constant := 0
      do {
        last_constant := last_constant * 10 + source.at index.decimal_value
        index := index + 1
      } while {(index <= source.upper) && {source.at index.in_range '0' to '9'}}
      if (read_character '.') then {
        div := 1
        while {(index <= source.upper) && {source.at index.in_range '0' to '9'}} do {
          last_constant := last_constant * 10 + source.at index.decimal_value
          index := index + 1
          div := div * 10
        }
        last_constant := last_constant / div
      }
    }
    result
  )

  - error <-
  (
    if (error_message.is_empty) then {
      from 0 to (index.min (source.upper)) do { j:Int
        error_message.add_last (source.at j)
      }
      error_message.append "<- Error!"
    }
  )

  // Grammar parsing.


  - read_expr:Real32 <-
  // EXPR <- EXPR_MUL { ( '+' | '-') EXPR_MUL }
  ( + result,right:Real32
    + oper:Char
    result := read_expr_mul
    while {(read_character '+') || {read_character '-'}} do {
      oper  := last_character
      right := read_expr_mul
      if (oper = '+') then {
        result := result + right
      } else {
        result := result - right
      }
    }
    result
  )

  - read_expr_mul:Real32 <-
  // EXPR_MUL <- EXPR_UNARY { ( 'x' | '*' | '/') EXPR_UNARY }
  ( + result,right:Real32
    + oper:Char
    result := read_expr_unary
    while {(read_character 'x') || {read_character '/'} || {read_character '*'}} do {
      oper  := last_character
      right := read_expr_unary
      if (oper = '/') then {
        result := result / right
      } else {
        result := result * right
      }
    }
    result
  )

  - read_expr_unary:Real32 <-
  // EXPR_UNARY <- ( '+' | '-') EXPR_UNARY
  //             |  EXPR_CST
  ( + result:Real32
    + oper:Char
    if ((read_character '+') || {read_character '-'}) then {
      oper   := last_character
      result := read_expr_unary
      (oper = '-').if {
        result := - result
      }
    } else {
      result := read_expr_cst
    }
    result
  )

  - read_expr_cst:Real32 <-
  // EXPR_CST <- '(' EXPR ')'
  //           |  constant
  ( + result:Real32
    if (read_character '(') then {
      result := read_expr
      (read_character ')').if_false {
        error
      }
    }.elseif {read_constant} then {
      result := last_constant
    }
    result
  )

Public

  - error_message:String_buffer := String_buffer.create 50

  - parse src:String :Real32 <-
  ( + result:Real32

    source := src
    index  := source.lower
    error_message.clear
    result := read_expr
    if (index <= source.upper) then { error; }
    result
  )
