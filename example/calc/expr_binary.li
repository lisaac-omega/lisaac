Header
  + name := Expr_binary
/*
  Binary Expression.
  */
Inherit

  + parent_expr:Flat Expr

Public

  + left:Expr

  + right:Expr

  //
  // Constructor
  //

  - create l:Expr and r:Expr :Self <-
  ( + result:Self

    result := clone
    result.make l and r
    result
  )

  - make l:Expr and r:Expr <-
  (
    left  := l
    right := r
  )
