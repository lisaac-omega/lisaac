Header
  + name := Calc
/*
  Calc application.
  */


Public

  - main <-
  ( + e:Expr
    + result:Int
    (Command_args.count != 2).if {
      "Usage :\n  ".print
      Command_args.at 0.print
      " <Arithmetic expression>\n\
      \Example :\n  ".print
      Command_args.at 0.print
      " \"(1-2)+(3+2*-5)\"\n".print
    } else {      
      e := Parse_expr.parse (Command_args.at 1)
      result := e.value
      "Result : ".print
      result.print
      '\n'.print
    }
  )
