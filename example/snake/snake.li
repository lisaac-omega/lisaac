Header
  + name := Snake
/*
  The classic Snake game in Lisaac Ω.
  The snake grows each time it eats and also moves faster.  

  To compile, as usual in a terminal:  
  $ lisaac snake -q -boost  
  $ ./snake  
  
  It can also be compiled and executed via elix menus.  
  
  Originally written in October 2025 by Benjamin Scheffer and Marcelin Ray 
  */
Inherit 
  
  + parent_game:Flat Game

Private
  
  // Data
  
  - grid_w:Int := 20
  - grid_h:Int := 15
  - cell_size:Int := 28
    
  - apple_x:Int := 12
  - apple_y:Int := 8

  - dir_x:Int := 1
  - dir_y:Int := 0
  
  - snake_x:Flat Array Int
  - snake_y:Flat Array Int
  
  - timer:Uint64
  
  // Services
  
  - draw_cell (x,y:Int) color col:Color <-
  (
    begin_path
    rect (x * cell_size,y * cell_size) size (cell_size-1,cell_size-1)
    fill_color col
    fill
  )

  - collision (x,y:Int) :Boolean <-
  ( + i:Int
    + result:Boolean
    while {(i <= snake_x.upper) && {! result}} do {
      result := (x,y) = (snake_x.at i,snake_y.at i)
      i := i + 1
    }
    result
  )
  
Public
  
  - main <-
  ( 
    Random.init_clock
    init "Snake Game" size (grid_w * cell_size, grid_h * cell_size + cell_size)
    from 0 to 2 do { i: Int
      snake_x.add_last (4 + i)
      snake_y.add_last 8
    }        
    Paper.run
  )
  
  - motion <-
  ( + x,y:Int
    + t:Uint64
    t := Time.gettimeofday
    (t > timer).if {
      (x,y) := (snake_x.last,snake_y.last)
      // Move Snake
      (x,y) := ((x + dir_x) % grid_w, (y + dir_y) % grid_h)
      (x < 0).if { x := grid_w - 1 }
      (y < 0).if { y := grid_h - 1 }      
      if (collision (x,y)) then {
        Out # "Game Over!\nScore: " # snake_x.count # '\n'; System.exit 0
      }
      // Check if the snake eats the apple
      if ((x,y) = (apple_x,apple_y)) then {        
        do {
          apple_x := Random.max (grid_w-1)
          apple_y := Random.max (grid_h-1)
        } while {collision (apple_x,apple_y)}
      } else {
        snake_x.remove_first; snake_y.remove_first
      }
      snake_x.add_last x; snake_y.add_last y      
      timer := t + (2_000_000 / snake_x.count).max 700      
    }
  )
  
  - draw <-
  ( + x,y:Int    
    font_size (cell_size - 4)
    font_face_id (Font sys (Font bold))
    text_align (align_middle | align_center)
    // Draw the grid
    from 0 to (grid_h-1) do { py:Int
      from 0 to (grid_w-1) do { px:Int
        draw_cell (px,py) color ((px+py).is_odd.ok (Color.rgb(240,240,240)) else {Color.rgb(200,200,200)}) 
      }
    }  
    (x,y) := (snake_x.last,snake_y.last)    
    // Display Snake
    from 0 to (snake_y.upper-1) do { i:Int
      draw_cell (snake_x.at i, snake_y.at i) color (Color.rgb(0,100,0))
    }      
    draw_cell (x,y) color (Color.rgb(0,200,0))      
    fill_color (Color.black) ; text (x * cell_size + cell_size/2, y * cell_size + cell_size/2) msg "Ω" 
    // Display Apple
    draw_cell (apple_x,apple_y) color (Color.rgb(255,0,0)) 
    // Display Score
    String.tmp { score_text:String_buffer
      score_text # "Score: " # snake_x.count # " Ω"      
      fill_color (Color.white)       
      text (grid_w * cell_size / 2, grid_h * cell_size + cell_size/2) msg score_text
    }
  )
    
  - key s:String cmd c:Uint8 :Boolean <-
  (
    (s.first)
    .when 'z' or 'U' then { (dir_x, dir_y) := ( 0 ,-1) }
    .when 's' or 'D' then { (dir_x, dir_y) := ( 0 , 1) }
    .when 'q' or 'L' then { (dir_x, dir_y) := (-1 , 0) }
    .when 'd' or 'R' then { (dir_x, dir_y) := ( 1 , 0) }
    True
  )
  