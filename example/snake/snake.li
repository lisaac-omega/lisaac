Header
  + name := SNAKE;
  /*
   Made by Benjamin Scheffer and Marcelin Ray 
   October 2025
  */
  
Inherit 
  + parent_window:Expanded WINDOW
  
Private
  - grid_width:INTEGER := 20
  - grid_height:INTEGER := 15
  - cell_size:INTEGER := 25
  - score_height:INTEGER := 40 
  
  + head_x:INTEGER := 5
  + head_y:INTEGER := 7
  
  + apple_x:INTEGER := RANDOM.max (grid_width - 1)
  + apple_y:INTEGER := RANDOM.max (grid_height - 1)

  + dir_x:INTEGER := 1
  + dir_y:INTEGER := 0
  
  // BUG elix, Mettre le curseur ici, ensuite Ctrl-a  Ctrl-p Ctrl-a Ctrl-k Ctrl-k
  + snake_x:ARRAY INTEGER
  + snake_y:ARRAY INTEGER

Public

  - main <-
  ( + i:INTEGER 
    RANDOM.init_clock
    init "Snake Game" size (grid_width * cell_size, (grid_height * cell_size) + score_height)
    
    snake_x := new ARRAY INTEGER capacity 16
    snake_y := new ARRAY INTEGER capacity 16
    until {snake_y.count = 3} do {
      snake_x.add_last (head_x - i - 1)
      snake_y.add_last head_y
    }
        
    PAPER.run
  )
  
  - draw_cell (x,y:INTEGER) color col:COLOR <-
  ( + x0, y0:INTEGER
    x0 := x * cell_size
    y0 := (y * cell_size) + score_height
    begin_path
    rect (x0,y0) size (cell_size-1,cell_size-1)
    fill_color col
    fill
  )

  - draw_score <-
  (
    STRING.tmp { score_text:STRING_BUFFER
      score_text.append "Score: "
      score.append_in score_text
      font_size 24
      font_face_id (FONT sys (FONT bold))
      fill_color (COLOR.white) 
      text (20, 30) msg score_text
    }
  )

  - move_snake <-
  ( + i:INTEGER
    + old_x, old_y:INTEGER
    
    // Save the old head position
    old_x := head_x
    old_y := head_y
    
    // Move the head according to the direction
    head_x := head_x + dir_x
    head_y := head_y + dir_y

    // Edge management (crossing over)
    if ((head_x >= grid_width)&& {dir_x = 1}) then { 
      head_x := 0
    }.elseif {(head_x <= -1) && {dir_x = -1}} then { 
      head_x := grid_width-1
    }.elseif {(head_y >= grid_height) && {dir_y = 1}} then { 
      head_y := 0
    }.elseif {(head_y <= -1) && {dir_y = -1}} then { 
      head_y := grid_height - 1
    }

    // Move the body (each segment takes the position of the previous one):
    i := snake_x.upper
    while {i > 0} do {
      snake_x.at i put (snake_x.at (i-1))
      snake_y.at i put (snake_y.at (i-1))
      i := i - 1
    }
    
    // The first body segment takes the old head position
    snake_x.at 0 put old_x
    snake_y.at 0 put old_y
  )

  - self_collision:BOOLEAN <-
  ( + i:INTEGER
    + result:BOOLEAN
    while {(i <= snake_x.upper) && {! result}} do {
      result := (snake_x.at i = head_x) && {snake_y.at i = head_y}
      i := i + 1
    }
    result
  )
  
  
  - draw <-
  ( + t:REAL_32

    // Sleep to limit the frame rate
    CLOCK.usleep 200000
    
    t := CLOCK.seconds
    
    // Draw the grid
    from 0 to (grid_height-1) do { y:INTEGER
      from 0 to (grid_width-1) do { x:INTEGER
        if (((x+y) % 2) = 0) then {
          draw_cell (x,y) color (COLOR.rgb(240,240,240)) // Light Grey
        } else {
          draw_cell (x,y) color (COLOR.rgb(200,200,200)) // Dark Grey
        }
      }
    }
    move_snake
    if (self_collision) then {
      OUT # "Game Over!\nScore: " # score # "\n"
      SYSTEM.exit 0
    }
    
    // Draw the body of the snake:
    from 0 to (snake_y.upper) do { i:INTEGER
      draw_cell (snake_x.at i, snake_y.at i) color (COLOR.rgb(0,100,0))
    }
    
    // Draw the head of the snake (lighter than the body):
    draw_cell (head_x,head_y) color (COLOR.rgb(0,200,0))
    
    draw_apple
    draw_score

    PAPER.refresh_again
  )
  
  - draw_apple <-
  (
    draw_cell (apple_x,apple_y) color (COLOR.rgb(255,0,0))
   
    // Check if the snake eats the apple
    if ((head_x = apple_x) && {head_y = apple_y}) then {
      grow_snake
      do {
        apple_x := RANDOM.max (grid_width-1)
        apple_y := RANDOM.max (grid_height-1)
      } while { apple_on_snake }
    }
  )

  - apple_on_snake:BOOLEAN <-
  ( + result:BOOLEAN
    + i:INTEGER
    result := FALSE
    i := 0
    while {(i <= (snake_x.upper)) && {!result}} do {
      result := (snake_x.at i = apple_x) && {snake_y.at i = apple_y}
      i := i + 1
    }
    result
  )

Private
  - score:INTEGER <- snake_x.count
  
  - grow_snake <-
  (
    snake_x.add_last (snake_x.last)
    snake_y.add_last (snake_y.last)
  )
  
  - go_up    <- ( (dir_x, dir_y) := ( 0 ,-1) )
  - go_down  <- ( (dir_x, dir_y) := ( 0 , 1) ) 
  - go_left  <- ( (dir_x, dir_y) := (-1 , 0) )
  - go_right <- ( (dir_x, dir_y) := ( 1 , 0) )
  
Public
  
  - key s:STRING cmd c:UINTEGER_8 <-
  (
    (s.first)
    .when 'z' then { go_up }
    .when 's' then { go_down }
    .when 'q' then { go_left }
    .when 'd' then { go_right }
    .when 'U' then { go_up }
    .when 'D' then { go_down }
    .when 'L' then { go_left } 
    .when 'R' then { go_right }
  )