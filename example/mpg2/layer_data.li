Header
  + name := Layer_data
/*
  layer specific variables (needed for SNR and DP scalability).
  */
Inherit
  
  - parent_any_mpg2:Any_mpg2 := Any_mpg2
  
Private
  
  //
  // BitStream manager.
  //
  
  - buffer:Array(Uint8)
  - pos:Int
  - max:Int
    
  - cache:Int
  - n_cache:Int
    
Public

  //
  // Data.
  //  
  
  // bit input 
  - infile:Pointer
     
  // sequence header and quant_matrix_extension() 
  - intra_quantizer_matrix:C_array(Int)
  - non_intra_quantizer_matrix:C_array(Int)
  - chroma_intra_quantizer_matrix:C_array(Int)
  - chroma_non_intra_quantizer_matrix:C_array(Int)
  
  - mpeg2_flag:Boolean
  - set_mpeg2_flag b:Boolean <-
  (
    mpeg2_flag := b
  )
  
  // sequence scalable extension 
  - scalable_mode:Int
  - set_scalable_mode m:Int <-
  (
    scalable_mode := m
  )
  
  // picture coding extension 
  - q_scale_type:Boolean
  - set_q_scale_type n:Boolean <-
  (
    q_scale_type := n
  )
  
  - alternate_scan:Int
  - set_alternate_scan n:Int <-
  (
    alternate_scan := n
  )
  
  // picture spatial scalable extension 
  - pict_scal:Boolean
  - set_pict_scal b:Boolean <-
  (
    pict_scal := b
  )
  
  // slice/macroblock 
  - priority_breakpoint:Int
  - set_priority_breakpoint n:Int <- // BSBS: GETHDR only
  (
    priority_breakpoint := n
  )
  
  - quantizer_scale:Int
  - set_quantizer_scale n:Int <-
  (
    quantizer_scale := n
  )
    
  - block:C_array(C_array(Int16)); // [12][64]
  
Public
  
  //
  // Creation.
  //
  
  - make name:String <-
  ( + code:Int
        
    // Open file.        
    (infile != NULL).if {
      File_utils.close infile
    }
    infile := File_utils.open_read name
    
    (infile = NULL).if {
      error_text.copy "Base layer input file "
      error_text.append name
      error_text.append " not found\n"
      error error_text
    }
            
    // initialize_buffer.
    (buffer = NULL).if {
      buffer := Array(Uint8).create 2048
    }
    system_stream_flag := False
    pos := max := 2048
    n_cache := cache := 0
    
    // Check format.    
    flush_buffer 0; // fills valid data into bfr 
    (show_bits 8 = 47h).if {
      error "Decoder currently does not parse transport streams\n"
    }
    next_start_code
    code := show_bits 32
    ((code = pack_start_code) || {code = video_elementary_stream}).if {
      system_stream_flag := True
    } else {
      (code != sequence_header_code).if { 
        error "Unable to recognize stream type\n"
      }
    }
    // Reset.
    File_utils.seek infile at 0
    pos := max := 2048
    n_cache := cache := 0
    flush_buffer 0
    
    // Init Structure.
    (block = NULL).if {
      intra_quantizer_matrix            := C_array(Int).create 64
      non_intra_quantizer_matrix        := C_array(Int).create 64
      chroma_intra_quantizer_matrix     := C_array(Int).create 64
      chroma_non_intra_quantizer_matrix := C_array(Int).create 64
    
      block := C_array(C_array(Int16)).create 12
      0.to 11 do { j:Int
        block.at j put (C_array(Int16).calloc_intern 64)
      }
    }
  )
    
  //
  // BitStream manager.
  //
    
  - show_bits n:Int :Int <-
  // return next n bits (right adjusted) without advancing 
  (
    //(cache.to_raw_uinteger >> (32 - n)).to_int
    (cache.to_uint32 >> (32 - n)).to_int
  )
  
  - show_boolean:Boolean <- show_bits 1.to_boolean
  
  - flush_buffer n:Int <-
  // advance by n bits 
  (     
    cache   := cache << n
    n_cache := n_cache - n
    ? {n_cache >= 0}
    
    (n_cache <= 24).if {
      (system_stream_flag && {pos >= (max-4)}).if {
        {
          (pos >= max).if {
            next_packet
          }
          cache   := cache | (get_byte << (24 - n_cache))
          n_cache := n_cache + 8
        }.do_while {n_cache <= 24}
      } else {
        (pos < 2044).if {  
          {
            cache   := cache | (buffer.at pos.to_int << (24 - n_cache))
            pos     := pos + 1
            n_cache := n_cache + 8
          }.do_while {n_cache <= 24}
        } else {
          {
            (pos >= 2048).if {
              fill_buffer
            }
            cache   := cache | (buffer.at pos.to_int << (24 - n_cache))
            pos     := pos + 1
            n_cache := n_cache + 8
          }.do_while {n_cache <= 24}
        }
      }
    }
  )

  - get_bits n:Int :Int <-
  // return next n bits (right adjusted) 
  ( + val:Int
    
    val := show_bits n
    flush_buffer n
    
    val
  )
  
  - get_boolean:Boolean <- get_bits 1.to_boolean
  
  - flush_buffer32 <-
  (     
    cache := 0
    
    n_cache := n_cache - 32
    
    (system_stream_flag && {pos >= (max-4)}).if {
      {n_cache <= 24}.while_do {
        (pos >= max).if {
          next_packet
        }
        cache   := cache | (get_byte << (24 - n_cache))
        n_cache := n_cache + 8
      }
    } else {
      {n_cache <= 24}.while_do {
        (pos >= 2048).if {
          fill_buffer
        }
        cache   := cache | (buffer.at pos.to_int << (24 - n_cache))
        pos     := pos + 1
        n_cache := n_cache + 8
      }
    }
  )

  - get_bits32:Int <-
  ( + l:Int

    l := show_bits 32
    flush_buffer32
    l
  )

  - next_start_code <-
  // align to start of next next_start_code 
  (
    // byte align 
    flush_buffer (n_cache & 7)
    
    {show_bits 24 != 1}.while_do {
      flush_buffer 8
    }
  )

Private
  
  - fill_buffer <-
  ( + buffer_level:Int
            
    buffer_level := read_buffer
    pos := 0
    
    (system_stream_flag).if {
      max := max - 2048
    }
    
    // end of the bitstream file 
    (buffer_level < 2048).if {
      pad_buffer buffer_level
    }
  )
  
  - pad_buffer level:Int <-
  // end of the bitstream file: complete @buffer with sequence end codes 
  ( + buffer_level:Int
    
    (infile = NULL).if_false {
      File_utils.close infile
      infile := NULL
    }
    // just to be safe 
    buffer_level := level.max 0
    
    // pad until the next to the next 32-bit word boundary 
    {(buffer_level & 3) != 0}.while_do {
      buffer.at buffer_level put 0
      buffer_level := buffer_level + 1
    }
    
    // pad the buffer with sequence end codes 
    {buffer_level < 2048}.while_do {
      buffer.at buffer_level put ((sequence_end_code >> 24).to_uint8)
      buffer_level := buffer_level + 1
      buffer.at buffer_level put (((sequence_end_code >> 16) & 0FFh).to_uint8)
      buffer_level := buffer_level + 1
      buffer.at buffer_level put (((sequence_end_code >> 8 ) & 0FFh).to_uint8)
      buffer_level := buffer_level + 1
      buffer.at buffer_level put ((sequence_end_code & 0FFh).to_uint8)
      buffer_level := buffer_level + 1
    }
  )
  
  - read_buffer:Int <-
  // The file can be already closed by @pad_buffer. 
  ( + result:Int
    
    (infile = NULL).if_false {
      result := File_utils.read_raw infile in (buffer.storage) size 2048
    }
    result
  )
  
  - get_byte:Int <-
  // MPEG-1 system layer demultiplexer 
  ( + result,buffer_level:Int
        
    {pos >= 2048}.while_do {      
      //buffer.clear
      buffer_level := read_buffer
      (buffer_level < 2048).if {
        pad_buffer buffer_level
      }
      pos := pos - 2048
      max := max - 2048
    }
    result := buffer.at pos
    pos    := pos + 1
    result
  )
  
  - get_word:Int <-
  // extract a 16-bit word from the bitstream buffer 
  ( + val:Int

    val := get_byte
    (val << 8) | get_byte
  )
  
  - next_packet <-
  // initialize buffer, call once before first getbits or showbits 
  // parse system layer, ignore everything we don't need 
  ( + code:Int
    + l:Int
    + is_read:Boolean
    + end:Boolean
    
    {
      code := get_long
      
      // remove system layer byte stuffing 
      // BSBS: @Int has 64 bits, keep only the last 4 bytes.
      {(code & 0FFFFFF00h) != 0100h}.while_do {
        code := ((code << 8) | get_byte) & 0FFFFFFFFh
      }
      
      is_read := False
      (code)
      .when pack_start_code then { // pack header 
        // skip pack header (system_clock_reference and mux_rate) 
        is_read := True
        ((get_byte >> 6) = 01h).if {
          // MPEG-2: 9 bytes, then pack_stuffing_length bytes
          pos := pos + 8
          l   := get_byte & 7
          pos := pos + l
        } else {
          pos := pos + 7
        }
      }
      .when video_elementary_stream then {   
        is_read := True
        code    := get_word;             // packet_length 
        max     := pos + code
        code    := get_byte
        
        ((code >> 6) = 02h).if {
          pos  := pos + 1
          code := get_byte;     // parse PES_header_data_length 
          pos  := pos + code;   // advance pointer by PES_header_data_length 
          //"MPEG-2 PES packet\n".print
          end := True
        } else {
          (code = 0FFh).if {
            // parse MPEG-1 packet header 
            {(code := get_byte) = 0FFh}.while_do { 
              // Nothing.
            }
          }
        }
        (end).if_false {
          // stuffing bytes 
          (code >= 040h).if {
            (code >= 080h).if {
              Stderr.put_string "Error in packet header\n"
              exit 1
            }
            // skip STD_buffer_scale 
            pos  := pos + 1
            code := get_byte
          }
          
          (code >= 030h).if {
            (code >= 040h).if {
              Stderr.put_string "Error in packet header\n"
              exit 1
            }
            // skip presentation and decoding time stamps 
            pos := pos + 9
          } else {
            (code >= 020h).if {
              // skip presentation time stamps 
              pos := pos + 4
            } else {
              (code != 00Fh).if {
                Stderr.put_string "Error in packet header\n"
                exit 1
              }
            }
          }
          end := True
        }
      }
      .when iso_end_code or sequence_end_code then { // end       
        // simulate a buffer full of sequence end codes 
        is_read := True
        l := 0
        {l < 2048}.while_do {
          buffer.at l put ((sequence_end_code >> 24).to_uint8)
          l := l + 1
          buffer.at l put (((sequence_end_code >> 16)&0FFh).to_uint8)
          l := l + 1
          buffer.at l put (((sequence_end_code >> 8)&0FFh).to_uint8)
          l := l + 1
          buffer.at l put ((sequence_end_code & 0FFh).to_uint8)
          l := l + 1
        }
        pos := 0
        max := 2048
        end := True
      }
      (is_read).if_false {
        (code >= system_start_code).if {
          // skip system headers and non-video packets
          code := get_word
          pos  := pos + code
        } else {
          Stderr.put_string "Unexpected startcode "
          Stderr.put_integer code
          Stderr.put_string " in system layer\n"
          exit 1
        }
      }
    }.do_until {end}
  )

  - get_long:Int <-
  ( + i:Int

    i := get_word
    (i << 16) | get_word
  )
