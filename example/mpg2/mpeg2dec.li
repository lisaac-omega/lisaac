Header
  + name := Mpeg2dec
/*
  main(), initialization, option processing.
  
  // C vs Lisaac difficulty:
  // =======================
  // - `goto' used.
  // - `return()' used in middle function.
  // - adress argument for multiple result => Lisaac V0.2
  // - Allocation array in the stack       => Lisaac V0.3 ?
  // - ptr2 = ptr + 10; (pointeur) => idx := 10; (pointeur + index)
  // - (short *)tab[2] = (int)2; => Pas de pb pour C ???!!!
  //
  // Blague : ld->Bfr |= *ld->Rdptr++ << (24 - Incnt);
  //
  // Blindé de `if' => permet pas d'avoir une vue d'ensemble.
  //
  // Parlé de la Classification Objet <-> C :
  // -> C Par theme.
  // -> Data + Function.
  
  */
Inherit
    
  + parent_window:Flat Window
  - parent_any_mpg2:Any_mpg2 := Any_mpg2

Public
  
  - main <-
  ( 
    // decode command line arguments 
    process_options
    
    open_stream
    (header_ready).if_false {
      error "No video sequence in this file\n"
    }
    
    (output_type = 0).if {
      load_sound
      init "netfLIx ;)" size ((vertical_size.to_real32 * display_ratio).to_int,vertical_size)
      //PAPER.set_animation 1
      Paper.run
    } else {
      {is_finished}.until_do {
        decode_picture
      }
    }
  )
  
Private

  - frames_width:Int
  - frames_height:Int
  
  - initialize_sequence <-
  // mostly IMPLEMENTAION specific rouintes
  ( + sz:Int

    // force MPEG-1 parameters for proper decoder behavior 
    // see ISO/IEC 13818-2 section D.9.14 
    (! ld.mpeg2_flag).if {
      progressive_sequence := True
      progressive_frame    := True
      picture_structure    := frame_picture
      frame_pred_frame_dct := True
      chroma_format        := chroma420
      matrix_coefficients  := 5
    }
    
    // round to nearest multiple of coded macroblocks 
    // ISO/IEC 13818-2 section 6.3.3 sequence_header() 
    mb_width := (horizontal_size + 0Fh) >> 4
    (ld.mpeg2_flag && {!progressive_sequence}).if {
      mb_height := ((vertical_size + 1Fh) >> 5) << 1
    } else {
      mb_height := (vertical_size + 0Fh) >> 4
    }

    coded_picture_width  := mb_width  << 4
    coded_picture_height := mb_height << 4
        
    // ISO/IEC 13818-2 sections 6.1.1.8, 6.1.1.9, and 6.1.1.10 
    (chroma_format = chroma444).if {
      chroma_width := coded_picture_width
    } else {
      chroma_width := coded_picture_width >> 1
    }
    (chroma_format != chroma420).if {
      chroma_height := coded_picture_height
    } else {
      chroma_height := coded_picture_height >> 1
    }
  
    // derived based on Table 6-20 in ISO/IEC 13818-2 section 6.3.17     
    (chroma_format)
    .when 1 then { block_count :=  6; }
    .when 2 then { block_count :=  8; }
    .when 3 then { block_count := 12; }
    
    // the buffers are kept when the same film is played again
    ((coded_picture_width != frames_width) || {coded_picture_height != frames_height}).if {
      (frames_width != 0).if {
        Store.reset_buffers
      }
      (frames_width,frames_height) := (coded_picture_width,coded_picture_height)
      
      backward_reference_frame := C_array(C_array Uint8).create 3
      forward_reference_frame  := C_array(C_array Uint8).create 3
      current_frame            := C_array(C_array Uint8).create 3
      auxframe                 := C_array(C_array Uint8).create 3
      llframe0                 := C_array(C_array Uint8).create 3
      llframe1                 := C_array(C_array Uint8).create 3
      0.to 2 do { cc:Int
        (cc = 0).if {
          sz := coded_picture_width * coded_picture_height
        } else {
          sz := chroma_width * chroma_height
        }
        backward_reference_frame.at cc put (C_array(Uint8).create sz)
        forward_reference_frame.at cc put (C_array(Uint8).create sz)
        auxframe.at cc put (C_array(Uint8).create sz)
        
        (ld.scalable_mode = sc_spat).if {
          // this assumes lower layer is 4:2:0 
          sz := lower_layer_prediction_horizontal_size*lower_layer_prediction_vertical_size
          (cc != 0).if {
            sz := sz / 4
          }
          llframe0.at cc put (C_array(Uint8).create sz)
          llframe1.at cc put (C_array(Uint8).create sz)
        }
      }
    }

    // SCALABILITY: Spatial 
    (ld.scalable_mode = sc_spat).if {
      lltmp := C_array(Int16).create      (lower_layer_prediction_horizontal_size*(
        (lower_layer_prediction_vertical_size*vertical_subsampling_factor_n)/        vertical_subsampling_factor_m
      ))
    }
  )
  
  - load_default p:String <-
  (
    String.tmp { tmp:String_buffer
      tmp.copy p
      tmp.append "anim.mpe"
      main_bitstream_filename := tmp.to_string_alias
    }
    output_type := 0
  )
  
  - print_usage <-
  (
    Stderr.put_string "MPEG2 Decoder V1.1, 2005-2026, Isaac/Lisaac project\n\n\
    \Usage:    mpeg2dec {options} file\n\n\
    \Options:  file      main bitstream: MPEG-1 or MPEG-2 video, as a program\n\
    \                    stream (.mpg, .mpe) or an elementary stream (.m2v)\n\
    \          -o0       play on screen with the sound (default)\n\
    \          -o1 name  write the pictures in files, without window nor sound:\n\
    \                    YUV: name<picture>.Y, .U and .V (no header)\n\
    \          -o2 name  SIF: name<picture>.SIF (U,Y,V,Y 4:2:2, no header)\n\
    \          -o3 name  TGA: name<picture>.tga\n\
    \          -o4 name  PPM: name<picture>.ppm\n\n\
    \Keyboard: space     pause, resume, or play again at the end of the film\n\
    \          escape, q quit\n\n\
    \Examples: mpeg2dec film.mpg\n\
    \          mpeg2dec -o4 pictures/rec film.mpg\n\n\
    \Without argument, plays anim.mpe from the current directory.\n\n"
  )
  
  - process_options <-
  // option processing
  ( + i:Int
    + is_read:Boolean
    + arg:String_alias
    
    // at least one argument should be present 
    (Command_args.count < 2).if {
      print_usage
      load_default "./"
    } else {
      i := 1
      // command-line options are proceeded by '-'     
      {i <= Command_args.upper}.while_do {
        arg := Command_args.at i
        
        // second character, [1], after '-' is the switch 
        ((arg.first = '-') && {arg.count >= 2}).if {
          is_read := False
          (arg.at 1)
          .when 'o' then {
            is_read := True
            ((arg.count != 3) || {! arg.at 2.is_digit}).if {
              print_usage
              error "ERROR: Invalid output type.\n"
            }
            output_type := arg.at 2.decimal_value
            
            (output_type.in_range 0 to 4).if_false {
              print_usage
              error "ERROR: Invalid output type.\n"
            }
            (output_type != 0).if {
              ((Command_args.upper = i) || {Command_args.at (i+1).first = '-'}).if {
                print_usage
                error "ERROR: -o must be followed by filename\n"
              } else {
                // filename is separated by space, so it becomes the next argument 
                i := i + 1
                output_picture_filename := Command_args.at i
              }
            }
          }
          (! is_read).if {
            print_usage
            error_text.copy "undefined option -"
            error_text.add_last (arg.at 1)
            error_text.append " ignored. Exiting program\n"
            error error_text
          }
        } else {        
          main_bitstream_filename := arg
        }
        
        i := i + 1
    
        // check for bitstream filename argument (there must always be one, at the very end
        // of the command line arguments 
      }
        
      // options sense checking 
      (
        (main_bitstream_filename = NULL) || {main_bitstream_filename.is_empty}
      ).if {
        print_usage
        error "There must be a main bitstream specified\n"
      }
    }
  )

  - stat_mpg:Int8
  - bitstream_framenum:Int
  - sequence_framenum:Int
  - header_ready:Boolean
  
  - open_stream <-
  // The first headers are read here: they give the size of the window.
  (
    Layer_data.make main_bitstream_filename
    ld := Layer_data
    bitstream_framenum := sequence_framenum := 0
    second_field := False
    header_ready := Gethdr.get_hdr
    stat_mpg := 1
  )
  
  - picture_done <-
  // update picture numbers 
  ( + nb_fields:Int
    
    (! second_field).if {
      bitstream_framenum := bitstream_framenum + 1
      sequence_framenum  := sequence_framenum  + 1
      
      nb_fields := 2
      (repeat_first_field).if {
        (! progressive_sequence).if {
          nb_fields := 3
        }.elseif {top_field_first} then {
          nb_fields := 6
        } else {
          nb_fields := 4
        }
      }
      fields := fields + nb_fields
    }
  )
      
  - decode_picture <-
  ( 
    (stat_mpg = 0).if {
      open_stream
    }.elseif {stat_mpg = 1} then {
      //
      // Begin sequence.
      //      
      (header_ready || {Gethdr.get_hdr}).if {
        header_ready := False
        // Video sequence.
        sequence_framenum := 0
        initialize_sequence

        // decode picture whose header has already been parsed in 
        // Decode_Bitstream() 
        Getpic.decode_picture (bitstream_framenum, sequence_framenum)
        picture_done
        stat_mpg := 2
      } else {
        stat_mpg := 4
      }
    }.elseif {stat_mpg = 2} then {
      //
      // Next picture.
      //
      
      // loop through the rest of the pictures in the sequence 
      (Gethdr.get_hdr).if {
        Getpic.decode_picture (bitstream_framenum, sequence_framenum)
        picture_done
      } else {
        stat_mpg := 3
      }
    }.elseif {stat_mpg = 3} then {
      //
      // Last picture
      //
      
      // put last frame 
      (sequence_framenum != 0).if {
        skip_output := False
        Getpic.output_last_frame_of_sequence bitstream_framenum
      }
      
      // deinitialize sequence
      ld.set_mpeg2_flag False
      stat_mpg := 1
    }.elseif {stat_mpg = 4} then {
      //
      // End of sequence.
      //
      is_finished := True
    }
  )
  
  //
  // Sound.
  //
  
  - music:Sound
  - sound_started:Boolean
  
  - load_sound <-
  ( + status:Int
    + track:Audio_track
    
    track := Audio_track
    track.load main_bitstream_filename
    (! track.is_empty).if {
      audio_start := track.start_time
      status := Audio.init
      (status = Audio.success).if {
        music := Sound.new
        status := music.init_from_memory (track.data) size (track.size.to_uint64) flags (Sound.flag_no_spatialization | Sound.flag_no_pitch) group NULL
        (status != Audio.success).if {
          music := NULL
        }
      }
      (status != Audio.success).if {
        Out # "No sound: " # Audio.result_description status # '\n'
      }
    }
  )
  
  - start_sound <-
  (
    // The first sound can be before the first picture.
    music.seek_to_second (audio_start.max 0.0 - audio_start)
    music.start
    sound_started := True
  )
  
  //
  // Clock: seconds since the first picture.
  // It follows the sound as long as there is one, so that the picture cannot
  // drift. Otherwise, it follows the real time.
  //
  
  - paused:Boolean
  - is_finished:Boolean
  - play_clock:Real32
  - last_tick:Uint64
  - audio_start:Real32
  
  - update_clock <-
  ( + now:Uint64
    + status:Int
    + cursor:Real32
    
    now := Clock.nanoseconds
    ((! paused) && {last_tick != 0}).if {
      play_clock := play_clock + (now - last_tick).to_real32 / 1000_000_000.0
    }
    last_tick := now
    
    ((! paused) && {music != NULL}).if {
      ((! sound_started) && {play_clock >= audio_start}).if {
        start_sound
      }
      (sound_started && {music.is_playing}).if {
        (status,cursor) := music.cursor_in_seconds
        (status = Audio.success).if {
          play_clock := cursor + audio_start
        }
      }
    }
  )
  
  //
  // Picture timing.
  //
  
  // Number of fields decoded. The display is one picture behind the decoding
  // (see @frame_reorder): the first picture to show comes with the second
  // decoded one, hence the -2.
  - fields:Int := -2
  
  - frame_rate:Real32 <-
  ( + result:Real32
    
    result := 25.0
    (frame_rate_code)
    .when 1 then { result := 24000.0 / 1001.0; }
    .when 2 then { result := 24.0; }
    .when 3 then { result := 25.0; }
    .when 4 then { result := 30000.0 / 1001.0; }
    .when 5 then { result := 30.0; }
    .when 6 then { result := 50.0; }
    .when 7 then { result := 60000.0 / 1001.0; }
    .when 8 then { result := 60.0; }
    result * (frame_rate_extension_n + 1).to_real32 / (frame_rate_extension_d + 1).to_real32
  )
  
  - time_of nb_fields:Int :Real32 <- nb_fields.to_real32 / (2.0 * frame_rate)
  
  - max_pictures_by_draw:Int := 4
  
  - decode_due_pictures <-
  // When late, the pictures are still decoded (the next ones depend on them)
  // but only the last one is displayed. The limit keeps the window alive
  // on a machine which is too slow.
  ( + n:Int
    
    {(! paused) && {! is_finished} && {n < max_pictures_by_draw} && {time_of fields <= play_clock}}.while_do {
      n := n + 1
      skip_output := (n < max_pictures_by_draw) && {time_of (fields + 2) <= play_clock}
      decode_picture
    }
  )
  
  - restart <-
  (
    (music != NULL).if {
      music.stop
    }
    sound_started := False
    play_clock := 0.0
    fields := -2
    paused := False
    is_finished := False
    stat_mpg := 0
  )
  
  - toggle_pause <-
  (
    paused := ! paused
    (sound_started).if {
      (paused).if {
        music.stop
      }.elseif {! music.at_end} then {
        music.start
      }
    }
  )
  
  - display_ratio:Real32 <-
  // Width / height of the picture on the screen.
  ( + result:Real32
    
    result := horizontal_size.to_real32 / vertical_size.to_real32
    (ld.mpeg2_flag).if {
      (aspect_ratio_information)
      .when 2 then { result := 4.0 / 3.0; }
      .when 3 then { result := 16.0 / 9.0; }
      .when 4 then { result := 2.21; }
    }
    result
  )
  
Public

  //
  // Keyboard: space to pause (or to play again at the end), escape or q to quit.
  //
  
  - key s:String cmd c:Uint8 :Boolean <-
  ( + result:Boolean
    
    (! s.is_empty).if {
      result := True
      (s.first)
      .when ' ' then {
        (is_finished).if {
          restart
        } else {
          toggle_pause
        }
      }
      .when '\27\' or 'q' then {
        on_close
      }
    }
    result
  )
  
  - on_close <-
  (
    Audio.uninit
    parent_window.on_close
  )
  
  //
  // Display.
  //
  
  - draw <-  
  ( + p:Paint
    + w,h,x,y:Real32
    
    update_clock
    decode_due_pictures
    
    begin_path
    fill_color (Color.black)
    rect (0,0) to (width,height)
    fill
    
    (scr != NULL).if {
      // The largest picture with the proportions of the film.
      h := height
      w := h * display_ratio
      (w > width).if {
        w := width
        h := w / display_ratio
      }
      x := (width  - w) / 2.0
      y := (height - h) / 2.0
      
      begin_path
      p := Paint.create_pattern (x,y) size (w,h) img_id id_scr angle 0 alpha 1
      rect (x,y) size (w,h)
      fill_paint p
      fill
      p.free
    }
    //
    Paper.refresh_again
  )
  
  //
  // Width / Height
  //
  
  - width_min:Real32  <- 100.0
  
  - height_min:Real32 <- 80.0
  
