Header
  + name := Pmv
/*
  Simple struct for table.
  */
Inherit
  
  - parent_clone:Clone := Clone
  
Private
  
  - buffer:C_array(Int) := C_array(Int).create 8
  
  - get_index (i0,i1,i2:Int) :Int <-
  (
    ? {i0.in_range 0 to 1}
    ? {i1.in_range 0 to 1}
    ? {i2.in_range 0 to 1}
    (i0 << 2) | (i1 << 1) | i2
  )
  
Public
    
  
  //
  // Manager.
  //
  
  - clear <-
  (
    buffer.clear_all 7
  )
  
  - at (i0,i1,i2:Int) :Int <-
  ( 
    buffer.at (get_index (i0,i1,i2))
  )

  - at (i0,i1,i2:Int) put elt:Int <-
  (
    buffer.at (get_index (i0,i1,i2)) put elt
  )
