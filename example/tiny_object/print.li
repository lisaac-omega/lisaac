Header
  + name := Print
/*
  The print
  */
Inherit

  + parent_expr:Flat Expr

Public

  + text:String_alias

  //
  // Creation.
  //

  - create p:Int text t:String_alias :Self <-
  ( + result:Self
    result := clone
    result.make p text t
    result
  )

  - make p:Int text t:String_alias <-
  (
    position := p
    text     := t
  )

  //
  // Run.
  //

  - run <-
  (
    text.print; '\n'.print
  )

  //
  // Display.
  //

  - print <-
  (
    '\"'.print
    text.print
    "\".print".print
  )

