Header
  + name := Tiny_object
Inherit

  - parent_any:Any := Any

Private

  //
  // Command.
  //

  - usage: String_alias := "Usage: tiny_object <input_file[.to]>\n"

  - display_usage <-
  (
    usage.print
    exit exit_failure_code
  )

  //
  // Options.
  //

  - read_options <-
  ( + cmd:String_alias
    + j:Int

    j := 1
    {j > Command_args.upper}.until_do {
      cmd := Command_args.at j
      (input_name != NULL).if {
        display_usage
      }
      input_name := cmd
      j := j+1
    }

    (input_name = NULL).if {
      display_usage
    }
  )

Public

  - main <-
  ( + file_input:Pointer
    + sz:Int
    + slot_master:Slot

    read_options

    // Read file.
    file_input := File_utils.open_read input_name
    sz := File_utils.size file_input
    source := String_buffer.create (sz+1)
    File_utils.read file_input in source size sz
    File_utils.close file_input

    // Parse grammar.
    Parser.parse
    /*
    "Parsing ok\n".print

    "Display\n".print
    (program.lower).to (program.upper) do { i:INTEGER
      program.item i.print
    }
    */
    // -- VFT --
    (is_vft).if {
      Class.compute_vft
      Call.compute_index
    }
    // -- VFT --

    "Display VFT :\n".print
    /* DCDC old HMPAP style
    (program.lower).to (program.upper) do { i:INTEGER
      program.at i.print_vft
    }
    */
    program.foreach_value { c:Class
      c.print_vft
    }


    "Execute...\n".print
    
    (class_master = NULL).if {
      /*
      // DCDC plus de TRAVERSABLE
      semantic_error (program.first.position) message "Slot master is needed."
      */
      + f:Boolean
      + c:Class
      (f,c) := program.search_key {k:String_alias ; True}
      semantic_error (c.position) message "Slot master is needed."
      
      
      
      
    }
    
    
    
    slot_master := class_master.get_slot keyword_master
    slot_master.run (class_master)
  )
  
