Header
  + name := Class
/*The class*/
Inherit

  + parent_instr:Flat Instr

Private

  - sources:Hmap Class Key String_alias := new Hmap Class Key String_alias

Public

  + name:String_alias

  + inherit_list:Linked_list(Class)

  + slot_list:Hmap Slot Key String_alias

  // -- VFT --
  + vft:Array(Slot)
  // -- VFT --

  // Creation.

  - create p:Int name n:String_alias :Self <-
  ( + result:Self
    result := clone
    result.make p name n
    result
  )

  - make p:Int name n:String_alias <-
  (
    position     := p
    name         := n
    inherit_list := Linked_list(Class).new
    slot_list    := new Hmap Slot Key String_alias
    // -- VFT --
    (is_vft).if {
      vft := Array(Slot).create_with_capacity 16
      // sources.add self to name
      sources.at name put self
    }
    // -- VFT --
  )

  // VFT.
  
  - compute_vft <-
  (
    /*
    // DCDC no more TRAVERSABLE
    (sources.lower).to (sources.upper) do { j:INTEGER
      sources.at j.compute_vft_base 0
    }
    */
    sources.foreach_value {c:Class; c.compute_vft_base 0}
    
    
    
    
  )

  - compute_vft_base base:Int <-
  ( + new_base:Int
    + vft_parent:Array Slot
    + slot,slot_parent:Slot
    (vft.is_empty).if {
      // -- SIMPLE --
      /*
      (inherit_list.is_empty).if_false {
        inherit_list.first.compute_vft_base base
        vft.copy (inherit_list.first.vft)
      }
      */
      // -- SIMPLE --

      // -- Multi --
      0.to (base-1) do { j:Int
        vft.add_last NULL
      }
      new_base := base
      (inherit_list.lower).to (inherit_list.upper) do { j:Int
        inherit_list.at j.compute_vft_base new_base
        vft_parent := inherit_list.at j.vft
        (vft_parent.lower).to (vft_parent.upper) do { i:Int
          slot := vft_parent.at i
          (i > vft.upper).if {
            vft.add_last slot
          }.elseif {vft.at i = NULL} then {
            vft.at i put slot
          }
        }
        new_base := vft.count
      }
      // -- Multi --

      // Common.
      
      /*
      // DCDC no more TRAVERSABLE
      (slot_list.lower).to (slot_list.upper) do { j:INTEGER
        slot := slot_list.at j
        slot_parent := get_slot_in_parent (slot.name)
        (slot_parent = NULL).if {
          // New slot.
          vft.add_last slot
          slot.set_index (vft.upper)
        } else {
          // Redefinition slot.
          vft.at (slot_parent.index) put slot
          slot.set_index (slot_parent.index)
        }
      }
      */
      
      slot_list.foreach_value { s: Slot
        slot := s
        slot_parent := get_slot_in_parent (slot.name)
        (slot_parent = NULL).if {
          // New slot.
          vft.add_last slot
          slot.set_index (vft.upper)
        } else {
          // Redefinition slot.
          vft.at (slot_parent.index) put slot
          slot.set_index (slot_parent.index)
        }
      }
      
      
      
      
      
      
    }
  )

  // Added.

  - add_parent c:Class <-
  (
    (inherit_list.fast_has c).if {
      semantic_error position message "Double definition parent."
    }
    inherit_list.add_last c
    // -- VFT --
    sources.remove (c.name)
    // -- VFT --
  )

  - add_slot s:Slot <-
  (
    (slot_list.has (s.name)).if {
      semantic_error position message "Double definition slot."
    }
    // slot_list.add s to (s.name)
    slot_list.at (s.name) add s 
  )

  // Run.
  
  - is_sub_type other:Class :Boolean <-
  ( + result:Boolean
    + i:Int

    result := self = other
    (result).if_false {
      i := inherit_list.lower
      {(i <= inherit_list.upper) && {! result}}.while_do {
        result := inherit_list.at i.is_sub_type other
        i := i + 1
      }
    }
    result
  )

  - get_slot_in_parent msg:String_alias :Slot <-
  ( + result:Slot
    + i:Int

    i := inherit_list.lower
    {(i <= inherit_list.upper) && {result = NULL}}.while_do {
      result := inherit_list.at i.get_slot msg
      i := i + 1
    }
    result
  )

  - get_slot msg:String_alias :Slot <-
  ( + result:Slot
    
    // result := slot_list.fast_reference_at msg
    result := slot_list.reference_at msg
    (result = NULL).if {
      result := get_slot_in_parent msg
    }
    result
  )

  // Display.

  - print <-
  (
    name.print
    (inherit_list.is_empty).if_false {
      " Inherit ".print
      (inherit_list.lower).to (inherit_list.upper-1) do { i:Int
        inherit_list.at i.name.print
        ','.print
      }
      inherit_list.last.name.print
    }
    "\n(\n".print
    (slot_list.lower).to (slot_list.upper) do { i:Int
      slot_list.at i.print
    }
    ")\n".print
  )

  // -- VFT --
  - print_vft <-
  ( + s,sp:Slot
    + j:Int
    "---".print
    name.print
    "---\n".print
    (vft = NULL).if {
      "No VFT!\n".print
    } else {
      (vft.lower).to (vft.upper) do { i:Int
        i.print
        ':'.print
        s := vft.at i
        (s = NULL).if {
          "NULL".print
        } else {
          s.name.print
          j := inherit_list.lower
          sp := NULL
          {(j <= inherit_list.upper) && {sp = NULL}}.while_do {
            (
              (inherit_list.at j.vft.upper >= i) && {inherit_list.at j.vft.at i != NULL}
            ).if {
              sp := inherit_list.at j.vft.at i
            } else {
              j := j + 1
            }
          }
          (sp = s).if {
            " <herit of ".print
            inherit_list.at j.name.print
            '>'.print
          }.elseif {sp != NULL} then {
            " <redefinition>".print
          } else {
            " <New>".print
          }
        }
        '\n'.print
      }
    }
    '\n'.print
  )
  // -- VFT --
