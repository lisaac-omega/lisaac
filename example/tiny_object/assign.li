Header
  + name := Assign
/*
  The print
  */
Inherit

  + parent_expr:Flat Expr

Public

  + local:Local

  + type:Class

  //
  // Creation.
  //

  - create p:Int local l:Local type t:Class :Self <-
  ( + result:Self
    result := clone
    result.make p local l type t
    result
  )

  - make p:Int local l:Local type t:Class <-
  (
    position := p
    local    := l
    type     := t
  )

  //
  // Run.
  //

  - run <-
  (
    // Type control:
    (type.is_sub_type (local.type)).if_false {
      semantic_error position message "Type mismatch."
    }
    // Execute.
    local.set_the_dynamic_type type
  )

  //
  // Display.
  //

  - print <-
  (
    local.name.print
    " = New ".print
    type.name.print
  )

