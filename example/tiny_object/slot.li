Header
  + name := Slot
/*The slot*/
Inherit

  - parent_instr:Flat Instr

Public

  + name:String_alias

  + local_list:Hmap Local Key String_alias

  + expr_list:Linked_list Expr

  // -- VFT --
  + index:Int

  - set_index idx:Int <-
  (
    index := idx
  )
  // -- VFT --

  //
  // Creation.
  //

  - create p:Int name n:String_alias :Self <-
  ( + result:Self
    result := clone
    result.make p name n
    result
  )

  - make p:Int name n:String_alias <-
  (
    position  := p
    name      := n
    expr_list := Linked_list (Expr) .new
  )

  //
  // Added.
  //

  - set_local_list d:Hmap Local Key String_alias <-
  (
    local_list := d
  )

  - add_expr e:Expr <-
  (
    expr_list.add_last e
  )

  //
  // Access.
  //

  - get_local n:String_alias :Local <-
  (
 // local_list.fast_reference_at n
    local_list.reference_at n
  )

  //
  // Run.
  //

  - run t:Class <-
  ( + this:Local
    // Fix dynamic type for This.
    this := get_local keyword_this
    this.set_the_dynamic_type t
    // Execute instr.
    (expr_list.lower).to (expr_list.upper) do { i:Int
      expr_list.at i.run
    }
  )

  //
  // Display.
  //

  - print <-
  (
    "  ".print
    name.print
    " = \n".print
    "  ( ".print
    (local_list.lower).to (local_list.upper-1) do { i:Int
      local_list.at i.print
      ','.print
    }
    local_list.last.print
    " |\n".print
    (expr_list.lower).to (expr_list.upper) do { i:Int
      "    ".print
      expr_list.at i.print
      ";\n".print
    }
    "  )\n".print
  )
