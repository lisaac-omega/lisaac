Header
  - name := Core
/*
  Mandelbrot generation for test core capacities. (COP project)
  */
  
Inherit
  
  - parent_clone : Clone := Clone
  
Public
  
  + identifier:Int
  
  - create idx:Int :Self <-
  ( + result:Self
    
    result := clone
    result.make idx
    result
  )
  
  - make idx:Int <-
  (    
    identifier := idx
  )
  
  - mandelbrot <-
  ( 
    + size, i, iter,sum: Int
    + zr, zi, cr, ci, pr, pi, limit: Real64
    + stop, gone: Boolean
    + bit, bit_accu: Uint8
    
    size := 300
    // compute mandelbrot's bitmap
    limit := 4.0
    iter  := 200_000
    bit   := 080h
    0.to (size-1) do { y:Int
      ci := (y * 2).to_real64 / size - 1.0

      0.to (size-1) do { x:Int
        cr := (x * 2).to_real64 / size - 1.5

        zr:=zi:=pr:=pi:=0
        i := 0
        stop := False
        {stop}.until_do {
          zi := zr * zi * 2 + ci
          zr := pr - pi + cr
          pi := zi * zi
          pr := zr * zr
          (pi+pr > limit).if {
            stop := True
            gone := True
          } else {
            i := i+1
            stop := (i = iter)
          }
        }

        (gone).if {
          gone := False
        } else {
          bit_accu := bit_accu | bit
        }

        (bit = 1).if {
          sum := sum + bit_accu
          bit_accu := 0
          bit := 80h
        } else {
          bit := bit >> 1
        }
      }
      
      (bit != 80h).if {
        sum := sum + bit_accu
        bit_accu := 0
        bit := 80h
      }
    }
    ((sum&0F000_0000h) != 0).if { "Yop\n".print; }; // Just for to force Lisaac to perform the task...    
  )
  
  
