Header
  + name := Fibonacci
/*
  Fibonacci with a function that has two results, in Lisaac Ω.
  The gain is not only syntactical: by returning both fib(n - 1) and
  fib(n), the recursive function calls itself only once at each step,
  and the exponential runtime of the naive version is avoided.

  Shows: a slot with multiple results, (a,b) := ... to get them, and
  the unbounded integers @ℤ.

  To compile, as usual in a terminal:
  $ lisaac fibonacci -q -boost
  $ ./fibonacci 1000
  */
Private
  
  - fiborec n:ℤ : (ℤ, ℤ) <-
  ( + f0,f1:ℤ
    
    if (n <= 1) then {
      (f0,f1) := (0,1)
    } else {
      (f0,f1) := fiborec (n-1)
      (f0,f1) := (f1, f0+f1)
    }
    (f0,f1)
  )
  
Public
  
  - fibonacci n:ℤ : ℤ <-
  ( + f1,f2:ℤ
    
    (f1,f2) := fiborec n
    f2
  )
  
  - main <-
  ( + n:ℤ
    if ((Command_args.count != 2) || {! Command_args at 1.is_integer}) then {
      Out # "usage: " # (Command_args.at 0) # " <integer>\n"
      System.exit 1
    }
    n := Command_args.first .to_int
    ? {n >= 1};
    Out # "fibonacci(" # n # ")=" # (fibonacci n) # '\n'
  )
