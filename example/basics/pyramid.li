Header
  + name := Pyramid
/*
  Solving the problem of the Pyramid for small pyramid only.
  This program uses the back-tracking method.
  Its goal is to try to fill a pyramid by making a substraction
  between two succesive columns and to take its absolute value.
  The result is put on the next line.
  Example with 5:
   6   14   15   3   13
     8    1   12  10
       7   11   2
         4    9 
            5

  */
  
Private

  + size:Int // PYRAMID size (number of lines/colums) 
  
  + max_value:Int
  
  + pyram:Array Int
  
  + used:Array Boolean; // Already used numbers in @pyramid.
  
Public 
  
  - main <-
  ( + arg:String
    if (Command_args.upper = 0) then {
      "Want to compute a small pyramid ?\n\
      \Enter a small number (> 1): ".print
      Stdin.read_integer
      size := Stdin.last_integer
    }.elseif {Command_args.upper = 1} then {
      if (! (arg := Command_args.at 1).is_integer) then {
        Out # "\"" # arg # "\" is not an integer\n"
        usage_exit
      }
      size := arg.to_int
    } else {
      usage_exit
    }
    
    if (size <= 1) then {
      "size must be bigger than 1\n".print
      usage_exit
    }
    if (size > 10) then {
      "Warning: you may wait a very long time.\n".print
    }
    max_value := (size * (size + 1)) / 2
    used := Array Boolean .create (max_value + 1)
    pyram := Array Int.create (max_value + 1)
    
    if (fill_up 1) then {
      "Full pyramid:\n".print
      print
    } else {
      "Unable to fill_up such one.\n".print
    }
  )
  
Private  
  
  - propagate val1:Int column col:Int :Boolean <-
  [
    ? { val1.in_range 1 to max_value}
    ? { col.in_range 1 to size}
  ]  
  ( + stop:Boolean
    + line, val, idx:Int
    + result:Boolean
    if (used.at val1) then {
      result := False 
    } else {
      idx := index (1,col)
      ? {pyram.at idx = 0}
      pyram.at idx put val1
      used.at val1 put True
      
      line := 1
      val := val1
      result := True
      until {stop} do {
        line := line + 1
        if (line > col) then {
          stop := True
        } else {
          val := val - pyram.at (index (line-1,col-line+1))
          val := val.abs
          if (used.at val) then {
            clear_column col
            stop := True
            result := False
          } else {
            pyram.at (index (line,col-line+1)) put val
            used.at val put True
          }
        }
      }
    }
    result
  )

  - fill_up col:Int :Boolean <-
  [ 
  ? { col.in_range 1 to (size + 1)}
  ]
  ( + stop,result:Boolean
    + nb:Int
    if (col > size) then {
      result := True
    } else {
      nb := max_value
      until {stop} do {
        if (used.at nb) then {
          nb := nb - 1 ; stop := nb = 0
        }.elseif {propagate nb column col} then {
          if (fill_up (col + 1)) then {
            stop := True
          } else {
            clear_column col
            nb := nb - 1 ; stop := nb = 0
          }
        } else {
          nb := nb - 1 ; stop := nb = 0
        }
      }
      result := nb > 0
    }
    result
  )

  - index (line,col:Int) :Int <-
  [
    ? {line.in_range 1 to size}
    ? {col.in_range 1 to size}    
  ]
  ( + l:Int
    + result:Int
    l := size - line + 1
    result := max_value - ((l * (l + 1)) / 2) + col
    result
  )
  [
    ? {Result.in_range 1 to max_value}
  ] 

  - clear_column col:Int <-
  [
    ? {col.in_range 1 to size}
  ]
  ( + idx:Int
    from 1 to col do { line:Int
      idx := index (line, col - line + 1)
      used.at (pyram.at idx) put False
      pyram.at idx put 0
    }
  )

  - print <-
  ( + nb, c, s:Int
    nb := 1
    String.tmp2 { (sps:String_buffer, buf:String_buffer)
      (size / 2).times {
        5.times { 
          sps.add_last ' '
        }
      }
      buf.append sps
      from max_value down_to 1 do { v:Int
        s := buf.upper
        buf.add_last ' '
        pyram.at v .append_in buf
        buf.add_last ' '
        until {buf.upper - s >= 4} do {
          buf.add_last ' '
        }
        c := c + 1
        if (c = nb) then {
          buf.add_last '\n'
          c := 0
          nb := nb + 1
          2.times { sps.remove_last }
          buf.append sps
        }        
      }
      buf.print
    }
  )
  
  - usage_exit <-
  (
    Out # "usage: " # (Command_args.at 0) # " <small-integer>\n"
    System.exit 1
  )
  
