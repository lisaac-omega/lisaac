Header
  + name := Block_test
Public

  - action n:Int when_odd odd_block:{} when_even even_block:{} <-
  (
    if (n.is_even) then {
      even_block.value
    } else {
      odd_block.value
    }
  )

  - main <-
  ( + n:Int
    "Enter a number:\n".print
    Stdin.read_integer
    n := Stdin.last_integer
    action n when_odd { 
      "odd\n".print  
    } when_even { 
      "even.\n".print 
    }
  )
