Header
  + name := Block_test
Inherit

  - parent_clone:Clone := Clone

Private

  - action n:Int if_odd odd_block:{} if_even even_block:{} <-
  (
    (n.is_even).if {
      even_block.value
    } else {
      odd_block.value
    }
  )

Public

  - main <-
  ( + n:Int

    "Entry a number:\n".print
    Stdin.read_integer
    n := Stdin.last_integer
    action n
    if_odd  { "This integer is odd.\n".print;  }
    if_even { "This integer is even.\n".print; }
  )
