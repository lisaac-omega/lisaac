Header
  + name := Example_show
  
/**/
Insert
  - code_show:Code_show := Code_show
    
Public
  
  - main <-
  (  
    directory "" main "hello_world" run False elit True
    directory "welcome" main "welcome" run True elit True
    directory "startrek" main "startrek" run True elit False
    directory "connect_four" main "connect_four" run True elit False
    directory "tetris" main "tetris" run True elit False
    directory "mapping" main "nayeli" run True elit False
    directory "snake" main "snake" run True elit True 
    directory "misc" main "glyph_example" run False elit True 
    directory "basics" main "factorial_example" run False elit True 
    directory "" main "fibonacci" run False elit True 
  )
  
