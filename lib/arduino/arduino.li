Header
  + name := Arduino
- lip <-
  (
    (target != "arduino").if {
      "Sorry, `ARDUINO' prototype is for only arduino target.\n".print;
      die_with_code 1;
    };
  );
  
  - include := `
#include <Arduino.h>
#include <SPI.h> 
#include <Wire.h>
`;
Inherit
  - parent_clone:Clone := Clone
  //- parent_var:VAR := VAR

Public
  
  // Basic command
  
  - low:Uint8 <- `LOW`:Uint8
  - high:Uint8 <- `HIGH`:Uint8
  - led_builtin:Uint8 <- `LED_BUILTIN`:Uint8
  - output:Uint8 <- `OUTPUT`:Uint8
  - input_pullup:Uint8 <- `INPUT_PULLUP`:Uint8
  
  - pin pin:Uint8 mode mode:Uint8 <- `pinMode(@pin,@mode)`
  
  - digital pin:Uint8 write val:Uint8 <- `digitalWrite(@pin,@val)`
  
  - analog pin:Uint8 write val:Uint8 <- `analogWrite(@pin,@val)`
  
  - digital_read pin:Uint8 :Uint8 <- `digitalRead(@pin)`:Uint8
  
  - delay ms:Uint16 <- `delay(@ms)`
  
  - micros:Uint32 <- `micros()`:Uint32
  
  - serial_begin bd:Uint16 <- `Serial.begin(9600)`
  
  - serial_available:Int16 <- `Serial.available()`:Int16; // 0..128
  
  - serial_read:Int8 <- `Serial.read()`:(Int8)
  
  // Interruption manager
  
  //- low:Uint8     <- `LOW`:Uint8
  - change:Uint8  <- `CHANGE`:Uint8
  - rising:Uint8  <- `RISING`:Uint8
  - falling:Uint8 <- `FALLING`:Uint8
  
  - attach_interrupt_pin pin:Uint8 fnc ptr:Pointer type t:Uint8 <-
  `attachInterrupt(digitalPinToInterrupt(@pin), @ptr, @t)`
  
  // Other
  
  - reset_all <- ( abstract; )
  
  - reboot <- reset_all
  
  - tools_main; //
  
  - tools_setup <-
  (
    `main_old(0,NULL)`
    `SPI.begin()`
  )
    
  
