Header
  + name := Edge
/* @stbtt__edge of stb_truetype v1.24: an edge of the outline, from (@x0,@y0)
   to (@x1,@y1) with @y0 <= @y1 (@invert gives the original direction). */
Inherit
  
  - parent_clone:Clone := Clone

Public  
  
  - new:Self <- clone
  
  + x0:Real32
  + y0:Real32
  + x1:Real32
  + y1:Real32
  + invert:Boolean
  
  - set_y0 y:Real32 <- ( y0 := y; )
  
  - make i:Boolean x0 px0:Real32 y0 py0:Real32 x1 px1:Real32 y1 py1:Real32 <-
  (
    invert := i
    (x0,y0) := (px0,py0)
    (x1,y1) := (px1,py1)
  )
