Header
  + name := Ttf_constant
Inherit
  
  - parent_clone:Clone := Clone
  
Public
   
  - macstyle_dontcare:Int   := 0
  - macstyle_bold:Int       := 1
  - macstyle_italic:Int     := 2
  - macstyle_underscore:Int := 4
  - macstyle_none:Int       := 8
  
  - vmove:Int := 1
  - vline:Int := 2
  - vcurve:Int:= 3
    
  - platform_id_unicode  :Int := 0
  - platform_id_mac      :Int := 1
  - platform_id_iso      :Int := 2
  - platform_id_microsoft:Int := 3

  - unicode_eid_unicode_1_0   :Int  := 0
  - unicode_eid_unicode_1_1   :Int  := 1
  - unicode_eid_iso_10646     :Int  := 2
  - unicode_eid_unicode_2_0_bmp:Int := 3
  - unicode_eid_unicode_2_0_full:Int:= 4

  - ms_eid_symbol       :Int := 0
  - ms_eid_unicode_bmp  :Int := 1
  - ms_eid_shiftjis     :Int := 2
  - ms_eid_unicode_full :Int :=10

  - mac_eid_roman       :Int := 0
  - mac_eid_arabic      :Int := 4
  - mac_eid_japanese    :Int := 1
  - mac_eid_hebrew      :Int := 5
  - mac_eid_chinese_trad:Int := 2
  - mac_eid_greek       :Int := 6
  - mac_eid_korean      :Int := 3
  - mac_eid_russian     :Int := 7

  - ms_lang_english :Int := 409h
  - ms_lang_italian :Int := 410h
  - ms_lang_chinese :Int := 804h
  - ms_lang_japanese:Int := 411h
  - ms_lang_dutch   :Int := 413h
  - ms_lang_korean  :Int := 412h
  - ms_lang_french  :Int := 40ch
  - ms_lang_russian :Int := 419h
  - ms_lang_german  :Int := 407h
  - ms_lang_spanish :Int := 409h
  - ms_lang_hebrew  :Int := 40dh
  - ms_lang_swedish :Int := 41Dh

  - mac_lang_english     :Int := 0
  - mac_lang_japanese    :Int :=11
  - mac_lang_arabic      :Int :=12
  - mac_lang_korean      :Int :=23
  - mac_lang_dutch       :Int := 4
  - mac_lang_russian     :Int :=32
  - mac_lang_french      :Int := 1
  - mac_lang_spanish     :Int := 6
  - mac_lang_german      :Int := 2
  - mac_lang_swedish     :Int := 5
  - mac_lang_hebrew      :Int :=10
  - mac_lang_chinese_simplified:Int :=33
  - mac_lang_italian     :Int := 3
  - mac_lang_chinese_trad:Int :=19
  
  // accessors to parse data from file

  - ttbyte p:C_array Uint8 :Uint8 <- 
  p.at 0.to_raw_uint8
  
  - ttchar p:C_array Uint8 :Int8  <- 
  p.at 0.to_raw_int8

  - ttfixed p:C_array Uint8 :Int32 <- 
  ttlong p
  
  - ttushort p:C_array Uint8 :Uint16 <- 
  (p.at 0.to_raw_uint16<<8)|(p.at 1.to_raw_uint8)
  
  - ttshort p:C_array Uint8 :Int16  <- 
  (p.at 0.to_raw_int16<<8)|(p.at 1.to_raw_uint8)
  
  - ttulong p:C_array Uint8 :Uint32 <- 
  (p.at 0.to_raw_uint32<<24)|
  (p.at 1.to_raw_uint8.to_raw_uint32<<16)|
  (p.at 2.to_raw_uint8.to_raw_uint32<< 8)|
  (p.at 3.to_raw_uint8)
  
  - ttlong p:C_array Uint8 :Int32 <- 
  (p.at 0.to_raw_int32<<24)|
  (p.at 1.to_raw_uint8.to_raw_int32<<16)|
  (p.at 2.to_raw_uint8.to_raw_int32<< 8)|
  (p.at 3.to_raw_uint8)
  
  - tag4 p:C_array Uint8 
  with (c0,c1,c2,c3:Uint8) :Boolean <- (
    (p.at 0 = c0) && {p.at 1 = c1} && 
    {p.at 2 = c2} && {p.at 3 = c3}
  )
  
  - tag p:C_array Uint8 with str:String_alias :Boolean <-
  tag4 p with (str.item 0,str.item 1,str.item 2,str.item 3)

  // @OPTIMIZE: binary search
  - find_table (dta:C_array Uint8,start:Int) 
  name tg:String_alias :Uint32 <-
  ( + result:Uint32
    + loc,i,num_tables,tabledir:Int
    
    num_tables := ttushort (dta+start+4)
    tabledir := start + 12
    {(i < num_tables) && {result = 0}}.while_do {
      loc := tabledir + 16*i
      (tag (dta+loc+0) with tg).if {
        result := ttulong (dta+loc+8)
      }
      i := i + 1
    }
    result
  )
