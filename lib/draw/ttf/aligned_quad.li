Header
  + name := Aligned_quad
/* @stbtt_aligned_quad of stb_truetype v1.24: the quad to draw for a baked or
   packed character (screen coordinates and texture coordinates). */
Inherit
  
  - parent_clone:Clone := Clone

Public
  
  - new:Self <- clone
  
  + x0:Real32; // top-left
  + y0:Real32
  + s0:Real32
  + t0:Real32
  + x1:Real32; // bottom-right
  + y1:Real32
  + s1:Real32
  + t1:Real32
  
  - get_baked_quad chardata:Array Backed_char size (pw,ph:Int) index char_index:Int pos (xpos,ypos:Real32) opengl opengl_fillrule:Boolean :(Real32,Real32) <-
  // As @stbtt_GetBakedQuad: fills @self, and returns the next position.
  ( + d3d_bias,ipw,iph:Real32
    + b:Backed_char
    + round_x,round_y:Int
    (opengl_fillrule).if { d3d_bias := 0; } else { d3d_bias := -0.5; }
    ipw := 1.0 / pw.to_real32
    iph := 1.0 / ph.to_real32
    b := chardata.at char_index
    round_x := ((xpos + b.xoff) + 0.5).floor
    round_y := ((ypos + b.yoff) + 0.5).floor
    x0 := round_x.to_real32 + d3d_bias
    y0 := round_y.to_real32 + d3d_bias
    x1 := (round_x + b.x1 - b.x0).to_real32 + d3d_bias
    y1 := (round_y + b.y1 - b.y0).to_real32 + d3d_bias
    s0 := b.x0.to_real32 * ipw
    t0 := b.y0.to_real32 * iph
    s1 := b.x1.to_real32 * ipw
    t1 := b.y1.to_real32 * iph
    xpos + b.xadvance, ypos
  )
  
  - get_packed_quad chardata:Array Packed_char size (pw,ph:Int) index char_index:Int pos (xpos,ypos:Real32) align align_to_integer:Boolean :(Real32,Real32) <-
  // As @stbtt_GetPackedQuad: fills @self, and returns the next position.
  ( + ipw,iph,x,y:Real32
    + b:Packed_char
    ipw := 1.0 / pw.to_real32
    iph := 1.0 / ph.to_real32
    b := chardata.at char_index
    (align_to_integer).if {
      x := (((xpos + b.xoff) + 0.5).floor).to_real32
      y := (((ypos + b.yoff) + 0.5).floor).to_real32
      x0 := x
      y0 := y
      x1 := x + b.xoff2 - b.xoff
      y1 := y + b.yoff2 - b.yoff
    } else {
      x0 := xpos + b.xoff
      y0 := ypos + b.yoff
      x1 := xpos + b.xoff2
      y1 := ypos + b.yoff2
    }
    s0 := b.x0.to_real32 * ipw
    t0 := b.y0.to_real32 * iph
    s1 := b.x1.to_real32 * ipw
    t1 := b.y1.to_real32 * iph
    xpos + b.xadvance, ypos
  )
