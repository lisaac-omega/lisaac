Header
  + name := Backed_char
/* @stbtt_bakedchar of stb_truetype v1.24: a character baked by
   @Ttf.bake_font_bitmap (its box in the bitmap, its offsets and advance). */
Inherit
  
  - parent_clone:Clone := Clone

Public
  
  - new:Self <- clone
  
  + x0:Uint16; // coordinates of bbox in bitmap
  + y0:Uint16
  + x1:Uint16
  + y1:Uint16
  + xoff:Real32
  + yoff:Real32
  + xadvance:Real32
  
  - make (px0,py0,px1,py1:Int) offset (pxoff,pyoff:Real32) xadvance pxadvance:Real32 <-
  (
    (x0,y0) := (px0.to_raw_uint16,py0.to_raw_uint16)
    (x1,y1) := (px1.to_raw_uint16,py1.to_raw_uint16)
    (xoff,yoff) := (pxoff,pyoff)
    xadvance := pxadvance
  )
