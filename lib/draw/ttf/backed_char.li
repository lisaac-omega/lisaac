Header
  + name := Backed_char
/*Proto utile ??*/
  
Mapping
  
  + x0:Uint16;
  + y0:Uint16;
  + x1:Uint16;
  + y1:Uint16;
  + xoff:Real32;
  + yoff:Real32;
  + xoff2:Real32;
  + yoff2:Real32;
  + xadvance:Real32;
  
  - make (px0,py0:Uint16) to (px1,py1:Uint16) 
  offset (pxoff,pyoff:Real32) to (pxoff2,pyoff2:Real32)
  xadvance pxadvance:Real32 <-
  (
    (x0,y0) := (px0,py0);
    (x1,y1) := (px1,py1);
    (xoff,yoff) := (pxoff,pyoff);
    (xoff2,yoff2) := (pxoff2,pyoff2);
    xadvance := pxadvance;
  );
