  ranges_render ranges:Array Pack_range 
  into_rects rects:Array Rect <-
  ( + i,j,k,return_value:Int
    + old_h_over,old_v_over:Int
    + fh,scale,recip_h,recip_v,sub_x,sub_y:Real32
    + r:Rect
    not_yet_implemented
    /*
    // save current values
    old_h_over := h_oversample
    old_v_over := v_oversample
    return_value := 1
