      (safe_h+1).to (h-1) do { i:Int
        ? {pixels.item ofs = 0}
        total := total - buffer.item (i & over_mask)
        pixels.put ((total / kernel_width).to_uint8) to ofs
        ofs := ofs + stride_in_bytes
      }
    }
  );*/

  - oversample_shift oversample:Int :Real32 <-
  ( + result:Real32
    (oversample != 0).if {
      result := -(oversample - 1).to_real32 / (oversample*2)
    }
    result
  )

  // rects array must be big enough to accommodate 
  // all characters in the given ranges
  - pack_font_ranges_gather_rects (info:Fontinfo,ranges:Array Pack_range, rects:Array Rect) :Int <-
  ( + i,j,k:Int
    not_yet_implemented
    /*
    0.to (ranges.upper) do { i:Int
      + fh,scal:REAL_32
      fh := ranges.item i.font_size
