Header
  + name := Context
/*stbrp_context*/
  
Public  
  
  + width:Int
  + height:Int
  + x:Int
  + y:Int
  + bottom_y:Int
  
  - init_target (pw,ph:Int) <-
  (
    (width,height) := (pw,ph)
    x := y := bottom_y := 0
  )

  - pack_rects rects:Array (Flat Rect) <-
  ( + i:Int
    + break:Boolean
    {(i < rects.count) && {! break}}.while_do { 
      (x + rects.item i.w > width).if {
        (x,y) := (0,bottom_y)
      }
      (y + rects.item i.h > height).if {
        break := True
      } else {
        rects.item i.set_xy (x,y)
        rects.item i.set_was_packed 1
        x := x + rects.item i.w
        (y + rects.item i.h > bottom_y).if {
          bottom_y := y + rects.item i.h
        }
        i := i + 1
      }
    }
    {i < rects.count}.while_do {
      rects.item i.set_was_packed 0
      i := i + 1
    }
  )

