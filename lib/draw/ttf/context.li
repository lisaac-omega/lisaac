Header
  + name := Context
/* @stbrp_context of stb_truetype v1.24: the "super-crappy" packer used when
   stb_rect_pack.h is not available (rows from left to right). */
Inherit
  
  - parent_clone:Clone := Clone

Public  
  
  - new:Self <- clone
  
  + width:Int
  + height:Int
  + x:Int
  + y:Int
  + bottom_y:Int
  
  - init_target (pw,ph:Int) <-
  (
    (width,height) := (pw,ph)
    x := y := bottom_y := 0
  )
  
  - pack_rects rects:Array Rect count num_rects:Int <-
  ( + i:Int
    + stop:Boolean
    {(i < num_rects) && {! stop}}.while_do { 
      (x + rects.at i.w > width).if {
        x := 0
        y := bottom_y
      }
      (y + rects.at i.h > height).if {
        stop := True
      } else {
        rects.at i.set_xy (x,y)
        rects.at i.set_was_packed True
        x := x + rects.at i.w
        (y + rects.at i.h > bottom_y).if {
          bottom_y := y + rects.at i.h
        }
        i := i + 1
      }
    }
    {i < num_rects}.while_do {
      rects.at i.set_was_packed False
      i := i + 1
    }
  )
