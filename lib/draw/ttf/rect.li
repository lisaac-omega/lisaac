Header
  + name :=  Rect
Public

  + x:Int
  + y:Int
  + id:Int
  + w:Int
  + h:Int
  + was_packed:Int
  
  - move_pad pad:Int <-
  (
    (x,y) := (x + pad,y + pad)
    (w,h) := (w - pad,h - pad)
  )
  
  - set_xy (px,py:Int) <- 
  (
    (x,y) := (px,py)
  )
  
  - set_was_packed i:Int <-
  (
    was_packed := i
  )
