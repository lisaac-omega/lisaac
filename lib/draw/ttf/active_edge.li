Header
  + name := Active_edge
/* @stbtt__active_edge of stb_truetype v1.24 (rasterizer version 2): an edge
   crossing the current scanline, in a linked list. */
Inherit  
  
  - parent_clone:Clone := Clone

Private  
  
  - stock_active_edge:Array Active_edge := Array Active_edge.create_with_capacity 32
  
Public
  
  + next:Active_edge
  + fx:Real32
  + fdx:Real32
  + fdy:Real32
  + direction:Real32
  + sy:Real32
  + ey:Real32
  
  - set_direction d:Real32 <- ( direction := d; )
  - set_next n:Active_edge <- ( next := n; )
  - set_fx x:Real32 <- ( fx := x; )
  - set_ey y:Real32 <- ( ey := y; )
  
  - create e:Edge offset off_x:Int start start_point:Real32 :Active_edge <-
  // As @stbtt__new_active.
  ( + result:Active_edge
    (stock_active_edge.is_empty).if {
      result := Active_edge.clone
    } else {
      result := stock_active_edge.pop
    }
    result.make e offset off_x start start_point
    result
  )
  
  - free <- stock_active_edge.add_last self
  
  - make e:Edge offset off_x:Int start start_point:Real32 <-
  ( + dxdy:Real32
    dxdy := (e.x1 - e.x0) / (e.y1 - e.y0)
    fdx := dxdy
    (dxdy != 0.0).if { fdy := 1.0 / dxdy; } else { fdy := 0.0; }
    fx := e.x0 + dxdy * (start_point - e.y0)
    fx := fx - off_x.to_real32
    (e.invert).if { direction := 1.0; } else { direction := -1.0; }
    sy := e.y0
    ey := e.y1
    next := NULL
  )
