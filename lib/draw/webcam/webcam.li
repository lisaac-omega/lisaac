Header
  + name := Webcam
- include := `#include <linux/videodev2.h>
extern struct v4l2_buffer bf;`;
  
  - external := `struct v4l2_buffer bf;`;
Inherit
  - parent_clone:Clone := Clone
  
Public
  
  - verbose:Boolean := False
  
  - init src:String_alias size (w,h:Int) :Self <-
  [ ? {src != NULL}; ]
  (
    palette := -1
    (width,height) := (w,h)
    // Open the device.
    fd := Dev.open src
    (fd < 0).if {        
      "Error opening device: ".print; src.println
      "open: ".print; String.errno.println
    }
    (verbose).if {
      src.print; " opened.\n".print
      get_capability
    }
    set_input; // Set the input.      
    set_pix_format; // Set the pixel format.
    // Set the frame-rate if > 0
    set_mmap
    self
  )

  - close <-
  (
    free_mmap
    (fd >= 0).if { Dev.close fd; fd := -1; }
  )

  - grab <-
  ( + f,time:Int
    + r,idx:Int
    //`struct v4l2_buffer bf`
    f := fd
    `fd_set fds`
    `struct timeval tv`

    // Is a frame ready?
    `FD_ZERO(&fds)`
    `FD_SET(@f, &fds)`
    time := 5
    `tv.tv_sec = @time`
    `tv.tv_usec = 0`
    r := `select(@f + 1, &fds, NULL, NULL, &tv)`:Int
    (r = -1).if {
      "select: ".print; String.errno.println
    }
    (r = 0).if {
      "Timed out waiting for frame!\n".print
    }
    `bf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE`
    `bf.memory = V4L2_MEMORY_MMAP`
    (Dev.ioctl fd cmd `VIDIOC_DQBUF`:Int ptr `&bf`:Pointer = -1).if {
      "VIDIOC_DQBUF: ".print; String.errno.println
    }
    idx := `bf.index`:Int
    //"index:".print; idx.println
    img := mbuf.at idx
    len := mlen.at idx
  )
  
  - reset_buf <-
  ( 
    (Dev.ioctl fd cmd `VIDIOC_QBUF`:Int ptr `&bf`:Pointer = -1).if {
      "VIDIOC_QBUF: ".print; String.errno.println
    }
  )
      
  // Last captured image
  + len:Uint32
  + img:C_array Uint8
  
  + width:Uint32
  + height:Uint32
  
  - nb_buf:Int <- mbuf.count
  
  - is_open:Boolean <- fd >= 0
  
Private
  //------------- Beg src v4l2
  + fd:Int := -1
  
  + mbuf:Array (C_array Uint8)
  + mlen:Array Int

  // Image Options
  + palette:Int
    
  - get_capability <-
  ( + cap:Int
    `struct v4l2_capability cap`
    (Dev.ioctl fd cmd `VIDIOC_QUERYCAP`:Int ptr `&cap`:Pointer < 0).if {
      "Not a V4L2 device?".println
    } else {
      "V4l2 information:".println
      "cap.driver: \"".print;      Print.extern `cap.driver`:C_array Char; "\"".println
      "cap.card: \"".print;        Print.extern `cap.card`:C_array Char; "\"".println
      "cap.bus_info: \"".print;    Print.extern `cap.bus_info`:C_array Char; "\"".println
      cap := `cap.capabilities`:Int
      "cap.capabilities=0x".print; cap.print_hex; '\n'.print
      ((cap & `V4L2_CAP_VIDEO_CAPTURE`:Int)!=0).if { "- VIDEO_CAPTURE\n".print; }
      ((cap & `V4L2_CAP_VIDEO_OUTPUT`:Int)!=0).if  { "- VIDEO_OUTPUT\n".print; }
      ((cap & `V4L2_CAP_VIDEO_OVERLAY`:Int)!=0).if { "- VIDEO_OVERLAY\n".print; }
      ((cap & `V4L2_CAP_VBI_CAPTURE`:Int)!=0).if   { "- VBI_CAPTURE\n".print; }
      ((cap & `V4L2_CAP_VBI_OUTPUT`:Int)!=0).if    { "- VBI_OUTPUT\n".print; }
      ((cap & `V4L2_CAP_RDS_CAPTURE`:Int)!=0).if   { "- RDS_CAPTURE\n".print; }
      ((cap & `V4L2_CAP_TUNER`:Int)!=0).if         { "- TUNER\n".print; }
      ((cap & `V4L2_CAP_AUDIO`:Int)!=0).if         { "- AUDIO\n".print; }
      ((cap & `V4L2_CAP_RADIO`:Int)!=0).if         { "- RADIO\n".print; }
      ((cap & `V4L2_CAP_READWRITE`:Int)!=0).if     { "- READWRITE\n".print; }
      ((cap & `V4L2_CAP_ASYNCIO`:Int)!=0).if       { "- ASYNCIO\n".print; }
      ((cap & `V4L2_CAP_STREAMING`:Int)!=0).if     { "- STREAMING\n".print; }
      ((cap & `V4L2_CAP_TIMEPERFRAME`:Int)!=0).if  { "- TIMEPERFRAME\n".print; }
      ((cap & `V4L2_CAP_VIDEO_CAPTURE`:Int)=0).if {
        "Device does not support capturing.\n".print
      }
    }
  )

  - set_input <-
  ( + typ,stat:Int
    `struct v4l2_input in`
    `int i=0`
    `in.index = 0`
    (Dev.ioctl fd cmd `VIDIOC_ENUMINPUT`:Int ptr `&in`:Pointer = -1).if {
      "Unable to query input 0.\n".print
      "VIDIOC_ENUMINPUT: ".print; String.errno.println
    }
    (verbose).if {
      "V4l2 Input 0 information:\n".print
      "name = \"".print; Print.extern `in.name`:C_array Char; "\"".println
      (typ,stat) := (`in.type`:Int,`in.status`:Int)
      "type = ".print; typ.print_hex; '\n'.print
      ((typ & `V4L2_INPUT_TYPE_TUNER`:Int)  != 0).if { "- TUNER\n".print; }
      ((typ & `V4L2_INPUT_TYPE_CAMERA`:Int) != 0).if { "- CAMERA\n".print; }
      "audioset = ".print; `in.audioset`:Int.print_hex; '\n'.print
      "tuner = ".print; `in.tuner`:Int.print_hex; '\n'.print
      "status = ".print; stat.print_hex; '\n'.print
      ((stat & `V4L2_IN_ST_NO_POWER`:Int)  != 0).if { "- NO_POWER\n".print; }
      ((stat & `V4L2_IN_ST_NO_SIGNAL`:Int) != 0).if { "- NO_SIGNAL\n".print; }
      ((stat & `V4L2_IN_ST_NO_COLOR`:Int)  != 0).if { "- NO_COLOR\n".print; }
      ((stat & `V4L2_IN_ST_NO_H_LOCK`:Int) != 0).if { "- NO_H_LOCK\n".print; }
      ((stat & `V4L2_IN_ST_COLOR_KILL`:Int)!= 0).if { "- COLOR_KILL\n".print; }
      ((stat & `V4L2_IN_ST_NO_SYNC`:Int)   != 0).if { "- NO_SYNC\n".print; }
      ((stat & `V4L2_IN_ST_NO_EQU`:Int)    != 0).if { "- NO_EQU\n".print; }
      ((stat & `V4L2_IN_ST_NO_CARRIER`:Int)!= 0).if { "- NO_CARRIER\n".print; }
      ((stat & `V4L2_IN_ST_MACROVISION`:Int)!= 0).if { "- MACROVISION\n".print; }
      ((stat & `V4L2_IN_ST_NO_ACCESS`:Int) != 0).if { "- NO_ACCESS\n".print; }
      ((stat & `V4L2_IN_ST_VTR`:Int)       != 0).if { "- VTR\n".print; }
    }
    (Dev.ioctl fd cmd `VIDIOC_S_INPUT`:Int ptr `&i`:Pointer = -1).if {
      "Error selecting input ".print; `i`:Int.println
      "VIDIOC_S_INPUT: ".print; String.errno.println
    }

    // If this input is attached to a tuner, set the frequency.
    ((typ & `V4L2_INPUT_TYPE_TUNER`:Int) != 0).if {
      + range:String_alias
      + tuner_typ,tuner_cap:Int
      + freq:Uint32
      `struct v4l2_tuner tuner`
      `struct v4l2_frequency freq`
      // Query the tuners capabilities. 		
      //memset(&tuner, 0, sizeof(tuner))
      `tuner.index = in.tuner`
      (Dev.ioctl fd cmd `VIDIOC_G_TUNER`:Int ptr `&tuner`:Pointer = -1).if {
        "Error querying tuner ".print; `in.tuner`:Int.print; ".\n".print
        "VIDIOC_G_TUNER: ".print; String.errno.println
      }
      (verbose).if {
        range := ((`tuner.capability`:Int & `V4L2_TUNER_CAP_LOW`:Int) != 0).ok "kHz" or "MHz"
        
        "V4l2 Tuner ".print; `in.tuner`:Int.print; " information:\n".print
        "name = \"".print; Print.extern `tuner.name`:C_array Char; "\"\n".print
        tuner_typ := `tuner.type`:Int
        "type = ".print; tuner_typ.print_hex; '\n'.print
        (tuner_typ = `V4L2_TUNER_RADIO`:Int).if     { "- RADIO\n".print; }
        (tuner_typ = `V4L2_TUNER_ANALOG_TV`:Int).if { "- ANALOG_TV\n".print; }
        tuner_cap := `tuner.capability`:Int
        "capability = ".print; tuner_cap.print_hex; '\n'.print
        ((tuner_cap & `V4L2_TUNER_CAP_LOW`:Int)    != 0).if { "- LOW\n".print; }
        ((tuner_cap & `V4L2_TUNER_CAP_NORM`:Int)   != 0).if { "- NORM\n".print; }
        ((tuner_cap & `V4L2_TUNER_CAP_STEREO`:Int) != 0).if { "- STEREO\n".print; }
        ((tuner_cap & `V4L2_TUNER_CAP_LANG1`:Int)  != 0).if { "- LANG1\n".print; }
        ((tuner_cap & `V4L2_TUNER_CAP_LANG2`:Int)  != 0).if { "- LANG2\n".print; }
        ((tuner_cap & `V4L2_TUNER_CAP_SAP`:Int)    != 0).if { "- SAP\n".print; }
        //
        "rangelow = ".print; `tuner.rangelow`:Int.print_hex
        ", (".print; ((`tuner.rangelow`:Int * 16).to_real32 / 1000).print; range.print; ")\n".print
        "rangehigh = ".print; `tuner.rangehigh`:Int.print_hex
        ", (".print; ((`tuner.rangehigh`:Int * 16).to_real32 / 1000).print; range.print; ")\n".print
        "signal = ".print; `tuner.signal`:Int.print_hex; '\n'.print
        "afc = ".print; `tuner.afc`:Int.print_hex; '\n'.print
        
        // Set the frequency.
        freq := 0
        `freq.tuner = in.tuner`
        `freq.type = V4L2_TUNER_ANALOG_TV`
        `freq.frequency = (@freq / 1000) * 16`
        (Dev.ioctl fd cmd `VIDIOC_S_FREQUENCY`:Int ptr `&freq`:Pointer = -1).if {
          "Error setting frequency ".print
          (freq.to_real32 / 16.0).print; range.print; '\n'.print
          "VIDIOC_S_FREQUENCY: ".print; String.errno.println
        }
        "Set frequency to ".print
        (freq / 1000).print; range.println
      }
    }
  )

  - set_pix_format <-
  ( + v4l2_pal,w,h:Int
    + pix:Uint32
    `struct v4l2_fmtdesc fmtdesc`
    `struct v4l2_format fmt`
    // Dump a list of formats the device supports.
    (verbose).if {
      "Device offers the following V4L2 pixel formats:\n".print
    }
    //memset(&fmt, 0, sizeof(fmt))
    `fmtdesc.index = @v4l2_pal`
    `fmtdesc.type  = V4L2_BUF_TYPE_VIDEO_CAPTURE`
    {Dev.ioctl fd cmd `VIDIOC_ENUM_FMT`:Int ptr `&fmtdesc`:Pointer != -1}.while_do {
      pix := `fmtdesc.pixelformat`:Int
      (verbose).if {
        v4l2_pal.print; ": [0x".print
        pix.print_hex; "] '".print
        (pix >> 0).to_character.print;  (pix >> 8).to_character.print
        (pix >> 16).to_character.print; (pix >> 24).to_character.print
        "' (".print; Print.extern `fmtdesc.description`:C_array Char; ")\n".print
      }
      ((pix = 47504A4Dh) || {pix = 4745504Ah}).if { palette := pix; }; // MJPG
      //(pix = 56595559h).if { palette := pix; }; // YUYV
      //memset(&fmt, 0, sizeof(fmt))
      v4l2_pal := v4l2_pal + 1
      `fmtdesc.index = @v4l2_pal`
      `fmtdesc.type = V4L2_BUF_TYPE_VIDEO_CAPTURE`
    }
    (palette != -1).if {
      (w,h,pix) := (width,height,palette)
      `fmt.type                = V4L2_BUF_TYPE_VIDEO_CAPTURE`
      `fmt.fmt.pix.width       = @w`
      `fmt.fmt.pix.height      = @h`
      `fmt.fmt.pix.pixelformat = @pix`
      `fmt.fmt.pix.field       = V4L2_FIELD_ANY`
      (
        (Dev.ioctl fd cmd `VIDIOC_TRY_FMT`:Int ptr `&fmt`:Pointer != -1) &&
        {`fmt.fmt.pix.pixelformat`:Int = palette}
      ).if {
        (verbose).if {
          "Using palette ".print
          (pix >> 0).to_character.print;  (pix >> 8).to_character.print
          (pix >> 16).to_character.print; (pix >> 24).to_character.println
        }
        (w,h) := (`fmt.fmt.pix.width`:Int,`fmt.fmt.pix.height`:Int)
        ((w != width) || {h != height}).if {
          (verbose).if {
            "Adjusting resolution from ".print
            width.print; 'x'.print; height.print; " to ".print
            w.print;     'x'.print; h.print;      ".\n".print
          }
          (width,height) := (w,h)
        }
        (Dev.ioctl fd cmd `VIDIOC_S_FMT`:Int ptr `&fmt`:Pointer = -1).if {
          "Error setting pixel format.\n".print
          "VIDIOC_S_FMT: ".print; String.errno.println
        }
      }
    }
  )

  - free_mmap <-
  ( + pimg:C_array Uint8
    + plen:Int
    0.to (mbuf.upper) do { b:Int
      (pimg,plen) := (mbuf.at b,mlen.at b)
      `munmap(@pimg, @plen)`
    }
  )

  - set_mmap <-
  ( + f,cnt:Int
    `enum v4l2_buf_type type`
    `struct v4l2_requestbuffers req`
    `struct v4l2_buffer buf`
    
    mbuf := Array (C_array Uint8).create_with_capacity 4
    mlen := Array Int.create_with_capacity 4
    //memset(req, 0, sizeof(req))
    `req.count  = 4`
    `req.type   = V4L2_BUF_TYPE_VIDEO_CAPTURE`
    `req.memory = V4L2_MEMORY_MMAP`
    f := fd
    (Dev.ioctl fd cmd `VIDIOC_REQBUFS`:Int ptr `&req`:Pointer = -1).if {
      "Error requesting buffers for memory map.\n".print
      "VIDIOC_REQBUFS: ".print; String.errno.println
    }
    cnt := `req.count`:Int
    (verbose).if {
      "mmap information:\n".print
      "frames=".print; cnt.println
    }
    (cnt < 2).if {
      "Insufficient buffer memory.\n".print
    }
    0.to (cnt-1) do { b:Int
      `memset(&buf, 0, sizeof(buf))`
      `buf.type   = V4L2_BUF_TYPE_VIDEO_CAPTURE`
      `buf.memory = V4L2_MEMORY_MMAP`
      `buf.index  = @b`
      (Dev.ioctl fd cmd `VIDIOC_QUERYBUF`:Int ptr `&buf`:Int = -1).if {
        "Error querying buffer ".print; b.println
        "VIDIOC_QUERYBUF: ".print; String.errno.println
      }
      mlen.add_last (`buf.length`:Int)
      mbuf.add_last (`mmap(NULL, buf.length,PROT_READ | PROT_WRITE, MAP_SHARED, @f, buf.m.offset)`:C_array Uint8)
      (mbuf.last = `MAP_FAILED`:C_array Uint8).if {
        "Error mapping buffer 0".println
        "mmap: ".print; String.errno.println
        free_mmap
      }
      (verbose).if {
        b.print; " length=".print; mlen.last.println
      }
      
      (Dev.ioctl fd cmd `VIDIOC_QBUF`:Int ptr `&buf`:Pointer = -1).if {
        "VIDIOC_QBUF: ".print; String.errno.println
        free_mmap
      }
    }
    `type = V4L2_BUF_TYPE_VIDEO_CAPTURE`
    (Dev.ioctl fd cmd `VIDIOC_STREAMON`:Int ptr `&type`:Pointer = -1).if {
      "Error starting stream.\n".print
      "VIDIOC_STREAMON: ".print; String.errno.println
      free_mmap
    }
    /*
    0.to (mbuf.upper) do { b:Int
      `buf.type   = V4L2_BUF_TYPE_VIDEO_CAPTURE`
      `buf.memory = V4L2_MEMORY_MMAP`
      `buf.index  = @b`
      (DEV.ioctl fd cmd `VIDIOC_QBUF`:Int ptr `&buf`:Pointer = -1).if {
        "VIDIOC_QBUF: ".print; STRING.errno.println
        free_mmap
        exit (-1)
      }
      `type = V4L2_BUF_TYPE_VIDEO_CAPTURE`
      (DEV.ioctl fd cmd `VIDIOC_STREAMON`:Int ptr `&type`:Pointer = -1).if {
        "Error starting stream.\n".print
        "VIDIOC_STREAMON: ".print; STRING.errno.println
        free_mmap
        exit (-1)
      }
    };*/
  )
  
