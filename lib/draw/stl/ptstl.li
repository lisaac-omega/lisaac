Header
  + name := Flat Ptstl
Inherit
  - parent_clone:Clone := Clone
  
Mapping,Public
  + xn:Real32
  + yn:Real32
  + zn:Real32
  
  + x1:Real32
  + y1:Real32
  + z1:Real32
  
  + x2:Real32
  + y2:Real32
  + z2:Real32
  
  + x3:Real32
  + y3:Real32
  + z3:Real32
  
  + ctrl:Uint16
  
Public
  
  - x_min:Real32 <- x1.min x2.min x3
  - y_min:Real32 <- y1.min y2.min y3
  - z_min:Real32 <- z1.min z2.min z3
  
  - x_max:Real32 <- x1.max x2.max x3
  - y_max:Real32 <- y1.max y2.max y3
  - z_max:Real32 <- z1.max z2.max z3
  
  - gx:Real32 <- (x1+x2+x3) / 3
  - gy:Real32 <- (y1+y2+y3) / 3
  - gz:Real32 <- (z1+z2+z3) / 3
  
  - translate (tx,ty,tz:Real32) <-
  (
    (x1,y1,z1) := (x1 + tx, y1 + ty, z1 + tz)
    (x2,y2,z2) := (x2 + tx, y2 + ty, z2 + tz)
    (x3,y3,z3) := (x3 + tx, y3 + ty, z3 + tz)
  )
  
  - rotate_x_p90 <-
  (
    (z1,z2,z3) := (y1,y2,y3)
    (y1,y2,y3) := (- Old z1, - Old z2, - Old z3)
  )
  
  - rotate_x_m90 <-
  (
    (z1,z2,z3) := (-y1,-y2,-y3)
    (y1,y2,y3) := (Old z1, Old z2, Old z3)
  )
    
Public
  
  - print <-
  (
    '['.print
    xn.print; ';'.print
    yn.print; ';'.print
    zn.print
    ']'.print
    '('.print; x1.print; ';'.print; y1.print; ';'.print; z1.print; ')'.print
    '('.print; x2.print; ';'.print; y2.print; ';'.print; z2.print; ')'.print
    '('.print; x3.print; ';'.print; y3.print; ';'.print; z3.print; ')'.print
    '\n'.print
  )
    
  
