Header
  + name := Constant_pen
Inherit
  
  - parent_clone:Clone := Clone
  
Public
  
  - pen_gl:Pen_gl
  
  - tess_tol:Real32
  - dist_tol:Real32
  
  - eq (x1,y1:Real32) and (x2,y2:Real32) :Boolean <-
  ( + dx,dy:Real32
    (dx,dy) := (x2 - x1,y2 - y1)
    // BSBS: Save in tmp := dist_tol * dist_tol
    dx*dx + dy*dy < dist_tol * dist_tol 
  )

  // PEN
  
  - pt_corner:Int     := 01h
  - pt_left:Int       := 02h
  - pt_bevel:Int      := 04h
  - pr_innerbevel:Int := 08h
        
  - cst_ccw:Int := 1; // Winding for solid shapes
  - cst_cw :Int := 2; // Winding for holes
  - cst_hole:Int := 2
  
  - butt:Int   := 0; // rectangle limit (cap)  [-
  - round:Int  := 1; // circle (join+cap)      O- or -O-
  - square:Int := 2; // rectangle center (cap) [-
  - bevel:Int  := 3; // K (join)
  - miter:Int  := 4; // < (join)
  
  // Length proportional to radius of a cubic bezier 
  // handle for 90deg arcs.
  - cst_kappa90:Real32 := 0.5522847493
  
  // Horizontal align
  - align_left:Int  := 1<<0; // Default, align text horizontally to left.
  - align_center:Int:= 1<<1; // Align text horizontally to center.
  - align_right:Int := 1<<2; // Align text horizontally to right.
  // Vertical align
  - align_top:Int      := 1<<3; // Align text vertically to top.
  - align_middle:Int   := 1<<4; // Align text vertically to middle.
  - align_bottom:Int   := 1<<5; // Align text vertically to bottom.
  - align_baseline:Int := 1<<6; // Default, align text vertically to baseline.
  
  // COMPOSITE_OPERATION_STATE
  
  - source_over:Int := 0
  - source_in:Int   := 1
  - source_out:Int  := 2
  - atop:Int        := 3
  - destination_over:Int := 4
  - destination_in:Int   := 5
  - destination_out:Int  := 6
  - destination_atop:Int := 7
  - lighter:Int          := 8
  - cst_copy:Int         := 9
  - xor:Int              := 10
  
  - cst_zero:Int               := 000_0000_0001b
  - cst_one:Int                := 000_0000_0010b
  - cst_src_color:Int          := 000_0000_0100b
  - cst_one_minus_src_color:Int:= 000_0000_1000b
  - cst_dst_color:Int          := 000_0001_0000b
  - cst_one_minus_dst_color:Int:= 000_0010_0000b
  - cst_src_alpha:Int          := 000_0100_0000b
  - cst_one_minus_src_alpha:Int:= 000_1000_0000b
  - cst_dst_alpha:Int          := 001_0000_0000b
  - cst_one_minus_dst_alpha:Int:= 010_0000_0000b
  - cst_src_alpha_saturate:Int := 100_0000_0000b
  
  // PEN_GL
      
  - antialias:Int       := 001b
  - stencil_strokes:Int := 010b
  - debug:Int           := 100b

  - image_nodelete:Int := 1<<16

  - loc_viewsize:Int := 0
  - loc_tex:Int      := 1
  - loc_frag:Int     := 2
  - max_locs:Int     := 3

  - shader_fillgrad:Int := 0
  - shader_fillimg:Int  := 1
  - shader_simple:Int   := 2
  - shader_img:Int      := 3

  - frag_binding:Int    := 0
  
  // PEN_CALL
  
  - cst_none:Int      := 0
  - cst_fill:Int      := 1
  - cst_convexfill:Int:= 2
  - cst_stroke:Int    := 3
  - cst_triangles:Int := 4
  
  // Image
  
  // Generate mipmaps during creation of the image.
  - image_generate_mipmaps:Int := 1<<0
  
  // Repeat image in X or Y direction.
  - image_repeatx:Int := 1<<1
  - image_repeaty:Int := 1<<2
  
  - image_flipy:Int   := 1<<3; // Flips (inverses) image in Y direction when rendered.
  - image_premultiplied:Int := 1<<4; // Image data has premultiplied alpha.
        
  // TEXTURE
  
  - texture_alpha:Int := 01h
  - texture_rgba:Int  := 02h
  
  - max_fontimages:Int := 4
  - max_fontimage_size:Int := 2048
  
  
