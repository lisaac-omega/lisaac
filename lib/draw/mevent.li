Header
  + name := Flat Mevent
- include := `#include <time.h>`;
  
Mapping, Public
  
  + x:Real32
  + y:Real32
  + time:Real32
  
Public
  
  - d:Real32 <- (x*x + y*y).sqrt
  
  - make (px,py:Real32) :Self <-
  (
    (x,y) := (px,py)
    time := `(float)clock()/CLOCKS_PER_SEC`
    self
  )
  
  - delta (px,py:Real32) :Self <-
  (
    (x,y) := (px - Mevent.x,py - Mevent.y)
    time := `(float)clock()/CLOCKS_PER_SEC` - Mevent.t
    self
  )
