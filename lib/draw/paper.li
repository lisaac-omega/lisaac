  - put_window_icon w:Pointer <-
  ( + img:C_array Uint32
    img := icon
    `{ GLFWimage img`    
    `img.width = 48; img.height = 48; img.pixels = (unsigned char *)@img`
    `glfwSetWindowIcon(@w,1,&img)`
    `}`
  )
  
Public
  
  - refresh_all <- wins.foreach { w:Window; w.ask_refresh; }
  
  - is_gl:Boolean <- `lisaac_gl`:Int = 1
  
  - flag_refresh:Boolean
  - refresh_again <- ( flag_refresh := True; )
  //- new_event_empty <- ( flag_refresh := True; ); //`glfwPostEmptyEvent()`
  
  - create_window (w,h:Int) title t:String_alias for winobj:Window :Pointer <-
  ( + result:Pointer
    (lip "target" str != "android").if {
      + win,mon:Pointer
      + tc:C_array Char
      + ww,hh:Int
      (wins.is_empty).if { init; }
      tc := t.to_external
      (winobj.fullscreen).if {      
        mon := `glfwGetPrimaryMonitor()`:Pointer
        `const GLFWvidmode* mode = glfwGetVideoMode(@mon)`
        ww := `mode->width`:Int
        hh := `mode->height`:Int
        winobj.size (ww,hh)
      } else { (ww,hh) := (w,h); }
      win := `glfwCreateWindow((int)@ww,(int)@hh,@tc, @mon, NULL)`:Pointer
      (win.is_null).if {
        "Paper: Window not open.".println
        `glfwTerminate()`
        exit exit_failure_code
      }
      `glfwSetWindowFocusCallback(@win, on_window_focus_c)`;
      //"Create window ".print; w.print; "x".print; h.println
      (lip "target" str = "apple").if_false { put_window_icon win; }
      `glfwSetKeyCallback(@win, intern_key)`
      `glfwSetCursorPosCallback(@win,(GLFWcursorposfun)mouse_move)`
      `glfwSetMouseButtonCallback(@win,(GLFWmousebuttonfun)mouse_button)`
      `glfwSetScrollCallback(@win,(GLFWscrollfun)mouse_scroll)`
      `glfwMakeContextCurrent(@win)`
      `glfwSetWindowRefreshCallback(@win,(GLFWwindowrefreshfun) refresh_callback)`
      `glfwSetWindowCloseCallback(@win, on_close_c)`;
      (lip "target" str = "windows").if {
        if (`gladLoadGL()`:Int = 0) then { // WinMerde
          "Failed to initialize GLAD\n".print
          exit 1
        }
      }
      //`glfwSwapInterval(1)`
      `glfwSetWindowUserPointer(@win, (void *)@winobj)`
      result := win
    }
    wins.add_last winobj    
    result
  )
  
  - destroy_window w:Window <-
  (lip "target" str != "android").if {
    + ptr:Pointer
    + i:Int
    i := wins.upper
    {wins.at i != w}.while_do { i := i - 1; }
    wins.remove i
    ptr := w.win_ptr
    w.set_win_ptr NULL
    `glfwSetCursor(@ptr, NULL)`;
    `glfwDestroyWindow(@ptr)`
  }
  
  - destroy_all_window <-
  (lip "target" str != "android").if {
    wins.foreach_backward { w:Window; destroy_window w; }
    `glfwPollEvents()`
    `glfwTerminate()`
  }
  
  - run <-
  ( + ptr:Pointer
    (lip "target" str != "android").if {
      (lip "target" str = "web").if {
        ptr := wins.first.win_ptr        
        `emscripten_set_main_loop_arg(generate_frame,@ptr, 0, 0/*false*/)`
      } else {
        {! window_should_close}.while_do {
          //`glfwPollEvents()`          
          (flag_refresh).if {          
            flag_refresh := False
            //"wins.count:".print; wins.count.println
            0.to (wins.upper) do { i:Int
              generate_frame (wins.at i.win_ptr)
            }
            `glfwWaitEventsTimeout(1.0/60.0)` // ~60 Hz            
          } else {
            `glfwWaitEvents()`
          }
        }
        //PEN.delete
        exit 0
      }
    }
  )
  
  - exit c:Int <-
  (    
    destroy_all_window
    System.exit c
  )
      
  // Position/Resize window
  
  - get_screen_size:(Int,Int) <-
  ( + xm,ym,n,wt,ht:Int
    `int n; GLFWmonitor** monitors = glfwGetMonitors(&n)`
    n := `n`:Int
    0.to (n-1) do { i:Int
      `const GLFWvidmode* mode = glfwGetVideoMode(monitors[@i])`
      `int x, y, w, h; glfwGetMonitorWorkarea(monitors[i], &x, &y, &w, &h)`
      (xm,ym) := (`x+w`:Int,`y+h`:Int)
      (xm > wt).if { wt := xm; }
      (ym > ht).if { ht := ym; }
    }
    wt,ht
  )
  
  - set_window win:Pointer pos (x,y:Int) <-
  (
    (lip "target" str != "android").if {      
      `glfwSetWindowPos(@win,@x,@y)`
    }
  )
  
  - get_window_pos win:Pointer :(Int,Int) <-
  ( + x,y:Int
    (lip "target" str != "android").if {
      `{ int x,y; glfwGetWindowPos(@win,&x,&y)`
      x := `x`:Int; y := `y`:Int
      `}`
    }
    x,y
  )
  
  - set_window win:Pointer size (w,h:Int) <-
  (
    (lip "target" str != "android").if {  
      `glfwSetWindowSize(@win,@w,@h)`
    }
  )
  
  - get_window_size w:Pointer :(Int,Int) <-
  ( + ww,hh:Int
    (lip "target" str = "android").if {
      (ww,hh) := (screen_width,screen_height)
    } else {
      `{ int ww,wh; glfwGetWindowSize(@w, &ww, &wh)`
      (ww,hh) := (`ww`:Int, `wh`:Int)
      `}`
    }
    ww,hh
  )
  
  - get_focus win:Pointer :Boolean <-
  ( + res:Boolean
    (lip "target" str = "android").if {
      res := True
    } else {
      res := `glfwGetWindowAttrib(@win,GLFW_FOCUSED)`:Int != 0
    }
    res
  )
  
  // Set cursor
  
  - create_cursor img:C_array Uint32 size (w,h:Int) hot (x,y:Int) :Pointer <-
  ( + result:Pointer
    (lip "target" str != "android").if {
      `{GLFWimage cursor`
      `cursor.width = @w; cursor.height = @h; cursor.pixels = (unsigned char *)@img`
      result := `glfwCreateCursor(&cursor,@x,@y)`:(Pointer)
      `}`
    }
    result
  )
  
  - get_cursor v:Int :Pointer <-
  ( + res:Pointer
    (lip "target" str != "android").if {
      res := `glfwCreateStandardCursor(@v)`:Pointer
    }
    res
  )
  
  - set_cursor w:Pointer img p:Pointer <-
  (
    (lip "target" str != "android").if {
      `glfwSetCursor(@w,@p)`
    }
  )
  
  - set_cursor w:Pointer pos (x,y:Int) <-
  (
    (lip "target" str != "android").if {
      `glfwSetCursorPos(@w,@x,@y)`
    }
  )
  
  - get_cursor_pos w:Pointer :(Int,Int) <-
  ( + x,y:Int
    (lip "target" str != "android").if {
      `{ double x,y; glfwGetCursorPos(@w,&x,&y)`
      (x,y) := (`x`:Int, `y`:Int)
      `}`
    }
    x,y
  )
  
  // Clipboard Support
  
  - get_clipboard_in buf:String_buffer :Boolean <-
  ( + tab:C_array Char
    + win:Pointer
    win := wins.first.win_ptr
    tab := `glfwGetClipboardString(@win)`:C_array Char
    (tab.is_not_null).if {      
      buf.from_external_copy tab
    }
  )
  
  - set_clipboard buf:String <-
  ( + tab:C_array Char
    + win:Pointer
    win := wins.first.win_ptr
    tab := buf.to_external
    `glfwSetClipboardString(@win,@tab)`
  )
  
Public
          
  - framebuffer_size w:Pointer :(Int,Int) <-
  ( `int fbw,fbh; glfwGetFramebufferSize(@w, &fbw, &fbh)`
    `fbw`:Int,`fbh`:Int
  )
  
  - li_refresh_callback w:Pointer :Int <-
  ( 
    (lip "target" str != "android").if {  
      + win_width,win_height:Int
      + fb_width,fb_height:Int
      + px_ratio:Real64
      + me:Window
      + rl,gl,bl,al:Uint8
      
      me := get_win w
      //"Call back:".print; me.id_name.println
      `glfwMakeContextCurrent(@w)`
      
      (win_width,win_height) := get_window_size w
      (fb_width,fb_height) := framebuffer_size w
      px_ratio := fb_width.to_real64 / win_width.to_real64
      //px_ratio.println
      // Update and render
      
      `glViewport(0, 0, @fb_width, @fb_height)`
      ((flag & transparent) = 0).if {
        (rl,gl,bl,al) := (0,0,0,255)
        `glClearColor(@rl,@gl,@bl,@al)`
      }
      `glClear(GL_COLOR_BUFFER_BIT|GL_DEPTH_BUFFER_BIT|GL_STENCIL_BUFFER_BIT)`
      Pen_gl.gl_enable (`GL_BLEND`:Int)
      Pen_gl.gl_blend_func (`GL_SRC_ALPHA`:Int,`GL_ONE_MINUS_SRC_ALPHA`:Int)
      //PEN_GL.gl_enable (`GL_CULL_FACE`:Int)
      Pen_gl.gl_disable (`GL_DEPTH_TEST`:Int)
      ((me.width.to_int != win_width) || {me.height.to_int != win_height}).if {
        me.size (win_width,win_height)
      }
      //win_width.print; ' '.print; win_height.println
      me.draw_all
      /*DIV_OUT.draw_stack.foreach { d:DIV
        d.draw pen
      };*/
      
      //Color.stack.clear
      `glfwSwapBuffers(@w)`
      //`glfwPollEvents()`
      //`glfwSwapInterval(1)`; // Pour eviter des dechirure de l'ecran (marche pas).
    }
    0
  )
    
External
  
  - on_window_focus (w:Pointer,f:Char) <-
  ( - count:Int
        
    (f != '\0').if {
      count := count + 1;
      (count = 1).if { wins.first.set_have_the_focus True }
    } else {
      count := count - 1;
      (count = 0).if { wins.first.set_have_the_focus False }
    }
  )
  
  - on_close (w:Pointer) <- get_win w.on_close

  - generate_frame w:Pointer <-
  (        
    li_refresh_callback w
  )
    
  - refresh_callback w:Pointer :Int <- ( li_refresh_callback w)
