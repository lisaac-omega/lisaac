Header
  + name := Flat Color
Inherit
  
  - parent_clone:Clone := Clone

Private
  
  //- stack:Array Color := Array Color.create_with_capacity 16; // BUG (ne sert a rien !!)
  
Mapping, Public

  + rf:Real32
  + gf:Real32
  + bf:Real32
  + af:Real32
  
  - ri:Int <- (rf*255.0).to_int
  - gi:Int <- (gf*255.0).to_int
  - bi:Int <- (bf*255.0).to_int
  - ai:Int <- (af*255.0).to_int
  
Public
  
  - none:Color   := rgbaf (0,0,0,0)
  
  // Color list:
  - black:Color := rgb (0,0,0)
  - blue:Color := rgb(0,0,0FFh)
  - brown:Color := rgb(096h,04Bh,0)
  - cyan:Color := rgb(0,0FFh,0FFh)
  - chocolate:Color := rgb(0D2h,069h,01Eh)
  - dark_orange:Color := rgb(0FFh,08Ch,0)
  - emerald_green:Color := rgb(050h,0C8h,078h)
  - gray:Color := rgb (80h,80h,80h)
  - green:Color := rgb(0,0FFh,0)
  - light_gray:Color := rgb(0D3h,0D3h,0D3h)
  - leaf_green:Color := rgb(022h,08Bh,022h)
  - magenta:Color:= rgb(0FFh,0,0FFh)
  - orange:Color := rgb(0FFh,080h,0)
  - peru:Color := rgb(0CDh,085h,03Fh)
  - pink:Color := rgb(0FFh,0C0h,0CBh)
  - red:Color := rgb(0FFh,0,0)
  - saddle_brown:Color := rgb(08Bh,045h,013h)
  - white:Color := rgb(0FFh,0FFh,0FFh)
  - yellow:Color := rgb(0FFh,0FFh,0)
  
  - list:Array Color := 
  ( + result:Array Color
    result := new Array Color of (black, blue, brown, cyan, chocolate, dark_orange, emerald_green,
       gray, green, light_gray, leaf_green, magenta, orange, peru, pink, red, saddle_brown, white, yellow)
    result
  )
  
  //  Other:
  
  - is_black:Boolean <- ((rf=0) && {gf=0} && {bf=0} && {af=0})
  
  - rgb (pr,pg,pb:Uint8) :Self <- rgba (pr,pg,pb,255)

  - rgbf (pr,pg,pb:Real32) :Self <- rgbaf (pr,pg,pb,1.0)
  
  - rgba (pr,pg,pb,pa:Uint8) :Color <-
  (
    rgbaf (
      pr.to_real32/255,pg.to_real32/255,
      pb.to_real32/255,pa.to_real32/255
    )
  )

  - rgbaf (pr,pg,pb,pa:Real32) :Color <-
  ( //+ result:Color
    //stack.add_last Color;    // BUG
    //result := stack.last; //pop
    (rf,gf,bf,af) := (pr,pg,pb,pa)
    self
  )
  
  /*
  - make (pr,pg,pb,pa:Real32) <-
  (
    (rf,gf,bf,af) := (pr,pg,pb,pa)
  )
  */
  //- set_a pa:Uint8 <- ( af := pa.to_real32/255; )
    
  - set_af pa:Real32 :Color <- Color rgbaf (rf,gf,bf,pa)
  
  - to_gray:Color <-
  ( + g:Real32
    g := (rf + gf + bf) / 9.0 + (3.0/9.0)
    Color rgbaf (g,g,g,af)
  )
    
  - premul_color:Color <-
  ( 
    (rf,gf,bf) := (rf*af,gf*af,bf*af)
    self
  )
  
  - lerp_rgba c:Self coef u:Real32 :Color <-
  ( + uu,uui:Real32
    
    uu  := u.clamp 0 and 1
    uui := 1.0 - uu
    Color rgba(uui*rf + uu*c.rf, uui*gf + uu*c.gf, uui*bf + uu*c.bf, uui*af + uu*c.af)
  )

  - hsl (h,s,l:Real32) :Color <- hsla (h,s,l) alpha 255
  
  - hsla (h,s,l:Real32) alpha pa:Uint8 :Color <- 
  // BSBS: Calcul en entier
  ( + m1,m2,ss,ll,hh,aa,rr,gg,bb:Real32
    
    hh := h % 1
    (hh < 0).if { hh := hh + 1; }
    ss := s.clamp 0 to 1
    ll := l.clamp 0 to 1
    (ll <= 0.5).if {
      m2 := ll * (1.0 + ss)
    } else {
      m2 := ll + ss - ll * ss
    }
    m1 := 2.0 * ll - m2
    rr := hue (hh + 1.0/3) with (m1,m2).clamp 0 to 1
    gg := hue  hh          with (m1,m2).clamp 0 to 1
    bb := hue (hh - 1.0/3) with (m1,m2).clamp 0 to 1
    aa := pa.to_real32 / 255
    Color rgbaf (rr,gg,bb,aa)
  )
  
Paint
  
  - mul_a c:Real32 :Color <-
  (
    af := c * af
    self
  )  
  
Private
  
  - hue hh:Real32 with (m1,m2:Real32) :Real32 <-
  ( + h,result:Real32
    (hh < 0).if   { h := hh + 1; }.elseif
    {hh > 1} then { h := hh - 1; } else {
      h := hh
    }
    (h < 1.0/6).if {
      result := m1 + (m2 - m1) * h * 6
    }.elseif {h < 3.0/6} then {
      result := m2
    }.elseif {h < 4.0/6} then {
      result := m1 + (m2 - m1) * (2.0/3 - h) * 6
    } else {
      result := m1
    }
    result
  )
  
Public
  
  - append_in b:String_buffer <-
  (
    b.append "rgb("
    ri.append_in b
    b.add_last ','
    gi.append_in b
    b.add_last ','
    bi.append_in b
    b.add_last ')'
  )
  
  // Comparison
  
  - too_similar other:Color threshold t:Real32 :Boolean <-
  // 
  //  Similarity threshold in the range [0.0, 1.0].
  //  Smaller values require colors to be almost identical.
  //  Larger values require colors to be more distinct.
  //  A value around 0.20f is generally a good choice for games.
  ( + drf,dgf,dbf,dist:Real32
    drf := rf - other.rf
    dgf := gf - other.gf
    dbf := bf - other.bf
    dist := (0.3*drf*drf + 0.59*dgf*dgf + 0.11*dbf*dbf).sqrt 
    dist < t
  )
  