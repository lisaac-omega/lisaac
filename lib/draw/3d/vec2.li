Header
  + name := Exact Vec2
Insert  
  - parent_vec:Vec := Vec
  
Self  
  - dim:Int := 2
  
  - free_list:Array Vec2 := Array Vec2.create_with_capacity 4
  
Mapping, Public 
  + x:Real32
  + y:Real32
  
Public
  
  - create:Self <-
  ( + result:Self
    (free_list.is_empty).if {
      result := clone
    } else {
      result := free_list.pop
    }
    result
  )
  
  - free <- free_list.add_last self
     
  - make (px,py:Real32) <- ( (x, y) := (px,py); )
