  )
  
  - mul_quat q:Vec4 <-
  ( + t0,t1,t2:Vec3
    //  XXX: The way this is written only works for orthogonal matrices. 
    // TODO: Take care of non-orthogonal case.
    t0 := q.mul_vec3 (c0.xyz)
    t1 := q.mul_vec3 (c1.xyz)
    t2 := q.mul_vec3 (c2.xyz)
    c0.put_xyz t0
    c1.put_xyz t1
    c2.put_xyz t2
    t0.free; t1.free; t2.free
  )

  - print <-
  (    
    0.to 3 do { y:Int
      '['.print
      0.to 3 do { x:Int
        x x y y.print
        ' '.print
      }
      "]\n".print
    }
    '\n'.print
  )
  
  - print_cm <-
  (    
    0.to 3 do { y:Int
      '['.print
      0.to 3 do { x:Int
        x x y y.to_cm.print
        ' '.print
      }
      "]\n".print
    }
    '\n'.print
  )
