//  ( + loc:Int32
//    loc := pen_gl.gl_get_uniform_location (id, name)
//    not_yet_implemented
    //pen_gl.gl_uniform_matrix3fv(loc, 1, GL_FALSE, &mat[0][0])
//  )

  - set name:String_alias mat4 mat:Mat4x4 <-
  ( + loc:Int32
    loc := pen_gl.gl_get_uniform_location (id, name)
    pen_gl.gl_uniform_matrix4fv(loc,mat)
  )
