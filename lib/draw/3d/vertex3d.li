Header
  + name := Flat Vertex3d
Insert
  
  - parent_clone:Clone := Clone
  
Mapping  
  + point:Flat Vec3
//  + norm:Flat VEC3
  
Public
  
  - make (x,y,z:Real32) /*norm (nx,ny,nz:REAL_32)*/ <-
  (
    point.make (x,y,z)
//    norm.make (nx,ny,nz)
  )
  
  - print <-
  (
    '{'.print; point.print; /*','.print; norm.print;*/ '}'.print
  )
