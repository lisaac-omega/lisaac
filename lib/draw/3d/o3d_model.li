Header
  + name := O3d_model
Inherit
  - parent_clone:Clone := Clone
  
Public
  
  + lower:Int
  + upper:Int
  
  + o:Vec4
  
  + g:Vec4
  
  - set (x,y,z:Real32) gravity (gx,gy,gz:Real32) low l:Int up u:Int :O3d_model <-
  (
    (o,g) := (Vec4.create,Vec4.create)
    o.make (x,y,z,1)
    g.make (gx,gy,gz,1)
    (lower,upper) := (l,u)
    self
  )
  
  - create_low l:Int up u:Int :O3d_model <-
  clone.set (0,0,0) gravity (0,0,0) low l up u
  
  - create (x,y,z:Real32) gravity (gx,gy,gz:Real32) low l:Int up u:Int :O3d_model <-
  clone.set (x,y,z) gravity (gx,gy,gz) low l up u
