Header
  + name := Vec
Insert
  - parent_clone:Clone := Clone
  
Self  
  - dim:Int <- ( abstract; 0)
        
Public
  - create:Self <-
  ( + result:Self
    abstract
    result
  )
  
  - free <- abstract
  
  - item i:Int :Real32    <- `((float *)@self)[@i]`:Real32
  
  - put e:Real32 to i:Int <- `((float *)@self)[@i] = @e`
  
  - dup:Self <-
  ( + result:Self
    result := create
    0.to (dim-1) do { i:Int
      result.put (item i) to i
    }
    result
  )
  
  - add other:Self <-
  ( 
    0.to (dim-1) do { i:Int
      put (item i + other.item i) to i
    }
  )
  
  - self:Self '+' other:Self :Self <-
  ( + result:Self
    result := dup
    result.add other
    result
  )
  
  - sub other:Self <-
  ( 
    0.to (dim-1) do { i:Int
      put (item i - other.item i) to i
    }
  )
  
  - self:Self '-' other:Self :Self <-
  ( + result:Self
    result := dup
    result.sub other
    result
  )
  
  - mul_scale scale:Real32 <-
  ( 
    0.to (dim-1) do { i:Int
      put (item i * scale) to i
    }
  )
  
  - self:Self '*#' scale:Real32 :Self <-
  ( + result:Self
    result := dup
    result.mul_scale scale
    result
  )
  
  - self:Self '#*' other:Self :Real32 <-
  ( + result:Real32
    0.to (dim-1) do { i:Int
      result := result + (item i * other.item i)
    }
    result
  )
  
  - length:Real32 <- (self #* self).sqrt
  
  - normalize <-
  ( + k:Real32
    k := 1.0 / length
    mul_scale k
  )
  
  - min other:Self <-
  ( 
    0.to (dim-1) do { i:Int
      put (item i.min (other.item i)) to i
    }
  )
  
  - max other:Self <-
  ( 
    0.to (dim-1) do { i:Int
      put (item i.max (other.item i)) to i
    }
  )
  
  - print <-
  (
    "[ ".print
    0.to (dim-1) do { i:Int
      item i.print_format_c "%4.2f"; ' '.print
    }
    "]".print
  )
  
  - print_cm <-
  (
    "[ ".print
    0.to (dim-1) do { i:Int
      item i.to_cm.print; "cm ".print
    }
    "]".print
  )
