Header
  + name := Texture
Inherit
  
  - parent_clone:Clone := Clone
  
Public

  + id:Int
  + tex:Uint32
  + width:Int
  + height:Int
  + type:Int
  + flags:Int
  
  - set_tex t:Uint32 <- ( tex := t; )
  
  - create pid:Int size (w,h:Int) 
  type typ:Int flags f:Int :Self <-
  ( + result:Self
    result := clone
    result.make pid size (w,h) type typ flags f
    result    
  )
  
  - make pid:Int size (w,h:Int) 
  type typ:Int flags f:Int <-
  ( 
    id := pid
    (width,height) := (w,h)
    type := typ
    flags := f
  )
  
  /*
  - create_image_from_handle_gles3 (GLuint textureId, int w, int h, int imageFlags) :Int <-
  (
    GLNVGcontext* gl = (GLNVGcontext*)nvgInternalParams(ctx)->userPtr
    GLNVGtexture* tex = glnvg__allocTexture(gl)

    if (tex == ((void *)0)) return 0

    type  := texture_rgba
    tex   := texture_id
    flags := image_flags
    width := w
    height:= h
    
    tex.id
  )
