Header
  + name := Keyboard
/*GLFW - Keyboard Driver*/
Public 
  - cmd:Uint8 := 40h; // 0:CTRL 1:AltGr 2:Alt 3:Cmd 4:Shift 5:Cap 6:NumLock 7:Scrolllock
  
  - str:String_buffer := String_buffer.create 8
  
Private 
  - num_str:String_alias := "\0A7h\\0A8h\\0A9h\\0A0h\\0B9h\" 
  
  - hat:Char  // \0: Nothing, ^ or ¨
  
Paper
  
  - key k:Int code key:Int press press:Boolean mods mods:Uint8 <-
  ( + cm:Uint8
    + name:C_array Char
    + idx,knidx:Int
    + cc:Char   
    str.clear
    debug.if {
      k_mem := k
      key_mem := key
      press_mem := press
      mods_mem := mods
      "---- keyboard.li".print
      press.if {
        " press".print
      } 
      Out # " k:" # k # " key:" # key # " mods:" # mods
    }
    cm := cmd
    name := `glfwGetKeyName(@k,@key)`:C_array Char
    if (debug && {! name.is_null}) then {
      String.tmp { kn:String_buffer
        while {(name.at knidx) != '\0'} do {
          kn.add_last (name.at knidx)
          knidx := knidx + 1
        }
        Out # " glfwGetKeyName:" # kn
      }
    }
    if (name.is_null) then {
      press.if {        
        (k)
        .when `GLFW_KEY_SPACE`:Int then { cc := ' ' }
        .when `GLFW_KEY_ESCAPE`:Int then { (cm,cc) := (cm | key_cmd, '\27\') }
        .when `GLFW_KEY_ENTER`:Int or `GLFW_KEY_KP_ENTER`:Int then { (cm,cc) := (cm | key_cmd, '\0Ah\') }
        .when `GLFW_KEY_TAB`:Int to `GLFW_KEY_END`:Int then {
          (cm,cc) := (cm | key_cmd, "\t\bISRLDUPNBE".item (k - `GLFW_KEY_TAB`:Int))
        }
        .when `GLFW_KEY_CAPS_LOCK`:Int   then { cmd := cmd ^ cap }
        .when `GLFW_KEY_NUM_LOCK`:Int    then { cmd := cmd ^ num_lock }
        .when `GLFW_KEY_SCROLL_LOCK`:Int then { cmd := cmd ^ scroll_lock; }
      //.when `GLFW_KEY_PRINT_SCREEN`:Int then { }
      //.when `GLFW_KEY_PAUSE`:Int then { }
        .when `GLFW_KEY_F1`:Int to `GLFW_KEY_F12`:Int then {
          (cm,cc) := (cm | key_cmd, 'a'+#(k.to_int-`GLFW_KEY_F1`:Int))
        }
        .when `GLFW_KEY_LEFT_SHIFT`:Int or `GLFW_KEY_RIGHT_SHIFT`:Int     then { cmd := cmd | shift; }
        .when `GLFW_KEY_LEFT_CONTROL`:Int or `GLFW_KEY_RIGHT_CONTROL`:Int then { cmd := cmd | ctrl; }
      //.when `GLFW_KEY_LEFT_SUPER`:Int or `GLFW_KEY_RIGHT_SUPER`:Int then { cmd := cmd ^ shift; }
        .when `GLFW_KEY_LEFT_ALT`:Int  then { cmd := cmd | alt; }
        .when `GLFW_KEY_RIGHT_ALT`:Int then { cmd := cmd | alt_gr; }
      //.when `GLFW_KEY_MENU`:Int then { /*put ((cmd.to_uint16 << 8) | key_cmd | 'M'.to_uint8);*/ }
        (cc != '\0').if { str.add_last cc; }
      } else {
        (k)
        .when `GLFW_KEY_LEFT_SHIFT`:Int or `GLFW_KEY_RIGHT_SHIFT`:Int     then { cmd := cmd & (~shift); }
        .when `GLFW_KEY_LEFT_CONTROL`:Int or `GLFW_KEY_RIGHT_CONTROL`:Int then { cmd := cmd & (~ctrl); }
      //.when `GLFW_KEY_LEFT_SUPER`:Int or `GLFW_KEY_RIGHT_SUPER`:Int then { cmd := cmd ^ shift; }
        .when `GLFW_KEY_LEFT_ALT`:Int  then { cmd := cmd & (~alt); }
        .when `GLFW_KEY_RIGHT_ALT`:Int then { cmd := cmd & (~alt_gr); }
      }
    } else {
      //OUT # "ICI mods:" # mods # " k: " # k # " key:" # key # '\n'
      press.if {        
        ((cmd & num_lock = 0) && {k.in_range `GLFW_KEY_KP_0`:Int to `GLFW_KEY_KP_DECIMAL`:Int}).if {
          (cm,cc) := (cm | key_cmd, "IEDNL5RBUPS".item (k - `GLFW_KEY_KP_0`:Int))
          str.add_last cc
        }.elseif {cmd & alt_gr != 0} then {          
          (k.in_range 50 to 57).if { str.add_last ("~#{[|`\\^".item (k-50)); }
          .elseif {k = 48} then { str.add_last '@'; }.elseif {k = 45} then { str.add_last ']'; }
          .elseif {k = 61} then { str.add_last '}'; }.elseif {k = 69} then { str.append "€"; }
        }.elseif {(mods = 1) && {k = 92} && {key = 42}} then {          
          cm := 0; str.clear; str.append "£" // Shift ` Apple 
        }.elseif {(mods = 4) && {k = 93} && {key = 30}} then {          
          cm := 0; str.clear; str.append "€" // Option $ Apple 
        }.elseif {(mods = 4) && {k = 53} && {key = 23}} then {          
          cm := 0; str.clear; str.append "{" // Option ( Apple 
        }.elseif {(mods = 4) && {k = 45} && {key = 27}} then {          
          cm := 0; str.clear; str.append "}" // Option ) Apple 
        }.elseif {(mods = 4) && {k = 78} && {key = 45}} then {          
          cm := 0; str.clear; str.append "~" // Option n Apple 
        }.elseif {(mods = 5) && {k = 53} && {key = 23}} then {          
          cm := 0; str.clear; str.append "[" // Shift Option ( Apple 
        }.elseif {(mods = 5) && {k = 45} && {key = 27}} then {          
          cm := 0; str.clear; str.append "]" // Shift Option ) Apple 
        }.elseif {(mods = 5) && {k = 76} && {key = 37}} then {          
          cm := 0; str.clear; str.append "|" // Shift Option l Apple 
          //OUT # "\nIIII " # str # " XXXX\n"
        } else {
          str.append_utf8 name native         
          (cmd & (shift|cap) != 0).if {
            (str.first.is_lower).if {
              str.at 0 put (str.at 0 .to_upper)
            }.elseif {(k = 54) && {key = 22}} then {
              str.clear; str.add_last '6' // Shift § Apple
            }.elseif {(k = 56) && {key = 28}} then {
              str.clear; str.add_last '8' // Shift ! Apple 
            }.elseif {(k = 161) && {key = 10}} then {
              str.clear; str.add_last '#' // Shift @ Apple 
            }.elseif {(k = 61) && {key = 24}} then {
              str.clear; str.add_last '_' // Shift - Apple 
            } else {
              (str.count = 1).if {
                cc := str.first
                (cc = '^').if {
                  str.remove_last; str.append "¨"
                }.elseif {cc = '$'} then {
                  str.remove_last
                  if (key = 35) then { 
                    str.append "£"
                  }.elseif {key = 30} then {
                    /*mac*/ str.add_last '*'
                  }.elseif {key = 27} then {
                    /*hp*/ str.append "£"
                  } else {
                    Out # "keyboard.li key = " # key # '\n' 
                  }
                }.elseif {cc = ')'} then {
                  str.remove_last; str.append "°"
                }.elseif {cc = '!'} then {
                  str.remove_last; str.append "§"
                }.elseif {cc = '*'} then {
                  str.remove_last; str.append "µ"
                }.elseif {(idx := "&\"'(-_=,;:<^".last_index_of cc) != -1} then {
                  str.at 0 put ("134568+?./>".at idx)
                }
              } else {
                ? {str.count > 1}
                ((idx := num_str.last_index_of (str.at 1)) != -1).if {
                  str.at 0 put ("9720%".at idx); str.remove_last
                } else {
                  "keyboard.li:".print; str.at 1.to_uint8.print_hex; '\n'.print
                }
              }
            }
          }
          (hat = '\0').if {
            ((str.first = '^') || {str == "¨"}).if {             
              hat := str.first 
              str.clear
            }
          } else {
            ((idx := "eioua".last_index_of (str.first)) != -1).if {
              idx := (idx << 1) + 1
              str.clear
              str.add_last '\0C3h\'              
              str.add_last ((hat = '^').ok "êîôûâ" or "ëïöüä".at idx)
            } else {
              (hat = '^').if {                
                (str.first != '^').if { str.add_first hat }
              } else {
                (str !== "¨").if { str.prepend "¨" }
              }
            }
            hat := '\0'
          }
        }
      }
    }
    if (! str.is_empty) then {
      debug.if { 
        Out # " put:" # str # " cmd " # cm
      }
      put str cmd cm
    }
    debug.if {
      Out # "----\n"
    }
  )
  
Keyboard_check  
  - debug:Boolean <- False
  - set_debug b:Boolean <- debug := b
  - k_mem:Int
  - key_mem:Int
  - press_mem:Boolean
  - mods_mem:Uint8
   
Public  
  - record:Boolean
  
  //- macro_buffer:ARRAY Uint16 := ARRAY Uint16.create_with_capacity 32
  
  /*
  - set_record b:Boolean <-
  (
    b.if {
      record := True
      macro_buffer.clear
    } else {
      record := False
    }
  )
  
  - play <-
  ( 
    macro_buffer.foreach { k:Uint16
      PAPER.root.key_event k
    }
  );*/
  
  - listen w:Window <- win := w
  - win:Window
  
  - put s:String cmd c:Uint8 <-
  (
    if (record) then {
      //macro_buffer.add_last k
    }
    //"Key to String:".print; key_to_string s cmd c.println
    if (win != NULL) then { 
      win.key s cmd c 
    } else { 
      Paper.wins.first.key s cmd c 
    }
  )
      
  // Key code generate.

  // 0:CTRL 1:AltGr 2:Alt 3:Cmd 4:Shift 5:Cap 6:NumLock 7:ScrollLock
  - ctrl:        Uint8 := 01h
  - alt_gr:      Uint8 := 02h
  - alt:         Uint8 := 04h
  - key_cmd:     Uint8 := 08h
  - shift:       Uint8 := 10h
  - cap:         Uint8 := 20h
  - num_lock:    Uint8 := 40h
  - scroll_lock: Uint8 := 80h
  - key_of c:Char :Uint8 <- c.to_uint8
  - msk_cmd:Uint8 <- ctrl | alt | key_cmd
  
  - key_to_string s:String cmd cm:Uint8 in tmp:String_buffer <-
  ( 
    ((cm &    ctrl) != 0).if { tmp.append "Ctrl "  }
    ((cm &  alt_gr) != 0).if { tmp.append "AltGr " }
    ((cm &     alt) != 0).if { tmp.append "Alt "   }
    ((cm &   shift) != 0).if { tmp.append "Shift " }
    ((cm & key_cmd) != 0).if {
      (s.first)
      .when 'a' to 'l' then { tmp.add_last 'F'; ((s.first - 'a').to_int8+1).append_in tmp }
      .when 'U' then { tmp.append "Up"   }.when 'D' then { tmp.append "Down" }
      .when 'L' then { tmp.append "Left" }.when 'R' then { tmp.append "Right" }
      .when 'P' then { tmp.append "PgUp" }.when 'N' then { tmp.append "PgDown" }
      .when 'M' then { tmp.append "Menu" }.when 'S' then { tmp.append "Suppr" }
      .when 'B' then { tmp.append "Beg"  }.when 'E' then { tmp.append "End" }
      .when 'I' then { tmp.append "Inser" }
      .when '\09\'  then { tmp.append "Tab" }
      .when '\08\'  then { tmp.append "Del" }
      .when '\0Ah\' then { tmp.append "Enter" }
      .when '\27\'  then { tmp.append "Esc" }
    } else {
      (s.first = ' ').if { tmp.append "Space" } else { tmp.append s }
    }    
  )
