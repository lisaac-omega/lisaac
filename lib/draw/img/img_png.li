Header
  + name := Img_png
/*
    public domain 'baseline' PNG decoder (stb_image v2.30)
      simple implementation
       - only 8-bit samples (16-bit samples are reduced to 8 bits by @load)
       - no CRC checking
       - allocates lots of intermediate memory
       - avoids problem of streaming data between subsystems
       - avoids explicit window management
       performance
       - uses zlib, a PD zlib implementation with fast huffman decoding
  */

  - include := `
  extern int xorig[];
  extern int yorig[];
  extern int xspc[];
  extern int yspc[];
  `;

  - external := `
  int xorig[] = { 0,4,0,2,0,1,0 };
  int yorig[] = { 0,0,4,0,2,0,1 };
  int xspc[]  = { 8,8,4,4,2,2,1 };
  int yspc[]  = { 8,8,8,4,4,2,2 };
  `;
Inherit
  - parent_image:Image := Image

Public

  - xorig i:Int :Int <- `xorig[@i]`:Int
  - yorig i:Int :Int <- `yorig[@i]`:Int
  - xspc  i:Int :Int <- `xspc[@i]`:Int
  - yspc  i:Int :Int <- `yspc[@i]`:Int

  - f_none:Uint8 := 0
  - f_sub:Uint8  := 1
  - f_up:Uint8   := 2
  - f_avg:Uint8  := 3
  - f_paeth:Uint8:= 4
  // synthetic filter used for first scanline to avoid needing a dummy row of 0s
  - f_avg_first:Uint8   := 5

  + idata:C_array Uint8
  + expanded:C_array Uint8
  + out:C_array Uint8
  + depth:Int

  - get_chunk_header:Pngchunk <- Pngchunk.create_length get32be type get32be

  - check_png_header:Boolean <-
  ( + result:Boolean
    result := True
    0.to 7 do { i:Int
      (get8 != png_sig.at i).if { result := False; }
    }
    result.if_false { error := "bad png sig"; }
    result
  )

  - png_sig:C_array Uint8 :=
  ( + r:C_array Uint8
    r := C_array Uint8.create 8
    r.at 0 put 137; r.at 1 put 80; r.at 2 put 78; r.at 3 put 71
    r.at 4 put 13;  r.at 5 put 10; r.at 6 put 26; r.at 7 put 10
    r
  )

  - first_row_filter:C_array Uint8 :=
  ( + r:C_array Uint8
    r := C_array Uint8.create 5
    r.at 0 put f_none
    r.at 1 put f_sub
    r.at 2 put f_none
    r.at 3 put f_avg_first
    r.at 4 put f_sub; // Paeth with b=c=0 turns out to be equivalent to sub
    r
  )

  - paeth (a,b,c:Int) :Int <-
  // This formulation looks very different from the reference in the PNG spec, but is
  // actually equivalent and has favorable data dependencies and admits straightforward
  // generation of branch-free code, which helps performance significantly.
  ( + thresh,lo,hi,t0:Int
    thresh := c*3 - (a + b)
    (a < b).if { (lo,hi) := (a,b); } else { (lo,hi) := (b,a); }
    t0 := (hi <= thresh).ok lo or c
    (thresh <= lo).ok hi or t0
  )

  - depth_scale_table:C_array Uint8 :=
  ( + res:C_array Uint8
    res := C_array Uint8.create 9
    res.at 1 put 0FFh; res.at 2 put 055h
    res.at 4 put 011h; res.at 8 put 001h
    res
  )

  // adds an extra all-255 alpha channel
  // dest == src is legal
  // img_n must be 1 or 3
  - create_png_alpha_expand8 (dest,src:C_array Uint8, x:Int, n:Int) <-
  (
    (n = 1).if {
      (x-1).downto 0 do { i:Int
        dest.at (i*2+1) put 255
        dest.at (i*2+0) put (src.at i)
      }
    } else {
      ? {n = 3}
      (x-1).downto 0 do { i:Int
        dest.at (i*4+3) put 255
        dest.at (i*4+2) put (src.at (i*3+2))
        dest.at (i*4+1) put (src.at (i*3+1))
        dest.at (i*4+0) put (src.at (i*3+0))
      }
    }
  )

  // create the png data from post-deflated data
  - create_png_image_raw (praw:C_array Uint8, raw_len:Uint32, out_n:Int)
  to (x,y:Int) depth pdepth:Int color color:Int :Boolean <-
  ( + bytes,stride,img_len,img_width_bytes:Int
    + output_bytes,filter_bytes,width:Int
    + raw,filter_buf:C_array Uint8
    + result:Boolean
    bytes := (pdepth = 16).ok 2 or 1
    stride := x * out_n * bytes
    output_bytes := out_n * bytes
    filter_bytes := img_n * bytes
    width := x
    raw := praw
    ? {(out_n = img_n) || {out_n = img_n+1}}
    out := C_array Uint8.create (x * y * output_bytes); // extra bytes to write off the end into

    (! mad3sizes_valid(img_n, x, pdepth, 7)).if {
      result := error_false "too large"
    } else {
      img_width_bytes := ((img_n * x * pdepth) + 7) >> 3
      (! mad2sizes_valid(img_width_bytes, y, img_width_bytes)).if {
        result := error_false "too large"
      } else {
        img_len := (img_width_bytes + 1) * y
        (raw_len < img_len).if {
          result := error_false "not enough pixels"
        } else {
          result := True
        }
      }
    }
    result.if {
      // Allocate two scan lines worth of filter workspace buffer.
      filter_buf := C_array Uint8.create (img_width_bytes * 2)
      // Filtering for low-bit-pdepth images
      (pdepth < 8).if {
        filter_bytes := 1
        width := img_width_bytes
      }
      0.to (y-1) do { j:Int
        + cur,prior,dest:C_array Uint8
        + nk,filter:Int
        // cur/prior filter buffers alternate
        cur   := filter_buf + (j & 1)*img_width_bytes
        prior := filter_buf + ((~j) & 1)*img_width_bytes
        dest := out + stride*j
        nk := width * filter_bytes
        result.if {
          filter := raw.first
          raw := raw + 1
          // check filter type
          (filter > 4).if {
            result := error_false "invalid filter"
          }
        }
        result.if {
          // if first row, use special filter that doesn't sample previous row
          (j = 0).if { filter := first_row_filter.at filter; }
          // perform actual filtering
          (filter)
          .when f_none then {
            memcpy(cur, raw, nk)
          }
          .when f_sub then {
            memcpy(cur, raw, filter_bytes)
            filter_bytes.to (nk-1) do { k:Int
              cur.at k put (bytecast(raw.at k + cur.at (k-filter_bytes)))
            }
          }
          .when f_up then {
            0.to (nk-1) do { k:Int
              cur.at k put (bytecast(raw.at k + prior.at k))
            }
          }
          .when f_avg then {
            0.to (filter_bytes-1) do { k:Int
              cur.at k put (bytecast(raw.at k + (prior.at k >> 1)))
            }
            filter_bytes.to (nk-1) do { k:Int
              cur.at k put (bytecast(raw.at k + ((prior.at k.to_int + cur.at (k-filter_bytes)) >> 1)))
            }
          }
          .when f_paeth then {
            0.to (filter_bytes-1) do { k:Int
              cur.at k put (bytecast(raw.at k + prior.at k)); // prior[k] == stbi__paeth(0,prior[k],0)
            }
            filter_bytes.to (nk-1) do { k:Int
              cur.at k put (bytecast(raw.at k + paeth(cur.at (k-filter_bytes), prior.at k, prior.at (k-filter_bytes))))
            }
          }
          .when f_avg_first then {
            memcpy(cur, raw, filter_bytes)
            filter_bytes.to (nk-1) do { k:Int
              cur.at k put (bytecast(raw.at k + (cur.at (k-filter_bytes) >> 1)))
            }
          }
          raw := raw + nk

          // expand decoded bits in cur to dest, also adding an extra alpha channel if desired
          (pdepth < 8).if {
            + scale,inb:Uint8
            + in,o:C_array Uint8
            + nsmp:Int
            scale := (color = 0).ok (depth_scale_table.at pdepth) or 1; // scale grayscale values to 0..255 range
            in := cur
            o := dest
            nsmp := x*img_n
            // expand bits to bytes first
            (pdepth = 4).if {
              0.to (nsmp-1) do { i:Int
                ((i & 1) = 0).if { inb := in.first; in := in + 1; }
                o.at i put ((scale * (inb >> 4)).to_raw_uint8)
                inb := (inb << 4).to_raw_uint8
              }
            }.elseif {pdepth = 2} then {
              0.to (nsmp-1) do { i:Int
                ((i & 3) = 0).if { inb := in.first; in := in + 1; }
                o.at i put ((scale * (inb >> 6)).to_raw_uint8)
                inb := (inb << 2).to_raw_uint8
              }
            } else {
              ? {pdepth = 1}
              0.to (nsmp-1) do { i:Int
                ((i & 7) = 0).if { inb := in.first; in := in + 1; }
                o.at i put ((scale * (inb >> 7)).to_raw_uint8)
                inb := (inb << 1).to_raw_uint8
              }
            }
            // insert alpha=255 values if desired
            (img_n != out_n).if {
              create_png_alpha_expand8(dest, dest, x, img_n)
            }
          }.elseif {pdepth = 8} then {
            (img_n = out_n).if {
              memcpy(dest, cur, x*img_n)
            } else {
              create_png_alpha_expand8(dest, cur, x, img_n)
            }
          }.elseif {pdepth = 16} then {
            // convert the image data from big-endian to platform-native
            + dest16:C_array Uint16
            + c:C_array Uint8
            dest16 := Cast (C_array Uint8) To (C_array Uint16).on dest
            c := cur
            (img_n = out_n).if {
              0.to (x*img_n-1) do { i:Int
                dest16.at i put (big16 c)
                c := c + 2
              }
            }.elseif {img_n = 1} then {
              0.to (x-1) do { i:Int
                dest16.at (i*2)   put (big16 c)
                dest16.at (i*2+1) put 0FFFFh
                c := c + 2
              }
            } else {
              ? {img_n = 3}
              0.to (x-1) do { i:Int
                dest16.at (i*4)   put (big16 c)
                dest16.at (i*4+1) put (big16 (c+2))
                dest16.at (i*4+2) put (big16 (c+4))
                dest16.at (i*4+3) put 0FFFFh
                c := c + 6
              }
            }
          }
        }
      }
    }
    result
  )

  - big16 c:C_array Uint8 :Uint16 <- ((c.at 0.to_uint16) << 8) | c.at 1

  - create_png_image (pimage_data:C_array Uint8, pimage_data_len:Uint32,out_n,depth,color:Int,interlaced:Boolean) :Boolean <-
  ( + final,image_data:C_array Uint8
    + out_x,out_y,bytes,out_bytes:Int
    + image_data_len:Uint32
    + result:Boolean
    bytes := (depth = 16).ok 2 or 1
    out_bytes := out_n * bytes
    image_data := pimage_data
    image_data_len := pimage_data_len
    (! interlaced).if {
      result := create_png_image_raw(image_data, image_data_len, out_n) to (img_x, img_y) depth depth color color
    } else {
      // de-interlacing
      result := True
      final := C_array Uint8.create (img_x * img_y * out_bytes)
      0.to 6 do { p:Int
        + x,y:Int
        x := (img_x - xorig p + xspc p - 1) / xspc p
        y := (img_y - yorig p + yspc p - 1) / yspc p
        (result && {x != 0} && {y != 0}).if {
          + img_len:Uint32
          img_len := ((((img_n * x * depth) + 7) >> 3) + 1) * y
          result := create_png_image_raw (image_data, image_data_len, out_n) to (x, y) depth depth color color
          result.if {
            0.to (y-1) do { j:Int
              0.to (x-1) do { i:Int
                out_y := j * yspc p + yorig p
                out_x := i * xspc p + xorig p
                memcpy(final + out_y*img_x*out_bytes + out_x*out_bytes, out + (j*x+i)*out_bytes, out_bytes)
              }
            }
            image_data := image_data + img_len
            image_data_len := image_data_len - img_len
          }
        }
      }
      out := final
    }
    result
  )

  - compute_transparency (ptc:C_array Uint8, out_n:Int) <-
  ( + pixel_count:Int
    + p:C_array Uint8
    pixel_count := img_x * img_y
    p := out
    // compute color-based transparency, assuming we've
    // already got 255 as the alpha value in the output
    ? {(out_n = 2) || {out_n = 4}}
    (out_n = 2).if {
      0.to (pixel_count-1) do { i:Int
        p.at 1 put ((p.at 0 = ptc.at 0).ok 0 or 255)
        p := p + 2
      }
    } else {
      0.to (pixel_count-1) do { i:Int
        ((p.at 0 = ptc.at 0) && {p.at 1 = ptc.at 1} && {p.at 2 = ptc.at 2}).if {
          p.at 3 put 0
        }
        p := p + 4
      }
    }
  )

  - compute_transparency16 (ptc:C_array Uint16, out_n:Int) <-
  ( + pixel_count:Int
    + p:C_array Uint16
    pixel_count := img_x * img_y
    p := Cast (C_array Uint8) To (C_array Uint16).on out
    ? {(out_n = 2) || {out_n = 4}}
    (out_n = 2).if {
      0.to (pixel_count-1) do { i:Int
        p.at 1 put ((p.at 0 = ptc.at 0).ok 0 or 65535)
        p := p + 2
      }
    } else {
      0.to (pixel_count-1) do { i:Int
        ((p.at 0 = ptc.at 0) && {p.at 1 = ptc.at 1} && {p.at 2 = ptc.at 2}).if {
          p.at 3 put 0
        }
        p := p + 4
      }
    }
  )

  - expand_png_palette (pal:C_array Uint8, pal_img_n:Int) <-
  ( + pixel_count,n:Int
    + p, temp_out, orig:C_array Uint8
    pixel_count := img_x * img_y
    orig := out
    p := C_array Uint8.create (pixel_count * pal_img_n)
    // between here and free(out) below, exitting would leak
    temp_out := p
    (pal_img_n = 3).if {
      0.to (pixel_count-1) do { i:Int
        n := orig.at i.to_int * 4
        p.at 0 put (pal.at  n   )
        p.at 1 put (pal.at (n+1))
        p.at 2 put (pal.at (n+2))
        p := p + 3
      }
    } else {
      0.to (pixel_count-1) do { i:Int
        n := orig.at i.to_int * 4
        p.at 0 put (pal.at  n   )
        p.at 1 put (pal.at (n+1))
        p.at 2 put (pal.at (n+2))
        p.at 3 put (pal.at (n+3))
        p := p + 4
      }
    }
    out := temp_out
  )

  - unpremultiply_on_load:Boolean
  - de_iphone_flag:Boolean

  - set_unpremultiply_on_load flag:Boolean <-
  ( unpremultiply_on_load := flag; )

  - convert_iphone_png_to_rgb flag:Boolean <-
  ( de_iphone_flag := flag; )

  - de_iphone <-
  ( + pixel_count:Int
    + p:C_array Uint8
    + t,a,half:Uint8
    p := out
    pixel_count := img_x * img_y
    (img_out_n = 3).if {  // convert bgr to rgb
      0.to (pixel_count-1) do { i:Int
        t := p.at 0
        p.at 0 put (p.at 2)
        p.at 2 put t
        p := p + 3
      }
    } else {
      ? {img_out_n = 4}
      (unpremultiply_on_load).if {
        // convert bgr to rgb and unpremultiply
        0.to (pixel_count-1) do { i:Int
          a := p.at 3
          t := p.at 0
          (a != 0).if {
            half := a / 2
            p.at 0 put (((p.at 2.to_int * 255 + half) / a).to_raw_uint8)
            p.at 1 put (((p.at 1.to_int * 255 + half) / a).to_raw_uint8)
            p.at 2 put (((t.to_int * 255 + half) / a).to_raw_uint8)
          } else {
            p.at 0 put (p.at 2)
            p.at 2 put t
          }
          p := p + 4
        }
      } else {
        // convert bgr to rgb
        0.to (pixel_count-1) do { i:Int
          t := p.at 0
          p.at 0 put (p.at 2)
          p.at 2 put t
          p := p + 4
        }
      }
    }
  )

  - id (a,b,c,d:Char):Uint32 <-
  (
    (a.to_int.to_uint32 << 24) | (b.to_int.to_uint32 << 16) | (c.to_int.to_uint32 << 8) | d.to_int.to_uint32
  )

  - palette:C_array Uint8 := C_array Uint8.create 1024
  - tc:C_array Uint8 := C_array Uint8.create 3
  - tc16:C_array Uint16 := C_array Uint16.create 3

  - parse_png_file (scan,req_comp:Int) :Boolean <-
  ( + pal_img_n:Uint8
    + has_trans:Boolean
    + ioff, idata_limit, pal_len:Uint32
    + color:Int
    + interlace, first, stop, is_iphone, result:Boolean
    first := True
    expanded := NULL
    idata := NULL
    out := NULL
    tc.clear_all 2

    (! check_png_header).if {
      result := False
    }.elseif {scan = scan_type} then {
      result := True
    } else {
      result := True
      {! stop}.while_do {
        + c:Pngchunk
        c := get_chunk_header
        (c.type = id('C','g','B','I')).if {
          is_iphone := True
          skip (c.length)
        }.elseif {c.type = id('I','H','D','R')} then {
          + comp,filter,ilace:Int
          (! first).if {
            result := error_false "multiple IHDR"
          }.elseif {c.length != 13} then {
            result := error_false "bad IHDR len"
          } else {
            first := False
            img_x := get32be
            img_y := get32be
            depth := get8
            color := get8
            comp  := get8
            filter:= get8
            ilace := get8
            ((img_y > max_dimensions) || {img_x > max_dimensions}).if {
              result := error_false "too large"
            }.elseif {(depth != 1) && {depth != 2} && {depth != 4} && {depth != 8} && {depth != 16}} then {
              result := error_false "1/2/4/8/16-bit only"
            }.elseif {color > 6} then {
              result := error_false "bad ctype"
            }.elseif {(color = 3) && {depth = 16}} then {
              result := error_false "bad ctype"
            }.elseif {(color != 3) && {(color & 1) != 0}} then {
              result := error_false "bad ctype"
            }.elseif {comp != 0} then {
              result := error_false "bad comp method"
            }.elseif {filter != 0} then {
              result := error_false "bad filter method"
            }.elseif {ilace > 1} then {
              result := error_false "bad interlace method"
            }.elseif {(img_x = 0) || {img_y = 0}} then {
              result := error_false "0-pixel image"
            } else {
              (color = 3).if { pal_img_n := 3; }
              interlace := ilace = 1
              (pal_img_n = 0).if {
                img_n := (((color & 2) != 0).ok 3 or 1) + (((color & 4) != 0).ok 1 or 0)
                ((1 << 30) / img_x / img_n < img_y).if { result := error_false "too large"; }
              } else {
                // if paletted, then pal_n is our final components, and
                // img_n is # components to decompress/filter.
                img_n := 1
                ((1 << 30) / img_x / 4 < img_y).if { result := error_false "too large"; }
              }
            }
          }
        }.elseif {c.type = id('P','L','T','E')} then {
          (first).if {
            result := error_false "first not IHDR"
          }.elseif {c.length > 256*3} then {
            result := error_false "invalid PLTE"
          } else {
            pal_len := c.length / 3
            (pal_len * 3 != c.length).if {
              result := error_false "invalid PLTE"
            } else {
              0.to (pal_len-1) do { i:Int
                palette.at (i*4+0) put get8
                palette.at (i*4+1) put get8
                palette.at (i*4+2) put get8
                palette.at (i*4+3) put 255
              }
            }
          }
        }.elseif {c.type = id('t','R','N','S')} then {
          (first).if {
            result := error_false "first not IHDR"
          }.elseif {idata != NULL} then {
            result := error_false "tRNS after IDAT"
          }.elseif {pal_img_n != 0} then {
            (scan = scan_header).if {
              img_n := 4
              stop := True
            }.elseif {pal_len = 0} then {
              result := error_false "tRNS before PLTE"
            }.elseif {c.length > pal_len} then {
              result := error_false "bad tRNS len"
            } else {
              pal_img_n := 4
              0.to (c.length-1) do { i:Int
                palette.at (i*4+3) put get8
              }
            }
          }.elseif {(img_n & 1) = 0} then {
            result := error_false "tRNS with alpha"
          }.elseif {c.length != img_n*2} then {
            result := error_false "bad tRNS len"
          } else {
            has_trans := True
            (scan = scan_header).if {
              img_n := img_n + 1
              stop := True
            }.elseif {depth = 16} then {
              0.to ((img_n-1).min 2) do { k:Int
                tc16.at k put get16be; // copy the values as-is
              }
            } else {
              0.to ((img_n-1).min 2) do { k:Int
                // non 8-bit images will be larger
                tc.at k put (((get16be & 255) * depth_scale_table.at depth).to_raw_uint8)
              }
            }
          }
        }.elseif {c.type = id('I','D','A','T')} then {
          (first).if {
            result := error_false "first not IHDR"
          }.elseif {(pal_img_n != 0) && {pal_len = 0}} then {
            result := error_false "no PLTE"
          }.elseif {scan = scan_header} then {
            (pal_img_n != 0).if { img_n := pal_img_n; }
            stop := True
          }.elseif {c.length > (1 << 30)} then {
            result := error_false "IDAT size limit"
          }.elseif {(ioff + c.length).to_raw_int32 < ioff.to_raw_int32} then {
            result := False
          } else {
            (ioff + c.length > idata_limit).if {
              + idata_limit_old:Uint32
              idata_limit_old := idata_limit
              (idata_limit = 0).if { idata_limit := (c.length > 4096).ok (c.length) or 4096; }
              {ioff + c.length > idata_limit}.while_do {
                idata_limit := idata_limit * 2
              }
              (idata_limit_old = 0).if {
                idata := C_array Uint8.create idata_limit
              } else {
                idata := idata.realloc idata_limit_old with idata_limit
              }
            }
            (! getn (idata+ioff) size (c.length)).if {
              result := error_false "outofdata"
            } else {
              ioff := ioff + c.length
            }
          }
        }.elseif {c.type = id('I','E','N','D')} then {
          + raw_len, bpl:Uint32
          (first).if {
            result := error_false "first not IHDR"
          }.elseif {scan != scan_load} then {
            stop := True
          }.elseif {idata = NULL} then {
            result := error_false "no IDAT"
          } else {
            // initial guess for decoded data size to avoid unnecessary reallocs
            bpl := (img_x * depth + 7) / 8; // bytes per line, per component
            raw_len := bpl * img_y * img_n /* pixels */ + img_y /* filter mode per row */
            (expanded, raw_len) := Img_zlib.decode_malloc_guesssize_headerflag (idata, ioff, raw_len) header (! is_iphone)
            idata := NULL
            (expanded = NULL).if {
              result := False; // zlib should set error
            } else {
              (((req_comp = img_n+1) && {req_comp != 3} && {pal_img_n = 0}) || {has_trans}).if {
                img_out_n := img_n+1
              } else {
                img_out_n := img_n
              }
              result := create_png_image(expanded, raw_len, img_out_n, depth, color, interlace)
            }
            result.if {
              (has_trans).if {
                (depth = 16).if {
                  compute_transparency16(tc16, img_out_n)
                } else {
                  compute_transparency(tc, img_out_n)
                }
              }
              (is_iphone && {de_iphone_flag} && {img_out_n > 2}).if {
                de_iphone
              }
              (pal_img_n != 0).if {
                // pal_img_n == 3 or 4
                img_n := pal_img_n; // record the actual colors we had
                img_out_n := pal_img_n
                (req_comp >= 3).if { img_out_n := req_comp; }
                expand_png_palette(palette, img_out_n)
              }.elseif {has_trans} then {
                img_n := img_n + 1
              }
              expanded := NULL
              get32be
            }
          }
          stop := True
        } else {
          // if critical, fail
          (first).if {
            result := error_false "first not IHDR"
          }.elseif {(c.type & (1 << 29)) = 0} then {
            result := error_false "PNG chunk not known"
          } else {
            skip (c.length)
          }
        }
        (! stop).if {
          // end of PNG chunk, read and skip CRC
          get32be
        }
        stop := stop || {! result}
      }
    }
    result
  )

  - load req_comp:Int :C_array Uint8 <-
  // As @stbi__do_png, then @stbi__convert_16_to_8 for a 16-bit image.
  ( + result:C_array Uint8
    rewind
    ((req_comp < 0) || {req_comp > 4}).if {
      error := "bad req_comp"
    }.elseif {parse_png_file (scan_load, req_comp)} then {
      result := out
      out := NULL
      (depth = 16).if {
        (req_comp != 0).if {
          result := convert_format16 result from img_out_n to req_comp
          img_out_n := req_comp
        }
        result := convert_16_to_8 result size (img_x * img_y * img_out_n)
      }.elseif {(req_comp != 0) && {req_comp != img_out_n}} then {
        result := convert_format result from img_out_n to req_comp
        img_out_n := req_comp
      }
    }
    out := expanded := idata := NULL
    result
  )

  - compute_y_16 (r,g,b:Uint16) :Uint16 <-
  (((r.to_uint32*77) + (g.to_uint32*150) + (b.to_uint32*29)) >> 8).to_raw_uint16

  - convert_format16 data:C_array Uint8 from n:Int to req_comp:Int :C_array Uint8 <-
  ( + s16,d16:C_array Uint16
    + result:C_array Uint8
    (req_comp = n).if {
      result := data
    } else {
      ? {req_comp.in_range 1 to 4}
      result := C_array Uint8.create (req_comp * img_x * img_y * 2)
      s16  := Cast (C_array Uint8) To (C_array Uint16).on data
      d16 := Cast (C_array Uint8) To (C_array Uint16).on result
      (img_x * img_y).times {
        + v:Uint16
        (n*10 + req_comp)
        .when 12 then { d16.at 0 put (s16.at 0); d16.at 1 put 0FFFFh; }
        .when 13 then { v := s16.at 0; d16.at 0 put v; d16.at 1 put v; d16.at 2 put v; }
        .when 14 then { v := s16.at 0; d16.at 0 put v; d16.at 1 put v; d16.at 2 put v; d16.at 3 put 0FFFFh; }
        .when 21 then { d16.at 0 put (s16.at 0); }
        .when 23 then { v := s16.at 0; d16.at 0 put v; d16.at 1 put v; d16.at 2 put v; }
        .when 24 then { v := s16.at 0; d16.at 0 put v; d16.at 1 put v; d16.at 2 put v; d16.at 3 put (s16.at 1); }
        .when 34 then { d16.at 0 put (s16.at 0); d16.at 1 put (s16.at 1); d16.at 2 put (s16.at 2); d16.at 3 put 0FFFFh; }
        .when 31 then { d16.at 0 put (compute_y_16(s16.at 0, s16.at 1, s16.at 2)); }
        .when 32 then { d16.at 0 put (compute_y_16(s16.at 0, s16.at 1, s16.at 2)); d16.at 1 put 0FFFFh; }
        .when 41 then { d16.at 0 put (compute_y_16(s16.at 0, s16.at 1, s16.at 2)); }
        .when 42 then { d16.at 0 put (compute_y_16(s16.at 0, s16.at 1, s16.at 2)); d16.at 1 put (s16.at 3); }
        .when 43 then { d16.at 0 put (s16.at 0); d16.at 1 put (s16.at 1); d16.at 2 put (s16.at 2); }
        s16  := s16 + n
        d16 := d16 + req_comp
      }
    }
    result
  )

  - convert_16_to_8 orig:C_array Uint8 size img_len:Int :C_array Uint8 <-
  ( + o:C_array Uint16
    + result:C_array Uint8
    o := Cast (C_array Uint8) To (C_array Uint16).on orig
    result := C_array Uint8.create img_len
    0.to (img_len-1) do { i:Int
      // top half of each byte is sufficient approx of 16->8 bit scaling
      result.at i put (((o.at i >> 8) & 0FFh).to_raw_uint8)
    }
    result
  )

  - test:Boolean <-
  ( + result:Boolean
    rewind
    result := check_png_header
    rewind
    result
  )

  - info:Boolean <-
  ( + result:Boolean
    rewind
    result := parse_png_file (scan_header, 0)
    rewind
    result
  )
