Header
  + name :=  Gif_lzw
Insert
  
  - parent_clone:Clone := Clone
  
Public
  
  + prefix:Int16
  + first:Uint8
  + suffix:Uint8
  
  - set_prefix p:Int16 <- ( prefix := p; )
  - set_first  f:Uint8 <- ( first := f;  )
  - set_suffix s:Uint8 <- ( suffix := s; )
  
  - prefix p:Int16 first f:Uint8 suffix s:Uint8 <-
  (
    prefix := p
    first  := f
    suffix := s
  )
