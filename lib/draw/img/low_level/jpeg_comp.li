Header
  + name := Flat Jpeg_comp
Insert
  
  - parent_clone:Clone := Clone
  
Public
  
  + id:Int
  - set_id i:Int <- ( id := i; )
  
  + h:Int
  + v:Int
  + tq:Int
  - h ph:Int v pv:Int tq ptq:Int <- ( (h,v,tq) := (ph,pv,ptq); )
  
  + hd:Int
  - set_hd h:Int <- ( hd := h; )
  
  + ha:Int
  - set_ha h:Int <- ( ha := h; )
  
  + dc_pred:Int
  - set_dc_pred d:Int <- ( dc_pred := d; )

  + x:Int
  + y:Int
  - x px:Int y py:Int <- ( (x,y) := (px,py); )
  
  + w2:Int
  + h2:Int
  - w2 pw2:Int h2 ph2:Int raw_data prd:C_array Uint8 <-
  ( (w2,h2,raw_data) := (pw2,ph2,prd); )
  
  + data:C_array Uint8
  - set_data d:C_array Uint8 <- ( data := d; )
  - data d:C_array Uint8 raw_data rd:C_array Uint8 <-
  ( (data,raw_data) := (d,rd); )
  
  + raw_data:C_array Uint8;  // void *
  - set_raw_data prd:C_array Uint8 <- ( raw_data := prd; )
  
  + raw_coeff:C_array Int16; // void *
  - coeff c:C_array Int16 raw_coeff rc:C_array Int16 <-
  ( (coeff,raw_coeff) := (c,rc); )
  - raw_data rd:C_array Uint8 raw_coeff rc:C_array Int16 <-
  ( (raw_data,raw_coeff) := (rd,rc); )
  
  + linebuf:C_array Uint8
  - set_linebuf d:C_array Uint8 <- ( linebuf := d; )
  
  + coeff:C_array Int16;   // progressive only
  + coeff_w:Int
  + coeff_h:Int; // number of 8x8 coefficient blocks
  - coeff_w cw:Int coeff_h ch:Int
  raw_coeff rc:C_array Int16 coeff c:C_array Int16 <-
  ( (coeff_w,coeff_h) := (cw,ch);  (raw_coeff,coeff) := (rc,c); )
