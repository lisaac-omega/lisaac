Header
  + name := Pngchunk
Inherit
  
  - parent_clone:Clone := Clone
  
Public

  + length:Uint32
  + type:Uint32
  
  - create_length l:Uint32 type t:Uint32 :Self <-
  ( + result:Self
    result := clone
    result.make_length l type t
    result
  )
  
  - make_length l:Uint32 type t:Uint32 <-
  (
    length := l
    type := t
  )
    
