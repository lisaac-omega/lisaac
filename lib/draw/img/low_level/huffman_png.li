Header
  + name := Huffman_png
Inherit
  
  - parent_clone:Clone := Clone
  
Public
  
  // zlib-style huffman encoding
  // (jpegs packs from left, zlib from right, so can't share code)
  + fast:C_array Uint16
  + firstcode:C_array Uint16
  + maxcode:C_array Int
  + firstsymbol:C_array Uint16
  + size:C_array Uint8
  + value:C_array Uint16
  
  // huffman decoding acceleration
  - fast_bits:Int := 9; // larger handles more cases; smaller stomps less cache
    
  - zbuild_huffman sizelist:C_array Uint8 size num:Int :Self <-
  // @NULL if the code lengths are corrupt (@Image.error says why).
  ( + result:Self
    result := clone
    (! result.zmake_huffman sizelist size num).if { result := NULL; }
    result
  )
  
  - zmake_huffman sizelist:C_array Uint8 size num:Int :Boolean <-
  ( + k,lcode,idx:Int
    + next_code, sizes:C_array Int
    + result:Boolean
    
    fast := C_array Uint16.create (1 << Img_zlib.zfast_bits)
    firstcode := C_array Uint16.create 16
    maxcode := C_array Int.create 17
    firstsymbol := C_array Uint16.create 16
    size := C_array Uint8.create 288
    value := C_array Uint16.create 288
    
    next_code := C_array Int.create 16
    sizes := C_array Int.create 17
    // DEFLATE spec for generating codes
    sizes.clear_all 16
    fast.clear_all ((1 << Img_zlib.zfast_bits)-1)
    0.to (num-1) do { i:Int
      idx := sizelist.at i
      sizes.at idx put (sizes.at idx + 1)
    }
    sizes.at 0 put 0
    result := True
    1.to 15 do { i:Int
      (sizes.at i > (1 << i)).if {
        result := Image.error_false "bad sizes"
      }
    }
    result.if {
      lcode := 0
      1.to 15 do { i:Int
        next_code.at i put lcode
        firstcode.at i put lcode
        firstsymbol.at i put k
        lcode := lcode + sizes.at i
        (sizes.at i != 0).if {
          (lcode-1 >= (1 << i)).if { result := Image.error_false "bad codelengths"; }
        }
        maxcode.at i put (lcode << (16-i)); // preshift for inner loop
        lcode := lcode << 1
        k := k + sizes.at i
      }
      maxcode.at 16 put 1_0000h; // sentinel
    }
    result.if {
      0.to (num-1) do { i:Int
        + s:Int
        s := sizelist.at i
        (s != 0).if {
          + c:Int
          + fastv:Uint16
          c := next_code.at s - firstcode.at s + firstsymbol.at s
          fastv := ((s << 9) | i).to_raw_uint16
          size.at c put s
          value.at c put i
          (s <= Img_zlib.zfast_bits).if {
            + j:Int
            j := next_code.at s.to_raw_uint16.bit_reverse >> (16-s)
            {j < (1 << Img_zlib.zfast_bits)}.while_do {
              fast.at j put fastv
              j := j + (1 << s)
            }
          }
          next_code.at s put (next_code.at s + 1)
        }
      }
    }
    result
  )
