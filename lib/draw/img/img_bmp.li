Header
  + name := Img_bmp
/*Microbite - Windobe BMP image*/
Inherit  
  + parent_image:Flat Image
  
Private
  
  - pal:C_array Uint8 := C_array Uint8.create 1024
  
Private
  
  + bpp:Int
  + offset:Int
  + hsz:Int
  + mr:Uint32
  + mg:Uint32
  + mb:Uint32
  + ma:Uint32
  + all_a:Uint32
  
Public
  
  - name:String_alias := "BMP - BitMaP (Microdobe & IBM)"
  
  - test:Boolean <-
  ( 
    rewind
    (get8 = 'B') && {get8 = 'M'} && {
      get32le; // discard filesize
      get16le; // discard reserved (for appli. creation)
      get16le; // discard reserved (for appli. creation)
      offset := get32le; // discard data offset
      hsz := get32le
      (hsz = 12) || {hsz = 40} || {hsz = 56} || {hsz = 108} || {hsz = 124}
    }
  )
  
  - info:Boolean <-
  ( + result:Boolean
    rewind
    all_a := 255
    result := parse_header
    img_n := (ma != 0).ok 4 or 3
    rewind
    result
  )

  + extra_read:Int
  
  - set_mask_defaults compress:Int :Boolean <-
  ( + result:Boolean
    (compress = 3).if {
      result := True
    }.elseif {compress = 0} then {
      (bpp = 16).if {
        mr := 31 << 10
        mg := 31 <<  5
        mb := 31 <<  0
      }.elseif {bpp = 32} then {
        mr := 0FFh << 16
        mg := 0FFh <<  8
        mb := 0FFh <<  0
        ma := 0FFh << 24
        all_a := 0; // if all_a is 0 at end, then we loaded alpha channel but it was all 0
      } else {
        mr := mg := mb := ma := 0
      }
      result := True
    }
    result
  )

  - parse_header:Boolean <-
  // As @stbi__bmp_parse_header, except for a 56 bytes header (BITMAPV3INFOHEADER,
  // written by Photoshop): its color masks are read in the header, where stb_image
  // looks for them after it.
  ( + result:Boolean
    + compress:Int
    ((get8 != 'B') || {get8 != 'M'}).if {
      result := error_false "not BMP"
    } else {
      get32le; // discard filesize
      get16le; // discard reserved
      get16le; // discard reserved
      offset := get32le.to_raw_int32
      hsz := get32le
      mr := mg := mb := ma := 0
      extra_read := 14
      (offset < 0).if {
        result := error_false "bad BMP"
      }.elseif {(hsz != 12) && {hsz != 40} && {hsz != 56} && {hsz != 108} && {hsz != 124}} then {
        result := error_false "unknown BMP"
      } else {
        (hsz = 12).if {
          img_x := get16le
          img_y := get16le
        } else {
          img_x := get32le
          img_y := get32le.to_raw_int32
        }
        (get16le != 1).if {
          result := error_false "bad BMP"
        } else {
          bpp := get16le
          result := True
        }
      }
    }
    (result && {hsz != 12}).if {
      compress := get32le
      ((compress = 1) || {compress = 2}).if {
        result := error_false "BMP RLE"
      }.elseif {compress >= 4} then {
        result := error_false "BMP JPEG/PNG"; // this includes PNG/JPEG modes
      }.elseif {(compress = 3) && {bpp != 16} && {bpp != 32}} then {
        result := error_false "bad BMP"; // bitfields requires 16 or 32 bits/pixel
      }
    }
    (result && {hsz != 12}).if {
      get32le; // discard sizeof
      get32le; // discard hres
      get32le; // discard vres
      get32le; // discard colorsused
      get32le; // discard max important
      ((hsz = 40) || {hsz = 56}).if {
        (hsz = 56).if {
          mr := get32le
          mg := get32le
          mb := get32le
          ma := get32le
        }
        ((bpp = 16) || {bpp = 32}).if {
          (compress = 0).if {
            set_mask_defaults compress
          }.elseif {compress = 3} then {
            (hsz = 40).if {
              mr := get32le
              mg := get32le
              mb := get32le
              extra_read := extra_read + 12
            }
            ((mr = mg) && {mg = mb}).if {
              result := error_false "bad BMP"
            }
          } else {
            result := error_false "bad BMP"
          }
        }
      } else {
        // hsz = 108 or 124
        mr := get32le
        mg := get32le
        mb := get32le
        ma := get32le
        (compress != 3).if { // override mr/mg/mb unless in BI_BITFIELDS mode, as per docs
          set_mask_defaults compress
        }
        get32le; // discard color space
        12.times { get32le; }; // discard color space parameters
        (hsz = 124).if {
          get32le; // discard rendering intent
          get32le; // discard offset of profile data
          get32le; // discard size of profile data
          get32le; // discard reserved
        }
      }
    }
    result
  )

  - load req_comp:Int :C_array Uint8 <-
  ( + out:C_array Uint8
    + psize,width,pad,target,z:Int
    + flip_vertically,result:Boolean
    + v,v2:Int
    rewind
    all_a := 255
    result := parse_header
    result.if {
      flip_vertically := img_y > 0
      img_y := img_y.abs
      ((img_y > max_dimensions) || {img_x > max_dimensions}).if {
        result := error_false "too large"
      }
    }
    result.if {
      (hsz = 12).if {
        (bpp < 24).if { psize := (offset - extra_read - 24) / 3; }
      } else {
        (bpp < 16).if { psize := (offset - extra_read - hsz) >> 2; }
      }
      (psize = 0).if {
        + bytes_read_so_far,header_limit,extra_data_limit:Int
        bytes_read_so_far := img_buffer #- img_buffer_original
        header_limit := 1024; // max we actually read is below 256 bytes currently.
        extra_data_limit := 256*4; // what ordinarily goes here is a palette; 256 entries*4 bytes is its max size.
        ((bytes_read_so_far <= 0) || {bytes_read_so_far > header_limit}).if {
          result := error_false "bad header"
        }.elseif {(offset < bytes_read_so_far) || {offset - bytes_read_so_far > extra_data_limit}} then {
          result := error_false "bad offset"
        } else {
          skip (offset - bytes_read_so_far)
        }
      }
    }
    result.if {
      ((bpp = 24) && {ma = 0FF000000h}).if {
        img_n := 3
      } else {
        img_n := (ma != 0).ok 4 or 3
      }
      (req_comp >= 3).if { // we can directly decode 3 or 4
        target := req_comp
      } else {
        target := img_n; // if they want monochrome, we'll post-convert
      }
      (! mad3sizes_valid(target, img_x, img_y, 0)).if {
        result := error_false "too large"
      }
    }
    (result && {bpp < 16}).if {
      out := C_array Uint8.create (target * img_x * img_y)
      ((psize = 0) || {psize > 256}).if { 
        result := error_false "invalid"
      } else {
        0.to (psize-1) do { i:Int
          pal.at (i*4+2) put get8
          pal.at (i*4+1) put get8
          pal.at (i*4+0) put get8
          (hsz != 12).if { get8; }
          pal.at (i*4+3) put 255
        }
        skip (offset - extra_read - hsz - psize * ((hsz = 12).ok 3 or 4))
        (bpp = 1).if {
          width := (img_x + 7) >> 3
        }.elseif {bpp = 4} then {
          width := (img_x + 1) >> 1
        }.elseif {bpp = 8} then {
          width := img_x
        } else { 
          result := error_false "bad bpp"
        }
      }
      result.if {
        pad := (-width) & 3
        (bpp = 1).if {
          0.to (img_y-1) do { j:Int
            + bit_offset:Int
            bit_offset := 7
            v := get8
            0.to (img_x-1) do { i:Int
              + color:Int
              color := (v >> bit_offset) & 1
              out.at z put (pal.at (color*4+0)); z := z + 1
              out.at z put (pal.at (color*4+1)); z := z + 1
              out.at z put (pal.at (color*4+2)); z := z + 1
              (target = 4).if { out.at z put 255; z := z + 1; }
              (i+1 != img_x).if {
                bit_offset := bit_offset - 1
                (bit_offset < 0).if {
                  bit_offset := 7
                  v := get8
                }
              }
            }
            skip pad
          }
        } else {
          0.to (img_y-1) do { j:Int
            from 0 to (img_x-1) step 2 do { i:Int
              v := get8
              (bpp = 4).if {
                v2 := v & 15
                v := v >> 4
              } else {
                v2 := 0
              }
              out.at z put (pal.at (v*4+0)); z := z + 1
              out.at z put (pal.at (v*4+1)); z := z + 1
              out.at z put (pal.at (v*4+2)); z := z + 1
              (target = 4).if { out.at z put 255; z := z + 1; }
              (i+1 != img_x).if {
                (bpp = 8).if { v := get8; } else { v := v2; }
                out.at z put (pal.at (v*4+0)); z := z + 1
                out.at z put (pal.at (v*4+1)); z := z + 1
                out.at z put (pal.at (v*4+2)); z := z + 1
                (target = 4).if { out.at z put 255; z := z + 1; }
              }
            }
            skip pad
          }
        }
      }
    }.elseif {result} then {
      + rshift,gshift,bshift,ashift,rcount,gcount,bcount,acount:Int
      + easy:Int
      + a:Uint32
      out := C_array Uint8.create (target * img_x * img_y)
      skip (offset - extra_read - hsz)
      (bpp = 24).if { 
        width := 3 * img_x
      }.elseif {bpp = 16} then { 
        width := 2*img_x
      } else { /* bpp = 32 and pad = 0 */ 
        width := 0
      }
      pad := (-width) & 3
      (bpp = 24).if {
        easy := 1
      }.elseif {bpp = 32} then {
        ((mb = 0FFh) && {mg = 0FF00h} && {mr = 000FF0000h} && {ma = 0FF000000h}).if {
          easy := 2
        }
      }
      (easy = 0).if {
        ((mr = 0) || {mg = 0} || {mb = 0}).if { 
          result := error_false "bad masks"
        } else {
          // right shift amt to put high bit in position #7
          rshift := high_bit mr - 7; rcount := bitcount mr
          gshift := high_bit mg - 7; gcount := bitcount mg
          bshift := high_bit mb - 7; bcount := bitcount mb
          ashift := high_bit ma - 7; acount := bitcount ma
          ((rcount > 8) || {gcount > 8} || {bcount > 8} || {acount > 8}).if {
            result := error_false "bad masks"
          }
        }
      }
      result.if {
        0.to (img_y-1) do { j:Int
          (easy != 0).if {          
            0.to (img_x-1) do { i:Int
              out.at (z+2) put get8
              out.at (z+1) put get8
              out.at (z+0) put get8
              z := z + 3
              (easy = 2).if { a := get8; } else { a := 255; }
              all_a := all_a | a
              (target = 4).if { 
                out.at z put (a.to_raw_uint8)
                z := z + 1
              }
            }
          } else {      
            + val:Uint32
            0.to (img_x-1) do { i:Int
              (bpp = 16).if { val := get16le; } else { val := get32le; }
              out.at z put (shiftsigned (val & mr) shift rshift bits rcount); z := z + 1
              out.at z put (shiftsigned (val & mg) shift gshift bits gcount); z := z + 1
              out.at z put (shiftsigned (val & mb) shift bshift bits bcount); z := z + 1
              (ma != 0).if { a := shiftsigned (val & ma) shift ashift bits acount; } else { a := 255; }
              all_a := all_a | a
              (target = 4).if {
                out.at z put (a.to_raw_uint8); z := z + 1
              }
            }
          }
          skip pad
        }
      }
    }
    result.if {
      // if alpha channel is all 0s, replace with all 255s
      ((target = 4) && {all_a = 0}).if {
        (4*img_x*img_y-1).downto 0 by 4 do { i:Int
          out.at i put 255
        }
      }
      (flip_vertically).if {
        + t:Uint8
        + p1,p2:C_array Uint8
        0.to ((img_y >> 1) - 1) do { j:Int
          p1 := out +          j *img_x*target
          p2 := out + (img_y-1-j)*img_x*target
          0.to (img_x*target-1) do { i:Int
            t := p1.at i
            p1.at i put (p2.at i)
            p2.at i put t
          }
        }
      }
      ((req_comp != 0) && {req_comp != target}).if {
        out := convert_format out from target to req_comp
      }
    } else {
      out := NULL
    }
    out
  )
  
  - write filename:String_alias to (x,y:Int) format comp:Int img data:C_array Uint8 :Boolean <-
  ( + pad:Int
    + f:Pointer
    
    f := File_utils.open_write filename
    // Header.
    pad := (-x*3) & 3
    put8 ('B'.to_uint8) to f
    put8 ('M'.to_uint8) to f
    put32 (14+40+(x*3+pad)*y) to f
    put32 0; // Reserved.
    put32 (14+40) to f
    put32 40 to f
    put32  x to f
    put32  y to f
    put16  1 to f
    put16 24 to f
    6.times { put32 0 to f; }
    // Image.
    write data rgb_dir (-1) v_dir (-1) size (x,y) type comp with_alpha 0 pad pad in f
    File_utils.close f
    True
  )
  
Private
  
  - high_bit pz:Uint32 :Int <-
  // returns 0..31 for the highest set bit
  ( + n:Int
    + z:Uint32
    z := pz
    (z = 0).if { n := -1; } else {
      (z >= 10000h).if { n := n + 16; z := z >> 16; }
      (z >= 00100h).if { n := n +  8; z := z >>  8; }
      (z >= 00010h).if { n := n +  4; z := z >>  4; }
      (z >= 00004h).if { n := n +  2; z := z >>  2; }
      (z >= 00002h).if { n := n +  1; z := z >>  1; }
    }
    n
  )

  - bitcount pa:Uint32 :Int <- // BSBS: A voir avec la lib...
  ( + a:Uint32
    a := pa
    a := (a & 55555555h) + ((a >>  1) & 55555555h); // max 2
    a := (a & 33333333h) + ((a >>  2) & 33333333h); // max 4
    a := (a + (a >> 4)) & 0f0f0f0fh; // max 8 per 4, now 8 bits
    a := (a + (a >> 8));  // max 16 per 8 bits
    a := (a + (a >> 16)); // max 32 per 8 bits
    (a & 0ffh).to_int
  )

  - shiftsigned v:Uint32 shift shift:Int bits bits:Int :Uint8 <-
  // As stb_image v2.30: the @bits significant bits of @v, shifted by @shift,
  // are replicated to fill 8 bits.
  ( + vv:Uint32
    (shift < 0).if { vv := v << (-shift); } else { vv := v >> shift; }
    ? {vv < 256}
    vv := vv >> (8-bits)
    ? {(bits >= 0) && {bits <= 8}}
    ((vv * mul_table.at bits) >> shift_table.at bits).to_raw_uint8
  )
  
  - mul_table:C_array Uint32 :=
  ( + r:C_array Uint32
    r := C_array Uint32.create 9
    r.at 1 put 0FFh; r.at 2 put 055h; r.at 3 put 049h; r.at 4 put 011h
    r.at 5 put 021h; r.at 6 put 041h; r.at 7 put 081h; r.at 8 put 001h
    r
  )
  
  - shift_table:C_array Int :=
  ( + r:C_array Int
    r := C_array Int.create 9
    r.at 3 put 1; r.at 5 put 2; r.at 6 put 4; r.at 7 put 6
    r
  )
