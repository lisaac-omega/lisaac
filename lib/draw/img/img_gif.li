Header
  + name := Img_gif
/* GIF decoder of stb_image v2.30. @load gives the first frame; each call of
   @load_next (with @begin @False) gives the next frame of an animated GIF in a
   new buffer, then @NULL at the end. @delay is in 1/100 s, as in the file. */
Inherit

  - parent_image:Image := Image

Public

  - name:String_alias := "GIF - Graphics Interchange Format (CompuServe)"

  // struct gif:
  + w:Int
  + h:Int
  + out:C_array Uint8; // output buffer (always 4 components)
  + background:C_array Uint8; // The current "background" as far as a gif is concerned
  + history:C_array Uint8
  + old_out:C_array Uint8; // frame before the previous one (for disposal 3)
  + flags:Int
  + bgindex:Int
  + ratio:Int
  + transparent:Int
  + eflags:Int
  + delay:Int
  + pal:C_array Uint8  := C_array Uint8.create (256*4); // pal[256][4]
  + lpal:C_array Uint8 := C_array Uint8.create (256*4); // lpal[256][4]
  + codes:C_array (Flat Gif_lzw) := C_array (Flat Gif_lzw).create 8192
  + color_table:C_array Uint8
  + parse:Int
  + step:Int
  + lflags:Int
  + start_x:Int
  + start_y:Int
  + max_x:Int
  + max_y:Int
  + cur_x:Int
  + cur_y:Int
  + line_size:Int

  - test:Boolean <-
  ( + result:Boolean
    + sz:Uint8
    rewind
    result := (get8 = 'G') && {get8 = 'I'} && {get8 = 'F'} && {get8 = '8'}
    result := result && {((sz := get8) = '9') || {sz = '7'}} && {get8 = 'a'}
    rewind
    result
  )

  - info:Boolean <-
  ( + result:Boolean
    rewind
    result := header True
    rewind
    result
  )

  - parse_colortable pl:C_array Uint8 size num_entries:Int transp transp:Int <-
  ( + ii:Int
    0.to (num_entries-1) do { i:Int
      pl.at (ii+2) put get8
      pl.at (ii+1) put get8
      pl.at  ii    put get8
      pl.at (ii+3) put ((transp = i).ok 0 or 255)
      ii := ii + 4
    }
  )

  - header is_info:Boolean :Boolean <-
  ( + version:Uint8
    + result:Boolean
    ((get8 != 'G') || {get8 != 'I'} || {get8 != 'F'} || {get8 != '8'}).if {
      result := error_false "not GIF"
    } else {
      version := get8
      ((version != '7') && {version != '9'}).if {
        result := error_false "not GIF"
      }.elseif {get8 != 'a'} then {
        result := error_false "not GIF"
      } else {
        w := get16le
        h := get16le
        flags := get8
        bgindex := get8
        ratio := get8
        transparent := -1
        ((w > max_dimensions) || {h > max_dimensions}).if {
          result := error_false "too large"
        } else {
          (img_x, img_y) := (w, h)
          img_n := 4; // can't actually tell whether it's 3 or 4 until we parse the comments
          result := True
          ((! is_info) && {(flags & 80h) != 0}).if {
            parse_colortable pal size (2 << (flags & 7)) transp (-1)
          }
        }
      }
    }
    result
  )

  - out_gif_code code:Uint16 <-
  ( + p,c:C_array Uint8
    + idx:Int
    // recurse to decode the prefixes, since the linked-list is backwards,
    // and working backwards through an interleaved image would be nasty
    (codes.at code.prefix >= 0).if {
      out_gif_code (codes.at code.prefix.to_raw_uint16)
    }
    (cur_y < max_y).if {
      idx := cur_x + cur_y
      p := out + idx
      history.at (idx / 4) put 1
      c := color_table + (codes.at code.suffix.to_int * 4)
      (c.at 3 > 128).if { // don't render transparent pixels;
        p.at 0 put (c.at 2)
        p.at 1 put (c.at 1)
        p.at 2 put (c.at 0)
        p.at 3 put (c.at 3)
      }
      cur_x := cur_x + 4
      (cur_x >= max_x).if {
        cur_x := start_x
        cur_y := cur_y + step
        {(cur_y >= max_y) && {parse > 0}}.while_do {
          step  := (1 << parse) * line_size
          cur_y := start_y + (step >> 1)
          parse := parse - 1
        }
      }
    }
  )

  - process_gif_raster:C_array Uint8 <-
  ( + lzw_cs:Uint8
    + len, first:Int
    + codesize, codemask, avail, oldcode, bits, valid_bits, clear:Int
    + init_code8:Uint8
    + ret:C_array Uint8
    + stop:Boolean
    lzw_cs := get8
    (lzw_cs > 12).if {
      stop := True
    } else {
      clear := 1 << lzw_cs
      first := 1
      codesize := lzw_cs + 1
      codemask := (1 << codesize) - 1
      0.to (clear-1) do { init_code:Int
        init_code8 := init_code.to_uint8
        codes.at init_code.prefix (-1) first init_code8 suffix init_code8
      }
      // support no starting clear code
      avail := clear+2
      oldcode := -1
    }
    {! stop}.while_do {
      (valid_bits < codesize).if {
        (len = 0).if {
          len := get8; // start new block
          (len = 0).if {
            ret := out
            stop := True
          }
        }
        (! stop).if {
          len := len - 1
          bits := bits | (get8.to_int << valid_bits)
          valid_bits := valid_bits + 8
        }
      } else {
        + code:Int
        code := bits & codemask
        bits := bits >> codesize
        valid_bits := valid_bits - codesize
        // @OPTIMIZE: is there some way we can accelerate the non-clear path?
        (code = clear).if {  // clear code
          codesize := lzw_cs + 1
          codemask := (1 << codesize) - 1
          avail := clear + 2
          oldcode := -1
          first := 0
        }.elseif {code = clear + 1} then { // end of stream code
          skip len
          {(len := get8) > 0}.while_do { skip len; }
          ret := out
          stop := True
        }.elseif {code <= avail} then {
          (first != 0).if {
            error := "no clear code"
            stop := True
          }.elseif {oldcode >= 0} then {
            + p:Int
            p := avail
            avail := avail + 1
            (avail > 8192).if {
              error := "too many codes"
              stop := True
            } else {
              codes.at p.set_prefix (oldcode.to_int16)
              codes.at p.set_first  (codes.at oldcode.first)
              (code = avail).if {
                codes.at p.set_suffix (codes.at p.first)
              } else {
                codes.at p.set_suffix (codes.at code.first)
              }
            }
          }.elseif {code = avail} then {
            error := "illegal code in raster"
            stop := True
          }
          (! stop).if {
            out_gif_code (code.to_raw_uint16)
            (((avail & codemask) = 0) && {avail <= 0FFFh}).if {
              codesize := codesize + 1
              codemask := (1 << codesize) - 1
            }
            oldcode := code
          }
        } else {
          error := "illegal code in raster"
          stop := True
        }
      }
    }
    ret
  )

  // this function is designed to support animated gifs
  - load_next req_comp:Int begin start:Boolean :C_array Uint8 <-
  ( + ret,prev_out:C_array Uint8
    + first_frame,stop:Boolean
    + dispose,pcount:Int
    error := NULL
    (start).if {
      // as the memset of stbi__gif_load: a new image starts from a blank state
      out := background := history := old_out := NULL
      eflags := delay := 0
      pal.clear_all (256*4-1)
      lpal.clear_all (256*4-1)
      rewind
    }
    (out = NULL).if {
      (header False).if {
        (! mad3sizes_valid(4, w, h, 0)).if {
          error := "too large"
        } else {
          pcount := w * h
          out := C_array Uint8.create (4 * pcount)
          background := C_array Uint8.create (4 * pcount)
          history := C_array Uint8.create pcount
          out.clear_all (4 * pcount - 1)
          background.clear_all (4 * pcount - 1); // state of the background (starts transparent)
          history.clear_all (pcount - 1);        // pixels that were affected previous frame
          old_out := NULL
          first_frame := True
        }
      }
      stop := out = NULL
    } else {
      // second frame - how do we dispose of the previous one?
      dispose := (eflags & 01Ch) >> 2
      pcount := w * h
      // each frame is returned in its own buffer: start from a copy of the previous one
      prev_out := out
      out := C_array Uint8.create (4 * pcount)
      memcpy(out, prev_out, 4 * pcount)
      ((dispose = 3) && {old_out = NULL}).if {
        dispose := 2; // if I don't have an image to revert back to, default to the old background
      }
      (dispose = 3).if { // use previous graphic
        0.to (pcount-1) do { pi:Int
          (history.at pi != 0).if {
            memcpy(out + pi * 4, old_out + pi * 4, 4)
          }
        }
      }.elseif {dispose = 2} then {
        // restore what was changed last frame to background before that frame;
        0.to (pcount-1) do { pi:Int
          (history.at pi != 0).if {
            memcpy(out + pi * 4, background + pi * 4, 4)
          }
        }
      }
      // This is a non-disposal case eithe way, so just
      // leave the pixels as is, and they will become the new background
      // 1: do not dispose
      // 0:  not specified.
      // background is what out is after the undoing of the previou frame;
      memcpy(background, out, 4 * pcount)
      old_out := prev_out
    }
    (! stop).if {
      // clear my history;
      history.clear_all (w * h - 1); // pixels that were affected previous frame
    }
    {! stop}.while_do {
      + tag:Uint8
      tag := get8
      (tag = 2Ch).if { /* Image Descriptor */
        + x, y, ww, hh:Int
        + o:C_array Uint8
        x  := get16le
        y  := get16le
        ww := get16le
        hh := get16le
        (((x + ww) > w) || {(y + hh) > h}).if {
          error := "bad Image Descriptor"
        } else {
          line_size := w * 4
          start_x := x * 4
          start_y := y * line_size
          max_x   := start_x + ww * 4
          max_y   := start_y + hh * line_size
          cur_x   := start_x
          cur_y   := start_y
          // if the width of the specified rectangle is 0, that means
          // we may not see *any* pixels or the image is malformed;
          // to make sure this is handled correctly, mark the frame as done
          (ww = 0).if { cur_y := max_y; }
          lflags := get8
          ((lflags & 40h) != 0).if {
            step := 8 * line_size; // first interlaced spacing
            parse := 3
          } else {
            step := line_size
            parse := 0
          }
          ((lflags & 80h) != 0).if {
            parse_colortable lpal size (2 << (lflags & 7)) transp (((eflags & 01h) != 0).ok transparent or (-1))
            color_table := lpal
          }.elseif {(flags & 80h) != 0} then {
            color_table := pal
          } else {
            error := "missing color table"
          }
        }
        (error = NULL).if {
          o := process_gif_raster
          (o != NULL).if {
            // if this was the first frame,
            pcount := w * h
            (first_frame && {bgindex > 0}).if {
              // if first frame, any pixel not drawn to gets the background color
              0.to (pcount-1) do { pi:Int
                (history.at pi = 0).if {
                  pal.at (bgindex*4+3) put 255; // just in case it was made transparent, undo that; It will be reset next frame if need be;
                  memcpy(out + pi * 4, pal + bgindex * 4, 4)
                }
              }
            }
          }
          ret := o
        }
        stop := True
      }.elseif {tag = 21h} then { // Comment Extension.
        + len,ext:Int
        + skipped:Boolean
        ext := get8
        (ext = 0F9h).if { // Graphic Control Extension.
          len := get8
          (len = 4).if {
            eflags := get8
            delay  := get16le; // delay - 1/100th of a second
            // unset old transparent
            (transparent >= 0).if {
              pal.at (transparent*4+3) put 255
            }
            ((eflags & 01h) != 0).if {
              transparent := get8
              (transparent >= 0).if {
                pal.at (transparent*4+3) put 0
              }
            } else {
              // don't need transparent
              skip 1
              transparent := -1
            }
          } else {
            skip len
            skipped := True
          }
        }
        (! skipped).if {
          {(len := get8) != 0}.while_do {
            skip len
          }
        }
      }.elseif {tag = 3Bh} then { // gif stream termination code
        stop := True; // end of animated gif: no frame
      } else {
        error := "unknown code"
        stop := True
      }
      stop := stop || {error != NULL}
    }
    ret
  )

  - load req_comp:Int :C_array Uint8 <-
  ( + u:C_array Uint8
    u := load_next req_comp begin True
    (u != NULL).if {
      img_x := w
      img_y := h
      ((req_comp != 0) && {req_comp != 4}).if {
        u := convert_format u from 4 to req_comp
      }
    }
    u
  )
