Header
  + name := Image
Inherit
  
  - parent_clone:Clone := Clone
  
Public

  - default:Int := 0; // only used for req_comp

  - grey:Int       := 1
  - grey_alpha:Int := 2
  - rgb:Int        := 3
  - rgb_alpha:Int  := 4
    
Public
  
  - coder:Image; // Encoder / Decoder
  
  - img_x:Int
  - img_y:Int
  - img_n:Int
  - img_out_n:Int
  - vertical_flip:Boolean
  
  - set_size (w,h:Int) <- ( (img_x,img_y) := (w,h); )
  
  - buflen:Int
  - buffer_start:C_array Uint8

  - img_buffer:C_array Uint8
  - img_buffer_end:C_array Uint8
  - img_buffer_original:C_array Uint8
  - img_buffer_original_end:C_array Uint8
  
  - error:String_alias
  
  - return_error e:String_alias <-
  (
    e.println
    crash
    exit 0
  )

  // As @stbi__err: note the reason @e of the failure and return @False
  // (or @NULL). @load returns @NULL on a corrupt or unsupported image.
  - error_false e:String_alias :Boolean <- ( error := e; False )

  - error_null e:String_alias :C_array Uint8 <- ( error := e; NULL )
  
  - set buf:C_array Uint8 size len:Int coder c:Image <-
  (
    img_buffer := img_buffer_original := buf
    img_buffer_end := img_buffer_original_end := buf+len
    coder := c
  )
  
  // initialize a memory-decode context
  - init buffer:C_array Uint8 size len:Int :Boolean <-
  ( + result:Boolean
    img_buffer := img_buffer_original := buffer
    img_buffer_end := img_buffer_original_end := buffer+len
    result := True
    //coder := IMG_GIF
    // same order as stb_image: the TGA test is weak, so it comes last
    (Img_png.test).if   { coder := Img_png; }.elseif
    {Img_bmp.test} then { coder := Img_bmp; }.elseif
    {Img_gif.test} then { coder := Img_gif; }.elseif
    {Img_psd.test} then { coder := Img_psd; }.elseif
    {Img_jpg.test} then { coder := Img_jpg; }.elseif
    {Img_pnm.test} then { coder := Img_pnm; }.elseif
    {Img_tga.test} then { coder := Img_tga; } else
    { error := "Image not of any known type, or corrupt"
      coder := NULL
      result := False
    }
    result
  )
  
  - file_buffer:C_array Uint8; // owned by @init filename (the buffer of @init buffer is the caller's)
  
  - init filename:String :Boolean <-
  // @False if the file can not be read (as @stbi_load: "can't fopen").
  ( + f:Pointer
    + sz:Int
    + buf:C_array Uint8
    + result:Boolean
    f := File_utils.open_read filename
    (f = NULL).if {
      error := "can't fopen"
    } else {
      sz := File_utils.size f
      buf := file_buffer
      buf := `realloc(@buf,@sz)`:C_array Uint8
      file_buffer := buf
      File_utils.read_raw f in buf size sz
      File_utils.close f
      result := init buf size sz
    }
    result
  )
  
  - rewind <-
  (
    img_buffer := img_buffer_original
    img_buffer_end := img_buffer_original_end
  )

  - vertical_flip in:C_array Uint8 type req_comp:Int :C_array Uint8 <- 
  ( + w,h,depth:Int
    + tmp1,tmp2:Uint8
    depth := (req_comp != 0).ok req_comp or img_n
    (w, h) := (img_x, img_y)
    // @BSBS: (OPTIMIZE) use a bigger temp buffer and memcpy multiple pixels at once
    0.to ((h>>1)-1) do { row:Int
      0.to (w-1) do { col:Int
        0.to (depth-1) do { z:Int
          tmp1 := in.item ((row * w + col) * depth + z)
          tmp2 := in.item (((h - row - 1) * w + col) * depth + z)
          in.at ((row * w + col) * depth + z) put tmp2
          in.at (((h - row - 1) * w + col) * depth + z) put tmp1
        }
      }
    }
    in
  )
  
  - info:Boolean <- coder.info
  
  - load req_comp:Int :C_array Uint8 <- coder.load req_comp
  
  - load req_comp:Int in ds:C_array Uint8 :C_array Uint8 <- coder.load req_comp in ds
          
  - convert_format data:C_array Uint8 
  from imgn:Int to req_comp:Int :C_array Uint8 <-
  ( + n,x,y:Int
    + c:Uint32
    + rout:C_array Uint8
    (req_comp = imgn).if { 
      rout := data
    } else {
      ? {req_comp.in_range 1 to 4}
      (x,y) := (img_x,img_y)
      n := y * x
      src := data
      //"Src : ".print; img_n.println
      //"Dst : ".print; req_comp.println
      rout := dst := C_array Uint8.create (req_comp * n)
      (((img_n-1)<<2)|(req_comp-1))
      /*    00_00b Nothing. */ 
      .when 00_01b then { n.times {           
          put16 (item8 | 0FF00h)
      }; }
      .when 00_10b then { n.times { 
          put24 (((c:=item8)<< 8)|c) and c
      }; }
      .when 00_11b then { n.times { 
          put32 (0FF000000h|((c:=item8)<<16)|(c<<8)|c)
      }; }
      .when 01_00b then { n.times {
          put8 (item16 & 0FFh)
      }; }
      /*    01_01b Nothing. */
      .when 01_10b then { n.times { 
          put24 (((c:=item16 & 0FFh)<<8)|c) and c
      }; }
      .when 01_11b then { n.times { 
          put32 (((c:=item8)<<16)|(c<<8)|c|(item8<<24))
      }; }      
      .when 10_00b then { n.times { 
          put8 (compute_y item24)
      }; }
      .when 10_01b then { n.times { 
          put16 (0FF00h|compute_y item24)
      }; }
      /*    10_10b Nothing. */
      .when 10_11b then { n.times {           
          put32 (0FF000000h|item24)
      };}      
      .when 11_00b then { n.times { 
          put8 (compute_y (item32 & 0FFFFFFh))
      }; }
      .when 11_01b then { n.times { 
          put16 (compute_y ((c:=item32) & 0FFFFFFh)|((c>>16) & 0FF00h))
      }; }
      .when 11_10b then { n.times { 
          put24 item16 and (item16 & 0FFh)
      }; }
      /*    11_11b Nothing. */      
      // STBI_FREE(data)
    }
    rout
  )
  
Private
  
  - memcpy(pdst,psrc:C_array Uint8,sz:Int) <- `memcpy(@pdst,@psrc,@sz)`
  
  - src:C_array Uint8
  - dst:C_array Uint8
  - item8 :Uint32 <- ( + r:Uint32
    r := src.at 0
    src := src + 1; r
  )
  - item16:Uint32 <- ( + r:Uint32
    r := Cast (C_array Uint8) To (C_array Uint16).on src.at 0
    src := src + 2; r
  )
  - item24:Uint32 <- ( + r:Uint32
    r := src.at 0; src := src + 1
    r | (item16<<8)
  )
  - item32:Uint32 <- ( + r:Uint32
    r := Cast (C_array Uint8) To (C_array Uint32).on src.at 0
    src := src + 4; r
  )
  - put8 r:Uint32 <- ( 
    dst.at 0 put (r.to_uint8)
    dst := dst + 1
  )
  - put16 r:Uint32 <- (
    Cast (C_array Uint8) To (C_array Uint16).on dst.at 0 put (r.to_uint16)
    dst := dst + 2
  )
  - put24 r:Uint32 and r2:Uint32 <- (
    put16 r; put8 r2
  )
  - put32 r:Uint32 <- (
    Cast (C_array Uint8) To (C_array Uint32).on dst.at 0 put r
    dst := dst + 4
  )
    
Image
  
  - scan_load:Int   := 0
  - scan_type:Int   := 1
  - scan_header:Int := 2
  
  - refill_buffer <-
  ( + n:Int
    not_yet_implemented
    //n := ???
    (n = 0).if {
      //read_from_callbacks := 0
      img_buffer := buffer_start
      img_buffer_end := buffer_start + 1
      img_buffer.at 0 put 0
    } else {
      img_buffer := buffer_start
      img_buffer_end := buffer_start + n
    }
  )
  
  - last_get8:Uint8
  
  - get8:Uint8 <-
  // 0 at the end of the buffer, as @stbi__get8.
  (
    (img_buffer.to_pointer < img_buffer_end.to_pointer).if {
      last_get8 := img_buffer.first
      img_buffer := img_buffer + 1
    } else {
      last_get8 := 0
    }
    last_get8
  )

  - at_eof:Boolean <- ( img_buffer.to_pointer >= img_buffer_end.to_pointer )

  - skip n:Int <-
  // A negative @n goes to the end, as @stbi__skip.
  ( 
    ((n < 0) || {(img_buffer_end.to_pointer - img_buffer.to_pointer) < n}).if {
      img_buffer := img_buffer_end
      //"-------------------------> FIN SKIP BUF!\n".print
    } else {      
      img_buffer := img_buffer + n
    }
  )

  - getn buffer:C_array Uint8 size n:Int :Boolean <-
  ( + result:Boolean
    ((img_buffer+n).to_pointer <= img_buffer_end.to_pointer).if {
      (n > 0).if { buffer.copy_from img_buffer until (n-1); }
      img_buffer := img_buffer + n
      result := True
    }
    result
  )

  - get16be:Uint16 <-
  ( + result:Uint16
    result := get8
    (result << 8) + get8
  )

  - get32be:Uint32 <-
  ( + result:Uint32
    result := get16be
    (result << 16) + get16be
  )

  - get16le:Uint16 <-
  ( + result:Uint16
    result := get8
    result + (get8.to_uint16 << 8)
  )
  
  - get32le:Uint32 <-
  ( + result:Uint32
    result := get16le
    result + (get16le.to_uint32 << 16)
  )

  - bytecast x:Int :Uint8 <- (x & 0FFh).to_uint8;  // truncate int to byte without warnings
  
  // Size checks of @stbi__mul2sizes_valid and co.: the result fits in a
  // positive 32-bit @Int (as in stb_image, where an @Int is 32 bits).
  
  - int_max:Int := 2147483647
  
  - max_dimensions:Int := 1 << 24; // as @STBI_MAX_DIMENSIONS
  
  - mul2sizes_valid (a,b:Int) :Boolean <-
  ( + result:Boolean
    ((a < 0) || {b < 0}).if {
      result := False
    }.elseif {b = 0} then {
      result := True; // mul-by-0 is always safe
    } else {
      result := a <= int_max / b
    }
    result
  )
  
  - addsizes_valid (a,b:Int) :Boolean <- (b >= 0) && {a <= int_max - b}
  
  - mad2sizes_valid (a,b,add:Int) :Boolean <-
  mul2sizes_valid(a, b) && {addsizes_valid(a*b, add)}
  
  - mad3sizes_valid (a,b,c,add:Int) :Boolean <-
  mul2sizes_valid(a, b) && {mul2sizes_valid(a*b, c)} && {addsizes_valid(a*b*c, add)}
  
  - mad4sizes_valid (a,b,c,d,add:Int) :Boolean <-
  mul2sizes_valid(a, b) && {mul2sizes_valid(a*b, c)} && {mul2sizes_valid(a*b*c, d)} && {addsizes_valid(a*b*c*d, add)}
  
  - compute_y3 (r,g,b:Uint8) :Uint8 <-
  // As @stbi__compute_y.
  (((r.to_uint32*77) + (g.to_uint32*150) + (b.to_uint32*29)) >> 8).to_raw_uint8

  - compute_y c:Uint32 :Uint32 <- 
  ((((c&0FFh)*77) + (((c>>8)&0FFh)*150) +  (29*(c>>16))) >> 8)
  
  // Que JPEG ???
  
  - lrot (x,y:Uint32) :Uint32 <-
  ( + result:Uint32
    //result := `_lrotl(x,y)`:Uint32
    result := (x << y) | (x >> (32 - y))
    result
  )
  
  - cpuid3:Int <-
  ( + result:Int
    `{ int info[4]; __cpuid(info,1)`
    result := `info[3]`:Int
    `}`
    result
  )
  
  /*
  - simd_align (type:?, name:?) <- `__declspec(align(16)) @type @name`
  //                               `@type @name __attribute__((aligned(16)))`

  - sse2_available:Boolean <- ((cpuid3 >> 26) & 1) != 0
  //                          `__builtin_cpu_supports("sse2")`:Boolean
  */
  
  - buf32:C_array Uint8 := C_array Uint8.create 4
  
  - put8  e:Uint8  to f:Pointer <-
  (
    buf32.at 0 put e
    File_utils.write f buffer buf32 size 1
  )
  
  - put16 e:Uint16 to f:Pointer <-
  (
    Cast (C_array Uint8) To (C_array Uint16).on buf32.at 0 put e
    File_utils.write f buffer buf32 size 2
  )
  
  - put24 e:Uint32 to f:Pointer <-
  (
    buf32.at 0 put (e.to_raw_uint8)
    buf32.at 1 put ((e >>  8).to_raw_uint8)
    buf32.at 2 put ((e >> 16).to_raw_uint8)
    File_utils.write f buffer buf32 size 3
  )
  
  - put32 e:Uint32 to f:Pointer <-
  (
    Cast (C_array Uint8) To (C_array Uint32).on buf32.at 0 put e
    File_utils.write f buffer buf32 size 4
  )
  
  - write data:C_array Uint8 rgb_dir rgb_dir:Int v_dir vdir:Int size (x,y:Int)
  type comp:Int with_alpha write_alpha:Int pad scanline_pad:Int in f:Pointer <-
  ( + i,j,k, j_end:Int
    + zero,c,bg,px:Uint32
    + d:C_array Uint8
    bg := 0FF00FFh
    (vdir < 0).if {
      j_end := -1
      j := y-1
    } else {
      j_end := y
      j := 0
    }
    {j != j_end}.while_do {
      0.to (x-1) do { i:Int
        d := data + (j*x+i)*comp
        (write_alpha < 0).if {
          put8 (d.item (comp-1)) to f
        }
        (comp)
        .when 1 or 2 then {
          c := d.first; c := (c << 16) | (c << 8) | c
          put24 c to f
        }
        .when 3 or 4 then {
          (write_alpha = 0).if {
            // composite against pink background
            //0.to 2 do { k:Int
            //  buf32.at k put (bg.item k + ((d.item k - bg.item k) * d.item 3)/255)
            //}
            c := 0; //(buf32.item (1+rgb_dir)<<16) | (buf32.item 1<<8) | buf32.item (1-rgb_dir)
          } else {
            c := (d.item (1+rgb_dir)<<16)  | (d.item 1<<8)  | d.item (1-rgb_dir)
          }
          put24 c to f
        }
        (write_alpha > 0).if { put8 (d.item (comp-1)) to f; }
      }
      0.to 3 do { i:Int; buf32.at i put 0; }
      File_utils.write f buffer buf32 size scanline_pad
      j := j + vdir
    }
  )

