Header
  + name := Img_jpg
- include := `
  extern unsigned int bmask[];
  extern int const jbias[];
  extern unsigned char jpeg_dezigzag[];
  `
  
  - external := `
  // (1 << n) - 1 // BSBS: J'ai des doutes sur l'utilité d'un tel tableau !!!
  unsigned int bmask[17]={0,1,3,7,15,31,63,127,255,511,1023,2047,4095,8191,16383,32767,65535};
  
  // bias[n] = (-1<<n) + 1 // BSBS: Idem...
  int const jbias[16] = {0,-1,-3,-7,-15,-31,-63,-127,-255,-511,-1023,-2047,-4095,-8191,-16383,-32767};
  
  // given a value that's at position X in the zigzag stream,
  // where does it appear in the 8x8 matrix coded as row-major?
  unsigned char jpeg_dezigzag[64+15] =
  {
  0,  1,  8, 16,  9,  2,  3, 10,
  17, 24, 32, 25, 18, 11,  4,  5,
  12, 19, 26, 33, 40, 48, 41, 34,
  27, 20, 13,  6,  7, 14, 21, 28,
  35, 42, 49, 56, 57, 50, 43, 36,
  29, 22, 15, 23, 30, 37, 44, 51,
  58, 59, 52, 45, 38, 31, 39, 46,
  53, 60, 61, 54, 47, 55, 62, 63,
  // let corrupt input sample past end
  63, 63, 63, 63, 63, 63, 63, 63,
  63, 63, 63, 63, 63, 63, 63
  };

  `;
Inherit
  
  + parent_image:Flat Image
  
Public
   
  + huff_dc:C_array Huffman_jpg :=
  ( + r:C_array Huffman_jpg
    r := C_array Huffman_jpg.create 4
    0.to 3 do { i:Int; r.at i put (Huffman_jpg.new); }
    r
  )
  
  + huff_ac:C_array Huffman_jpg :=
  ( + r:C_array Huffman_jpg
    r := C_array Huffman_jpg.create 4
    0.to 3 do { i:Int; r.at i put (Huffman_jpg.new); }
    r
  )
    
  + dequant:Array (C_array Uint16) :=
  ( + r:Array (C_array Uint16)
    r := Array (C_array Uint16).create_with_capacity 4
    4.times { r.add_last (C_array Uint16.create 64); }
    r
  )
  
  + fast_ac:C_array (C_array Int16) :=
  ( + r:C_array (C_array Int16)
    r := C_array (C_array Int16).create 4
    0.to 3 do { i:Int
      r.at i put (C_array Int16.create (1 << Huffman_jpg.fast_bits))
    }
    r
  )

  // sizes for components, interleaved MCUs
  + img_h_max:Int
  + img_v_max:Int
  + img_mcu_x:Int
  + img_mcu_y:Int
  + img_mcu_w:Int
  + img_mcu_h:Int

  // definition of jpeg image component
  + img_comp:Array (Flat Jpeg_comp) := Array (Flat Jpeg_comp).create 4

  + code_buffer:Uint32; // jpeg entropy-coded buffer
  + code_bits:Int;       // number of valid bits
  + marker:Uint8;       // marker seen while filling entropy buffer
  + nomore:Int;          // flag if we saw a marker so must stop

  + progressive:Boolean
  + spec_start:Int
  + spec_end:Int
  + succ_high:Int
  + succ_low:Int
  + eob_run:Int

  + scan_n:Int
  + jfif:Int
  + app14_color_transform:Int; // Adobe APP14 tag
  + rgb:Int
  + order:C_array Int := C_array Int.create 4; //[4]
  + restart_interval:Int
  + todo:Int

  - grow_buffer_unsafe <-
  ( + b,c:Int
    + stop:Boolean
    {
      (nomore != 0).if {
        b := 0
      } else {
        b := get8
      }
      (b = 0FFh).if {
        c := get8
        {c = 0FFh}.while_do { c := get8; }; // consume fill bytes
        (c != 0).if {
          marker := c.to_raw_uint8
          nomore := 1
          stop := True
        }
      }
      (! stop).if {
        code_buffer := code_buffer | (b << (24 - code_bits))
        code_bits := code_bits + 8
      }
    }.do_while {(code_bits <= 24) && {!stop}}
  )
  
  - f2f x:Real32 :Int <- (x * 4096 + 0.5).to_int

  // (1 << n) - 1 // BSBS: J'ai des doutes sur l'utilité d'un tel tableau !!!
  - bmask i:Int :Uint32 <- `bmask[@i]`:Uint32

  // decode a jpeg huffman value from the bitstream
  - huff_decode h:Huffman_jpg :Int <-
  ( + temp:Uint32
    + c,k,result:Int

    (code_bits < 16).if { grow_buffer_unsafe; }
    // look at the top FAST_BITS and determine what symbol ID it is,
    // if the code is <= FAST_BITS
    c := (code_buffer >> (32 - Huffman_jpg.fast_bits)) & ((1 << Huffman_jpg.fast_bits)-1)
    k := h.fast.at c
    (k < 255).if {
      + s:Int
      s := h.size.at k
      (s > code_bits).if {
        result := -1
      } else {
        code_buffer := code_buffer << s
        code_bits := code_bits - s
        result := h.values.at k
      }
    } else {
      // naive test is to shift the code_buffer down so k bits are
      // valid, then test against maxcode. To speed this up, we've
      // preshifted maxcode left so that it has (16-k) 0s at the
      // end; in other words, regardless of the number of bits, it
      // wants to be compared against something shifted to have 16
      // that way we don't need to shift inside the loop.
      temp := code_buffer >> 16
      k := Huffman_jpg.fast_bits+1
      {temp >= h.maxcode.at k}.while_do { k := k + 1; }
      (k = 17).if {
        // error! code not found
        code_bits := code_bits - 16
        result := -1
      }.elseif {k > code_bits} then {
        result := -1
      } else {
        // convert the huffman code to the symbol id
        c := ((code_buffer >> (32 - k)) & bmask k) + h.delt.at k
        ((c < 0) || {c >= 256}).if {
          result := -1; // symbol id out of bounds!
        } else {
          ? {((code_buffer >> (32 - h.size.at c)) & bmask (h.size.at c)) = h.code.at c}
          // convert the id to a symbol
          code_bits := code_bits - k
          code_buffer := code_buffer << k
          result := h.values.at c
        }
      }
    }
    result
  )

  // bias[n] = (-1<<n) + 1
  - jbias i:Int :Int <- `jbias[@i]`:Int

  // combined JPEG 'receive' and JPEG 'extend', since baseline
  // always extends everything it receives.
  - extend_receive n:Int :Int <-
  ( + k:Uint32
    + sgn,result:Int
    (code_bits < n).if { grow_buffer_unsafe; }
    // ran out of bits from stream, return 0s intead of continuing
    (code_bits >= n).if {
      sgn := code_buffer.to_raw_int32 >> 31; // sign bit is always in MSB
      k := lrot(code_buffer, n)
      ? {(n >= 0) && {n < 17}}
      code_buffer := k & ~bmask n
      k := k & bmask n
      code_bits := code_bits - n
      result := k.to_int + (jbias n & ~sgn)
    }
    result
  )

  // get some unsigned bits
  - get_bits n:Int :Int <-
  ( + k:Uint32
    (code_bits < n).if { grow_buffer_unsafe; }
    (code_bits >= n).if {
      k := lrot(code_buffer, n)
      code_buffer := k & ~bmask n
      k := k & bmask n
      code_bits := code_bits - n
    }
    k
  )

  - get_bit:Int <-
  ( + k:Uint32
    (code_bits < 1).if { grow_buffer_unsafe; }
    (code_bits >= 1).if {
      k := code_buffer
      code_buffer := k << 1
      code_bits := code_bits - 1
    }
    k & 08000_0000h
  )

  // @a + @b does not overflow an @Int32 (as @stbi__addints_valid)
  - addints_valid (a,b:Int) :Boolean <-
  ( + result:Boolean
    ((a >= 0) != (b >= 0)).if {
      result := True; // a and b have different signs, so no overflow
    }.elseif {(a < 0) && {b < 0}} then {
      result := a >= (-2147483648 - b)
    } else {
      result := a <= (2147483647 - b)
    }
    result
  )

  // @a * @b fits in an @Int16 (as @stbi__mul2shorts_valid)
  - mul2shorts_valid (a,b:Int) :Boolean <-
  ( + result:Boolean
    ((b = 0) || {b = -1}).if {
      result := True; // multiplication by 0 is always 0; check for -1 so SHRT_MIN/b doesn't overflow
    }.elseif {(a >= 0) = (b >= 0)} then {
      result := a <= (32767 / b); // product is positive, so similar to mul2sizes_valid
    }.elseif {b < 0} then {
      result := a <= (-32768 / b); // same as a * b >= SHRT_MIN
    } else {
      result := a >= (-32768 / b)
    }
    result
  )

  - dezigzag i:Int :Uint8 <- `jpeg_dezigzag[@i]`:Uint8
  // where does it appear in the 8x8 matrix coded as row-major?
  // given a value that's at position X in the zigzag stream,

  - decode_block(data:C_array Int16 ,
  hdc,hac:Huffman_jpg, fac:C_array Int16, b:Int, dequan:C_array Uint16) :Boolean <-
  // decode one 64-entry block-- data[64]
  ( + diff,dc,k:Int
    + t:Int
    + stop,result:Boolean
    (code_bits < 16).if { grow_buffer_unsafe; }
    t := huff_decode hdc
    ((t < 0) || {t > 15}).if {
      result := error_false "bad huffman code"
    } else {
      // 0 all the ac values now so we can do it 32-bits at a time
      data.clear_all 63
      (t != 0).if { diff := extend_receive t; }
      (! addints_valid(img_comp.at b.dc_pred, diff)).if {
        result := error_false "bad delta"
      } else {
        dc := img_comp.at b.dc_pred + diff
        img_comp.at b.set_dc_pred dc
        (! mul2shorts_valid(dc, dequan.first)).if {
          result := error_false "can't merge dc and ac"
        } else {
          result := True
          data.at 0 put ((dc * dequan.first).to_raw_int16)
          // decode AC components, see JPEG spec
          k := 1
          {
            + zig:Uint32
            + c,r,s:Int
            (code_bits < 16).if { grow_buffer_unsafe; }
            c := (code_buffer >> (32 - Huffman_jpg.fast_bits)) & ((1 << Huffman_jpg.fast_bits)-1)
            r := fac.at c
            (r != 0).if { // fast-AC path
              k := k + ((r >> 4) & 15); // run
              s := r & 15; // combined length
              (s > code_bits).if {
                result := error_false "bad huffman code"; // Combined length longer than code bits available
              } else {
                code_buffer := code_buffer << s
                code_bits := code_bits - s
                // decode into unzigzag'd location
                zig := dezigzag k
                k := k + 1
                data.at zig put (((r >> 8) * dequan.at zig).to_raw_int16)
              }
            } else {
              + rs:Int
              rs := huff_decode hac
              (rs < 0).if {
                result := error_false "bad huffman code"
              } else {
                s := rs & 15
                r := rs >> 4
                (s = 0).if {
                  (rs != 0F0h).if { stop := True; }; // end block
                  k := k + 16
                } else {
                  k := k + r
                  // decode into unzigzag'd location
                  zig := dezigzag k
                  k := k + 1
                  data.at zig put ((extend_receive s * dequan.at zig).to_raw_int16)
                }
              }
            }
          }.do_while {(k < 64) && {! stop} && {result}}
        }
      }
    }
    result
  )

  - decode_block_prog_dc(data:C_array Int16, hdc:Huffman_jpg, b:Int) :Boolean <-
  // data[64]
  ( + diff,dc:Int
    + t:Int
    + result:Boolean
    (spec_end != 0).if {
      result := error_false "can't merge dc and ac"
    } else {
      (code_bits < 16).if { grow_buffer_unsafe; }
      result := True
      (succ_high = 0).if {
        // first scan for DC coefficient, must be first
        data.clear_all 63; // 0 all the ac values now
        t := huff_decode hdc
        ((t < 0) || {t > 15}).if {
          result := error_false "can't merge dc and ac"
        } else {
          (t != 0).if { diff := extend_receive t; }
          (! addints_valid(img_comp.at b.dc_pred, diff)).if {
            result := error_false "bad delta"
          } else {
            dc := img_comp.at b.dc_pred + diff
            img_comp.at b.set_dc_pred dc
            (! mul2shorts_valid(dc, 1 << succ_low)).if {
              result := error_false "can't merge dc and ac"
            } else {
              data.at 0 put ((dc * (1 << succ_low)).to_raw_int16)
            }
          }
        }
      } else {
        // refinement scan for DC coefficient
        (get_bit != 0).if {
          data.at 0 put ((data.first + (1 << succ_low)).to_raw_int16)
        }
      }
    }
    result
  )
  
  - clamp x:Int :Uint8 <-
  ( + result:Uint8
    (x.to_raw_uint > 255).if {
      (x > 255).if { result := 255; }
    } else { result := x.to_uint8; }
    result
  )
  
  // derived from jidctint -- DCT_ISLOW
  - idct_1d (s0,s1,s2,s3,s4,s5,s6,s7:Int)
  :(Int,Int,Int,Int,Int,Int,Int,Int) <-
  ( + t0,t1,t2,t3,p1,p2,p3,p4,p5,x0,x1,x2,x3:Int
    p2 := s2
    p3 := s6
    p1 := (p2+p3)*f2f(0.5411961)
    t2 := p1 + p3*f2f(-1.847759065)
    t3 := p1 + p2*f2f( 0.765366865)
    p2 := s0
    p3 := s4
    t0 := (p2+p3) << 12
    t1 := (p2-p3) << 12
    x0 := t0+t3
    x3 := t0-t3
    x1 := t1+t2
    x2 := t1-t2
    t0 := s7
    t1 := s5
    t2 := s3
    t3 := s1
    p3 := t0+t2
    p4 := t1+t3
    p1 := t0+t3
    p2 := t1+t2
    p5 := (p3+p4)*f2f( 1.175875602)
    t0 := t0*f2f( 0.298631336)
    t1 := t1*f2f( 2.053119869)
    t2 := t2*f2f( 3.072711026)
    t3 := t3*f2f( 1.501321110)
    p1 := p5 + p1*f2f(-0.899976223)
    p2 := p5 + p2*f2f(-2.562915447)
    p3 := p3*f2f(-1.961570560)
    p4 := p4*f2f(-0.390180644)
    t3 := t3 + p1+p4
    t2 := t2 + p2+p3
    t1 := t1 + p2+p4
    t0 := t0 + p1+p3
    x0,x1,x2,x3, t0,t1,t2,t3
  )
  
  - val_block:C_array Int := C_array Int.create 64
  - idct_block(out:C_array Uint8, out_stride:Int,data:C_array Int16) <-
  // data[64]
  ( + val,v:C_array Int
    + o:C_array Uint8
    + d:C_array Int16
    //"IDCT beg\n".print
    d := data
    v := val := val_block
    // columns
    0.to 7 do { i:Int
      // if all zeroes, shortcut -- this avoids dequantizing 0s and IDCTing
      ((d.at 8 = 0) && {d.at 16 = 0} && {d.at 24 = 0} && {d.at 32 = 0} &&
      {d.at 40 = 0} && {d.at 48 = 0} && {d.at 56 = 0}).if {
        + dcterm:Int
        //    no shortcut                 0     seconds
        //    (1|2|3|4|5|6|7)==0          0     seconds
        //    all separate               -0.047 seconds
        //    1 && 2|3 && 4|5 && 6|7:    -0.047 seconds
        dcterm := d.at 0.to_int << 2
        v.at 0  put dcterm;  v.at 8  put dcterm;  v.at 16 put dcterm;  v.at 24 put dcterm
        v.at 32 put dcterm;  v.at 40 put dcterm;  v.at 48 put dcterm;  v.at 56 put dcterm
      } else {
        + x0,x1,x2,x3,t0,t1,t2,t3:Int
        /*
        "data:\n".print
        d.at 0.print; ' '.print
        d.at 8.print; ' '.print
        d.at 16.print; ' '.print
        d.at 24.print; ' '.print
        d.at 32.print; ' '.print
        d.at 40.print; ' '.print
        d.at 48.print; ' '.print
        d.at 56.print; ' '.print
        '\n'.print
        */
        (x0,x1,x2,x3,t0,t1,t2,t3) := 
        idct_1d(d.at 0,d.at 8,d.at 16,d.at 24,d.at 32,d.at 40,d.at 48,d.at 56)
        // constants scaled things up by 1<<12; let's bring them back
        // down, but keep 2 extra bits of precision
        x0 := x0 + 512;  x1 := x1 + 512;  x2 := x2 + 512;  x3 := x3 + 512
        //"Val:\n".print
        v.at 0  put ((x0+t3) >> 10); //v.item  0.print; ' '.print
        v.at 56 put ((x0-t3) >> 10); //v.item 56.print; ' '.print
        v.at 8  put ((x1+t2) >> 10); //v.item  8.print; ' '.print
        v.at 48 put ((x1-t2) >> 10); //v.item 48.print; ' '.print
        v.at 16 put ((x2+t1) >> 10); //v.item 16.print; ' '.print
        v.at 40 put ((x2-t1) >> 10); //v.item 40.print; ' '.print
        v.at 24 put ((x3+t0) >> 10); //v.item 24.print; ' '.print
        v.at 32 put ((x3-t0) >> 10); //v.item 32.print; ' '.print
        //'\n'.print
      }
      d := d + 1;  v := v + 1
    }
    //"IDCT 1.5\n".print
    o := out
    v := val
    0.to 7 do { i:Int
      + x0,x1,x2,x3,t0,t1,t2,t3:Int
      // no fast case since the first 1D IDCT spread components out
      (x0,x1,x2,x3,t0,t1,t2,t3) := 
      idct_1d(v.at 0,v.at 1,v.at 2,v.at 3,v.at 4,v.at 5,v.at 6,v.at 7)
      // constants scaled things up by 1<<12, plus we had 1<<2 from first
      // loop, plus horizontal and vertical each scale by sqrt(8) so together
      // we've got an extra 1<<3, so 1<<17 total we need to remove.
      // so we want to round that, which means adding 0.5 * 1<<17,
      // aka 65536. Also, we'll end up with -128 to 127 that we want
      // to encode as 0..255 by adding 128, so we'll add that before the shift
      x0 := x0 + 65536 + (128<<17)
      x1 := x1 + 65536 + (128<<17)
      x2 := x2 + 65536 + (128<<17)
      x3 := x3 + 65536 + (128<<17)
      // tried computing the shifts into temps, or'ing the temps to see
      // if any were out of range, but that was slower
      //i.println
      //"out:\n".print
      o.at 0 put (clamp((x0+t3) >> 17)); //o.item 0.print; ' '.print
      o.at 7 put (clamp((x0-t3) >> 17)); //o.item 7.print; ' '.print
      o.at 1 put (clamp((x1+t2) >> 17)); //o.item 1.print; ' '.print
      o.at 6 put (clamp((x1-t2) >> 17)); //o.item 6.print; ' '.print
      o.at 2 put (clamp((x2+t1) >> 17)); //o.item 2.print; ' '.print
      o.at 5 put (clamp((x2-t1) >> 17)); //o.item 5.print; ' '.print
      o.at 3 put (clamp((x3+t0) >> 17)); //o.item 3.print; ' '.print
      o.at 4 put (clamp((x3-t0) >> 17)); //o.item 4.print; ' '.print
      //'\n'.print
      v := v + 8;  o := o + out_stride
    }
    //"IDCT end\n".print
  )
  
  - decode_block_prog_ac(data:C_array Int16, hac:Huffman_jpg, fac:C_array Int16) :Boolean <-
  // data[64] @OPTIMIZE: store non-zigzagged during the decode passes,
  // and only de-zigzag when dequantizing
  ( + k:Int
    + break,result:Boolean
    
    result := True
    (spec_start = 0).if {
      result := error_false "can't merge dc and ac"
    }.elseif {succ_high = 0} then {
      + shift:Int
      //"A".print; eob_run.println
      shift := succ_low
      (eob_run != 0).if {
        eob_run := eob_run - 1
      } else {
        k := spec_start
        {
          + zig:Uint8
          + c,r,s,rs:Int
          (code_bits < 16).if { grow_buffer_unsafe; }
          c := (code_buffer >> (32 - Huffman_jpg.fast_bits)) & ((1 << Huffman_jpg.fast_bits)-1)
          r := fac.at c
          (r != 0).if { // fast-AC path
            k := k + (r >> 4) & 15; // run
            s := r & 15; // combined length
            (s > code_bits).if {
              result := error_false "bad huffman code"; // Combined length longer than code bits available
            } else {
              code_buffer := code_buffer << s
              code_bits := code_bits - s
              zig := dezigzag k
              k := k + 1
              data.at zig put (((r >> 8) * (1 << shift)).to_raw_int16)
            }
          }.elseif {(rs := huff_decode hac) < 0} then {
            result := error_false "bad huffman code"
          } else {
            s := rs & 15
            r := rs >> 4
            (s = 0).if {
              (r < 15).if {
                eob_run := 1 << r
                (r != 0).if {
                  eob_run := eob_run + get_bits r
                }
                eob_run := eob_run - 1
                break := True
              }
              k := k + 16
            } else {
              k := k + r
              zig := dezigzag k
              k := k + 1
              data.at zig put ((extend_receive s * (1 << shift)).to_raw_int16)
            }
          }
        }.do_while {(k <= spec_end) && {! break} && {result}}
      }
    } else {
      + bit:Int16
      //"B".print; eob_run.println
      // refinement scan for these AC coefficients      
      bit := 1 << succ_low
      (eob_run != 0).if {
        eob_run := eob_run - 1
        spec_start.to spec_end do { k:Int
          + p:C_array Int16
          p := data + dezigzag k
          (p.first != 0).if {
            (get_bit != 0).if {
              ((p.first & bit) = 0).if {
                (p.first > 0).if {
                  p.at 0 put (p.first + bit)
                } else {
                  p.at 0 put (p.first - bit)
                }
              }
            }
          }
        }
      } else {
        //"C".print; eob_run.println
        k := spec_start
        {
          + r,s,rs:Int
          rs := huff_decode hac; // @OPTIMIZE see if we can use the fast path here, advance-by-r is so slow, eh
          (rs < 0).if { result := error_false "bad huffman code"; }
          s := rs & 15
          r := rs >> 4
          (s = 0).if {
            (r < 15).if {
              eob_run := (1 << r) - 1
              (r != 0).if {
                eob_run := eob_run + get_bits r
                //"eob:".print; eob_run.println
              }
              r := 64; // force end of block
            } else {
              // r=15 s=0 should write 16 0s, so we just do
              // a run of 15 0s and then write s (which is 0),
              // so we don't have to do anything special here
            }
          } else {
            (s != 1).if { result := error_false "bad huffman code"; }
            // sign bit
            (get_bit != 0).if {
              s := bit
            } else {
              s := - bit
            }
          }
          // advance by r
          break := ! result
          {(k <= spec_end) && {!break}}.while_do {
            + p:C_array Int16
            p := data + dezigzag k
            k := k + 1
            (p.first != 0).if {
              (get_bit != 0).if {
                ((p.first & bit) = 0).if {
                  (p.first > 0).if {
                    p.at 0 put (p.first + bit)
                  } else {
                    p.at 0 put (p.first - bit)
                  }
                }
              }
            } else {
              (r = 0).if {
                p.at 0 put (s.to_raw_int16)
                break := True
              }
              r := r - 1
            }
          }
        }.do_while {(k <= spec_end) && {result}}
      }
    }
    result
  )

  - marker_none:Int := 0FFh
  // if there's a pending marker from the entropy stream, return that
  // otherwise, fetch from the stream and get a marker. if there's no
  // marker, return 0xff, which is never a valid marker value
  - get_marker:Uint8 <-
  ( + x:Uint8
    (marker != marker_none).if {
      x := marker
      marker := marker_none
    } else {
      x := get8
      (x != 0FFh).if {
        x := marker_none
      } else {
        {x = 0FFh}.while_do {
          x := get8
        }
      }
    }
    //x.print_hexa; '\n'.print
    x
  )

  // in each scan, we'll have scan_n components, and the order
  // of the components is specified by order[]
  - restart x:Int :Boolean <- ((x >= 0D0h) && {x <= 0D7h})

  // after a restart interval, jpeg_reset the entropy decoder and the dc prediction
  - reset <-
  (
    code_bits := code_buffer := nomore := 0
    img_comp.at 0.set_dc_pred 0
    img_comp.at 1.set_dc_pred 0
    img_comp.at 2.set_dc_pred 0
    img_comp.at 3.set_dc_pred 0
    marker := marker_none
    todo := (restart_interval != 0).ok restart_interval or 07FFFFFFFh
    eob_run := 0
    // no more than 1<<31 MCUs if no restart_interal? that's plenty safe,
    // since we don't even allow 1<<30 pixels
  )

  // Count down the restart interval after an MCU; @False if the stream
  // must stop here (no restart marker: corrupt data rather than no data).
  - next_mcu:Boolean <-
  ( + result:Boolean
    result := True
    todo := todo - 1
    (todo <= 0).if {
      (code_bits < 24).if { grow_buffer_unsafe; }
      (restart marker).if { reset; } else { result := False; }
    }
    result
  )
  
  - data_parse:C_array Int16  := C_array Int16.create 64
  
  // @False on error; a missing restart marker ends the scan without error.
  - parse_entropy_coded_data:Boolean <-
  ( + result,go:Boolean
    + n,w,h,j,i:Int
    + data:C_array Int16
    reset
    result := go := True
    (scan_n = 1).if {
      n := order.first
      // non-interleaved data, we just need to process one block at a time,
      // in trivial scanline order
      // number of blocks to do just depends on how many actual "pixels" this
      // component has, independent of interleaved MCU blocking and such
      w := (img_comp.at n.x+7) >> 3
      h := (img_comp.at n.y+7) >> 3
      j := 0
      {(j < h) && {go}}.while_do {
        i := 0
        {(i < w) && {go}}.while_do {
          (! progressive).if {
            + ha:Int
            data := data_parse
            ha := img_comp.at n.ha
            result := decode_block(data, huff_dc.at (img_comp.at n.hd), huff_ac.at ha, fast_ac.at ha, n, dequant.at (img_comp.at n.tq))
            result.if {
              idct_block(img_comp.at n.data+img_comp.at n.w2*j*8+i*8, img_comp.at n.w2, data)
            }
          } else {
            data := img_comp.at n.coeff + 64 * (i + j * img_comp.at n.coeff_w)
            (spec_start = 0).if {
              result := decode_block_prog_dc(data, huff_dc.at (img_comp.at n.hd), n)
            } else {
              + ha:Int
              ha := img_comp.at n.ha
              result := decode_block_prog_ac(data, huff_ac.at ha, fast_ac.at ha)
            }
          }
          // every data block is an MCU, so countdown the restart interval
          go := result && {next_mcu}
          i := i + 1
        }
        j := j + 1
      }
    } else { // interleaved
      j := 0
      {(j < img_mcu_y) && {go}}.while_do {
        i := 0
        {(i < img_mcu_x) && {go}}.while_do {
          // scan an interleaved mcu... process scan_n components in order
          0.to (scan_n-1) do { k:Int
            n := order.at k
            // scan out an mcu's worth of this component; that's just determined
            // by the basic H and V specified for the component
            0.to (img_comp.at n.v-1) do { y:Int
              0.to (img_comp.at n.h-1) do { x:Int
                + x2,y2:Int
                x2 := i*img_comp.at n.h + x
                y2 := j*img_comp.at n.v + y
                result.if {
                  (! progressive).if {
                    + ha:Int
                    data := data_parse
                    ha := img_comp.at n.ha
                    result := decode_block(data, huff_dc.at (img_comp.at n.hd), huff_ac.at ha, fast_ac.at ha, n, dequant.at (img_comp.at n.tq))
                    result.if {
                      idct_block(img_comp.at n.data+img_comp.at n.w2*y2*8+x2*8, img_comp.at n.w2, data)
                    }
                  } else {
                    data := img_comp.at n.coeff + 64 * (x2 + y2 * img_comp.at n.coeff_w)
                    result := decode_block_prog_dc(data, huff_dc.at (img_comp.at n.hd), n)
                  }
                }
              }
            }
          }
          // after all interleaved components, that's an interleaved MCU,
          // so now count down the restart interval
          go := result && {next_mcu}
          i := i + 1
        }
        j := j + 1
      }
    }
    result
  )

  - dequantize data:C_array Int16 with dequan:C_array Uint16 <-
  ( 
    0.to 63 do { i:Int
      data.at i put (((data.at i).to_int * dequan.at i).to_raw_int16)
    }
  )

  - finish <-
  (
    (progressive).if { // dequantize and idct the data
      + w,h:Int
      0.to (img_n-1) do { n:Int
        w := (img_comp.at n.x+7) >> 3
        h := (img_comp.at n.y+7) >> 3
        0.to (h-1) do { j:Int
          0.to (w-1) do { i:Int
            + data:C_array Int16
            data := img_comp.at n.coeff + 64 * (i + j * img_comp.at n.coeff_w)
            dequantize data with (dequant.at (img_comp.at n.tq))
            idct_block(img_comp.at n.data+img_comp.at n.w2*j*8+i*8, img_comp.at n.w2, data)
          }
        }
      }
    }
  )
  
  - sizes_mark:C_array Int := C_array Int.create 16
  - process_marker m:Int :Boolean <-
  ( + ll:Int
    + result:Boolean
    (m)
    .when marker_none then { // no marker found
      result := error_false "expected marker"
    }
    .when 0DDh then { // DRI - specify restart interval
      (get16be != 4).if {
        result := error_false "bad DRI len"
      } else {
        restart_interval := get16be
        result := True
      }
    }
    .when 0DBh then { // DQT - define quantization table
      ll := get16be - 2
      result := True
      {(ll > 0) && {result}}.while_do {
        + q,p,t:Int
        q := get8
        p := q >> 4
        t := q & 15
        ((p != 0) && {p != 1}).if {
          result := error_false "bad DQT type"
        }.elseif {t > 3} then {
          result := error_false "bad DQT table"
        } else {
          0.to 63 do { i:Int
            (p != 0).if {
              dequant.at t.at (dezigzag i) put get16be
            } else {
              dequant.at t.at (dezigzag i) put get8
            }
          }
          ll := ll - ((p != 0).ok 129 or 65)
        }
      }
      result := result && {ll = 0}
    }
    .when 0C4h then { // DHT - define huffman table
      + sizes:C_array Int
      sizes := sizes_mark
      ll := get16be - 2
      result := True
      {(ll > 0) && {result}}.while_do {
        + v:C_array Uint8
        + n,q,tc,th:Int
        n := 0
        q := get8
        tc := q >> 4
        th := q & 15
        ((tc > 1) || {th > 3}).if {
          result := error_false "bad DHT header"
        } else {
          0.to 15 do { i:Int
            sizes.at i put get8
            n := n + sizes.at i
          }
          (n > 256).if {
            // Loop over i < n would write past end of values!
            result := error_false "bad DHT header"
          } else {
            ll := ll - 17
            (tc = 0).if {
              result := huff_dc.at th.make sizes
              v := huff_dc.at th.values
            } else {
              result := huff_ac.at th.make sizes
              v := huff_ac.at th.values
            }
            (! result).if {
              error := "bad code lengths"
            } else {
              0.to (n-1) do { i:Int
                v.at i put get8
              }
              (tc != 0).if {
                huff_ac.at th.build_fast_ac (fast_ac.at th)
              }
              ll := ll - n
            }
          }
        }
      }
      result := result && {ll = 0}
    }
    // check for comment block or APP blocks
    (((m >= 0E0h) && {m <= 0EFh}) || {m = 0FEh}).if {
      ll := get16be
      (ll < 2).if {
        result := error_false ((m = 0FEh).ok "bad COM len" or "bad APP len")
      } else {
        ll := ll - 2
        ((m = 0E0h) && {ll >= 5}).if { // JFIF APP0 segment
          + ok:Boolean
          ok := True
          "JFIF".foreach { ch:Char
            (get8 != ch.to_uint8).if { ok := False; }
          }
          (get8 != 0).if { ok := False; }
          ll := ll - 5
          ok.if { jfif := 1; }
        }.elseif {(m = 0EEh) && {ll >= 12}} then { // Adobe APP14 segment
          + ok:Boolean
          ok := True
          "Adobe".foreach { ch:Char
            (get8 != ch.to_uint8).if { ok := False; }
          }
          (get8 != 0).if { ok := False; }
          ll := ll - 6
          ok.if {
            get8;    // version
            get16be; // flags0
            get16be; // flags1
            app14_color_transform := get8; // color transform
            ll := ll - 6
          }
        }
        skip ll
        result := True
      }
    }.elseif {(m != marker_none) && {m != 0DDh} && {m != 0DBh} && {m != 0C4h}} then {
      result := error_false "unknown marker"
    }
    result
  )

  // after we see SOS
  - process_scan_header:Boolean <-
  ( + ls:Int
    + aa:Int
    + result:Boolean
    ls := get16be
    scan_n := get8
    ((scan_n < 1) || {scan_n > 4} || {scan_n > img_n}).if {
      result := error_false "bad SOS component count"
    }.elseif {ls != 6+2*scan_n} then {
      result := error_false "bad SOS len"
    } else {
      result := True
      0.to (scan_n-1) do { i:Int
        + id,which,q:Int
        id := get8
        q := get8
        result.if {
          which := 0
          {(which < img_n) && {img_comp.at which.id != id}}.while_do {
            which := which + 1
          }
          (which = img_n).if {
            result := False; // no match
          } else {
            img_comp.at which.set_hd (q >> 4)
            img_comp.at which.set_ha (q & 15)
            (img_comp.at which.hd > 3).if {
              result := error_false "bad DC huff"
            }.elseif {img_comp.at which.ha > 3} then {
              result := error_false "bad AC huff"
            }
            order.at i put which
          }
        }
      }
      result.if {
        spec_start := get8
        spec_end   := get8; // should be 63, but might be 0
        aa := get8
        succ_high := (aa >> 4)
        succ_low  := (aa & 15)
        (progressive).if {
          ((spec_start > 63) || {spec_end > 63}  || {spec_start > spec_end} || {succ_high > 13} || {succ_low > 13}).if {
            result := error_false "bad SOS"
          }
        } else {
          ((spec_start != 0) || {succ_high != 0} || {succ_low != 0}).if {
            result := error_false "bad SOS"
          }
          spec_end := 63
        }
      }
    }
    result
  )

  - process_frame_header scan:Int :Boolean <-
  ( + lf,p,q, h_max,v_max,c,w2,h2:Int
    + result:Boolean
    h_max := v_max := 1
    lf := get16be
    (lf < 11).if { result := error_false "bad SOF len"; } else { // JPEG
      p  := get8
      (p != 8).if { result := error_false "only 8-bit"; } else { // JPEG baseline
        img_y := get16be
        img_x := get16be
        c := get8
        (img_y = 0).if {
          // Legal, but we don't handle it--but neither does IJG
          result := error_false "no header height"
        }.elseif {img_x = 0} then {
          result := error_false "0 width"; // JPEG requires
        }.elseif {(img_y > max_dimensions) || {img_x > max_dimensions}} then {
          result := error_false "too large"
        }.elseif {(c != 3) && {c != 1} && {c != 4}} then {
          result := error_false "bad component count"
        }.elseif {lf != 8+3*c} then {
          result := error_false "bad SOF len"
        } else {
          result := True
        }
      }
    }
    result.if {
      img_n := c
      0.to (c-1) do { i:Int
        img_comp.at i.set_data NULL
        img_comp.at i.set_linebuf NULL
      }
      rgb := 0
      0.to (img_n-1) do { i:Int
        img_comp.at i.set_id get8
        ((img_n = 3) && {img_comp.at i.id = "RGB".at i.to_uint8}).if {
          rgb := rgb + 1
        }
        q := get8
        img_comp.at i.h (q >> 4) v (q & 15) tq get8
        result.if {
          ((img_comp.at i.h = 0) || {img_comp.at i.h > 4}).if {
            result := error_false "bad H"
          }.elseif {(img_comp.at i.v = 0) || {img_comp.at i.v > 4}} then {
            result := error_false "bad V"
          }.elseif {img_comp.at i.tq > 3} then {
            result := error_false "bad TQ"
          }
        }
      }
    }
    (result && {scan = scan_load}).if {
      (! mad3sizes_valid(img_x, img_y, img_n, 0)).if {
        result := error_false "too large"
      } else {
        0.to (img_n-1) do { i:Int
          (img_comp.at i.h > h_max).if { h_max := img_comp.at i.h; }
          (img_comp.at i.v > v_max).if { v_max := img_comp.at i.v; }
        }
        // check that plane subsampling factors are integer ratios; our resamplers can't deal with fractional ratios
        // and I've never seen a non-corrupted JPEG file actually use them
        0.to (img_n-1) do { i:Int
          (h_max % img_comp.at i.h != 0).if { result := error_false "bad H"; }
          (v_max % img_comp.at i.v != 0).if { result := error_false "bad V"; }
        }
      }
    }
    (result && {scan = scan_load}).if {
      // compute interleaved mcu info
      img_h_max := h_max
      img_v_max := v_max
      img_mcu_w := h_max * 8
      img_mcu_h := v_max * 8
      // these sizes can't be more than 17 bits
      img_mcu_x := (img_x + img_mcu_w-1) / img_mcu_w
      img_mcu_y := (img_y + img_mcu_h-1) / img_mcu_h
      
      0.to (img_n-1) do { i:Int
        + comp:Flat Jpeg_comp
        comp := img_comp.at i
        // number of effective pixels (e.g. for non-interleaved MCU)
        comp.x ((img_x * comp.h + h_max-1) / h_max) y ((img_y * comp.v + v_max-1) / v_max)
        // to simplify generation, we'll allocate enough memory to decode
        // the bogus oversized data from using interleaved MCUs and their
        // big blocks (e.g. a 16x16 iMCU on an image of width 33); we won't
        // discard the extra data until colorspace conversion
        //
        // img_mcu_x, img_mcu_y: <=17 bits; comp[i].h and .v are <=4 (checked earlier)
        // so these muls can't overflow with 32-bit ints (which we require)
        w2 := img_mcu_x * comp.h * 8
        h2 := img_mcu_y * comp.v * 8
        comp.w2 w2 h2 h2 raw_data (get_na_uint8 (w2 * h2 + 15))
        comp.coeff NULL raw_coeff NULL
        comp.set_linebuf NULL
        // align blocks for idct using mmx/sse
        comp.set_data ((comp.raw_data + 15) & ~15)
        (progressive).if {
          + rb:C_array Uint8
          + rc,ac:C_array Int16
          // w2, h2 are multiples of 8 (see above)
          rb := get_na_uint8 (w2 * h2 * 2 + 15)
          rc := Cast (C_array Uint8) To (C_array Int16).on rb
          // align on 16 bytes (not 16 shorts)
          ac := Cast (C_array Uint8) To (C_array Int16).on ((rb + 15) & ~15)
          comp.coeff_w (w2 / 8) coeff_h (h2 / 8) raw_coeff rc coeff ac
        }
      }
    }
    result
  )

  // use comparisons since in some cases we handle more than one case (e.g. SOF)
  - dnl x:Int :Boolean <- (x = 0DCh)
  - soi x:Int :Boolean <- (x = 0D8h)
  - eoi x:Int :Boolean <- (x = 0D9h)
  - sof x:Int :Boolean <- (x = 0C0h) || {x = 0C1h} || {x = 0C2h}
  - sos x:Int :Boolean <- (x = 0DAh)

  - sof_progressive x:Int :Boolean <- (x = 0C2h)
  
  - decode_header scan:Int :Boolean <-
  ( + m:Int
    + result:Boolean
    jfif := 0
    app14_color_transform := -1; // valid values are 0,1,2
    marker := marker_none; // initialize cached marker to empty
    m := get_marker
    (! soi m).if {
      result := error_false "no SOI"
    }.elseif {scan = scan_type} then {
      result := True
    } else {
      result := True
      m := get_marker
      {(! sof m) && {result}}.while_do {
        result := process_marker m
        result.if {
          m := get_marker
          {(m = marker_none) && {result}}.while_do {
            // some files have extra padding after their blocks, so ok, we'll scan
            (at_eof).if {
              result := error_false "no SOF"
            } else {
              m := get_marker
            }
          }
        }
      }
      result.if {
        progressive := sof_progressive m
        result := process_frame_header scan
      }
    }
    result
  )

  - skip_jpeg_junk_at_end:Uint8 <-
  // some JPEGs have junk at end, skip over it but if we find what looks
  // like a valid marker, resume there
  ( + x,result:Uint8
    + found:Boolean
    result := marker_none
    {(! at_eof) && {! found}}.while_do {
      x := get8
      {(x = 0FFh) && {! found}}.while_do { // might be a marker
        (at_eof).if {
          found := True
        } else {
          x := get8
          ((x != 0) && {x != 0FFh}).if {
            // not a stuffed zero or lead-in to another marker, looks
            // like an actual marker, return it
            result := x
            found := True
          }
          // stuffed zero has x=0 now which ends the loop, meaning we go
          // back to regular scan loop.
          // repeated 0xff keeps trying to read the next byte of the marker.
        }
      }
    }
    result
  )

  // decode image to YCbCr format
  - decode_jpeg_image:Boolean <-
  ( + m:Int
    + result,stop:Boolean
    0.to 3 do { i:Int
      img_comp.at i.raw_data NULL raw_coeff NULL
    }
    restart_interval := 0
    result := decode_header scan_load
    result.if {
      m := get_marker
      {(! eoi m) && {result} && {! stop}}.while_do {
        (sos m).if {
          result := process_scan_header && {parse_entropy_coded_data}
          result.if {
            (marker = marker_none).if {
              marker := skip_jpeg_junk_at_end
              // if we reach eof without hitting a marker, get_marker() below will fail and we'll eventually return 0
            }
            m := get_marker
            (restart m).if { m := get_marker; }
          }
        }.elseif {dnl m} then {
          + ld,nl:Int
          ld := get16be
          nl := get16be
          (ld != 4).if {
            result := error_false "bad DNL len"
          }.elseif {nl != img_y} then {
            result := error_false "bad DNL height"
          } else {
            m := get_marker
          }
        }.elseif {! process_marker m} then {
          // as stb: the image is returned as it is (not finished if progressive)
          stop := True
        } else {
          m := get_marker
        }
      }
      (result && {! stop}).if { finish; }
    }
    result
  )

  // this is a reduced-precision calculation of YCbCr-to-RGB introduced
  // to make sure the code produces the same results in both SIMD and scalar
  - float2fixed x:Real32 :Int32 <-  (((x * 4096.0 + 0.5).to_int32) << 8)
  
  - y_cb_cr_to_rgb_row (pout,y,pcb,pcr:C_array Uint8, count,step:Int) <-
  ( + y_fixed,r,g,b,cr,cb:Int32
    + out:C_array Uint8
    out := pout
    0.to (count-1) do { i:Int
      y_fixed := (y.at i.to_int << 20) + (1<<19); // rounding
      cr := pcr.at i.to_int - 128
      cb := pcb.at i.to_int - 128
      //y.item i.print; '/'.print; cr.print; '/'.print; cb.print; '\n'.print
      r := y_fixed +  cr*  float2fixed 1.40200
      g := y_fixed + (cr* -float2fixed 0.71414) + ((cb* -float2fixed 0.34414) & `0xFFFF0000`:Int32)
      b := y_fixed                              +   cb*  float2fixed 1.77200
      r := r >> 20
      g := g >> 20
      b := b >> 20
      (r.to_raw_uint32 > 255).if { r := (r < 0).ok 0 or 255; }
      (g.to_raw_uint32 > 255).if { g := (g < 0).ok 0 or 255; }
      (b.to_raw_uint32 > 255).if { b := (b < 0).ok 0 or 255; }
      //"r=".print; r.print; " g=".print; g.print; " b=".print; b.println
      out.at 0 put (r.to_uint8)
      out.at 1 put (g.to_uint8)
      out.at 2 put (b.to_uint8)
      out.at 3 put 255
      out := out + step
    }
  )

  // clean up the temporary component buffers
  - cleanup <-
  (
    0.to (img_n-1) do { i:Int
      (img_comp.at i.raw_data != NULL).if {
        //STBI_FREE(j->img_comp[i].raw_data)
        img_comp.at i.data NULL raw_data NULL
      }
      (img_comp.at i.raw_coeff != NULL).if {
        //STBI_FREE(j->img_comp[i].raw_coeff)
        img_comp.at i.coeff NULL raw_coeff NULL
      }
      (img_comp.at i.linebuf != NULL).if {
        //STBI_FREE(j->img_comp[i].linebuf)
        img_comp.at i.set_linebuf NULL
      }
    }
  )
  
  - stk_uint8:Flat Array (Array Uint8)
  - stk_uint8_up:Int := -1
  - get_na_uint8 s:Int :C_array Uint8 <-
  ( + r:Array Uint8
    stk_uint8_up := stk_uint8_up + 1
    (stk_uint8_up > stk_uint8.upper).if {
      stk_uint8.add_last (Array Uint8.create s)
    }
    r := stk_uint8.at stk_uint8_up
    r.set_capacity s
    // a reused buffer starts blank, as a new one (no data from the previous image)
    r.storage.clear_all (s-1)
    r.storage
  )
  
  - coutput_load:C_array (C_array Uint8) := C_array (C_array Uint8).create 4
  - res_comp_load:C_array (Flat Resample) := C_array (Flat Resample).create 4
  
  - load req_comp:Int :C_array Uint8 <- load req_comp in NULL
  
  - clear_tables <-
  // stb_image starts each image with a new @stbi__jpeg: no table is kept
  // from the previous image.
  (
    0.to 3 do { i:Int
      dequant.at i.clear_all 63
      huff_dc.at i.clear
      huff_ac.at i.clear
      fast_ac.at i.clear_all ((1 << Huffman_jpg.fast_bits)-1)
      img_comp.at i.clear
    }
    code_buffer := 0
    code_bits := 0
    marker := 0
    nomore := 0
    progressive := False
    spec_start := spec_end := succ_high := succ_low := eob_run := 0
    scan_n := 0
    order.clear_all 3
    restart_interval := todo := 0
  )

  - blinn_8x8 (x,y:Uint8) :Uint8 <-
  ( + t:Uint32
    t := x.to_uint32 * y + 128
    ((t + (t >> 8)) >> 8).to_raw_uint8
  )

  - load req_comp:Int in ds:C_array Uint8 :C_array Uint8 <-
  ( + n, decode_n:Int
    + is_rgb:Boolean
    + output:C_array Uint8
    + coutput:C_array (C_array Uint8)
    + res_comp:C_array (Flat Resample)
    stk_uint8_up := -1
    rewind
    clear_tables
    img_n := 0; // make cleanup_jpeg safe
    // validate req_comp
    ((req_comp < 0) || {req_comp > 4}).if {
      error := "bad req_comp"
    }.elseif {! decode_jpeg_image} then {
      // load a jpeg image from whichever source, but leave in YCbCr format
      cleanup
    } else {
      // determine actual number of components to generate
      n := (req_comp != 0).ok req_comp or ((img_n >= 3).ok 3 or 1)
      is_rgb := (img_n = 3) && {(rgb = 3) || {(app14_color_transform = 0) && {jfif = 0}}}
      ((img_n = 3) && {n < 3} && {! is_rgb}).if {
        decode_n := 1
      } else {
        decode_n := img_n
      }
      // resample and color-convert
      coutput := coutput_load
      res_comp := res_comp_load
      0.to (decode_n-1) do { k:Int
        + r:Flat Resample
        + hs,vs:Int
        + line:C_array Uint8
        r := res_comp.at k
        // allocate line buffer big enough for upsampling off the edges
        // with upsample factor of 4
        img_comp.at k.set_linebuf (get_na_uint8 (img_x + 3))
        hs := img_h_max / img_comp.at k.h
        vs := img_v_max / img_comp.at k.v
        line := img_comp.at k.data
        r.hs hs vs vs ystep (vs >> 1) w_lores ((img_x + hs-1) / hs) ypos 0 line0 line line1 line
      }
      // can't error after this so, this is safe
      (ds = NULL).if {
        output := C_array Uint8.create (n * img_x * img_y + 1)
      } else {
        output := ds
      }
      // now go ahead and resample
      0.to (img_y-1) do { j:Int
        + out,y:C_array Uint8
        out := output + n * img_x * j
        0.to (decode_n-1) do { k:Int
          + r:Flat Resample
          r := res_comp.at k
          coutput.at k put (r.resample(img_comp.at k.linebuf))
          r.set_ystep (r.ystep + 1)
          (r.ystep >= r.vs).if {
            r.set_ystep 0
            r.set_line0 (r.line1)
            r.set_ypos (r.ypos + 1)
            (r.ypos < img_comp.at k.y).if {
              r.set_line1 (r.line1 + img_comp.at k.w2)
            }
          }
        }
        y := coutput.at 0
        (n >= 3).if {
          (img_n = 3).if {
            is_rgb.if {
              0.to (img_x-1) do { i:Int
                out.at 0 put (y.at i)
                out.at 1 put (coutput.at 1.at i)
                out.at 2 put (coutput.at 2.at i)
                out.at 3 put 255
                out := out + n
              }
            } else {
              y_cb_cr_to_rgb_row (out, y, coutput.at 1, coutput.at 2, img_x, n)
            }
          }.elseif {img_n = 4} then {
            (app14_color_transform = 0).if { // CMYK
              0.to (img_x-1) do { i:Int
                + m:Uint8
                m := coutput.at 3.at i
                out.at 0 put (blinn_8x8(coutput.at 0.at i, m))
                out.at 1 put (blinn_8x8(coutput.at 1.at i, m))
                out.at 2 put (blinn_8x8(coutput.at 2.at i, m))
                out.at 3 put 255
                out := out + n
              }
            }.elseif {app14_color_transform = 2} then { // YCCK
              y_cb_cr_to_rgb_row (out, y, coutput.at 1, coutput.at 2, img_x, n)
              0.to (img_x-1) do { i:Int
                + m:Uint8
                m := coutput.at 3.at i
                out.at 0 put (blinn_8x8(255 - out.at 0, m))
                out.at 1 put (blinn_8x8(255 - out.at 1, m))
                out.at 2 put (blinn_8x8(255 - out.at 2, m))
                out := out + n
              }
            } else { // YCbCr + alpha?  Ignore the fourth channel for now
              y_cb_cr_to_rgb_row (out, y, coutput.at 1, coutput.at 2, img_x, n)
            }
          } else {
            0.to (img_x-1) do { i:Int
              + c:Uint8
              c := y.at i
              out.at 0 put c; out.at 1 put c; out.at 2 put c
              out.at 3 put 255; // not used if n==3
              out := out + n
            }
          }
        }.elseif {is_rgb} then {
          0.to (img_x-1) do { i:Int
            out.at 0 put (compute_y3(y.at i, coutput.at 1.at i, coutput.at 2.at i))
            (n = 2).if { out.at 1 put 255; }
            out := out + n
          }
        }.elseif {(img_n = 4) && {app14_color_transform = 0}} then {
          0.to (img_x-1) do { i:Int
            + m,r,g,b:Uint8
            m := coutput.at 3.at i
            r := blinn_8x8(coutput.at 0.at i, m)
            g := blinn_8x8(coutput.at 1.at i, m)
            b := blinn_8x8(coutput.at 2.at i, m)
            out.at 0 put (compute_y3(r, g, b))
            out.at 1 put 255
            out := out + n
          }
        }.elseif {(img_n = 4) && {app14_color_transform = 2}} then {
          0.to (img_x-1) do { i:Int
            out.at 0 put (blinn_8x8(255 - coutput.at 0.at i, coutput.at 3.at i))
            out.at 1 put 255
            out := out + n
          }
        }.elseif {n = 1} then {
          0.to (img_x-1) do { i:Int; out.at i put (y.at i); }
        } else {
          0.to (img_x-1) do { i:Int; out.at (i*2) put (y.at i); out.at ((i*2)|1) put 255; }
        }
      }
      cleanup
      img_n := (img_n >= 3).ok 3 or 1; // report original components, not output
      img_out_n := n
    }
    output
  )

  - test:Boolean <-
  ( 
    rewind
    decode_header scan_type
  )

  - info_raw:Boolean <-
  (
    rewind
    !decode_header scan_header
  )

  - info:Boolean <- info_raw
  
