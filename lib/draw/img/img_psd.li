Header
  + name := Img_psd
Inherit
  
  + parent_image:Flat Image
  
Public
  
  - name:String_alias := "PSD - PhotoShop Document (Adobe)"
  
  + channel_count:Int
  + bitdepth:Int
  
  - test:Boolean <-
  ( + result:Boolean
    rewind
    result := get32be = 038_42_50_53h
    rewind
    result
  )
  
  - info:Boolean <-
  ( + result:Boolean
    rewind
    (get32be != 038425053h).if {
      error := "not PSD"
    }.elseif {get16be != 1} then {
      error := "wrong version"
    } else {
      skip 6
      channel_count := get16be
      (! channel_count.in_range 0 to 16).if {
        error := "wrong channel count"
      } else {
        img_y := get32be
        img_x := get32be
        bitdepth := get16be
        ((bitdepth != 8) && {bitdepth != 16}).if {
          error := "unsupported bit depth"
        }.elseif {get16be != 3} then {
          // Make sure the color mode is RGB.
          // Valid options are:
          //   0: Bitmap
          //   1: Grayscale
          //   2: Indexed color
          //   3: RGB color  <--------- Ok !
          //   4: CMYK color
          //   7: Multichannel
          //   8: Duotone
          //   9: Lab color
          error := "wrong color format"
        } else {
          img_n := 4
          result := True
        }
      }
    }
    result
  )

  - decode_rle p:C_array Uint8 size pixel_count:Int :Boolean <-
  // RLE as used by .PSD and .TIFF
  // Loop until you get the number of unpacked bytes you are expecting:
  //     Read the next source byte into n.
  //     If n is between 0 and 127 inclusive, copy the next n+1 bytes literally.
  //     Else if n is between -127 and -1 inclusive, copy the next byte -n+1 times.
  //     Else if n is 128, noop.
  // Endloop
  ( + count,nleft,len:Int
    + q:C_array Uint8
    + result:Boolean
    + val:Uint8
    q := p
    result := True
    {result && {(nleft := pixel_count - count) > 0}}.while_do {
      len := get8
      (len = 128).if {
        // No-op.
      }.elseif {len < 128} then {
        // Copy next len+1 bytes literally.
        len := len + 1
        (len > nleft).if {
          result := False; // corrupt data
        } else {
          count := count + len
          len.times {
            q.at 0 put get8
            q := q + 4
          }
        }
      } else {
        // Next -len+1 bytes in the dest are replicated from next source byte.
        // (Interpret len as a negative 8-bit int.)
        len := 257 - len
        (len > nleft).if {
          result := False; // corrupt data
        } else {
          val := get8
          count := count + len
          len.times {
            q.at 0 put val
            q := q + 4
          }
        }
      }
    }
    result
  )

  - load req_comp:Int :C_array Uint8 <-
  ( + pixel_count,compression:Int
    + out:C_array Uint8
    + ok:Boolean
    ok := info
    ok.if {
      ((img_y > max_dimensions) || {img_x > max_dimensions}).if {
        ok := error_false "too large"
      }
    }
    ok.if {
      skip get32be; // Skip the Mode Data.  (palette for indexed; other info.)
      skip get32be; // Skip the image resources. (resolution, pen tool paths, etc)
      skip get32be; // Skip the reserved data.
      // Find out if the data is compressed.
      // Known values:
      //   0: no compression
      //   1: RLE compressed
      compression := get16be
      (compression > 1).if {
        ok := error_false "bad compression"
      }.elseif {! mad3sizes_valid(4, img_x, img_y, 0)} then {
        ok := error_false "too large"
      }
    }
    ok.if {
      // Create the destination image.
      pixel_count := img_x * img_y
      out := C_array Uint8.create (pixel_count * 4)
      // Finally, the image data.
      (compression != 0).if {
        // The RLE-compressed data is preceeded by a 2-byte data count for each row in the data,
        // which we're going to just skip.
        skip (img_y * channel_count * 2)
        // Read the RLE data by channel.
        0.to 3 do { channel:Int
          + p:C_array Uint8
          p := out + channel
          (channel >= channel_count).if {
            + val:Uint8
            // Fill this channel with default data.
            val := (channel = 3).ok 255 or 0
            0.to (pixel_count-1) do { i:Int
              p.at (i*4) put val
            }
          }.elseif {ok} then {
            (! decode_rle p size pixel_count).if {
              ok := error_false "corrupt"; // bad RLE data
            }
          }
        }
      } else {
        // We're at the raw image data.  It's each channel in order (Red, Green, Blue, Alpha, ...)
        // where each channel consists of an 8-bit value for each pixel in the image.
        // Read the data by channel.
        0.to 3 do { channel:Int
          + p:C_array Uint8
          p := out + channel
          (channel >= channel_count).if {
            + val:Uint8
            // Fill this channel with default data.
            val := (channel = 3).ok 255 or 0
            0.to (pixel_count-1) do { i:Int
              p.at (i*4) put val
            }
          }.elseif {bitdepth = 16} then { // input bpc
            0.to (pixel_count-1) do { i:Int
              p.at (i*4) put ((get16be >> 8).to_raw_uint8)
            }
          } else {
            0.to (pixel_count-1) do { i:Int
              p.at (i*4) put get8
            }
          }
        }
      }
    }
    ok.if {
      // remove weird white matte from PSD
      (channel_count >= 4).if {
        0.to (pixel_count-1) do { i:Int
          + pixel:C_array Uint8
          pixel := out + 4*i
          ((pixel.at 3 != 0) && {pixel.at 3 != 255}).if {
            + a,ra,inv_a:Real32
            a := pixel.at 3.to_real32 / 255.0
            ra := 1.0 / a
            inv_a := 255.0 * (1.0 - ra)
            pixel.at 0 put (((pixel.at 0.to_real32 * ra + inv_a).to_raw_int).to_raw_uint8)
            pixel.at 1 put (((pixel.at 1.to_real32 * ra + inv_a).to_raw_int).to_raw_uint8)
            pixel.at 2 put (((pixel.at 2.to_real32 * ra + inv_a).to_raw_int).to_raw_uint8)
          }
        }
      }
      ((req_comp != 0) && {req_comp != 4}).if {
        out := convert_format out from 4 to req_comp
      }
    } else {
      out := NULL
    }
    out
  )

