Header
  + name := Fons_text_iter
Inherit
  
  - parent_clone:Clone := Clone
  
Private
  
  - stock_fons:Array Fons_text_iter := Array Fons_text_iter.create_with_capacity 32
  
  - new:Fons_text_iter <-
  ( + result:Fons_text_iter
    (stock_fons.is_empty).if {
      result := Fons_text_iter.clone
    } else {      
      result := stock_fons.pop
    }
    result
  )
  
Public
  
  + x:Real32
  + y:Real32
  + nextx:Real32
  + nexty:Real32
  + scale:Real32
  + spacing:Real32
  
  + codepoint:Uint32
  + isize:Int16
  + iblur:Int16
  
  + font:Fons_font
  
  + prev_glyph_index:Int
  + str:String
  
  + start:Int; // BSBS: me
  + next:Int
  + end:Int
  
  + utf8state:Uint32
  
  - set_start s:Int <- ( start := s; )
  - set_next s:Int <- ( next := s; )
  - set_utf8state v:Uint32 <- ( utf8state := v; )
  - set_codepoint c:Uint32 <- ( codepoint := c; )
  
  - set_xy (px,py:Real32) <- ( (x,y) := (px,py); )
  - set_next_xy (px,py:Real32) <- ( (nextx,nexty) := (px,py); )
  
  - set_prev_glyph_index v:Int <- ( prev_glyph_index := v; )
  
  - copy other:Fons_text_iter <-
  ( 
    (x,y)           := (other.x,other.y)
    (nextx,nexty)   := (other.nextx,other.nexty)
    (scale,spacing) := (other.scale,other.spacing)
    codepoint       := other.codepoint
    (isize,iblur)   := (other.isize,other.iblur)
    font            := other.font
    prev_glyph_index:= other.prev_glyph_index
    str             := other.str
    (start,next,end):= (other.start,other.next,other.end)
    utf8state       := other.utf8state
  )
  
  - create:Fons_text_iter <- new
  
  - create f:Fons_font isize s:Int16 iblur b:Int16 
  scale sc:Real32 :Fons_text_iter <-
  ( + result:Fons_text_iter
    result := new
    result.font f isize s iblur b scale sc
    result
  )
      
  - font f:Fons_font isize s:Int16 iblur b:Int16 scale sc:Real32 <-
  (
    font := f
    (isize,iblur) := (s,b)
    scale := sc
  )
  
  - xy (px,py:Real32) spacing sp:Real32 str st:String
  from fst:Int to ed:Int codepoint c:Uint32
  prev_glyph_index idx:Int <-
  (
    (x,y) := (nextx,nexty) := (px,py)
    spacing := sp
    str := st
    start := fst
    next := fst
    end := ed
    codepoint := c
    prev_glyph_index := idx
  )
    
  - reset <-
  (
    x := y := nextx := nexty := scale := spacing := 0.0
    codepoint := 0
    isize := iblur := 0
    font := NULL
    prev_glyph_index := 0
    str := NULL
    start := next := end := 0
    utf8state := 0
  )
  /*
  - print <-
  (
    "codepoint:".print
    (codepoint != 0).if { codepoint.to_char.print; '='.print; }; codepoint.print
    "\nstart:".print; start.print
    "\nnext:".print; next.print
    "\nend:".print; end.print
    "\nutf8state:".print; utf8state.print
    "\n==============\n".print
  )
*/
  - free <-
  (     
    stock_fons.add_last self
  )
