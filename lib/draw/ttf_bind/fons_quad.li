Header
  + name := Fons_quad
Inherit
  
  - parent_clone:Clone := Clone
  
Private
  
  - stock_fons_quad:Array Fons_quad := Array Fons_quad.create_with_capacity 32
    
  - new:Fons_quad <-
  ( + result:Fons_quad
    (stock_fons_quad.is_empty).if {
      result := Fons_quad.clone
    } else {
      result := stock_fons_quad.pop
    }
    result
  )
  
Public

  + x0:Real32
  + y0:Real32
  + s0:Real32
  + t0:Real32
  
  + x1:Real32
  + y1:Real32
  + s1:Real32
  + t1:Real32
  
  - create:Fons_quad <- new
  
  - free <- ( stock_fons_quad.add_last self; )
  
  - xy0 (px0,py0:Real32) xy1 (px1,py1:Real32) <-
  (
    (x0,y0) := (px0,py0)
    (x1,y1) := (px1,py1)
  )
  
  - st0 (ps0,pt0:Real32) st1 (ps1,pt1:Real32) <-
  (
    (s0,t0) := (ps0,pt0)
    (s1,t1) := (ps1,pt1)
  )
  
