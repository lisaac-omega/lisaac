Header
  + name := Fons_state
Inherit
  
  - parent_fontstash:Fontstash := Fontstash
  
Public

  + font:Int
  + align:Int
  + size:Real32
  + color:Uint32
  + blur:Real32
  + spacing:Real32
  
  - my_clone:Self <- clone
  
  - size s:Real32 color c:Uint32 
  font f:Int blur b:Real32 spacing sp:Real32 align a:Int <-
  (
    size := s; color := c; font := f
    blur := b; spacing := sp; align := a
  )
  
  - size s:Real32 spacing sp:Real32 blur b:Real32 align a:Int 
  font f:Int <-
  (
    size := s; font := f
    blur := b; spacing := sp; align := a
  )
