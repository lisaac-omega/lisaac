Header
  + name := Fons_atlas_node
Inherit
  
  - parent_fontstash:Fontstash := Fontstash
  
Private
  
  - stock:Array Fons_atlas_node := Array Fons_atlas_node.create_with_capacity 512
  
  - new:Fons_atlas_node <-
  ( + result:Fons_atlas_node
    (stock.is_empty).if {
      result := Fons_atlas_node.clone
    } else {
      result := stock.pop
    }
    result
  )
  
Public
  
  + x:Int16
  + y:Int16
  + width:Int16
  
  - set_x px:Int16 <- ( x := px; )
  - set_width pw:Int16 <- ( width := pw; )
  
  - create (px,py:Int16) width pw:Int16 :Fons_atlas_node <-
  ( + result:Fons_atlas_node
    result := new
    result.make (px,py,pw)
    result
  )
  
  - make (px,py,pw:Int16) <-
  (
    (x,y) := (px,py)
    width := pw
  )
  
  - free <-
  (
    stock.add_last self
  )
  
  - print <-
  (
    "[ ".print
    x.print; ','.print
    y.print; ','.print
    (x+width-1).print
    " ] ".print
    width.print; 'x'.print; (512-y).print
  )
