Header
  + name := Fons_params
Inherit
  
  - parent_fontstash:Fontstash := Fontstash
  
Public
  
  + width:Int
  + height:Int
  
  + flags:Uint8
  
  - set_width w:Int <- ( width := w; )
  - set_height h:Int <- ( height := h; )
  
  - create (w,h:Int) :Self <-
  ( + result:Self
    result := clone
    result.make (w,h)
    result
  )
  
  - make (w,h:Int) <-
  (
    (width,height) := (w,h)
    flags := fons_zero_topleft
  )
  
  //void* userPtr
  - render_create (width,height:Int) :Int <- 
  ( 
    "`render_create' not implemented.\n.".print;
    0
  )
  
  - render_resize (width,height:Int) :Int <-
  (
    "`render_resize' not implemented.\n.".print;
    0
  )
  
  - render_update (rect:Flat Rect,data:Array Uint8) <-
  (
    "`render_update' not implemented.\n.".print;
  )
  
  - render_draw verts:Array Real32 coord tcoords:Array Real32
  color colors:Array Int32 <-
  (
    "`render_draw' not implemented.\n.".print;
  )
  
  - render_delete <-
  (
    "`render_delete' not implemented.\n.".print;
  )

