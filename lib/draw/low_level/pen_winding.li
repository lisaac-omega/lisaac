Header
  + name := Pen_winding
Inherit
  
  + parent_pen_cmd:Flat Pen_cmd

Private
  
  - stack:Array Pen_winding := Array Pen_winding.create_with_capacity 16
  
Public
  
  + direction:Int
  
  - create dir:Int :Pen_winding <-
  ( + result:Pen_winding
    (stack.is_empty).if {
      result := clone
    } else {
      result := stack.last
      stack.remove_last
    }
    result.make dir
    result
  )
  
  - make dir:Int <-
  (
    direction := dir
  )
  
  - free <-
  ( 
    stack.add_last self
  )
  
  - to_path pc:Path_cache <-
  (
    pc.paths.last.set_winding direction
  )
