Header
  + name := Pen_line
Inherit
  
  + parent_pen_move:Flat Pen_move
  
Public
  
  - create (xx,yy:Real32) :Pen_move <-
  ( + result:Pen_move
    (stack_line.is_empty).if {
      result := clone
    } else {
      result := stack_line.last
      stack_line.remove_last
    }
    result.make (xx,yy)
    result
  )

  - to_path pc:Path_cache <-
  (
    pc.paths.last.add_point (x,y) flags pt_corner
  )
  
  - free <-
  ( 
    stack_line.add_last self
  )
  
  - svg_append_in buf:String_buffer <-
  (
    buf.add_last 'L'
    svg_put (x,y) in buf
  )
