Header
  + name := Flat Composite_operation_state
Inherit
  
  - parent_constant_pen:Constant_pen := Constant_pen
        
Public
  
  + src_rgb:Int
  + src_alpha:Int
  + dst_rgb:Int
  + dst_alpha:Int

  - make op:Int <-
  ( + sfactor,dfactor:Int
    op.when source_over then {
      sfactor := cst_one
      dfactor := cst_one_minus_src_alpha
    }.when source_in then {
      sfactor := cst_dst_alpha
      dfactor := cst_zero
    }.when source_out then {        
      sfactor := cst_one_minus_dst_alpha
      dfactor := cst_zero
    }.when atop then {
      sfactor := cst_dst_alpha
      dfactor := cst_one_minus_src_alpha
    }.when destination_over then {
      sfactor := cst_one_minus_dst_alpha
      dfactor := cst_one
    }.when destination_in then {        
      sfactor := cst_zero
      dfactor := cst_src_alpha
    }.when destination_out then {
      sfactor := cst_zero
      dfactor := cst_one_minus_src_alpha
    }.when destination_atop then {
      sfactor := cst_one_minus_dst_alpha
      dfactor := cst_src_alpha
    }.when lighter then {
      sfactor := cst_one
      dfactor := cst_one
    }.when cst_copy then {
      sfactor := cst_one
      dfactor := cst_zero
    }.when xor then {      
      sfactor := cst_one_minus_dst_alpha
      dfactor := cst_one_minus_src_alpha
    }
    src_rgb := src_alpha := sfactor
    dst_rgb := dst_alpha := dfactor
  )
  
  - convert_blend_func_factor factor:Int :Int <-
  ( + result:Int
    result := `GL_INVALID_ENUM`:Int
    (factor)
    .when cst_zero                then { result := `GL_ZERO`:Int; }
    .when cst_one                 then { result := `GL_ONE`:Int;  }
    .when cst_src_color           then { result := `GL_SRC_COLOR`:Int; }
    .when cst_one_minus_src_color then { result := `GL_ONE_MINUS_SRC_COLOR`:Int; }
    .when cst_dst_color           then { result := `GL_DST_COLOR`:Int; }
    .when cst_one_minus_dst_color then { result := `GL_ONE_MINUS_DST_COLOR`:Int; }
    .when cst_src_alpha           then { result := `GL_SRC_ALPHA`:Int; }
    .when cst_one_minus_src_alpha then { result := `GL_ONE_MINUS_SRC_ALPHA`:Int; }
    .when cst_dst_alpha           then { result := `GL_DST_ALPHA`:Int; }
    .when cst_one_minus_dst_alpha then { result := `GL_ONE_MINUS_DST_ALPHA`:Int; }
    .when cst_src_alpha_saturate  then { result := `GL_SRC_ALPHA_SATURATE`:Int; }
    result
  )
