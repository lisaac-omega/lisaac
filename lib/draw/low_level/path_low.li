Header
  + name := Flat Path_low
Inherit  
  - parent_clone:Clone := Clone
  
Public
  
  + fill_offset:Int
  + fill_count:Int
  
  + stroke_offset:Int
  + stroke_count:Int
    
  - make (fofs,fcnt:Int) stroke (sofs,scnt:Int) :Self <-
  (
    (fill_offset,fill_count)     := (fofs,fcnt)
    (stroke_offset,stroke_count) := (sofs,scnt)
    self
  )
