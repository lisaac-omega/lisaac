Header
  + name := Pen_cmd
Inherit
  
  - parent_constant_pen:Constant_pen := Constant_pen
  
Public
  
  - transform mtx:Transform <-
  (    
    // Nothing.
  )
  
  - to_path pc:Path_cache <-
  (
    abstract
  )
  
  - free <- abstract
  
Pen_cmd
  
  - get_tranform (sx,sy:Real32) with mtx:Transform :(Real32,Real32) <-
  ( + rx,ry:Real32
    rx := sx*mtx.t0 + sy*mtx.t2 + mtx.t4
    ry := sx*mtx.t1 + sy*mtx.t3 + mtx.t5
    rx,ry
  )
  
Public
    
  - svg_put (px,py:Real32) in buf:String_buffer <-
  (
    px.append_in buf
    buf.add_last ','
    py.append_in buf
  )
  
  - svg_append_in buf:String_buffer <- abstract
