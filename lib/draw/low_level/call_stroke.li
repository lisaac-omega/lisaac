Header
  + name := Call_stroke
Inherit
  
  + parent_pen_call_2d:Flat Pen_call_2d
  
Private
  
  - stack:Array Call_stroke := Array Call_stroke.create_with_capacity 16

Public
    
  - create_image img:Int path (pofs,pcnt:Int) 
  triangle (tofs,tcnt:Int) uniform uofs:Int :Pen_call_2d <-
  ( + result:Call_stroke
    (stack.is_empty).if {
      result := clone
    } else {
      result := stack.pop
    }
    result.make_image img path (pofs,pcnt) triangle (tofs,tcnt) uniform uofs
    result    
  )
  
  - free <-
  ( 
    stack.add_last self
  )
  
  - run_2d <- pen_gl.stroke self
