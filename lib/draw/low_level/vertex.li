Header
  + name := Flat Vertex
Inherit 
  
  - parent_clone:Clone := Clone
  
Mapping, Public
  
  + x:Real32
  + y:Real32
  + u:Real32
  + v:Real32
  
Public
  
  - make (px,py:Real32) axes (pu,pv:Real32) :Self <-
  ( (x,y) := (px,py)
    (u,v) := (pu,pv)
    self
  )
  
  - print <-
  (
    "x:".print; x.print; " y:".print; y.print; ' '.print
    "u:".print; u.print; " v:".print; v.print; '\n'.print
  )
