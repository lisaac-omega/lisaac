Header
  + name := Glyph_position
Inherit

  - parent_clone:Clone := Clone

Private  
  
  - stock:Array Glyph_position := Array Glyph_position.create_with_capacity 32
  
  - new:Glyph_position <-
  ( + result:Glyph_position
    (stock.is_empty).if {
      result := Glyph_position.clone
    } else {
      result := stock.pop
    }
    result
  )

Public
  
  + cur:Int;        // Position of the glyph in the input string.
  + x:Real32;                // The x-coordinate of the logical glyph position.
  + minx:Real32;        // The bounds of the glyph shape.
  + maxx:Real32
  
  - create c:Int to px:Real32 range (mi,ma:Real32) :Glyph_position <-
  ( + result:Glyph_position
    result := new
    result.make c to px range (mi,ma)
    result    
  )
  
  - make c:Int to px:Real32 range (mi,ma:Real32) <-
  (
    cur := c
    x := px
    (minx,maxx) := (mi,ma)
  )
  
  - free <- stock.add_last self
