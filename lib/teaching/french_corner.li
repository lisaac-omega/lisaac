Header
  + name := French_corner
/*
  To insert to add a small touch of French for beginners in programming.


  */
  
Private
  
  - lire_entier:Int <-
  (
    Stdin.read_line
    while {! Stdin.last_string.is_integer} do {
      "Il faut taper un entier. Recommence.".print;
      Stdin.read_line
    }
    Stdin.last_string.to_int
  )
  
  - lire_chaine:String_alias <- 
  (
    Stdin.read_line
    Stdin.last_string.to_string_alias
  )
  
  - lire_réel:Real64 <-
  ( + ok:Boolean
    + result:Real64
    Stdin.read_line
    (ok, result) := Stdin.last_string.to_real64_at 0
    until {ok} do {
      "Il faut taper un réel. Recommence.".print;
      Stdin.read_line
      (ok, result) := Stdin.last_string.to_real64_at 0
    }
    result
  )  
  
  - vrai:Boolean <- True
  
  - faux:Boolean <- False
  
  - non (b:Boolean):Boolean <- !b
  
  - écrire e:E et f:F <-
  (
    Out # e # f
  )
  
  - écrire e:E et f:F et g:G <-
  (
    Out # e # f # g
  )
  
  // Accès aux arguments de la ligne de commande:
  
  - argument idx:Int :String_alias <- 
  ( 
    (Command_args.valid_index idx).if_false {
      Out # "Il manque l'argument numéro " # idx # " en ligne de commande.\n"
      Out # "Voici la commande lancée (" # (Command_args.upper) # ' '
      if ((Command_args.upper) <= 1) then {
        Out # "argument"
      } else {
        Out # "arguments"
      }
      Out # "):\n"
      0.to (Command_args.upper) do { i:Int
        Out # (Command_args.at i) # ' '
      }
      Out # '\n'
      System.exit 1
    }
    Command_args.at idx
  )
  
  - argument idx:Int entier:Int <- 
  ( + str:String
    
    str := argument idx
    if (! str.is_integer) then {
      Out # "L'argument numéro " # idx # " de la ligne de commande ne correspond pas à un entier.\n"
      Out # "Voici cet argument: " # str # '\n'
      System.exit 1
    }
    str.to_int
  )
  
  - argument idx:Int réel:Real64 <-
  ( + str:String
    + ok: Boolean
    + result:Real64
    
    str := argument idx
    (ok, result) := str.to_real64_at 0
    if (! ok) then {
      Out # "L'argument numéro " # idx # " de la ligne de commande ne correspond pas à un réel.\n"
      Out # "Voici cet argument: " # str # '\n'
      System.exit 1
    }
    
    result
  )
  