Header
  + name := Tortue
/*    Tortue Logo Ω

  */
Inherit
  
  + parent_window:Flat Window
Insert
  
  - parent_french:Flat French_corner
  
  - parent_colors:Flat Colors
  
Private
  
  + running:Boolean
  
  + turtle_x: Real32
  + turtle_y: Real32
  
  + angle: Int // of the turtle in [0 , 360]
  
  + background: Color
  
  + pen_color: Color
  + pen_width: Int  
  + pen_down:Boolean
  
  + random:Random
  
  - aupif (min, max:Int) : Int <- (random.min min max max)
 
Public
  
  - main <-
  (
    Out # "Le raccourci clavier Q ferme le dessin.\n"
    dessin
    running := True
    Paper.run    
  )
     
  - draw <-
  ( - mem:Boolean
    - x:Real32
    - y:Real32
    - a:Int
    - c:Color
    - w:Int
    - d:Boolean
    draw_background
    mem.if_false {
      mem := True
      x := turtle_x
      y := turtle_y
      a := angle
      c := pen_color
      w := pen_width
      d := pen_down
    }
    dessin
    téléportation (x,y) angle a pen d couleur c épaisseur w
  )
   
Private
  
  - titre t:String_alias départ (x,y:Int) taille (l,h:Int) <-
  ( - mem:Boolean
    mem.if_false {
      mem := True
      (turtle_x, turtle_y) := (x, y)
      pen_down := True
      pen_color := black
      pen_width := 1
      background := white
      random := Random.new.init_clock    
      init t size (l,h)
      set_pos(0,0)
    }
  )
  
  - titre t:String_alias départ (x,y:Int) <- titre t départ (x,y) ratio 35
  
  - titre t:String_alias taille (x,y:Int) <- titre t départ (0,0) taille (x, y)
  
  - draw_background <-
  (
    begin_path
    rect (0,0) size (width,height)
    fill_color background
    fill
  )
  
Public
  
  - key s:String cmd c:Uint8 :Boolean <-
  (
    if ("qQ".has (s.first)) then {
      exit 0
    }
    String.tmp { key:String_buffer
      Keyboard.key_to_string s cmd c in key
      if ("Esc" == key) then {
        exit 0
      } else {
        Out # "key " # key # "\n"
      }
    }
    True
  )
   
  - mouse_scroll (dx,dy: Real64) <- ();
  
Private
  
  - π:Real32 := Real32 pi
 
  - avance pixels:Int <-
  ( + tx, ty, rad:Real32
    
    if running then {
      //OUT # "(" # turtle_x # ',' # turtle_y # ") " # angle # " " # pen_down # '\n'  
      ? {angle .in_range 0 to 360}
      if (angle = 0) then {
        (tx, ty) := (turtle_x + pixels, turtle_y)
      }.elseif {angle = 180} then {
        (tx, ty) := (turtle_x - pixels, turtle_y)      
      }.elseif {angle = 90} then {
        (tx, ty) := (turtle_x, turtle_y + pixels)
      }.elseif {angle = 270} then {
        (tx, ty) := (turtle_x, turtle_y - pixels)      
      } else {
        rad := (angle * π) .div 180.0
        tx := cos(rad) * pixels + turtle_x  
        ty := sin(rad) * pixels + turtle_y
      }
      tx := tx.clamp(0, width.to_raw_int)
      ty := ty.clamp(0, height.to_raw_int)
      if pen_down then {
        stroke {
          move_to (turtle_x, turtle_y)
          line_to(tx, ty)
        } width pen_width color pen_color
      }
      (turtle_x, turtle_y) := (tx, ty)
    }
  )
  
  - recule pixels:Int <- avance (- pixels)
   
  - tourne a:Int <-
  (
    ? {angle.in_range 0 to 360}
    if running then {
      angle := angle + a
      if (a = 0) then {
        // Nothing
      }.elseif {a > 0} then {
        while {angle >= 360} do {
          angle := angle - 360
        }
      } else {
        while {angle < 0} do {
          angle := angle + 360
        }      
      }
    }
  )
  
  - tourne_gauche a:Int <- tourne (-a)
  - tourne_droite a:Int <- tourne a
  
  - carré pixels:Int <-
  (
    4 times {
      avance pixels
      tourne 90
    }
  )
  
  - hexagone pixels:Int <-
  (
    6 times {
      avance pixels
      tourne 60
    }
  )
  
  - texte txt:String <- texte txt xy (turtle_x, turtle_y)
  
  - texte txt:String xy (x,y:Real32) <- 
    texte txt xy (x,y) taille pen_width couleur pen_color
  
  - texte txt:String xy (x,y:Real32) taille t: Int couleur c:Color <-
  ( + state:State

    if running then {      
      state := get_state
      state.set_font_size (14 + (8 * t))
      fill_color c
      text (x, y) msg txt
    }
  )
  
  - cercle rayon:Int <-
  // La tortue marche sur le cercle (36 pas de 10°), elle part et revient au même endroit,
  // dans la même direction. Le centre est sur le côté.
  ( + pas:Int

    pas := (rayon * 6283) / 36000 // 2.pi.r / 36
    répéter 36 fois {
      avance pas ; tourne 10
    }
  )
  
  - arc r:Int degrés d:Int <-
  // La tortue marche sur un arc de cercle de rayon @r et de @d degrés
  // (pas de 10°). Elle tourne donc de @d au total.
  [
    ((d % 10) = 0)
  ]
  ( + pas:Int

    pas := (r * 6283) / 36000 // 2.pi.r / 36
    répéter (d / 10) fois {
      avance pas ; tourne 10
    }
  )  
  
  - couleur_trait c:Color <- pen_color := c
  
  - épaisseur_trait e:Int <- pen_width := e.max 1
  
  - lève_crayon <- ( pen_down := False )
  
  - baisse_crayon <- ( pen_down := True )
  
  - téléportation (x:Real32, y:Real32) <- 
  (
    if running then {
      turtle_x := x.clamp(0, width)
      turtle_y := y.clamp(0, height)
    }
  )
  
  - téléportation (x:Real32, y:Real32) angle a:Int <-
  (
    if running then {
      téléportation(x,y)
      angle := a
    }
  )
  
  - téléportation (x:Real32, y:Real32) angle a:Int pen d:Boolean couleur c:Color épaisseur e:Int <-
  (
    if running then {
      téléportation(x,y) angle a
      pen_down := d
      couleur_trait c
      épaisseur_trait e
    }
  )
  
  - couleur_aupif: Color <-  random.color
  
  - tourne x:Int gauche <- tourne_gauche x
  
  - tourne x:Int droite <- tourne_droite x
  
  - fond bg:Color trait pc:Color <-
  (
    background := bg
    pen_color := pc
  )
  
  - fond bg:Color crayon (pw:Int, pc:Color) <-
  (
    background := bg
    pen_color := pc
    pen_width := pw
  )
  
