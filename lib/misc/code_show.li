Header
  + name := Code_show
  
/**/
Insert
  
  - parent_mini_bash:Mini_bash := Mini_bash
    
Private
  
  + exec_directory:String_alias
  
  + elit_view:Boolean := False
  
  + background: Boolean := True
  
  - show list:String_alias^n <-
  ( + dir, file, path_li, exec, args, cmd_run:String_alias
    + idx, array_idx:Int
    + array:Array String_alias
    + bg, ev, do_run:Boolean
    
    verbose := Command_args.option_shift "--verbose"
    
    if (Command_args.option_shift "--elit_view") then {
      elit_view := True
    }
    
    background := ! Command_args.option_shift "--no_background"
    if (Command_args.upper != 0) then {
      Out # (Command_args.at 0) # ": \"" # (Command_args.at 1) # "\" no such option.\n"
      Out # "Possible options: --verbose --elit_view --no_background\n"
      System.exit 1
    }
    File_utils.pwd_in working_directory
    ? {working_directory.last = '/'}
    exec_directory := working_directory.to_string_alias  
    verbose.if {
      Out # "exec_directory=" # exec_directory # '\n'
      Out # "elit_view=" # elit_view # '\n'
      Out # "background=" # background # '\n'
    }
    array := new Array String_alias of list
    verbose.if {
      Out # array # '\n'
    }
    
    while {array_idx <= array.upper} do {
      path_li := array.at array_idx
      (path_li.has_suffix ".li").if_false {
        Out # "Wrong argument for the show: \"" # path_li # "\" at index " # array_idx # ".\n"
        System.exit 1
      }
      array_idx := array_idx + 1
      
      bg := background
      if (check "background" at (array, array_idx)) then {
        array_idx := array_idx + 1
        bg := True
      }
      if (check "wait" at (array, array_idx)) then {
        array_idx := array_idx + 1
        bg := False
      }
      
      ev := elit_view
      if (check "elit-view" at (array, array_idx)) then {
        array_idx := array_idx + 1
        ev := True
      }
      
      do_run := True ; args := ""
      if (check "run" at (array, array_idx)) then {
        array_idx := array_idx + 1
        args := array.at array_idx
        array_idx := array_idx + 1
      }
      if (check "no-run" at (array, array_idx)) then {
        array_idx := array_idx + 1
        do_run := False
      }
              
      String.tmp { buf: String_buffer
        buf.append ".li"
        idx := path_li.upper -3
        while {(idx >= 0) && {path_li.at idx != '/'}} do {
          buf.add_first (path_li.at idx)
          idx := idx -1
        }
        file := buf.to_string_alias
        buf.clear
        dir := ""
        (idx > 0).if {
          0.to idx do { i:Int
            buf.add_last (path_li.at i)
          }
        }
        dir := buf.to_string_alias
      } 
      
      String.tmp { buf:String_buffer
        buf.copy file
        buf.remove_tail 3
        exec := buf.to_string_alias
      }
      
      String.tmp { buf:String_buffer
        buf.copy exec_directory
        buf.extend_unless '/'
        buf.append dir
        buf.extend_unless '/'
        cd buf
      }
      
      String.tmp { buf:String_buffer
        buf.copy working_directory
        buf.extend_unless '/'
        buf.append exec
        buf.append " "
        buf.append args
        cmd_run := buf.to_string_alias
        verbose.if {
          Out # "cmd_run=\"" # cmd_run # "\"\n"
        }
      }
      
      do_run.if {
        run ("lisaac " + file + " -boost -q")
      }
      if (elit_view || {ev}) then {
        do_run.if {
          run cmd_run background
        } 
        run ("elit " + file)
      }.elseif {bg} then {
        do_run.if {
          run cmd_run background
        }
      } else {
        do_run.if {
          run cmd_run
        }
      }
      
      /*
      do_run.if {
        run ("rm -f " + exec + " " + exec + "*.c " +  exec + "*.h " + exec + "*.o") 
      }
      */
    }
  )
    
  - cd dir:String <-
  (
    if (Environment.chdir dir = 0) then {
      Out # "cd " # dir #'\n'
      working_directory.clear
      File_utils.pwd_in working_directory
      //OUT # "cwd: " # working_directory # '\n'
    } else {
      crash_with_message ("Cannot chdir into \"" + dir + "\"")
    }
  )
  
  - run cmd:String  <- run cmd background_flag False
  
  - run cmd:String background  <- run cmd background_flag True
  
  - run cmd:String background_flag bf:Boolean  <-
  ( + exit_status:Int
    
    verbose .if {
      Out # "run \""  # cmd # "\" background=" # bf # '\n'
    }
    bf.if {
      exit_status := Environment.run cmd background
    } else {
      exit_status := Environment.run cmd
    }
    ((!bf) && {exit_status != 0}).if {
      Out # "code_show: exit_status=" # exit_status 
          # " run \"" # cmd # "\" background_flag " # bf # '\n'
    }   
  )
  
  - check tag:String_alias at (array:Array String_alias, array_idx:Int): Boolean <-
  ( 
    ((array_idx <= array.upper) && {array.at array_idx = tag})
  )
  