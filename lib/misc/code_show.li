Header
  + name := Code_show
  
/**/
Insert
  - parent_mini_bash:Mini_bash := Mini_bash
    
Private
  
  + run_dir:String_alias  
  
  - cd dir:String <-
  (
    if (Environment.chdir dir = 0) then {
      Out # "cd " # dir #'\n'
      working_directory.clear
      File_utils.working_directory_in working_directory
      //OUT # "cwd: " # working_directory # '\n'
    } else {
      crash_with_message ("Cannot chdir into \"" + dir + "\"")
    }
  )
  
  - directory dir:String_alias main m:String_alias run r:Boolean elit e:Boolean <-
  ( + cmd_lisaac, cmd_elit, cmd_run, cmd_rm:String
    if (run_dir = NULL) then {
      File_utils.working_directory_in working_directory
      run_dir := working_directory.to_string_alias  
    }
    String.tmp { b:String_buffer
      b.copy run_dir
      b.extend_unless '/'
      b.append dir
      b.extend_unless '/'
      cd b
      cmd_lisaac := "lisaac " + m + " -boost -q"
      cmd_elit := "elit " + b + m + ".li"
      cmd_run := "./" + m
      cmd_rm := "rm -f " + m + " " + m + "*.c " + m + "*.h " + m + "*.o"
      if (e && {r}) then {
        run cmd_elit background
        run cmd_lisaac ; run cmd_run ; run cmd_rm
      }.elseif {e && {! r}} then {
        run cmd_lisaac
        run cmd_elit
      }.elseif {(!e) && {r}} then {
        run cmd_lisaac ; run cmd_run ; run cmd_rm
      }.elseif {(!e) && {!r}} then {
        run cmd_lisaac        
      } else {
        ? {False}
      }
    }
  )
  
  - directory dir:String_alias main m:String_alias background <-
  ( + cmd_run:String
    // OUT # "directory " # dir # " main " # m # '\n'
    directory dir main m run False elit False
    cmd_run := "./" + m
    run cmd_run background
  )
  
  - run cmd:String  <-
  (
    cmd.println
    Environment.run cmd
  )
  
  - run cmd:String background  <-
  (
    Out # cmd # " &\n"
    Environment.run cmd background
  )
  
  - show list:String_alias^n <-
  (
    { ex:String_alias
      directory "" main ex run True elit True
    }.value list
  )
  
  - basic dir:String_alias run go:Boolean main m:String_alias <-
  ( + cmd_lisaac, cmd_elit, cmd_run, cmd_rm:String
    Environment.run "clear"
    String.tmp { b:String_buffer
      b.copy dir
      b.extend_unless '/'
      cd b
      cmd_lisaac := "lisaac " + m + " -boost -q"
      cmd_elit := "elit " + b + m + ".li 1>/dev/null"
      cmd_run := "./" + m
      cmd_rm := "rm -f " + m + " " + m + "*.c " + m + "*.h " + m + "*.o"
      Environment.run cmd_lisaac
      if (go) then {
        Environment.run cmd_run background 
      } else {
        Out # b # m # '\n'
      }
      Environment.run cmd_elit
      Environment.run cmd_rm      
    }
  )
  