Header
  + name := CODE_SHOW
Insert
  - parent_mini_bash:MINI_BASH := MINI_BASH
    
Private
  
  + example_dir:STRING_ALIAS  
  
  - directory dir:STRING_ALIAS main m:STRING_ALIAS run r:BOOLEAN elix e:BOOLEAN <-
  ( + cmd_lisaac, cmd_elix, cmd_run:STRING
    if (example_dir = NULL) then {
      FILE_UTILS.working_directory_in working_directory
      example_dir := working_directory.to_string_alias  
    }
    //OUT # "show " # directory # " name " # n # '\n'
    STRING.tmp { b:STRING_BUFFER
      b.copy example_dir
      b.extend_unless '/'
      b.append dir
      b.extend_unless '/'
      //OUT # b # n # ".li\n"
      if (ENVIRONMENT.chdir b = 0) then {
        OUT # "cd " # b #'\n'
        working_directory.clear
        FILE_UTILS.working_directory_in working_directory
      } else {
        crash_with_message ("Cannot chdir into \"" + b + "\"")
      }
      cmd_lisaac := "lisaac " + m + " -boost -q"
      cmd_elix := "elix " + b + m + ".li 2> /dev/null"
      cmd_run := "./" + m
      if (e && {r}) then {
        run cmd_elix background
        run cmd_lisaac
        run cmd_run
      }.elseif {e && {! r}} then {
        run cmd_lisaac
        run cmd_elix
      } else {
        run cmd_lisaac
        run cmd_run
      }
    }
  )
  
  - run cmd:STRING  <-
  (
    cmd.println
    ENVIRONMENT.run cmd
  )
  
  - run cmd:STRING background  <-
  (
    cmd.println
    ENVIRONMENT.run cmd background
  )
  
  - show list:STRING_ALIAS^n <-
  (
    { ex:STRING_ALIAS
      directory "" main ex run TRUE elix TRUE
    }.value list
  )
 