Header
  + name := Test
Insert
  - parent_utils:Utils := Utils
  - parent_print:Print := Print
  
Public  
  + counter:Int
  
  - check assert:Boolean <-
  (
    counter := counter + 1
    assert.if_false {
      crash_with_message "TEST.check failed."
    }
  )
  
  - check_false assert:Boolean <- check (! assert)

  - check str1:String string str2:String <-
  (
    counter := counter + 1
    (str1 == str2).if_false {
      crash_with_message ("TEST.check failed: \"" + str1 + "\" != \"" + str2 + "\"")
    }
  )
  
  - check c1:Char character c2:Char <-
  (
    counter := counter + 1
    (c1 = c2).if_false {
      String.tmp { msg:String_buffer
        msg.append "TEST.check failed: '"
        msg.add_last c1
        msg.append "' != '"
        msg.add_last c2
        msg.append "'"
        crash_with_message msg
      }
    }
  )
  
  - check i1:Int integer i2:Int <-
  (
    counter := counter + 1
    (i1 = i2).if_false {
      crash_with_message ("TEST.check failed: " + i1.to_string + " != " + i2.to_string)
    }
  )
  
  - check i1:ℤ intz i2:ℤ <-
  (
    counter := counter + 1
    (i1 == i2).if_false {
      crash_with_message ("TEST.check failed: " + i1.to_string + " != " + i2.to_string)
    }
  )
  
  - check assert:Boolean txt txt:{String} <-
  (
    counter := counter + 1
    assert.if_false {
      crash_with_message ("TEST.check failed: " + txt.value)
    }
  )
  
  - check_not_null o:E <- check (o != NULL)
  
  - check_null o:E <-
  (
    counter := counter + 1
    (o = NULL).if_false {
      o.println
      crash_with_message ("TEST.check failed: " + o.to_string)
    }
  )
  
  - check c1:Char char c2:Char <-
  (
    counter := counter + 1
    (c1 = c2).if_false {
      crash_with_message ("TEST.check failed: '" + c1.to_string + "' != '" + c2.to_string + "'")
    }
  )
  
  
