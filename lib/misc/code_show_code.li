Header
  + name := Code_show_code
/*
  Read only view of the header comment of the current example of the
  graphical `Code_show' (the code itself is opened in elit): long lines
  are wrapped, keeping their indentation; scrolling. As in elit, a name
  written with an at sign before it is shown without the at sign, in
  blue for a variable or a slot, in green for a prototype.
  */
Inherit
  + parent_gobj:Flat Gobj Code_show_code

Public

  + entry:Code_show_entry
  + top:Real32      // First visible row (may be fractional).

  - margin:Real32 := 28

  + rows:Array Int
  // Wrapped rows: quadruples (line of the comment, first byte, last byte,
  // indentation in columns of the continuation rows, 0 otherwise).
  + rows_width:Real32
  + rows_size:Real32
  + rows_entry:Code_show_entry

  - create:Self <-
  ( + result:Self
    result := clone
    result.init_obj
    result
  )

  - set_entry e:Code_show_entry <-
  (
    entry := e
    entry.load_comment
    top := 0
  )

  - line_h:Real32 <- Code_show_look.code_size * 1.5

  - visible_lines:Real32 <- (height - margin * 2) / line_h

  - row_count:Int <-
  ( + result:Int
    (rows != NULL).if { result := rows.count / 4; }
    result
  )

  - scroll dy:Real32 <-
  (
    top := top - dy * 3
    clamp
  )

  - page dir:Int <-
  (
    top := top + dir.to_real32 * ((visible_lines - 2).max 1)
    clamp
  )

  - clamp <-
  ( + m:Real32
    m := (row_count.to_real32 - visible_lines).max 0
    top := (top.max 0).min m
  )

  - char_w:Real32 <-
  ( + x0,y0,x1,y1,w:Real32
    set_font
    (w,x0,y0,x1,y1) := text_bounds (0,0) msg "0000000000"
    w / 10
  )

  - set_font <-
  (
    (Code_show_look.mono >= 0).if {
      font_face_id (Code_show_look.mono)
    } else {
      font_face_id (Font.sys (Font.roman))
    }
    font_size (Code_show_look.code_size)
  )

  - wrap <-
  // Compute `rows' for the current width and font size.
  ( + cols,c,b,i,sp,ind,lead:Int
    + s:String_alias
    (rows = NULL).if { rows := Array Int.create_with_capacity 256; }
    rows.clear
    (rows_entry,rows_width,rows_size) := (entry,width,Code_show_look.code_size)
    cols := (((width - margin * 2) / char_w).to_int).max 20
    0.to (entry.comment.upper) do { k:Int
      s := entry.comment.at k
      lead := 0
      {(lead <= s.upper) && {s.at lead = ' '}}.while_do { lead := lead + 1; }
      (lead > cols / 2).if { lead := 0; }
      (s.is_empty).if {
        add_row (k,0,-1,0)
      }
      b := 0
      ind := 0
      {b <= s.upper}.while_do {
        // As many characters as possible, cut after the last space:
        i := b
        c := ind
        sp := -1
        {(i <= s.upper) && {c < cols}}.while_do {
          (s.at i = ' ').if { sp := i; }
          ((s.at i).to_uint8 & 0C0h != 80h).if { c := c + 1; }
          i := i + 1
        }
        {(i <= s.upper) && {(s.at i).to_uint8 & 0C0h = 80h}}.while_do { i := i + 1; }
        ((i <= s.upper) && {s.at i = ' '}).if { sp := i; }
        (i > s.upper).if {
          add_row (k,b,s.upper,ind)
          b := s.count
        }.elseif {sp > b} then {
          add_row (k,b,sp - 1,ind)
          b := sp + 1
          {(b <= s.upper) && {s.at b = ' '}}.while_do { b := b + 1; }
        } else {
          add_row (k,b,i - 1,ind)
          b := i
        }
        ind := lead
      }
    }
  )

  - add_row (k,b,e,ind:Int) <-
  (
    rows.add_last k
    rows.add_last b
    rows.add_last e
    rows.add_last ind
  )

  - draw <-
  ( + cw,lh,x0,y,yb:Real32
    + first,last,r:Int
    + s:String_alias
    begin_path
    rect (xo,yo) size (width,height)
    fill_color (Code_show_look.background)
    fill
    (entry != NULL).if {
      ((rows_entry != entry) || {rows_width != width} || {rows_size != Code_show_look.code_size}).if {
        wrap
      }
      clamp
      cw := char_w
      lh := line_h
      x0 := xo + margin
      save
      intersect_scissor (xo,yo) size (width,height)
      text_align (align_left | align_middle)
      (row_count = 0).if {
        font_face_id (Font.sys (Font.roman))
        font_size (Code_show_look.ui_size)
        fill_color (Code_show_look.text_faint)
        text (x0, yo + margin + lh / 2) msg "Pas de commentaire d'entête dans ce fichier : le code est à voir dans elit."
      } else {
        first := top.to_int
        last := ((top + visible_lines + 1).to_int).min (row_count - 1)
        first.to last do { i:Int
          r := i * 4
          (rows.at (r + 1) <= rows.at (r + 2)).if {
            y := yo + margin + (i.to_real32 - top) * lh + lh / 2
            s := entry.comment.at (rows.at r)
            draw_row (x0 + cw * (rows.at (r + 3)).to_real32, y) msg s from (rows.at (r + 1)) to (rows.at (r + 2))
          }
        }
      }
      reset_scissor
      restore
      // Vertical scroll indicator:
      (row_count > 0).if {
        yb := (visible_lines / row_count.to_real32).min 1
        (yb < 1).if {
          begin_path
          rect (xmax - 6, yo + 4 + (height - 8) * top / row_count.to_real32) size (4, (height - 8) * yb) radius 2
          fill_color (Code_show_look.panel_hover)
          fill
        }
      }
    }
  )

  - draw_row (x,y:Real32) msg s:String from b:Int to e:Int <-
  // Draw @s from @b to @e, with the colors of the referenced names.
  ( + i,j,n:Int
    + cw:Real32
    cw := char_w
    i := b
    {i <= e}.while_do {
      // Plain text, up to the next referenced name:
      j := i
      {(j <= e) && {! is_ref s at j from b to e}}.while_do { j := j + 1; }
      (j > i).if {
        fill_color (Code_show_look.text)
        text (x + cw * n.to_real32, y) msg s from i to (j - 1)
        n := n + columns s from i to (j - 1)
      }
      // The referenced name, without its at sign:
      (j <= e).if {
        i := j + 1
        j := i
        {(j <= e) && {is_word (s.at j)}}.while_do { j := j + 1; }
        fill_color ((is_prototype s at i).ok (Code_show_look.comment_type) or (Code_show_look.comment_slot))
        text (x + cw * n.to_real32, y) msg s from i to (j - 1)
        n := n + columns s from i to (j - 1)
      }
      i := j
    }
  )

  - is_word c:Char :Boolean <-
  (c.is_letter_or_digit) || {c = '_'} || {! c.is_ascii}

  - is_ref s:String at j:Int from b:Int to e:Int :Boolean <-
  // A `@' at the start of a word, followed by a name (as in elit).
  (s.at j = '@') && {(j = b) || {s.at (j - 1) = ' '}} && {j < e} && {is_word (s.at (j + 1))}

  - is_prototype s:String at i:Int :Boolean <-
  // Starts with an upper case letter, or with ℕ, ℤ, ℚ, ℝ, ℂ.
  ((s.at i).is_upper) || {((s.at i).to_uint8 = 0E2h) && {i < s.upper} && {(s.at (i + 1)).to_uint8 = 084h}}

  - columns s:String from b:Int to e:Int :Int <-
  ( + result:Int
    b.to e do { k:Int
      ((s.at k).to_uint8 & 0C0h != 80h).if { result := result + 1; }
    }
    result
  )

  - event ev:Int :Boolean <-
  ( + e:Int
    e := ev & ~1
    (e = Hand.clic).if { focus := NULL; }
    True
  )
