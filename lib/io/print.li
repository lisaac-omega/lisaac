Header
  + name := Print
/*
  print, append_in, to_string, etc.
  */
Public
  - self:Self '#' e:E :Self <- ( crash; Self); // See OUT

  
  - extern s:C_array Char <-
  ( + i:Int
    String.tmp { b:String_buffer
      {s.at i != '\0'}.while_do { b | s.at i; i := i + 1; }
      b.print
    }
  )
  
  - print <-
  (
    String.tmp { b:String_buffer
      append_in b
      b.print
    }
  )
  
  - to_string:String_alias <-
  ( + result:String_alias
    String.tmp { b:String_buffer
      append_in b
      result := b.to_string_alias
    }
    result
  )
  
  - append_in b:String_buffer <-
  (
    to_pointer.append_in b
  )
  
  - println <-
  (
    print
    '\n'.print
  )
  
  // French corner
  
  - écrire self:Self <- ( self.print )
  
  
