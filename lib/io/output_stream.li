Header
  + name := Output_stream
Insert
  - parent_utils:Utils := Utils
  
Public
  - put_string str:String <-
  (
    str.foreach {c:Char
      put_character c
    }
  )
  
  - put_character c:Char <-
  (
    abstract
  )

  - put_integer i:Int <-
  // Output `i' to current output device.
  (
    String.tmp { tmp:String_buffer
      i.append_in tmp
      put_string tmp
    }
  )

  - put_integer_format (i, s:Int) <-
  // Output `i' to current output device using at most
  // `s' character.
  (
    not_yet_implemented
    /*
    STRING.tmp { tmp:String_buffer
      i.append_in_format (tmp,s)
      put_string tmp
    };*/
  )

  // Other features:

  - put_boolean b:Boolean <-
  // Output `b' to current output device according
  // to the Eiffel format.
  (
    put_string (b.to_string)
  )

  - put_pointer p:Pointer <-
  // Output a viewable version of `p'.
  (
    String.tmp { tmp:String_buffer
      p.append_in tmp
      put_string tmp
    }
  )

  - put_new_line <-
  // Output a newline character.
  (
    put_character '\n'
  )

  - put_spaces nb:Int <-
  // Output `nb' spaces character.
  ( ? {nb >= 0}

    nb.times {
      put_character ' '
    }
  )

  - file_exists path:String :Boolean<-
  (
    not_yet_implemented
    //DIRECTORY.scan_current_working_directory
    //DIRECTORY.has path
  )

  - flush <-
  // forces a write of unwritten character (write my have been
  // delayed, flush writes buffered characters)
  (
    abstract
  )

Private

  - basic_io_putc c:Char <- System_io.print_char c

  - basic_error_putc c:Char <- System_io.print_error_char c
