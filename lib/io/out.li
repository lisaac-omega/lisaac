Header
  + name := Exact Out
Public
  
  - reset:String_alias := "\033o\[0m"
  - red:String_alias   := "\033o\[31m"
  - green:String_alias := "\033o\[32m"
  - yellow:String_alias:= "\033o\[33m"
  - blue:String_alias  := "\033o\[34m"
  - bold:String_alias  := "\033o\[1m"
  
  - self:Self '#' e:E :Self <-
  (
    e.print
    self
  )
  
  - self:Self '|#' e:E :Self <- 
  (
    '\n'.print
    e.print
    self
  )
  
  - self:Self '#|' e:E :Self <- 
  (
    e.print
    '\n'.print
    self
  )
  
  - self:Self '##' (e:E,a:Int,c:Char) :Self <-
  ( + n:Int    
    String.tmp { tmp:String_buffer
      e.append_in tmp
      n := a - (tmp.upper + 1)
      (n > 0).if {
        tmp.insert c to 0 on n
      }
      tmp.print
    }
    self
  )
 