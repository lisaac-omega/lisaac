Header
  + name := Mutex
- type := `pthread_mutex_t`;
Inherit
  
  - parent_clone:Clone := Clone
  
Public
  
  - create:Self <-
  ( + result:Self
    result := clone
    result.make
    result    
  )
  
  - make <-
  (
    (is_cop_active).if {
      `pthread_mutex_init(@self,NULL)`
    }
  )
  
  - lock <-
  (
    (is_cop_active).if {
      `pthread_mutex_lock(@self)`
    }
  )
  
  - unlock <-
  (
    (is_cop_active).if {
      `pthread_mutex_unlock(@self)`
    }
  )
