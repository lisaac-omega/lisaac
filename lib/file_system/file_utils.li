Header
  + name := File_utils
/*Basic low-level FILE_SYSTEM calls.*/

  - include := `
#undef  __wur
#define __wur
#include <unistd.h>
`;
Inherit
  - parent_utils:Utils := Utils

Public
      
  - open_read n:String :Pointer <-
  ( + buf:C_array(Char)
    buf := n.to_external
    `fopen((char*)@buf,"rb")`:(Pointer)
  )

  - open_write n:String :Pointer <-
  ( + buf:C_array(Char)
    buf := n.to_external
    `fopen((char*)@buf,"wb")`:(Pointer)
  )
  
  - read_line f:Pointer in buf:String_buffer :Boolean <-
  ( + ptr:C_array(Char)
    + result:Pointer
    + sz:Int
    sz := buf.capacity
    ptr := buf.to_external
    result := `fgets((void *)(@ptr),@sz,(FILE*)(@f))`:(Pointer)
 //   ptr.put '\0' to sz
    buf.from_external ptr
    result != NULL
  )

  - read f:Pointer in buf:String_buffer size sz:Int :Int <-
  [
    ? {buf.capacity >= sz}
  ]
  ( + ptr:C_array(Char)
    + result:Int
    ptr := buf.storage
    result := `fread((void *)(@ptr),(size_t)(1), (size_t)(@sz),(FILE*)(@f))`:(Int)
    buf.set_upper (sz-1)
    result
  )
  
  - force_read_raw f:Pointer in ptr:C_array Uint8 size sz:Int <-
  ( (read_raw f in ptr size sz != sz).if {
      "Error: `fread()' on ".print; sz.print; "bytes.".println;
      exit (-1)
    }
  )
  
  - read_raw f:Pointer in ptr:C_array Uint8 size sz:Int :Int <-
  ( `fread((void *)(@ptr),(size_t)(1), (size_t)(@sz),(FILE*)(@f))`:(Int) )

  - read_native_char f:Pointer in ptr:C_array Char size sz:Int :Int <-
  ( `fread((void *)(@ptr),(size_t)(1), (size_t)(@sz),(FILE*)(@f))`:(Int) )

  - write f:Pointer with buf:String size sz:Int :Int <-
  [
    ? {sz <= buf.count}
  ]
  ( + ptr:C_array(Char)
    + result:Int
    ptr := buf.storage; // Warning: Not used `to_external'    
    result := `fwrite((void *)(@ptr),(size_t)(1), (size_t)(@sz),(FILE*)(@f))`:(Int)
    result
  )
  
  - write f:Pointer string str:String :Int <- write f with str size (str.count)
  
  - write f:Pointer buffer buf:C_array Uint8 size sz:Int :Int <-
  `fwrite((void *)(@buf),(size_t)(1),(size_t)(@sz),(FILE *)(@f))`:(Int)
  
  - write f:Pointer native_char buf:C_array Char size sz:Int :Int <-
  `fwrite((void *)(@buf),(size_t)(1),(size_t)(@sz),(FILE *)(@f))`:(Int)
  
  - close p:Pointer <- `fclose((FILE*)(@p))`

  - size p:Pointer :Int <-
  ( + result:Int
    `fseek((FILE*)(@p),0,SEEK_END)`
    result := `ftell((FILE *)@p)`:Int
    `fseek((FILE*)(@p),0,SEEK_SET)`
    result
  )
  
  - seek p:Pointer at i:Int <- `fseek((FILE*)(@p),@i,SEEK_SET)`

  - make_empty_file new_path:String :Boolean <-
  ( + p:C_array(Char)
    + stream:Pointer
    + result:Boolean
    p := new_path.to_external
    stream := `fopen((char*)@p,"w+b")`:Pointer
    (result := (stream != NULL)).if {
      close stream
    }
    result
  )

  - file_exists some_path:String :Boolean <-
  ( + result:Boolean
    + p:Pointer
    ((p := open_read some_path).is_not_null).if {
      result := True
      close p
    }
    result
  )

  - remove some_path:String :Int <-
  ( + p:C_array Char
    p := some_path.to_external
    `remove((char*)@p)`:(Int)
  )
  
  - create_directory some_path:String :Boolean <-
  ( + p:C_array Char
    p := some_path.to_external
    `mkdir((char*)@p,0700)`:(Int) = 0
  )
  
  - working_directory_in buffer:String_buffer <-
  Environment.pwd_in buffer
  [
    ? {buffer.last = '/'}
  ]
