Header
  + name := File_utils
/*Basic low-level FILE_SYSTEM calls.*/

  - include := `
#undef  __wur
#define __wur
#include <stdio.h>
#include <unistd.h>
#include <sys/stat.h>
#include <string.h>
#include <errno.h>
#ifdef _WIN32
#include <direct.h>
#endif
#include <dirent.h>
#include <stdlib.h>

static int li_path_kind(const char *p, int n) {
struct stat st;
#ifdef _WIN32
  char buf[4096];
  if (n < 0 || n >= (int)sizeof(buf)) return 0;
  memcpy(buf,p,n);
  buf[n] = '\0';
  while (n > 1 && (buf[n-1]=='/' || buf[n-1]=='\\') && !(n==3 && buf[1]==':'))
    buf[--n] = '\0';
  p = buf;
#else
  (void)n;
#endif
  if (stat(p,&st) != 0) {
#ifdef EOVERFLOW
    if (errno == EOVERFLOW) return 2;
#endif
    return 0;
  }
  return S_ISDIR(st.st_mode) ? 1 : 2;
}

static int li_mkdir(const char *p) {
#ifdef _WIN32
  return _mkdir(p);
#else
  return mkdir(p,0777);
#endif
}

static int li_rmdir(const char *p) {
#ifdef _WIN32
  return _rmdir(p);
#else
  return rmdir(p);
#endif
}

/* 0 on success, -1 on first failure (stops there). */
static int li_rmdir_recursive(const char *p) {
  DIR *d;
  struct dirent *e;
  struct stat st;
  size_t n = strlen(p);
  int sep = (n > 0 && (p[n-1] == '/' || p[n-1] == '\\')) ? 0 : 1;
  int result = 0;
  d = opendir(p);
  if (d == NULL) return -1;
  while (result == 0 && (e = readdir(d)) != NULL) {
    char *q;
    if (strcmp(e->d_name,".") == 0 || strcmp(e->d_name,"..") == 0) continue;
    q = malloc(n + sep + strlen(e->d_name) + 1);
    if (q == NULL) { result = -1; break; }
    memcpy(q,p,n);
    if (sep) q[n] = '/';
    strcpy(q + n + sep, e->d_name);
#ifdef _WIN32
    if (stat(q,&st) != 0) result = -1;
#else
    if (lstat(q,&st) != 0) result = -1;  /* ne suit pas les liens */
#endif
    else if (S_ISDIR(st.st_mode)) result = li_rmdir_recursive(q);
    else result = remove(q);
    free(q);
  }
  closedir(d);
  if (result == 0) result = li_rmdir(p);
  return result;
}

/* ---- Copie recursive de repertoire ---- */

/* dir + '/' + name, alloue par malloc (NULL si plus de memoire). */
static char *li_path_join(const char *dir, const char *name) {
  size_t n = strlen(dir);
  int sep = (n > 0 && (dir[n-1] == '/' || dir[n-1] == '\\')) ? 0 : 1;
  char *q = malloc(n + sep + strlen(name) + 1);
  if (q == NULL) return NULL;
  memcpy(q,dir,n);
  if (sep) q[n] = '/';
  strcpy(q + n + sep, name);
  return q;
}

static void li_chmod(const char *p, unsigned mode) {
#ifdef _WIN32
  (void)p; (void)mode;
#else
  chmod(p,(mode_t)(mode & 0777));
#endif
}

/* Cree le repertoire p, ou accepte qu'il existe deja en tant que repertoire. */
static int li_mkdir_or_dir(const char *p) {
  struct stat st;
  if (li_mkdir(p) == 0) return 0;
  if (errno == EEXIST && stat(p,&st) == 0 && S_ISDIR(st.st_mode)) return 0;
  return -1;
}

/* Copie d'un fichier regulier. 0 si OK, -1 sinon. */
static int li_cpfile(const char *src, const char *dst, unsigned mode) {
  char buf[65536];
  FILE *in, *out;
  size_t k;
  int result = 0;
  in = fopen(src,"rb");
  if (in == NULL) return -1;
  out = fopen(dst,"wb");
  if (out == NULL) { fclose(in); return -1; }
  while ((k = fread(buf,1,sizeof(buf),in)) > 0)
    if (fwrite(buf,1,k,out) != k) { result = -1; break; }
  if (ferror(in)) result = -1;
  if (fclose(out) != 0) result = -1;
  fclose(in);
  if (result == 0) li_chmod(dst,mode);
  return result;
}

#ifndef _WIN32
/* Recree le lien symbolique src en dst (le lien est copie, pas sa cible). */
static int li_cplink(const char *src, const char *dst, const struct stat *st) {
  size_t n = (st->st_size > 0) ? (size_t)st->st_size + 1 : 4096;
  char *buf = malloc(n);
  ssize_t k;
  int result = -1;
  if (buf == NULL) return -1;
  k = readlink(src,buf,n);
  if (k >= 0 && (size_t)k < n) {
    buf[k] = '\0';
    result = symlink(buf,dst);
  }
  free(buf);
  return result;
}
#endif

/* Copie le contenu de src dans dst (qui existe deja).
   root : stat de la destination racine, pour ne jamais la recopier
   dans elle-meme quand dst est situe sous src. */
static int li_cpdir_into(const char *src, const char *dst, const struct stat *root) {
  DIR *d;
  struct dirent *e;
  struct stat st;
  int result = 0;
#ifdef _WIN32
  (void)root;
#endif
  d = opendir(src);
  if (d == NULL) return -1;
  while (result == 0 && (e = readdir(d)) != NULL) {
    char *s, *t;
    if (strcmp(e->d_name,".") == 0 || strcmp(e->d_name,"..") == 0) continue;
    s = li_path_join(src,e->d_name);
    t = li_path_join(dst,e->d_name);
    if (s == NULL || t == NULL) result = -1;
#ifdef _WIN32
    else if (stat(s,&st) != 0) result = -1;
#else
    else if (lstat(s,&st) != 0) result = -1;  /* ne suit pas les liens */
    else if (st.st_dev == root->st_dev && st.st_ino == root->st_ino) {
      /* c'est la destination elle-meme : on saute */
    }
    else if (S_ISLNK(st.st_mode)) result = li_cplink(s,t,&st);
#endif
    else if (S_ISDIR(st.st_mode)) {
      result = li_mkdir_or_dir(t);
      if (result == 0) result = li_cpdir_into(s,t,root);
      if (result == 0) li_chmod(t,st.st_mode);  /* apres remplissage */
    }
    else if (S_ISREG(st.st_mode)) result = li_cpfile(s,t,st.st_mode);
    /* autres (fifo, socket, peripherique) : ignores */
    free(s);
    free(t);
  }
  closedir(d);
  return result;
}

/* Copie recursive de src vers dst (dst cree s'il n'existe pas,
   fusion sinon). 0 on success, -1 on first failure (stops there). */
static int li_cpdir(const char *src, const char *dst) {
  struct stat ss, sd;
  if (stat(src,&ss) != 0 || !S_ISDIR(ss.st_mode)) return -1;
  if (li_mkdir_or_dir(dst) != 0 || stat(dst,&sd) != 0) return -1;
#ifndef _WIN32
  if (ss.st_dev == sd.st_dev && ss.st_ino == sd.st_ino) return -1;  /* src == dst */
#endif
  if (li_cpdir_into(src,dst,&sd) != 0) return -1;
  li_chmod(dst,ss.st_mode);
  return 0;
}


`;
Inherit
  
  - parent_utils:Utils := Utils

Public
  
  // Files:  
  
  - open_read n:String :Pointer <-
  ( + buf:C_array(Char)
    
    buf := n.to_external
    `fopen((char*)@buf,"rb")`:(Pointer)
  )
  
  - open_write n:String :Pointer <-
  ( + buf:C_array(Char)
    
    buf := n.to_external
    `fopen((char*)@buf,"wb")`:(Pointer)
  )
  
  - open_write_append n:String :Pointer <-
  ( + buf:C_array(Char)
    
    buf := n.to_external
    `fopen((char*)@buf,"a")`:(Pointer)
  )
  
  - read_line f:Pointer in buf:String_buffer :Boolean <-
  ( + ptr:C_array(Char)
    + result:Pointer
    + sz:Int
    
    sz := buf.capacity
    ptr := buf.to_external
    result := `fgets((void *)(@ptr),@sz,(FILE*)(@f))`:(Pointer)
    buf.from_external ptr
    result != NULL
  )

  - read f:Pointer in buf:String_buffer size sz:Int :Int <-
  [
    ? {buf.capacity >= sz}
  ]
  ( + ptr:C_array(Char)
    + result:Int
    
    ptr := buf.storage
    result := `fread((void *)(@ptr),(size_t)(1), (size_t)(@sz),(FILE*)(@f))`:(Int)
    buf.set_upper (sz-1)
    result
  )
  
  - force_read_raw f:Pointer in ptr:C_array Uint8 size sz:Int <-
  (
    (read_raw f in ptr size sz != sz).if {
      "Error: `fread()' on ".print; sz.print; "bytes.".println;
      exit (-1)
    }
  )
  
  - read_raw f:Pointer in ptr:C_array Uint8 size sz:Int :Int <-
  ( `fread((void *)(@ptr),(size_t)(1), (size_t)(@sz),(FILE*)(@f))`:(Int) )

  - read_native_char f:Pointer in ptr:C_array Char size sz:Int :Int <-
  ( `fread((void *)(@ptr),(size_t)(1), (size_t)(@sz),(FILE*)(@f))`:(Int) )

  - write f:Pointer with buf:String size sz:Int :Int <-
  [
    ? {sz <= buf.count}
  ]
  ( + ptr:C_array(Char)
    + result:Int
    
    ptr := buf.storage; // Warning: Not used @to_external    
    result := `fwrite((void *)(@ptr),(size_t)(1), (size_t)(@sz),(FILE*)(@f))`:(Int)
    result
  )
  
  - write f:Pointer string str:String :Int <- write f with str size (str.count)
  
  - write f:Pointer buffer buf:C_array Uint8 size sz:Int :Int <-
  `fwrite((void *)(@buf),(size_t)(1),(size_t)(@sz),(FILE *)(@f))`:(Int)
  
  - write f:Pointer native_char buf:C_array Char size sz:Int :Int <-
  `fwrite((void *)(@buf),(size_t)(1),(size_t)(@sz),(FILE *)(@f))`:(Int)
  
  - close p:Pointer <- `fclose((FILE*)(@p))`
  
  - position p:Pointer :Int <- `ftell((FILE *)@p)`:Int
  
  - size p:Pointer :Int <-
  ( + result,old_p:Int
    
    old_p := position p
    `fseek((FILE*)(@p),0,SEEK_END)`
    result := position p 
    seek p at old_p    
    result
  )
  
  - rename src:String to dst:String <-
  ( + psrc,pdst:C_array Char
    
    (psrc,pdst) := (src.to_external, dst.to_external)
    `rename(@psrc,@pdst)`
  )    
  
  - flush p:Pointer <- `fflush((FILE*)(@p))`
  
  - seek p:Pointer at i:Int <- `fseek((FILE*)(@p),@i,SEEK_SET)`

  - make_empty_file new_path:String :Boolean <-
  ( + p:C_array(Char)
    + stream:Pointer
    + result:Boolean
    
    p := new_path.to_external
    stream := `fopen((char*)@p,"w+b")`:Pointer
    (result := (stream != NULL)).if {
      close stream
    }
    result
  )

  - file_exists some_path:String :Boolean <-
  (
    (li_path_kind some_path) = 2
  )

  - remove some_path:String :Int <-
  ( + p:C_array Char
    
    p := some_path.to_external
    `remove((char*)@p)`:(Int)
  )
  
  // Directory handling:
  
  - pwd_in buffer:String_buffer <- Environment.pwd_in buffer
  
  - dir_exists some_path:String :Boolean <-
  (
    (li_path_kind some_path) = 1
  )

  - mkdir some_path:String :Boolean <-
  ( + p: C_array Char
    
    p := some_path.to_external
    `li_mkdir(@p)`:(Int) = 0
  )
  
  - rmdir some_path:String :Boolean <-
  ( + p: C_array Char
    
    p := some_path.to_external
    `li_rmdir(@p)`:(Int) = 0
  )
  
  - rmdir_recursive some_path:String :Boolean <-
  ( + p: C_array Char
    
    p := some_path.to_external
    `li_rmdir_recursive(@p)`:(Int) = 0
  )  
  
  - cpdir model_path:String dest path:String :Boolean <-
  ( + s, d: C_array Char
    
    s := model_path.to_external
    d := path.to_external
    
    `li_cpdir(@s,@d)`:(Int) = 0
  )  
  
  // Other:
  
  - exists some_path:String : Boolean <-
  (
    (li_path_kind some_path) != 0
  )
  
  - add_dirsep path:String_buffer <-
  // If not alreday at the end, add the correct directory separator.
  ( + directory_separator:Char
    
    if (System.name = "windows") then {
      directory_separator := '\\'
    } else {
      directory_separator := '/'
    }
    path.extend_unless directory_separator
  )
  
Private
  
  - li_path_kind some_path:String :Int <-
  // 0: nothing, 1: directory, 2: other (regular file, device, ...) 
  ( + result, strlen:Int
    + p: C_array Char
    
    strlen := some_path.count
    p := some_path.to_external
    result := `li_path_kind(@p,@strlen)`:(Int)
    result
  )
  