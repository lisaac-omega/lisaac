Header
  + name := File
/*Abstract File Management*/
Inherit
  + parent_dirent:Flat Dirent

Private

  + stream:Pointer; // Unix file pointer (FILE *).
  
Public
  
  - is_file:Boolean <- True
  
  - is_open:Boolean <- stream != NULL

  - size:Uint32 <-
  ( + pe:C_array(Char)
    + result:Uint32
    pe := path.to_external
    `{ struct stat t; stat(@pe,&t)`
      result := `t.st_size`:Uint32
    `}`
    result
  )

  - cursor:Uint32 <-
  ( + str:Pointer
    str := stream
    `ftell((FILE *)@str)`:Uint32
  )

  - set_cursor n:Uint32 <-
  [
    /* BSBS Old; */
    -? {stream != NULL}
    -? {n <= size}
  ]
  ( + str:Pointer
    str := stream
    `fseek((FILE*)(@str),@n,SEEK_SET)`
  )

  - open:Boolean <-
  [
    -? {stream = NULL}
  ]
  ( + pa:C_array(Char)
    pa := path.to_external
    stream := `fopen((char*)@pa,"r+b")`:(Pointer)
    stream != NULL
  )

  - open_read_only:Boolean <-
  ( + pa:C_array(Char)
    pa := path.to_external
    stream := `fopen((char*)@pa,"rb")`:(Pointer)
    stream != NULL
  )

  - close <-
  [
    -? {stream != NULL}
  ]
  ( + str:Pointer

    str := stream
    `fclose((FILE*)(@str))`
    stream := NULL
  )


  - is_empty:Boolean <- size = 0
  
  - read_uinteger_8:Uint8 <-
  (
    physical_read tmp_uinteger_8 size 1
    tmp_uinteger_8.item 0
  )
  
  - read_integer_16:Int16 <-
  (
    physical_read tmp_uinteger_8 size 2
    (tmp_uinteger_8.item 1.to_int16 << 8) | tmp_uinteger_8.item 0
  )
  
  - read_uinteger_16:Uint16 <-
  (
    physical_read tmp_uinteger_8 size 2
    (tmp_uinteger_8.item 1.to_uint16 << 8) | tmp_uinteger_8.item 0
  )
  
  - read dest:Clone :Int <-
  // WARNING: It's good for Mapping objects, else serializable is necessary.
  [
    -? {is_open}
  ]
  ( + buf:C_array(Uint8)
    buf := Cast Clone To (C_array Uint8).on dest
    physical_read buf size (dest.object_size)
  )

  - read dest:Arrayed size nb_elt:Int :Int <-
  [
    -? {is_open}
  ]
  ( + buf:C_array Uint8
    + index,s:Int
    + result:Int
    + new_count:Int

    new_count := dest.count + nb_elt
    dest.set_capacity new_count
    buf := dest.to_c_array_uint8
    index := dest.count * dest.element_sizeof
    s := nb_elt * dest.element_sizeof
    result := physical_read (buf+index) size s
    dest.set_count new_count
    ? {result % dest.element_sizeof = 0}
    result / dest.element_sizeof
  )

  // Write.
  
  - write src:Clone :Int <-
  ( + buf:C_array(Uint8)
    buf := Cast Clone To (C_array Uint8).on src
    physical_write buf size (src.object_size)
  )

  - write src:Arrayed from start:Int size nb_elt:Int :Int <-
  [
    -? {is_open}
  ]
  ( + buf:C_array Uint8
    + index,s:Int
    + result:Int

    buf := src.to_c_array_uint8
    index := (start-src.lower) * src.element_sizeof
    s := nb_elt * src.element_sizeof
    result := physical_write (buf+index) size s
    ? {result % src.element_sizeof = 0}
    result / src.element_sizeof
  )

  - write src:Array Uint8 size nb_elt:Int :Int <-
  (
    write src from (src.lower) size nb_elt
  )

Private
  
  - tmp_uinteger_8:C_array(Uint8) := C_array(Uint8).create 8

  - physical_read buf:C_array(Uint8) size s:Int :Int <-
  // return size read or 0 if end of input (-1 on error => exception ?)
  ( + str:Pointer
    str := stream
    `fread((void *)(@buf),(size_t)(1), (size_t)(@s),(FILE*)(@str))`:(Int)
  )

  - physical_write buf:C_array(Uint8) size s:Int :Int <-
  // return size read or 0 if end of input (-1 on error => exception ?)
  ( + str:Pointer
    str := stream
    `fwrite((void *)(@buf),(size_t)(1), (size_t)(@s),(FILE*)(@str))`:(Int)
  )

  
  
