Header
  + name := Reference E
/*Reference on object (Flat)*/
  - export    := E,Pointer;
  - import    := E;
Inherit
  - parent_clone:Clone := Clone

Public

  + value:E

  // Creation.

  - create v:E :Self <-
  ( + result:Self
    result := clone
    result.make v
    result
  )

  - make v:E <-
  (
    value := v
  )

  // Cast.

  - to_e:E <- value

  - from_e v:E :Self <- create v
