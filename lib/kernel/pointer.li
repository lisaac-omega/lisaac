Header
  + name := Flat Pointer
/*References to objects (Pointer is mapped as C type 'void *')*/
  - type    := `void *`;
  - default := `NULL`:Pointer;
  - export  := Uint_cpu;
Insert
  - parent_unsigned_integer:Unsigned_integer := Unsigned_integer

Public

  - in_range low:Self to up:Self :Boolean <- True; // BSBS: A revoir.

  - object_size:Int <- `sizeof(void *)`:Int

  - is_null:Boolean <- (self = NULL)
  // Is the external Pointer a NULL pointer ?

  - is_not_null:Boolean <- ! is_null
  // Is the external Pointer a non-NULL pointer ?


  - to_c_array:C_array(Uint8) <- Cast Self To (C_array Uint8).on self
  // Convert `pointer' into 'native_array' type.

//  - to_uint32:Uint32 <- `(unsigned int)@self`:Uint32
  // convert `pointer' into uinteger type (adress of the pointer)

//  - from_uinteger p:Uint32 :Pointer <- CAST Uint32 TO Pointer.on p
  // create Pointer from an adress

//  - to_int:Int <- to_raw_int

  // Convertion format without test.

  - to_raw_uinteger_cpu:Uint_cpu <- Cast Self To Uint_cpu.on self

  - to_raw_int:Int           <- Cast Uint_cpu To Int.on to_raw_uinteger_cpu

  - to_raw_uinteger:Uint         <- Cast Uint_cpu To Uint.on to_raw_uinteger_cpu

  - to_raw_uint8:Uint8     <- Cast Uint_cpu To Uint8.on to_raw_uinteger_cpu

  - to_raw_uint16:Uint16   <- Cast Uint_cpu To Uint16.on to_raw_uinteger_cpu

  - to_raw_uint32:Uint32   <- Cast Uint_cpu To Uint32.on to_raw_uinteger_cpu

  - to_raw_uint64:Uint64   <- Cast Uint_cpu To Uint64.on to_raw_uinteger_cpu

  - to_raw_int8:Int8       <- Cast Uint_cpu To Int8 .on to_raw_uinteger_cpu

  - to_raw_int16:Int16     <- Cast Uint_cpu To Int16.on to_raw_uinteger_cpu

  - to_raw_int32:Int32     <- Cast Uint_cpu To Int32.on to_raw_uinteger_cpu

  - to_raw_int64:Int64     <- Cast Uint_cpu To Int64.on to_raw_uinteger_cpu
  
  - append_in b:String_buffer <-
  (
    append_in b base 16
  )
