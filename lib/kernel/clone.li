Header
  + name := Clone
Insert
  - parent_print:Print := Print
  - parent_utils:Utils := Utils
  
Public
  
  - clone_allocation_size:Uint_cpu
  
  - clone_total_size:Uint_cpu := 0
  
  - add_clone_total_size siz:Uint_cpu <- (clone_total_size := clone_total_size+siz;)
  
  - set_detect_memory_leak b:Boolean <-
  (
    "Memory leak: ".print; b.print; '\n'.print
    detect_memory_leak := b
  )

Self
  
  - cnt_clone:Int
  
  - detect_memory_leak:Boolean
  
  - clone:Self <-
  ( + result:Self
    + ptr:Pointer
    + sz:Uint_cpu
    + typ_id:Int
    (detect_memory_leak).if {            
      type_name.println
      //crash_with_message "Memory leak !";
    }
    /*
    cnt_clone := cnt_clone + 1
    (cnt_clone > 50).if {
      crash_with_message "YOP"
    }
    */
    ///*clone_stats.li*/type_name.print; '\n'.print
    sz := object_size
    (sz = 0).if {
      result := self; // BSBS: Pas genial (result devrait etre diff Self)
    } else {
      typ_id := type_id_intern
      ptr := `malloc((@sz + 3) & ~3)`:Pointer; // ANDROID
      //( + tp:Int; tp := cnt_clone
        // `printf("%ld\n",@tp)`
      //)
      //cnt_clone := cnt_clone + 1
      
      (cnt_clone > 1000).if {
        //crash_with_message "Fuite memory!\n"
      }
      
      clone_allocation_size := clone_allocation_size + sz
      
      // MHMH: enregistrement taille :
      clone_total_size := clone_total_size + sz
      /* ANDROID
      (typ_id = -1).if
      {
      ptr := MEMORY.alloc_size sz
      } else
      {
      ptr := MEMORY.alloc_type (typ_id.to_uint32) size sz
      }
      */
      result := Cast Pointer To Self.on ptr
      //MEMORY.copy to_pointer to ptr size (CAST Pointer TO Uint32.on sz)
      copy_intern_in result
      (is_cop_type).if {
        `((lith_object *)@result)->first = NULL`
        `((lith_object *)@result)->last  = NULL`
      }
    }
    result
  )
  
Self
  
  - free_allocation_memory <-
  // Static free, don't use with GC.
  ( + ptr:Pointer
    + sz:Uint_cpu
    + typ_id:Int
    
    sz := object_size
    (sz != 0).if
    {
      typ_id := type_id_intern
      //ptr := `free(@self)`
      clone_allocation_size := clone_allocation_size - sz
      ptr := to_pointer
      (typ_id = -1).if { Memory.free ptr size sz; }
      else {  Memory.free ptr type (typ_id.to_uint32); }
    }
  )
  
Public

  - twin:Self <-
  (
    abstract
    self
  )
  
Self


  - safe_equal (e1, e2:V) :Boolean <-
  [
    deprecated True msg "clone.li:l121:Still used gigi ?. DC Jan 2026" 
  ]
  (
    (e1=e2) || {(e1!=NULL) && {e1==e2}}
  )
  
