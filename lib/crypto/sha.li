Header
  + name := Sha
Inherit
  - parent_clone:Clone := Clone
  
Sha
  
  + data:Array Uint8
  + bitlen:Uint64
    
  - data32:C_array Uint32 <-
  Cast (C_array Uint8) To (C_array Uint32).on (data.storage)
  - data64:C_array Uint64 <-
  Cast (C_array Uint8) To (C_array Uint64).on (data.storage)
  
  - data_size:Int   <- Int.abstract
  
  - mybuffer:String_buffer := String_buffer.create 2048
  
  - map:String_alias := "0123456789abcdef"
  
  - prepare_digest <-
  (
    add_bitlen (data.count)
    data.add_last 80h
    (data.count <= short_data_size).if {      
      {data.count < short_data_size}.while_do {
        data.add_last 0
      }
    } else {
      {data.count < data_size}.while_do {
        data.add_last 0
      }
      transform
      data.clear
      short_data_size.times { data.add_last 0; }
    }
    ? {data.count = short_data_size}
    data.set_upper (data_size-1)
    put_bitlen
    transform
  )
  
Public
  
  - digest_size:Int <- ( abstract; 0); // in number of bytes
  
  - create:Self <-
  ( + result:Self
    result := clone
    result.reset
    result
  )
  
  - reset <- abstract
  
  - update dta:Array Uint8 <-
  ( 
    0.to (dta.upper) do { i:Int
      data.add_last (dta.item i)
      (data.count = data_size).if {
        transform
        add_bitlen data_size
        data.clear
      }
    }
  )
  
  - update_str dta:String <-
  ( 
    0.to (dta.upper) do { i:Int
      data.add_last (dta.item i); //.code)
      (data.count = data_size).if {
        transform
        add_bitlen data_size
        data.clear
      }
    }
  )
  
  
  - sum_in digest:Array Uint8 <- ( abstract; )
  
  - sum_in_string buffer:String_buffer <- ( abstract; )
  
  - sum file_path:String in buffer:String_buffer <-
  ( + file_input:Pointer
    + sz:Int
    reset
    file_input := File_utils.open_read file_path
    ? {file_input != NULL}
    sz := File_utils.size file_input
    {sz = 0}.until_do {
      + s,blksize:Int
      blksize := 512
      (sz >= blksize).if {
        s := blksize
        sz := sz - blksize
      } else {
        s := sz
        sz := 0
      }
      mybuffer.clear
      File_utils.read file_input in mybuffer size s
      update_str mybuffer
    }
    File_utils.close file_input
    sum_in_string buffer
  )
