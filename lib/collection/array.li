Header
  + name :=   Exact Array V
  /*Resizable, zero @lower bound array.
  
array.png
  
General purpose resizable arrays. The @lower bound is frozen to 0.
The @at access is likely to be more efficient, as well as loops going from @upper to @lower,
simply because @lower is 0.
Keep in mind that even if @lower is frozen to 0, it is still better to use the @lower attribute,
and not 0 directly, since you may decide in the future to use another @Collection implementation.

The @Array implementation uses only one chunk of memory: the @storage area, which is a @C_array.
One must keep in mind that this internal @storage area is always kept left-aligned.
Thus, you can expect good performance when using an @Array to model a stack behavior with
@add_last / @last / @remove_last.
Conversely, @add_first and @remove_first are likely to slow down your program if they are used too often.
If the fact that @lower is fixed to 0 does matter, also consider @Range_array.
For very large collections, prefer @Array_block.
If not yet done, have a look at our paper entitled "RIP Linked List" (B. Sonntag, D. Colnet).*/
Inherit
  
  + parent_collection: Flat Collection V
  
  - parent_arrayed:Arrayed := Arrayed  
    
Public
  
  + storage:C_array V
  
Public

  + capacity:Int
  // Internal storage capacity in number of item.
  

  // Creation:
  
  - new self:Self of (v:V^n) :Self <-
  ( + result:Self
    result := clone
    result.add_last v
    result
  )

  - new self:Self capacity c:Int :Self <-
  // New empty array with a given capacity.
  ( + result:Self
    
    result := clone
    if (c > 0) then {
      result.set_capacity c
    }
    result
  )
  [
    Result.is_empty
  ]

  - create new_count:Int :Self <-
  // Make array with range [ 0 .. @new_count - 1 ].
  // When @new_count = 0 the array @is_empty.
  ( + result:Self
  
    result := clone
    result.make new_count
    result
  )
  [
    Result.count = new_count
  ]

  
  // Query:

  // Writing:

Public
  
  // Query:
  
  - at i:Int :V <-
  // Direct access in memory block.
  
  (
    storage.at i
  )
  
  - at i:Int put v:V <- 
  (
    storage.at i put v
  )
  
  - add element:V first n:Int <-
  // addfirst.gif
  [
    deprecated True msg "array.li:l67:Use the new add_first instead. DC Jan 2026",
    n > 0 
  ]
  ( + new_capacity,new_count:Int
  
    new_count := count + n
    (capacity = 0).if {
      storage := C_array V.create new_count
      capacity := new_count
    }.elseif {new_count > capacity} then {
      new_capacity := capacity * 2
      {new_capacity >= new_count}.until_do {
        new_capacity := new_capacity * 2
      }
      storage := storage.realloc capacity with new_capacity
      capacity := new_capacity
    }
    storage.move 0 to upper forward n
    storage.set_slice_with element from lower until (n-1)
    upper := upper + n
  )

  // Adding:
  
  - add_first v:V^n <-
  ( + idx:Int
    set_capacity (count + n)    
    if (upper >= 0) then {
      storage.move 0 to upper forward n
    }
    upper := upper + n
    { e:V
      storage.at idx put e
      idx := idx + 1
    }.value v
  )
 
  - add_last v:V^n <-
  ( 
    set_capacity (count + n)
    { e:V
      upper := upper + 1
      storage.at upper put e
    }.value v
  )
     
  - element_sizeof:Int <-
  ( + result:Int
  
    (V.is_expanded_type).if {
      result := V.object_size
    } else {
      result := Pointer.object_size
    }
    result
  )
  
  // Creation and modification:
  

  - create_with_capacity new_count:Int :Self <-
  // Create an empty array with at least @needed_capacity. <- DCDC VIRER / OBSOLETE
  //[ deprecated True msg "array.li:l128:Use new__capacity, DC Feb 2026" ]
  ( + result:Self  
  
    result := clone
    result.with_capacity new_count
    result
  )
  
  - create_with_native_array_byte na:C_array Uint8 size s:Int :Self <-
  ( + result:Self
  
    result := clone
    result.make_with_native_array_byte na size s
    result
  )
  
  - create_capacity c:Int e0 e0:E :Self <-
  // New ARRAY of capacity @c, initialized with @e0.
  [
    deprecated True msg "array.li:l148:Use new__of, DC Feb 2026"
  ]
  ( + result:Self
    result := create_with_capacity c
    result.add_last e0
    result
  )
  
  - create_capacity c:Int e0 e0:E e1 e1:E :Self <-
  // New ARRAY of capacity @c, initialized with @e0 and @e1.
  [
    deprecated True msg "array.li:l159:Use new__of, DC Feb 2026"
  ]
  ( + result:Self
    result := create_with_capacity c
    result.add_last e0
    result.add_last e1
    result
  )
  
  - new_storage c:Int <-
  [
    deprecated True msg "array.li:l154:Still used ? DC Jan 2026"
  ]
  (
    (c = 0).if {
      storage := NULL
    } else {
      storage := C_array V.create c
    }
    capacity := c
    upper := -1
  )
  
  - new_copy o:Array V <-
  ( + u:Int

    u := o.upper
    upper := u
    (u = -1).if {
      storage := NULL
      ? {capacity = 0}
    } else {
      capacity := u + 1
      storage := C_array V.create capacity
      storage.copy_from (o.storage) until u
    }
  )
  
  - make_with_map_object obj:Clone <-
  // BSBS: A revoir.
  [ 
    deprecated True msg "array.li:l183:Still used ? DC Jan 2026"
    element_sizeof = 1
  ]
  (
    storage := Cast Clone To (C_array V).on obj
    capacity := obj.object_size
    upper := -1
  )
  [ 
    storage != NULL
  ]
  
  - make_with_native_array_byte na:C_array Uint8 size s:Int <-
  [ 
    s > 0,
    na != NULL
  ]
  (
    storage  := na
    capacity := s
    upper := -1
  )
  [
    storage != NULL
  ]
  
  - make new_count:Int <-
  // Make array with range [0 .. @new_count - 1].
  // When @new_count = 0 the array is empty.
  [
    new_count >= 0
  ]
  (
    ( new_count.to_int > capacity).if {
      // The new one is bigger:
      storage := C_array V.create new_count
      capacity := new_count
    }.elseif { (capacity > 0) && { upper >= 0}} then {
      // The new one is smaller and just need to be cleared:
      storage.clear 0 to upper
    }
    upper := new_count - 1
  )
  [
    count = new_count,
    capacity >= Old capacity
    //+? { (upper >= 0) ->> {all_default} }
  ]
  
  - first:V <- storage.at 0

  - second:V <- storage.at 1

  - last :V <- at upper
    
  - at i:Int add (v:V^n) <-
  ( + j:Int
    
    set_capacity (count + n)
    (i != count).if {
      storage.move i to upper forward n
    }
    upper := upper + n
    j := i
    { u:V
      storage.at j put u
      j := j + 1
    } value v
  )
  
  - pop:V <-
  ( + result:V
    result := last
    remove_last
    result
  )
  
  - pop_first:V <-
  ( + result:V
    result := first
    remove_first
    result
  )
  
  - remove_last <-
  (
    upper := upper - 1
  )

  - remove_tail n:Int <-
  (
    upper := upper - n
  )
  
  - remove_all u:V <-
  ( + i,j:Int
    + v:V

    {(i <= upper) && {at i != u}}.while_do {
      i := i + 1
    }
    j := i; i := i + 1
    {i <= upper}.while_do {
      v := at i
      (v != u).if {
        at j put v
        j := j + 1
      }
      i := i + 1
    }
    upper := j-1
  )

  - replace_all old_value:V with new_value:V <-
  (
    storage.replace_all old_value with new_value until (count - 1)
  )

  - fast_replace_all old_value:V with new_value:V <-
  (
    storage.fast_replace_all old_value 
    with new_value until (count - 1)
  )

  - reverse <-
  ( + i,j:Int

    i := lower
    j := upper
    {i >= j}.until_do {
      swap i with j
      i := i + 1
      j := j - 1
    }
  )
  
  - set_count new_count:Int <-
  (
    upper := new_count + lower - 1
  )

  - to_c_array_uint8:C_array Uint8 <-
  (
    Cast (C_array V) To (C_array Uint8).on storage
  )

  - add_last_buffer buf:Array Uint8 from beg:Int to end:Int <-
  ( + tab:C_array Uint8
    + pos_beg,size,new_capacity:Int

    pos_beg := count * element_sizeof; // + ofs_buf
    size    := end - beg + 1

    new_capacity := (pos_beg + end - beg + element_sizeof) / element_sizeof
    (capacity < new_capacity).if {
      "cap:".print
      capacity.print
      "new:".print
      new_capacity.print
      "Crash !\n".print
      crash
    }

    tab := Cast (C_array V) To (C_array Uint8).on storage
    tab.copy (buf.storage + beg) to pos_beg until size
    //ofs_buf := (pos_beg + size) % element_sizeof
    upper   := (pos_beg + size - 1) / element_sizeof
  )

  - get_buffer_from_byte i:Int size_bytes s:Int :Array Uint8 <-
  [
    deprecated True msg "array.li:l353:Still used ? DC Jan 2026"
  ]
  ( + tab:C_array Uint8
    tab := Cast (C_array V) To (C_array Uint8).on storage
    Array Uint8.create_with_native_array_byte (tab + i) size s
  )
  
  // Interfacing with C:

  - to_external:Pointer <-
  // Gives C access into the internal @storage of the ARRAY.
  // Result is pointing the element at index @lower.
  // NOTE: do not free/realloc the Result. Resizing of the array
  //       can makes this pointer invalid.
  [
    ! is_empty
  ]
  (
    storage.to_pointer
  )
  [
    Result.is_not_null
  ]

  - to_c_array:C_array V <-
  // Gives C access into the internal @storage of the ARRAY.
  // Result is pointing the element at index @lower.
  // NOTE: do not free/realloc the Result. Resizing of the array
  //       can makes this pointer invalid.
  [
    ! is_empty
  ]
  (
    storage
  )
  [
    Result.is_not_null
  ]

Public
  
  - search cmp:{V; Boolean} :V <-
  ( + i:Int
    + result:V
    i := lower
    {(i <= upper) && {! cmp.value (at i)}}.while_do { 
      i := i + 1
    }
    (i <= upper).if {
      result := at i
    }
    result
  )
      
  - with_capacity needed_capacity:Int <-
  // Create an empty array with at least @needed_capacity.
  [ // deprecated True msg "array.li:l430:Use set_capacity DC Feb 2026",
    needed_capacity >= 0
  ]
  (
    (capacity < needed_capacity).if {
      storage := C_array V.create needed_capacity
      capacity := needed_capacity
      //}.elseif { capacity > needed_capacity } then {
      //  storage.clear 0 to upper; // BSBS: Ca serre a quoi de le vider !
    }
    upper := -1
  )
  [
    capacity >= needed_capacity, 
    is_empty
  ]
  
  // Hashable.
  
  - create_copy other:Array V :Array V <-
  // Make array with range [0 .. @new_count - 1].
  // When @new_count = 0 the array is empty.
  ( + result:Array V
    result := clone
    result.make_copy other
    result
  )
  
  - twin:Self <-
  ( + result:Self
    result ?= Array V.create_copy self
    result
  )
  
  - make_copy other:Array V <-
  (
    capacity := other.count
    (capacity = 0).if { storage := NULL; } else {
      storage := C_array V.create capacity
    }
    upper := capacity - 1
    0.to upper do { i:Int
      storage.at i put (other.at i)
    }
  )
  
  - hash_code:Int <-
  ( + result:Int
    + i,n:Int
    + elt:V
    
    {(i <= upper) && {n < 4}}.while_do {
      ((elt := at i) != NULL).if {
        result := result + elt.hash_code
        n := n + 1
      }
      i := i + 1
    }
    result
  )
  
  // Modification:
  
  - prepare_space n:Int <-
  // Makes sure that we have at least @n places, ready to use, after @upper.
  [
    deprecated True msg "array.li:l492:Still used ? DC Jan 2026"
    n > 0
  ]
  (
    (upper - (capacity - 1) < n).if {
      set_capacity (2 * capacity)
    }
  )
  [
    upper = Old upper
  ]
  
  - fast_resize new_count:Int <-
  [
    new_count <= capacity
  ]
  (
    upper := new_count - 1
  )
  
  - resize new_count:Int <-
  // Resize the array. When @new_count is greater than @count, new positions are 
  // initialized with appropriate default values.
  [
    new_count >= 0
  ]
  ( + new_capacity:Int
    // DCDC apparemment, c'est encore utilisé, alors il faudrait toujours 
    // mettre une puissance de 2 pour capacity ?  (DC le 26 janvier 2026)
    if ( new_count > count ) then {
      (capacity = 0).if {
        storage := C_array V.create new_count
        capacity := new_count
      }.elseif { capacity < new_count } then {
        new_capacity := capacity * 2
        { new_capacity >= new_count }.until_do {
          new_capacity := new_capacity * 2
        }
        storage := storage.realloc capacity with new_capacity
        capacity := new_capacity
      }
      storage.clear count to (new_count - 1)
    }
    upper := new_count - 1
  )
  [
    count = new_count,
    capacity >= Old capacity
  ]
  
  // Implementation of abstract:
  
  - is_empty:Boolean <- ( upper < 0 )
    
  - put_last element:V <-
  (
    storage.at upper put element
  )  
  
  - clear <-
  (
    upper := -1
  )
  [ 
    capacity = Old capacity
  ]
  
  - copy other:Self <-
  // Copy @other onto self.
  ( + other_upper, new_capacity:Int
    
    other_upper := other.upper
    (other_upper >= 0).if {
      new_capacity := other_upper + 1
      (capacity < new_capacity).if {
        storage := C_array V.create new_capacity // BSBS Mettre colloc_intern !
        capacity := new_capacity
      }
      storage.copy_from (other.storage) until other_upper
    }
    upper := other_upper
  )
  
  - prepend o:Array V <-
  ( + n:Int
    (o.upper >= 0).if {
      n := o.count
      set_capacity (count + n)
      storage.move 0 to upper forward n
      storage.copy_inc (o.storage) to 0 until (n-1)
      upper := upper + n
    }
  )
  
  - set_all_with v:V <-
  (
    storage.set_all_with v until upper
  )
  
  - move_to_last low:Int to up:Int <-
  // A-BCD-EF move_to_last 1 to 3 => A-EF-BCD  
  [ 
    {low.in_range 0 to up},
    up <= upper
  ]
  ( + d:Int
    (up != upper).if {
      d := up - low + 1
      set_capacity (count+d)
      storage.move low to up forward (upper-low+1)
      storage.move (up+1) to (upper+d) backward (-d)
    }
  )
  
  // MHMH : reference_at :
  
  - reference_at e:V with cmp:{(V,V); Boolean} :V <-
  // Searches the first item such that cmp(e, at) is true.
  // Returns NULL if no one match.
  ( + return:V
    + i:Int
    i := lower
    
    { (i <= upper) && { ! cmp.value(e, (at i)) } }.while_do { i := i + 1; }
    
    (i <= upper).if { return := at i; }
    
    return
  )
  
  
  // Other.
  
  - from_collection model:Collection V <-
  ( + i1:Int
    
    with_capacity model.count
    upper := model.count - 1
    i1 := 0
    (model.lower).to (model.upper) do { i2:Int
      storage.at i1 put (model.at i2)
      i1 := i1 + 1
    }
  )
  
  - self:Self '=='  Right 60 other:E :Boolean <-
  ( + result:Boolean
    + same:Self
    ( self = other).if {
      result := True
    } else {
      same ?= other
      ((same != NULL) && { upper = same.upper }).if {
        result := storage.fast_memcmp (same.storage) until upper
      }
    }
    result
  )
  
  - all_default:Boolean <-
  [
    storage != NULL
  ]
  (
    storage.all_default upper
  )
  
  - occurrences element:V :Int <-
  (
    storage.occurrences element until upper
  )
  
  - fast_occurrences element:V :Int <-
  (
    storage.fast_occurrences element until upper
  )
  
  - first_index_of element:V :Int <-
  ( + result:Int
    
    (upper >= 0).if {
      result := storage.first_index_of element until upper
    }
    result
  )
  
  - index_of element:V start start_index:Int :Int <-
  ( + result:Int
    
    (upper >= 0).if {
      result := storage.index_of (element,start_index) until upper
    }
    result
  )
  
  - reverse_index_of element:V start start_index:Int :Int <-
  (
    storage.reverse_index_of (element, start_index)
  )
  
  - fast_index_of e:V :Int <- fast_first_index_of e
  
  - fast_first_index_of element:V :Int <-
  // BSBS: A virer (see fast_index_of)
  ( + result:Int
    
    (upper >= 0).if {
      result := storage.fast_first_index_of element until upper
    }
    result
  )
  
  - fast_index_of element:V start start_index:Int :Int <-
  ( + result:Int
    
    (upper >= 0).if {
      result := storage.fast_index_of (element,start_index) until upper
    }
    result
  )
  
  - fast_reverse_index_of element:V :Int <-
  ( + result:Int
    (upper >= lower).if {
      result := storage.fast_reverse_index_of element from upper
    } else {
      result := -1
    }
    result
  )
  
  - fast_reverse_index_of element:V start start_index:Int :Int <-
  (
    storage.fast_reverse_index_of element from start_index
  )
  
  - subarray min:Int to max:Int :Self <-  
  // slice
  ( + result:Self
    
    result := Self.create (max - min + 1)
    result.storage.slice_copy storage to 0 from min to max
    
    result
  )
  
  - force element:V to index:Int <-
  (
    ( index <= upper ).if {
      storage.at index put element
    }.elseif { index = (upper + 1) } then {
      add_last element
    } else {
      resize (index + 1)
      storage.at index put element
    }
  )
  
  - remove_first <-
  ( + void_storage:C_array V
    
    ( upper = 0).if {
      storage := void_storage
      capacity := 0
      upper := -1
    } else {
      storage.remove_first upper
      upper := upper - 1
    }
  )
  [
    lower = Old lower
  ]
  
  - remove_head n:Int <-
  (
    (upper >= n).if {
      storage.move n to upper backward (-n)
    }
    upper := upper - n
  )
  
  - remove_ben (idx:Int^n) <-
  // BSBS -> DCDC : Pour remplacer remove (Tu peux tester en -boost, il est aussi efficace en cas de n=1)
  // Il y a juste l'obligation que les index doivent être dans l'ordre croissant.
  [ + b:Int
    b := -1
    { i:Int
      ? {i > b}          // Order test
      ? {valid_index i}  // Valid index
      b := i
    }.value idx;
  ]
  ( + b,c:Int    
    { e:Int
      (c != 0).if {
        storage.move b to (e-1) backward c
      }
      b := e + 1
      c := c - 1
    }.value idx
    storage.move b to upper backward c
    upper := upper + c
  )
  
  - remove index:Int <-
  (
    storage.remove index until upper
    upper := upper - 1
  )
  
  - remove beg:Int to end:Int <-
  [
    {valid_index beg},
    {valid_index end},
    beg <= end
  ]
  ( + s:Int
    
    (beg = end).if {
      remove beg
    } else {
      s := end - beg + 1
      (end < upper).if {
        move (end+1) to upper by (-s)
      }
      upper := upper - s
    }
  )
 
  - remove_value v:V <- remove (fast_index_of v)
  
  - remove_value_force v:V <-
  ( + i:Int
    i := fast_index_of v
    (i <= upper).if { remove i; }
  )
  
  - rotation_left <-
  ( + f:V
    f := first
    storage.remove_first upper
    storage.at upper put f
  )
  
  - rotation_right <-
  ( + l:V
    l := last
    storage.move 0 to (upper - 1) forward 1
    storage.at 0 put l
  )
  
  - rotation d:Int <-
  [ d != 0 ]
  ( 
    set_capacity (count+d)
    (d > 0).if {
      storage.move 0 to upper forward d
      storage.move count to (count+d-1) backward (-count)
    } else {
      storage.move 0 to (-d-1) forward count
      storage.move (-d) to (count-d-1) backward d
    }
  )
  
  - intersection o:Array V <-
  (
    upper.downto 0 do { i:Int
      (! o.fast_has (at i)).if {
        remove i
      }
    }
  )
  
  - median:V <-
  // Warning: Change order value
  ( + result:V
    result := qselect 0 to upper pivot (count / 2)
    (count.is_even).if {
      result := result ~ qselect 0 to upper pivot (count / 2 - 1)
    }
    result
  )
  
  - mean:V <-
  // WARNING: mean invalid if V:Uint8
  ( + sum:V    
    foreach { v:V; sum := sum + v }
    sum / count
  )
    
  - min_max_mean:(V,V,V) <-
  // WARNING: mean invalid if V:Uint8
  ( + min,max,mean,sum,v:V
    min := max := sum := first
    1.to upper do { i:Int
      v := at i
      sum := sum + v
      (v > max).if { max := v; }
      (v < min).if { min := v; }
    }
    mean := sum / count
    min,max,mean  
  )
  
  - median_index:Int <-
  ( + sum,cum:V    
    + j:Int
    0.to upper do { i:Int;
      sum := sum + at i;
    }
    sum := sum / 2
    {(j < upper) && {cum < sum}}.while_do { cum := cum + at j; j := j + 1; }
    j
  )
    
  - median_index_normalized:Int <-
  ( + min,v:V
    + sum,cum:V
    + j:Int
    min := first
    1.to upper do { i:Int
      v := at i      
      (v < min).if { min := v; }
    }    
    0.to upper do { i:Int; sum := sum + at i - min }
    (sum = 0).if {
      j := count / 2
    } else {
      sum := sum / 2
      {(j < upper) && {cum < sum}}.while_do {
        cum := cum + at j - min;
        j := j + 1;
      }
    }
    j
  )
    
Private
  
  - partition l:Int to r:Int pivot piv:Int :Int <-
  ( + val:V
    + res:Int
    val := at piv
    swap piv with r;  // Move pivot to end
    res := l
    l.to (r-1) do { i:Int
      (at i < val).if {
        swap i with res
        res := res + 1
      }
    }
    swap res with r;  // Move pivot to its final place
    res
  )

  - qselect l:Int to r:Int pivot k:Int :V <-
  ( + result:V
    + piv:Int
    (l = r).if {
      result := at l;  // Only one element
    } else {    
      // Select a new pivot index between left and right
      piv := (l + r) / 2
      piv := partition l to r pivot piv
      // The pivot is in its final sorted position
      (k = piv).if {
        result := at k
      }.elseif {k < piv} then {
        result := qselect l to (piv - 1) pivot k
      } else {
        result := qselect (piv + 1) to r pivot k
      }
    }
    result
  )
  
Public
  
  // Guru Section.
  
  - set_storage s:C_array V cap c:Int up u:Int <-
  ( (storage,capacity,upper) := (s,c,u); )
  
  - set_upper new_upper:Int <-
  [
    {new_upper.in_range (-1) to (capacity - 1)}
  ]
  (
    upper := new_upper
  )
  
  - swap_with_last idx:Int <-
  // DCDC: avec mot clef ça sera super
  (
    swap idx with upper
  )
  
  - insert_with_last idx:Int <-
  // BSBS: avec mot clef ça sera super !!!! Yes Dom ;)
  ( + elt:V
    (idx != upper).if {
      elt := last
      (upper-1).downto idx do { i:Int
        at (i+1) put (at i)
      }
      at idx put elt
    }
  )
  
  // Other and Less Common

  - new self:Self empty :Self <-
  ( + result:Self

    result := clone
    result.set_upper (-1)
    result
  )
  [
    Result.capacity = 0,
    Result.upper = (-1)
  ]
