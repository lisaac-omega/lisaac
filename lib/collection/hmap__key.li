Header
  + name := HMAP V KEY K;
  /*
  Associative memory. Values of type `V` are stored using keys of type `K`.
  Assumes that keys of type `K` provide an efficient `hash_code` method.
  Also assumes that keys are aliased, allowing all comparisons to be performed
  using the efficient `=` comparison operator.
  */
Insert
  - parent_clone:CLONE := CLONE
Private

  + buckets:NATIVE_ARRAY(HMAP_NODE V KEY K)
  // The `buckets' storage area is the primary hash table of `capacity'
  // elements. To search some key, the first access is done in `buckets'
  // using the remainder of the division of the key `hash_code' by
  // `capacity'. In order to try to avoid clashes, `capacity' is always a
  // prime number (selected using HASH_TABLE_SIZE).

Public

  + capacity:INTEGER
  // Of the `buckets' storage area.

  + count:INTEGER
  // Actual `count' of stored elements.
  

  // Creation:
  - new Self:SELF :SELF <- new Self capacity minimum_capacity
  
  - new Self:SELF capacity c:INTEGER :SELF <-
  ( + result:SELF
    result := clone
    result.with_capacity c
    result
  )
  
Private
  
  - minimum_capacity:INTEGER := 193
  // Default size for the 'buckets' storage area in number of items (prime number).

  - with_capacity medium_size:INTEGER <-
  // May be used to save some execution time if one is sure that
  // storage size will rapidly become really bigger than `Default_size'.
  // When first `remove' occurs, storage size may naturally become
  // smaller than `medium_size'. Afterall, tuning of storage size is
  // done automatically according to usage.
  [
    -? { medium_size > 0 }
  ]
  ( + new_capacity:INTEGER
    new_capacity := HASH_TABLE_SIZE.prime_number_ceiling medium_size
    buckets := NATIVE_ARRAY(HMAP_NODE V KEY K).create new_capacity
    capacity := new_capacity
    count := 0
  )
  [
    ? { is_empty }
    ? { capacity >= medium_size }
  ]
  
Public
  
  // Basic access:
  
  - is_empty:BOOLEAN <- count = 0
  // Is it empty?
  
  - has k:K :BOOLEAN <-
  // Is there a value currently associated with key `k'?
  ( + idx:INTEGER
    + node:HMAP_NODE V KEY K
    idx := k.hash_code % capacity
    node := buckets.at idx
    until {(node = NULL) || {node.key = k}} do {
      node := node.next
    }
    node != NULL
  )
  
  - reference_at k:K :V <-
  // Return NULL or the value associated with key `k'. Actually, this
  // feature is useful when the type of values (the type E) is a
  // reference type, to avoid using `has' just followed by `at' to get
  // the corresponding value.
  ( + idx:INTEGER
    + node:HMAP_NODE V KEY K
    + result:V

    idx := k.hash_code % capacity
    node := buckets.at idx
    {(node = NULL) ||{node.key == k}}.until_do {
      node := node.next
    }
    (node != NULL).if {
      result := node.value
    }
    result
  )

  - fast_at k:K :V <-
  ( + idx:INTEGER
    + node:HMAP_NODE V KEY K
    idx := k.hash_code % capacity
    node := buckets.at idx
    {node.key = k}.until_do {
      node := node.next
    }
    node.value
  )

  - fast_reference_at k:K :V <-
  // 
  // DCDC remplacer avec search
  //  
  // Return NULL or the value associated with key `k'. Actually, this
  // feature is useful when the type of values (the type V) is a
  // reference type, to avoid using `has' just followed by `at' to get
  // the corresponding value.
  ( + idx:INTEGER
    + node:HMAP_NODE V KEY K
    + result:V

    idx := k.hash_code % capacity
    node := buckets.at idx
    {(node = NULL) || {node.key = k}}.until_do {
      node := node.next
    }
    ( node != NULL ).if {
      result := node.value
    }
    result
  )

Public
  
  // Modification:
  
  
  - at k:K put v:V  <- 
  // Change some existing entry or `add' the new one. If there is as yet no key `k' in the map, enter
  // it with item `v'. Otherwise overwrite the item associated with key `k'.
  ( + h, idx:INTEGER
    + node:HMAP_NODE V KEY K
    h := k.hash_code
    idx := h % capacity
    node := buckets.at idx
    until {(node = NULL) || {node.key = k}} do {
      node := node.next
    }
    (node = NULL).if {
      (capacity = count).if {
        increase_capacity
        idx := h % capacity
      }
      node := new_node v key k next (buckets.at idx)
      buckets.put node to idx
      count := count + 1
    } else {
      node.set_value v
    }
  )

  
  - search k:K : (BOOLEAN,V) <-
  ( + found:BOOLEAN 
    + v:V
    + idx:INTEGER
    + node:HMAP_NODE V KEY K
    idx := k.hash_code % capacity
    node := buckets.at idx
    until {(node = NULL) || {node.key = k}} do {
      node := node.next
    }
    if (found := node != NULL) then {
      v := node.value
    }
    (found, v)
  )
  
  - search_key blk: {K; BOOLEAN} : (BOOLEAN,V) <-
  // Sequential searching. May be slow.
  ( + found:BOOLEAN 
    + v:V
    + idx, c:INTEGER
    + node:HMAP_NODE V KEY K
    until {found || {c >= count}} do {
      if ((node := buckets.at idx) != NULL) then {
        c := c + 1
        if (found := (blk.value(node.key))) then {
          v := node.value
        } else {
          until {found || {node.next = NULL}} do {
            c := c + 1
            if (found := blk.value(node.key)) then {
              v := node.value
            }
          }
        }
      }
      idx := idx + 1;
    }
    (found, v)
  )
  
  - search_value blk: {V; BOOLEAN} : (BOOLEAN,K) <-
  // Sequential searching. May be slow.
  ( + found:BOOLEAN 
    + k:K
    + idx, c:INTEGER
    + node:HMAP_NODE V KEY K
    until {found || {c >= count}} do {
      if ((node := buckets.at idx) != NULL) then {
        c := c + 1
        if (found := (blk.value(node.value))) then {
          k := node.key
        } else {
          until {found || {node.next = NULL}} do {
            c := c + 1
            if (found := blk.value(node.value)) then {
              k := node.key
            }
          }
        }
      }
      idx := idx + 1;
    }
    (found, k)
  )
  
  - search_key bk: {K; BOOLEAN} value bv: {V; BOOLEAN}  : (BOOLEAN,K,V) <-
  // Sequential searching. May be slow.
  ( + found:BOOLEAN 
    + k:K
    + v:V
    + idx, c:INTEGER
    + node:HMAP_NODE V KEY K
    until {found || {c >= count}} do {
      if ((node := buckets.at idx) != NULL) then {
        c := c + 1
        if (found := ((bk.value(node.key)) && {bv.value(node.value)})) then {
          k := node.key ; v := node.value
        } else {
          until {found || {node.next = NULL}} do {
            c := c + 1
            if (found := ((bk.value(node.key)) && {bv.value(node.value)})) then {
              k := node.key ; v := node.value
            }
          }
        }
      }
      idx := idx + 1;
    }
    (found, k, v)
  )
  
  - at k:K add v:V <-
  // Assumes `k' is a new entry. Actually, this is equivalent to 
  // call `at__put', but may run a little bit faster.
  [ ? {! has k} ]
  ( + idx:INTEGER
    + node:HMAP_NODE V KEY K
    if (capacity = count ) then {
      increase_capacity
    }
    idx := k.hash_code % capacity
    node := new_node v key k next (buckets.at idx)
    buckets.at idx put node
    count := count + 1
  )

  // Removing:

  - remove k:K <-
  // Remove entry `k' (which may exist or not before this call).
  ( + h, idx:INTEGER
    + node, previous_node:HMAP_NODE V KEY K
    h := k.hash_code
    idx := h % capacity
    node := buckets.at idx
    (node != NULL ).if {
      (node.key == k ).if {
        count := count - 1
        node := node.next
        buckets.at idx put node
      } else {
        previous_node := node
        node := node.next
        {(node = NULL) || {node.key == k}}.until_do {
          previous_node := node
          node := node.next
          }
          (node != NULL ).if {
            count := count - 1
            previous_node.set_next (node.next)
          }
      }
    }
  )

  - clear <-
  // Discard all items.
  (
    count := 0
    buckets.set_all_with NULL until (capacity - 1)
  )
  [
    ? {capacity = Old capacity}
  ]

  // To provide iterating facilities:
  
  - foreach blk:{(K,V);} <-
  ( + idx:INTEGER
    + node:HMAP_NODE V KEY K
    while {idx < capacity} do {
      node := buckets.at idx
      while {node != NULL} do {
        blk.value (node.key,node.value)
        node := node.next        
      }
      idx := idx + 1
    }
  )
  
  - foreach_key blk:{K;} <- foreach {(k:K,v:V); blk.value k }  
  
  - foreach_value blk:{V;} <- foreach {(k:K,v:V); blk.value v }
  
  - at k:K :V <-
  // Very fast in -boost mode.
  [ ? {has k} ]
  ( + idx:INTEGER
    + node:HMAP_NODE V KEY K
    idx := k.hash_code % capacity
    node := buckets.at idx
    until {node.key = k} do {
      node := node.next
    }
    node.value
  )

  - copy other:SELF <-
  // Reinitialize by copying all associations of `other'.
  (
    clear
    (capacity < other.count).if {
      with_capacity (other.count + 1)
    }.elseif {capacity = 0} then {
      make
    }
    1.to (other.count) do { i:INTEGER
      at (other.key i) add (other.item i)
    }
  )

Private

  - increase_capacity <-
  // There is no more free slots:the dictionary must grow.
  [ capacity = count ]
  ( + idx, new_capacity,i:INTEGER
    + old_buckets:NATIVE_ARRAY(HMAP_NODE V KEY K)
    + node1, node2:HMAP_NODE V KEY K

    old_buckets  := buckets
    new_capacity := HASH_TABLE_SIZE.prime_number_ceiling (capacity + 1)

    buckets := NATIVE_ARRAY(HMAP_NODE V KEY K).create new_capacity
    i := capacity -1
    capacity := new_capacity
    until {i < 0} do {
      node1 := old_buckets.at i
      {node1 = NULL}.until_do {
        node2 := node1.next
        idx := node1.key.hash_code % capacity
        node1.set_next (buckets.at idx)
        buckets.at idx put node1
        node1 := node2
      }
      i := i - 1
    }
  )
  [
    ? { count = Old count }
    ? { capacity > Old capacity }
  ]

  - dispose_node node:HMAP_NODE V KEY K :HMAP_NODE V KEY K <-
  // Add `node' in the `free_nodes' list.
  [
    -? {node != NULL}
  ]
  ( + result:HMAP_NODE V KEY K
    result := node.next
    //node.set_next (free_nodes.item)
    //free_nodes.set_value(node)
    result
  )
  [
    +? {Result = Old node.next}
  ]

  - new_node v:V key k:K next nxt:HMAP_NODE V KEY K :HMAP_NODE V KEY K <- 
  (
    new HMAP_NODE V KEY K value v key k next nxt
  )

Public

  // RESTE A VIRER

  - add v:V to k:K <- at k put v
  
  - create :SELF <- new SELF
  
  - virer_fast_has k:K :BOOLEAN <- has k
  
  - fast_put v:V to k:K <- at k put v
  

  