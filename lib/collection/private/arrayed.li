Header
  + name    := Arrayed;
  /* To share some stuff... should be removed... DCDC*/
Public

  - count:Int <- abstract

  - element_sizeof:Int <-
  // The size in number of bytes for type @E.
  (
    abstract
    0
  )

  - set_capacity new_capacity:Int <-
  // If necessary, make @capacity growing to the nearest greater power of two of @new_capacity.
  // The @count remains unchanged.
  // 
  [
    new_capacity > 0
  ]
  ( + new_cap:Int
    
    if (new_capacity > capacity) then {
      new_cap := 1 << Asm_builtin.size_in_base_2 new_capacity
      ? {(capacity = 0) ->> {storage = NULL}}      
      storage := storage.realloc_intern new_cap
      capacity := new_cap
    }
  )
  [
    capacity >= Old capacity
  ]


  - set_count new_count:Int <-
  (
    abstract
  )

  - to_c_array_uint8:C_array Uint8 <-
  (
    abstract
    NULL
  )
