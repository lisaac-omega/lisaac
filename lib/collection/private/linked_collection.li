Header
  + name := Linked_collection V
/*
  Common root of LINKED_LIST and SINGLE_LIST.
  */
Inherit
  + parent_collection: Flat Collection V
Public
  - is_empty:Boolean <- ( first_link = NULL )
  
  // Creation:
  
  - new self:Self of v: V^n :Self <-
  ( + result:Self
    result := clone  
    { vi:V
      result.add_last vi
    }.value v    
    result
  )
  
Public  
  - new:Self <-
  // Make an empty list
  ( + result:Self
    result := clone
    result.make
    result
  )
  [
    ? {Result.count = 0}
  ]
  
Private
  - make <-
  (
    upper := -1
  )
Public  
  - remove_head n:Int <-
  ( + i:Int
    i := n
    {i = 0}.until_do {
      remove_first
      i := i - 1
    }
  )

  - remove_tail n:Int <-
  ( + i:Int

    i := n
    {i = 0}.until_do {
      remove_last
      i := i - 1
    }
  )

  - first_index_of element:V :Int <-
  (
    index_of element start lower
  )

  - fast_first_index_of element:V :Int <-
  (
    fast_index_of element start lower
  )

  // Implement manifest generic creation.

  - manifest_make needed_capacity:Int <-
  // Manifest creation of a list of items of type E.
  (
    create
  )

  - manifest_put index:Int to element:V <-
  (
    add_last element
  )
  
Public
  - twin:Self <-
  ( + result:Self
    result := Self.new
    0.to upper do { i:Int
      result.add_last (at i)
    }
    result
  )