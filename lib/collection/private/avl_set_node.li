Header
  + name := Avl_set_node V
/*
   Auxiliary class to implement AVL_SET.
   This a classic implementation of an AVL tree (balanced tree first
   designed by Adelson-Velskii and Landis, 1960)
  */
Inherit
  + parent_avl_tree_node:Flat Avl_tree_node V

Avl_set

  // Creation:

  - create i:V :Self <-
  ( + result:Self

    result := clone
    result.make i
    result
  )

  - make i:V <-
  (
    set_balance balanced
    left  := NULL
    right := NULL
    set_item i
  )
  [
    +? {item = i}
  ]



