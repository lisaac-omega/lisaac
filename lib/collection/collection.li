Header
  + name := Collection V
  /*
Common abstract definition of a sequenceable collection of objects.
Such a collection is traversable using a simple Int index from @lower to @upper using @at.
All collections are resizable thanks to @add_last / @remove_last, @add_first / @remove_first,
as well as @add / @remove.

This abstraction provides features to view a @Collection as a stack (for example by using
@add_last, @last, and @remove_last).
One can also use a @Collection as a queue (for example by using @add_last, @first, and
@remove_first).

The Lisaac Ω library provides five implementations of @Collection: @Array, @Array_ring,
@Array_block, @Range_array, @Linked_list, and @Single_list.
Except for creation, all implementations have exactly the same behavior.
Switching from one implementation to another only changes the memory usage and execution time.
We suggest that you read the paper entitled "RIP Linked List" (B. Sonntag and D. Colnet)
to choose the best implementation of @Collection for your needs.*/
Insert

  - parent_clone:Clone := Clone

Public
  
  // Creation:
  
  - new self:Self of v: V^n :Self <-
  // Creates and initialize with a set of items.
  (
    abstract
    self
  )
  [
    Result.count = n
  ]
  
Public
  
  // Query:
  
  - lower:Int <- 0
  // Minimum index.
  
  + upper:Int := -1
  // Maximum index.
    
  - valid_index i:Int :Boolean <-
  // True when @i is valid (i.e., inside actual bounds).
  (
    (lower <= i) && {i <= upper}
  )
  
  - count:Int <-
  // Number of available items.
  (
    upper - lower + 1
  )
  [
    Result = upper - lower + 1
  ]

  - is_empty:Boolean <-
  // Is it empty ?
  (
    count = 0
  )
  [
    Result = (count = 0)
  ]
  
  - at i:Int :V <-
  // Access item at index @i.
  [
    valid_index i
  ]
  (
    abstract
    V
  )
  
  - first:V <-
  // Access to the @first item.
  [
    ! is_empty
  ]
  (
    at lower
  )
  [
    Result = at lower
  ]
  
  - second:V <-
  // Access to the @first item.
  [
    count > 1
  ]
  (
    at (lower+1)
  )
  [
    Result = at (lower+1)
  ]
  
  - last:V <-
  // Access to the @last item.
  [
    ! is_empty
  ]
  (
    at upper
  )
  [
    Result = at upper
  ]

  - second_last:V <- at (upper-1)  
  
  // Writing:

  - at i:Int put v:V <-
  // Make @v the value @at index @i.
  [
    valid_index i
  ]
  (
    abstract
  )
  [
    at i = v,
    count = Old count
  ]
  
  - swap i1:Int with i2:Int <-
  // Swap at at index @i1 with item at index @i2.
  [
    valid_index i1,
    valid_index i2
  ]
  ( + tmp:V

    tmp := at i1
    at i1 put (at i2)
    at i2 put tmp
  )
  [
    at i1 = Old at i2,
    at i2 = Old at i1,
    count = Old count
  ]

  - set_all_with v:V <-
  // Set all items with value @v.
  (
    lower.to upper do { i:Int
      at i put v
    }
  )
  [
    count = Old count
  ]

  - set_slice lower_index:Int to upper_index:Int with v:V <-
  // Set all items in range [@lower_index .. @upper_index] with @v.
  [
    lower_index <= upper_index,
    valid_index lower_index,
    valid_index upper_index
  ]
  (
    lower_index.to upper_index do { i:Int
      at i put v
    }
  )
  [
    count = Old count
  ]

  - clear_all <-
  // Set every item to its default value.
  // The @count is not affected
  // see also @clear, @all_default.
  ( + value:V
    set_all_with value
  )
  [
    upper = Old upper,
    lower = Old lower,
    all_default
  ]

  // Adding:

  - add_first v:V^n <-
  // Add one or more @v in first position: @count is increased by @n and all items are shifted right.
  (
    abstract
  )
  [
    upper = n + Old upper
  ]

  - add_last v:V^n <-
  // Add one or more @v at the end.
  (
    abstract
  )
  [
    upper = n + Old upper
  ]

  - at i:Int add v:V^n <-
  // Add one or more @v at rank @i : @count is increased by @n and range [ @i .. @upper ] is 
  // shifted right by @n position(s).
  [
    i.in_range lower to (upper + 1)
  ]
  (
    abstract
  )
  [
    upper = n + Old upper
  ]

  - append_collection other:Collection(V) <- 
  // BSBS: append tout court ! Passer en Self
  // Append @other to @self.
  [
    other != NULL
  ]
  (
    (other.lower).to (other.upper) do { i:Int
      add_last (other.at i)
    }
  )
  [
    count = other.count + Old count
  ]

  - copy_collection other:Collection(V) <-
  // Copy @other to @self.
  // DC: Passer aussi en Self non ?
  [
    other != NULL
  ]
  ( 
    clear
    (other.lower).to (other.upper) do { i:Int
      add_last (other.at i)
    }
  )
  [
    count = other.count
  ]
  
  - append other:Collection V from l:Int to u:Int <-
  // BSDC: Passer en Self !
  (
    l.to u do { i:Int
      add_last (other.at i)
    }
  )
  
  // Searching:
  
  - fast_has v:V :Boolean <-
  // Look for @v using basic @= for comparison.
  [
    deprecated True msg "Collection.li:252: Use has. BSDC Jan 2026" 
  ]
  (
    valid_index (fast_first_index_of v)
  )
  
  - has v:V :Boolean <-
  // Look for @v using basic @= for comparison.
  (
    valid_index (fast_first_index_of v)
  )
  
  // Modification:

  - force element:V to index:Int <-
  // Make @element the item at @index, enlarging the collection if
  // necessary (new bounds except @index are initialized with
  // default values).
  [
    index >= lower
  ]
  ( + v:V
    {index <= upper}.until_do {
      add_last v
    }
    at index put element
  )    
  [
    upper = index.max (Old upper),
    at index = element
  ]

  - copy other:Self <-
  // Reinitialize by copying all the items of @other.
  (
    abstract
  )

  - from_collection model:Collection(V) <-
  // Initialize the current object with the contents of @model.
  [
    model != NULL,
    model != self
  ]
  (
    abstract
  )
  [
    count = model.count
  ]

  // Removing:

  - remove_first <-
  // Remove the @first element of the collection.
  [
    ! is_empty
  ]
  (
    abstract
  )
  [
    count = Old count - 1,
    (lower = Old lower + 1) ^ (upper = Old upper - 1)
  ]

  - remove_head n:Int <-
  // Remove the @n elements of the collection.
  [
    n >= 0,
    n <= count
  ]
  (
    abstract
  )
  [
    count = Old count - n,
    (lower = Old lower + n) ^ (upper = Old upper - n)
  ]

  - remove index:Int <-
  // Remove the item at position @index. Followings items are shifted left by one position.
  [
    valid_index index
  ]
  (
    abstract
  )
  [
    count = Old count - 1,
    upper = Old upper - 1
  ]

  - remove_last <-
  // Remove the @last item.
  [ 
    ! is_empty 
  ]
  (
    abstract
  )
  [
    upper = Old upper - 1
  ]

  - remove_tail n:Int <-
  // Remove the last @n item(s).
  [
    n >= 0,
    n <= count
  ]
  (
    abstract
  )
  [
    count = Old count - n,
    upper = Old upper - n
  ]

  - clear <-
  // Discard all items in order to make it @is_empty.
  (
    abstract
  )
  [
    count = 0
  ]

  // Looking and Searching:
  
  - first_index_of element:V :Int <-
  // Give the index of the first occurrence of @element using
  // @== for comparison.
  // Answer @upper @+ @1 when @element is not inside.
  (
    abstract
    0
  )
  [
    Result = index_of element start lower
  ]

  - index_of element:V start start_index:Int :Int <-
  // Using @is_equal for comparison, gives the index of the first occurrence
  // of @element at or after @start_index. Answer @upper @+ @1 when @element
  // when the search fail.
  (
    abstract
    0
  )
  [
    Result.in_range start_index to (upper + 1),
    valid_index Result ->> {element == at Result}
  ]

  - reverse_index_of element:V start start_index:Int :Int <-
  // Using @is_equal for comparison, gives the index of the first occurrence of
  // @element at or before @start_index. Search is done in reverse direction,
  // which means from the @start_index down to the lower index .
  // Answer @lower @- @1 when the search fail.
  [
    valid_index start_index
  ]
  (
    abstract
    0
  )
  [
    Result.in_range (lower - 1) to start_index,
    valid_index Result -> (at Result == element)
  ]

  - last_index_of element:V :Int <-
  // Using @is_equal for comparison, gives the index of the last occurrence
  // of @element at or before upper. Search is done in reverse direction,
  // which means from the upper down to the lower index . Answer @lower @- @1
  // when the search fail.
  (
    reverse_index_of element start upper
  )
  [
    Result = reverse_index_of element start upper
  ]

  - fast_first_index_of element:V :Int <-
  // Give the index of the first occurrence of @element using basic @=
  // for comparison. Answer @upper @+ @1 when @element is not inside.
  (
    abstract
    0
  )
  [
    Result = fast_index_of element start lower
  ]

  - fast_index_of element:V start start_index:Int :Int <-
  // Using basic @= for comparison, gives the index of the first occurrence
  // of element @v at or after @start_index. Answer @upper @+ @1 when @element
  // when the search fail.
  (
    abstract
    0
  )
  [
    Result.in_range start_index to (upper + 1),
    valid_index Result ->> {element = at Result}
  ]

  - fast_reverse_index_of element:V start start_index:Int :Int <-
  // Using basic @= comparison, gives the index of the first occurrence
  // of @element at or before @start_index. Search is done in reverse
  // direction, which means from the @start_index down to the lower
  // index . Answer @lower @- @1 when the search fail.
  [
    valid_index start_index || {start_index = -1}
  ]
  (
    abstract
    0
  )
  [
    Result.in_range (lower - 1) to start_index,
    valid_index Result ->> {at Result = element}
  ]

  - fast_last_index_of element:V :Int <-
  // Using basic @= for comparison, gives the index of the last occurrence
  // of @element at or before upper. Search is done in reverse direction,
  // which means from the upper down to the lower index . Answer @lower @- @1
  // when the search fail.
  (
    fast_reverse_index_of element start upper
  )
  [
    Result = fast_reverse_index_of element start upper
  ]
  
  - index_of_true b:{V;Boolean} :Int <- index_of_true b start 0
  
  - index_of_true b:{V;Boolean} start i:Int :Int <-
  ( + result:Int
    
    result := i
    {(result <= upper) && {!b.value (at result)}}.while_do {
      result := result + 1
    }
    result
  )
  
  - index_of_false b:{V;Boolean} :Int <- index_of_false b start 0
    
  - index_of_false b:{V;Boolean} start i:Int :Int <-
  ( + result:Int
    
    result := i
    {(result <= upper) && {b.value (at result)}}.while_do {
      result := result + 1
    }
    result
  )
  
  // Looking and comparison:

  - self:Self '=='  Right 60 other:E :Boolean <-
  // Do both collections have the same @lower, @upper, and items?
  // The basic @= is used for comparison of items.
  (
    abstract
    False
  )

  - self:Self '~='  Right 60 other:Collection(V) :Boolean <-
  // Do both collections have the same lower, upper, and
  // items?
  // The basic @= is used for comparison of items.
  (
    abstract
    False
  )
  [
    Result ->> {(lower = other.lower) & (upper = other.upper)}
  ]
  
  - all_default:Boolean <-
  // Do all items have their type's default value?
  // Note: for non NULL items, the test is performed with the @is_default predicate.
  (
    abstract
    False
  )

  - same_items other:Collection(V) :Boolean <-
  // Do both collections have the same items? The basic @= is used
  // for comparison of items and indices are not considered (for
  // example this routine may yeld true with self indexed in
  // range [1..2] and @other indexed in range [2..3]).
  [
    other != NULL
  ]
  ( + result:Boolean
    + i,j:Int

    (count = other.count).if {
      result := True
      i := lower
      j := other.lower
      {(! result) || {i > upper}}.until_do {
        result := (at i = other.at j)
        i := i + 1
        j := j + 1
      }
    }
    result
  )
  [
    Result -> (count = other.count)
  ]

  - occurrences element:V :Int <-
  // Number of occurrences of @element using @equal for comparison.
  (
    abstract
    0
  )
  [
    Result >= 0
  ]

  - fast_occurrences element:V :Int <-
  // Number of occurrences of @element using basic @= for comparison.
  (
    abstract
    0
  )
  [
    Result >= 0
  ]
  
  // Sorting:
  
  - bubble_sort <- ( bubble_sort_with { (a,b:V); a < b }; )
  
  - bubble_sort_with cmp:{ (V,V); Boolean} <-
  // Two way bubble sort
  ( + low,up,idx,max:Int
    + sw:Boolean
    max := upper - 1
    low := 0
    up := max
    {
      sw := False
      low.to up do { i:Int
        (cmp.value (at i,at (i+1))).if_false {
          swap i with (i + 1)
          sw := True
        }
        idx := max - i
        (cmp.value (at idx,at (idx+1))).if_false {
          swap idx with (idx+1)
          sw := True
        }
      }
      up  := up  - 1
      low := low + 1
    }.do_while {sw}
  )
  
  - quick_sort cmp:{ (V,V); Boolean} from low:Int to up:Int <-
  ( + i:Int
    + pivot:V
    (low < up).if {
      pivot := at up
      i := low
      low.to (up-1) do { j:Int
        (cmp.value (at j,pivot)).if {
          swap i with j
          i := i + 1
        }
      }
      swap i with up
      quick_sort cmp from low to (i - 1)
      quick_sort cmp from (i + 1) to up
    }
  )
  
  - quick_sort <- quick_sort { (a,b:V); a < b} from lower to upper
  
  - quick_sort_with cmp:{ (V,V); Boolean} <- quick_sort cmp from lower to upper
  
  // foreach family:
  
  - foreach b:{V;} <- from lower to upper do b
  
  - from low:Int to up:Int do b:{V;} <-
  // *** deplacer la cible ?? DCDC
  (
    (up >= low).if {
      low.to up do { i:Int
        b.value (at i)
      }
    }
  )
  
  - while_do b:{V; Boolean} :Boolean <- from lower to upper while_do b
  
  - until_do b:{V; Boolean} :Boolean <- from lower to upper until_do b
      
  - from low:Int to up:Int while_do b:{V; Boolean} :Boolean <-
  // *** deplacer la cible DCDC
  // BSBS: True si il a tout fait. (A generalise')
  //  <=>  True si b a toujours ete true...
  ( + i:Int
    i := low
    {(i <= up) && {b.value (at i)}}.while_do {
      i := i + 1
    }
    i > up
  )
  
  - from low:Int to up:Int until_do b:{V; Boolean} :Boolean <-
  // *** deplacer la cible DCDC
  // True, si b est toujours faux
  ( + i:Int
    i := low
    {(i <= up) && {!b.value (at i)}}.while_do {
      i := i + 1
    }
    i > up
  )
  
  - search_until b:{V; Boolean} :V <-
  ( + i:Int
    + result:V
    i := lower
    {(i <= upper) && {!b.value (at i)}}.while_do { i := i + 1; }
    (i <= upper).if { result := at i; }
    result
  )
  
  - count_if tst:{V; Boolean} :Int <- // DCDC STILL USED
  ( + result:Int
    0.to upper do { i:Int
      (tst.value (at i)).if {
        result := result + 1
      }
    }
    result
  )
  
  // backward variant:
  
  - foreach_backward b:{V; } <- from upper downto lower do b
  // DCDC   ********  la fin
  
  - from up:Int downto low:Int do b:{V; } <-
  // *** deplacer la cible DCDC
  (
    (up >= low).if {
      up.downto low do { i:Int
        b.value (at i)
      }
    }
  )
  
  - while_do_backward b:{V; Boolean} :Boolean <- from upper downto lower while_do b
  
  - until_do_backward b:{V; Boolean} :Boolean <- from upper downto lower until_do b
  
  - from up:Int downto low:Int while_do b:{V; Boolean} :Boolean <-
  // *** deplacer la cible DCDC
  ( + i:Int
    i := up
    {(i >= low) && {b.value (at i)}}.while_do {
      i := i - 1
    }
    i < low
  )
  
  - from up:Int downto low:Int until_do b:{V; Boolean} :Boolean <-
  // *** deplacer la cible DCDC
  ( + i:Int
    i := up
    {(i >= low) && {!b.value (at i)}}.while_do {
      i := i - 1
    }
    i < low
  )
  
  // Others features:
  
  - replace_all old_value:V with new_value:V <-
  // Replace all occurrences of the element @old_value by @new_value
  // using @equal for comparison.
  (
    abstract
  )
  [
    count = Old count
  ]

  - fast_replace_all old_value:V with new_value:V <-
  // Replace all occurrences of the element @old_value by @new_value
  // using operator @= for comparison.
  (
    abstract
  )
  [
    count = Old count,
    { (old_value != new_value) ->> {occurrences old_value = 0}}
  ]

  - move lower_index:Int to upper_index:Int by distance:Int <-
  // Move range @lower_index .. @upper_index by @distance
  // positions. Negative distance moves towards lower indices.
  // Free places get default values.
  [
    lower_index <= upper_index,
    {valid_index lower_index},
    {valid_index (lower_index + distance)},
    {valid_index upper_index},
    {valid_index (upper_index + distance)}
  ]
  ( + default_value:V
    (distance != 0).if {
      (distance < 0).if {
        lower_index.to upper_index do { i:Int
          at (i + distance) put (at i)
          at i put default_value
        }
      } else {
        upper_index.downto lower_index do { i:Int
          at (i + distance) put (at i)
          at i put default_value
        }
      }
    }
  )
  [
    count = Old count
  ]

  - slice min:Int to max:Int :Self <-
  // New collection consisting of items at indexes in [min..max].
  // Result has the same dynamic type as self.
  // The lower index of the Result is the same as lower.
  [
    lower <= min,
    max <= upper,
    min <= max + 1
  ]
  (
    abstract
    NULL
  )
  [    
    Result.count = max - min + 1,
    Result.lower = lower
  ]

  - reverse <-
  // Reverse the order of the elements.
  (
    abstract
  )
  [
    count = Old count
  ]


  // Debug

  - inspect_virer : String_buffer <-
  ( + res : String_buffer
     res := String_buffer.create 4096
     res.append "[ "
    foreach { el : V; res.append "'"; res.append (el.to_string); res.append "' , ";}
    res.append "]"
    res
  ) 

  - append_in b: String_buffer <-
  ( 
    b.add_last '[' 
    foreach { e: V
      b.add_last ' ' 
      e.append_in b
      b.add_last ','
    }
    if (! is_empty) then {
      b.remove_last
    }
    b.add_last ']'     
  )  
