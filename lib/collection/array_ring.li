Header
  + name := Exact Array_ring V
/*Resizable, fixed lower bound array. Circular handling of the storage area.*/
Inherit
  
  + parent_collection:Flat Collection V
  
  - parent_arrayed:Arrayed := Arrayed
  
Private
  
  + storage:C_array V
  
  + ring_low:Int; // corresponding lower in storage
  
  - ring_msk:Int <- capacity - 1
  
Public
  
  + capacity:Int; // Always a power of 2 to ease computing overlays.
  
  + count:Int
  
  - upper:Int <- ( count - 1 )
  
  // Creation:
  
  - new self:Self of (v:V^n) :Self <-
  ( + result:Self
    result := new self capacity n 
    result.add_last v
    result
  )
 
  - new self:Self capacity c:Int :Self <-
  // New empty array with at least capacity of c elements.
  ( + result:Self
    result := clone
    result.with_capacity c
    result
  )
  
Private
  
  - with_capacity needed_capacity:Int <-
  // Create an empty array with at least @needed_capacity.
  [
    needed_capacity >= 0
  ]
  (
    ? {capacity = 0}
    capacity := 1024
    {capacity >= needed_capacity}.until_do {
      capacity := capacity << 1
    }
    storage := C_array V .create capacity
    ring_low := 0
    count := 0
  )
  [
    capacity >= needed_capacity,
    is_empty
  ]
  
Public
  
  - is_empty:Boolean <- (count = 0)
  
  - at i:Int :V <-
  ( + result:V
    result := storage.at ((ring_low + i) & ring_msk)
    result
  )
  
  - at i:Int put v:V  <-
  ( 
    storage.at ((ring_low + i) & ring_msk) put v
  )
  
  - add_last v:V^n <-
  (
    set_capacity (count + n)
    { e:V
      ? {ring_low.in_range 0 to capacity}
      storage.at ((ring_low + count) & ring_msk) put e
      count := count + 1;
    }.value v
  )
  
  - add_first v:V^n <-
  (
    set_capacity (count + n)
    { e:V
      ring_low := (ring_low - 1) & ring_msk
      storage.at ring_low put e
      count := count + 1;
    }.value v
    if (n > 1) then {      
      + i1, i2:Int
      i2 := n - 1
      while {i1 < i2} do {
        swap i1 with i2
        i1 := i1 + 1
        i2 := i2 - 1
      }      
    }
  )
  
  - at i:Int add v:V^n <-
  ( + idx, up, lo, foo:Int
    
    if (i = 0) then {
      add_first v
    }.elseif {i = count} then {
      add_last v
    } else {
      set_capacity (count + n)
      { e:V
        idx := (ring_low + i) & ring_msk
        if (i < (count - i)) then {
          foo := ring_low
          lo := ring_low := (ring_low - 1) & ring_msk
          until {foo = idx} do {
            storage.at lo put (storage.at foo)
            lo := foo
            foo := (foo + 1) & ring_msk
          }
          idx := lo
        } else {
          up := (ring_low + count) & ring_msk
          foo := (up - 1) & ring_msk
          until {idx = up} do {
            storage.at up put (storage.at foo)
            up := foo
            foo := (foo - 1) & ring_msk
          }
        }
        storage.at idx put e
        count := count + 1
      }.value v
    }
  )
  
  - remove_last <-
  (
    count := count - 1
  )
  
  - remove_first <-
  (
    ring_low := (ring_low + 1) & ring_msk
    count := count - 1
  )
  
  - remove index:Int <-
  ( + idx,i,up:Int
    (index = lower).if {
      remove_first
    }.elseif {index = upper} then {
      remove_last
    } else {
      idx := i := (ring_low + index) & ring_msk
      (index < (count - index)).if {
        {idx = ring_low}.until_do {
          idx := i
          i := (i - 1) & ring_msk
          storage.at idx put (storage.at i)
        }
        ring_low := (ring_low + 1) & ring_msk
      } else {
        up := (ring_low + count - 1) & ring_msk
        {i = up}.until_do {
          idx := i
          i := (i + 1) & ring_msk
          storage.at idx put (storage.at i)
        }
      }
      count := count - 1
    }
  )
  
  - to_string:String_alias <-
  ( + i:Int
    + result:String_alias
    + v:V
    String.tmp { ts:String_buffer
      ts.append "-----------------\n"
      ts.append "capacity="; capacity.append_in ts; ts.add_last '\n'
      ts.append "count="; count.append_in ts; ts.add_last '\n'
      ts.append "upper="; upper.append_in ts; ts.add_last '\n'
      ts.append "ring_low="; ring_low.append_in ts; ts.add_last '\n'
      ts.append "ring_msk="; ring_msk.append_in ts; ts.add_last '\n'
      i := ring_low
      /*
      count.times {
        ts.append "i="; i.append_in ts
        ts.add_last ' '
        v := storage.at i
        (v = NULL).if {
          ts.append "NULL"
        } else {
          ts.append (v.to_string)
        }
        ts.add_last '\n'
        i := (i + 1) & ring_msk
      }
      */
      result := ts.to_string_alias
    }
    result
  )
  
Public
  
  - twin:Self <-
  ( + result:Self
    result := new Self capacity count
    0.to upper do { i:Int
      result.add_last (at i)
    }
    result
  )
    
