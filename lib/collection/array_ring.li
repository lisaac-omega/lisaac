Header
  + name := Exact Array_ring V
/*Resizable, fixed lower bound array. Circular handling of the storage area.*/
Inherit
  
  + parent_collection:Flat Collection V
  
  - parent_arrayed:Arrayed := Arrayed
  
Private
  
  + storage:C_array V
  
  + ring_low:Int; // corresponding lower in storage
  
  - ring_msk:Int <- capacity - 1
  
Public
  
  + capacity:Int; // Always a power of 2 to ease computing overlays.
  
  + count:Int
  
  - upper:Int <- ( count - 1 )
  
  // Creation:
  
  - new self:Self of (v:V^n) :Self <-
  ( + result:Self
    result := new self capacity n 
    result.add_last v
    result
  )
 
  - new self:Self capacity c:Int :Self <-
  // New empty array with at least capacity of c elements.
  ( + result:Self
    result := clone
    result.with_capacity c
    result
  )
  
  - set_capacity new_capacity:Int ring <-
  // DCDC faire un super...
  ( + old_capacity, i1:Int

    old_capacity := capacity
    set_capacity new_capacity
    if ((capacity != old_capacity) && {ring_low > (old_capacity - count)}) then {
      Out # "capacity:" # old_capacity # "/" # capacity # " ring_low= " # ring_low # " upper=" # upper # " count=" # count #'\n'
      i1 := ring_low
      ring_low := capacity - (old_capacity - ring_low)
      storage.move i1 to (old_capacity - 1) forward (old_capacity - ring_low)
    }
  )

Private
  
  - with_capacity needed_capacity:Int <-
  // Create an empty array with at least @needed_capacity.
  [
    needed_capacity >= 0
  ]
  (
    ? {capacity = 0}
    capacity := 1024 // DCDC faire comme dans arrayed
    {capacity >= needed_capacity}.until_do {
      capacity := capacity << 1
    }
    storage := C_array V .create capacity
    ring_low := 0
    count := 0
  )
  [
    capacity >= needed_capacity,
    is_empty
  ]
  
Public
  
  - is_empty:Boolean <- (count = 0)
  
  - at i:Int :V <-
  ( + result:V
    result := storage.at ((ring_low + i) & ring_msk)
    result
  )
  
  - at i:Int put v:V  <-
  ( 
    storage.at ((ring_low + i) & ring_msk) put v
  )
  
  - add_last v:V^n <-
  ( + msk:Int
    set_capacity (count + n) ring
    msk := ring_msk
    { e:V
      storage.at ((ring_low + count) & msk) put e
      count := count + 1;
    }.value v
  )
  
  - add_first v:V^n <-
  ( + i, msk:Int
    set_capacity (count + n) ring
    msk := ring_msk
    count := count + n
    ring_low := (ring_low - n) & msk
    { e:V
      storage.at ((ring_low + i) & msk) put e
      i := i + 1;
    }.value v
  )
  
  - at i:Int add v:V^n <-
  ( + i1, i2, msk:Int
    + right_shift:Boolean

    set_capacity (count + n) ring
  //if (i > (upper >> 1)) then {
    if (True) then {
      i1 := upper
      i2 := upper + n
      right_shift := True
    } else {
      ring_low := ring_low - n
      if (ring_low < 0) then {
        ring_low := capacity + ring_low
      }
    }
    count := count + n
    msk := ring_msk
    right_shift.if {
      while {i1 >= i} do {
        storage.at ((ring_low + i2) & msk) put (storage.at ((ring_low + i1) & msk))
        i1 := i1 - 1
        i2 := i2 - 1
      }
    } else {
      i1 := 0
      i2 := n      
      while {i2 < (i - n)} do {
        storage.at ((ring_low + i1) & msk) put (storage.at ((ring_low + i2) & msk))
        i1 := i1 + 1
        i2 := i2 + 1
      }
    }
    i1 := i
    { e:V
      storage.at ((ring_low + i1) & msk) put e
      i1 := i1 + 1
    }.value v
  )
  
  - remove_last <-
  (
    count := count - 1
  )
  
  - remove_first <-
  (
    ring_low := (ring_low + 1) & ring_msk
    count := count - 1
  )
  
  - remove index:Int <-
  ( + idx,i,up:Int
    (index = lower).if {
      remove_first
    }.elseif {index = upper} then {
      remove_last
    } else {
      idx := i := (ring_low + index) & ring_msk
      (index < (count - index)).if {
        {idx = ring_low}.until_do {
          idx := i
          i := (i - 1) & ring_msk
          storage.at idx put (storage.at i)
        }
        ring_low := (ring_low + 1) & ring_msk
      } else {
        up := (ring_low + count - 1) & ring_msk
        {i = up}.until_do {
          idx := i
          i := (i + 1) & ring_msk
          storage.at idx put (storage.at i)
        }
      }
      count := count - 1
    }
  )
  
  - to_string:String_alias <-
  ( + i:Int
    + result:String_alias
    + v:V
    String.tmp { ts:String_buffer
      ts.append "-----------------\n"
      ts.append "capacity="; capacity.append_in ts; ts.add_last '\n'
      ts.append "count="; count.append_in ts; ts.add_last '\n'
      ts.append "upper="; upper.append_in ts; ts.add_last '\n'
      ts.append "ring_low="; ring_low.append_in ts; ts.add_last '\n'
      ts.append "ring_msk="; ring_msk.append_in ts; ts.add_last '\n'
      i := ring_low
      /*
      count.times {
        ts.append "i="; i.append_in ts
        ts.add_last ' '
        v := storage.at i
        (v = NULL).if {
          ts.append "NULL"
        } else {
          ts.append (v.to_string)
        }
        ts.add_last '\n'
        i := (i + 1) & ring_msk
      }
      */
      result := ts.to_string_alias
    }
    result
  )
  
Public
  
  - twin:Self <-
  ( + result:Self
    result := new Self capacity count
    0.to upper do { i:Int
      result.add_last (at i)
    }
    result
  )
    
