Header
  + name := Exact Array_ring V
/*Resizable, fixed lower bound array. Circular handling of the storage area.*/
Inherit
  
  + parent_collection:Flat Collection V
  
  - parent_arrayed:Arrayed := Arrayed
  
Private
  
  + storage:C_array V
    
  + ring_low:Int; // corresponding lower in storage
  
  - ring_msk:Int <- capacity - 1
  
Public
  
  + capacity:Int; // Always a power of 2 to ease computing overlays.
  
  + count:Int
  
  - upper:Int <- ( count - 1 )
  
  // Creation:
  
  - new self:Self of (v:V^n) :Self <-
  ( + result:Self
    result := new self capacity n 
    result.add_last v
    result
  )
 
  - new self:Self capacity c:Int :Self <-
  // New empty array with at least capacity of c elements.
  ( + result:Self
    result := clone
    result.set_capacity c
    result
  )
  
  - set_capacity new_capacity:Int <-
  ( + old_capacity:Int
    
    //(capacity < new_capacity).if { debug_print "avant set_capacity "}
    old_capacity := capacity
    self.parent_arrayed.set_capacity new_capacity
    if (old_capacity = 0) then {
      ? {ring_low = 0}
      ? {count = 0}
    }.elseif {(capacity > old_capacity) && {ring_low + count > old_capacity}} then {
      storage.move ring_low to (old_capacity - 1) forward (capacity - old_capacity)
      ring_low := ring_low + (capacity - old_capacity)
    }
    //(capacity != old_capacity).if { debug_print "après set_capacity" }
  )
  
Public
  
  - is_empty:Boolean <- (count = 0)
  
  - at i:Int :V <-
  ( + result:V
    result := storage.at ((ring_low + i) & ring_msk)
    result
  )
  
  - at i:Int put v:V  <-
  ( 
    storage.at ((ring_low + i) & ring_msk) put v
  )
  
  - add_last v:V^n <-
  ( + msk:Int

    //debug_print ("avant add_last " + n.to_string)
    set_capacity (count + n)
    msk := ring_msk
    { e:V
      storage.at ((ring_low + count) & msk) put e
      count := count + 1;
    }.value v
    //debug_print ("après add_last " + n.to_string)
  )
  
  - add_first v:V^n <-
  ( + i, rmsk:Int

    //debug_print ("avant add_first " + n.to_string)
    set_capacity (count + n)
    rmsk := ring_msk
    count := count + n
    ring_low := (ring_low - n) & rmsk
    { e:V
      storage.at ((ring_low + i) & rmsk) put e
      i := i + 1;
    }.value v
    //debug_print "appres add_first"
  )
  
  - at i:Int add v:V^n <-
  ( + i1, i2:Int

    //debug_print ("avant at " + i.to_string + " add " + n.to_string)
    set_capacity (count + n)
    //if (i < (upper -i)) then {
    if (False) then { // DCDC to do...
      // shift left:
      count := count + n
      ring_low := (ring_low - n) & ring_msk
      i1 := 0
      i2 := i + (n - 1)
      while {i1 < i} do {
        //Out # "left ring_low:" # ring_low # " i1:" # i1 # " i2:" # i2 # " ring_msk:" # ring_msk # '\n'
        at i1 put (at i2)
        i1 := i1 + 1
        i2 := i2 + 1
      }
    } else {
      // shift right:
      i1 := upper
      i2 := upper + n
      count := count + n
      while {i1 >= i} do {
        //Out # "right ring_low:" # ring_low # " i1:" # i1 # " i2:" # i2 # " ring_msk:" # ring_msk # '\n'
        storage.at ((ring_low + i2) & ring_msk) put (storage.at ((ring_low + i1) & ring_msk))
        i1 := i1 - 1
        i2 := i2 - 1
      }
    }
    // writing values:
    i1 := i
    { e:V
      storage.at ((ring_low + i1) & ring_msk) put e
      i1 := i1 + 1
    }.value v
    //debug_print ("après at " + i.to_string + " add " + n.to_string)
  )
  - old_at i:Int add v:V^n <-
  ( + i1, i2, rmsk:Int

    set_capacity (count + n)
    rmsk := ring_msk

    //if (i > (upper >> 1)) then {
    if (True) then {
      // right shift:
      i1 := upper
      i2 := upper + n
      count := count + n
      while {i1 >= i} do {
        storage.at ((ring_low + i2) & rmsk) put (storage.at ((ring_low + i1) & rmsk))
        i1 := i1 - 1
        i2 := i2 - 1
      }
    } else {
      if (ring_low + count > capacity) then {
        // left shift when already split in two:
        Out # "split ring_low:" # ring_low # '/' # (ring_low - n) # '\n'
        storage.move ring_low to (capacity - 1) backward (-n)
        ring_low := ring_low - n
      } else {
        // left shift, splitting in two:
        Out # "2 ring_low:" # ring_low # '/' # (ring_low - n) # '\n'
        storage.move 0 to n forward (capacity - n)
        ring_low := capacity - n
      }
      count := count + n
    }
    // writing values:
    i1 := i
    { e:V
      storage.at ((ring_low + i1) & rmsk) put e
      i1 := i1 + 1
    }.value v
  )
  
  - remove_last <-
  (
    count := count - 1
  )
  
  - remove_first <-
  (
    ring_low := (ring_low + 1) & ring_msk
    count := count - 1
  )
  
  - remove index:Int <-
  ( + idx,i,up:Int
    (index = lower).if {
      remove_first
    }.elseif {index = upper} then {
      remove_last
    } else {
      idx := i := (ring_low + index) & ring_msk
      (index < (count - index)).if {
        {idx = ring_low}.until_do {
          idx := i
          i := (i - 1) & ring_msk
          storage.at idx put (storage.at i)
        }
        ring_low := (ring_low + 1) & ring_msk
      } else {
        up := (ring_low + count - 1) & ring_msk
        {i = up}.until_do {
          idx := i
          i := (i + 1) & ring_msk
          storage.at idx put (storage.at i)
        }
      }
      count := count - 1
    }
  )
  
  - debug_print tag:String <-
  (
    Out # "\n--- " # tag # '\n'
    Out # "capacity:" # capacity # " ring_low:" # ring_low # " count:" # count # " upper:" # upper # '\n'
    '['.print
    0.to (capacity - 1) do { i:Int
      storage.at i .print
      (i < (capacity - 1)). if {
        ' '.print
      }
    }
    "]\n Normal print:".println
    
    self.print
    "\n---\n".print
  )
  
Public
  
  - twin:Self <-
  ( + result:Self
    result := new Self capacity count
    0.to upper do { i:Int
      result.add_last (at i)
    }
    result
  )