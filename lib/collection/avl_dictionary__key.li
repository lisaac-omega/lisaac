Header
  + name := Avl_dictionary V Key K
/*
   Associative memory. Values of type `V' are stored using Keys of type `K'.
   Efficient implementation of DICTIONARY using an AVL balanced tree.
   AVL stands for the names of G. M. Adel'son-Velskii and E. M. Landis,
   two Russian mathematicians who first came up with this method of keeping
   the tree balanced.
  */
Insert
  + parent_avl_tree:Flat Avl_tree K

Private
  - key_memory:K <- item_memory

Public

  - capacity:Int <- count

  - at k:K :V <-
  ( + dic:Avl_dictionary_node V Key K
    dic ?= root.at k
    dic.value
  )

  - fast_at k:K :V <-
  ( + dic:Avl_dictionary_node V Key K
    dic ?= root.fast_at k
    dic.value
  )

  - reference_at k:K :V <-
  ( + result:V
    + n:Avl_dictionary_node V Key K

    (root != NULL).if {
      n := root.at k
      (n != NULL).if {
        result := n.value
      }
    }
    result
  )

  - fast_reference_at k:K :V <-
  ( + result:V
    + n:Avl_dictionary_node V Key K

    (root != NULL).if {
      n := root.fast_at k
      (n != NULL).if {
        result := n.value
      }
    }
    result
  )

  - put v:V to k:K <- add v to k

  - add v:V to k:K <-
  (
    value_memory := v
    key_memory := k
    root := do_insert root
  )

  - fast_put v:V to k:K <-
  (
    value_memory := v
    key_memory := k
    root := fast_do_insert root
  )

  - occurrences v:V :Int <-
  ( + result:Int

    (root != NULL).if {
      result := root.occurrences v
    }
    result
  )

  - fast_occurrences v:V :Int <-
  ( + result:Int

    (root != NULL).if {
      result := root.fast_occurrences v
    }
    result
  )

  - key_at v:V :K <- root.key_at v

  - fast_key_at v:V :K <- root.fast_key_at v

  - clear_count <- clear_count_and_capacity

  - clear_count_and_capacity <-
  (
    (! is_empty).if {
      clear_nodes root
      root := NULL
      count := 0
      map_dirty := True
    }
  )

  - item i:Int :V <-
  ( + dic:Avl_dictionary_node V Key K
    (map_dirty).if {
      build_map
    }
    dic ?= map.item (i - 1)
    dic.value
  )

  - key index:Int :K <-
  (
    (map_dirty).if {
      build_map
    }
    map.item (index - 1).key
  )

  - internal_key k:K :K <- root.at(k).key

  - make <-
  (
    map := Array(Avl_tree_node K).create 0
    // lost_nodes ::= common_lost_nodes.reference_at(generating_type)
    // if lost_nodes = NULL then
    //        create lost_nodes.set_item(NULL)
    //        common_lost_nodes.add(lost_nodes, generating_type)
    //end
  )

Private

  + value_memory:V

  - set_value_and_key n:Avl_tree_node(K) <-
  ( + dic:Avl_dictionary_node V Key K

    dic ?= n
    dic.make (value_memory, key_memory)
  )

  - set_value n:Avl_tree_node(K) <-
  ( + dic:Avl_dictionary_node V Key K

    dic ?= n
    dic.set_value value_memory
  )

  - exchange_and_discard (n1, n2:Avl_tree_node(K)) <-
  (
    n1.set_key (n2.key)
    n1.set_value (n2.value)
    rebalance := True
    count := count - 1
    discard_node n2
  )

  - discard_node n:Avl_dictionary_node V Key K <-
  ( + v:V
    + k:K

    n.make (v, k)
  )

  - a_new_node:Avl_dictionary_node V Key K <-
  (
    Avl_dictionary_node V Key K.clone
  )


  //invariant

  //[ Old
   // -? {lost_nodes != NULL}
   // -? {lost_nodes = common_lost_nodes.at generating_type}
  //]

