Header
  + name := Array_align V
- include := `#include <string.h>`;
Insert

  - parent_clone:Clone := Clone

Public
  
  + storage:C_array Uint8
  
  + capacity:Int
  
  + upper:Int
  
  + align:Int := 1
  
  - item_size:Int <- 
  (
    (V.object_size + align) - (V.object_size % align)
  )
  
  - lower:Int := 0; // Frozen lower bound.

  // Creation and modification:

  - create new_count:Int align a:Int :Self <-
  // Make array with range [0 .. @new_count - 1].
  // When @new_count = 0 the array is empty.
  ( + result:Self

    result := clone
    result.make new_count align a
    result
  )

  - create_with_capacity new_count:Int align a:Int :Self <-
  // Create an empty array with at least @needed_capacity.
  ( + result:Self

    result := clone
    result.with_capacity new_count align a
    result
  )

  - make new_count:Int align a:Int <-
  // Make array with range [0 .. @new_count - 1].
  // When @new_count = 0 the array is empty.
  [ /* BSBS Old; */
    -? { new_count >= 0}
  ]
  (
    align := a
    ( new_count.to_int > capacity).if {
      // The new one is bigger:
      storage := C_array(Uint8).create (new_count * item_size)
      capacity := new_count
    }.elseif { (capacity > 0) && { upper >= 0}} then {
      // The new one is smaller and just need to be cleared:
      storage.clear 0 to ((upper+1)*item_size-1)
    }
    upper := new_count - 1
  )
  [ /* BSBS Old; */
    +? { count = new_count }
    +? { capacity >= Old capacity }
    +? { (upper >= 0) ->> {all_default} }
  ]

  - with_capacity needed_capacity:Int align a:Int <-
  // Create an empty array with at least @needed_capacity.
  [ /* BSBS Old; */
    -? { needed_capacity >= 0 }
  ]
  (
    align := a
    (capacity < needed_capacity).if {
      storage := C_array(Uint8).create (needed_capacity*item_size)
      capacity := needed_capacity
      /*
      ( + ofs:C_array Uint8
        ofs := storage
        storage := `(((long long)@ofs) + 255) & ~255`:C_array Uint8
      )
      "************************************************\n".print
      */
    //}.elseif { capacity > needed_capacity } then {
    //  storage.clear 0 to upper; // BSBS: Ca serre a quoi de le vider !
    }
    upper := -1
  )
  [ /* BSBS Old; */
    +? { capacity >= needed_capacity }
    +? { is_empty }
  ]

  // Modification:

  - set_capacity new_capacity:Int <-
  // Resize capacity the array, but not count.
  [
    -? {new_capacity >= 0}
  ]
  (
    (new_capacity > capacity).if {
      (capacity = 0).if {
        storage := C_array(Uint8).create (new_capacity*item_size)
      } else {
          storage := storage.realloc (capacity*item_size) with (new_capacity*item_size)
      }
      capacity := new_capacity
    }
  )
  [
    +? { capacity >= Old capacity }
  ]

  - resize new_count:Int <-
  // Resize the array. When @new_count is greater than
  // @count, new positions are initialized with appropriate
  // default values.
  [ /* BSBS Old; */
    -? {new_count >= 0}
  ]
  ( + new_capacity:Int

    ( new_count > count).if {
      (capacity = 0).if {
        storage := C_array(Uint8).create (new_count*item_size)
        capacity := new_count
      }.elseif { capacity < new_count } then {
        new_capacity := capacity * 2
        { new_capacity >= new_count }.until_do {
          new_capacity := new_capacity * 2
        }
        storage := storage.realloc (capacity*item_size) with (new_capacity*item_size)
        capacity := new_capacity
      }
    }.elseif { new_count != count } then {
      storage.clear (new_count*item_size) to (count*item_size - 1)
    }

    upper := new_count - 1
  )
  [ /* BSBS Old; */
    +? { count = new_count }
    +? { capacity >= Old capacity }
  ]

  // Implementation of abstract:

  - is_empty:Boolean <- ( upper < 0 ); // end is_empty

  - item i:Int :V <-
  ( + st:C_array Uint8
    + ofs:Int
    st := storage
    ofs := i*item_size
    (st = NULL).if { "ARRAY_ALIGN L.172\n".print; }; // BSBS: Bug Compilo!
    `&@st[@ofs]`:V
  )
  
  - last:V <- item upper

  - put element:V to i:Int <-
  ( + st:C_array Uint8
    + ofs,sz:Int
    st := storage
    sz := V.object_size
    ofs := i*item_size
    (st = NULL).if { "ARRAY_ALIGN L.172\n".print; }; // BSBS: Bug Compilo!
    `memcpy(&@st[@ofs],@element,@sz)`
  )

  - add_last element:V <-
  ( + new_capacity:Int
    (upper + 1 < capacity).if {
      upper := upper + 1
    }.elseif {capacity = 0} then {
      storage := C_array(Uint8).create (2*item_size)
      capacity := 2
      upper := 0
    } else {
      new_capacity := 2 * capacity
      storage := storage.realloc (capacity*item_size) with (new_capacity*item_size)
      capacity := new_capacity
      upper := upper + 1
    }
    put element to upper
  )

  - count:Int <- ( upper + 1 ); // end count

  - clear <-
  (
    upper := -1
  )
  [ /* BSBS Old; */
    +? { capacity = Old capacity }
  ]

