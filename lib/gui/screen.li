Header
  + name := Exact Screen
Inherit
  + parent_window:Flat Window
  - parent_json:Json := Json
  - parent_any_gui:Any_gui := Any_gui
  
Private
  - stk:Flat Array Screen
  
Public
  
  - new:Self <-
  ( + r:Self; (stk.is_empty).if { r := clone; } else { r := stk.pop; }; r)
  
  - free <-
  ( child.foreach {c:Win; c.free; }
    child.clear
    stk.add_last self
    Hand.destroy_window self
    Paper.destroy_window self
  )
  
  - width_min:Real32 <- child.first.width_min.max (child.second.width_min)
  - height_min:Real32 <- child.first.height_min + child.second.height_min
  
  - is_split:Boolean
  
  - on_close <- 
  (
    (Paper.wins.count > 1).if {
      {self = Page.cur_pg.window}.while_do {         
        change_pg; 
      }
      free
    } else {
      exit_cmd
    }
  )
    
  - draw <-
  ( 
    Img.update pen
  )
  
  - draw_child <-
  ( + ps:Page_split
    + x1,x2,y1,y2:Real32
    + w:Win
    parent_window.draw_child
    Page.cur_pg.buf_pg.fix_buffer
    ((Hand.window_cur = self) && {(ps ?= child.second) != NULL}).if {
      w := ps.child.first
      (ps.is (ps.line) != 0).if {
        (x1,y1,y2) := (w.xmax-2, 0, ymax)
        x2 := x1 + 2
        is_split := Hand.x_cur.in_range x1 to x2
      } else {
        (y1,x1,x2) := (w.ymax-2, 0, xmax)
        y2 := y1 + 2
        is_split := Hand.y_cur.in_range y1 to y2
      }
      (is_split).if {
        begin_path
        rect (x1,y1) to (x2,y2)
        fill_color (Color.red)
        fill
      }
    }
    (! acts_wait.is_empty).if {
      Paper.refresh_again
      (! acts_wait.pop_first.run).if { beep; acts_wait.clear; }
    }
  )
  
  - set_have_the_focus b:Boolean <-
  (
    (b && {! have_the_focus}).if {
      Buf_pg.footnote_left.clear
      Buffer.catalog.foreach { e:Buffer; e.reload }
    }
    parent_window.set_have_the_focus b
  )
  
  - draw_forward <-
  (
    (! have_the_focus).if {
      begin_path
      fill_color (Look.focus_off)
      rect (0,0) size (width,height)
      fill
    }
  )
    
  - refresh <-
  ( + head:Win
    + l:Int
    head := child.first; head.refresh
    l := 2
    (Vkeyb.parent = self).if {
      Vkeyb.refresh
      (Vkeyb.parent = self).if {
        height:= height - Vkeyb.height
        l := l + 1
      }
    }
    (Cmd.parent = self).if {
      child.at 2.refresh; // self CMD
      (Cmd.parent = self).if {
        height:= height - Cmd.height
        l := l + 1
      }
    }
    child.upper.downto l do { i:Int; child.at i.refresh; }
    height := height - head.height
    child.at 1.xy (0,head.height).size (width,height).refresh
    height := Old height
  )
  
  - event ev:Int :Boolean <-
  ( 
    (is_split && {ev & ~1 = Hand.clic}).if {
      split_win
    }
  )
  
  - mouse_scroll (dx,dy:Real64) <-
  ( + d:Real64
    d := dy * Page.cur_pg.height * -0.20
    Page.cur_pg.buf_pg.set_pos_y (Page.cur_pg.buf_pg.pos_y + d)
    Page.cur_pg.buf_pg.move_pos_y d
  )
  
  - key s:String cmd c:Uint8 :Boolean <-
  ( + r:Boolean
    Buf_pg.footnote_left.clear
    (focus != NULL).if {      
      r := focus.key s cmd c
    } else {      
      r := Shortcut.key s cmd c
      (! r).if {
        (cmd_cur.is (cmd_cur.on)).if {
          r := cmd_cur.key s cmd c
        } else {          
          r := Page.cur_pg.buf_pg.key s cmd c
        }
      }
    }
    //"key:".print; c.print; ' '.print; s.println
    (r).if {
      current_key.clear
    } else {
      (! current_key.is_empty).if { current_key # ", " }
      Keyboard.key_to_string s cmd c in current_key    
      Page.cur_pg.buf_pg.footnote_left.copy current_key
    }
  )
  
  - init_pos (x,y:Real32) size (w,h:Real32) :Self <-
  ( (xo,yo,width,height) := (x,y,w,h); init_common)
    
  - read:Self <-
  ( read_object
    ((vkeyb) && {Vkeyb.parent = NULL}).if { Vkeyb.set_open self; }
    init_common
  )
    
  - item id:String_alias int v:Int :Boolean <-
  (
    id
    .case "x"      then { xo := v;     }
    .case "y"      then { yo := v;     }
    .case "width"  then { width := v;  }
    .case "height" then { height := v; }
    = String_alias
  )
  
  - item id:String_alias bool v:Boolean :Boolean <-
  (
    id
    .case "fullscreen" then { (! home_directory.has_suffix "/ben/").if { fullscreen := v; }; }
    = String_alias
  )
  
  - object id:String_alias :Boolean <-
  (
    id
    .case "HEADER"     then { Header.new.init self;     }
    .case "PAGE_SPLIT" then { Page_split.new.init self; }
    .case "PAGE"       then { Page.new.init self;       }
    = String_alias
  )
  
  - write_object <-
  ( + x,y:Real32
    + w:Win
    put_object {      
      put "fullscreen" value { put_bool fullscreen; }
      (x,y) := get_pos
      put "x" value { put_int (x.to_int); }
      put "y" value { put_int (y.to_int); }
      put "width"  value { put_int (width.to_int); }
      put "height" value { put_int (height.to_int); }
      put "HEADER" value { child.first.like Header.write_object; }
      w := child.second
      (w.dynamic_type = Page).if {
        put "PAGE" value { w.like Page.write_object; }
      } else {
        put "PAGE_SPLIT" value { w.like Page_split.write_object; }
      }
    }
  )
  
Private
  
  - current_key:String_buffer := String_buffer.create 32
    
  - init_common:Self <-
  (
    id_name := window_title
    init NULL
    Font.load pen
    set_pos (xo,yo)
    Keyboard.listen self
    (xo, yo) := (0, 0)
    self
  )
