Header
  + name := CMD_CUT_RIGHT;
  
Inherit
  - parent_cmd:CMD := CMD

Public
  
  - open:BOOLEAN <-
  ( 
    (cmd_cur != Self).if {
      clipboard.clear
      cmd_cur := Self
      set on
      SUBACT.get "CutRight".load Self
    }
    cut
  )

  - key s:STRING cmd c:UINTEGER_8 <-
  (
    close
    SCREEN.key s cmd c
  )
  
  - close <-
  ( 
    SUBACT.restore
    unset on
    CLIPBOARD.put clipboard
    cmd_cur := CMD
  )
  
Private
  
  - cut:BOOLEAN <-
  ( + p0,p:INTEGER
    + c:CHARACTER
    + pg:TXT_PG
    + d:DIV
    
    pg := cur_txt
    d ?= pg.child.at (pg.pt_div)
    
    //OUT # pg.pos.pt # "->" # d.pte.pt # '\n'
    
    p := p0 := pg.pos.pt
    {p != d.pte.pt}.while_do {
      clipboard.add_last (cur_txt.text.at p)
      p := p + 1
    }  
    (p = p0).if {
      c := pg.text.at p
      (c = '\r').if { clipboard.add_last '\r'; p := p + 1; c := pg.text.at p }
      (c = '\n').if { clipboard.add_last '\n'; p := p + 1 }
    }
    p := p - p0
    (p != 0).if {
      pg.text.rm p0 times p
      pg.set_pos (pg.pos.pt)
    }
  )
