Header
  + name := Cmd_cut_right
Inherit
  - parent_cmd:Cmd := Cmd

Public
  
  - open:Boolean <-
  ( 
    (cmd_cur != self).if {
      clipboard.clear
      cmd_cur := self
      set on
      Subact.get "CutRight".load self
    }
    cut
  )

  - key s:String cmd c:Uint8 :Boolean <-
  (
    close
    Screen.key s cmd c
  )
  
  - close <-
  ( 
    Subact.restore
    unset on
    Clipboard.put clipboard
    cmd_cur := Cmd
  )
  
Private
  
  - cut:Boolean <-
  ( + p0,p:Int
    + c:Char
    + pg:Txt_pg
    + d:Div
    
    pg := cur_txt
    d ?= pg.child.at (pg.pt_div)
    
    //OUT # pg.pos.pt # "->" # d.pte.pt # '\n'
    
    p := p0 := pg.pos.pt
    {p != d.pte.pt}.while_do {
      clipboard.add_last (cur_txt.text.at p)
      p := p + 1
    }  
    (p = p0).if {
      c := pg.text.at p
      (c = '\r').if { clipboard.add_last '\r'; p := p + 1; c := pg.text.at p }
      (c = '\n').if { clipboard.add_last '\n'; p := p + 1 }
    }
    p := p - p0
    (p != 0).if {
      pg.text.rm p0 times p
      pg.set_pos (pg.pos.pt)
    }
  )
