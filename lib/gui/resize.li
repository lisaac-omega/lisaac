Header
  + name := Resize
Inherit
  + parent_win:Flat Win
  - parent_any_gui:Any_gui := Any_gui
    
Public
    
  - event ev:Int :Boolean <-
  ( 
    (ev = Hand.in).if {
      (! decorated).if {
        Paper.set_cursor (window.win_ptr) img cursor_sz
      }
    }.elseif {ev = Hand.out} then {
      Paper.set_cursor (window.win_ptr) img cursor_std
    }.elseif {(ev & ~1) = Hand.drag} then {
      (! decorated).if {
        - psh,psv:Page_split
        (Hand.is_begin).if {
          psh := Page.cast parent.get_split True
          psv := Page.cast parent.get_split False
        }
        Page_split.move psh and psv win self
      }
    }
  )
  
