Header
  + name := Undo
Inherit
  - parent_clone:Clone := Clone
  
Public
  - stack_size:Int := 32_768; // Power 2 !!
  - stack_mask:Int := stack_size - 1
  
  + stack:Flat Array Undo_elt
  + lower:Int
  + count:Int
  - upper:Int <- count - 1
  + ptr:Int
  + ptr_save:Int
  
  + auto:Boolean := True
  - set_auto b:Boolean <- ( auto := b; )
  
  - is_empty:Boolean <- count = 0
  
  - new:Self <- clone
  
  - clear <-
  ( + e:Undo_elt
    0.to upper do { i:Int
      e := at i
      (e != NULL).if {
        e.free
        at i put NULL
      }
    }    
    lower := count := ptr := ptr_save := 0
  )
  
  - rm i:Int  char c:Uint32 <- gen i char c type t_rm
  - add i:Int char c:Uint32 <- gen i char c type t_add
  - add_stop <- ((!is_empty) && {at upper != NULL}).if { add NULL; }
  
  - last_save <- ( ptr_save := ptr; );
  
  - do t:Txt_buf :Boolean <-
  ( + u:Undo_elt
    + p:Int
    p := ptr - 1
    {(p >= 0) && {at p = NULL}}.while_do { p := p - 1; }
    (p >= 0).if {
      //print "Before UNDO"
      busy := True
      {(p >= 0) && {(u := at p) != NULL}}.while_do {
        u.run t dir 0
        p := p - 1
      }
      ptr := p + 1
      busy := False
      //OUT # "ptr=" # ptr # " ptr_save=" # ptr_save # '\n'
      (ptr = ptr_save).if { t.set_save True }
      //print "After UNDO"
      t.footnote_left.clear
    } else {
      t.footnote_left.copy "No further undo information."
    }
  )
  
  - redo t:Txt_buf :Boolean <-
  (ptr < count).if {
    + u:Undo_elt
    //print "Before REDO"
    busy := True
    {(ptr < count) && {(u := at ptr) != NULL}}.while_do {
      u.run t dir 1
      ptr := ptr + 1
    }
    {(ptr < count) && {at ptr = NULL}}.while_do { ptr := ptr + 1; }
    (ptr = ptr_save).if { t.set_save True }
    busy := False
    t.footnote_left.clear
    //print "After REDO"
  } else {
    t.footnote_left.copy "No further redo information."
  }
  
  - print t:String <-
  ( + u:Undo_elt
    "----------------".print; t.println
    0.to upper do { i:Int
      (i = ptr).if { "> ".print; } else { "  ".print; }
      i.print; ':'.print
      u := at i
      (u = NULL).if { "NULL".println; } else { u.print; }
    }
    (count = ptr).if { "> ".println; }
  )
  
Undo, Undo_elt
  
  - busy:Boolean
  
  - t_rm:Int8  := 0
  - t_add:Int8 := 1
  - t_sav:Int8 := 2
  
  - at i:Int :Undo_elt <- stack.at ((lower + i) & stack_mask)
  - at i:Int put e:Undo_elt <- stack.at ((lower + i) & stack_mask) put e
  
  - add e:Undo_elt <-
  ( + u:Undo_elt
    (! busy).if {
      (stack.capacity = 0).if { stack.make stack_size }
      ((u := at ptr) != NULL).if { u.free }
      at ptr put e
      (ptr = stack_size).if {
        (ptr_save = lower).if { ptr_save := -1 }
        lower := (lower + 1) & stack_mask
      } else {
        ((e = NULL) && {ptr = ptr_save}).if { ptr_save := ptr_save + 1 }
        ptr := ptr + 1
        count := ptr
      }
    }
  )
  
  - gen i:Int char c:Uint32 type t:Int8 <-
  ( + new_t:Uint64
    - time:Uint64
    ((auto) && {(ptr = 0) || {at (ptr-1) != NULL}}).if {
      new_t := Clock.time_raw
      ((new_t - time) >= 1).if { add NULL; }
      time := new_t
    }
    add (Undo_elt.new.init i char c type t)
  )
  
