Header
  + name := Exact Undo_elt
Inherit
  - parent_clone:Clone := Clone
  
Private
  - stk:Flat Array Undo_elt
  - tmp:String_buffer := String_buffer.create 4
Public
  - stack_size:Int := 32_768; // Power 2 !!
  
  + pt_i:Int
  + char:Uint32
  + type:Int8
  
  - str:String_buffer <-
  ( + c:Uint32
    tmp.clear
    c := char
    {c != 0}.while_do {
      tmp.add_first (c.to_uint8.to_character)
      c := c >> 8
    }
    tmp
  )
  
  - run t:Txt_buf dir dir:Int8 <-
  (
    (type ^ dir)
    .when (Undo.t_rm)  then { rm t;  }
    .when (Undo.t_add) then { add t; }
  )
    
  - rm t:Txt_buf <-
  ( t.rm pt_i
    t.set_pos_raw pt_i
  )
  
  - add t:Txt_buf <-
  ( t.at pt_i add str
    t.set_pos_raw (pt_i + tmp.count)
  )
  
  - init i:Int char c:Uint32 type t:Int8 :Self <-
  ( (pt_i,char,type) := (i,c,t); self)
  
  - new:Self <-
  ( + r:Self; (stk.is_empty).if { r := clone; } else { r := stk.pop; }; r)
  
  - free <- stk.add_last self
  
  - print <-
  (
    pt_i.print; ' '.print
    type
    .when (Undo.t_rm)  then { "rm".print;  }
    .when (Undo.t_add) then { "add".print; }
    "`".print; str.print; '\''.println;
  )
