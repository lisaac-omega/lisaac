Header
  + name := Tok_drw
Insert
  + parent_txt_buf:Txt_buf := Txt_buf
Inherit
  - parent_clone:Clone := Clone; // Just for DIV.data:CLONE

Public
  
  - is_major:Boolean := True
  - di_major:Int <- ( ? {is_major}; di)
  
  - txt_buf:Txt_buf <- parent_txt_buf
  //- set_p_txt_buf t:TXT_BUF <- ( parent_txt_buf := t; )
  
  - pt_b:Pos
  - begin p:Pos <-
  (
    Tok_itm.set_parent_tok_drw self
    pt_b := p
  )
  
  - new:Self <- (crash; Self)
  - free
  
  - rmk_extern <-
  ( + c:Char
    + n:String_alias    
    + p:Int
    + l:Local
    jmp 1 sub 0
    p := sty.count
    pos_i := pos_i + 1
    String.tmp { tmp:String_buffer
      {
        c := at pos_i
        tmp # c
        pos_i := pos_i + 1        
        (c = '\\').if {
          tmp # at pos_i
          jmp 1 sub 1
          pos_i := pos_i + 1
          c := at pos_i
        }
      }.do_while {! " \n\0\r.,".has c}
      tmp.remove_last
      n := tmp.to_string_alias
    }
    (! n.is_empty).if {
      l := Expr.get_local n
      (l = NULL).if {
        sty.at p add (Old pos_i.pt - pt_b.pt, (n.first.is_upper).ok (Look.type | 80h) or (Look.slot | 80h))
      } else {      
        sty.at p add (Old pos_i.pt - pt_b.pt, (n = "self").ok (Look.keyword | 80h) or (Look.local | 80h))
        (l.style_is (Decl.f_ro)).if {
          sty.at p add (Old pos_i.pt - pt_b.pt, Font.italic | 10000h)
          fnt (Font.roman) sub 1
        }
      }      
      col (Look.rmk) sub 1
    }
    pos_i := pos_i - 2
  )  
  
  - begin_draw
  - sub_draw
  - end_draw
  - post_draw
      
  - draw_std e:Int <-
  [ ? {e.in_range 0 to (upper+1)} ] 
  ( + old_pt:Pos    
    {pos_i < e}.while_do {
      old_pt := pos_i
      sty_run
      sub_draw
      (old_pt = pos_i).if {        
        at_tmp pos_i
        draw_tmp_c
        pos_i := pos_i + tmp_c.count
      }
    }    
    sty_run
    old_pt := pos_i; // DEBUG:
    //pt_ri := pt_ci - pt_b
    sub_draw
    //sty_run
    /*(pos_i != old_pt).if {
      "TOK:".print
      type_name.print; ' '.print
      pos_i.pt.print; '/'.print; old_pt.pt.println
    };*/
    //? {pos_i = old_pt}
  )
  
  //- is_phys:Boolean := True
  
  + di:Int
  - end d:Pos :Self <- ( di := d.pt - pt_b.pt; self)
  
  + dh:Real32; // Delta Height
  //- set_dh h:REAL_32 <- ( dh := h; )
    
  + nl:Int
  - inc_nl <- ( nl := nl + 1; )
  - dec_nl <- ( nl := nl - 1; )
  - set_nl l:Int <- ( nl := l; )
  
  - cmd_new_line:Boolean <-
  ( + r:Boolean
    r := txt_buf.cmd_add "\n"
    (r && {auto_indent}).if {
      pos := pos + indent_line (pos-1)
      pos := pos + indent_line pos
    }
    r
  )
  
  - cmd_new_line2:Boolean <-
  ( + r:Boolean
    r := txt_buf.cmd_add "\r\n"
    (r && {auto_indent}).if {
      pos := pos + indent_line (pos-2)
      pos := pos + indent_line pos
    }
    r
  )
  
  - cmd_suppr:Boolean <- ( txt_buf.rm pos; True)
  
  - printi i:Int <-
  (    
    "=== ".print; i.print; " ===".println
    "Size   : ".print; di.println
    "Size y : ".print; dh.println
  )
  
  - check_end d:Int :Boolean <-
  ( + result:Boolean
    (pt_b+di != d).if {
      "Error TOK_DRW:\n pos real:".print; d.println
      " pt_b:".print; pt_b.print; " + di:".print; di.print; " = ".print; (pt_b+di).println
      result := True
    }
    ? {pt_b+di = d}
    result
  )
  
  - detect:Boolean <-
  [ parent_txt_buf := Txt_buf.current; ]
  ( abstract; True)
  
  - parse          <- ( abstract; )
  - next_parse
  
  - product <-
  (
    parent_txt_buf := Txt_buf.current
    nl := 0
    dh := 0
    sty.clear
    begin pos_i
    parse
    end pos_i
    
    (! ((pos_i = upper) || {(pos_i-1 < upper) && {at (pos_i-1) = '\n'}})).if {
      "TOK_DRW 103 ".print; type_name.print; ' '.print; pos_i.print
      '/'.print; upper.print
      '\n'.print; at (pos_i-1).to_uint8.print
      " in ".print; name.println
      exit 0
    }
    ? {(pos_i = upper) || {(pos_i-1 < upper) && {at (pos_i-1) = '\n'}}}
    
    ((pos_i = upper) && {(upper = 0) || {at (upper-1) != '\n'}}).if {      
      nl := nl + 1
    }
  )
  
  - is_empty:Boolean <- di = 1
  
  - my_pos:Pos <-
  ( + i:Int
    + p:Pos
    + t:Tok_drw
    {(t := toks.at i) != self}.while_do {      
      p := p + t.di
      i := i + 1
    }
    p
  )
  
  - my_tok_cur:Int <-
  ( + i:Int
    {toks.at i != self}.while_do { i := i + 1; }
    i
  )
  
  - draw_extern <-
  (
    pos_i := my_pos
    tok_cur := my_tok_cur
    Tok_itm.set_parent_tok_drw self
    draw
    Tok_itm.set_parent_tok_drw (Old Tok_itm.parent_t_drw)
    tok_cur := Old tok_cur
    pos_i := Old pos_i
  )
  
  - draw <-
  ( + e,i,v:Int
    + dx:Real32
    begin pos_i
    styi := 0
    //pt_ri := 0
    begin_draw
    e := pt_b.pt + di
    (pos.pt.in_range (pos_i.pt) to (e-1)).if {
      i := 2
      {(i <= sty.upper) && {sty.at i + pt_b.pt < pos.pt}}.while_do { i := i + 2; }
      (i < sty.upper).if {
        v := sty.at (i+1)
        ((v < 0) && {sty.at (i-1) = v}).if {          
          itm_cur := v; //CAST Int TO TOK_ITM.on (v & 07FFF_FFFF_FFFF_FFFFh)
        }
      }
    } else { itm_cur := -1; }
    //fill_color (COLOR.black)
    draw_std e
    ((pos_i = upper) && {tok_cur = toks.upper}).if { end_text; }
    end_draw
    //
    (Div.debug_div).if {
      dx := x_space*2
      save
      begin_path
      line (dx,tex.y) to (width-dx,tex.y)
      stroke_width 1.0
      stroke_color (Color.white)
      stroke
      fill_color (Color.white)
      String.tmp { tmp:String_buffer
        tmp.copy "Tok#"
        tok_cur.append_in tmp
        tmp.append " L"
        nl.append_in tmp
        font_size 15
        text (width-100,tex.y-3) msg tmp
      }
      restore
    }
    //
    post_draw
    dh := tex.y - Old tex.y
  )
  
  - search s:String base b:Int at idx:Int :Int <-
  ( ? {idx.in_range 0 to (di-1)}; // No valid for TOK_ITM
    search s range (b+idx) to (b+di-1)
  )
  
  - search_back s:String base b:Int at idx:Int :Int <-
  ( ? {idx.in_range 0 to di}; // No valid for TOK_ITM
    search_back s range (b+idx) downto b
  )
  
  // Style / Color
  
  - esc_char_style:Int32 := 30100h
  - esc_char_arrow:Int32 := 30201h
  - esc_char_commu:Int32 := 30202h
    
  + sty:Flat Array Int32
  - styi:Int
  - underline:Boolean
  - last_color:Color; // Used LIZ
  
  - ope_val:Flat Array String_alias // See LIZ
  
  - reset_sty p:Int <-
  ( + d:Int
    d := p - pt_b.pt
    {(!sty.is_empty) && {sty.second_last >= d}}.while_do { sty.remove_tail 2 }
  )
  
  
  - sty_run <-
  ( + f,n,j:Int32
    + sz:Real32
    {(styi <= sty.upper) && {pos_i >= pt_b.pt + sty.at styi}}.while_do {
      f := sty.at (styi+1)
      (f = itm_cur).if {
        underline := !underline
      } else {
        n := f & 0FF_FFh
        (f >> 16)
        .when 0 then { // Color
          (n & 80h = 0).if {
            last_color := Look.cols.at n
          } else {
            last_color := Look.cols_bland.at (n & 7Fh)
          };
          fill_color last_color
          //stroke_color (COLOR.white)
        }
        .when 1 then { // Font
          //OUT # "FONT:" # n # " pos:" # (pt_b.pt + sty.at styi) # '\n'
          Font.app n in txt_buf
        }
        .when 2 then { // Size
          n
          .when 0 then { sz := Font.size_app; }
          .when 1 then { sz := Font.size_app * 0.8; }
          .when 2 then { sz := Font.size_app * 1.1; }
          font_size sz
        }
        .when 3 then { // Escape character
          j := n >> 8; n := n & 0FFh
          (! pos.in_range (pos_i.pt-1) to (pos_i.pt+j+1)).if {            
            (last_div = NULL).if {
              (tex.x = tex.xmin).if { begin_line; }
              last_div := Div.new.text
            }
            tex.set_x (Look.drw n)
            //
            tex.ascdes (asc_c,des_c)
            detect_cur
            pos_i := pos_i + j
          }
        }
        .when 4 then { // Img
          (! pos.in_range (pos_i.pt) to (pos_i.pt+n)).if {
            String.tmp { tmp:String_buffer
              tmp.copy name
              tmp.remove_suffix shortname
              (pos_i.pt).to (pos_i.pt + n - 1) do { i:Int
                tmp | at i
              }              
              (put_image tmp).if {
                pos_i := pos_i + n
              }
            }
          }
        }
        .when 5 then { // Exposant / Indice
          n
          // Exposant
          .when 0 then {
            font_size (Font.size_app)
            tex.add_y (+ Font.size_app * 0.2)
          }
          .when 1 then {
            font_size (Font.size_app * 0.8)            
            tex.add_y (- Font.size_app * 0.2)
          }
          // Indice
          .when 2 then {
            font_size (Font.size_app)
            tex.add_y (- Font.size_app * 0.2)
          }
          .when 3 then {
            font_size (Font.size_app * 0.8)            
            tex.add_y (+ Font.size_app * 0.2)
          }
        }
        .when 6 then { // Jump
          (! pos.in_range (pos_i.pt-1) to (pos_i.pt+n+1)).if {
            pos_i := pos_i + n
          }
        }        
        .when 7 then { // UTF8 conversion
          j := n >> 8; n := n & 0FFh
          (! pos.in_range (pos_i.pt-1) to (pos_i.pt+j+1)).if {
            tmp_c.copy (ope_val.at n)
            draw_tmp_c            
            pos_i := pos_i + j
          }
        }
      }
      styi := styi + 2
    }
  )
  
  - col n:Int sub s:Int <-
  //[ ? {sty.is_empty || {pos_i.pt - pt_b.pt - s >= sty.second_last}}; ]
  (
    ((!sty.is_empty) && {pos_i.pt - pt_b.pt - s < sty.second_last}).if {
      print_sty (pt_b.pt)
      Out # (pos_i.pt - pt_b.pt - s) # " < " # sty.second_last # '\n'
      Out # "Pos_i = " # pos_i.pt # '\n'
      //crash
    } else {
    sty.add_last (pos_i.pt - pt_b.pt - s)
    sty.add_last n
    }
  )
  
  - fnt n:Int sub s:Int <-
  [ ? {sty.is_empty || {pos_i.pt - pt_b.pt - s >= sty.second_last}}; ]
  ( sty.add_last (pos_i.pt - pt_b.pt - s)
    sty.add_last (n | 10000h)
  )
  
  - fsz n:Int sub s:Int <-
  [ ? {sty.is_empty || {pos_i.pt - pt_b.pt - s >= sty.second_last}}; ]
  ( sty.add_last (pos_i.pt - pt_b.pt - s)
    sty.add_last (n | 20000h)
  )
  
  - drw n:Int sub s:Int <-
  [ ? {sty.is_empty || {pos_i.pt - pt_b.pt - s >= sty.second_last}}; ]
  ( sty.add_last (pos_i.pt - pt_b.pt - s)
    sty.add_last (n | 30000h)
  )
  
  - img b:Int to e:Int <-
  [ ? {sty.is_empty || {b - pt_b.pt >= sty.second_last}}; ]
  ( sty.add_last (b - pt_b.pt)
    sty.add_last ((e-b) | 40000h)
  )
  
  - exp b:Boolean sub s:Int <-
  [ ? {sty.is_empty || {pos_i.pt - pt_b.pt - s >= sty.second_last}}; ]
  ( sty.add_last (pos_i.pt - pt_b.pt - s)
    sty.add_last (b.to_int | 50000h)
  )
  
  - ind b:Boolean sub s:Int <-
  [ ? {sty.is_empty || {pos_i.pt - pt_b.pt - s >= sty.second_last}}; ]
  ( sty.add_last (pos_i.pt - pt_b.pt - s)
    sty.add_last ((b.to_int+2) | 50000h)
  )
  
  - jmp n:Int sub s:Int <-
  [ ? {sty.is_empty || {pos_i.pt - pt_b.pt - s >= sty.second_last}}; ]
  ( sty.add_last (pos_i.pt - pt_b.pt - s)
    sty.add_last (n | 60000h)
  )
  
  - utf n:Int sub s:Int <-
  [ ? {sty.is_empty || {pos_i.pt - pt_b.pt - s >= sty.second_last}}; ]
  ( sty.add_last (pos_i.pt - pt_b.pt - s)
    sty.add_last (n | 70000h)
  )
  
  - itm_cur:Int; //OK_ITM
  - itm n:Tok_itm sub s:Int <-
  [ ? {sty.is_empty || {pos_i.pt - pt_b.pt - s >= sty.second_last}}; ]
  ( sty.add_last (pos_i.pt - pt_b.pt - s)
    sty.add_last (n.to_pointer.to_int | 8000_0000h)
  )
  
  - get_col p:Int :Int <-
  ( + i,c,v:Int    
    {(i <= sty.upper) && {sty.at i <= p}}.while_do {
      v := sty.at (i+1)
      ((v >> 16) = 0).if {
        c := v
        //OUT # "  p=" # sty.at i # " col=" # c # '\n'
      }
      i := i + 2
    }
    c
  )
    
  - print_sty b:Int <-
  ( + f,n:Int32
    
    "-------------".println    
    from 0 to (sty.upper) step 2 do { i:Int
      Out # i # ": " # sty.at i # " (" # (b + sty.at i) # ") "
      f := sty.at (i+1)
      n := f & 0FFFFh
      (f >> 16)
      .when 0 then { // Color
        "Color: ".print; n.print; ' '.print
        n
        .when (Look.dead) then { "dead".print; }
        .when (Look.symbol) then { "symbol".print; }
        .when (Look.rmk) then { "rmk".print; }
        .when (Look.sub_rmk) then { "sub_rmk".print; }
        .when (Look.type) then { "type".print; }
        .when (Look.slot) then { "slot".print; }
        .when (Look.local) then { "local".print; }
        .when (Look.operator) then { "operator".print; }
        .when (Look.string) then { "string".print; }
        .when (Look.external) then { "external".print; }
        .when (Look.number) then { "number".print; }
        .when (Look.keyword) then { "keyword".print; }
      }
      .when 1 then { // Font
        "Font: ".print; n.print; ' '.print
        n
        .when (Font.roman)  then { "Roman".print; }
        .when (Font.bold)   then { "Bold".print; }
        .when (Font.italic) then { "Italic".print; }
        .when (Font.italic | Font.bold) then { "Bold/Italic".print; }
      }
      .when 2 then { // Size
        "Font size: ".print; n.print; ' '.print
        n
        .when 0 then { "Normal".print; }
        .when 1 then { "80%".print; }
        .when 2 then { "120%".print; }
      }
      .when 3 then { // Special character
        n
        .when 0 then { "Clone".print; }
      }
      
      .when 6 then {
        "Jump ".print; n.print
      }
      ((f >> 16) > 3).if { (f>>16).print; }
      '\n'.print
    }
    // crash
  )
    
  
