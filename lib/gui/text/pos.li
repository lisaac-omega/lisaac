Header
  + name := Flat Pos
- type    := `unsigned long long `;
  - default := (Cast Int To Pos.on 0);
  
  - export := Int;
  - import := Int;
  
Private
  
  - from_int i:Int :Self <- to_pos i
  - to_int:Int <- pt
  
  - to_raw:Int64 <- Cast Pos To Int64.on self
  - to_pos p:Int64 :Self <- Cast Int64 To Pos.on p
  
  - siz_pt_li:Int64 := 22
  - siz_pt:Int64 <- siz_pt_li + is_big.ok siz_tok or 0; // 4 MB 
  - lim_pt:Int64 <- (1.to_int64 << siz_pt) - 1
  - shl_pt:Int64 := 0
  - msk_pt:Int64 <- lim_pt << shl_pt

  - siz_tok:Int64 := 16; // 65 536
  - lim_tok:Int64 := (1.to_int64 << siz_tok) - 1
  - shl_tok:Int64 := shl_pt + siz_pt_li
  - msk_tok:Int64 := lim_tok << shl_tok
            
  - siz_x:Int64 := 14; // [0..16384]
  - lim_x:Int64 := (1.to_int64 << siz_x) - 1
  - shl_x:Int64 := shl_tok + siz_tok
  - msk_x:Int64 := lim_x << shl_x
  
  - siz_y:Int64 := 10; // [0..1023] * font_size
  - lim_y:Int64 := (1.to_int64 << siz_y) - 1
  - shl_y:Int64 := shl_x + siz_x
  - msk_y:Int64 := lim_y << shl_y
    
  - siz_ico:Int64 := 1
  - lim_ico:Int64 := (1.to_int64 << siz_ico) - 1
  - shl_ico:Int64 := 62
  - msk_ico:Int64 := lim_ico << shl_ico
    
  - siz_xy:Int64 := 1
  - lim_xy:Int64 := (1.to_int64 << siz_xy) - 1
  - shl_xy:Int64 := 63
  - msk_xy:Int64 := lim_xy << shl_xy
  
  - msk_cmp:Int64 := ~ (msk_x | msk_y)
  - msk_tok_ico:Int64 := msk_tok | msk_ico
  - msk_cmp2:Int64 := msk_ico | msk_tok | msk_pt
  
Public
  
  - undefine:Pos <- to_pos (-1)
  - is_undefine:Boolean <- to_raw = -1
  
  - undefine_xy:Pos <- to_pos (to_raw & ~(msk_x | msk_y))
  - is_undefine_xy:Boolean <- (to_raw & (msk_x | msk_y)) = 0
  
  - is_define_all:Boolean <- (!is_xy) && {!is_undefine_xy}
  
  - is_big:Boolean <- Tok_itm.txt_buf.upper >= 1 << siz_pt_li
    
  - is_ico:Boolean <- (!is_big) && {(to_raw & msk_ico) != 0}
  - is_xy:Boolean  <- (to_raw & msk_xy ) != 0
  
  - x:Real32 <- ((to_raw << (64-shl_x-siz_x)) >> (64-siz_x)).to_real32
  - y:Real32 <- ((to_raw >> shl_y) & lim_y).to_real32 * Font.size_app + Font.size_app*0.5
  
  - tok:Int <-
  [ ? {! is_big}; ]
  (to_raw >> shl_tok) & lim_tok
  
  - pt:Int <- to_raw & lim_pt
  
  - set_pt i:Int :Self <-
  to_pos ((to_raw & ~(msk_pt|msk_xy|msk_x|msk_y)) | (i << shl_pt))
  
  - div d:Div xy (px,py:Real32) :Self <-
  to_pos (d.pos.to_raw | msk_xy).set_xy (px,py)
  
  - new_ico n:Int :Self <-
  [ ? {! is_big}; ]
  to_pos (n | (Txt_buf.tok_cur << shl_tok) | msk_ico)
    
  - set_xy (px,py:Real32) :Self <-
  [ ? {py >= 0}; ]
  ( + xi,yi:Int64
    xi := px.to_int64;                   ? {xi < (lim_x>>1)}
    yi := (py / Font.size_app).to_int64; ? {yi < lim_y}
    ((xi = 0) && {yi = 0}).if { yi := 1; }; // Else undefine
    to_pos ((to_raw & ~(msk_x|msk_y)) | ((xi << shl_x) & msk_x) | (yi << shl_y))
  )
      
  - self:Self '-' Left 80 d:Int :Self <- set_pt (pt - d)
  - self:Self '+' Left 80 d:Int :Self <- set_pt (pt + d)
  
  - self:Self '>=' Right 60 d:Int :Boolean <- pt >= d
  - self:Self '<=' Right 60 d:Int :Boolean <- pt <= d
  - self:Self '>'  Right 60 d:Int :Boolean <- pt > d
  - self:Self '<'  Right 60 d:Int :Boolean <- pt < d
  
  - self:Self '=='  Right 60 o:Pos :Boolean <- (to_raw & msk_cmp) = (o.to_raw & msk_cmp)
  - self:Self '!==' Right 60 o:Pos :Boolean <- ! (self == o)
  
  - self:Self '==='  Right 60 o:Pos :Boolean <- (to_raw & msk_cmp2) = (o.to_raw & msk_cmp2)
  
  - in_range b:Int to e:Int :Boolean <- (!is_xy) && {pt.in_range b to e}
    
  - self:Self '~=' o:Pos :Boolean <-
  (( is_undefine_xy) && {o.pt >= pt}) || {(!is_undefine_xy) && {o.pt  = pt}}
  
  - self:Self '=|' o:Pos :Boolean <-
  (
    //pt.print; '='.print; o.pt.print; " ".print; x.print; "<=".print; o.x.println
    (pt = o.pt) && {(x <= o.x) || {(x > o.x) && {Txt_pg.last_div.width >= 0}}}
  )
    
  - inside d:Div :Boolean <-
  (
    //"\nDIV:".print; d.pos.print
    ((to_raw & msk_tok_ico) = (d.pos.to_raw & msk_tok_ico)) && {pt.in_range (d.pos) to (d.pte)}
  )
  
  - print <-
  (    
    (is_xy).if {
      "XY ".print
    } else {
      "PT ".print
    }
    (is_ico).if { "Tok:".print; tok.print; " #".print; }
    pt.print
    " (".print; x.print; ",".print; y.print; ")".println
  )
