Header
  + name := Tok_txt
Inherit
  + parent_tok_drw:Flat Tok_drw
  
Private
  - stk:Flat Array (Exact Tok_txt)
  
Public
     
  - new:Self <-
  ( + r:Self; (stk.is_empty).if { r := clone; } else { r := stk.pop; }; r)
  
  - begin_draw <-
  (    
    fill_color (Look.none)
  )
    
  - detect:Boolean <- True
  
  - parse <-
  (    
    skip_until '\n'
    (at pos_i = '\n').if { nl := nl + 1; pos_i := pos_i + 1; }
  )
    
  - free <- stk.add_last self
