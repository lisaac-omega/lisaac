Header
  + name := Hand
Inherit
  - parent_utils:Utils := Utils
  
Private
  - delay:Uint64 := 200_000; // 0.2 s
  - delay_clic:Uint64 := 500_000; // 0.5 s
  - is_drag:Uint8
  - timestamp:Uint64
  - last_clic:Uint64
  
  - set_win_cur w:Win :Boolean <-
  (w != win_cur).if {
    (win_cur != NULL).if { win_cur.event out; }
    win_cur := w
    (win_cur != NULL).if { win_cur.event  in; }
  }
  
Public
  - ray:Real32 := 16
    
  - move:Uint8  := 0_0000b
  
  - in:Uint8    := 0_0010b
  - out:Uint8   := 0_0011b
  
  - clic:Uint8  := 0_0100b; // Standard click
  - lclic:Uint8 := 0_0101b; // Long click (right most bit)
  
  - drag:Uint8  := 0_1000b; // Quick drag
  - ldrag:Uint8 := 0_1001b; // Long click then drag (right most bit)
  
  - clic2:Uint8 := 1_0000b; // Click right
//  - dclic:Uint8 := 1_0001b; // Double clic

  - nb_clic:Int

  + is_begin:Boolean
  + is_end:Boolean
  
  - dx:Real32 <- x_cur - x_last
  - dy:Real32 <- y_cur - y_last
  
  - ldx:Real32 <- x_cur - x_start
  - ldy:Real32 <- y_cur - y_start
  
  - window_cur:Window
  - win_cur:Win
  - x_cur:Real32
  - y_cur:Real32
  - press_cur:Boolean
  
  - x_begin:Real32
  - y_begin:Real32
  
  - x_last:Real32
  - y_last:Real32
  
  - destroy_window w:Window <-
  ( 
    window_cur := NULL
    win_cur := NULL
  )
  
  - set_ptr (w:Window) xy (x,y:Int) <-  
  ( + xx,yy:Real32
    (x_cur,y_cur,window_cur) := (x.to_real32,y.to_real32,w)
    (press_cur).if {
      (is_drag = 0).if {
        (xx,yy) := (x_cur - x_begin, y_cur - y_begin)
        ((xx*xx + yy*yy).sqrt > ray).if {
          is_drag := drag + (Time.gettimeofday - timestamp > delay).to_int
          (x_last,y_last) := (x_begin,y_begin)
          is_begin := True
          set_win_cur (depth_send is_drag)
          is_begin := False
        }
      } else {
        (win_cur != NULL).if { /*depth_*/send is_drag; }; // Send
      }
      (x_last,y_last) := (x_cur,y_cur)
    } else {      
      ((!set_win_cur (w.get_win (x,y))) && {win_cur != NULL}).if { depth_send move; }
    }
  )
  
  - set_ptr (w:Window) press (n:Int,p:Boolean) <-
  ( + t:Uint64
    (window_cur != w).if {
      (x_cur,y_cur) := Paper.get_cursor_pos (w.win_ptr)
      x_cur := x_cur.max 0.min (w.xmax)
      y_cur := y_cur.max 0.min (w.ymax)
      window_cur := w
    }
    n
    .when 0 then {
      t := Time.gettimeofday
      ((! press_cur) && {p}).if {        
        set_win_cur (w.get_win (x_cur,y_cur))
        (x_begin,y_begin,timestamp) := (x_cur,y_cur,t)
      }.elseif {press_cur && {!p}} then {
        (is_drag = 0).if {
          set_win_cur (w.get_win (x_cur,y_cur))
          (t - last_clic < delay_clic).if { nb_clic := nb_clic + 1; } else { nb_clic := 0; }
          last_clic := t
          depth_send (clic + (t - timestamp > delay).to_int)
        } else {
          (win_cur != NULL).if {
            is_end := True; /*depth_*/send is_drag; is_end := False; // send
          }
          is_drag := 0
        }
      }
      press_cur := p
    }
    .when 1 then {
      (!p).if { depth_send clic2; }
    }
  )
  
  - acts:Flat Array Act
  
  - add_act a:Act <- acts.add_last a
  
  - run n:String_alias <-
  ( + i:Int
    {(i <= acts.upper) && {acts.at i.text_r != n}}.while_do { i := i + 1; }
    ((i > acts.upper) || {! acts.at i.run}).if { Any.beep; }
  )
  
Private
  
  - last_ev:Uint8
  
  - send e:Uint8 :Boolean <-
  ( + r:Boolean
    last_ev := e
    (win_cur != NULL).if { r := win_cur.event e; }
    r
  )
  
  - depth_send e:Uint8 :Win <-
  ( + r:Win
    last_ev := e    
    (win_cur != NULL).if { r := win_cur.depth_event e; }
    r
  )
