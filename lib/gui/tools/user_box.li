Header
  + name := Exact User_box
Inherit
  + parent_gobj:Flat Gobj User_box
  
Private
  - stk:Flat Array User_box
  
Public
  
  + width_min:Real32
  + height_min:Real32
  
  + drw:{User_box;}
  + evt:{(User_box,Uint8); Boolean}
  
  - new:Self <-
  ( + r:Self; (stk.is_empty).if { r := clone; } else { r := stk.pop; }; r)
  
  - free <- stk.add_last self
  
  - init (w,h:Real32) draw d:{User_box;} :Self <-
  init (w,h) draw d event {(d:User_box,e:Uint8); False}
  
  - init (w,h:Real32) draw d:{User_box;} event e:{(User_box,Uint8);Boolean} :Self <-
  (
    (width_min,height_min) := (width,height) := (w,h)
    (drw,evt) := (d,e)
    init_obj
  )
    
  - draw <- drw.value self
  
  - event ev:Uint8 :Boolean <- evt.value (self,ev)
