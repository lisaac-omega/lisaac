Header
  + name := Button
Inherit
  + parent_gobj:Flat Gobj Button
  
Private
  
  - stk:Flat Array (Exact Button)
  
Public
    
  - new:Self <-
  ( + r:Self; (stk.is_empty).if { r := clone; } else { r := stk.pop; }; r)
  - free <- stk.add_last self
  
  - margin:Int := 8
  
  - mute:Int  := 1 << 15
  - barre:Int := 1 << 16
  - dark:Int  := 1 << 17
  - light:Int := 1 << 18
  - nobackground:Int := 1 << 19
  
  - check:Int := 1 << 20
  - radio:Int := 1 << 21
    
  + txt:String_alias
  + act:{Button;Boolean}
  + get_case:{Button;Boolean}
  
  - set_check b:{Button;Boolean} :Self <- ( get_case := b; set check)
  - set_radio b:{Button;Boolean} :Self <- ( get_case := b; set radio)
  
  - set_txt t:String_alias <- ( txt := t; )
  
  - width_min:Real32 <-
  ( + x0,y0,x1,y1,wt,s:Real32
    font_face_id (Font.sys (Font.bold))
    s := Font.size_sys*zom
    font_size s
    (wt,x0,y0,x1,y1) := text_bounds (0,0) msg txt
    wt + margin*2 + ((is radio) || {is check}).ok s or 0
  )
    
  - height_min:Real32 <- (Font.size_sys + margin*2)
   
  - init t:String_alias do d:{Button;Boolean} :Self <-
  (
    (act,txt) := (d,t)
    set align_center
    init_obj
  )
  
  - draw <-
  ( + y,x,w,s,r:Real32
    + c:Color
    //draw_debug    
    (is inside).if {
      fill_color (Look_gui.border_on)
    } else {      
      (is light).if {
        fill_color (Look_gui.border_on) //(COLOR.rgb(200,200,200))
      } else {
        fill_color (Look_gui.border_off); //COLOR.rgba (0,0,0,10))
      }
    }
    (! is nobackground).if {
      begin_path
      rect (xo,yo) size (width, height) radius 8
      fill
    }
    //
    ((is mute) || {is dark}).if {
      c := (col=Color).ok (Look_gui.text_bg_ui) else {col.set_af 0.3}
    } else {
      c := (col=Color).ok (Look_gui.text_ui) or col
    }
    y := yo + height/2
    (is align_left).if {
      x := xo
    }.elseif {is align_right} then {
      x := xmax - width_min
    } else {
      x := xo + (width - width_min)/2
    }
    x := x + margin
    s := Font.size_sys*zom
    fill_color c
    ((is radio) || {is check}).if {
      begin_path
      stroke_color c
      stroke_width 2.0
      r := s / 2 - 5
      //
      (is radio).if {
        circle (x+r,y) radius r
        stroke
        (get_case.value self).if {
          begin_path
          circle (x+r,y) radius (r-4)
          fill
        }
      } else {
        rect (x, y - r) size (r * 2, r * 2)
        (get_case.value self).if {
          line (x, y - r) to (x + r * 2, y + r)
          line (x + r * 2, y - r) to (x, y + r)
        }
        stroke
      }
      x := x + s
    }
    font_face_id (Font.sys (is inside.ok (Font.bold) or (Font.roman)))
    font_size s
    text_align (align_left | align_middle)
    w := text (x,y) msg txt - x
    //
    (is barre).if {      
      begin_path
      stroke_width (zom*3)
      stroke_color (Color.rgba (0,0,0,128))
      line (x,y) to (x+w,y)
      stroke
    }    
  )
  
  - event ev:Uint8 :Boolean <-
  ( + e:Uint8
    e := ev & ~1
    (is mute).if {
      // Nothing.
    }.elseif {e = Hand.in} then {
      set inside with (ev = Hand.in)
    }.elseif {e = Hand.clic} then {
      //"Act:".print; act.text_l.println
      //MENU.close_all_except act
      act.value self.if_false { beep; }
    }
  )
