Header
  + name := Itk
Public
  
  - map_col:C_array Uint8 := C_array Uint8.create 4
  
  - tmp_cap:Int
  - tmp:C_array Uint8
  
  - gauss_size:Int
  - gauss_sigma:Real64 := 1.5
  - gauss:C_array Int
  - gauss_sum:Int
  
  - update_gaussian sz:Int sigma sig:Real64 <-
  [ ? {sz.is_odd}; ]
  ( + x,y,hsz,k,sum:Int
    + v,sig2:Real64
    + scal,vi,none:Int
    + ker:C_array Int
    scal := 1000
    hsz := sz / 2
    sig2 := sig * sig * 2
    (ker,none) := C_array Int.update_size (gauss,gauss_size*gauss_size) new (sz*sz)
    gauss := ker
    gauss_size := sz
    gauss_sigma := sig
    0.to (sz-1) do { i:Int
      0.to (sz-1) do { j:Int
        x := i - hsz
        y := j - hsz
        v := (-(x * x + y * y).to_real64 / sig2).exp / (Real64.pi * sig2)
        vi := (v * scal + 0.5).to_int
        ker.at k put vi
        sum := sum + vi
        k := k + 1
      }
    }
    gauss_sum := sum
  )
  
  - variance src:C_array Uint8 width w:Int to (p:Int) dim s:Int :(Uint8,Real64) <-
  ( + var,v:Real64
    + mean:Uint8
    + cnt,k,ky,hs,pb,sum:Int
    cnt := s*s
    hs := s / 2
    // Sum:
    ky := pb := p - hs*w - hs
    s.times { 
      k := ky
      s.times {
        sum := sum + src.at k
        k := k + 1
      }
      ky := ky + w
    }
    mean := sum / cnt
    // Variance:
    ky := pb
    s.times {
      k := ky
      s.times {
        v := src.at k.to_real64 - mean.to_real64
        var := var + v*v
        k := k + 1
      }
      ky := ky + w
    }
    var := var / cnt
    mean,var
  )
  
  - border src:C_array Uint8 size (w,h:Int) w b:Int <-
  ( + o1,o2,oup,obo:Int
    o2 := w*h-1
    oup := w*b
    obo := o2-oup
    b.times {
      b.times {
        src.at o1 put (src.at (oup+b))
        src.at o2 put (src.at (obo-b))
        o2 := o2 - 1
        o1 := o1 + 1
      }
      b.to (w-b-1) do { x:Int
        src.at o1 put (src.at (oup+x))
        src.at o2 put (src.at (obo-x))
        o2 := o2 - 1
        o1 := o1 + 1
      }
      b.times {
        src.at o1 put (src.at (oup+(w-b-1)))
        src.at o2 put (src.at (obo-(w-b-1)))
        o2 := o2 - 1
        o1 := o1 + 1
      }
    }
    (h-b*2).times { 
      0.to (b-1) do { x:Int
        src.at (o1+x) put (src.at (o1+b))
        src.at (o2-x) put (src.at (o2-b))
      }
      o1 := o1 + w
      o2 := o2 - w
    }
  )
    
  - border4 src:C_array Uint8 size (w,h:Int) w b:Int <-
  ( + o1,o2,oup,obo,xx:Int
    o2 := w*h-1
    oup := w*b
    obo := o2-oup
    b.times {
      0.to (w-1) do { x:Int
        xx := x.max b.min (w-b-1)
        src.copy ((oup+xx)*4) n 4 to (o1*4)
        src.copy ((obo-xx)*4) n 4 to (o2*4)
        o2 := o2 - 1
        o1 := o1 + 1
      }
    }
    (h-b*2).times { 
      0.to (b-1) do { x:Int
        src.copy ((o1+b)*4) n 4 to ((o1+x)*4)
        src.copy ((o2-b)*4) n 4 to ((o2-x)*4)
      }
      o1 := o1 + w
      o2 := o2 - w
    }
  )
  
  - circle_full src:C_array Uint8 size (w,h:Int) to (xc, yc:Int) ray r:Int col c:Uint8 <-
  ( + x,y,d,o:Int
    y := r
    d := 3 - 2 * r
    {x <= y}.while_do {
      ((yc + y).in_range 0 to (h-1)).if {
        o := (yc+y) * w
        ((xc-x).max 0).to ((xc+x).min (w-1)) do { i:Int; src.at (o+i) put c; }
      }
      ((yc - y).in_range 0 to (h-1)).if {
        o := (yc-y) * w
        ((xc-x).max 0).to ((xc+x).min (w-1)) do { i:Int; src.at (o+i) put c; }
      }
      ((yc + x).in_range 0 to (h-1)).if {
        o := (yc+x) * w
        ((xc-y).max 0).to ((xc+y).min (w-1)) do { i:Int; src.at (o+i) put c; }
      }
      ((yc - x).in_range 0 to (h-1)).if {
        o := (yc-x) * w
        ((xc-y).max 0).to ((xc+y).min (w-1)) do { i:Int; src.at (o+i) put c; }
      }
      (d < 0).if {
        d := d + 4 * x + 6
      } else {
        d := d + 4 * (x - y) + 10
        y := y - 1
      }
      x := x + 1
    }
  )
  
  - circle_msk src:C_array Uint8 size (w,h:Int) to (xc, yc:Int) ray r:Int col c:Uint8 <-
  ( + x,y,d,o:Int
    y := r
    d := 3 - 2 * r
    {x <= y}.while_do {
      ((yc + y).in_range 0 to (h-1)).if {
        o := (yc+y) * w
        ((xc-x).max 0).to ((xc+x).min (w-1)) do { i:Int
          (src.at (o+i) != 0).if { src.at (o+i) put c; }
        }
      }
      ((yc - y).in_range 0 to (h-1)).if {
        o := (yc-y) * w
        ((xc-x).max 0).to ((xc+x).min (w-1)) do { i:Int
          (src.at (o+i) != 0).if { src.at (o+i) put c; }
        }
      }
      ((yc + x).in_range 0 to (h-1)).if {
        o := (yc+x) * w
        ((xc-y).max 0).to ((xc+y).min (w-1)) do { i:Int
          (src.at (o+i) != 0).if { src.at (o+i) put c; }
        }
      }
      ((yc - x).in_range 0 to (h-1)).if {
        o := (yc-x) * w
        ((xc-y).max 0).to ((xc+y).min (w-1)) do { i:Int
          (src.at (o+i) != 0).if { src.at (o+i) put c; }
        }
      }
      (d < 0).if {
        d := d + 4 * x + 6
      } else {
        d := d + 4 * (x - y) + 10
        y := y - 1
      }
      x := x + 1
    }
  )
    
  - line src:C_array Uint8 size (w,h:Int) from (x0,y0:Int) to (x1,y1:Int) width r:Int col c:Uint8 <-
  ( + dx,dy,sx,sy,d,x,y:Int
    + swap:Boolean
    (dx,dy) := ((x1 - x0).abs, (y1 - y0).abs)
    sx := (x1 > x0).ok 1 or (-1)
    sy := (y1 > y0).ok 1 or (-1)
    (dy > dx).if {
      (dx,dy) := (dy,dx)
      swap := True
    }
    d := 2 * dy - dx
    (x,y) := (x0,y0)
    0.to dx do { i:Int
      circle_full src size (w,h) to (x, y) ray r col c
      (d > 0).if { 
        (swap).if { x := x + sx; } else { y := y + sy; }
        d := d - 2 * dx
      }
      (swap).if { y := y + sy; } else { x := x + sx; }
      d := d + 2 * dy
    }
  )
  
  - line_msk src:C_array Uint8 size (w,h:Int) from (x0,y0:Int) to (x1,y1:Int) width r:Int col c:Uint8 <-
  ( + dx,dy,sx,sy,d,x,y:Int
    + swap:Boolean
    (dx,dy) := ((x1 - x0).abs, (y1 - y0).abs)
    sx := (x1 > x0).ok 1 or (-1)
    sy := (y1 > y0).ok 1 or (-1)
    (dy > dx).if {
      (dx,dy) := (dy,dx)
      swap := True
    }
    d := 2 * dy - dx
    (x,y) := (x0,y0)
    0.to dx do { i:Int
      circle_msk src size (w,h) to (x, y) ray r col c
      (d > 0).if { 
        (swap).if { x := x + sx; } else { y := y + sy; }
        d := d - 2 * dx
      }
      (swap).if { y := y + sy; } else { x := x + sx; }
      d := d + 2 * dy
    }
  )
  
  
Public
  - line src:C_array Uint8 size (w,h:Int)
  from (x0,y0:Int) to (x1,y1:Int) col3 (r,g,b:Uint8) <-
  ( + dx,dy,sx,sy,d,x,y,o:Int
    + swap:Boolean
    (dx,dy) := ((x1 - x0).abs, (y1 - y0).abs)
    sx := (x1 > x0).ok 1 or (-1)
    sy := (y1 > y0).ok 1 or (-1)
    (dy > dx).if {
      (dx,dy) := (dy,dx)
      swap := True
    }
    d := 2 * dy - dx
    (x,y) := (x0,y0)
    0.to dx do { i:Int
      o := (y*w + x) << 2
      src.at (o+0) put r; src.at (o+1) put g; src.at (o+2) put b; src.at (o+3) put 255
      (d > 0).if { 
        (swap).if { x := x + sx; } else { y := y + sy; }
        d := d - 2 * dx
      }
      (swap).if { y := y + sy; } else { x := x + sx; }
      d := d + 2 * dy
    }
  )
  
  - line src:C_array Uint8 size (w,h:Int)
  from (x0,y0:Int) to (x1,y1:Int) col c:Uint8 <-
  ( + dx,dy,sx,sy,d,x,y,o:Int
    + swap:Boolean
    (dx,dy) := ((x1 - x0).abs, (y1 - y0).abs)
    sx := (x1 > x0).ok 1 or (-1)
    sy := (y1 > y0).ok 1 or (-1)
    (dy > dx).if {
      (dx,dy) := (dy,dx)
      swap := True
    }
    d := 2 * dy - dx
    (x,y) := (x0,y0)
    0.to dx do { i:Int
      o := y*w + x
      src.at o put c
      (d > 0).if { 
        (swap).if { x := x + sx; } else { y := y + sy; }
        d := d - 2 * dx
      }
      (swap).if { y := y + sy; } else { x := x + sx; }
      d := d + 2 * dy
    }
  )
  
  - rect img:C_array Uint8 size (w,h:Int) rect (x0,y0,x1,y1:Int) col c:Uint8 <-
  ( + o:Int
    o := y0*w
    (y1-y0 + 1).times {
      o := o + x0
      ? {o%w = x0}
      (x1-x0 + 1).times {
        img.at o put c
        o := o + 1
      }
      ? {o%w = x1+1}
      o := o + (w-x1-1)
      ? {o%w = 0}
    }
    ? {o = (y1+1)*w}
  )
  
  - cadre img:C_array Uint8 size (w,h:Int) rect (x0,y0,x1,y1:Int) col3 (r,g,b:Uint8) <-
  ( + o0,o1:Int
    o0 := (y0*w + x0)*4
    o1 := (y1*w + x1)*4
    (x1-x0+1).times {
      img.at (o0+0) put r; img.at (o0+1) put g; img.at (o0+2) put b
      img.at (o1+0) put r; img.at (o1+1) put g; img.at (o1+2) put b
      o0 := o0 + 4; o1 := o1 - 4
    }
    (y1-y0+1).times {
      img.at (o0+0) put r; img.at (o0+1) put g; img.at (o0+2) put b
      img.at (o1+0) put r; img.at (o1+1) put g; img.at (o1+2) put b
      o0 := o0 + w*4; o1 := o1 - w*4
    }
  )
  
  - crop img:C_array Uint8 size (w,h:Int) rect (x0,y0,x1,y1:Int) <-
  ( + o:Int
    + c:Uint8
    c := 0
    (y0*w).times {
      img.at o put c
      o := o + 1
    }
    ? {o = y0*w}
    (y1-y0 + 1).times {
      x0.times {
        img.at o put c
        o := o + 1
      }
      ? {o%w = x0}
      o := o + (x1-x0 + 1)
      ? {o%w = x1+1}
      (w-x1-1).times {
        img.at o put c
        o := o + 1
      }
      ? {o%w = 0}
    }
    ? {o = (y1+1)*w}
    ((h-y1-1)*w).times {
      img.at o put c
      o := o + 1
    }
    ? {o = w*h}
  )
  
  - norm src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) rect (x0,y0,x1,y1:Int) <-
  // Src = dst ok
  ( + min,max,oy,ox,c,d:Int
    min := 255; max := 0
    oy := y0*w + x0
    y0.to y1 do { y:Int
      ox := oy
      x0.to x1 do { x:Int
        c := src.at ox
        (c < min).if { min := c; }
        (c > max).if { max := c; }
        ox := ox + 1
      }
      oy := oy + w
    }
    d := max - min
    //
    (d != 0).if {
      oy := y0*w + x0
      y0.to y1 do { y:Int
        ox := oy
        x0.to x1 do { x:Int
          c := src.at ox
          c := clamp ((255*(c-min)) / d)
          dst.at ox put c
          ox := ox + 1
        }
        oy := oy + w
      }
    }
  )
  
  - rot4 src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) <-
  ( + os,ody,odx:Int
    odx := (w-1)*(h*4)
    h.times {
      ody := odx
      w.times {
        dst.at (ody+0) put (src.at os); os := os + 1
        dst.at (ody+1) put (src.at os); os := os + 1
        dst.at (ody+2) put (src.at os); os := os + 1
        dst.at (ody+3) put (src.at os); os := os + 1
        ody := ody - h*4
      }
      odx := odx + 4
    }
  )
  
  - var_r32 src:Array Real32 :Real32 <-
  ( + sum,mean:Real64
    src.foreach { r:Real32; sum := sum + r; ? {r.in_range 0 to 1}; }
    mean := sum / src.count
    sum := 0
    src.foreach { r:Real32; sum := sum + (r-mean)*(r-mean); }
    (sum / src.count).sqrt
  )

  - clamp c:Int :Uint8 <-
  ( + r:Uint8
    (c >= 255).if {
      r := 255
    } else {
      (c > 0).if { r := c.to_uint8; }
    }
    r
  )
  
  - print_gaussian <-
  (
    0.to (gauss_size-1) do { y:Int
      0.to (gauss_size-1) do { x:Int
        gauss.at (y*gauss_size+x).print_format 3; ' '.print
      }
      '\n'.print
    }
  )
  
Public
  
  - x1_white s:C_array Uint8 to d:C_array Uint8 size (w,h:Int) <-
  // s = d : ok
  ( + r,g,b:Int
    + c:Uint8
    0.to (w*h*4) by 4 do { i:Int
      (r,g,b) := (s.at i,s.at (i+1),s.at (i+2))
      ((r,g,b) = (255,255,255)).if { c := 255; } else { c := 0; }
      d.at (i>>2) put c
    }
  )
  
  - x1 s:C_array Uint8 to d:C_array Uint8 size (w,h:Int) <-
  // s = d : ok
  ( + r,g,b:Int
    + c:Uint8
    0.to (w*h*4-1) by 4 do { i:Int
      (r,g,b) := (s.at i,s.at (i+1),s.at (i+2))
      //c := (r+g+b)/3
      c := (77 * r + 150 * g + 29 * b) >> 8
      d.at (i>>2) put c
    }
  )
  
  - r1 s:C_array Uint8 to d:C_array Real32 size (w,h:Int) <-
  ( + c:Real32
    0.to (w*h-1) do { i:Int
      c := s.at i.to_real32 / 255.0
      d.at i put c
    }
  )
  
  - x4 s:C_array Uint8 to d:C_array Uint8 size (w,h:Int) <-
  // s = d Ok
  ( + j:Int
    + c:Uint8
    j := w*h*4
    (w*h-1).downto 0 do { i:Int
      c := s.at i
      j := j - 1; d.at j put 255
      j := j - 1; d.at j put c
      j := j - 1; d.at j put c
      j := j - 1; d.at j put c
    }
  )
  
  - neg s:C_array Uint8 to d:C_array Uint8 size (w,h:Int) <-
  // s = d : ok
  ( + c:Uint8
    0.to (w*h-1) do { i:Int
      c := s.at i
      d.at i put (255-c)
    }
  )
  
  - rgba (r,g,b,a:Uint8) src s:C_array Uint8 to d:C_array Uint8 size (w,h:Int) <-
  // s = d Ok
  ( + j:Int
    + c:Uint8
    j := w*h*4
    (w*h-1).downto 0 do { i:Int
      c := s.at i
      (c != 0).if {
        j := j - 1; d.at j put a
        j := j - 1; d.at j put b
        j := j - 1; d.at j put g
        j := j - 1; d.at j put r
      } else {
        j := j - 1; d.at j put 255
        j := j - 1; d.at j put 0
        j := j - 1; d.at j put 0
        j := j - 1; d.at j put 0
      }
    }
  )
  
  - resize src:C_array Uint8 size (sw,sh:Int) to dst:C_array Uint8 size (dw,dh:Int) <-
  // src = dst Ok if (sw,sh) >= (ds,dh)
  [ ? {(src != dst) || {(sw >= dw) && {sh >= dh}}}; ]
  ( + dx,dy,px,py,i:Int
    dx := (sw << 16) / dw
    dy := (sh << 16) / dh
    0.to (dh-1) do { y:Int
      px := ((py >> 16) * sw) << 16
      0.to (dw-1) do { x:Int
        dst.at i put (src.at (px >> 16))
        px := px + dx
        i := i + 1
      }
      py := py + dy
    }
  )
  
  - resize4 src:C_array Uint8 size (sw,sh:Int)
  to dst:C_array Uint8 size (dw,dh:Int) <-
  // src = dst Ok if (sw,sh) >= (ds,dh)
  [ ? {(src != dst) || {(sw >= dw) && {sh >= dh}}}; ]
  ( + dx,dy,px,py,i,os:Int
    dx := (sw << 16) / dw
    dy := (sh << 16) / dh
    0.to (dh-1) do { y:Int
      px := ((py >> 16) * sw) << 16
      0.to (dw-1) do { x:Int
        os := (px >> 16) << 2
        //
        dst.at i put (src.at (os+0)); i := i + 1
        dst.at i put (src.at (os+1)); i := i + 1
        dst.at i put (src.at (os+2)); i := i + 1
        dst.at i put (src.at (os+3)); i := i + 1
        //
        px := px + dx
      }
      py := py + dy
    }
  )
  
  - mask src:C_array Uint8 size (w,h:Int) with msk:C_array Uint8 size (mw,mh:Int) <-
  [ ? {src != msk}; ] 
  ( + dx,dy,px,py,i:Int
    + c:Uint8
    dx := (mw << 16) / w
    dy := (mh << 16) / h
    0.to (h-1) do { y:Int
      px := ((py >> 16) * mw) << 16
      0.to (w-1) do { x:Int
        c := msk.at (px >> 16)
        (c = 0).if { src.at i put 0; }
        px := px + dx
        i := i + 1
      }
      py := py + dy
    }
  )
  
  - redmask src:C_array Uint8 size (w,h:Int) with msk:C_array Uint8 size (mw,mh:Int) <-
  [ ? {src != msk}; ] 
  ( + dx,dy,px,py,i:Int
    + c:Uint8
    dx := (mw << 16) / w
    dy := (mh << 16) / h
    0.to (h-1) do { y:Int
      px := ((py >> 16) * mw) << 16
      0.to (w-1) do { x:Int
        c := msk.at (px >> 16)
        (c != 0).if {
          src.at (i<<2) put (clamp (src.at (i<<2).to_int + 60))
        }
        px := px + dx
        i := i + 1
      }
      py := py + dy
    }
  )
  /*
  - copy src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) dim t:Int <-
  (
    
  );*/
  
  - set src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) col c:Color <-
  ( + r,g,b:Uint8
    + j:Int
    (r,g,b) := (c.ri,c.gi,c.bi)
    0.to (w*h-1) do { i:Int
      (src.at i = 255).if {
        dst.at (j+0) put r; dst.at (j+1) put g
        dst.at (j+2) put b; dst.at (j+3) put 255
      }
      j := j + 4
    }
  )
  
  - clean4 src:C_array Uint8 mask msk:C_array Uint8 size (w,h:Int) color (r,g,b:Uint8) select c:Uint8 <-
  ( + j:Int
    0.to (w*h-1) do { i:Int
      (msk.at i = c).if {
        src.at (j+0) put r
        src.at (j+1) put g
        src.at (j+2) put b
      }
      j := j + 4
    }
  )
  
  - sobel src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) <-
  // Src != dst
  [ ? {src != dst}; ]
  ( + sumx,sumy,i:Int
    + c0,c1,c2,c3,c5,c6,c7,c8,c:Int
    0.to (w-1) do { x:Int; dst.at i put 0; i := i + 1; }
    1.to (h-2) do { y:Int
      dst.at i put 0; i := i + 1
      1.to (w-2) do { x:Int
        c0 := src.at (i-w-1); c1 := src.at (i-w); c2 := src.at (i-w+1)
        c3 := src.at (i-1);                       c5 := src.at (i+1)
        c6 := src.at (i+w-1); c7 := src.at (i+w); c8 := src.at (i+w+1)
        sumx := -c0 + c2 - c3*2 + c5*2 - c6 + c8
        sumy := -c0 - c1*2 - c2 + c6 + c7*2 + c8
        c := (sumx * sumx + sumy*sumy).sqrt
        dst.at i put (clamp c)
        i := i + 1
      }
      dst.at i put 0; i := i + 1
    }
    ? {i = (h-1)*w}
    0.to (w-1) do { x:Int; dst.at i put 0; i := i + 1; }
    //border dst size (w,h) w 1
  )
  
  - sobel src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int)
  rect (x0,y0,x1,y1:Int) <-
  // Src != dst
  [ ? {src != dst}; ]
  ( + sumx,sumy,i:Int
    + c0,c1,c2,c3,c5,c6,c7,c8,c:Int
    (y0+1).to (y1-1) do { y:Int
      (x0+1).to (x1-1) do { x:Int
        i := y*w+x
        c0 := src.at (i-w-1); c1 := src.at (i-w); c2 := src.at (i-w+1)
        c3 := src.at (i-1);                       c5 := src.at (i+1)
        c6 := src.at (i+w-1); c7 := src.at (i+w); c8 := src.at (i+w+1)
        sumx := -c0 + c2 - c3*2 + c5*2 - c6 + c8
        sumy := -c0 - c1*2 - c2 + c6 + c7*2 + c8
        c := (sumx * sumx + sumy*sumy).sqrt
        dst.at i put (clamp c)
      }
    }
  )

  
  - sobel src:C_array Real32 size (w,h:Int)
  at (x,y:Int) size (bw,bh:Int) :(Real32,Real32) <-
  ( + i,i0:Int
    + c0,c1,c2,c3,c5,c6,c7,c8:Real32
    + sumx,sumy,c,c_mx,sumx_mx,sumy_mx,a:Real32
    /*
    i0 := y*w + x
    0.to (bh-1) do { y:Int
      i := i0
      0.to (bw-1) do { x:Int
        c := c + src.at i
        i := i + 1
      }
      i0 := i0 + w
    }
    m := c / (bh*bw)
    */
    i0 := y*w + x
    1.to (bh-2) do { y:Int
      i0 := i0 + w
      i := i0 + 1
      1.to (bw-2) do { x:Int
        c0 := src.at (i-w-1); c1 := src.at (i-w); c2 := src.at (i-w+1)
        c3 := src.at (i-1);                       c5 := src.at (i+1)
        c6 := src.at (i+w-1); c7 := src.at (i+w); c8 := src.at (i+w+1)
        /*
        c0 := (c0 < m).ok 0 or 1; c1 := (c1 < m).ok 0 or 1
        c2 := (c2 < m).ok 0 or 1; c3 := (c3 < m).ok 0 or 1
        c5 := (c5 < m).ok 0 or 1; c6 := (c6 < m).ok 0 or 1
        c7 := (c7 < m).ok 0 or 1; c8 := (c8 < m).ok 0 or 1
        */
        sumx := -c0 + c2 - c3*2 + c5*2 - c6 + c8
        sumy := -c0 - c1*2 - c2 + c6 + c7*2 + c8
        c := sumx * sumx + sumy*sumy
        (c > c_mx).if {
          (c_mx, sumx_mx,sumy_mx) := (c, sumx,sumy)
        }
        i := i + 1
      }
    }
    a := sumy_mx.atan2 sumx_mx; // [-pi;+pi]
    (a < 0).if { a := a + Real32.pi; }; // [-pi;+pi] => [0;+pi]
    a := a + Real32.pi/2
    (a > Real32.pi).if { a := a - Real32.pi; }
    c_mx.sqrt, a
  )
  
  - thresholding src:C_array Uint8 to dst:C_array Uint8
  size (w,h:Int) limit l:Int set (c0,c1:Uint8) <-
  // src = dst Ok
  ( + c:Uint8
    0.to (w*h-1) do { i:Int
      c := src.at i
      (c < l).if { c := c0; } else { c := c1; }
      dst.at i put c
    }
  )
  
  //- err:Flat ARRAY Int
  
  - contour img:C_array Uint8 size (w,h:Int) in pt:Array Int
  rect (x0,y0,x1,y1:Int) :(String_alias,Int,Int /*,Int,Int,Int,Int*/) <-
  // min=16 default
  // Ben Inside
  ( + n,m,p,p1,dx,dy,lim,cpt,x,ymax,ymin,out_x,out_y,pbeg,bug:Int
    //+ xx0,yy0,xx1,yy1:Int
    + c:Uint8
    + out:Boolean
    + res:String_alias
    
    // @n direction :
    //    111(7) 000(0) 001(1)
    //       \    |    /
    // 110(6) ----|----> 010(2)
    //       /    V    \
    //    101(5) 100(4) 011(3)    
    pbeg := p := pt.first
    (img.at (p+1) != 0).if   { n := 010b; }.elseif
    {img.at (p-1) != 0} then { n := 110b; }.elseif
    {img.at (p+w) != 0} then { n := 100b; }
    //"Begin: ".print; x.print; ','.print; y.println
    lim := (w+h)*4; // Limit force stop algo -> Error
    (ymin,ymax) := (y0*w,y1*w)
    m := n
    {
      n := (n-3) & 111b
      cpt := 0
      {
        n := (n + 1) & 111b
        // Compute dx,dy
        (((n+2) & 11b) != 0).if { dx := (((n+2) & 100b) = 0).ok (+1) or (-1); } else { dx := 0; }
        (( n    & 11b) != 0).if { dy := (( n    & 100b) = 0).ok (+w) or (-w); } else { dy := 0; }
        p1 := p + dx + dy
        c := img.at p1
        cpt := cpt + 1
      }.do_while {(c != 0) && {cpt<8}}
      x := p1 % w
      ((x <= x0) || {x >= x1} || {p1 < ymin} || {p1 >= ymax}).if {
        out := True
        (out_x,out_y) := (x,p1/w)
      }
      //
      ((dy != 0) && {n&100b != m&100b}).if {
        (pt.last = p).if { pt.remove_last; /*"S0 ".print*/  } else { pt.add_last p; /*"+0 ".print*/ }
      }
      p := p1
      (dy != 0).if {
        pt.add_last p
        //"+1 ".print
        m := n
      } else {
        (
          ((n = 0) && {m&100b  = 0}) || {(n = 4) && {m&100b != 0}}
        ).if {
          pt.put_last p
          //"U1 ".print
        }
      }
      (p = pbeg).if { bug := bug + 1; }
      //  XXXX
      //  X
      //p.print; " / ".print; pt.first.print; " / ".print; pt.count.println
    }.do_while {
      (pt.count < lim) && {cpt < 8} && {!out} && {
        (pt.count = 1) || {pt.first != p}        
      } && {bug < 5}
    }
    //"BUG=".print; bug.println;
    /*(bug>2).if { "--------------------------BUG----------------".print;
      bug.println
    }*/
    (pt.first = pt.last).if { pt.remove_last; }
    //
    ((pt.count >= lim) || {cpt >= 8} || {pt.count.is_odd} || {out}).if { // Echec      
      (pt.count >= lim).if {
        res := "Contour trop long."
        "Nb pts:".print; pt.count.print; " lim:".print; lim.println
      }.elseif {cpt >= 8} then {
        res := "Point suivant non trouvé."
      }.elseif {out} then {
        res := "Objet hors image."
      }.elseif {pt.count.is_odd} then {
        res := "Bug contour: count points impair! (Err:Contour intern, not extern)"
        /*
        //"Nb pts:".print; pt.count.println        
        0.to (2.min (pt.upper)) do { i:Int; i.print; ':'.print
        (pt.at i % w).print; ','.print; (pt.at i / w).print; ' '.print; }
        (pt.count >= 4).if {
          "... ".print
          (pt.upper-2).to (pt.upper) do { i:Int; i.print; ':'.print
          (pt.at i % w).print; ','.print; (pt.at i / w).print; ' '.print; }
        }
        '\n'.print
        */
        //err.clear
        //err.copy_collection pt;
      }
      pt.clear
    } else { out_x := out_y := -1; }
    res,out_x,out_y
  )
  
  - fill img:C_array Uint8 size (w,h:Int) with pt:Array Int border s:Uint8 col c:Uint8 <-
  // If s = c then no border !
  ( + b,e:Int
    pt.quick_sort
    0.to (pt.upper) by 2 do { i:Int
      (b,e) := (pt.at i, pt.at (i+1))
      (s != c).if {
        { b := b + 1; (img.at b = 0FFh).if { img.at b put s; }}.while_loop
        { e := e - 1; (img.at e = 0FFh).if { img.at e put s; }}.while_loop
      }
      b.to e do { j:Int; img.at j put c; }
    }
  )
    
  - sum_xy img:C_array Uint8 size (w,h:Int) in (sx,sy:Array Int) :(Int,Int) <-
  // Result: median
  ( + l,c,i,sum,cx,cy,ix,iy:Int
    sx.resize w; sy.resize h
    sx.set_all_with 0
    0.to (h-1) do { y:Int
      l := 0
      0.to (w-1) do { x:Int
        c := img.at i
        sum := sum + c
        sx.at x put (sx.at x + c)
        l := l + c
        i := i + 1
      }
      sy.at y put l
    }
    sum := sum / 2
    {(ix < w) && {cx < sum}}.while_do { cx := cx + sx.at ix; ix := ix + 1; }
    {(iy < h) && {cy < sum}}.while_do { cy := cy + sy.at iy; iy := iy + 1; }
    ix,iy
  )
  
  - clean img:C_array Uint8 size (w,h:Int) <-
  ( + ofs:Int
    ofs := w
    1.to (h-2) do { y:Int
      ofs := ofs + 1
      1.to (w-2) do { x:Int
        (img.at ofs != 0).if {
          (
            (img.at (ofs-w-1) != 0).to_int + (img.at (ofs-w) != 0).to_int + (img.at (ofs-w+1) != 0).to_int +
            (img.at (ofs  -1) != 0).to_int +                                  + (img.at (ofs  +1) != 0).to_int +
            (img.at (ofs+w-1) != 0).to_int + (img.at (ofs+w) != 0).to_int + (img.at (ofs+w+1) != 0).to_int
          <= 2).if {
            img.at ofs put 0
          }
        }
        ofs := ofs + 1
      }
      ofs := ofs + 1
    }
  )
  
  - bold src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) dim t2:Int <-
  // src = dst Ok
  // t = 1 then [-t .. +t]
  // ooo
  // oXo
  // ooo
  [ ? {t2.is_odd}; ]
  ( + i,j,k,t:Int
    + c:Uint8
    t := t2 / 2
    i := w*t
    t.to (h-t-1) do { y:Int
      i := i + t
      t.to (w-t-1) do { x:Int
        (src.at i = 255).if {
          j := i-t*w-t
          (-t).to t do { yy:Int
            k := j
            (-t).to t do { xx:Int
              c := src.at k
              (c = 0).if { dst.at k put 254; } else { dst.at k put c; }
              k := k + 1
            }
            j := j + w
          }
        }
        i := i + 1
      }
      i := i + t
    }
  )
  
  - put src:C_array Uint8 size (w,h:Int) pts pt:Array Int dim t:Int col c:Uint8 <-
  ( + x0,y0,x1,y1:Int
    (x1,y1) := (pt.first,pt.second)
    2.to (pt.upper) by 2 do { i:Int
      (x0,y0) := (x1,y1)
      (x1,y1) := (pt.at i, pt.at (i+1))
      line src size (w,h) from (x0,y0) to (x1,y1) width t col c
    }
    line src size (w,h) from (x1,y1) to (pt.first,pt.second) width t col c
  )
  
  - border src:C_array Uint8 size (w,h:Int) width b:Int <-
  ( + o1,o2:Int
    o2 := w*h-1
    (b*w).times {
      src.at o1 put 0
      src.at o2 put 0
      o2 := o2 - 1
      o1 := o1 + 1
    }
    (h-b*2).times {
      0.to (b-1) do { x:Int
        src.at (o1+x) put 0
        src.at (o2-x) put 0
      }
      o1 := o1 + w
      o2 := o2 - w
    }
  )
  
  - max src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) dim t2:Int <-
  // src = dst Ok
  // t = 1 then [-t .. +t]
  // ooo
  // oXo
  // ooo
  [ ? {t2.is_odd}; ]
  ( + i,j,k,mx,t:Int
    t := t2/2
    i := w*t
    t.to (h-t-1) do { y:Int
      i := i + t
      t.to (w-t-1) do { x:Int
        j := i-t*w-t
        mx := 0
        (-t).to t do { yy:Int
          k := j
          (-t).to t do { xx:Int
            (src.at k > mx).if { mx := src.at k; }
            k := k + 1
          }
          j := j + w
        }
        dst.at i put mx
        i := i + 1
      }
      i := i + t
    }
    border dst size (w,h) w t
  )
  
  - mean src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) dim t2:Int <-
  // src = dst Ok
  // t = 1 then [-t .. +t]
  // ooo
  // oXo
  // ooo
  [ ? {t2.is_odd}; ]
  ( + i,j,k,sum,q,t:Int
    t := t2/2
    i := w*t
    q := t2*t2
    t.to (h-t-1) do { y:Int
      i := i + t
      t.to (w-t-1) do { x:Int
        j := i-t*w-t
        sum := 0
        (-t).to t do { yy:Int
          k := j
          (-t).to t do { xx:Int
            sum := sum + src.at k
            k := k + 1
          }
          j := j + w
        }
        dst.at i put (sum/q)
        i := i + 1
      }
      i := i + t
    }
    border dst size (w,h) w t
  )
  
  - mean4 src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) dim t2:Int <-
  // src = dst Ok
  // t = 3 then [-1 .. +1]
  // ooo
  // oXo
  // ooo
  [ ? {t2.is_odd}; ]
  ( + i,j,k,sum_r,sum_g,sum_b,q,t:Int
    t := t2/2
    i := w*t
    q := t2*t2
    t.to (h-t-1) do { y:Int
      i := i + t
      t.to (w-t-1) do { x:Int
        j := i-t*w-t
        sum_r := sum_g := sum_b := 0
        (-t).to t do { yy:Int
          k := j
          (-t).to t do { xx:Int
            sum_r := sum_r + src.at (k*4 + 0)
            sum_g := sum_g + src.at (k*4 + 1)
            sum_b := sum_b + src.at (k*4 + 2)
            k := k + 1
          }
          j := j + w
        }
        dst.at (i*4 + 0) put (sum_r/q)
        dst.at (i*4 + 1) put (sum_g/q)
        dst.at (i*4 + 2) put (sum_b/q)
        dst.at (i*4 + 3) put 255
        i := i + 1
      }
      i := i + t
    }
    border4 dst size (w,h) w t
  )
  
  - gauss src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) dim t2:Int sigma sig:Real64 <-
  // src = dst Ok
  // t = 1 then [-t .. +t]
  // ooo
  // oXo
  // ooo
  [ ? {t2.is_odd}; ]
  ( + i,j,k,g,sum,s,t:Int
    t := t2 / 2
    i := w*t
    s := t2
    ((gauss_size != s) || {gauss_sigma != sig}).if { update_gaussian s sigma sig; }
    t.to (h-t-1) do { y:Int
      i := i + t
      t.to (w-t-1) do { x:Int
        j := i-t*w-t
        sum := g := 0
        (-t).to t do { yy:Int
          k := j
          (-t).to t do { xx:Int
            sum := sum + gauss.at g * src.at k
            k := k + 1
            g := g + 1
          }
          j := j + w
        }
        dst.at i put (sum/gauss_sum)
        i := i + 1
      }
      i := i + t
    }
    border dst size (w,h) w t
  )
  
  - median src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) dim t2:Int <-
  // src = dst Ok
  // t = 1 then [-t .. +t]
  // ooo
  // oXo
  // ooo
  [ ? {t2.is_odd}; ]
  ( + i,j,k,q,g,t:Int
    t := t2/2
    i := w*t
    q := t2*t2
    (tmp,tmp_cap) := C_array Uint8.update_size (tmp,tmp_cap) new q
    t.to (h-t-1) do { y:Int
      i := i + t
      t.to (w-t-1) do { x:Int
        j := i-t*w-t
        g := 0
        (-t).to t do { yy:Int
          k := j
          (-t).to t do { xx:Int
            tmp.at g put (src.at k)
            k := k + 1
            g := g + 1
          }
          j := j + w
        }
        tmp.quick_sort_upper (q-1)
        dst.at i put (tmp.at (q/2))
        i := i + 1
      }
      i := i + t
    }
    border dst size (w,h) w t
  )
  
  - nagao src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int) dim t:Int <-
  // src != dst
  // ooo
  // oXo
  // ooo
  [ ? {t.is_odd}; ]
  ( + i,p,pp,ht:Int
    + best_m,m:Uint8
    + best_v,v:Real64
    i := w*t
    ht := t/2
    t.to (h-t-1) do { y:Int
      i := i + t
      t.to (w-t-1) do { x:Int
        best_v := 10_000; // +oo (256 suffit ;) )
        p := i - ht*w - ht
        3.times { // 9 zones:
          pp := p
          3.times {
            (m,v) := variance src width w to pp dim t
            (v < best_v).if { (best_m,best_v) := (m,v); }
            pp := pp + ht
          }
          p := p + ht*w
        }
        dst.at i put best_m
        i := i + 1
      }
      i := i + t
    }
    border dst size (w,h) w t
  )
  
  - contour src:Array Int to_pt dst:Array Int width w:Int <-
  // src = dst Ok
  ( + cnt,v,x,y,j,up:Int
    cnt := src.count * 2
    up := src.upper
    dst.set_capacity cnt
    dst.set_upper (cnt-1)
    up.downto 0 do { i:Int
      v := src.at i
      (x,y) := (v % w, v / w)
      j := i<<1
      dst.at (j    ) put x
      dst.at (j + 1) put y
    }
  )
  
  - flip s:Array Real32 y y:Real32 <-
  (
    0.to (s.upper) by 2 do { i:Int
      s.at (i+1) put (y*2 - s.at (i+1))
    }
  )
  
  - flip s:Array Real32 x x:Real32 <-
  (
    0.to (s.upper) by 2 do { i:Int
      s.at i put (x*2 - s.at i)
    }
  )
  
  //- bug:ARRAY REAL_32 := ARRAY REAL_32.create_with_capacity 100
  
  - contour s:Array Int to d:Array Real32 inset offset:Real32 <-
  // Ben Inside
  ( + i,j,a,b,c,e0,e1:Int
    + x0,y0,x1,y1:Real32
    + dx,dy,l,ndx,ndy:Real32
    + du,dv:Real32
    + rm,again:Boolean
    //bug.clear
    d.clear
    (x0,y0) := (s.at 0,s.at 1); i := 2
    {
      (x1,y1) := (s.at i,s.at (i+1))
      (dx,dy) := (x1-x0, y1-y0)
      l := (dx * dx + dy * dy).sqrt
      (l != 0).if {
        (ndx,ndy) := ((-dy/l) * offset, (dx/l) * offset)
        d.add_last (x0 + ndx); d.add_last (y0 + ndy)
        d.add_last (x1 + ndx); d.add_last (y1 + ndy)
      }
      (x0,y0) := (x1,y1)
      i := (i + 2) % s.count
    }.do_while {i != 2}
    (a,b) := (0,4); i := 8
    {
      again := False
      {
        c := i
        rm := False
        (e0,x0,y0, e1,x1,y1) := (inter d pt (a,b) first True, inter d pt (b,c) first False)
        ((e0 < 0) || {e0 < 0}).if {
          rm := True
        }.elseif {(e0 > 0) || {e1 > 0}} then {
          (dx,dy) := (d.at (b+2)-d.at (b+0), d.at (b+3)-d.at (b+1))
          (du,dv) := (x1-x0, y1-y0)
          (dx*du + dy*dv <= 0).if {
            rm := True
          } else {
            d.at (b+0) put x0; d.at (b+1) put y0; d.at (b+2) put x1; d.at (b+3) put y1
          }
        }
        (rm).if {
          again := True
          d.remove b to (b+3)
          (a > b).if { a := a - 4; }
          (b > d.upper).if { b := 0; i := 4; }
        } else {
          (a,b) := (b,c)
          i := i + 4
        }
        i := i % d.count
      }.do_while {i != 8}
    }.do_while {again}
    i := 0
    {i < d.upper-8}.while_do {
      a := i
      j := i + 8
      {j < d.upper-4}.while_do {
        b := j
        (x0,y0) := inter2 d pt (a,b)
        (x0 >= 0).if {
          //bug.add_last x0; bug.add_last y0
          d.at (a+2) put x0; d.at (a+3) put y0
          d.at (b+0) put x0; d.at (b+1) put y0
          d.remove (a+4) to (b-1)
          j := a + 4
        }
        j := j + 4
      }
      i := i + 4
    }
    i := 2
    {i < d.count/2}.while_do {
      d.at (i+0) put (d.at (i*2+0))
      d.at (i+1) put (d.at (i*2+1))
      i := i + 2
    }
    d.set_upper (i-1)
  )
  
Private
  
  - inter2 d:Array Real32 pt (ab,cd:Int) :(Real32,Real32) <-
  ( + det,xa,xb,xc,xd,ya,yb,yc,yd,u,t,x,y:Real32
    x := -1
    (xa,ya,xb,yb) := (d.at (ab+0),d.at (ab+1),d.at (ab+2),d.at (ab+3))
    (xc,yc,xd,yd) := (d.at (cd+0),d.at (cd+1),d.at (cd+2),d.at (cd+3))
    det := (xb - xa) * (yd - yc) - (yb - ya) * (xd - xc)
    (det.abs >= 0.0001).if {
      t := ((xc - xa) * (yd - yc) - (yc - ya) * (xd - xc)) / det
      u := ((xc - xa) * (yb - ya) - (yc - ya) * (xb - xa)) / det
      ((t.in_range 0 to 1) && {u.in_range 0 to 1}).if {        
        x := xa + t * (xb - xa)
        y := ya + t * (yb - ya)
      }
    }
    x,y
  )

  - inter d:Array Real32 pt (ab,cd:Int) first f:Boolean :(Int,Real32,Real32) <-
  ( + dx,dy,du,dv,det,x,y,t:Real32
    + xa,xb,xc,xd,ya,yb,yc,yd:Real32
    //+ c1,c2:REAL_32
    + e:Int
    (xa,ya,xb,yb) := (d.at (ab+0),d.at (ab+1),d.at (ab+2),d.at (ab+3))
    (xc,yc,xd,yd) := (d.at (cd+0),d.at (cd+1),d.at (cd+2),d.at (cd+3))
    (dx,dy) := (xb-xa, yb-ya)
    (du,dv) := (xd-xc, yd-yc)
    det := dx*dv - dy*du
    (det.abs < 0.0001).if { // Parallel segment
      e := -1
      /*
      c1 := ((yc - ya) * (xb - xa) - (xc - xa) * (yb - ya)).abs
      c2 := ((yd - ya) * (xb - xa) - (xd - xa) * (yb - ya)).abs
      ((c1 < 0.0001) && {c2 < 0.0001}).if {    
        e := -1
      } else {
        c1 := (dx*dx+dy*dy).sqrt
        c2 := (du*du+dv*dv).sqrt
        ((f) && {c2 < c1}).if { e := -1
          bug.add_last xc; bug.add_last yc
        }
        (x,y) := (xc, yc)
      };*/
    } else {
      (((xb-xc).abs < 0.1) && {(yb-yc).abs < 0.1}).if {
        (x,y) := (xc, yc)
      } else {
        e := +1
        t := ((xc - xa)*dv - (yc - ya)*du)/det
        (x,y) := (xa + t*dx, ya + t*dy)
      }
    }
    e,x,y
  )
  
Public
  
  - rgb_to_tsl src:C_array Uint8 to tsl:Array (C_array Real32) size (w,h:Int) <-
  [ ? {tsl.count = 3}; ]
  ( + r,g,b,t,s,l,max,min,d:Real32
    + ii:Int
    0.to (w*h*4-1) by 4 do { i:Int
      (r,g,b) := (src.at (i+0).to_real32, src.at (i+1).to_real32, src.at (i+2).to_real32)
      (r,g,b) := (r/255,g/255,b/255)
      (max,min) := (r.max g.max b, r.min g.min b)
      t := s := l := (max+min)/2
      (max = min).if {
        t := s := 0
      } else {
        d := max - min
        (l > 0.5).if {
          s := d / (2.0 - max - min)
        } else {
          s := d / (max + min)
        }
        (r = max).if {
          t := (g-b)/d + (g < b).ok 6 or 0
        }.elseif {g = max} then {
          t := 2.0 + (b-r)/d
        } else { // b = max
          t := 4.0 + (r-g)/d
        }
        t := t / 6
      }
      
      tsl.at 0.at ii put t
      tsl.at 1.at ii put s
      tsl.at 2.at ii put l
      ? {l.in_range 0 to 1}
      ii := ii + 1
    }
  )
  
  - rgb_to_l src:C_array Uint8 to imgl:C_array Uint8 size (w,h:Int) <-
  ( + r,g,b,l:Uint8
    + ii,max,min:Int
    0.to (w*h*4-1) by 4 do { i:Int
      (r,g,b) := (src.at (i+0), src.at (i+1), src.at (i+2))
      (max,min) := (r.max g.max b, r.min g.min b)
      l := ((max+min)/2).to_uint8
      imgl.at ii put l
      ii := ii + 1
    }
  )
  
Private
  - hue2rgb (p,q,t:Real32) :Real32 <-
  ( + tt,r:Real32
    tt := t
    (tt < 0).if { tt := tt + 1; }
    (tt > 1).if { tt := tt - 1; }
    (tt < 1.0/6).if {
      r := p + (q - p) * 6 * tt
    }.elseif {tt < 1.0/2} then {
      r := q
    }.elseif {tt < 2.0/3} then {
      r := p + (q - p) * (2.0/3 - tt) * 6
    } else {
      r := p
    }
    r
  )

Public
  
  - tsl_to_rgb src:C_array Real32 to rgb:C_array Uint8 size (w,h:Int) <-
  ( + r,g,b,t,s,l,p,q:Real32
    0.to (w*h*4-1) by 4 do { i:Int
      (t,s,l) := (src.at (i+0), src.at (i+1), src.at (i+2))
      (s = 0).if {
        r := g := b := l
      } else {
        (l < 0.5).if {
          q := l * (s + 1)
        } else {
          q := l + s - l * s
        }
        p := l * 2 - q
        r := hue2rgb(p,q,t + 1.0/3)
        g := hue2rgb(p,q,t)
        b := hue2rgb(p,q,t - 1.0/3)
      }
      rgb.at (i+0) put ((r*255).to_uint8)
      rgb.at (i+1) put ((g*255).to_uint8)
      rgb.at (i+2) put ((b*255).to_uint8)
      rgb.at (i+3) put 255
    }
  )
    
  - rgb_to_hsv src:C_array Uint8 to hsv:C_array Uint8 size (w,hh:Int) <-
  // rgba = hsv OK
  ( + up:Int
    + r,g,b,a,max,min,delta,h,s,v:Int
    up := w * hh * 4
    0.to (up-1) by 4 do { i:Int
      (r,g,b,a) := (src.at (i+0), src.at (i+1), src.at (i+2),src.at (i+3))
      max := r.max g.max b
      min := r.min g.min b
      delta := max - min
      h := s := 0; v := max
      (max != 0).if {
        s := (delta * 255) / max
      } else {
        s := 0
      }
      (delta > 0).if {
        (max = r).if {
          h := (43 * (g - b)) / delta
        }.elseif {max = g} then {
          h := (43 * (b - r)) / delta + 85
        }.elseif {max = b} then {
          h := (43 * (r - g)) / delta + 171
        }
        (h < 0).if {
          h := h + 255
        }
      }
      hsv.at (i+0) put h
      hsv.at (i+1) put s
      hsv.at (i+2) put v
      hsv.at (i+3) put a
    }
  )
  
  - hsv_to_rgb src:C_array Uint8 to rgb:C_array Uint8 size (w,hh:Int) <-
  // rgba = hsv OK
  ( + up,reg,rem,p,q,t:Int
    + r,g,b,a,h,s,v:Int
    up := w * hh * 4
    0.to (up-1) by 4 do { i:Int
      (h,s,v,a) := (src.at (i+0), src.at (i+1), src.at (i+2),src.at (i+3))
      r := g := b := 0
      (s = 0).if {
        r := g := b := v
      } else {      
        reg := (h * 6) / 255
        rem := (h * 6) % 255
        p := (v * (255 - s)) / 255
        q := (v * (255 - (s * rem) / 255)) / 255
        t := (v * (255 - (s * (255 - rem)) / 255)) / 255
        reg
        .when 0 then { (r,g,b) := (v,t,p); }
        .when 1 then { (r,g,b) := (q,v,p); }
        .when 2 then { (r,g,b) := (p,v,t); }
        .when 3 then { (r,g,b) := (p,q,v); }
        .when 4 then { (r,g,b) := (t,p,v); }
        .when 5 then { (r,g,b) := (v,p,q); }
      }
      rgb.at (i+0) put r
      rgb.at (i+1) put g
      rgb.at (i+2) put b
      rgb.at (i+3) put a
    }
  )
  
  - black_detect src:C_array Uint8 to rgb:C_array Uint8 size (w,hh:Int) lim vv:Int <-
  ( + h,s,v,a:Int
    0.to (w*hh*4) by 4 do { i:Int
      (h,s,v,a) := (src.at (i+0), src.at (i+1), src.at (i+2),src.at (i+3))
      (v < vv).if {
        rgb.at (i>>2) put 255
      } else {
        rgb.at (i>>2) put 0
      }
    }
  )
  
  - select src:C_array Uint8 to dst:C_array Uint8 size (w,h:Int)
  col c:Int lim l:Int <-
  // src = dst ok
  ( + j,c0,c1,c2,cmx:Int
    0.to (w*h-1) do { i:Int
      (c0,c1,c2) := (src.at (j+0), src.at (j+1), src.at (j+2))
      ((c0 > c1+l) && {c0 > c2+l}).if   { cmx := 0; }.elseif
      {(c1 > c0+l) && {c1 > c2+l}} then { cmx := 1; }.elseif
      {(c2 > c0+l) && {c2 > c1+l}} then { cmx := 2; } else { cmx := -1; }
      (cmx = c).if { dst.at i put 0; } else { dst.at i put 255; }
      j := j + 4
    }
  )

  - draw_cross pen:Pen to (x,y:Real32) col col:Color <-
  (
    pen.begin_path
    pen.stroke_width 3
    pen.stroke_color col
    pen.line (x - 8, y - 8) to (x + 8, y + 8)
    pen.line (x + 8, y - 8) to (x - 8, y + 8)
    pen.stroke
  )
  
  - draw pen:Pen contour s:Array Real32 to (px,py:Real32) coef c:Real32 col col:Color <-
  (
    pen.begin_path
    pen.move_to (px + s.first*c, py + s.second*c)
    2.to (s.upper) by 2 do { i:Int
      pen.line_to (px + s.at i*c, py + s.at (i+1)*c)
    }
    pen.line_to (px + s.first*c, py + s.second*c)
    pen.stroke_width 1.0
    pen.stroke_color col
    pen.stroke
  )
  
  - draw pen:Pen line s:Array Real32 to (px,py:Real32) coef c:Real32 col col:Color <-
  ( + x0,y0,x1,y1:Real32
    pen.begin_path
    0.to (s.upper) by 4 do { i:Int
      (x0,y0) := (px + s.at (i+0)*c, py + s.at (i+1)*c)
      (x1,y1) := (px + s.at (i+2)*c, py + s.at (i+3)*c)
      pen.line (x0,y0) to (x1,y1)
    }
    pen.stroke_width 2.0
    pen.stroke_color col
    pen.stroke
    
    pen.begin_path
    (x0,y0) := (px + s.first*c, py + s.second*c)
    pen.circle (x0,y0) radius 8
    pen.stroke_color (Color.red)
    pen.stroke
    /*
    pen.begin_path
    0.to (bug.upper) by 2 do { i:Int
      (x0,y0) := (px + bug.at (i+0)*c, py + bug.at (i+1)*c)
      pen.circle (x0,y0) radius 2
    }
    pen.stroke_color (COLOR.magenta)
    pen.stroke
    */
  )
  
Private

  - edges:Array Npedge

  - edges_upper:Int
  - poly_ymax:Int := Int.minimum.to_int

  - poly_list_y:Array Npedge

  - begin_y:Npedge
  - begin_idx:Int

  - last_y:Npedge
  - last_idx:Int

  - x_origin:Int
  - y_origin:Int

Private
    
  - display_poly <-
  ( + edge:Npedge

    0.to (poly_list_y.upper) do { i:Int
      edge := poly_list_y.at i
      {edge != NULL}.while_do {
        edge.display
        ';'.print
        edge := edge.next_y
      }
      '\n'.print
    }
  )

Private

  - connect_first <-
  (
    bmp_line_to (x_origin,y_origin)
    ((begin_y!=NULL) && {begin_y.is_down = last_y.is_down}).if {
      // Connecting.
      (begin_y.is_down).if {
        // Add first list.
        last_y.set_next_y begin_y
        poly_list_y.at begin_idx put (poly_list_y.at last_idx)
      } else {
        // Add last list.
        begin_y.set_next_y last_y
      }
      poly_list_y.remove last_idx
    }
  )

  - sort_list_y <-
  // Bubble sort :- => BSBS: Optmize with Quick sort...
  ( + low,up,idx,upper:Int
    + swap:Boolean

    upper := poly_list_y.upper-1

    low := 0
    up  := upper
    {
      swap:=False
      low.to up do { i:Int
        (poly_list_y.at i.y0 > poly_list_y.at (i+1).y0).if {
          poly_list_y.swap i with (i+1)
          swap := True
        }

        idx := upper - i
        (poly_list_y.at idx.y0 > poly_list_y.at (idx+1).y0).if {
          poly_list_y.swap idx with (idx+1)
          swap := True
        }
      }
      up  := up - 1
      low := low + 1
    }.do_while {swap}
  )

Public
  
  - spot_x:Int
  - spot_y:Int
  
  - bmp_move_to (x,y:Int) <-
  (
    //x.print; ' '.print; y.print; '\n'.print
    (edges = NULL).if {
      poly_list_y := Array(Npedge).create_with_capacity 16
      edges := Array(Npedge).create 64
      0.to 63 do { n:Int; edges.at n put (Npedge.create); }
    }
    (edges_upper != 0).if { connect_first; }
    spot_x := x_origin := x
    spot_y := y_origin := y
    begin_y  := NULL
    last_y   := NULL

    poly_ymax := poly_ymax.max y
  )

  - bmp_line_to (x1,y1:Int) <-
  ( + edge,edge2:Npedge
    + x0,y0:Int
    //x1.print; ' '.print; y1.print; '\n'.print
    x0:=spot_x
    y0:=spot_y

    ((x0!=x1) || {y0!=y1}).if {      
      spot_x := x1
      spot_y := y1

      (edges_upper >= (edges.upper-4)).if { // BSBS: A optimiser avec MAP_ARRAY ...
        // Append 16 Edges.
        0.to 15 do { j:Int; edges.add_last (Npedge.create); }
      }

      (y0=y1).if {
        // Flat.
        edge  := edges.at edges_upper
        edges_upper := edges_upper + 1
        poly_list_y.add_last edge
        edge2 := edges.at edges_upper
        edges_upper := edges_upper + 1
        poly_list_y.add_last edge2

        (x0 < x1).if {
          edge .make (x0,y0) add 1
          edge2.make (x1,y1) add (-1)
        } else {
          edge .make (x0,y0) add (-1)
          edge2.make (x1,y1) add 1
        }
      } else {
        // Line.
        edge  := edges.at edges_upper
        edges_upper := edges_upper + 1
        edge.make (x0,y0) to (x1,y1)

        (begin_y=NULL).if {
          begin_idx := poly_list_y.count
          begin_y   := edge
        }
        ((last_y=NULL) || {last_y.is_down != edge.is_down}).if {
          // New line_y.
          poly_list_y.add_last edge
          last_idx := poly_list_y.upper
          last_y   := edge
          poly_ymax := poly_ymax.max y1
        } else {
          // Continue line_y.
          (edge.is_down).if {
            // Add last.
            last_y.set_next_y edge
            poly_ymax := poly_ymax.max y1
          } else {
            // Add first.
            poly_list_y.at last_idx put edge
            edge.set_next_y last_y
          }
          last_y := edge
        }
      }
    }
  )
  
  - bmp_trace bmpline:{(Int,Int,Int); } :(Int,Int) <-
  ( + edge,next_edge,edgep:Npedge
    + x_edges:Npedge
    + x0,x1,new_x,x_mx,y_mx:Int
    + idx_y:Int
    + trace:Int
    + line:Int
    + is_y:Boolean
       
    (edges_upper != 0).if {      
      // Connexion with first point.
      connect_first

      // Optimize clip_y0
      /*
      (poly_list_y.upper).downto 0 do { j:Int
        edge := poly_list_y.at j
        //{(edge != NULL) && {edge.y1 < clip_y0}}.while_do {
        //  edge := edge.next_y
        //}
        (edge = NULL).if {
          poly_list_y.remove j
        } else {
          poly_list_y.put edge to j
        }
      }
      */
      
      // Sort on Y.
      sort_list_y
        
      y_mx := poly_ymax
      line := 1
      x_mx := 0
      //"=============================================\n".print
      // for each scanline in the polygon.
      (poly_list_y.first.y0).to poly_ymax do { y:Int
        ? {y >= 0}
        is_y := False
        // Active edges.
        {(idx_y <= poly_list_y.upper) && {poly_list_y.at idx_y.y0 = y}}.while_do {
          x_edges := poly_list_y.at idx_y.add x_edges
          idx_y   := idx_y + 1
        }
        //"--------------------\n".print
        // Draw horizontal line.
        x1:=Int.minimum.to_int
        edge:=x_edges
        {edge!=NULL}.while_do {
          next_edge:=edge.next_x
          // Trace.            
          (trace = 0).if {
            // Begin point.
            new_x := (edge.x+16383)>>16
            //x0.print; ' '.print; y.print; '/'.print; x1.print; ' '.print; new_x.print; '\n'.print
            ((new_x != x1) && {new_x != (x1 + 1)}).if {              
              (x1 >= x0).if {
                bmpline.value (x0,y,x1)
                is_y := True
              }
              x0 := new_x
            }
          }
            
          (edge.is_point).if {
            trace := trace + edge.dx
          } else {
            trace := trace + line
            line  := - line
          }
            
          (trace = 0).if {
            // End point.
            x1 := (edge.x+16384)>>16
          }
                    
          // Inc edges.
          (edge.width!=0).if {
            edge.new_step
            
            // Sort with X :
            edgep:=edge.prev_x
            {(edgep!=NULL) && {edge.x<edgep.x}}.while_do {
              edgep:=edgep.prev_x
            }
            (edgep!=edge.prev_x).if {
              edge.prev_x.set_next_x (edge.next_x)
              (edge.next_x!=NULL).if {
                edge.next_x.set_prev_x (edge.prev_x)
              }
              edge.set_prev_x edgep
              (edgep!=NULL).if {
                edge.set_next_x (edgep.next_x)
                edgep.set_next_x edge
              } else {
                edge.set_next_x x_edges
                x_edges:=edge
              }
              (edge.next_x!=NULL).if {
                edge.next_x.set_prev_x edge
              }
            }
          } else {
            // Next line.
            x_edges:=edge.next_line x_edges
          }
          edge := next_edge
        }
        x_mx := x_mx.max x1
        (x1>=x0).if {
          bmpline.value (x0,y,x1)
        }.elseif {! is_y} then {
          bmpline.value (x0,y,x0)
          //"Patch\n".print
        }
      }
    }
    // Init structure for next.
    edges_upper:=0
    poly_list_y.clear
    begin_y:=NULL
    poly_ymax:=Int.minimum.to_int
    x_mx,y_mx
  )
    
Public
  
  - rays pt:Array Int to (xc,yc:Real32) in ray:Array (Array Real32) :Real32 <-
  ( + a,dy,dx,l,max,v:Real32
    + n,r,ro,x0,y0,x1,y1,d,ax,i,rf:Int
    + rl:Array Real32
    ray.foreach { t:Array Real32; t.clear; }
    ro := -1
    (x1,y1) := (pt.first, pt.second); i := 2
    {
      (x0,y0) := (x1,y1)
      (x1,y1) := (pt.at i, pt.at (i+1))
      ax := (x0=x1).ok 0 else {(x0 < x1).ok (+1) or (-1)}
      dy := y0.to_real32-yc
      {        
        dx := x0.to_real32-xc
        l := (dx*dx+dy*dy).sqrt
        (l > max).if { max := l; }
        a := dy.atan2 dx+Real32.pi
        r := (ray.count.to_real32/Real32.two_pi * a).to_int & ray.upper
        rl := ray.at r
        (r != ro).if {
          (ro = -1).if {
            rf := ro := r
          } else {
            v := ray.at ro.last/n
            ray.at ro.put_last v
            d := ((r-ro)&(ray.count>>1)=0).ok (+1) or (-1)
            ro := (ro + d) & ray.upper
            {ro != r}.while_do {
              ray.at ro.add_last v
              ro := (ro + d) & ray.upper
            }
            // ro := r
          }
          n := 1
          rl.add_last l
          //((rl.is_empty) || {rl.last-l > 1}).if { rl.add_last l; }
        } else {
          n := n + 1
          rl.put_last (rl.last+l)
        }
        x0 := x0+ax
      }.do_while {x0 != x1}
      i := (i + 2) % pt.count
    }.do_while {i != 2}
    v := ray.at ro.last/n
    ray.at ro.put_last v
    ((d := rf - ro) != 0).if {
      d := (d&(ray.count>>1)=0).ok (+1) or (-1)
      // "ro:".print; ro.print; " rf:".print; rf.print; " d:".print; d.println
      ro := (ro + d) & ray.upper
      {ro != rf}.while_do {
        ray.at ro.add_last v
        ro := (ro + d) & ray.upper
      }
    }
    max
  )
  
  - rays img:C_array Uint8 size (w,h:Int) to (xc,yc:Real32) clip (x0,y0,x1,y1:Real32) in ray:Array (Array Real32) :Real32 <-
  ( + x,y,dx,dy,a:Real32
    + r,rmax:Int
    + c,co:Uint8
    ray.foreach { t:Array Real32; t.clear; }
    0.to (ray.upper) do { i:Int
      (x,y) := (xc,yc)
      co := img.at (y.to_int*w + x.to_int)
      a := (Real32.two_pi * i)/ray.count
      (dx,dy) := (a.cos,a.sin)
      r := 0
      {(x.in_range x0 to x1) && {y.in_range y0 to y1}}.while_do {
        (x,y) := (x+dx,y+dy)
        r := r + 1
        c := img.at (y.to_int*w + x.to_int)
        (c != co).if {
          ray.at i.add_last r
          (r > rmax).if { rmax := r; }
          co := c
        }
      }
    }
    rmax
  )

  
  - draw pen:Pen id id:String to (x,y:Real32) width w:Real32
  rays ray:Array (Array Real32) max max:Real32 angle a:Int <-
  ( + px,py,mx,ww,c:Real32
    + r:Array Real32
    ww := w
    pen.save
    (id != NULL).if {
      pen.fill_color (Look.text_ui)
      pen.font_size (Font.size_app)
      pen.font_face_id (Font.app (Font.bold))
      pen.text_align (pen.align_center | pen.align_middle)
      pen.text (x+8,y+50) msg id
      mx := 20
      ww := ww - mx
    }
    c := ww / ray.count
    pen.begin_path
    pen.stroke_width 1.0
    pen.stroke_color (Color.blue)
    pen.rect (x+mx,y) size (ww,100)
    pen.stroke
    0.to (ray.upper) do { i:Int
      px := x+c*i+mx
      r := ray.at i
      0.to (r.upper) do { j:Int
        py := y+100.0-100.0/max * r.at j
        pen.begin_path
        pen.fill_color (Color.green)
        pen.circle (px,py) radius 2
        pen.fill
      }
    }
    (a != -1).if {
      pen.begin_path
      pen.stroke_color (Color.red)
      px := x+c*a+mx
      pen.line (px,y) to (px,y+100)
      pen.stroke
    }
    pen.restore
  )
  
  - draw pen:Pen to (x,y:Real32) n n:Int col c:Color <-
  (
    pen.fill_color c
    pen.font_face_id (Font.sys (Font.roman))
    pen.font_size (Font.size_sys)
    pen.text_align (pen.align_center | pen.align_middle)
    String.tmp { t:String_buffer; n.append_in t
      pen.text (x,y) msg t
    }
  )
  
  - circle_fill src:C_array Uint8 size (w,h:Int)
  to (xc, yc:Int) ray r:Int col3 (rc,gc,bc:Uint8) <-
  ( + x,y,d:Int
    + pix:{(Int,Int); }
    pix := { (px,py:Int)
      + o:Int
      ((px.in_range 0 to (w-1)) && {py.in_range 0 to (h-1)}).if {
        o := (py*w + px) << 2
        src.at (o+0) put rc
        src.at (o+1) put gc
        src.at (o+2) put bc
        src.at (o+3) put 255
      }
    }
    y := r
    d := 3 - 2 * r
    {x <= y}.while_do {
      (xc-x).to (xc+x) do { i:Int; pix.value (i,yc+y); }
      (xc-x).to (xc+x) do { i:Int; pix.value (i,yc-y); }
      (xc-y).to (xc+y) do { i:Int; pix.value (i,yc+x); }
      (xc-y).to (xc+y) do { i:Int; pix.value (i,yc-x); }
      (d < 0).if {
        d := d + 4 * x + 6
      } else {
        d := d + 4 * (x - y) + 10
        y := y - 1
      }
      x := x + 1
    }
  )
  
  - sum img:C_array Uint8 off o:Int inc d:Int :Real32 <-
  ( + oo,n:Int
    + s:Real32
    oo := o + d*4
    n := 1
    n.times {
      s := s + (img.at (oo+0) + img.at (oo+1) + img.at (oo+2)).to_real32
      oo := oo + d*4
    }
    s / (n*3)
  )
  
  - tab:Array Real32 := Array Real32.create (512/16)
  
  - bidulle img:C_array Uint8 to img2:C_array Uint8 size (w,h:Int) <-
  ( + o,x,xb:Int
    + c_mx,cc:Uint8
    + d,g,c:Real32
    
    0.to (h-1) by 16 do { yy:Int
      tab.at (yy/16) put 0
      (0).to (w-1) by 16 do { xx:Int
        o := (yy*w + xx)*4
        x := 0; c_mx := img.at o
        1.to 15 do { i:Int
          cc := img.at (o+i*4)
          (cc < c_mx).if { x := i; c_mx := cc; }
        }
        xb := x := xx + x
        yy.to (yy+16-1) do { y:Int
          o := (y*w + x)*4
          g := sum img off o inc (-1)
          c := (img.at (o+0) + img.at (o+1) + img.at (o+2)).to_real32 / 3
          d := sum img off o inc (+1)
          img2.at (o+0) put 255; img2.at (o+1) put 0; img2.at (o+2) put 0
          ((c < g) && {c < d}).if {
          }.elseif {(g < c) && {g < d}} then {
            x := x - 1
          }.elseif {(d < c) && {d < g}} then {
            x := x + 1
          }
        }
        tab.at (yy/16) put (tab.at (yy/16) + (x-xb))
      }
      tab.at (yy/16) put (tab.at (yy/16) / (512/16))
      (yy/16).print; " : ".print; (tab.at (yy/16)*10).to_int.print; '\n'.print
    }
    '\n'.print
  )
  
  - bidulle_old img:C_array Uint8 to img2:C_array Uint8 size (w,h:Int) <-
  ( + o,x:Int
    + d,g,c,c_mx:Real32
    0.to (h-1) by 16 do { yy:Int
      (0).to (w-1) by 16 do { xx:Int
        x := xx
        yy.to (yy+16-1) do { y:Int
          o := (y*w + x)*4
          g := sum img off o inc (-1)
          c := (img.at (o+0) + img.at (o+1) + img.at (o+2)).to_real32 / 3
          d := sum img off o inc (+1)
          img2.at (o+0) put 255; img2.at (o+1) put 0; img2.at (o+2) put 0
          ((c < g) && {c < d}).if {
          }.elseif {(g < c) && {g < d}} then {
            x := x - 1
          }.elseif {(d < c) && {d < g}} then {
            x := x + 1
          }
        }
        tab.at (yy/16) put (tab.at (yy/16) + (x-xx))
      }
      tab.at (yy/16) put (tab.at (yy/16) / (512/16))
      tab.at (yy/16).print; ' '.print
    }
    '\n'.print
  )
  
  //
  // Sobel -> NMS -> Double seuillage -> hysterisis
  //
  
Private  

  - bins:Int := 2048;
  - hist:C_array Uint32 := C_array Uint32.create bins

  // Propagation vers les faibles connectés (8-voisinage)
  - nx:C_array Int :=
  ( + r:C_array Int
    r := C_array Int.create 8
    r.at 0 put (-1); r.at 1 put   0 ; r.at 2 put 1; r.at 3 put (-1)
    r.at 4 put   1 ; r.at 5 put (-1); r.at 6 put 0; r.at 7 put   1
    r
  )
  - ny:C_array Int :=
  ( + r:C_array Int
    r := C_array Int.create 8
    r.at 0 put (-1); r.at 1 put (-1); r.at 2 put (-1); r.at 3 put 0;
    r.at 4 put   0 ; r.at 5 put   1 ; r.at 6 put   1 ; r.at 7 put 1;
    r
  )
  
  - to_ofs (x,y,w:Int) :Int <- y*w + x

  // Quantifie un angle (radians) en 4 directions : 0°,45°,90°,135° -> {0,1,2,3}
  - quantize_dir angle_rad:Real32 :Uint8 <-
  ( + a:Real32
    + r:Uint8
    // map to [0,180)
    a := angle_rad * 180.0 / Real32.pi;
    while {a < 0}      do { a := a + 180.0; }
    while {a >= 180.0} do { a := a - 180.0; }

    // centres: 0, 45, 90, 135 ; plages +/-22.5°
    if ((a >= 157.5) || {a < 22.5}) then { } // 0°
    .elseif {a < 67.5}  then { r := 1; } // 45°
    .elseif {a < 112.5} then { r := 2; } // 90°
    else { r := 3; } // 135°
    r
  )
  
  - mag:C_array Real32
  - mag_cap:Int
  - dirq:C_array Uint8
  - dirq_cap:Int
  - nms:C_array Real32
  - nms_cap:Int
  - cls:C_array Uint8
  - cls_cap:Int
  - stack:C_array Int
  - stack_cap:Int
  
Public
  
  // Détection d'arêtes façon Canny (Sobel -> NMS -> double seuil + hystérésis)
  // img : pointeur sur image 8-bit (imgh lignes, imgw colonnes)
  // ROI : (x0,y0) haut-gauche, (x1,y1) bas-droit (inclusif). Sera recadré dans l'image.
  // Retour : nouvel array alloué de taille imgw*imgh (0/255). A libérer par l'appelant.
  - detect_edges_sobel_nms_hyst img:C_array Uint8
  to out:C_array Uint8 size (imgw,imgh:Int)
  rect (x0,y0, x1,y1:Int) :Boolean <-
  ( + roiw,roih,roisize:Int;
    + y,x,gx,gy,i:Int
    + p00,p10,p20,p01,p21,p02,p12,p22:Int
    + m:Real32
    + sp,px,py:Int;
    + maxmag,high,low:Real32
    + countpos:Int
    + result:Boolean
        
    roiw := x1 - x0 + 1;
    roih := y1 - y0 + 1;
    roisize := roiw * roih;

    // Buffers ROI
    (mag,mag_cap)   := C_array Real32   .update_size (mag,mag_cap)   new roisize; // magnitude du gradient
    (dirq,dirq_cap) := C_array Uint8.update_size (dirq,dirq_cap) new roisize; // direction quantifiée
    (nms,nms_cap)   := C_array Real32   .update_size (nms,nms_cap)   new roisize; // après suppression non-max
    (cls,cls_cap)   := C_array Uint8.update_size (cls,cls_cap)   new roisize; // 0=non, 1=faible, 2=fort

    // 1) Sobel Gx, Gy -> magnitude + direction (quantifiée)
    // Kernels:
    // Gx = [-1 0 1; -2 0 2; -1 0 1]
    // Gy = [ 1 2 1;  0 0 0; -1 -2 -1]
    1.to (roih - 2) do { ry:Int;
      y := y0 + ry;
      1.to (roiw - 2) do { rx:Int;
        x := x0 + rx;
        // Raccourcis des voisins
        p00 := img.at (to_ofs (x-1, y-1, imgw));
        p10 := img.at (to_ofs (x,   y-1, imgw));
        p20 := img.at (to_ofs (x+1, y-1, imgw));
        p01 := img.at (to_ofs (x-1, y,   imgw));
        p21 := img.at (to_ofs (x+1, y,   imgw));
        p02 := img.at (to_ofs (x-1, y+1, imgw));
        p12 := img.at (to_ofs (x,   y+1, imgw));
        p22 := img.at (to_ofs (x+1, y+1, imgw));

        gx := -p00 + p20 - 2*p01 + 2*p21 - p02 + p22;
        gy :=  p00 + 2*p10 + p20 - p02 - 2*p12 - p22;

        m := (gx.to_real32).hypot (gy.to_real32);
        i := ry * roiw + rx;
        mag.at i put m;
        dirq.at i put (quantize_dir((gy.to_real32).atan2 (gx.to_real32)));
      }
    }
    // Bords du ROI (0..roiW-1, 0..roiH-1) restent à 0 via calloc.

    // 2) Suppression des non-maximum (NMS)
    1.to (roih - 2) do { ry:Int
      1.to (roiw - 2) do { rx:Int
        + m1,m2:Real32
        i := ry * roiw + rx;
        m := mag.at i;
        if (m = 0.0) then {
          nms.at i put 0.0;
        } else {
          m1 := 0.0; m2 := 0.0;
          (dirq.at i)
          .when 0 then { // 0° : (x-1,y), (x+1,y)
            m1 := mag.at (i - 1);
            m2 := mag.at (i + 1);
          }
          .when 1 then { // 45° : (x-1,y+1), (x+1,y-1)
            m1 := mag.at (i - 1 + roiw);
            m2 := mag.at (i + 1 - roiw);
          }
          .when 2 then { // 90° : (x,y-1), (x,y+1)
            m1 := mag.at (i - roiw);
            m2 := mag.at (i + roiw);
          }
          .when 3 then { // 135° : (x-1,y-1), (x+1,y+1)
            m1 := mag.at (i - 1 - roiw);
            m2 := mag.at (i + 1 + roiw);
          }
          nms.at i put (((m >= m1) && {m >= m2}).ok m or 0.0);
        }
      }
    }

    // 3) Seuils automatiques sur NMS : high = P90, low = high/2.5
    // Histogramme simple sur 2048 bins, normalisé par max    
    0.to (roisize-1) do { i:Int
      if (nms.at i > 0.0) then {
        if (nms.at i > maxmag) then { maxmag := nms.at i; }
        countpos := countpos + 1;
      }
    }
    
    if ((countpos = 0) || {maxmag = 0}) then {
      // Rien à détecter -> image vide
      result := False
    } else {
      + cum,target:Uint64
      + bin90:Int
      + v:Real32
      + b:Int

      result := True
      0.to (bins-1) do { i:Int; hist.at i put 0; }
      0.to (roisize-1) do { i:Int
        v := nms.at i;
        if (v <= 0.0) then {
          // continue;
        } else {
          b := (v / maxmag * (bins - 1)).to_int;
          b := b.max 0.min (bins-1)
          hist.at b put (hist.at b + 1);
        }
      }
      // Cumul pour percentile 90%
      target := (0.90 * countpos.to_real64).ceil.to_uint64;
      bin90 := bins - 1;
      b := 0
      {b < bins}.while_do { 
        cum := cum + hist.at b;
        if (cum >= target) then { bin90 := b; b := bins /* break */ }
        b := b + 1;
      }
      high := bin90.to_real32 / (bins - 1).to_real32 * maxmag;
      low  := high / 2.5;      
    }

    // 4) Classification fort/faible
    0.to (roisize-1) do { i:Int
      + v:Real32
      v := nms.at i;
      if      (v >= high) then { cls.at i put 2; } // fort
      .elseif {v >= low}  then { cls.at i put 1; } // faible
      else                     { cls.at i put 0; } // non
    }

    // 5) Hystérésis (DFS avec pile)
    // Pile maximum = tous les pixels du ROI    
    (stack,stack_cap) := C_array Int.update_size (stack,stack_cap) new (roisize*2); 
    
    // Empile tous les forts
    1.to (roih - 2) do { ry:Int
      1.to (roiw - 2) do { rx:Int
        i := ry * roiw + rx;
        if (cls.at i = 2) then {
          stack.at sp put rx; sp := sp + 1; stack.at sp put ry; sp := sp + 1;
          // Marque déjà comme "final" dans out pour éviter doublons
          out.at (to_ofs (x0 + rx, y0 + ry, imgw)) put 255;
        }
      }
    }

    while {sp > 0} do {
      sp := sp - 1; px := stack.at sp; sp := sp - 1; stack.at sp;      
      0.to 7 do { k:Int;
        + rx,ry:Int
        rx := px + nx.at k;
        ry := py + ny.at k;
        if ((rx <= 0) || {rx >= roiw-1} || {ry <= 0} || {ry >= roih-1}) then {
          // Continue
        } else {
          i := ry * roiw + rx;
          if (cls.at i = 1) then { // faible -> promouvoir
            cls.at i put 2;
            stack.at sp put rx; sp := sp + 1; stack.at sp put ry; sp := sp + 1;
            out.at (to_ofs (x0 + rx, y0 + ry, imgw)) put 255;
          }
        }
      }
    }
    result
  )

