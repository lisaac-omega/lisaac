Header
  + name := Gobj E
Inherit
  + parent_win:Flat Win
  - parent_any_gui:Any_gui := Any_gui
  
Public
  
  + col:Color
  + zom:Real32 := 1
  - zoom z:Real32 :Self <- ( zom := z; self)
  - color c:Color :Self <- ( col := c; self)
    
  + updat:{E;}
  - update a:{E;} :Self <- ( updat := a; self)
  
  - init_obj:Self <-
  ( parent := NULL
    ? {child.is_empty}
    (width,height,flag,col,zom) := (0,0,0,Color,1)
    updat := NULL
    self
  )
  
  - draw_all <-
  (
    (updat != NULL).if { updat.value self; ask_refresh; }
    draw
    draw_child
    //draw_debug
  )
