Header
  + name := Npedge
/*Sub prototype for BITMAP.polygone*/
Inherit

  - parent_clone:Clone := Clone

Public

  // Make.

  + y:Int
  + x:Int

  + width:Int
  + dx:Int;  // REAL_16_16

  + is_down:Boolean
  + is_point:Boolean

  - x0:Int <- x
  - y0:Int <- y
  - x1:Int <- dx
  - y1:Int <- width

  + next_y:Npedge

  + prev_x:Npedge;  // doubly linked list
  + next_x:Npedge

  //
  // Function.
  //
  
  - create:Self <- clone
  
  - make (xx,yy:Int) add inc:Int <-
  // Flat.
  (
    next_y   := NULL
    is_point := True
    dx       := inc
    width    := 0
    x := xx
    y := yy
  )

  - make (xx,yy:Int) to (xx1,yy1:Int) <-
  // Line.
  (
    next_y   := NULL
    is_point := False
    (is_down := yy < yy1).if {
      // Down.
      y  := yy
      x  := xx
      dx := xx1
      width := yy1
    } else {
      // up.
      y  := yy1
      x  := xx1
      dx := xx
      width := yy
    }
  )

  - set_next_x new:Npedge <-
  (
    next_x:=new
  )

  - set_prev_x new:Npedge <-
  (
    prev_x:=new
  )

  - set_next_y new:Npedge <-
  (
    next_y := new
  )

  - add old_root:Npedge :Npedge <-
  // Double link and sort with X.
  ( + pos,prv:Npedge
    + new_root:Npedge

    to_run
    pos:=old_root
    {(pos!=NULL) && {(pos.x<x) || {(pos.x=x) && {pos.dx<dx}} } }.while_do {
      prv := pos
      pos := pos.next_x
    }
    next_x := pos
    prev_x := prv
    (next_x != NULL).if {
      next_x.set_prev_x self
    }
    (prev_x!=NULL).if {
      prev_x.set_next_x self
      new_root:=old_root
    } else {
      new_root:=self
    }

    new_root
  )

  - next_line old_root:Npedge :Npedge <-
  // Remove double link.
  ( + new_root:Npedge

    (next_y = NULL).if {
      // Remove
      (next_x!=NULL).if {
        next_x.set_prev_x prev_x
      }
      (prev_x!=NULL).if {
        prev_x.set_next_x next_x
        new_root:=old_root
      } else {
        new_root:=next_x
      }
    } else {
      // Replace next_y
      next_y.to_run
      next_y.set_next_x next_x
      next_y.set_prev_x prev_x
      (next_x!=NULL).if {
        next_x.set_prev_x next_y
      }
      (prev_x!=NULL).if {
        prev_x.set_next_x next_y
        new_root:=old_root
      } else {
        new_root:=next_y
      }
    }
    new_root
  )

  - new_step <-
  (
    width:=width-1
    x:=x+dx
  )

Private

  - to_run <-
  ( + dy:Int

    (is_point).if {
      // Point (Flat)
      x := x0 << 16
    } else {
      // Line
      dy := y1 - y0
      dx := ((x1 - x0)<<16) / dy
      x  := x0 << 16

      (next_y = NULL).if {
        width := dy
      } else {
        width := dy - 1
      }
    }
  )

  - display <-
  (
    '{'.print
    x0.print
    ','.print
    y0.print
    '-'.print
    x1.print
    ','.print
    y1.print
    '}'.print
  )

  - display_2 <-
  (
    '{'.print
    (x>>16).print
    ','.print
    y.print
    'W'.print
    width.print
    'D'.print
    dx.print
    'N'.print
    (next_y=NULL).if {
      "null".print
    } else {
      "=>".print
    }
    '@'.print
    Int.force_conversion self .print
    '}'.print
  )






