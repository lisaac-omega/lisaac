Header
  + name := Exact Separator
Inherit
  + parent_gobj:Flat Gobj Separator
  
Private
  - stk:Flat Array Separator
Public
  
  - width_min:Real32  <- is vertical.ok 16 or 0
  - height_min:Real32 <- is vertical.ok 0 or 16
  
  - vertical:Int := 1 << 15
  
  + col:Color
  - color c:Color  :Self <- (col := c; self)
  
  - new:Self <-
  ( + r:Self; (stk.is_empty).if { r := clone; } else { r := stk.pop; }; r)
  
  - free <- stk.add_last self
  
  - init_h:Self <- init_obj
  
  - init_v:Self <-
  (
    init_obj
    set vertical
    self
  )
    
  - draw <-
  ( + c:Color
    + v:Real32
    c := (col=Color).ok (Look.text_ui) or col
    begin_path
    stroke_color c
    stroke_width 1
    (is vertical).if {
      v := xo + width/2
      line (v,yo+2) to (v,ymax-2)
    } else {
      v := yo + height/2
      line (xo+2,v) to (xmax-2,v)
    }
    stroke
  )
