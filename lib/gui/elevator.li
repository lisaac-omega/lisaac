Header
  + name := Elevator
Inherit
  - parent_win:Win := Win
  
Private
  - get_y_h hu:Real32 :(Real32,Real32) <-
  ( + y,h:Real32
    h := (height * height / hu).max 16
    y := (height * pos_y / hu).min (height - h).max 0
    y,h
  )
  
  - get_x_w wu:Real32 :(Real32,Real32) <-
  ( + x,w:Real32
    w := (width * width / wu).max 16
    x := (width * pos_x / wu).min (width - w).max 0
    x,w
  )
      
Public
  
  + pos_x:Real32
  + pos_y:Real32
  
  - set_pos_x x:Real32 <- ( pos_x := x; )
  - set_pos_y y:Real32 <- ( pos_y := y; )
  - set_pos_xy (x,y:Real32) <- ( (pos_x,pos_y) := (x,y); )
  
  - width_upper:Real32
  - height_upper:Real32
  
  - draw_elevator <-
  ( + h,hu,w,wu,x,y,s,d:Real32
    (Hand.window_cur = window).if {
      ((hu := height_upper) > height).if {
        (Hand.y_cur.in_range yo to ymax).if {
          s := (32.0 - (Hand.x_cur.to_real32 - (xo+width-8)).abs.min 32).min 16.max 8
        } else { s := 8; }
        (y,h) := get_y_h hu
        begin_path
        fill_color (Look_gui.elevator_ui)
        rect (xo+width-s-4,yo+y+2) size (s-2,h-4) radius (s/2)
        fill
        (! Hand.press_cur).if {        
          (pos_y < 0).if {
            pos_y := (pos_y < 2).ok (Real32.zero) else {pos_y / 2}
            move_pos_y (pos_y - Old pos_y)
            ask_refresh
            Paper.refresh_again
          }
          ((d := hu - height - pos_y) < 0).if {            
            pos_y := pos_y + (d > -2).ok d else {d / 2}
            move_pos_y (pos_y - Old pos_y)
            ask_refresh
            Paper.refresh_again
          }
        }
      }
      ((wu := width_upper) > width).if {
        (Hand.x_cur.in_range xo to xmax).if {
          s := (32.0 - (Hand.y_cur.to_real32 - (yo+height-8)).abs.min 32).min 16.max 8
        } else { s := 8; }
        (x,w) := get_x_w wu
        begin_path
        fill_color (Look_gui.elevator_ui)
        rect (xo+x+2,yo+height-s-4) size (w-4,s-2) radius (s/2)
        fill
        (! Hand.press_cur).if {          
          (pos_x < 0).if {
            pos_x := (pos_x > -2).ok (Real32.zero) else {pos_x / 2}
            move_pos_x (pos_x - Old pos_x)
            Paper.refresh_again
            ask_refresh
          }
          ((d := wu - width - pos_x) < 0).if {
            pos_x := pos_x + (d > -2).ok d else {d / 2}
            move_pos_x (pos_x - Old pos_x)
            Paper.refresh_again
            ask_refresh
          }
        }
      }
    }
    /*
    begin_path
    stroke_width 1.0
    line (xmax-20, yo) to (xmax-20,ymax)
    stroke_color (COLOR.red)
    stroke
    */
  )
  
  - move_pos_y dy:Real32
  - move_pos_x dx:Real32
    
  - event_elevator ev:Int :Boolean <-
  ( - is_h,is_w:Boolean
    + w,h,x,y,wu,hu,dx,dy:Real32
    (ev & ~1 = Hand.drag).if {
      //ask_refresh
      ((wu := width_upper) > width).if {
        (Hand.is_begin).if {
          (x,w) := get_x_w wu; x := x + xo
          is_w := (Hand.y_begin > ymax - 20) && {Hand.x_begin.in_range x to (x+w)}
        }
        is_w.if {
          dx := Hand.dx * wu / width
          (pos_x + dx < -width).if      { dx := -width - pos_x; }
          (pos_x + dx > width_upper).if { dx := width_upper - pos_x; }
        } else { dx := - Hand.dx; }
        pos_x := pos_x + dx
        //dx.println
        move_pos_x dx
        //PAPER.refresh_again
        ask_refresh
      }
      ((hu := height_upper) > height).if {
        (Hand.is_begin).if {
          (y,h) := get_y_h hu; y := y + yo
          is_h := (Hand.x_begin > xmax - 20) && {Hand.y_begin.in_range y to (y+h)}
        }
        is_h.if {
          dy := Hand.dy * hu / height
          (pos_y + dy < -height).if      { dy := -height - pos_y; }
          (pos_y + dy > height_upper).if { dy := height_upper - pos_y; }
        } else { dy := - Hand.dy; }
        pos_y := pos_y + dy
        move_pos_y dy
        ask_refresh
      }
    }
  )
