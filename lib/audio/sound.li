  - seek_to_second second:Real32 :Int <-
  ( + sound_ptr:Pointer
    + result:Int
    sound_ptr := ma_sound
    (sound_ptr.is_null).if {
      result := Audio.invalid_operation
    } else {
      result := `ma_sound_seek_to_second((ma_sound *)@sound_ptr, @second)`:(Int)
    }
    result
