  - data_format channel_map:Pointer capacity capacity:Uint64
    :(Int,Int,Uint32,Uint32) <-
  ( + sound_ptr:Pointer
    + result,format:Int
    + channels,sample_rate:Uint32

    sound_ptr := ma_sound
    (sound_ptr.is_null).if {
      result := Audio.invalid_operation
    } else {
      result := `ma_sound_get_data_format((const ma_sound *)@sound_ptr, (ma_format *)&@format, &@channels, &@sample_rate, (ma_channel *)@channel_map, (size_t)@capacity)`:(Int)
    }
    result,format,channels,sample_rate
  )

