Header
  + name := Sound
/*
  Une voix ma_sound clonable attachee au moteur unique Audio.

  L'attribut ma_sound reste prive. Avant chaque appel C, sa valeur est copiee
  dans une variable locale qui seule est utilisee dans le bloc external C.
*/

Insert

  - parent_clone:Clone := Clone

Private

  + ma_sound:Pointer
  + sound_initialized:Boolean

  - allocate <-
  ( + sound_ptr:Pointer

    sound_ptr := `ma_calloc(sizeof(ma_sound), NULL)`:Pointer
    ma_sound := sound_ptr
  )

  - raw_handle:Pointer <- ma_sound

Public

  // Drapeaux de ma_sound_init_from_file().

  - flag_stream:Uint32            <- `MA_SOUND_FLAG_STREAM`:Uint32
  - flag_decode:Uint32            <- `MA_SOUND_FLAG_DECODE`:Uint32
  - flag_async:Uint32             <- `MA_SOUND_FLAG_ASYNC`:Uint32
  - flag_wait_init:Uint32         <- `MA_SOUND_FLAG_WAIT_INIT`:Uint32
  - flag_unknown_length:Uint32    <- `MA_SOUND_FLAG_UNKNOWN_LENGTH`:Uint32
  - flag_no_default_attachment:Uint32 <- `MA_SOUND_FLAG_NO_DEFAULT_ATTACHMENT`:Uint32
  - flag_no_pitch:Uint32          <- `MA_SOUND_FLAG_NO_PITCH`:Uint32
  - flag_no_spatialization:Uint32 <- `MA_SOUND_FLAG_NO_SPATIALIZATION`:Uint32
  - flag_looping:Uint32           <- `MA_SOUND_FLAG_LOOPING`:Uint32

  // Creation et destruction de la voix.

  - new:Self <-
  ( + result:Self

    result := clone
    result.allocate
    result
  )

  - init_from_file file:String :Int <-
    init_from_file file flags 0.to_uint32

  - init_from_file file:String flags flags:Uint32 :Int <-
    init_from_file file flags flags group NULL fence NULL

  - init_from_file file:String flags flags:Uint32
    group group:Pointer fence fence:Pointer :Int <-
  ( + engine_ptr,sound_ptr:Pointer
    + path:C_array Char
    + result:Int

    engine_ptr := Audio.handle
    sound_ptr := ma_sound

    (sound_ptr.is_null).if {
      allocate
      sound_ptr := ma_sound
    }

    ((engine_ptr.is_null) || {sound_ptr.is_null}).if {
      result := Audio.invalid_operation
    } else {
      sound_initialized.if {
        `ma_sound_uninit((ma_sound *)@sound_ptr)`
        sound_initialized := False
      }

      path := file.to_external
      result := `ma_sound_init_from_file((ma_engine *)@engine_ptr, @path, @flags, (ma_sound_group *)@group, (ma_fence *)@fence, (ma_sound *)@sound_ptr)`:(Int)
      sound_initialized := result = Audio.success
    }
    result
  )

  - config_new:Pointer <-
  // Configuration brute ma_sound_config. Le pointeur reste a l'appelant.
  // config_new utilise la variante recommandee par miniaudio 0.11.x.
  ( + engine_ptr,config_ptr:Pointer

    engine_ptr := Audio.handle
    config_ptr := `ma_calloc(sizeof(ma_sound_config), NULL)`:Pointer
    ((! config_ptr.is_null) && {! engine_ptr.is_null}).if {
      `*((ma_sound_config *)@config_ptr) = ma_sound_config_init_2((ma_engine *)@engine_ptr)`
    }
    config_ptr
  )

  - config_new_deprecated:Pointer <-
  ( + config_ptr:Pointer

    config_ptr := `ma_calloc(sizeof(ma_sound_config), NULL)`:Pointer
    (! config_ptr.is_null).if {
      `*((ma_sound_config *)@config_ptr) = ma_sound_config_init()`
    }
    config_ptr
  )

  - config_delete config:Pointer <-
  (
    (! config.is_null).if {
      `ma_free(@config, NULL)`
    }
  )

  - init_from_file_w file_w:Pointer flags flags:Uint32
    group group:Pointer fence fence:Pointer :Int <-
  ( + engine_ptr,sound_ptr:Pointer
    + result:Int

    engine_ptr := Audio.handle
    sound_ptr := ma_sound

    (sound_ptr.is_null).if {
      allocate
      sound_ptr := ma_sound
    }

    ((engine_ptr.is_null) || {sound_ptr.is_null}).if {
      result := Audio.invalid_operation
    } else {
      sound_initialized.if {
        `ma_sound_uninit((ma_sound *)@sound_ptr)`
        sound_initialized := False
      }

      result := `ma_sound_init_from_file_w((ma_engine *)@engine_ptr, (const wchar_t *)@file_w, @flags, (ma_sound_group *)@group, (ma_fence *)@fence, (ma_sound *)@sound_ptr)`:(Int)
      sound_initialized := result = Audio.success
    }
    result
  )

  - init_copy source:Self flags flags:Uint32 group group:Pointer :Int <-
  ( + engine_ptr,sound_ptr,source_ptr:Pointer
    + result:Int

    engine_ptr := Audio.handle
    sound_ptr := ma_sound
    source_ptr := source.raw_handle

    (sound_ptr.is_null).if {
      allocate
      sound_ptr := ma_sound
    }

    ((engine_ptr.is_null) || {sound_ptr.is_null} || {source_ptr.is_null}).if {
      result := Audio.invalid_operation
    } else {
      sound_initialized.if {
        `ma_sound_uninit((ma_sound *)@sound_ptr)`
        sound_initialized := False
      }

      result := `ma_sound_init_copy((ma_engine *)@engine_ptr, (const ma_sound *)@source_ptr, @flags, (ma_sound_group *)@group, (ma_sound *)@sound_ptr)`:(Int)
      sound_initialized := result = Audio.success
    }
    result
  )

  - init_from_data_source ds:C_array Uint8 :Int <- init_from_data_source ds flags 0 group NULL

  - init_from_data_source ds:C_array Uint8 flags flags:Uint32 :Int <- init_from_data_source ds flags flags group NULL

  - init_from_data_source ds:C_array Uint8 flags flags:Uint32 group group:Pointer :Int <-
  ( + engine_ptr,sound_ptr:Pointer
    + result:Int

    engine_ptr := Audio.handle
    sound_ptr := ma_sound

    (sound_ptr.is_null).if {
      allocate
      sound_ptr := ma_sound
    }

    ((engine_ptr.is_null) || {sound_ptr.is_null} || {ds = NULL}).if {
      result := Audio.invalid_operation
    } else {
      sound_initialized.if {
        `ma_sound_uninit((ma_sound *)@sound_ptr)`
        sound_initialized := False
      }

      result := `ma_sound_init_from_data_source((ma_engine *)@engine_ptr, (ma_data_source *)@ds, @flags, (ma_sound_group *)@group, (ma_sound *)@sound_ptr)`:(Int)
      sound_initialized := result = Audio.success
    }
    result
  )
  
Private
 
  + ma_decoder:Pointer // Utilise uniquement pour init_from_memory.

  + memory_buffer:C_array Uint8 // Buffer RAW externe. Sound ne le libere pas.
  + memory_buffer_size:Uint64
  
  - uninit_decoder <-
  ( + decoder_ptr:Pointer

    decoder_ptr := ma_decoder

    (! decoder_ptr.is_null).if {
      `ma_decoder_uninit((ma_decoder *)@decoder_ptr)`
      `ma_free(@decoder_ptr, NULL)`
      ma_decoder := NULL
    }

    memory_buffer := NULL
    memory_buffer_size := 0.to_uint64
  )
  
Public  
  
  - init_from_memory buffer:Pointer size size:Uint64 :Int <-
    init_from_memory buffer size size flags 0

  - init_from_memory buffer:Pointer size size:Uint64
    flags flags:Uint32 :Int <-
    init_from_memory buffer size size flags flags group NULL
  
  - init_from_memory buf:C_array Uint8 size size:Uint64 flags flags:Uint32 group group:Pointer :Int <-
  ( + engine_ptr,sound_ptr,decoder_ptr:Pointer
    + result:Int

    engine_ptr := Audio.handle
    sound_ptr := ma_sound

    (sound_ptr.is_null).if {
      allocate
      sound_ptr := ma_sound
    }

    ((engine_ptr.is_null) || {sound_ptr.is_null}).if {
      result := Audio.invalid_operation
    } else {

      // Si ce Sound etait deja initialise, detruire d'abord le ma_sound.
      sound_initialized.if {
        `ma_sound_uninit((ma_sound *)@sound_ptr)`
        sound_initialized := False
      }

      // Puis seulement sa precedente data source.
      uninit_decoder

      decoder_ptr := `ma_calloc(sizeof(ma_decoder), NULL)`:Pointer

      (decoder_ptr.is_null).if {
        result := Audio.out_of_memory
      } else {
        result := `ma_decoder_init_memory(@buf,(size_t)@size,NULL,(ma_decoder *)@decoder_ptr)`:(Int)

        (result = Audio.success).if {

          result := `ma_sound_init_from_data_source((ma_engine *)@engine_ptr,(ma_data_source *)@decoder_ptr,@flags,(ma_sound_group *)@group,(ma_sound *)@sound_ptr)`:(Int)

          (result = Audio.success).if {
            ma_decoder := decoder_ptr

            // On conserve ces informations pendant toute la vie du Sound.
            memory_buffer := buf
            memory_buffer_size := size

            sound_initialized := True
          } else {
            `ma_decoder_uninit((ma_decoder *)@decoder_ptr)`
            `ma_free(@decoder_ptr, NULL)`
          }
        } else {
          `ma_free(@decoder_ptr, NULL)`
        }
      }
    }

    result
  )
  
  - init_from_asset fn:String :Int <- init_from_asset fn flags 0 group NULL

  - init_from_asset fn:String flags flags:Uint32 :Int <- init_from_asset fn flags flags group NULL
  
  - init_from_asset fn:String flags flags:Uint32 group group:Pointer :Int <-
  ( + f:Pointer
    + buf:C_array Uint8
    + result,sz:Int
    
    f := System_io_default.asset_open fn
    (f.is_null).if {
      result := Audio.does_not_exist
    } else {      
      sz := System_io_default.asset_size f
      buf := C_array Uint8.create sz
      System_io_default.asset_read f in buf size sz      
      System_io_default.asset_close f
      //
      result := init_from_memory buf size sz flags flags group group      
    }
    result
  )
  
  - init_ex config:Pointer :Int <-
  ( + engine_ptr,sound_ptr:Pointer
    + result:Int

    engine_ptr := Audio.handle
    sound_ptr := ma_sound

    (sound_ptr.is_null).if {
      allocate
      sound_ptr := ma_sound
    }

    ((engine_ptr.is_null) || {sound_ptr.is_null} || {config.is_null}).if {
      result := Audio.invalid_operation
    } else {
      sound_initialized.if {
        `ma_sound_uninit((ma_sound *)@sound_ptr)`
        sound_initialized := False
      }

      result := `ma_sound_init_ex((ma_engine *)@engine_ptr, (const ma_sound_config *)@config, (ma_sound *)@sound_ptr)`:(Int)
      sound_initialized := result = Audio.success
    }
    result
  )


  - uninit <-
  ( + sound_ptr:Pointer

    sound_ptr := ma_sound
    ((! sound_ptr.is_null) && {sound_initialized}).if {
      `ma_sound_uninit((ma_sound *)@sound_ptr)`
      sound_initialized := False
    }
  )

  - delete <-
  ( + sound_ptr:Pointer

    uninit
    sound_ptr := ma_sound
    (! sound_ptr.is_null).if {
      `ma_free(@sound_ptr, NULL)`
      ma_sound := NULL
    }
  )

  - is_initialized:Boolean <- sound_initialized

