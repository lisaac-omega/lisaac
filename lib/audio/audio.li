Header
  + name := Audio
/*
  Moteur miniaudio unique et non clonable.

  L'attribut ma_engine reste prive. Chaque appel C utilise une variable locale
  contenant sa valeur : les attributs Lisaac ne sont jamais passes directement
  dans un bloc external C.
*/

  - lip <-
  (
    add_lib_i (lisaac+"deps_lib/");

    (target = "unix").if {
      //add_lib "-ldl";
      add_lib "-lpthread";
      add_lib "-lm";
    };

    (target = "android").if {
      //add_lib "-ldl";
      add_lib "-lm";
      add_lib "-llog";
      add_lib "-landroid";
    };
  )

  - include := `#define MINIAUDIO_IMPLEMENTATION
  #include "miniaudio.h"`

External
  
  - capture_to_wav_callback (dev,output,input:Pointer, frame_count:Uint32) <-
  // Callback utilise par record_wav. pUserData contient un ma_encoder*.
  ( + encoder_ptr:Pointer
    + result:Int

    encoder_ptr := `((ma_device *)@dev)->pUserData`:Pointer
    result := success

    ((! encoder_ptr.is_null) && {! input.is_null}).if {
      result := `ma_encoder_write_pcm_frames((ma_encoder *)@encoder_ptr, @input, (ma_uint64)@frame_count, NULL)`:(Int)
    }
    capture_result := result
  )

Private

  + ma_engine:Pointer
  + engine_initialized:Boolean

  + ma_encoder:Pointer  // Une seule capture est active a la fois, comme le moteur de sortie.
  + ma_device:Pointer
  + capture_result:Int

  - text_buffer:String_buffer := String_buffer.create 128

Public
    
  // Resultats miniaudio.

  - success:Int           <- `MA_SUCCESS`:Int
  - out_of_memory:Int     <- `MA_OUT_OF_MEMORY`:Int
  - invalid_operation:Int <- `MA_INVALID_OPERATION`:Int
  - does_not_exist:Int <- `MA_DOES_NOT_EXIST`:Int

  - result_description result:Int :String_alias <-
  ( + description:C_array Char

    description := `ma_result_description((ma_result)@result)`:C_array Char
    text_buffer.from_external_copy description
    text_buffer.to_string_alias
  )

  // Cycle de vie du ma_engine unique.

  - init:Int <-
  ( + engine_ptr:Pointer
    + result:Int

    result := success
    (! engine_initialized).if {
      engine_ptr := ma_engine

      (engine_ptr.is_null).if {
        engine_ptr := `ma_calloc(sizeof(ma_engine), NULL)`:Pointer
        ma_engine := engine_ptr
      }

      (engine_ptr.is_null).if {
        result := out_of_memory
      } else {
        result := `ma_engine_init(NULL, (ma_engine *)@engine_ptr)`:(Int)
        engine_initialized := result = success
      }
    }
    result
  )

  - uninit <-
  ( + engine_ptr:Pointer

    engine_ptr := ma_engine
    ((! engine_ptr.is_null) && {engine_initialized}).if {
      `ma_engine_uninit((ma_engine *)@engine_ptr)`
      engine_initialized := False
    }
    (! engine_ptr.is_null).if {
      `ma_free(@engine_ptr, NULL)`
      ma_engine := NULL
    }
  )

  - is_initialized:Boolean <- engine_initialized

  - start:Int <-
  ( + engine_ptr:Pointer
    + result:Int

    engine_ptr := ma_engine
    (engine_ptr.is_null).if {
      result := invalid_operation
    } else {
      result := `ma_engine_start((ma_engine *)@engine_ptr)`:(Int)
    }
    result
  )

  - stop:Int <-
  ( + engine_ptr:Pointer
    + result:Int

    engine_ptr := ma_engine
    (engine_ptr.is_null).if {
      result := invalid_operation
    } else {
      result := `ma_engine_stop((ma_engine *)@engine_ptr)`:(Int)
    }
    result
  )

  - play file:String :Int <- play file in NULL

  - play file:String in group:Pointer :Int <-
  ( + engine_ptr:Pointer
    + path:C_array Char
    + result:Int

    engine_ptr := ma_engine
    (engine_ptr.is_null).if {
      result := invalid_operation
    } else {
      path := file.to_external
      result := `ma_engine_play_sound((ma_engine *)@engine_ptr, @path, (ma_sound_group *)@group)`:(Int)
    }
    result
  )

  - set_volume volume:Real32 :Int <-
  ( + engine_ptr:Pointer
    + result:Int

    engine_ptr := ma_engine
    (engine_ptr.is_null).if {
      result := invalid_operation
    } else {
      result := `ma_engine_set_volume((ma_engine *)@engine_ptr, @volume)`:(Int)
    }
    result
  )

  - volume:Real32 <-
  ( + engine_ptr:Pointer
    + result:Real32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_volume((ma_engine *)@engine_ptr)`:Real32
    }
    result
  )

  - sample_rate:Uint32 <-
  ( + engine_ptr:Pointer
    + result:Uint32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_sample_rate((ma_engine *)@engine_ptr)`:Uint32
    }
    result
  )

  - time_in_pcm_frames:Uint64 <-
  ( + engine_ptr:Pointer
    + result:Uint64

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_time_in_pcm_frames((ma_engine *)@engine_ptr)`:Uint64
    }
    result
  )

  - set_time_in_pcm_frames frame:Uint64 :Int <-
  ( + engine_ptr:Pointer
    + result:Int

    engine_ptr := ma_engine
    (engine_ptr.is_null).if {
      result := invalid_operation
    } else {
      result := `ma_engine_set_time_in_pcm_frames((ma_engine *)@engine_ptr, @frame)`:(Int)
    }
    result
  )

  // API ma_engine_* complementaire.
  // Toutes les fonctions publiques de ma_engine exposees par miniaudio.h
  // sont disponibles ici sans repasser le ma_engine en parametre.

  - config_new:Pointer <-
  ( + config_ptr:Pointer

    config_ptr := `ma_calloc(sizeof(ma_engine_config), NULL)`:Pointer
    (! config_ptr.is_null).if {
      `*((ma_engine_config *)@config_ptr) = ma_engine_config_init()`
    }
    config_ptr
  )

  - config_delete config:Pointer <-
  (
    (! config.is_null).if {
      `ma_free(@config, NULL)`
    }
  )

  - init_with config:Pointer :Int <-
  ( + engine_ptr:Pointer
    + result:Int

    result := success
    (! engine_initialized).if {
      engine_ptr := ma_engine

      (engine_ptr.is_null).if {
        engine_ptr := `ma_calloc(sizeof(ma_engine), NULL)`:Pointer
        ma_engine := engine_ptr
      }

      (engine_ptr.is_null).if {
        result := out_of_memory
      } else {
        result := `ma_engine_init((const ma_engine_config *)@config, (ma_engine *)@engine_ptr)`:(Int)
        engine_initialized := result = success
      }
    }
    result
  )

  - read_pcm_frames frames_out:Pointer
    count frame_count:Uint64 read frames_read:Pointer :Int <-
  ( + engine_ptr:Pointer
    + result:Int

    engine_ptr := ma_engine
    (engine_ptr.is_null).if {
      result := invalid_operation
    } else {
      result := `ma_engine_read_pcm_frames((ma_engine *)@engine_ptr, @frames_out, @frame_count, (ma_uint64 *)@frames_read)`:(Int)
    }
    result
  )

  - node_graph:Pointer <-
  ( + engine_ptr,result:Pointer

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_node_graph((ma_engine *)@engine_ptr)`:Pointer
    }
    result
  )

  - resource_manager:Pointer <-
  ( + engine_ptr,result:Pointer

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_resource_manager((ma_engine *)@engine_ptr)`:Pointer
    }
    result
  )

  - device:Pointer <-
  ( + engine_ptr,result:Pointer

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_device((ma_engine *)@engine_ptr)`:Pointer
    }
    result
  )

  - log:Pointer <-
  ( + engine_ptr,result:Pointer

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_log((ma_engine *)@engine_ptr)`:Pointer
    }
    result
  )

  - endpoint:Pointer <-
  ( + engine_ptr,result:Pointer

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_endpoint((ma_engine *)@engine_ptr)`:Pointer
    }
    result
  )

  - time_in_milliseconds:Uint64 <-
  ( + engine_ptr:Pointer
    + result:Uint64

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_time_in_milliseconds((const ma_engine *)@engine_ptr)`:Uint64
    }
    result
  )

  - set_time_in_milliseconds time:Uint64 :Int <-
  ( + engine_ptr:Pointer
    + result:Int

    engine_ptr := ma_engine
    (engine_ptr.is_null).if {
      result := invalid_operation
    } else {
      result := `ma_engine_set_time_in_milliseconds((ma_engine *)@engine_ptr, @time)`:(Int)
    }
    result
  )

  - time:Uint64 <-
  //  Alias generique fourni par miniaudio.
  ( + engine_ptr:Pointer
    + result:Uint64

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_time((const ma_engine *)@engine_ptr)`:Uint64
    }
    result
  )

  - set_time time:Uint64 :Int <-
  ( + engine_ptr:Pointer
    + result:Int

    engine_ptr := ma_engine
    (engine_ptr.is_null).if {
      result := invalid_operation
    } else {
      result := `ma_engine_set_time((ma_engine *)@engine_ptr, @time)`:(Int)
    }
    result
  )

  - channels:Uint32 <-
  ( + engine_ptr:Pointer
    + result:Uint32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_channels((const ma_engine *)@engine_ptr)`:Uint32
    }
    result
  )

  - set_gain_db gain_db:Real32 :Int <-
  ( + engine_ptr:Pointer
    + result:Int

    engine_ptr := ma_engine
    (engine_ptr.is_null).if {
      result := invalid_operation
    } else {
      result := `ma_engine_set_gain_db((ma_engine *)@engine_ptr, @gain_db)`:(Int)
    }
    result
  )

  - gain_db:Real32 <-
  ( + engine_ptr:Pointer
    + result:Real32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_gain_db((ma_engine *)@engine_ptr)`:Real32
    }
    result
  )

  - listener_count:Uint32 <-
  ( + engine_ptr:Pointer
    + result:Uint32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_get_listener_count((const ma_engine *)@engine_ptr)`:Uint32
    }
    result
  )

  - closest_listener_to x:Real32 y y:Real32 z z:Real32 :Uint32 <-
  ( + engine_ptr:Pointer
    + result:Uint32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_find_closest_listener((const ma_engine *)@engine_ptr, @x, @y, @z)`:Uint32
    }
    result
  )

  - listener_set_position index:Uint32 x x:Real32 y y:Real32 z z:Real32 <-
  ( + engine_ptr:Pointer

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      `ma_engine_listener_set_position((ma_engine *)@engine_ptr, @index, @x, @y, @z)`
    }
  )

  - listener_position index:Uint32 :(Real32,Real32,Real32) <-
  ( + engine_ptr:Pointer
    + x,y,z:Real32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      x := `ma_engine_listener_get_position((const ma_engine *)@engine_ptr, @index).x`:Real32
      y := `ma_engine_listener_get_position((const ma_engine *)@engine_ptr, @index).y`:Real32
      z := `ma_engine_listener_get_position((const ma_engine *)@engine_ptr, @index).z`:Real32
    }
    x,y,z
  )

  - listener_set_direction index:Uint32 x x:Real32 y y:Real32 z z:Real32 <-
  ( + engine_ptr:Pointer

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      `ma_engine_listener_set_direction((ma_engine *)@engine_ptr, @index, @x, @y, @z)`
    }
  )

  - listener_direction index:Uint32 :(Real32,Real32,Real32) <-
  ( + engine_ptr:Pointer
    + x,y,z:Real32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      x := `ma_engine_listener_get_direction((const ma_engine *)@engine_ptr, @index).x`:Real32
      y := `ma_engine_listener_get_direction((const ma_engine *)@engine_ptr, @index).y`:Real32
      z := `ma_engine_listener_get_direction((const ma_engine *)@engine_ptr, @index).z`:Real32
    }
