  - listener_set_cone index:Uint32
    inner inner_angle:Real32 outer outer_angle:Real32 gain outer_gain:Real32 <-
  ( + engine_ptr:Pointer

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      `ma_engine_listener_set_cone((ma_engine *)@engine_ptr, @index, @inner_angle, @outer_angle, @outer_gain)`
    }
  )

  - listener_cone index:Uint32 :(Real32,Real32,Real32) <-
  ( + engine_ptr:Pointer
    + inner_angle,outer_angle,outer_gain:Real32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      `ma_engine_listener_get_cone((const ma_engine *)@engine_ptr, @index, &@inner_angle, &@outer_angle, &@outer_gain)`
    }
    inner_angle,outer_angle,outer_gain
  )

  - listener_set_world_up index:Uint32 x x:Real32 y y:Real32 z z:Real32 <-
  ( + engine_ptr:Pointer

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      `ma_engine_listener_set_world_up((ma_engine *)@engine_ptr, @index, @x, @y, @z)`
    }
  )

  - listener_world_up index:Uint32 :(Real32,Real32,Real32) <-
  ( + engine_ptr:Pointer
    + x,y,z:Real32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      x := `ma_engine_listener_get_world_up((const ma_engine *)@engine_ptr, @index).x`:Real32
      y := `ma_engine_listener_get_world_up((const ma_engine *)@engine_ptr, @index).y`:Real32
      z := `ma_engine_listener_get_world_up((const ma_engine *)@engine_ptr, @index).z`:Real32
    }
    x,y,z
  )

  - listener_set_enabled index:Uint32 enabled enabled:Boolean <-
  ( + engine_ptr:Pointer
    + value:Int

    engine_ptr := ma_engine
    value := enabled.to_int
    (! engine_ptr.is_null).if {
      `ma_engine_listener_set_enabled((ma_engine *)@engine_ptr, @index, (ma_bool32)@value)`
    }
  )

  - listener_is_enabled index:Uint32 :Boolean <-
  ( + engine_ptr:Pointer
    + result:Boolean

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      result := `ma_engine_listener_is_enabled((const ma_engine *)@engine_ptr, @index)`:Int != 0
    }
    result
  )

  - play file:String into node:Pointer bus bus_index:Uint32 :Int <-
  ( + engine_ptr:Pointer
    + path:C_array Char
    + result:Int

    engine_ptr := ma_engine
    (engine_ptr.is_null).if {
      result := invalid_operation
    } else {
      path := file.to_external
      result := `ma_engine_play_sound_ex((ma_engine *)@engine_ptr, @path, (ma_node *)@node, @bus_index)`:(Int)
    }
    result
  )

  - listener_index_closest:Uint32 <- `MA_LISTENER_INDEX_CLOSEST`:Uint32
  - max_listeners:Uint32          <- `MA_ENGINE_MAX_LISTENERS`:Uint32


Public // Utilise uniquement par Sound.

  - handle:Pointer <- ma_engine

Public

  // Capture WAV unique. Cette partie permet de conserver le troisieme exemple
  // sans ajouter un troisieme prototype pour le moment.

  - record_wav file:String channels chs:Uint32 rate smp_rate:Uint32 :Int <-
  ( + encoder_ptr,encoder_config_ptr:Pointer
    + device_ptr,device_config_ptr:Pointer
    + path:C_array Char
    + result:Int
    + encoder_ok,device_ok:Boolean

    stop_recording
    capture_result := success

    encoder_ptr := `ma_calloc(sizeof(ma_encoder), NULL)`:Pointer
    encoder_config_ptr := `ma_calloc(sizeof(ma_encoder_config), NULL)`:Pointer
    device_ptr := `ma_calloc(sizeof(ma_device), NULL)`:Pointer
    device_config_ptr := `ma_calloc(sizeof(ma_device_config), NULL)`:Pointer

    (
      encoder_ptr.is_null || {encoder_config_ptr.is_null} || {device_ptr.is_null} || {device_config_ptr.is_null}
    ).if {
      result := out_of_memory
    } else {
      `*((ma_encoder_config *)@encoder_config_ptr) = ma_encoder_config_init(ma_encoding_format_wav, ma_format_s16, @chs, @smp_rate)`

      path := file.to_external
      result := `ma_encoder_init_file(@path, (const ma_encoder_config *)@encoder_config_ptr, (ma_encoder *)@encoder_ptr)`:(Int)
      encoder_ok := result = success

      (encoder_ok).if {
        `*((ma_device_config *)@device_config_ptr) = ma_device_config_init(ma_device_type_capture)`
        `((ma_device_config *)@device_config_ptr)->capture.format = ma_format_s16`
        `((ma_device_config *)@device_config_ptr)->capture.channels = @chs`
        `((ma_device_config *)@device_config_ptr)->sampleRate = @smp_rate`
        `((ma_device_config *)@device_config_ptr)->dataCallback = (ma_device_data_proc)capture_to_wav_callback`
        `((ma_device_config *)@device_config_ptr)->pUserData = @encoder_ptr`

        result := `ma_device_init(NULL, (const ma_device_config *)@device_config_ptr, (ma_device *)@device_ptr)`:(Int)
        device_ok := result = success
      }

      (device_ok).if {
        result := `ma_device_start((ma_device *)@device_ptr)`:(Int)
        (result = success).if {
          ma_encoder := encoder_ptr
          ma_device := device_ptr
        }
      }
    }

    (! encoder_config_ptr.is_null).if {
      `ma_free(@encoder_config_ptr, NULL)`
    }
    (! device_config_ptr.is_null).if {
      `ma_free(@device_config_ptr, NULL)`
    }

    (result != success).if {
      (device_ok).if {
        `ma_device_uninit((ma_device *)@device_ptr)`
      }
      (encoder_ok).if {
        `ma_encoder_uninit((ma_encoder *)@encoder_ptr)`
      }
      (! device_ptr.is_null).if {
        `ma_free(@device_ptr, NULL)`
      }
      (! encoder_ptr.is_null).if {
        `ma_free(@encoder_ptr, NULL)`
      }
    }
    result
  )

  - stop_recording <-
  ( + device_ptr,encoder_ptr:Pointer

    device_ptr := ma_device
    encoder_ptr := ma_encoder

    (! device_ptr.is_null).if {
      `ma_device_uninit((ma_device *)@device_ptr)`
      `ma_free(@device_ptr, NULL)`
      ma_device := NULL
    }

    (! encoder_ptr.is_null).if {
      `ma_encoder_uninit((ma_encoder *)@encoder_ptr)`
      `ma_free(@encoder_ptr, NULL)`
      ma_encoder := NULL
    }
  )

  - is_recording:Boolean <-
  ( + device_ptr:Pointer
    + result:Boolean

    device_ptr := ma_device
    (! device_ptr.is_null).if {
      result := `ma_device_is_started((ma_device *)@device_ptr)`:Int != 0
    }
    result
  )

  - capture_write_result:Int <- capture_result
  