  - listener_set_velocity index:Uint32 x x:Real32 y y:Real32 z z:Real32 <-
  ( + engine_ptr:Pointer

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      `ma_engine_listener_set_velocity((ma_engine *)@engine_ptr, @index, @x, @y, @z)`
    }
  )

  - listener_velocity index:Uint32 :(Real32,Real32,Real32) <-
  ( + engine_ptr:Pointer
    + x,y,z:Real32

    engine_ptr := ma_engine
    (! engine_ptr.is_null).if {
      x := `ma_engine_listener_get_velocity((const ma_engine *)@engine_ptr, @index).x`:Real32
      y := `ma_engine_listener_get_velocity((const ma_engine *)@engine_ptr, @index).y`:Real32
      z := `ma_engine_listener_get_velocity((const ma_engine *)@engine_ptr, @index).z`:Real32
