Header
  + name := String_buffer
Inherit
  + inherit_string:Flat String
  - parent_arrayed:Arrayed := Arrayed  
Public

  + capacity:Int

  // General :

  - set_storage tab:C_array(Char) <-
  ( ? {tab != NULL}
    storage := tab
  )

  // Creation / Modification :

  - new self:Self capacity c:Int :Self <-
  ( + result:Self
    result := Self.clone
    result.make c
    result
  )
  [
    Result.is_empty
  ]
  
  - create needed_capacity:Int :Self <- new Self capacity needed_capacity

  - create_from_string str:String :Self <-
  ( + result:Self
    result := create (str.count)
    result.copy str
    result
  )

  - make needed_capacity:Int <-
  // Initialize the string to have at least @needed_capacity
  // characters of storage.
  ( ? {needed_capacity >= 0}
    (needed_capacity > 0).if {
      (capacity < needed_capacity).if {
        storage := C_array Char.create needed_capacity
        capacity := needed_capacity
      }
    }
    upper := -1

    //? {needed_capacity <= capacity}
    //? {count = 0}
  )

  - make_empty <-
  // Create an empty string
  (
    make 0
  )

  - create_filled (c:Char,n:Int) :Self <-
  ( + result:Self
    result := Self.clone
    result.make_filled (c,n)
    result
  )

  - make_filled (c:Char,n:Int) <-
  // Initialize string with @n copies of @c
  [
    -? {n >= 0}
  ]
  (
    make n
    upper := n-1
    fill_with c
  )
  [
    +? {count = n}
    +? {occurrences c = count}
  ]

  - twin:Self <-
  (
    create_from_string self
  )
  
  - create_from_external p:C_array Char :Self <-
  ( + result:Self
    result := clone
    result.from_external p
    result
  )
  
  - to_string_alias:String_alias <- Alias Self To String_alias.register self
  
Public  
//Section ALIAS TO
  
  - create_alias:String_alias <-
  ( + up:Int
    + new_stor:C_array Char
    + result:String_alias
    up := upper
    (up > -1).if {
      new_stor := C_array Char.create (up+2)
      new_stor.copy_from storage until up
      new_stor.at (up+1) put '\0'
      result := String_alias.create new_stor upper up
    } else {
      result := ""
    }
    result
  )
  
  - is_equal_alias other:String_alias :Boolean <-
  ( + result:Boolean
    (upper = other.upper).if {
      (upper = -1).if {
        result := True
      } else {
        result:=storage.fast_memcmp (other.storage) until upper
      }
    }
    result
  )
  
Public
  
  // Modification :

  - resize new_count:Int <-
  // Resize self. When @new_count is greater than @count,
  // new positions are initialized with the default value of Char
  [
    -? { new_count >= 0 }
  ]
  (
    (new_count <= count).if {
    }.elseif { capacity < new_count } then {
      (capacity = 0).if {
        storage := C_array(Char).create new_count
      } else {
        storage := storage.realloc capacity with new_count
      }
      capacity := new_count
    } else {
      storage.clear count to (new_count - 1)
    }
    upper := new_count-1
  )
  [
    +? {count = new_count}
    +? {capacity >= Old capacity}
  ]

  - prepare_space n:Int <-
  // Makes sure that we have at least @n places, ready to use, after @upper.
  [
    deprecated True msg "Still used ? DC Jan 2026"
    ? {n > 0}
  ]
  (
    (upper - (capacity - 1) < n).if {
      set_capacity (2 * capacity)
    }
  )
  [
    ? {upper = Old upper}
  ]
  
  - clear <-
  // Clear out the current String_buffer.
  // Note: internal @storage memory is neither released nor shrunk.
  (
    upper := -1
    ? {count = 0}
  )

  - copy other:String<-
  // Copy @other onto @self.
  (
    upper := other.upper
    (upper >= 0).if {
      (capacity < count).if {
        storage  := C_array(Char).create count
        capacity := count
      }
      storage.copy_from (other.storage) until upper
    }
    ? {count = other.count}
  )
  
  - copy other:String from l:Int to e:Int <-
  ( + cnt:Int
    cnt := e-l+1
    (capacity < cnt).if {
      storage  := C_array(Char).create cnt
      capacity := cnt
    }
    upper := cnt - 1
    storage.copy_from (other.storage+l) until upper
  )

  - fill_with c:Char <-
  // Replace every character with @c.
  (
    storage.set_all_with c until upper

    ? {occurrences c = count}
  )

  - replace_all old_char:Char with new_char:Char <-
  // Replace all occurrences of the element @old_char by @new_character
  (
    storage.fast_replace_all old_char with new_char until upper
  )
  [
    +? { count = Old count }
    +? { occurrences old_char = 0}
  ]

  - append other:String <-
  // Append @other to @self.
  ( + other_count, needed_capacity:Int
    ? {other != NULL}

    other_count := other.count
    needed_capacity := count + other_count
    (capacity < needed_capacity).if {
      (capacity = 0).if {
        capacity := needed_capacity
        storage  := C_array(Char).create capacity
      } else {
        storage  := storage.realloc capacity with needed_capacity
        capacity := needed_capacity
      }
    }
    storage.copy (other.storage) to count until other_count
    upper := needed_capacity - 1
  )
  
  - append other:String from b:Int to e:Int<-
  // Append @other to @self.
  [ ? {b.in_range 0 to (other.upper)}
    ? {e.in_range 0 to (other.upper)}
    ? {b <= e}
  ]
  ( + other_count, needed_capacity:Int
    ? {other != NULL}

    other_count := e - b + 1
    needed_capacity := count + other_count
    (capacity < needed_capacity).if {
      (capacity = 0).if {
        capacity := needed_capacity
        storage  := C_array(Char).create capacity
      } else {
        storage  := storage.realloc capacity with needed_capacity
        capacity := needed_capacity
      }
    }
    storage.slice_copy (other.storage) to count from b to e
    upper := needed_capacity - 1
  )
    
  - self:Self '#' e:E :Self <- ( e.append_in self; self)
  
  - self:Self '|#' e:E :Self <- ( clear; e.append_in self; self)
  
  - self:Self '##' (e:E,a:Int,c:Char) :Self <-
  ( + u,n:Int
    u := upper
    e.append_in self
    n := a - (upper - u)
    (n > 0).if {
      insert c to (u+1) on n
    }
    self
  )
  
  - prepend other:String from b:Int to e:Int<-
  // Append @other to @self.
  [ ? {b.in_range 0 to (other.upper)}
    ? {e.in_range 0 to (other.upper)}
    ? {b <= e}
  ]
  ( + other_count, needed_capacity:Int
    ? {other != NULL}

    other_count := e - b + 1
    needed_capacity := count + other_count
    (capacity < needed_capacity).if {
      (capacity = 0).if {
        capacity := needed_capacity
        storage  := C_array Char.create capacity
      } else {
        storage  := storage.realloc capacity with needed_capacity
        capacity := needed_capacity
      }
    }
    storage.move 0 to upper by other_count
    storage.slice_copy (other.storage) to 0 from b to e
    upper := needed_capacity - 1
  )
  
  - self:Self '|' c:Char :String_buffer <-
  (
    add_last c
    self
  )
    
  - self:Self '+#' Left 60 other:Int :String_buffer <-
  (
    other.append_in self
    self
  )
  
  - self:Self '+=' other:String :String_buffer <-
  (
    append other
    self
  )

  - prepend other:String <-
  // Prepend @other to @self
  [
    ? {other != NULL}
  ]
  ( + i, j: Int
    
    j := other.upper
    (j != -1).if {
      i := upper
      resize (i + j + 2)
      ((i >= 0) && {j >= 0}).if {
        storage.move 0 to i by (j+1)
      }
      storage.copy_from (other.storage) until j
    }
  )

  - insert_string s:String to i:Int <-
  // Insert @s at index @i, shifting characters from index @i
  // to @count rightwards.
  ( + j,k:Int

    ? { s != NULL }
    ? { i.in_range 0 to count}

    j := upper
    k := s.count
    resize (j + k + 1)
    (i <= j).if {
      storage.move i to j by k
    }
    storage.copy (s.storage) to i until k
  )

  - replace_substring s:String from start:Int to end:Int <-
  // Replace the substring from start to end, inclusive, with s
  ( + difference, old_upper: Int

    ? {s != NULL}
    ? { end <= upper}
    ? {start.in_range 0 to (end + 1)}
    difference := s.upper - end + start
    (difference != 0).if {
      old_upper  := upper
      resize (old_upper + difference + 1)
      (end < old_upper).if { 
        storage.move (end + 1) to old_upper by difference
      }
    }
    storage.copy (s.storage) to start until (s.upper+1)
  )

  - replace_all_substring motif:String with txt:String <-
  ( + idx:Int

    idx := lower
    {
      idx := substring_index (motif,idx)
      (idx != -1).if {
        replace_substring txt from idx to (idx+motif.upper)
        idx := idx + txt.count
      }
    }.do_while {idx != -1}
  )
  
  - replace_all_substring motif:String with txt:String from start:Int <-
  [ ? {start.in_range 0 to upper}; ]
  ( + idx:Int

    idx := start
    {
      idx := substring_index (motif,idx)
      (idx != -1).if {
        replace_substring txt from idx to (idx+motif.upper)
        idx := idx + txt.count
      }
    }.do_while {idx != -1}
  )

  - at i:Int put c:Char <-
  [
    ? {valid_index i}
  ]
  (
    storage.at i put c
  )
    
  - put c:Char to i:Int <- storage.at i put c
  // BSBS -> DOM Pour que je puisse travailler ...
  
  - swap i1:Int with i2: Int <-
  [
    ? {valid_index i1}
    ? {valid_index i2}
  ]
  ( + t:Char
    t := at i1
    at i1 put (at i2)
    at i2 put t
  )
  [
    ? {at i1 = Old at i2}
    ? {at i2 = Old at i1}
  ]
  
  - at i:Int add c:Char <- insert c to i
  
  - insert ch:Char to index:Int <-
  // Insert @ch after position @index.
  ( + i:Int
    ? {0 <= index}
    ? {index <= count}

    i := upper
    extend ' '
    {i >= index}.while_do {
      at (i + 1) put (at i)
      i := i - 1
    }
    at index put ch

    ? {at index = ch}
  )
  
  - escape_char c:Char <-
  // Example: "2 + 4".escape_char '+' => "2 \+ 4"
  ( + i:Int
    i := index_of c
    {i <= upper}.while_do {
      insert '\\' to i
      i := index_of c since (i+2)
    }
  )
  
  - escape <-
  ( + i:Int
    i := upper
    {i >= 0}.while_do {
      at i
      .when '\n' then { remove i; insert_string "\\n" to i }
      .when '\t' then { remove i; insert_string "\\t" to i }
      .when '"'  then { insert '\\' to i }
      .when '\'' then { insert '\\' to i }
      .when '\\' then { insert '\\' to i }
      i := i - 1
    }
  )
  
  - insert ch:Char to i:Int on nb:Int <-
  // Insert @ch after position @i.
  [
    ? {0 <= i}
    ? {i <= count}
    ? {nb > 0}
  ]
  ( resize (count+nb)
    storage.move i to upper by nb
    i.to (i+nb-1) do { j:Int; storage.at j put ch; }
  )

  - shrink min_index:Int to max_index:Int <-
  // Keep only the slice [@min_index .. @max_index] or nothing
  // when the slice is empty.
  (
    ? {0 <= min_index}
    ? {max_index <= upper}
    ? {min_index <= max_index + 1}

    (max_index < min_index).if {
      upper := -1
    } else {
      (min_index = 0).if {
        upper := max_index
      } else {
        storage.slice_copy storage to 0 from min_index to max_index
        upper := max_index - min_index + 1
      }
    }

    ? {upper = max_index - min_index + 1}
  )

  - remove index:Int <-
  // Remove character at position @index.
  ( ? {valid_index index}
    remove index to index
    ? {count = Old count - 1}
  )

  - add_first ch: Char <-
  // Add @ch at first position.
  ( 
    add_last ' '
    upper.downto 1 do { i:Int
      at i put (at (i - 1))
    }
    at 0 put ch

    ? {count = 1 + Old count}
    ? {at 0 = ch}
  )

  - add_last ch:Char <-
  // Append @ch to string
  ( + new_capacity:Int
    
    (capacity = count).if {
      (capacity = 0).if {
        capacity := 32
        storage  := C_array(Char).create capacity
      } else {
        new_capacity := capacity * 2
        storage      := storage.realloc capacity with new_capacity
        capacity     := new_capacity
      }
    }
    upper := upper + 1
    storage.at upper put ch

    ? {count = 1 + Old count}
    ? {at upper = ch}
  )
  
  - put_last c:Char <- at upper put c
  
  - append_character c:Char <- add_last c

  - extend c:Char <- add_last c

  -  append_utf8 utf8: String <- append_utf8 (utf8.storage) native
  
  -  append_utf8 utf8: C_array Char native <-
  ( + i:Int
    + cu:Uint8
    cu := utf8.first
    add_last (utf8.first)
    i := 1 
    if ((cu & 1000_0000b) != 0) then {
      add_last (utf8.at i)
      i := i + 1
      if ((cu & 1110_0000b) = 1110_0000b) then {
        add_last (utf8.at i)
        i := i + 1
        if ((cu & 1111_0000b) = 1111_0000b) then {
          add_last (utf8.at i)
        }
      }
    }
  )

  - to_lower <-
  // Convert all characters to lower case.
  (
    upper.downto 0 do { i:Int
      at i put (at i.to_lower)
    }
  )

  - to_upper <-
  // Convert all characters to upper case.
  (
    upper.downto 0 do { i:Int
      at i put (at i.to_upper)
    }
  )

  - keep_head n:Int <-
  // Remove all characters except for the first @n. 
  // Do nothing if @n @>= @count.
  ( ? { n >= 0}
    
    (n < count).if {
      remove_tail (count - n)
    }

    ? { count = n.min (Old count)}
  )

  - keep_tail n:Int <-
  // Remove all characters except for the last @n.
  // Do nothing if @n @>= @count.
  [ 
    n >= 0 
  ]
  ( 
    if (n < count) then {
      remove_head (count - n)
    }
  )
  [
    count = n.min (Old count)
  ]
  
  - remove_first <- remove_head 1
  
  - remove_head n:Int <-
  // Remove @n first characters.
  // If @n >= @count, remove all.
  [ ? { n >= 0}; ]
  (         
    (n > upper).if {
      upper := -1
    } else {
      (n > 0).if {
        remove 0 to (n-1)
      }
    }

    ? { count = 0.max (Old count - n)}
  )

  - remove start:Int to end:Int <-
  // Remove all characters from @start_index to @end_index inclusive.
  // BSBS: ce ne serait pas plus simple `remove to'
  (
    + len:Int
    ? { end <= upper }
    ? { start.in_range 0 to (end + 1)}

    len := end - start + 1
    (len > 0).if {
      (end + 1).to upper do { i:Int
        at (i - len) put (at i)
      }
      upper := upper - len
    }
    ? {count = (Old count - (end - start + 1))}
  )

  - remove_suffix s:String <-
  // Remove the suffix @s of current string.
  (
    ? {has_suffix s}
    remove_tail (s.count)
  )

  - remove_tail n:Int <-
  // Remove @n last characters. If @n >= @count, remove all.    
  [ ?{ n >= 0 }; ]
  ( 
    (n > upper).if {
      upper := -1
    } else {
      upper := upper - n
    }
  )
  [ ? {count = 0.max (Old count - n)}; ]

  - remove_last <-
  (
    remove_tail 1
  )

  - remove_prefix s:String <-
  // Remove the prefix @s of current string.
  (
    ? {has_prefix s}
    remove_head (s.count)
  )

  - left_adjust <-
  // Remove leading blanks.
  (+ i: Int
    i := -1
    {((i + 1) > upper) || {at (i + 1) != ' '}}.until_do {
      i := i + 1
    }
    remove_first i
    ? {is_empty || {at 0 != ' '}}
  )

  - right_adjust <-
  // Remove trailing blanks.
  ( + i:Int
    
    i := upper
    {(i = -1) || {at i != ' '}}.until_do {
      i := i - 1
    }
    upper := i
    
    ? {is_empty || {at upper != ' '}}
  )

  - extend_multiple c:Char by n:Int <-
  // Extend self with @n times character @c.
  ( ? { n >= -1}
        
    (n - 1).downto 0 do { i:Int
      add_last c
    }

    ? {count = n + Old count}
  )

  - precede_multiple c:Char by n:Int <-
  // Prepend @n times character @c to @self.
  [ ? { n >= -1 }; ]
  ( 
    (n > 0).if {
      (upper = -1).if {
        extend_multiple c by n
      } else {
        resize (count + n)
        storage.move 0 to (Old upper) by n
        storage.set_all_with c until (n - 1)
      }
    }
    ? {count = n + Old count}
  )

  - extend_to_count c:Char until needed_count:Int <-
  // Extend self with @c until @needed_count is reached.
  // Do nothing if @needed_count is already greater or equal
  // to @count.
  ( ? { needed_count >= 0 }
    
    (needed_count - upper).times {
      add_last c
    }

    ? { count >= needed_count}
  )

  -  precede_to_count c:Char until needed_count:Int <-
  // Prepend @c to @self until @needed_count is reached.
  // Do nothing if @needed_count is already greater or equal
  // to @count.
  ( + offset, old_upper: Int
    ? { needed_count >= 0}
        
    offset := needed_count - count
    (offset > 0).if {
      old_upper := upper
      resize needed_count
      storage.move 0 to old_upper by offset
      storage.set_all_with c until (offset - 1)
    }

    ? { count >= needed_count }
  )

  - reverse <-
  // Reverse the string.
  (
    + i1, i2: Int
    i1 := 0
    i2 := upper
    { i1 >= i2 }.until_do {
      swap i1 with i2
      i1 := i1 + 1
      i2 := i2 - 1
    }
  )

  - remove_all_occurrences ch:Char <-
  // Remove all occurrences of @ch.
  ( + j,i:Int
    {(i <= upper) && {at i != ch}}.while_do { i := i + 1; }
    (i <= upper).if {
      j := i
      i := i + 1
      {i <= upper}.while_do {
        (at i != ch).if {
          at j put (at i)
          j := j + 1
        }
        i := i + 1
      }
      upper := j - 1
    }
  )

  - extend_unless ch:Char <-
  // Extend @self (using @extend) with @ch unless @ch is
  // already the @last character.
  ( 
    ( (upper = -1) || {at upper != ch}).if {
      add_last ch
    }

    ? { last = ch }
  )

  - make_from_string model:String <-
  // Initialize from the characters of @model.
  // Useful in proper descendants of String_buffer.
  ( + c:Int

    ? { model != NULL }
    c := model.upper
    (capacity < c+1).if {
      capacity := c+1
      storage := C_array(Char).calloc_intern capacity
    }
    upper := c
    storage.copy_from (model.storage) until c

    ? {count = model.count}
  )

  - set_count new_count:Int <-
  [
    -? { new_count <= capacity }
  ]
  (
    upper := new_count - 1
  )
  
  - set_upper new_upper:Int <-
  (
    upper := new_upper
  )
  
  - unescape_c <-
  ( + p,q,i,val,up:Int
    + c:Char
    
    {p <= upper}.while_do {
      ((c := at p) = '\\').if {
        p := p + 1;
        c := at p
        i := "ntrabfv\\\'\"?".last_index_of c
        (i != -1).if {
          at q put ("\n\t\r\a\b\f\v\\\'\"\?".at i)
          p := p + 1
        }.elseif {c.in_range '0' to '7'} then {
          // Seq. octal : \ooo (3 digits)
          val := 0; up := (p+2).min upper
          {
            val := (val << 3) | (c -! '0')
            p := p + 1
          }.do_while {(p <= up) && {(c := at p).in_range '0' to '7'}}
          at q put (val.to_char)          
        }.elseif {c = 'x'} then {
          // Seq. hexa : \xhh (2 hexdigits)
          p := p + 1; val := 0; up := (p+1).min upper
          {(p <= up) && {(c := at p).is_hexadecimal_digit}}.while_do {
            val := (val << 4) | c.hexadecimal_value
            p := p + 1
          }
          at q put (val.to_char)        
        } else { // Other (copy)
          at q put c
          p := p + 1;
        }        
      } else {
        at q put c
        p := p + 1;        
      }
      q := q + 1;
    }
    upper := q - 1    
  )
  
  // Interfacing with C string :

  - to_external:C_array Char <-
  // Gives C access to the internal @storage (may be dangerous).
  // To be compatible with C, a null character is added at the end
  // of the internal @storage. This extra null character is not
  // part of the Lisaac String_buffer.
  (
    // Append 0 terminal.
    (capacity > count).if {
      storage.at count put '\0'
    } else {
      add_last '\0'
      upper := upper - 1
    }
    storage
  )
  [
    +? {count = Old count}
    +? {Result.is_not_null}
  ]

  - from_external p:C_array(Char) <-
  // Internal @storage is set using @p (may be dangerous because
  // the external C string @p is not duplicated).
  // Assume @p has a null character at the end in order to
  // compute the Lisaac @count. This extra null character
  // is not part of the Lisaac String_buffer.
  // Also consider @from_external_copy to choose the most appropriate.
  ( ? {p.is_not_null}

    upper := -1
    {p.at (upper+1) = '\0'}.until_do {
      upper := upper + 1
    }

    (storage != p).if {
      storage := p
      capacity := upper + 2
    }

    ? {capacity >= (count + 1)}
    ? {p = to_external}
  )

  - from_external_copy p:C_array(Char)  <-
  // Internal @storage is set using a copy of @p.
  // Assume @p has a null character at the end in order to
  // compute the Eiffel @count. This extra null character
  // is not part of the Lisaac String_buffer.
  // Also consider @from_external to choose the most appropriate.
  ( + i:Int
    ? {p.is_not_null}
    upper := -1
    {p.at i = '\0'}.until_do {
      add_last (p.at i)
      i := i + 1
    }
  )

  - element_sizeof:Int <- 1

  - to_c_array_uint8:C_array(Uint8) <-
  (
    Cast (C_array Char) To (C_array Uint8).on storage
  )

  - add_last_buffer buf:Array(Uint8) from beg:Int to end:Int <-
  (
    beg.to end do { j:Int
      add_last (buf.at j.to_char)
    }
  )

  - item_byte idx:Int offset ofs:Int :Uint8 <-
  (
    ? {ofs = 0}
    ? {idx <= upper}
    at idx.to_uint8
  )

  - restore_after_external <-
  (
    upper := -1
    {storage.at (upper+1) = '\0'}.until_do {
      upper := upper + 1
    }
  )
