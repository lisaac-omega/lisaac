Header
  + name := Flat Uint8
/*Unsigned 8 bits integer.*/
  - type    := `unsigned char`;
  - default := (0.to_raw_uint8);
  - export  := Uint64, Uint32, Uint16,
  Int64 , Int32 , Int16 ,
  Int;
Insert

  - parent_unsigned_integer:Unsigned_integer := Unsigned_integer

Public

  - object_size:Int := 1

  // Range.

  - maximum:Uint64 := 255.to_raw_uint64

  // Conversion with test.

  - to_uint8:Uint8 <- self

  - to_character:Char <-
  [ -? {in_range (Char.minimum) to (Char.maximum)}; ]
  (
    Cast Uint8 To Char.on self
  )



