Header
  + name := Flat Real32
/*Float (C `float` mapping).*/
  - type     := `float`;
  - default  := (0.to_raw_real32);
  - export   := Real, Real64, Real80, Real_16_16;
Insert
  - parent_float_map32:Float_map32 := Float_map32
  - parent_float_real:Float_real := Float_real

Public

  - hypot y:Self :Self <- `hypotf(@self,@y)`:Self
  
  - atan2 dx:Self :Self <- `atan2f(@self,@dx)`:Self

