Header
  + name := Flat  Real_24_8
/*signed 24.8 fixed float.*/
  - type    := `signed long`;
  - default := (0.to_raw_real_24_8);
  - export  := Real32, Real64;
Insert
  - parent_signed_fixed_real:Signed_fixed_real := Signed_fixed_real

Self

  - shift_bits:Int <- 8

Public
  
  - round:Int <-
  // Rounded integral value.
  ( + result:Int
    result := to_raw_int
    ((result & 80h) != 0).if {
      result := (result >> 8) + 1
    } else {
      result := result >> 8
    }
    result
  )

  // Range.

  - minimum:Int64 <- - 7F_FFFFh.to_raw_int64

  - maximum:Uint64 <- 7F_FFFFh.to_raw_uint64

  // Convertion format with test.

  - to_real_24_8:Real_24_8 <- self

  // Convertion

  - append_in b:String_buffer <-
  // Append in the @b the equivalent of @to_string. No new String_buffer
  // creation during the process.
  ( + val:Int
    + old_count,new_count:Int
    ? {b!=NULL}
    val := to_raw_int
    (val < 0).if {
      val := - val
      b.extend '-'
    }
    (val >> 8).append_in b
    b.extend '.'
    old_count:=b.count
    //     1/256 = 0.00390625 => 8 digit.
    (((val & 255).to_uint64 * 100000000)>>8).to_int.append_in b
    new_count:=old_count+8
    {b.count!=new_count}.while_do {
      b.insert '0' to old_count
    }
  )










