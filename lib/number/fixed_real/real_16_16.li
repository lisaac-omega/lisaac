Header
  + name := Flat Real_16_16
/*signed 16.16 fixed float.*/
  - type    := `signed int`;
  - default := (0.to_raw_real_16_16);
  - export  := Real32, Real64;
Insert
  - parent_signed_fixed_real:Signed_fixed_real := Signed_fixed_real

Self

  - shift_bits:Int <- 16

Public

  - round:Int <-
  // Rounded integral value.
  ( + result:Int
    result := to_raw_int
    ((result & 8000h) != 0).if {
      result := (result >> 16) + 1
    } else {
      result := result >> 16
    }
    result
  )

  // Range.

  - minimum:Int64  <- Int16.minimum

  - maximum:Uint64 <- Int16.maximum

  // Convertion format with test.

  - to_real_16_16:Real_16_16 <- self

  // Convertion

  - append_in b:String_buffer <-
  // Append in the `b' the equivalent of `to_string'. No new String_buffer
  // creation during the process.
  ( + val:Int
    + old_count,new_count:Int
    ? {b!=NULL}
    val := to_raw_int
    (val < 0).if {
      val := - val
      b.extend '-'
    }
    (val >> 16).append_in b
    b.extend '.'
    old_count := b.count
    //     1/65536 = 0.00390625 => 8 digit.
    (((val & 0FFFFh).to_uint64 * 100000000)>>16).to_int.append_in b
    new_count:=old_count+8
    {b.count!=new_count}.while_do {
      b.insert '0' to old_count
    }
  )









