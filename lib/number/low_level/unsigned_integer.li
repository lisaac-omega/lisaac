Header
  + name := Unsigned_integer
/*Generic Unsigned Int.*/
Insert

  - parent_integer:Int := Int

Public

  // Range

  - minimum:Int64 := 0.to_raw_int64

  // Function :

  - sign:Int <-
  // Sign of self (0 -1 or 1).
  (
    (self != 0).to_int
  )

  - self:Self abs:Self <- self; // Absolute value of @self.
    
  // Convertion

  - append_in b:String_buffer <-
  // Append in the @b the equivalent of @to_string. No new String_buffer
  // creation during the process.
  ( + val:Self
    + k,j:Int
    ? {b!=NULL}

    (self = 0).if {
      b.extend '0'
    } else {

      k := b.upper+1

      val := self
      {val = 0}.until_do {
        b.extend ((val % 10).digit)
        val := val / 10
      }
      j := b.upper

      {k >= j}.until_do {
        b.swap k with j
        j := j - 1
        k := k + 1
      }

    }
  )

  - print <-
  (
    print_positif
  )

  - to_octal:Self <-
  // Gives coresponding octal value.
  ( + result, unit, current:Self

    current := self
    unit := 1
    {current!=0}.while_do {
      result := result + ((current & 7)*unit)
      unit := (unit << 3) + (unit << 1)
      current := current >> 3
    }
    result
  )

  // Hashing:

  - hash_code:Int <- to_int

  // Looping

  - downto limit_down:Self do blc:{Self; } <-
  (
    (self+1).downto_unsigned limit_down do blc
  )

  // Bound test

  - bound_test low:Int64 to up:Uint64 :Boolean <-
  (
    (up > to_raw_uint64)
  )

  - number_bits:Int <- object_size * 8
  
  - self:Self '@<' other:Self :Self <- (self << other) | (self >> (number_bits - other)); // rol: Rotation left
  - self:Self '@>' other:Self :Self <- (self >> other) | (self << (number_bits - other)); // ror
  
  // Crypto (SHAxyz)
  
  - ch (y,z:Self) :Self <- (self & y) ^ (~self & z)
  - maj (y,z:Self) :Self <- (self & y) ^ (self & z) ^ (y & z)
        
Private

  - downto_unsigned limit_down:Self do blc:{Self; } <-
  (
    (self > limit_down).if {
      blc.value (self - 1)
      (self - 1).downto_unsigned limit_down do blc
    }
  )
  
