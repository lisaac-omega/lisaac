Header

  + name    := Float_map32

  /*Mapping for REAL_32.*/
Inherit

  - parent_float_map:Float_map := Float_map

Private

  - map_32:Uint32 <- `((union { float f; uint32_t j; }){.f = @self}).j`:Uint32

Public

  - sign:Boolean    <- (map_32 >> 31) = 0; // True if positif, False else.

  - exponent:Uint32 <- (map_32 >> mantissa_bits) & 0FFh

  - mantissa:Uint64 <- (map_32 & 7F_FFFFh)

    
  // Format.

  - mantissa_bits:Int8 := 23

  - exponent_bits:Int8 := 8

