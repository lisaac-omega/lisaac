Header
  + name := Float_map80
/*Mapping for REAL_80.*/
Inherit

  - parent_float_map:Float_map := Float_map

Mapping,Private

  + exp_16:Uint16
  + man_64:Uint64

Real, Real32, Real64, Real80

  - get_map f:Self <-
  ( + tab:C_array(Self)
    tab := Cast Float_map80 To (C_array Self).on Float_map80
    tab.put f to 0
  )

Public
  
  - sign:Boolean         <- (exp_16 >> 15) = 0; // True if positif, False else.

  - exponent:Uint32 <- exp_16 & 07F_FFh

  - mantissa:Uint64 <- man_64


  // Format.

  - mantissa_bits:Int8 := 64

  - exponent_bits:Int8 := 15

