Header
  + name := Float_map80
/*Mapping for REAL_80.*/
Inherit

  - parent_float_map:Float_map := Float_map

Private

  // x86 layout: 64 bits of mantissa, then the sign and the 15 bits of exponent.
  
  - exp_16:Uint16 <- `((union { long double f; struct { uint64_t m; uint16_t e; } b; }){.f = @self}).b.e`:Uint16

  - man_64:Uint64 <- `((union { long double f; struct { uint64_t m; uint16_t e; } b; }){.f = @self}).b.m`:Uint64

Public
  
  - sign:Boolean    <- (exp_16 >> 15) = 0; // True if positif, False else.

  - exponent:Uint32 <- exp_16 & 07F_FFh

  - mantissa:Uint64 <- man_64


  // Format.

  - mantissa_bits:Int8 := 64

  - exponent_bits:Int8 := 15
