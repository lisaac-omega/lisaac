Header
  + name := Signed_fixed_real
/*Signed real number of fixed decimal part.*/
Insert

  - parent_fixed_real:Fixed_real := Fixed_real

Public

  // Bound test

  - bound_test low:Int64 to up:Uint64 :Boolean <-
  (
    (low < to_raw_int64) && {up > to_raw_uint64}
  )

  // Around

  - object_size:Int := 4

  - floor:Int <-
  // Greatest integral value no greater than self.
  (
    to_raw_int32 >> shift_bits
  )
  [
    +? {self >= Result}
    +? {(self - Result) < 1}
  ]

  - ceiling:Int <-
  // Smallest integral value no smaller than self.
  (
    (to_raw_int32 + ((1 << shift_bits) - 1)) >> shift_bits
  )
  [
    +? {self <= Result}
    +? {(self - Result) < 1}
  ]

  - rounded:Int <-
  // Rounded integral value.
  (
    (to_raw_int32 + ((1 << shift_bits) / 2)) >> shift_bits
  )

  - truncated_to_int:Int <- floor
  // Int part (largest absolute value no greater than self).

  // binary operator :

  - self:Self '-'  Left 80  other:Self :Self <-
  (
    Cast Int32 To Self.on (to_raw_int32 - other.to_raw_int32)
  )

  - self:Self '*#' Left 90 other:Int :Self <-
  (
    Cast Int32 To Self.on (to_raw_int32 * other)
  )

  - self:Self '*'  Left 90 other:Self :Self <-
  (
    Cast Int64 To Self.on ((to_raw_int64 * other.to_raw_int64) >> shift_bits)
  )

  - self:Self '/#' Left 90 other:Int :Self <-
  (
    Cast Int32 To Self.on (to_raw_int32 / other)
  )

  - self:Self '/'  Left 90 other:Self :Self <-
  (
    Cast Int64 To Self.on ((to_raw_int64 << shift_bits) / other.to_raw_int64)
  )

  - self:Self '&'  Left 90 other:Self :Self <-
  (
    Cast Int32 To Self.on (to_raw_int32 & other.to_raw_int32)
  )

  - self:Self '>>' Left 90 other:Int :Self <-
  (
    Cast Int32 To Self.on (to_raw_int32 >> other)
  )

  - self:Self '<<' Left 90 other:Int :Self <-
  (
    Cast Int32 To Self.on (to_raw_int32 << other)
  )

  // Test binary operator :

  - self:Self '>' Right 60 other:Self :Boolean <-
  (
    to_raw_int32 > other.to_raw_int32
  )

  // prefix : Unary operator

  - '~' self:Self :Self <-
  (
    Cast Int32 To Self.on (~ to_raw_int32)
  )




