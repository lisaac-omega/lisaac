Header
  + name := Fixed_real
/*Real number of fixed decimal part.*/
Insert
  - parent_real:Real := Real

Self
  - shift_bits:Int <-
  (
    abstract
    0
  )

Public
  - floor:Int <-
  (
    abstract
  )
  
  - round:Int <-
  // Rounded integral value.
  (
    abstract
    0
  )

  // Conversions with tests

  // - To unsigned integers

  - to_uint8:Uint8     <-
  (
    floor.to_raw_uint8
  )

  - to_uint16:Uint16   <-
  (
    floor.to_raw_uint16
  )

  - to_uint32:Uint32   <-
  (
    floor.to_raw_uint32
  )

  - to_uint64:Uint64   <-
  (
    floor.to_raw_uint64
  )

  // - To signed integers

  - to_int8:Int8   <-
  (
    floor.to_raw_int8
  )

  - to_int16:Int16 <-
  (
    floor.to_raw_int16
  )

  - to_int32:Int32 <-
  (
    floor.to_raw_int32
  )

  - to_int64:Int64 <-
  (
    floor.to_raw_int64
  )

  - to_int:Int <-
  (
    floor
  )

  // - To unsigned fixed reals

  - to_ureal_16_16:Ureal_16_16 <-
  ( + result:Uint32
    (shift_bits < 16).if {
      result := to_raw_uint32 << (16 - shift_bits)
    } else {
      result := to_raw_uint32 >> (shift_bits - 16)
    }
    result.to_raw_ureal_16_16
  )

  - to_ureal_24_8:Ureal_24_8   <-
  ( + result:Uint32
    (shift_bits < 8).if {
      result := to_raw_uint32 << (8 - shift_bits)
    } else {
      result := to_raw_uint32 >> (shift_bits - 8)
    }
    result.to_raw_ureal_24_8
  )

  - to_ureal_26_6:Ureal_26_6   <-
  ( + result:Uint32
    (shift_bits < 6).if {
      result := to_raw_uint32 << (6 - shift_bits)
    } else {
      result := to_raw_uint32 >> (shift_bits - 6)
    }
    result.to_raw_ureal_26_6
  )

  // - To signed fixed reals

  - to_real_16_16:Real_16_16 <-
  ( + result:Uint32
    (shift_bits < 16).if {
      result := to_raw_int32 << (16 - shift_bits)
    } else {
      result := to_raw_int32 >> (shift_bits - 16)
    }
    result.to_raw_real_16_16
  )

  - to_real_24_8:Real_24_8   <-
  ( + result:Uint32
    (shift_bits < 8).if {
      result := to_raw_int32 << (8 - shift_bits)
    } else {
      result := to_raw_int32 >> (shift_bits - 8)
    }
    result.to_raw_real_24_8
  )

  - to_real_26_6:Real_26_6 <-
  ( + result:Uint32
    (shift_bits < 6).if {
      result := to_raw_int32 << (6 - shift_bits)
    } else {
      result := to_raw_int32 >> (shift_bits - 6)
    }
    result.to_raw_ureal_26_6
  )

  // - To float reals

  - to_real32:Real32 <-
  (
    to_raw_real32 / (1 << shift_bits)
  )

  - to_real64:Real64 <-
  (
    to_raw_real64 / (1 << shift_bits)
  )

  - to_real80:Real80 <-
  (
    to_raw_real80 / (1 << shift_bits)
  )

  - atan:Self <- not_yet_implemented

  - sqrt:Self <-
  // The Heron approximation Algorithm.
  [ -? {self > 0}; ]
  ( + result:Self
    result := self
    0.to 7 do { j:Int
      result := (result + self / result) /# 2
    }
    result
  )

  - log:Self  <- not_yet_implemented

  - sin:Self  <- 
  [
    ? {in_range 0 to (pi *# 2)}
  ]
  ( + a:Self
    a := pi /# 2 - self
    (a < 0).if {
      a := a + pi *# 2
    }
    a.cos
  )

  - cos:Self  <- 
  // Taylor progression.
  [
    ? {in_range 0 to (pi *# 2)}
  ]
  ( + result,x2,xx:Self
    
    (self <= pi /# 2).if { 
      (self != pi /# 2).if {        
        result := 1
        x2 := self * self
        result := result - x2 /# 2
        xx := x2 * x2
        result := result + xx /# 24
        xx := xx * x2
        result := result - xx /# 720
        xx := xx * x2
        result := result + xx /# 40_320
        xx := xx * x2
        result := result - xx /# 3_628_800
      }
    }.elseif {self <= pi} then {
      result := - (pi - self).cos
    } else {
      result := (pi *# 2 - self).cos
    }
    result
  )

  - self:Self pow exp:Self :Self <- not_yet_implemented

  // Comparaison.

  - self:Self '~=' other:Self :Boolean <-
  (
    self = other
  )

  - is_nan:Boolean <- False

  - is_infinite:Boolean <- False

  // Print.

  - append_in b:String_buffer decimal n:Int <-
  (
    not_yet_implemented
  )

  - scientific_append_in b:String_buffer <-
  (
    not_yet_implemented
  )

