Header

  + name    := Float_map64

  /*Mapping for Real64.*/
Inherit

  - parent_float_map:Float_map := Float_map

Mapping,Private

  + map_64:Uint64

Real, Real32, Real64, Real80

  - get_map f:Self <-
  ( `{ double f; uint64_t j=0; f = @f; memcpy(&j,&f,sizeof(double))`;
    map_64 := `j`:Uint64
    `}`    
    /*+ tab:C_array(Self)
    tab := CAST FLOAT_MAP64 TO (C_array Self).on FLOAT_MAP64
    `/* Bug GCC */`
    tab.at 0 put f*/
  )

Public
  
  - sign:Boolean    <- (map_64 >> 63) = 0; // True if positif, False else.

  - exponent:Uint32 <- ((map_64 >> mantissa_bits) & 07_FFh).to_uint32

  - mantissa:Uint64 <- map_64 & ((1 << mantissa_bits)-1)


  // Format.

  - mantissa_bits:Int8 := 52

  - exponent_bits:Int8 := 11

