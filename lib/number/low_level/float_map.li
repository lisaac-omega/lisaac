Header
  + name := Float_map
/*Mapping for REAL_xx.*/

Private

  - abstract <- crash_with_message "Slot abstract."

Real, Real32, Real64, Real80

  - get_map f:Self <-
  (
    abstract
  )

Public
  
  - sign:Boolean         <- abstract; // True if positif, False else.

  - exponent:Uint32 <- abstract

  - mantissa:Uint64 <- abstract

  // Consultation.

  - is_infinite:Boolean <-
  (exponent = ((1 << exponent_bits) - 1)) && {(mantissa >> (mantissa_bits-1)) = 0}

  - is_nan:Boolean <-
  (exponent = ((1 << exponent_bits) - 1)) && {(mantissa >> (mantissa_bits-1)) != 0}

  - is_zero:Boolean <- (exponent = 0) && {mantissa = 0}


  // Format.

  - mantissa_bits:Int8 <- abstract

  - exponent_bits:Int8 <- abstract
