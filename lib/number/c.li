Header
  + name := Flat ℂ
  /*
  The set ℂ denotes the set of complex numbers re + im i, with i^2 = -1.
  Both parts are @Real64: unlike @ℤ and @ℚ, a value is not exact,
  but it needs no memory management.
  */
Insert

  - parent_numeric:Numeric := Numeric

Public

  + re:Real64
  + im:Real64

  - re real:Real64 im img:Real64 :Self <-
  // ℂ re 3.5 im 2.3 is also written 3.5 + 2.3 i.
  (
    (re,im) := (real,img)
    self
  )

  - polar (r,t:Real64) :Self <-
  // Value of modulus @r and argument @t (radian).
  (
    ℂ re(r * t.cos) im (r * t.sin)
  )

  - self:Self '+' Left 80 <> other:Self :Self <- ℂ re (re + other.re) im (im + other.im)

  - self:Self '-' Left 80 <> other:Self :Self <- ℂ re (re - other.re) im (im - other.im)

  - self:Self '*' Left 90 <> other:Self :Self <-
  (
    ℂ re (re * other.re - im * other.im) im (re * other.im + im * other.re)
  )

  - self:Self '/' Left 90 <> other:Self :Self <-
  [ ? {other.norm != 0.0}; ]
  ( + q:Real64
    q := other.norm
    ℂ re ((re * other.re + im * other.im) / q) im ((im * other.re - re * other.im) / q)
  )

  - '-' self:Self :Self <- ℂ re (- re) im (- im)

  - '+' self:Self :Self <- self

  - conj:Self <- ℂ re (re) im (- im)
  // Conjugate: re - im i.

  - norm:Real64 <- re * re + im * im
  // Square of the modulus.

  - modulus:Real64 <-
  ( + x,y:Real64
    (x,y) := (re,im)
    `hypot(@x,@y)`:Real64
  )

  - arg:Real64 <- im.atan2 re
  // Argument in ]-pi, pi].

  - self:Self pow e:Int :Self <-
  // @self to the power of @e, which can be negative.
  [ ? {(e >= 0) || {norm != 0.0}}; ]
  ( + r,x:Self
    + n:Int
    r := ℂ re 1.0 im 0.0
    x := self
    n := e.abs
    {n > 0}.while_do {
      (n.is_odd).if { r := r * x; }
      x := x * x
      n := n >> 1
    }
    (e < 0).if { r := (ℂ re 1.0 im 0.0) / r; }
    r
  )

  - sqrt:Self <-
  // Principal square root: its real part is >= 0.
  // Only the larger part comes from (@modulus + |@re|) / 2: no cancellation.
  ( + t,x,y:Real64
    (norm = 0.0).if {
      (x,y) := (0.0,0.0)
    } else {
      t := ((modulus + re.abs) / 2.0).sqrt
      (re >= 0.0).if {
        x := t
        y := im / (2.0 * t)
      } else {
        x := im.abs / (2.0 * t)
        y := t
        (im < 0.0).if { y := - t; }
      }
    }
    ℂ re x im y
  )

  - exp:Self <- ℂ.polar (re.exp, im)

  - log:Self <-
  // Principal logarithm.
  [ ? {norm != 0.0}; ]
  (
    ℂ re (modulus.log) im arg
  )

  - self:Self '=' Right 50 <> other:Self :Boolean <- (re = other.re) && {im = other.im}

  - self:Self '!==' Right 60 other:Self :Boolean <- ! (self = other)

  - append_in b:String_buffer <-
  (
    b # re
    (im < 0.0).if {
      b # " - " # (- im)
    } else {
      b # " + " # im
    }
    b.add_last 'i'
  )
