Header
  + name := Random
/*
   RANDOM number generation.
  */
Inherit  
  - parent_rgn_common: /*EYE*/ Rgn_common := Rgn_common
    
Private
  + seedmem:Int32 := 1

  + iv:C_array Int32
  
  + iy:Int32
  
  - minimal_next <-
  ( + k:Int32
    k := seedmem / 127773
    seedmem := 16807 * (seedmem - k * 127773) - 2836 * k
    (seedmem < 0).if {
      seedmem := seedmem + 2147483647
    }
    (iv = NULL).if {
       iv := C_array Int32 .create 32
    }
  )
  
  - next <-
  ( + tmp:Int32
    tmp := iy % 32
    minimal_next
    iy := iv.at tmp
    iv.at tmp put seedmem
  )

Public
  
  - init seed:Uint32 : Self <-
  ( + i:Int32
    seedmem := seed.to_raw_int32
    iv := C_array Int32 .create 32
    minimal_next
    {i <= 6}.while_do {
      minimal_next
      i := i + 1
    }
    i := 31
    {i >= 0}.while_do {
      iv.at i put seedmem
      minimal_next
      i := i - 1
    }
    iy := iv.at 0
    next
    self
  )
  
  - uint32:Uint32 <-
  (
    next
    iy.to_raw_uint32
  )
  
