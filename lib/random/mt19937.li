Header
  + name := Mt19937
/*
   The Mersenne Twister is a general-purpose pseudorandom number generator (PRNG)
   developed in 1997 by Makoto Matsumoto and Takuji Nishimura. 
   Its name derives from the choice of a Mersenne prime as its period length.
   The standard implementation of that, MT19937, uses a 32-bit word length.
  */
Inherit
  - parent_rgn_common: /*EYE*/ Rgn_common := Rgn_common
  
Private
  - cst_n:Int := 624
  - cst_m:Int := 397
  - cst_w:Int := 32
  - cst_r:Int := 31
  - umask:Int := 8000_0000h; //(0FFFF_FFFFh << cst_r)
  - lmask:Int := (0FFFF_FFFFh >> (cst_w-cst_r))
  - cst_a:Int := 09908B0DFh
  - cst_u:Int := 11
  - cst_s:Int := 7
  - cst_t:Int := 15
  - cst_l:Int := 18
  - cst_b:Int := 09D2C5680h
  - cst_c:Int := 0EFC60000h
  - cst_f:Int := 1812433253
  
  + state_array:C_array Uint32
  + state_index:Int
  
Public
   
  - init seed:Uint32 :Self <-
  ( + s:Uint32
    (state_array = NULL).if {
      state_array := C_array Uint32.create cst_n
    }
    (seed = 0).if { s := 19650218; } else { s := seed; }
    state_array.at 0 put s
    1.to (cst_n-1) do { i:Int
      s := cst_f * (s ^ (s >> (cst_w-2))) + i
      state_array.at i put s
    }
    state_index := 0
    self
  )

  - uint32:Uint32 <-
  ( + k,j:Int
    + x,xa,y,z:Uint32
    
    k := state_index
    j := k - (cst_n-1)
    (j < 0).if { j := j + cst_n; }

    x := (state_array.at k & umask) | (state_array.at j & lmask)
    xa := x >> 1
    ((x & 01h) != 0).if { xa := xa ^ cst_a; }
    
    j := k - (cst_n-cst_m)
    (j < 0).if { j := j + cst_n; }
    
    x := state_array.at j ^ xa
    state_array.at k put x
    k := k + 1
    
    (k >= cst_n).if { k := 0; }
    state_index := k
    
    y := x ^ (x >> cst_u)
    y := y ^ ((y << cst_s) & cst_b)
    y := y ^ ((y << cst_t) & cst_c)
    z := y ^ (y >> cst_l)
    z
  )
  
