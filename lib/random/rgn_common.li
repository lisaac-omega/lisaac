Header
  + name := Rgn_common
  
/*
   RNG: Random Number Generator.
   A common interface that allows you to quickly switch from one generator to another.
  */
Insert  
  - parent_clone:Clone := Clone
    
Public
  
  - new self:Self :Self <- clone
  
  - init_clock :Self <-
  ( + seed: Uint32
    seed := Clock.time_raw.to_raw_uint32
    init seed
  )
  
  - init seed:Uint32 :Self <-
  [
    ? {seed > 0}
  ]
  (
   abstract
   )        
  
  - uint32:Uint32 <- abstract

  - real_64:Real64 <- uint32.to_real64 / 0FFFF_FFFFh
  
  - real_32:Real32 <- uint32.to_real32 / 0FFFF_FFFFh
  
  - real_32 min:Real32 to max:Real32 :Real32 <- real_32 * (max-min) + min
  
  - real_64 min:Real64 to max:Real64 :Real64 <- real_64 * (max-min) + min
  
  - hexadecimal_digit:Char <-
  ( + i,j:Int
    i := min 0 max 15
    (i <= 9).if {
      j := ('0'.code) + i
    } else {
      j := ('A'.code) - 10 + i
    }
    j.to_char
  )
  [
    ? {Result.is_hexadecimal_digit}.txt{Result.to_string}
  ]
    
  - between mn:Real32 and mx:Real32 :Real32 <- (real_32 * (mx - mn) + mn)
  
  - range mn:Int32 to mx:Int32 : Int32 <-
  [
    ? {deprecated True msg "RGN_COMMON: use min__max instead"};
  ]
  (
    min mn max mx
  )
  
  - min mn:Int32 max mx:Int32 : Int32 <-
  // Random value inside [ mn, mx ].
  [
    ? {mn <= mx}
  ]
  ( + range, result:Int32
    range := mx - mn + 1
    result := mn + (uint32 .to_raw_int % range)
    result
  )
  [
    ? {Result.in_range mn to mx};
  ]
  
  - max v:Int32 :Int32 <- min 0 max v
  
  
  // Misc
  
  - color: Color <-
  ( + result: Color
    (min 1 max 17)
    .when 1 then { result := Color.blue }
    .when 2 then { result := Color.brown }
    .when 3 then { result := Color.cyan }
    .when 4 then { result := Color.chocolate }
    .when 5 then { result := Color.dark_orange }
    .when 6 then { result := Color.emerald_green }
    .when 7 then { result := Color.gray }
    .when 8 then { result := Color.green }
    .when 9 then { result := Color.light_gray }
    .when 10 then { result := Color.leaf_green }
    .when 11 then { result := Color.magenta }
    .when 12 then { result := Color.orange }
    .when 13 then { result := Color.peru }
    .when 14 then { result := Color.pink }
    .when 15 then { result := Color.red }
    .when 16 then { result := Color.saddle_brown }
    .when 17 then { result := Color.yellow }
    .else { result := Color.rgb(min 100 max 255.to_uint8, min 0 max 128.to_uint8, min 0 max 100.to_uint8) }  
    result
  )
  
  - flip_coin: Boolean <- ((min 0 max 1) = 0)
  