Header
  + name := Dev
- include := `
#include <sys/types.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <sys/ioctl.h>
#include <sys/mman.h>
`;

Public

  - open n:String :Int <-
  ( + buf:C_array Char
    buf := n.to_external
    `open((char*)@buf,O_RDWR | O_NONBLOCK)`:(Int)
  )
  
  - ioctl f:Int cmd cmd:Int ptr p:Pointer :Int <- `ioctl(@f,@cmd,@p)`:Int
  
  
  
  - close f:Int <- `close(@f)`
