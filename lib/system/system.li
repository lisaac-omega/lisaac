Header
  + name := System
- include := `char *system_name();`;
  
  - external := `
char *system_name()
{ char *n; 
#if defined(_WIN32)
n = "windows";
#elif defined(__ANDROID__)
n = "android";
#elif defined(__APPLE__)
n = "apple";
#else 
n = "unix";
#endif
return n;
}`;

Private
  
  + name_memory:String_alias
    
Public
  
  - name:String_alias <- // "Linux" "Android" "Apple" "Windows"
  ( + n:C_array Char
    + r:String_alias
    n := `system_name()`:C_array Char
    String.tmp { tmp:String_buffer
      tmp.from_external_copy n
      r := tmp.to_string_alias
    }
    r
  )
  
  - exit code:Int <- `exit(@code)`
  
