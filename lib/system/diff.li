Header
  + name := Diff
/*diff unix-like command*/
  
Public
  - path p1:String path p2:String : Int <-
  ( + result:Int
    String.tmp { tmp:String_buffer
      tmp.append "diff "
      tmp.append p1
      tmp.add_last ' '
      tmp.append p2
      result := Environment.run tmp
    }
    result
  )
    
