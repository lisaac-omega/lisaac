Header
  + name := Processor
/*Processor object.*/

Public

  - to_intel_ulong v:Uint64 :Uint64 <- abstract

  - to_intel_uint v:Uint32 :Uint32 <- abstract

  - to_intel_ushort v:Uint16 :Uint16 <- abstract

  - to_motorola_ulong v:Uint64 :Uint64 <-
  (
    (v << 56) | ((v & 0FF00h) << 40) | ((v & 0FF0000h) << 24) | ((v & 0FF000000h) << 8) |
           (v >> 56)   | ((v >> 40) & 0FF00h) | ((v >> 24) & 0FF0000h) | ((v >> 8) & 0FF000000h)
  )

  - to_motorola_uint v:Uint32 :Uint32 <-
  (
    (v << 24) | ((v & 0FF00h) << 8) | ((v >> 8) & 0FF00h) | (v >> 24)
  )
  
  - to_motorola_ureal_16_16 v:Ureal_16_16 :Ureal_16_16 <- Cast Uint32 To Ureal_16_16.on (to_motorola_uint (v.to_raw_uint32))

  - to_motorola_int v:Int :Int <-
  (
    // Conversion in uxxx to cut the sign
    (v  << 24) | (((v & 0FF00h) << 8).to_uint16) | (((v >> 8) & 0FF00h).to_uint16) | ((v >> 24).to_uint8)
  )

  - to_motorola_ushort v:Uint16 :Uint16 <-
  (
    (v  << 8) | (v >> 8)
  )

  - to_motorola_short v:Int16 :Int16 <-
  (
    // Conversion in usmall to cut the sign
    ((v << 8) | ((v >> 8) & 0FFh))
  )

