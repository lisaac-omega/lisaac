Header
  + name := Command_args
/*
    Gives access to the command line arguments.
    Unix-like spirit: arg 0 is the command name, other arguments may be shifted.
  */
  
  - include := `
#include <unistd.h>

#if defined(_WIN32)
  #include <windows.h>
#elif defined(__APPLE__)
  #include <mach-o/dyld.h>
#elif defined(__linux__)
  #include <unistd.h>
#endif
void get_executable_path(char *buf, int64_t size);  
  `;
  
  - external := `
void get_executable_path(char *buf, int64_t size) {
#if defined(_WIN32)
    int len = GetModuleFileNameA(NULL, (char*)buf, size - 1);
    buf[len] = '\0';
#elif defined(__APPLE__)
    uint32_t s = size;
    _NSGetExecutablePath((char*)buf, &s);
#elif defined(__linux__)
    int len = readlink("/proc/self/exe", (char*)buf, size - 1);
    buf[len] = '\0';
#endif
}
  `;
  
Private  
  
  - arg_vector idx:Int :C_array(Char) <- `arg_vector[@idx]`:C_array(Char)

  - arg_count:Int <- `arg_count`:Int

  // @args is built at its first use, not at the start: with `-cop', each universe has its
  // `-' slots, and would build it (`to_string_alias' is a synchronous message to the table of
  // the aliases, shared by all the universes).

  - args_storage:Array String_alias

  - args:Array String_alias <-
  ( + result:Array String_alias
    (args_storage = NULL).if {
      String.tmp { buf:String_buffer
        result := new Array String_alias capacity arg_count
        from 0 to (arg_count - 1) do { j:Int
          buf.from_external_copy (arg_vector j)
          result.add_last (buf.to_string_alias)
        }
      }
      args_storage := result
    }
    args_storage
  )
  
Public
  
  - count:Int <- args.count

  - lower:Int := 0; // As in Unix, the first one is 0 and is the executable name

  - upper:Int <- args.upper
  
  - valid_index i:Int :Boolean <-  i.in_range lower to upper
  
  - at i:Int :String_alias <-
  ( + result:String_alias
    (args.valid_index i).if {
      result := args.at i
    }
    result
  )
  
  - foreach blk:{String_alias;} <- from 1 to upper do { i:Int; blk.value (at i)};
  
  - first:String_alias <-
  // The one just after the command name. 
  (
    at 1
  )
  
  - executable_directory:String_alias :=
  // Try to compute the absolute directory path. 
  ( + cbuf:C_array Char
    + cap,i:Int
    + result: String_alias
    
    String.tmp { buf:String_buffer
      buf.set_capacity 1024
      cbuf := buf.to_external
      cap := buf.capacity
      `get_executable_path(@cbuf, @cap)`
      buf.restore_after_external
      i := buf.last_path_separator
      (i != -1).if { buf.set_upper i; }
      buf.replace_all '\\' with '/'
      result := buf.to_string_alias
    }
    result
  )
  
  - shift <-
  // Mimic bash/sh shift.
  ( + i:Int
    
    i := 1 
    //Out # "Command_args " # (args.upper) # '\n'    
    until {i >= args.upper} do {
      ? {args.at i = args.at i}
      //Out # i # " -- " # (args.at i) # " -- " # (args.at (i + 1)) # '\n'
      args.at i put (args.at (i + 1))
      i := i + 1
    }
    (args.upper >= 1).if {
      args.remove_last
    }
  )
  
  - option_shift name:String_alias :Boolean <-
  // Search for name and remove it when present.
  ( + result:Boolean
    + i:Int
    i := 1
    until {i > upper} do {
      (args.at i = name).if {
        result := True
        args.remove i
        i := upper
      }
      i := i + 1
    }
    result
  )
  
  - search name:String_alias :Boolean <-
  // Search for name.
  ( + result:Boolean
    + i:Int
    i := 1
    until {i > upper} do {
      (args.at i = name).if {
        result := True
        i := upper
      }
      i := i + 1
    }
    result
  )
