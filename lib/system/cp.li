Header
  + name := Cp
/*cp unix-like command*/
  
Public
  - src p1:String dest p2:String : Int <-
  ( + result:Int
    String.tmp { tmp:String_buffer
      tmp.append "cp "
      tmp.append p1
      tmp.add_last ' '
      tmp.append p2
      result := Environment.execute_command tmp
    }
    result
  )
 
