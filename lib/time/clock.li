Header
  + name := Clock
- include := `#include <time.h>
  #include <unistd.h>`;
Insert

  - parent_clone:Clone := Clone

Public
  
  - date_time:(Date,Time) <-
  ( + wd,d,mo:Uint8
    + s,m,h:Uint8
    + y:Uint16
    `{
    struct tm *t; time_t tt
    tt = time(NULL)
    t = localtime(&tt)`;
    wd := `t->tm_wday`:Uint8 + 1
    d  := `t->tm_mday`:Uint8
    mo := `t->tm_mon` :Uint8 + 1
    y  := `t->tm_year`:Uint16 + 1900
    h := `t->tm_hour`:Uint8
    m := `t->tm_min` :Uint8
    s := `t->tm_sec` :Uint8
    `}`
    Date.create (y,mo,d,wd),Time.create (h,m,s,0)
  )
  
  - date:Date <-
  ( + wd,d,mo:Uint8
    + y:Uint16

    `{
      struct tm *t; time_t tt
      tt = time(NULL)
      t = localtime(&tt)`;
      wd := `t->tm_wday`:Uint8 + 1
      d  := `t->tm_mday`:Uint8
      mo := `t->tm_mon` :Uint8 + 1
      y  := `t->tm_year`:Uint16 + 1900
    `}`
    Date.create (y,mo,d,wd)
  )

  - time:Time <-
  ( + s,m,h:Uint8

    `{
      struct tm *t; time_t tt
      tt = time(NULL)
      t = localtime(&tt)`;
      h := `t->tm_hour`:Uint8
      m := `t->tm_min` :Uint8
      s := `t->tm_sec` :Uint8
    `}`
    Time.create (h,m,s,0)
  )
  
  - time_raw:Uint64 <- `time(NULL)`:Uint64
  
  - clock:Uint64 <- `clock()`:Uint64
  
  - usleep usec:Uint64 <- `usleep(@usec)`
  
  - clocks_per_sec:Uint64 <- `CLOCKS_PER_SEC`:Uint64
  
  //- seconds:REAL_32 <- clock.to_real32 / clocks_per_sec.to_real32
  
  - seconds:Real32 <- nanoseconds.to_real32 / 1000_000_000.0
  
  - nanoseconds:Uint64 <-
  ( `struct timespec now`
    `clock_gettime(CLOCK_MONOTONIC, &now)`
    `now.tv_sec*1000000000LL + now.tv_nsec`:Uint64
  )
    
  - make <-
  (
    // Nothing.
  )
