Header
  + name := Flat  Date
/*
  Wrap C <time.h>.
  See 'man mktime'. 
  */
  
  - type := `time_t`;
  
  - default := `0`:Date;
  
  - include := `
#include <time.h>
extern struct tm*tm_info;
extern struct tm tm_glob;  
`;  
  
  - external := `
struct tm*tm_info;
struct tm tm_glob;
`;
Insert
  - parent_clone:Clone := Clone

Public
  - to_raw:Int64 <-
  (
    Cast Self To Int64.on self
  )

  - from_raw i:Int64 :Self <-
  (
    Cast Int64 To Self.on i
  )

Public
  - self:Self '>' Right 60 other:Self :Boolean <- to_raw > other.to_raw

  - self:Self '<' Right 60 other:Self :Boolean <- to_raw < other.to_raw

  - self:Self '>=' Right 60 other:Self :Boolean <- to_raw >= other.to_raw

  - self:Self '<=' Right 60 other:Self :Boolean <- to_raw <= other.to_raw

  - year:Uint16 <-
  (
    `tm_info = localtime(&@self);`
    `tm_info->tm_year + 1900`:Uint16
  )

  - month:Uint8 <-
  (
    `tm_info = localtime(&@self);`
    `tm_info->tm_mon`:Uint8
  )

  - day:Uint8 <-
  (
    `tm_info = localtime(&@self);`
    `tm_info->tm_mday`:Uint8
  )

  - week_day:Uint8 <-
  (
    `tm_info = localtime(&@self);`
    `tm_info->tm_wday`:Uint8
  )
  
  - hour:Int <-
  (
    `tm_info = localtime(&@self);`
    `tm_info->tm_hour`:Int
  )
  
  - min:Int <-
  (
    `tm_info = localtime(&@self);`
    `tm_info->tm_min`:Int
  )
  
  - sec:Int <-
  (
    `tm_info = localtime(&@self);`
    `tm_info->tm_sec`:Int
  )
  
Public
  - create_now :Date <- (`time(NULL)`:Date)
  
  - sec sec:Int min min:Int hour hour:Int mday mday:Int mon mon:Int year year:Int wday wday:Int yday yday:Int isdt isdt:Int :Date <-
  // All fields of the ctime.h tm struct (see man ctime).
  // Note: year must be Year - 1900.
  [
    ? { sec >= 0 }
    ? { min.in_range 0 to 59}
    ? { hour.in_range 0 to 23}
    ? { mday.in_range 1 to 31}
    ? { mon.in_range 0 to 11}
    ? { year >= 0 }
    ? { wday.in_range 0 to 6}
    ? { yday.in_range 0 to 365 }
  ]
  (
    `tm_glob.tm_sec=@sec;`
    `tm_glob.tm_min=@min;`
    `tm_glob.tm_hour=@hour;`
    `tm_glob.tm_mday=@mday;`
    `tm_glob.tm_mon=@mon;`
    `tm_glob.tm_year=@year;`
    `tm_glob.tm_wday=@wday;`
    `tm_glob.tm_yday=@yday;`
    `tm_glob.tm_isdst=@isdt;`
    `mktime(&tm_glob)`:Date
  )
  
  - create (y:Uint16,m,d,wd:Uint8) :Date <-
  // As in "man mktime".
  [
    ? { m.in_range 0 to 11}
    ? { d.in_range 1 to 31}
    ? { wd.in_range 0 to 6}
  ]
  (
    sec 0 min 0 hour 0 mday d mon m year (y - 1900) wday wd yday d isdt 0
  )
  
  - create_timestamp t:Int64 :Self <- from_raw t
  
  - iso8601_to_timestamp b:String at bi:Int :Self <- 
  // 2025-05-27T23:55:00+00:00 => 1748383200 (timestamp)
  ( + t:Self
    + tz_sign:Char
    + tz_h,tz_m,offset, y,m,d, h,n,s, i:Int
    
    i := bi
    {b.at i.is_digit}.while_do { y := y * 10 + b.at i.to_digit; i := i + 1 }; ? {b.at i = '-'}; i := i + 1
    {b.at i.is_digit}.while_do { m := m * 10 + b.at i.to_digit; i := i + 1 }; ? {b.at i = '-'}; i := i + 1
    {b.at i.is_digit}.while_do { d := d * 10 + b.at i.to_digit; i := i + 1 }; ? {b.at i = 'T'}; i := i + 1
    {b.at i.is_digit}.while_do { h := h * 10 + b.at i.to_digit; i := i + 1 }; ? {b.at i = ':'}; i := i + 1
    {b.at i.is_digit}.while_do { n := n * 10 + b.at i.to_digit; i := i + 1 }; ? {b.at i = ':'}; i := i + 1
    {(i <= b.upper) && {b.at i.is_digit}}.while_do { s := s * 10 + b.at i.to_digit; i := i + 1 }
    (i <= b.upper).if {
      tz_sign := b.at i; ? {(tz_sign = '+') || {tz_sign = '-'}}; i := i + 1;
      {b.at i.is_digit}.while_do { tz_h := tz_h * 10 + b.at i.to_digit; i := i + 1 }; ? {b.at i = ':'}; i := i + 1
      {(i <= b.upper) && {b.at i.is_digit}}.while_do { tz_m := tz_m * 10 + b.at i.to_digit; i := i + 1 } 
    }
    (y,m) := (y - 1900, m - 1)
    `tm_glob.tm_year = @y; tm_glob.tm_mon  = @m; tm_glob.tm_mday = @d`
    `tm_glob.tm_hour = @h; tm_glob.tm_min  = @n; tm_glob.tm_sec  = @s; tm_glob.tm_isdst = 0`
    // Conversion UTC data
    t := `timegm(&tm_glob)`:Self

    // Shift timezone
    offset := tz_h * 3600 + tz_m * 60

    (tz_sign = '+').if {
      t := t -# offset
    } else {
      t := t +# offset
    }
    t
  )  
  
  //- self:Self '+' d:Self :Self <- from_raw (to_raw + d.to_raw)
  - self:Self '-' d:Self :Int <- to_raw - d.to_raw
  
  - self:Self '+#' d:Int :Self <- from_raw (to_raw + d)
  - self:Self '-#' d:Int :Self <- from_raw (to_raw - d)
  
  - in_range b:Self to e:Self :Boolean <- to_raw.in_range (b.to_raw) to (e.to_raw)
  
  - append_in b:String_buffer <-
  (
    //week_day.append_in b
    week_day
    .when 0 then {
      b.append "Sun"
    }
    .when 1 then {
      b.append "Mon"
    }
    .when 2 then {
      b.append "Tue"
    }
    .when 3 then {
      b.append "Wed"
    }
    .when 4 then {
      b.append "Thu"
    }
    .when 5 then {
      b.append "Fri"
    }
    .else {
      ? {week_day = 6}
      b.append "Sat"
    }
    b.add_last ' '
    day.append_in b format 2 with '0'
    b.add_last '/'
    (month + 1).append_in b format 2 with '0'
    b.add_last '/'
    year.append_in b format 4
  )

  - append_ddmmyy_in b:String_buffer <-
  (
    day.append_in b format 2 with '0'
    b.add_last '/'
    (month + 1).append_in b format 2 with '0'
    b.add_last '/'
    (year % 100).append_in b format 2 with '0'
  )
  
  - append_yymmdd_in b:String_buffer <-
  (
    (year % 100).append_in b format 2 with '0'
    b.add_last '-'
    (month + 1).append_in b format 2 with '0'
    b.add_last '-'
    day.append_in b format 2 with '0'
  )
  
  - append_yyyymmdd_in b:String_buffer <-
  (
    year.append_in b format 4 with '0'
    b.add_last '-'
    (month + 1).append_in b format 2 with '0'
    b.add_last '-'
    day.append_in b format 2 with '0'
  )

  - append_ddmmyyyy_in b:String_buffer <-
  (
    day.append_in b format 2 with '0'
    b.add_last '/'
    (month + 1).append_in b format 2 with '0'
    b.add_last '/'
    year.append_in b format 4 with '0'
  )
  
  - weekday_fr:String_alias <-
  ( + result:String_alias
    week_day
    .when 0 then {
      result := "Dim"
    }
    .when 1 then {
      result := "Lun"
    }
    .when 2 then {
      result := "Mar"
    }
    .when 3 then {
      result := "Mer"
    }
    .when 4 then {
      result := "Jeu"
    }
    .when 5 then {
      result := "Ven"
    }
    .when 6 then {      
      result := "Sam"
    }
    result
  )
  
  - append_hhmmss_in b:String_buffer <-
  (
    hour.append_in b format 2 with '0'
    b.add_last ':'
    min.append_in b format 2 with '0'
    b.add_last ':'
    sec.append_in b format 2 with '0'
  )    
  
  - encode:Int64 <- to_raw

  - decode i:Int64 :Self <- from_raw i
