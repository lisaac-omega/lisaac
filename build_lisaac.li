Header
  + name := Build_lisaac
/*    Install and configure Lisaac Ω. */

  - include := `#include <unistd.h>`;
Insert
  
  - parent_mini_bash:Mini_bash := Mini_bash

Private
  
  + lisaac_dir:String_alias
  + system:String_alias
  + user_homedir:String_alias // "" for windows
  + shell:String_alias; // $SHELL or ""
  + lisaac_bin_dir:String_alias
  + elit_dir:String_alias
  + rc_file:String_alias
  
Private
  
  - chdir arg:String_alias or_exit <-
  (
    if verbose then {
      ("cd \"" + arg + "\"").println
    }
    if (Environment.chdir arg != 0) then {
      die "Fail." exit 1
    }
    File_utils.pwd_in working_directory
  )
  
  - cc_compile_bin_lisaac <-
  ( + exit_status:Int
    "C compiling lisaac/bin/lisaac.c ... wait...".println
    chdir lisaac_bin_dir or_exit
    String.tmp {cmd: String_buffer
      cmd.append "gcc -Wno-unused lisaac.c -o lisaac -O2"
      if (system = "windows") then {
        cmd.append " ../deps_lib/windows/utf8.res"
      }
      exit_status := execute_command cmd
    }
  )
  
  - check_update_export_path <-
  (
    if (shell = "/bin/bash") then {
      export_path ".bashrc" create True
    }.elseif {shell = "/bin/zsh"} then {
      export_path ".zshrc" create True
    }.elseif {system = "windows"} then {
      export_path ".bashrc" create True
    } else {
      export_path ".bashrc" create False
      export_path ".zshrc" create False
      export_path ".cshrc" create False
    }
    if verbose then {
      if (rc_file = NULL) then { 
        "No rc_file.".println
      }
    }
  )
  
  - export_path rc:String_alias create create:Boolean <-
  ( + index:Int
    ("Create/Update \"" + rc + "\".").println
    if verbose then {
      ("Checking export PATH for \"" + rc + "\".").println
    }
    chdir user_homedir or_exit
    if ((! File_utils.file_exists rc) && {create}) then {
      if verbose then {
        Out # "Creating \"" # rc # "\".\n"
      }
      File_utils.make_empty_file rc
    }
    if (File_utils.file_exists rc) then {
      rc_file := rc
      String.tmp2 { (rc_txt, export_txt :String_buffer)
        export_txt.append "export PATH=\""
        export export_txt add lisaac_bin_dir
        export export_txt add elit_dir
        export_txt.append "$PATH\"\n"
        (open_read rc in rc_txt).if {
          if ((index := rc_txt.first_substring_index comment_unix) < 0) then {
            rc_txt.append comment_unix
            rc_txt.append export_txt
          } else {
            index := index + comment_unix.count
            {rc_txt.at index = '\n'}.until_do {
              rc_txt.remove index
            }
            rc_txt.remove index
            rc_txt.insert_string export_txt to index
          }
          write rc content rc_txt
        } else {
          die ("Cannot read \"" + rc + "\".") exit 1
        }
      }
    }
  )
  
  - update_make_lip <-
  ( + index:Int
    "Update lisaac/make.lip config.".println
    chdir lisaac_dir or_exit
    String.tmp { (lip_txt:String_buffer)
      (open_read "make.lip" in lip_txt).if_false {
        die "Cannot read make.lip." exit 1
      }
      //
      index := idx_after "+ target:String := \"" in lip_txt from "make.lip"
      {lip_txt.at index = '\"'}.until_do {
        lip_txt.remove index
      }
      lip_txt.insert_string system to index
      write "make.lip" content lip_txt
    }
  )
  
  - update_elit_cfg <-
  ( + index:Int
    + value:String_alias
    
    Out #| "Update lisaac/elit/assets/elit.cfg."
    chdir elit_dir or_exit
    chdir "assets" or_exit
    String.tmp { elit_cfg:String_buffer
      (open_read "elit.cfg" in elit_cfg).if_false {
        die "Cannot read lisaac/elit/assets/elit.cfg." exit 1
      }
      //
      index := idx_after "shortcut   : \"" in elit_cfg from "elit.cfg"
      value := "standard"
      if (system = "apple") then {
        value := "mac_os"
      }
      until {elit_cfg.at index = '\"'} do {
        elit_cfg.remove index
      }
      elit_cfg.insert_string value to index
      //
      index := idx_after "decorated  : " in elit_cfg from "elit.cfg"
      value := "false"
      if (system = "apple") then {
        value := "true"
      }
      until {elit_cfg.at index = ','} do {
        elit_cfg.remove index
      }
      elit_cfg.insert_string value to index
      //
      write "elit.cfg" content elit_cfg
    }
  )
  
  - idx_after tag:String in txt:String from file_name:String_alias :Int <-
  ( + index:Int
    index := txt.first_substring_index tag
    if (index < 0) then {
      die ("Tag \"" + tag + "\" not in " + file_name + ".") exit 1
    }
    index + tag.count
  )

  - comment_unix    :String_alias := "\n# **** LISAAC-OMEGA TOOLS ****\n"
  
  - user_homedir_detection <-
  (
    if ((user_homedir := Environment.read_variable "HOME") = NULL) then {
      die "Warning: No $HOME variable." exit 1
    }
  )
    
  - system_detection <-
  ( + s:String_alias
    system := s := System.name
    if ((s != "windows") && {s != "android"} && {s != "apple"} && {s != "unix"}) then {
      Out # "Warning: strange system name \"" # s # "\".\n"  
    }
    if verbose then {
      ("system=\"" + system + "\".").println
    }
  )

Public
  
  - main <-
  (    
    "Installing Lisaac Ω Compiler and Tools.".println
    File_utils.pwd_in working_directory
    working_directory.add_dirsep
    
    verbose := Command_args.option_shift "--verbose"
    if (Command_args.count != 1) then {
      ("Unknow option \"" + (Command_args.at 1) + "\".").println
      "Usage: build_lisaac [--verbose]".println
      System.exit 1
    }
    if verbose then {
      ("Running from \"" + working_directory + "\".").println
    }
    system_detection
    
    lisaac_dir := working_directory.to_string_alias
    if (lisaac_dir.has ' ') then {
      Out # "Warning: Warning: Avoid spaces in the Lisaac Ω path.\n"
      Out # "lisaac_dir=\"" # lisaac_dir # "\".\n"
    }
    if (lisaac_dir.has_suffix "lisaac/") then {
      // ok
    }.elseif {lisaac_dir.has_suffix "lisaac\\"} then {
      // windows
    } else {
      die "buid_lisaac must be run from lisaac directory." exit 1
    }
    if verbose then {
      ("lisaac_dir=\"" + lisaac_dir + "\".").println
    }
    lisaac_bin_dir_set
    elit_dir_set
    
    user_homedir_detection
    if verbose then {
      ("user_homedir=\"" + user_homedir + "\".").println
    }
    remove_old_elit_cfg
    shell_detection
    cc_compile_bin_lisaac
    check_update_export_path
    update_make_lip
    update_elit_cfg
    compile_new_assets
    compile_elit
    big_show
    welcome_omega
    "Installation Completed Successfully.".println
    
    String.tmp2 { (old_path, substr: String_buffer)
      Environment.read_variable "PATH" in old_path
      verbose.if {
        Out # "Old PATH=\"" # old_path # "\"\n" 
        Out # "lisaac_bin_dir=\"" # lisaac_bin_dir # "\"\n" 
      }
      substr.append lisaac_bin_dir
      substr.remove_last
      if (! old_path.has_substring substr) then {
        "Open a new terminal window.".println
        "or:".println
        ("source ~/" + rc_file).println
      }
    }
    final_cleanup
  )
  
Private
  - shell_detection <-
  (
    shell := Environment.read_variable "SHELL"
    if ( shell = NULL ) then {
      die "No $SHELL variable." exit 1
    }.elseif { (shell = "/usr/bin/bash") && {system = "windows"} } then {
      shell := "/bin/bash"
    }
    if (verbose) then {
      ("shell=\"" + shell + "\".").println
    }
  )
  
  - die msg:String exit status:Int <-
  (
    msg.println
    if (! verbose) then {
      "Rerun using --verbose to try to debug.".println
    }
    System.exit status
  )
  
  - lisaac_bin_dir_set <-
  (
    check lisaac_dir non_ascii_warning
    chdir lisaac_dir or_exit
    chdir "bin" or_exit
    lisaac_bin_dir := working_directory.to_string_alias
    if verbose then {
      Out # "lisaac_bin_dir=\"" # lisaac_bin_dir # "\".\n"
    }
  )
  
  - elit_dir_set <-
  (
    chdir lisaac_dir or_exit
    chdir "elit" or_exit
    elit_dir := working_directory.to_string_alias
    if verbose then {
      ("elit_dir=\"" + elit_dir + "\".").println
    }
  )

  - write file_name:String_alias content content:String_buffer <-
  ( + file:Pointer
    + s:Int
    if verbose then {
      ("Open write \"" + file_name + "\".").println
    }
    file := File_utils.open_write file_name
    s := File_utils.write file with content size (content.count)
    if verbose then {
      ("writen " + s.to_string + " bytes.").println
    }
    File_utils.close file
    if verbose then {
      ("Close \"" + file_name + "\".").println
    }
  )
  
  - export export_txt:String_buffer add dir:String_alias <-
  (
    export_txt.append dir
    if ("/\\".has (export_txt.last)) then {
      export_txt.remove_last
    }
    export_txt.append ":"
  )
  
  - compile_elit <-
  ( + exit_status:Int
    
    "Compiling lisaac/elit ... wait...".println
    chdir elit_dir or_exit
    String.tmp { cmd:String_buffer
      cmd.append lisaac_bin_dir
      cmd.add_dirsep
      cmd.append "lisaac elit -q -boost"
      if (system != "windows") then {
        // -split does work yet on "windows".
        cmd.append " -split"
      }
      exit_status := execute_command cmd
      
    }
  )
  
  - big_show <-
  (
    "Compiling lisaac/big_show.li ...".println
    chdir lisaac_dir or_exit
    String.tmp { cmd:String_buffer
      cmd.append lisaac_bin_dir
      cmd.add_dirsep
      cmd.append "lisaac big_show -q -boost"
      execute_command cmd
    }
    String.tmp { cmd:String_buffer
      cmd.append lisaac_dir
      cmd.add_dirsep
      cmd.append "big_show"
      execute_command cmd background True
    }
  )
  
  - welcome_omega <-
  (
    "Compiling lisaac/example/welcome.li ... wait...".println
    chdir lisaac_dir or_exit
    chdir "example" or_exit
    chdir "welcome" or_exit
    String.tmp { cmd:String_buffer
      cmd.append lisaac_bin_dir
      cmd.add_dirsep
      cmd.append "lisaac welcome -q -boost"
      execute_command cmd
    }
    String.tmp { cmd:String_buffer
      cmd.append lisaac_dir
      cmd.add_dirsep
      cmd.append "example"
      cmd.add_dirsep
      cmd.append "welcome"
      cmd.add_dirsep
      cmd.append "welcome"
      execute_command cmd background True
    }
  )
  
  - remove_old_elit_cfg <-
  (
    String.tmp { path:String_buffer
      path.append user_homedir
      path.add_dirsep
      path.append ".elit.cfg"
      if ( verbose ) then {
        ("Remove old \"" + path + "\".").println
      }
      File_utils.remove path
      if (File_utils.file_exists path) then {
        die ("Cannot remove \"" + path + "\".") exit 1
      }
    }
  )
  
  - compile_new_assets <-
  (
    "Compiling lisaac/misc/new_assets.li".println
    chdir lisaac_dir or_exit
    chdir "misc" or_exit
    String.tmp { cmd:String_buffer
      cmd.append lisaac_bin_dir
      cmd.add_dirsep
      cmd.append "lisaac new_assets -q"
      execute_command cmd
    }
  )
  
  - check path:String non_ascii_warning <-
  ( + idx:Int
    + c:Char
    
    {idx <= (path.upper)}.while_do {
      c := path.at idx
      (c = ' ').if {
        Out # "The space character in \"" # path # "\" may cause future malfunctions.\n"
      }
      (! c.is_ascii).if {
        Out # "Non ASCII character in \"" # path # "\" may cause future malfunctions.\n"
      }
      idx := idx + 1
    }
  )
  
  - final_cleanup <-
  ( + i, status:Int
    
    verbose.if {
      Out # "Final cleanup (after installation)\n"
    }
    chdir elit_dir or_exit
    String.tmp { path:String_buffer
      
      path.copy elit_dir
      path.add_dirsep
      path.append "elit.h"
      file_remove path
      
      path.copy elit_dir
      path.add_dirsep
      path.append "elit.c"
      file_remove path
      
      path.copy elit_dir
      path.add_dirsep
      path.append "elit_data.c"
      file_remove path
      
      {status = 0}.while_do {
        path.copy elit_dir
        path.add_dirsep
        path.append "elit_code"
        i.append_in path
        path.append ".c"
        status := file_remove path
        (i > 100).if { status := 1 }
        i := i + 1
      }
    }  
  )
  