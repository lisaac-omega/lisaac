Header
  + name := Tass
Inherit
  - parent_texp:Texp := Texp
  
Public
  
  + var:Int
  + value:Texp
  
  - init v:Int with e:Texp :Tass <- ( (var,value) := (v,e); self)
  
  - run <- ( stk.at (bp+var) put (value.eval); )
  
  - append_in b:String_buffer <-
  (
    b | 'V'; var.append_in b
    b += " <- "
    value.append_in b
  )
