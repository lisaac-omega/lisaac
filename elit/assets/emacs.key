  null,
  {cmd: 'split_hori',          txt: "New Window Below",    key: 'Ctrl x, 2'},
  {cmd: 'split_vert',          txt: "New Window on Right", key: 'Ctrl x, 3'},
  {cmd: 'close_pg',            txt: "Delete Window",       key: 'Ctrl x, 0'},
  {cmd: 'change_pg, close_pg', txt: "Delete other Window", key: 'Ctrl x, 1'},
  {cmd: 'change_pg',           txt: "Change Window",       key: 'Ctrl x, o'},
  {cmd: 'middle_pg',           txt: "Cursor in the Middle",key: 'Ctrl l'},
  null,
  {cmd: 'split_win',           txt: "Split Window",        key: 'Ctrl x, Ctrl x'},
  {cmd: 'close_win',           txt: "Close Window",        key: 'Ctrl x, Ctrl q'},
