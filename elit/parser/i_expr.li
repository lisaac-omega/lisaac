Header
  + name := I_expr
Inherit
  + parent_inode:Flat I_node
  
Public
  
  - stck:Flat Array I_expr
  
  - new:I_expr <-
  ( + result:I_expr
    (stck.is_empty).if { result := I_expr.clone; } else { result := stck.pop; }
    result
  )
  
Public
    
  - error:Int <- ((ref = NULL) && {type = NULL}).to_int
  
  + ref:Expr
  + type:Type
    
  - new i:Int expr e:Expr :I_expr <- new.init i expr e type NULL
  - new i:Int type t:Type :I_expr <- new.init i expr NULL type t
  
  - copy:I_node <- new.init lower expr ref type type
  
  - init i:Int expr e:Expr type t:Type :I_expr <-
  (
    (lower,ref) := (i,e)
    upper := (e != NULL).ok i else {i-1}
    (e != NULL).if { type := e.type; } else { type := t; }
    self
  )
  
  - put_sty u:Uint16 slot s:Slot <-
  ( + m:Uint16
    (lower <= upper).if {
      (error != 0).if {
        m := Sty.ul_red
      } else {
        m := u | type_check s
      }
      "EXPR:".print; ref.type_name.println
      Sty.put m to lower in (Ia.sty)
      Sty.put m to (upper+1) in (Ia.sty)
    }
    Ia.inc_arg_i
  )
  
  - txt_in s:String_buffer <-
  ( 
    s.add_last '('
    s.add_last ')'
  )
  
  - rtxt_in s:String_buffer <- 
  ( 
    s.append "(˂"
    (type != NULL).if { type.txt_in s sty NULL; }
    s.append "˃)"
  )
  
  - size:Int <- (ref.dynamic_type = List).ok (-1) or 1
  - to_expr:Expr <- ref
  
  - free <- stck.add_last self
