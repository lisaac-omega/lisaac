Header
  + name := I_nil
Inherit
  + parent_inode:Flat I_node
  
Public
  
  - stck:Flat Array I_nil

  - new:I_nil <-
  ( + result:I_nil
    (stck.is_empty).if { result := I_nil.clone; } else { result := stck.pop; }
    result
  )
  
Public
  
  - type:Type <- NULL
  
  - error:Int <- upper - lower + 1
    
  - new l:Int to u:Int :I_nil <- new.init (l,u)
  
  - copy:I_node <- new.init (lower,upper)
  
  - init (l,u:Int) :I_nil <-
  (
    (lower,upper) := (l,u)
    {Ia.src.at upper = ' '}.while_do { upper := upper - 1; }
    self
  )
  
  - put_sty u:Uint16 slot s:Slot <-
  ( + m:Uint16
    (Ia.src.at lower.is_upper).if { m := Sty.typ; } else { m := Sty.non; }
    m := m | u
    (s = NULL).if {
      m := m | Sty.ul_red
      msg_err += "Arg. #"
      Ia.arg_i.append_in msg_err
      msg_err += ": \'"
      msg_err.append (Ia.src) from lower to upper
      msg_err += "\' not found. "
    } else {
      m := m | Sty.ul_orange
      msg_err += "New local `";
      msg_err.append (Ia.src) from lower to upper
      msg_err += "' of type "
      s.type_arg (Ia.arg_i).append_in msg_err
      msg_err += ". "
    }
    Sty.put m to lower in (Ia.sty)
    Sty.put m to (upper+1) in (Ia.sty)
    Ia.inc_arg_i
  )
  
  - txt_in s:String_buffer <-
  (
    s.add_last '\''
    s.append (Ia.src) from lower to upper
    s.add_last '\''
  )
  
  - rtxt_in s:String_buffer <-
  (    
    txt_in s; s+="(I_NIL)"
  )
  
  - size:Int <- upper - lower + 1
  - to_expr:Expr <-
  ( + result:Err
    result := Err.new (String_buffer,Array Uint16) exp (Array Expr) tmp False
    result.txt.append (Ia.src) from lower to upper
    result    
  )
  
  - free <- stck.add_last self
