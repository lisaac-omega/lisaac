Header
  + name := Exact Wloc
Inherit
  + parent_expr:Flat Expr
  
Insert
  - parent_recyclable:Recyclable := Recyclable

Private
  
Public
  + loc:Local
  + expr:Expr
  
Public
  - type:Type <- expr.type
  
  - res e:Expr :Self <-
  ( expr := e
    copy_itm e
    self
  )
  
  - new:Self <-
  parent_recyclable.new
  - free <-
  ( (expr != NULL).if { expr.free; expr := NULL; }; parent_recyclable.free; )
    
  - sub_draw <-
  (
    (expr.now pos_i).if { expr.draw; }
  )
