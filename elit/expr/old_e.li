Header
  + name := Exact Old_e
Inherit
  + parent_expr:Flat Expr
  
Private
  - stk_old:Flat Array Old_e
  
Public
  + expr:Expr
  
Public
  - type:Type <- expr.type
    
  - new:Self <-
  ( + r:Self
    (stk_old.is_empty).if { r := clone; } else { r := stk_old.pop; }
    r
  )
  - free <-
  ( (expr != NULL).if { expr.free; expr := NULL; }; stk_old.add_last self; )
  
  - new_parse t:Int <-
  ( (rd_word "Old").if {
      col (Look.keyword) sub 3
      expr := rd_expr_op
      (expr = NULL).if { err syntax msg "Expression is needed."; }
    }
  )
      
  - run <-
  (
    not_yet_implemented
    // Ici il est trop tard !
    // Il faut le gerer au parsing sinon c'est trop la merde au niveau du contexte !!
    // Donc: * remonter @tmp := EXPR (Att. @tmp peut etre complexe)
    //       * Mettre ici que @tmp
  )
  
