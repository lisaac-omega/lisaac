Header
  + name := Ext
Inherit
  //+ parent_tok_itm:Flat TOK_ITM
  + parent_expr:Flat Expr
  //- parent_op:OP := OP
  
Insert
  - parent_recyclable:Recyclable := Recyclable

Private  
        
Public
  
  + ttok:Ttok
  - type:Type <- ttok.type
  
  + lttok:Ttok
  
  + persistant:Boolean
  
  - new:Self <-
  parent_recyclable.new
  - free <-
  ( (ttok  != NULL).if { ttok.free;  ttok  := NULL }
    (lttok != NULL).if { lttok.free; lttok := NULL }
    persistant := False
    parent_recyclable.free
  )
  
  //
  // PARSER / DRAW
  //
  
  - new_parse t:Int <-
  (
    (rd_ext).if {
      col (Look.external) sub (pos_i.pt - Old pos_i.pt)
      (read_c ':').if {
        col (Look.symbol) sub 1
        persistant := read_c '('          
        ttok := Ttok.parse_sp (Ttok.tpro)
        (ttok = NULL).if { err syntax msg "Incorrect type."; }
        (read_c '{').if {
          lttok := Ttok.parse_sp (Ttok.tvec)
          (lttok = NULL).if { err syntax msg "Incorrect live type list."; }
          (! read_c '}').if { err warning msg "Added '}'. (3)"; }
        }
        (persistant).if {
          (read_c ')').if { 
            col (Look.symbol) sub 1
          } else {
            err warning msg "Added ')'. (6)"; 
          }
        }
      }
    }
  )
  
  - finalize t:Int db l:Int de e:Int <-
  ( t
    .when 0 then { parent_tok_itm.finalize t db l de e; }
    .when 1 then { parent_tok_itm.finalize t db (l+1) de (e-1); }
  )
        
  - run <- push self
