Header
  + name := Slot_body
Inherit  
  + parent_tok_drw:Flat Tok_drw
Insert
  - parent_lix_buf:Lix_buf := Lix_buf
  - parent_recyclable:Recyclable := Recyclable
    
Private
Public
  - is_major:Boolean := False
  
  + expr:Expr
  
  + slot:Slot
  - set_slot s:Slot <- ( slot := s; )
      
  - new:Self <- parent_recyclable.new
  
  - free <-
  ( (expr != NULL).if { expr.free; expr := NULL; }; parent_recyclable.free; )
      
  - detect:Boolean <-
  ( + c:Char
    (look "  ") && {(c := at (pos_i+2)) != '\n'} && {c != '['} && {c != '\0'}
  )
    
  - parse <-
  ( //? {sty.is_empty}
    Expr.skip_body
    end pos_i
   /* ((Page.cur_pg != NULL) && {Page.cur_pg = page}).if {
      + p,n:Int;      
      (p,n) := (pos_i,nl)
      pos_i := Old pos_i
      parse_real
      (pos_i,nl) := (p,n)      
    }   */
  )
  
  - begin_draw <-
  (    
    (expr = NULL).if {      
      parse_real
      pos_i := Old pos_i
      nl := Old nl
    }
  )
  
  - sub_draw <-
  (
    ((expr != NULL) && {expr.now pos_i}).if { expr.draw; }
  )
  
Private
  
  - parse_real <-
  (    
    //EXPR.print_local
    //slot.load_arg
    ln_limit := pt_b.pt + di
    //? {sty.is_empty}
    reset_sty pt_b    
    expr := Expr.rd_expr_op    
    (read_c ';').if { col (Look.symbol) sub 1; }
    //"\nSLOT_BODY:".print; pos_i.pt.print; '/'.print; di.println
    ln_limit := 0    
  )