Header
  + name := Slot_rmk
Inherit
  + parent_tok_drw:Flat Tok_drw
  
Insert
  - parent_lix_buf:Lix_buf := Lix_buf
  
Private
  - stk:Flat Array (Exact Slot_rmk)
  
Public
  - is_major:Boolean := False
     
  - new:Self <-
  ( + r:Self; (stk.is_empty).if { r := clone; } else { r := stk.pop; }; r)
  - free <- stk.add_last self
    
  // PARSER
  
  - key:String_alias := "  // "
  
  - detect:Boolean <- look key
  
  - parse <-
  ( 
    {look key}.while_do {
      pos_i := pos_i + 4
      skip_until '\n'
      (at pos_i = '\n').if { nl := nl + 1; pos_i := pos_i + 1; }
      //rd_rem_cpp
    }
  )
  
  - cmd_new_line:Boolean <-
  (
    txt_buf.at pos add_text "\n  // "
    pos := pos + 6
    True
  )
  
  - cmd_suppr:Boolean <-
  (
    (txt_buf.at (pos - 5) = '\n').if {
      pos := pos - 2
      txt_buf.rm pos times 3
    } else {
      txt_buf.rm pos
    }
    True
  )
  
  // DRAW
    
  - begin_draw <-
  ( 
    (sty.is_empty).if {      
      {look key}.while_do {
        pos_i := pos_i + 2        
        rd_rem_cpp
      }
      pos_i := Old pos_i
      nl := Old nl
    }
    tex.push (x_space*2,0)
    pos_i := pos_i + 4
  )
  
  - sub_draw <-
  (
    ((at (pos_i-1) = '\n') && {pos_i != pt_b+di}).if {
      pos_i := pos_i + 4
    }
  )
  
  - end_draw <-
  (
    rmk (tex.x,tex.ymin) to (tex.xmax,tex.y)
    tex.pop_add_y 0
  )
    
Private
  
  - rmk (x0,y0:Real32) to (x1,y1:Real32) <-
  ( 
    begin_path
    stroke_color (Look.cols.at (Look.rmk))
    stroke_width 3
    line (x0,y0) to (x0,y1)
    stroke
  )
