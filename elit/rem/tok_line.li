Header
  + name := Tok_line
Inherit
  + parent_tok_txt:Flat Tok_txt
  
Private
  - stkl:Flat Array (Exact Tok_line)
  
  - last_sec:Section
  
Public
  
  - show:Boolean <- 
  (
    last_sec := get_prev_tok Section
    (last_sec = NULL) || {! last_sec.is_parent} || {last_sec.show_inherit} || {last_sec.proto.open_win = '3'}
  )
    
  
  - new:Self <- ( + r:Self; (stkl.is_empty).if { r := clone; } else { r := stkl.pop; }; r)
  
  - free <- stkl.add_last self
  
  - y_section:Real32
  - begin_draw <-
  (    
    y_section := tex.y
    fill_color (Look.none)
  )
  
  - post_draw <-
  ( 
    (last_sec != NULL).if { last_sec.draw_section y_section; }
  )
    
