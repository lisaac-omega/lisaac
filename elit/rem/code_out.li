Header
  + name := Code_out
Inherit
  + parent_tok_drw:Flat Tok_drw
  
Insert
  - parent_lix_buf:Lix_buf := Lix_buf
  - parent_recyclable:Recyclable := Recyclable
  
Private
  
Public
     
  - new:Self <-
  parent_recyclable.new
  - free <- parent_recyclable.free
    
  //
  // PARSER / DRAW
  //
  
  - detect:Boolean <- look "  /*"
  
  - parse <-
  (
    pos_i := pos_i + 2
    rd_rem_c
    skip_until '\n'
    (at pos_i = '\n').if { pos_i := pos_i + 1; nl := nl + 1; }
  )
    
  - begin_draw <- fill_color (Color.gray)
