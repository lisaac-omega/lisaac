Header
  + name := Big_show
  
/*
  Welcome to Lisaac Ω
  A programming language designed to become the reference for teaching
  programming. Lisaac Ω aims to provide a clear, consistent, and modern
  environment to help students grasp the core principles of programming
  with ease and efficiency.

  Developed at the University of Lorraine and the University of
  Strasbourg, Lisaac Ω is the result of research and innovation in
  object-oriented and prototype-based programming models.

  This show plays a tour of the distribution: demos, games, teaching
  examples and two prototypes of the library itself.

  To compile, in a terminal:
  $ cd lisaac
  $ lisaac big_show -q -boost
  $ ./big_show

  Created and maintained by Benoît Sonntag and Dominique Colnet.
  */
Insert
  
  - code_show:Code_show := Code_show 
  
Public
  
  - main <-
  (
    show (
      "example/welcome/welcome.li",
      
      "example/hello_world.li",
      
      "example/gems/gems.li", "background",
      "game_show.li",
      
      "example/CodEx/Tortue/rosace_cercles.li",
      "example/CodEx/Tortue/tortue_show.li",
      
      "example/misc/glyph_example.li", "no-run", 
      
      "example/basics/factorial_example.li", "run", "1000",
      "example/CodEx/Fibonacci/fibonacci.li", "run", "v2 500",
      "example/example_show.li",
      
      "lib/collection/collection.li", "no-run",
      "lib/boolean/boolean.li", "no-run",
      
      "example/startrek/startrek.li"
    )
  )
