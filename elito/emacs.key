//
// Grammar for <file.key>
// E          -> [ 'FunctionKeysAccess' '[' TOUCH ']' ] MENU
// MENU       -> { '<' [ text ] '>' { ITEM } }
// ITEM       -> text [ '[' SHORTCUT { ',' SHORTCUT } ']' ] '(' function { ',' function } ')' 
//             | '-'
// SHORTCUT   -> KEY { KEY }
// KEY        -> [a-z or all single character]
//             | 'Alt' | 'Ctrl' | 'Esc' | 'Shift' | 'Tab' | 'Space'
//             | 'Begin' | 'End'  | 'PgUp'  | 'PgDown' 
//             | 'Right' | 'Left' | 'Up'    | 'Down'
//             | 'Suppr' | 'Insr' | 'Enter' | 'Del'
//             | 'F'[1-9] |  
// text       -> [A-Za-z0-9. ]+
// string     -> '"' [All character]+ '"'
// function   -> 'open' | 'save' | 'save_as' | 'exit' | ...

//-----------------------------------------------------
<File>
Open...               [Ctrl x, Ctrl f] (open)
Insert File...        [Ctrl x, i]      (insert_file)
Open File at Point    [Ctrl x, f]      (open_at_point)
-
Save                  [Ctrl x, Ctrl s] (save)
Save as...            [Ctrl x, Ctrl w] (save_as)
-
Command Shell...      [Ctrl x, Ctrl t]       (execute "")
Shell execution       [Ctrl x, Ctrl Shift t] (execute "/bin/bash")
-
New Window Below      [Ctrl x, 2]      (split_hori)
New Window on Right   [Ctrl x, 3]      (split_vert)
Delete Window         [Ctrl x, 0]      (close_pg)
Delete other Window   [Ctrl x, 1]      (delete_other_window)
Change Window         [Ctrl x, o]      (change_pg)
Cursor in the Middle  [Ctrl l]         (middle_pg)
-
Quit                  [Ctrl x, Ctrl c] (exit)

//-----------------------------------------------------
<Edit>
Undo                  [Ctrl _]       (undo)
Abort command         [Esc, Esc]     (stop_cmd)
-
Cut                   [Ctrl w]       (cut)
Copy                  [Esc, w]       (copy)
Paste                 [Ctrl y]       (paste)
-
Cut Line to the Right [Ctrl k]       (cut_end_line)
Cut Line to the Left                 (select_on, go_beg_line, cut)
Erase Line                           (go_beg_line, select_on, go_end_line, go_next_char, suppr_select)
Cut Word              [Esc, d]       (select_on, go_next_word, cut)
-
Move Line Up          [Ctrl Up]      (go_beg_line, select_on, go_end_line, go_next_char, cut, go_prev_line, go_beg_line, paste, go_prev_line)
Move Line Down        [Ctrl Down]    (go_beg_line, select_on, go_end_line, go_next_char, cut, go_next_line, go_beg_line, paste, go_prev_line)
-
Select Start          [Ctrl Space]   (select_on)
Select All            [Ctrl x, h]    (go_eof, select_on, go_top)
-
Search Foreward...    [Ctrl s]       (search_fore)
Search Backward...    [Ctrl r]       (search_back)
Replace String...     [Esc, %]       (replace)
-
Completion            [Alt /]        (completion)
UpperCase Word        [Esc, u]       (to_upper)
LowerCase Word        [Esc, l]       (to_lower)
Delimiter-separated   [Esc, m]       (to_delimiter)
-
Indentation Line or Select [Tab]     (indent)
Indentation All                      (go_eof, select_on, go_top, indent)

//-----------------------------------------------------
<Buffers>
.                                    (select_buffer)
.                                    (select_buffer)
.                                    (select_buffer)
.                                    (select_buffer)
.                                    (select_buffer)
.                                    (select_buffer)
.                                    (select_buffer)
.                                    (select_buffer)
.                                    (select_buffer)
.                                    (select_buffer)
-
Select Named Buffer... [Ctrl x, b]   (buffer_list)
Kill Buffer...         [Ctrl x, k]   (kill_buffer)
Kill All Buffer        [Ctrl x, Shift k] (kill_all_buffer)

//-----------------------------------------------------
<Tools>
Go to Line...          [Esc, g]          (go_line)
Go to Point...         [Alt g,c][Esc, p] (go_point)
-
Go Begin of file       [Esc, <]          (go_top)
Go End of file         [Esc, >]          (go_eof)
-
Go Next Word           [Ctrl Right]      (go_next_word)
Go Previous Word       [Ctrl Left]       (go_prev_word)
-
Go Up Page             [PgUp]            (go_up_pg)
Go Down Page           [PgDown]          (go_down_pg)
-
Go Previous Line       [Up]              (go_prev_line)
Go Next Line           [Down]            (go_next_line)
-
Go Begin Line          [Beg]             (go_beg_line)
Go End Line            [End]             (go_end_line)
-
Go next character      [Ctrl f][Right]   (go_next_char)
Go previous character  [Ctrl b][Left]    (go_prev_char)
-
Start Macro            [Ctrl x, (]       (start_macro)
End Macro              [Ctrl x, )]       (end_macro)
Call Macro             [Ctrl x, e]       (call_macro)
-
Repeater...            [Ctrl u]          (repeater) 

//-----------------------------------------------------
<Lisaac>
Inc. variable        [Alt +, Alt +]  (go_prev_word, select_on, go_next_word, copy, go_next_word, insert " := ", paste, insert " + 1;")
Dec. variable        [Alt -, Alt -]  (go_prev_word, select_on, go_next_word, copy, go_next_word, insert " := ", paste, insert " - 1;")
Auto setter          [Alt s] (go_beg_line, go_next_word, go_prev_word, select_on, go_end_line,
                              copy, go_end_line,
                              insert "\n\n  - set_", paste, go_beg_line, go_next_word, 
                              insert " \n",paste,insert "\n",go_prev_line,go_beg_line,
                              select_on,go_next_word,copy,go_prev_line,go_end_line,select_on,
                              go_next_line,go_next_line,go_beg_line,suppr_select,
                              paste,go_prev_word,go_next_char,select_on,go_next_word,suppr_select,
                              go_end_line,
                              go_prev_char,insert " <-\n  (\n    ",paste,
                              insert " := ", paste,go_prev_word,go_next_char,select_on,go_end_line,
                              suppr_select, insert ";\n  );\n")
-
Begin New Prototype  [Alt b]         (insert "Section Header\n\n  + name := ;\n\nSection Inherit\n\n  - parent_clone:OBJECT := OBJECT;\n\nSection Public\n\n  ", 
                                      go_prev_line, go_prev_line, go_prev_line, go_prev_line, 
                                      go_prev_line, go_prev_line, go_prev_line, go_prev_line, 
                                      go_end_line, go_prev_char)
Insert Create        [Alt c]         (insert "- create:SELF <-\n  ( + result:SELF;\n    result := clone;\n    result.make;\n    result\n  );\n\n  - make <-\n  ( \n  );\n",
                                      go_prev_line, go_prev_line, go_end_line)
-
Library Explorer...      [Ctrl x, Ctrl l]  (lib_explorer)
Current Path Explorer... [Ctrl x, Ctrl p]  (path_explorer)

//-----------------------------------------------------
<Help>
Font Size Upper       [Ctrl +]        (font_size_upper)
Font Size Lower       [Ctrl -]        (font_size_lower)
-
Buffer line         On/Off            (buffer_line_switch)
Help line            On/Off           (help_line_switch)
Sound                 On/Off          (sound_switch)
-
About Elit            [Ctrl h,Ctrl a] (about)

//-----------------------------------------------------
<>
Next line          [Esc, Space]   (insert "\r")
Go previous Line   [Ctrl p]   (go_prev_line)
Go Next Line       [Ctrl n]   (go_next_line)
Abort command      [Ctrl g]   (stop_cmd)
Go Begin Line      [Ctrl a]   (go_beg_line)
Go End Line        [Ctrl e]   (go_end_line)
Delete char        [Ctrl d]   (delete_char)
Go Previous Word   [Esc, b]   (go_prev_word)
Go Next Word       [Esc, f]   (go_next_word)
Go Down Page       [Ctrl v]   (go_down_pg)
Go Up Page         [Esc, v]   (go_up_pg)

