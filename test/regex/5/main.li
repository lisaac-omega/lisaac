Header
  + name := Main
  /*
  Results checked against the <regex.h> of the GNU libc, on random expressions:
  stdout only keeps the cases where the two implementations agree.
  */
Private
  
  - c (cf,ef,nm:Int,p,d:String) <-
  // Compile @p, run it on @d, and print the result.
  ( + re:Regex
    + e:Int
    re := Regex.create_nmatch nm
    e := re.regcomp p cflag cf
    (e != 0).if {
      Out # 'E' # e # '\n'
    } else {
      e := re.regexec d start 0 cflag ef
      (e != 0).if {
        Out # "N\n"
      }.elseif {(cf & Regex.nosub) != 0} then {
        Out # "Y\n"
      } else {
        Out # 'M'
        0.to (nm - 1) do { i:Int
          Out # ' ' # (re.offset_start_index i) # ',' # (re.offset_end_index i)
        }
        Out # '\n'
      }
    }
  )
  
