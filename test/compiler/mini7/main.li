Header
  + name := Main
- external := `#include <stdlib.h>`
Public

  + upper:Int
  
  - main <-
  ( + result:Self
    + a:Int
    + toto:{} 
    result := `NULL`:Exact Main
    
    toto := { result.add_last2; }
    toto.value
    toto.value
    
    a := result.upper
    `@a`;
  )
  
  - add_last2 <-
  (
    `/* BEGIN */`
    (Boolean.unpredictable).if_false {
      upper := `0`:Int
    }
    `/* END */`
  )

