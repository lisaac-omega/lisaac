Header
  + name := Bug_copilo
/**/
  
Public
  - str1:String_alias := "\0A7h\\0A8h\\0A9h\\0A0h\\0B9h\"
  
  - str2:String_buffer
  
  - main <-
  ( 
    str2 := String_buffer.create 6
    //OUT # str2.count # '\n'
    str2.add_last '\0A7h\'
    //OUT # str2.count # '\n'
    str2.add_last '\0A8h\'
    str2.add_last '\0A9h\'
    str2.add_last '\0A0h\'
    str2.add_last '\0B9h\'
    //OUT # str1.count # "  " # str2.count # "\n"
    from 0 to (str1.upper) do { i:Int
      Test.check (str1.at i) character (str2.at i)
    }
  )
