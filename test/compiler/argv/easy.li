Header
  + name := Easy
  
/**/


Public
  
  - run names:String_alias^n <-
  (
    { ni:String;
      ni.println
    }.value names
  )
  
  - main <-
  (
    run ("dessin_carre", "dessin_triangle", "dessin_triangle_bis", "dessin_maison",
      "dessin_hexagone", "dessin_feuille", "dessin_etoile", "flocon_koch", "arbre_fractale",
    )
  )
