Header
  + name := Msg_generic
/*
  Function with multiple results example. The gain is not only syntactical!
  Example below shows an efficient, still recursive, solution for the
  Fibonacci example. Thanks to the usage of two results, the exponential
  runtime complexity is avoided.
  Just compare:
  ./fibonacci v1 40
  and
  ./fibonacci v2 40

  */
Insert
  
  - french: French_corner := French_corner
  
Public
  - est_premier (n:ℤ) : Boolean <-
  ( + result:Boolean
    + i:ℤ
    if (n < 2) then {
      result := False
    } else {
      i := 2 
      //tant_que ((i <= n.sqrt) && {!result}) faire {
      tant_que {True} faire {
        //si ((n / d) = 0) alors {
        si (n = 0) alors {
          result := True
        }
      }
    }
    result
  )

  - main <-
  ( 
    ? {(est_premier 0) = faux}
  )
