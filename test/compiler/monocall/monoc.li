Header
  + name := Monoc
  
/**/
Public
  - main <-
  ( + ap:Auxprot
    ap := Auxprot.new
    Test.check (ap.counter) integer 0
    ap.monoproc
    Test.check (ap.counter) integer 1
    (ap)monoproc
    Test.check (ap.counter) integer 2
    monoproc(ap)
    Test.check (ap.counter) integer 3
    (monoproc ap)
    Test.check (ap.counter) integer 4
    
    Test.check (ap.monofonc) integer 5
    Test.check ((ap)monofonc) integer 6
    Test.check (monofonc(ap)) integer 7
    Test.check (monofonc ap) integer 8
  )
