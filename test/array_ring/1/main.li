Header
  + name := Main

Public

  + array:Array Int

  + array_ring:Array_ring Int

  - main <-
  ( + idx: Int

    array := new Array Int capacity 3
    Test.check (array.capacity) integer 4
    array_ring := new Array_ring Int capacity 2
    Test.check (array_ring.capacity) integer 2

    idems

    array.add_last (1,2,3)
    array_ring.add_last (1,2,3)
    
    idems

    array.add_first (4,5,6)
    array_ring.add_first (4,5,6)
    
    idems


    array.at 2 add (7,8,9)    
    array_ring.at 2 add (7,8,9)

    idems

    array.at 0 add 10
    array_ring.at 0 add 10
    

    idems


    array.at 1 add (11, 12)
    array_ring.at 1 add (11, 12)
    
    idems

    idx := array.upper
    array.at idx add (13, 14)
    array_ring.at idx add (13, 14)

    idems


    idx := array.upper + 1
    array.at idx add (15, 16)
    array_ring.at idx add (15, 16)
    
    idems
  )


  - idems <-
  ( + idx:Int
    
    while { idx <= array.upper} do {
      Test.check (array.at idx) integer (array_ring.at idx)
      idx := idx + 1
      
    }
    Test.check idx integer (1 + array.upper)
    Test.check idx integer (1 + array_ring.upper)

  )
