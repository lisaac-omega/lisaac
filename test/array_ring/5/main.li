Header
  + name := Main

Public

  + array:Array Int

  + single_list:Single_list Int

  - main <-
  ( + idx: Int

    array := new Array Int capacity 2 ; Test.check (array.capacity) integer 2
    array.set_capacity 4 ; Test.check (array.capacity) integer 4
    array.set_capacity 8 ; Test.check (array.capacity) integer 8


    single_list := new Single_list Int

    idems

    array.add_last (1,2,3)
    single_list.add_last (1,2,3)
    
    idems

    array.add_first (4,5,6)
    single_list.add_first (4,5,6)
    
    idems

    array.at 2 add (7,8,9)
    single_list.at 2 add (7,8,9)
    
    idems

    array.at 0 add 10
    single_list.at 0 add 10
    
    idems

    array.at 1 add (11, 12)
    single_list.at 1 add (11, 12)
    
    idems

    idx := array.upper
    array.at idx add (13, 14)
    single_list.at idx add (13, 14)
    
    idems

    idx := array.upper + 1
    array.at idx add (15, 16)
    single_list.at idx add (15, 16)
    
    idems
  )


  - idems <-
  ( + idx:Int
    
    while { idx <= array.upper} do {
      Test.check (array.at idx) integer (single_list.at idx)
      idx := idx + 1
      
    }
    Test.check idx integer (1 + array.upper)
    Test.check idx integer (1 + single_list.upper)

  )
