Header
  + name := Rand_max
Public
  - main <-
  ( + random: Random
    + mt19937: Mt19937
    + v1,c:Int
    
    c := Test.counter
    random := new Random.init 5
    while {v1 != 1} do {
      v1 := random.max 1
      Test.check True
    }
    Test.check (Test.counter - c) integer 1 // Good
    
    c := Test.counter
    random := new Random.init 5
    while {v1 != 0} do {
      v1 := random.max 1
      Test.check True
    }
    Test.check (Test.counter - c) integer 4 // Mouais...
    
    c := Test.counter    
    mt19937 := new Mt19937.init 5
    while {v1 != 1} do {
      v1 := mt19937.max 1
      Test.check True
    }
    Test.check (Test.counter - c) integer 1 // Good
    
    c := Test.counter    
    mt19937 := new Mt19937.init 5
    while {v1 != 0} do {
      v1 := mt19937.max 1
      Test.check True
    }
    Test.check (Test.counter - c) integer 2 // Good
  )
