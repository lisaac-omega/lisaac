Header
  + name := New_array_ring
Public
  - main <-
  ( + a:Array_ring Int
    a := new Array_ring Int of (4,3,2,1)
    Test.check (a.at 0 = 4)
    Test.check (a.at 1 = 3)
    Test.check (a.at 2 = 2)
    Test.check (a.at 3 = 1)
    
    a := new Array_ring Int of 5
    Test.check (a.at 0 = 5)
    
  )
