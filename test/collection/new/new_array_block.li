Header
  + name := New_array_block
Public
  - main <-
  ( + a:Array_block Int
    a := new Array_block Int of (4,3,2,1)
    Test.check (a.at 0 = 4)
    Test.check (a.at 1 = 3)
    Test.check (a.at 2 = 2)
    Test.check (a.at 3 = 1)
    
    a := new Array_block Int of (5)
    Test.check (a.at 0 = 5)
    
  )
