Header
  + name := Linked_list_of
Public
  - main <-
  ( + a:Linked_list String
    + b:Array String
    a := new Linked_list String of ("foo","bar","zoo")    
    Test.check (a.count) integer 3
    Test.check (a.lower) integer 0    
    Test.check ((a.at 0) = "foo")
    Test.check ((a.at 1) = "bar")
    Test.check ((a.at 2) = "zoo")
    
    b := new Array String of (a.at 1)
    Test.check (b.count) integer 1
    Test.check ((b.at 0) = "bar")
  )
