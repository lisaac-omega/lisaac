Header
  + name := Af_linked_list
Public
  - main <-
  ( + a:Linked_list Int
    
    a := new Linked_list Int
    a.add_first 1
    Test.check (a.at 0 = 1)  
    
    a := new Linked_list Int
    a.add_first (1, 2)
    Test.check (a.at 0 = 1)  
    Test.check (a.at 1 = 2)  
    
    a := new Linked_list Int
    a.add_first (1, 2, 3)
    Test.check (a.at 0 = 1)  
    Test.check (a.at 1 = 2)  
    Test.check (a.at 2 = 3)
    
    a := new Linked_list Int of 2
    a.add_first 1
    Test.check (a.at 0 = 1)
    Test.check (a.at 1 = 2)
    
    a := new Linked_list Int of (3,4)
    a.add_first(1,2)
    Test.check (a.at 0 = 1)
    Test.check (a.at 1 = 2)
    Test.check (a.at 2 = 3)
    Test.check (a.at 3 = 4)
    
    a := new Linked_list Int of 4
    a.add_first(1,2,3)
    Test.check (a.at 0) integer 1
    Test.check (a.at 1 = 2)
    Test.check (a.at 2 = 3)
    Test.check (a.at 3 = 4)
    
    a := new Linked_list Int of (5, 6)
    a.add_first(1,2,3,4)
    Test.check (a.at 0) integer 1
    Test.check (a.at 1 = 2)
    Test.check (a.at 2 = 3)
    Test.check (a.at 3 = 4)
    Test.check (a.at 4 = 5)
    Test.check (a.at 5 = 6)
  )
