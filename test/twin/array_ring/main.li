Header
  + name := Main
  /**/
Public
  - main <-
  ( + a1, a2: Array_ring Int
    a1 := new Array_ring Int capacity 1024
    a1.add_last 2
    a2 := a1.twin
    Test.check (a1.upper = a2.upper)
    Test.check (a1.first = a2.last)
    //Out # "a1.capacity:" # (a1.capacity) # '\n'
    //Out # "a2.capacity:" # (a2.capacity) # '\n'
    Test.check (a2.capacity <= a1.capacity)
  )

