Header
  + name := Main
Public
  - max:Int <- 100000
  
  - main <-
  ( + a:Array_block Int
    a := Array_block Int .new
    1.to max do { k:Int
      a.add_last k
    }
    Test.check (a.first) integer 1
    Test.check (a.last) integer max
    1.to max do { k:Int
      Test.check (a.at (k - 1)) integer k
    }
    1.to max do { k:Int
      a.remove_last
    }
    Test.check (a.is_empty)
  )
