Header
  + name := Wrong_expanded1
Inherit
  - parent_clone:Clone := Clone
  
Public
  
  + bidon:Flat Array Int
    
  - main <-
  ( + sto1,sto2:C_array Int
    + other:Wrong_expanded1
    + v:Int
    bidon.add_last 1
    other := clone
    Test.check (other.bidon.upper = 0)
    v := other.bidon.first
    Test.check (v = 1)
    sto1 := sto2 := bidon.storage
    {sto1 = sto2}.while_do {
      bidon.add_last 1
      sto2 := bidon.storage
    }
    Test.check (other.bidon.upper = 0)
    v := other.bidon.first
    other.bidon.at 0 put 5; // Encore plus grave: j'ecris potentiellement sur
    // un autre objet mis a la place de l'ancien storage...
    //? {v = 1}.txt {v.to_string}; // ouille
    Test.check (v != 1) // ouille
    // DCDC Finalement on fait quoi.... c'est quand m^eme cool d'avoir des Flat Array....
    // ... finalement, c'est un problème de conception de MAIN qui devrait pas se laisser
    // cloner sans twinner son expanded bidon... 
  )
