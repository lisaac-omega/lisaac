Header
  + name := Main
Public
  - max:Int <- 99
  
  - main <-
  ( + a:Array Int
    a := Array Int .create_with_capacity max
    1.to max do { k:Int
      a.add_first (max - k)
    }
    1.to max do { k:Int
      Test.check (a.at (k - 1)) integer (k - 1)
    }
    Test.check (a.first) integer 0
    Test.check (a.last) integer (max - 1)
    1.to max do { k:Int
      a.remove_first
    }
    Test.check (a.is_empty)
  )
