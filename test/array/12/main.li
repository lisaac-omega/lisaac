Header
  + name := Main
Public
    
  - main <-
  ( + t:Array Char
    t := Array Char.create_with_capacity 6
    0.to 5 do { i:Int; t.add_last ('A'+#i); t.last.print; }
    '\n'.print
    t.move_to_last 1 to 3
    String.tmp { tmp:String_buffer
      0.to 5 do { i:Int; tmp | t.at i; }
      tmp.println
      ? {tmp == "AEFBCD"}
    }
  )
