Header
  + name := Main
Public

  - main <-
  ( + a1,a2:Array Int
    + b1,b2:Array_block Char
    //
    a1 := Array Int .create_with_capacity 1024
    a1.add_last 2
    a2 := a1.twin
    Test.check (a1.upper = a2.upper)
    Test.check (a1.first = a2.last)
    //
    b1 := Array_block Char .new
    b1.add_last '2'
    b2 := b1.twin
    Test.check (b1.upper = b2.upper)
    Test.check (b1.first = b2.last)
    Utils.exit 0
  )

