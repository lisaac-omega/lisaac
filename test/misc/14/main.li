Header
  + name := Main
Public
  
  - main <-
  ( + min,max:Int64
    
    max := `0x7FFFFFFFFFFFFFFF`:Int64
    ? {max.to_string == "9223372036854775807"}
    min := `0x8000000000000000`:Int64
    ? {min.to_string == "-9223372036854775808"}
    Utils.exit 0
    ("Hello" + " Dom").to_string_alias; // Bug compilo ASCII    
  )
