Header
  + name := Main
Public
  
/*  
  - last_bit x:INTEGER_64 :INTEGER_64 <-
  [ ? {x != 0}; ]
  ( + pos:INTEGER
    `{ unsigned long pos,x=@x`
    `  __asm__ ("bsrq %1, %0" : "=r" (pos) : "r" (x))`
    pos := `pos`:INTEGER
    `}`
    pos
  )
  
  */
  
  - last_bit x:Int64 :Int64 <-
  [ ? {x != 0}; ]
  ( + pos:Int
    pos := 63 - `__builtin_clzl(@x)`:Int64
    pos
  )


  - main <-
  ( 
    Test.check (last_bit 1) integer 0
    Test.check (last_bit 2) integer 1
    Test.check (last_bit 3) integer 1
    Test.check (last_bit 4) integer 2
    Test.check (last_bit 5) integer 2
    Test.check (last_bit 6) integer 2
    Test.check (last_bit 7) integer 2
    Test.check (last_bit 8) integer 3
    Test.check (last_bit 9) integer 3
    Test.check (last_bit 10) integer 3
    Test.check (last_bit 11) integer 3
    Test.check (last_bit 12) integer 3
    Test.check (last_bit 13) integer 3
    Test.check (last_bit 14) integer 3
    Test.check (last_bit 15) integer 3
    Test.check (last_bit 16) integer 4
    Test.check (last_bit 32) integer 5
    Test.check (last_bit 64) integer 6
    Test.check (last_bit 1024) integer 10
    Test.check (last_bit 4096) integer 12
    Test.check (last_bit 4097) integer 12
    Test.check (last_bit 4098) integer 12
    
  )
  
