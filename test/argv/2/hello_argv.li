Header
  - name := Hello_argv
  

Public

  - toto d:Int
  lst a:Int^n
  msg f:String_alias
  lst c:Char^n
  other s:String_alias^p <-
  (
    Out # "Count:" # n # ',' # p # '\n'
    { (ai:Int,ci:Char)
      Out # ai # ' ' # ci # '\n';      
    }.value (a,c)
    
    
    { si:String_alias
      si.println
    }.value s
    
    
    f.println
    
    (d > 1).if {
      toto (d-1) lst a msg f lst c other s
    }
    
  )
  

  - main <-
  (
    toto 0 lst (1,2) msg "fin!" lst ('a','b','c') other ("Moi")
  )
  