Header
  + name := Main
Public
  - main <-
  ( + array:Array Int
    array := Array Int .create_with_capacity 4
    1.to 5 do { i:Int
      array.add_last i
    }
    array.foreach { i:Int
      "foreach a:".print
      i.println
    }
    array.foreach_backward { i:Int
      "foreach b:".print
      i.println
    }
    array.while_do { i:Int
      "foreach c:".print
      i.println
      i < 3
    }
    array.while_do_backward { i:Int
      "foreach d:".print
      i.println
      i < 3
    }
    
  )
