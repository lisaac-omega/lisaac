Header
  + name := KEYBOARD_CHECK;
  /*


  */
  
Inherit 
  + parent_window:Expanded WINDOW  
Private
    
  + key_mem: STRING_BUFFER := new STRING_BUFFER capacity 16
  
  + cmd_mem: UINTEGER_8
  
Public

  - main <-
  (
    KEYBOARD.set_debug TRUE
    init "Keyboard Check" size (360*2, 240*2)
    PAPER.run
  )
  
  - draw <-
  ( + x, y, lx, dy:INTEGER
    + txt: STRING
    begin_path
    rect (0,0) size (width.to_integer,height.to_integer)
    fill_color (COLOR.white)
    fill   
    
    lx := 100
    dy := 60
    font_size 34
    
    label (x :=  lx, y := dy / 2) txt "Keyboard Control - Lisaac Ω"    
    
    label (x := lx, y := y + dy) txt "WINDOW.key"
    value (x := x + 190, y) txt key_mem
    label (x := x + 30, y) txt "cmd"
    value (x := x + 80, y) int cmd_mem
    
    STRING.tmp { txt_buff:STRING_BUFFER
      label (x :=  lx, y := y + dy) txt "KEYBOARD.key_to_string"
      if (key_mem.is_empty) then {
        txt_buff.append "<none>"
      } else {
        KEYBOARD.key_to_string key_mem cmd cmd_mem in txt_buff
      }
      value (x := x + 350, y) txt txt_buff
    }
    
    label (x := lx, y := y + dy) txt "KEYBOARD.k_mem"
    value (x := x + 275, y) int (KEYBOARD.k_mem)
    
    label (x := lx, y := y + dy) txt "KEYBOARD.key_mem"
    value (x := x + 290, y) int (KEYBOARD.key_mem)
    
    label (x := lx, y := y + dy) txt "KEYBOARD.press_mem"
    if (KEYBOARD.press_mem) then {
      txt := "<yes>"
    } else {
      txt := "<no>"
    }
    value (x := x + 320, y) txt txt    
    
    label (x := lx, y := y + dy) txt "KEYBOARD.mods_mem"
    value (x := x + 320, y) int (KEYBOARD.mods_mem)    
    
    label (x := lx, y := y + dy) txt "KEYBOARD.cmd"
    value (x := x + 245, y) int (KEYBOARD.cmd)    
        
    PAPER.refresh_again
  )
   
  - key s:STRING cmd c:UINTEGER_8 <-
  (
    key_mem.copy s
    cmd_mem := c
  )
  
Private
  
  - label (x,y:INTEGER) txt txt:STRING <-
  (
    font_face_id (FONT sys (FONT roman))
    fill_color (COLOR.gray)
    text (x, y) msg txt
  )
  
  - value (x,y:INTEGER) txt txt:STRING <-
  (
    font_face_id (FONT sys (FONT roman))
    fill_color (COLOR.black)
    text (x, y) msg txt
  )
  
  - value (x,y:INTEGER) int i:INTEGER <-
  (
    STRING.tmp { buf: STRING_BUFFER
      i.append_in buf
      value (x,y) txt buf
    }
  )
  