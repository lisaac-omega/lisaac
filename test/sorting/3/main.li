Header
  + name := Main
Public
  
  + a1:Array Int
  
  + a2:Array Int
  
  - main <-
  (
    a1 := Array Int .create_with_capacity 12
    a1.add_last 5
    a1.add_last 4
    a1.add_last 3
    a1.add_last 2
    a1.add_last 1
    a2 := Array Int .create_with_capacity 12
    a2.add_last 5
    a2.add_last 1
    a2.add_last 2
    a2.add_last 3
    a2.add_last 4
    Test.check (! (a1 == a2))
    //a2.bubble_sort { (a,b:INTEGER); a > b }
    a2.quick_sort { (a,b:Int); a > b }; // DCDC l'autre marche ???
    Test.check (a1 == a2)
    a2.swap 2 with 3
    Test.check_false (a1 == a2)
  )
