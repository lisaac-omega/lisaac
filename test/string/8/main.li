Header
  + name := Main
Public
  - main <-
  ( + i:Stridx
    + c:Int
    + str:Ustring
    + charo:Char
    str := Ustring_buffer.from_alias "Toto fait du vélo!"
    Test.check (str.upper.to_string) string "18+0"
    charo := Char.from_alias "o"
    
    i := str.last_index_of charo start (str.upper)
    {str.valid_index i}.while_do {
      c := c + 1
      i := i - 1
      i := str.last_index_of charo start i
      Test.check (c <= 100)
    }
    Test.check c integer 3
  )
  
  
