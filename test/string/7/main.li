Header
  + name := Main
Public
  - main <-
  ( + euro:Ustring
    + char:Char
    euro := Ustring_buffer.from_alias "x€x"
    char := euro.at (Stridx.lower )
    Test.check (char.to_uint8) integer ('x'.to_int8)
    Test.check (char.is_ascii)
    Test.check (char.ascii = 'x')
    Test.check (char.byte_count) integer 1
    char := euro.at (Stridx.lower + 1)
    Test.check (! char.is_ascii)
    Test.check (char.byte_count) integer 3
  )
