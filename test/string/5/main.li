Header
  + name := Main
Public
  - main <-
  ( + str:Ustring
    + char:Char
    + i:Stridx
    str := Ustring_buffer.from_alias "vélo"
    char := str.at (str.lower)
    Test.check (char.to_uint8) integer ('v'.to_uint8)
    char := str.at (str.upper)
    Test.check (char.to_uint8) integer ('o'.to_uint8)
    i := str.upper
    char := str.at i
    Test.check (char.to_uint32) integer ('o'.to_uint8)
    i := i - 1
    char := str.at i
    Test.check (char.to_uint32) integer ('l'.to_uint8)
    i := i - 1
    char := str.at i
    Test.check 43459 integer (0000_1010_1001_1100_0011b)
    ? {char.to_uint32 != 0}.txt {char.to_uint32.to_string}
    Test.check (char.to_uint32) integer 43459
    Test.check (`@char`:Uint64) integer (0000_1010_1001_1100_0011b)
    Test.check (char.to_uint32) integer (0000_1010_1001_1100_0011b)
    char.println
  )
  