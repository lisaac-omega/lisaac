Header
  + name := Main
/**/

Public 
  - main <-
  ( + map: Hmap Int Key Char
    + v: Int
    + b:Boolean
    map := new Hmap Int Key Char
    Test.check (! map.has '1')
    map.at '1' put 1
    Test.check (map.has '1')
    Test.check ((map.at '1') = 1)
    
    Test.check (! map.has '2')    
    map.at '2' add 2
    Test.check ((map.at '2') = 2)
    
    (b,v) := map.search '1'
    Test.check b
    Test.check (v = 1)
    (b,v) := map.search '3'
    Test.check (!b)
    Test.check (v = 0)
  )