Header
  + name := Main
/**/
Public 
  - main <-
  ( + map: Hmap Int Key Char
    + found:Boolean; + key: Char
    map := new Hmap Int Key Char
    
    (found,key) := map.search_value { v:Int
      v = 0
    }
    Test.check (! found)
    Test.check (key = '\0')
    map.at '1' put 1
    (found,key) := map.search_value { v:Int
      v = 1
    }
    Test.check (found)
    Test.check (key = '1')

    map.at '2' add 2

    map.at '3' add 3

    map.at '5' add 5

    (found,key) := map.search_value { v:Int
      v = 3
    }
    Test.check (key = '3')
    Test.check (found)
    (found,key) := map.search_value { v:Int
      v = 4 
    }
    Test.check (!found)
    Test.check (key = '\0')
    (found,key) := map.search_value { v:Int
      v = 5 
    }
    Test.check (found)
    Test.check (key = '5')
  )
  