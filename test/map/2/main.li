Header
  + name := MAIN;
  /**/
Public 
  - main <-
  ( + map: HMAP INTEGER KEY STRING_ALIAS
    map := new HMAP INTEGER KEY STRING_ALIAS
    TEST.check (! map.has "1")
    map.at "1" put 1
    TEST.check (map.has "1")
    TEST.check ((map.at "1") = 1)
    
    TEST.check (! map.has "2")    
    map.at "2" add 2
    TEST.check ((map.at "2") = 2)
  )
