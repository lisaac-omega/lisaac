Header
  + name := Main
/**/
Public 
  - main <-
  ( + map: Hmap Int Key String_alias
    map := new Hmap Int Key String_alias
    Test.check (! map.has "1")
    map.at "1" put 1
    Test.check (map.has "1")
    Test.check ((map.at "1") = 1)
    
    Test.check (! map.has "2")    
    map.at "2" add 2
    Test.check ((map.at "2") = 2)
  )
