Header
  + name := Main
/**/

Public 
  - main <-
  ( + map: Hmap Int Key Char
    map := new Hmap Int Key Char
    map.at '1' put 1
    map.at '2' add 2
    map.foreach_key { k:Char
      Out # "key:" # k # '\n' 
    }
    map.foreach_value { v:Int
      Out # "value:" # v # '\n' 
    }
    map.foreach { (k:Char, v:Int)
      Out # "key:" # k # " value:" # v # '\n' 
    }
  )
  