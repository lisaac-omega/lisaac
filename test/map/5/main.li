Header
  + name := Main
/**/

Public 
  - main <-
  ( + map: Hmap Int Key Char
    + found:Boolean; + value: Int
    map := new Hmap Int Key Char
    Test.check (map.count = 0)
    (found,value) := map.search_key { k:Char
      k = '0'
    }
    Test.check (! found)
    Test.check (value = 0)
    map.at '1' put 1
    (found,value) := map.search_key { k:Char
      k = '1'
    }
    Test.check (found)
    Test.check (value = 1)
    Test.check (map.count = 1)
    map.at '2' add 2
    Test.check (map.count = 2)
    map.at '3' add 3
    Test.check (map.count = 3)
    map.at '5' add 5
    Test.check (map.count = 4)    
    (found,value) := map.search_key { k:Char
      k = '3'
    }
    Test.check (value = 3)
    Test.check (found)
    (found,value) := map.search_key { k:Char
      k = '4' 
    }
    Test.check (!found)
    Test.check (value = 0)
    (found,value) := map.search_key { k:Char
      k = '5' 
    }
    Test.check (found)
    Test.check (value = 5)
  )
  