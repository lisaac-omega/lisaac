Header
  + name := MAIN;
  /**/

Public 
  - main <-
  ( + map: HMAP INTEGER KEY CHARACTER
    + found:BOOLEAN; + value: INTEGER
    map := new HMAP INTEGER KEY CHARACTER
    TEST.check (map.count = 0)
    (found,value) := map.search_key { k:CHARACTER
      k = '0'
    }
    TEST.check (! found)
    TEST.check (value = 0)
    map.at '1' put 1
    (found,value) := map.search_key { k:CHARACTER
      k = '1'
    }
    TEST.check (found)
    TEST.check (value = 1)
    TEST.check (map.count = 1)
    map.at '2' add 2
    TEST.check (map.count = 2)
    map.at '3' add 3
    TEST.check (map.count = 3)
    map.at '5' add 5
    TEST.check (map.count = 4)    
    (found,value) := map.search_key { k:CHARACTER
      k = '3'
    }
    TEST.check (value = 3)
    TEST.check (found)
    (found,value) := map.search_key { k:CHARACTER
      k = '4' 
    }
    TEST.check (!found)
    TEST.check (value = 0)
    (found,value) := map.search_key { k:CHARACTER
      k = '5' 
    }
    TEST.check (found)
    TEST.check (value = 5)
  )
  