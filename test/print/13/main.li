Header
  + name := Main
Insert
  - parent_print:Print := Print
  
  - parent_utils:Utils := Utils
  
  
Public
  
  + buffer:String
  
  - main <-
  ( + hexa:String_alias
    hexa := to_string
    //hexa.println
    hexa.foreach { c:Char
      Test.check ("0123456789ABCDEF" .has c)
    }
    '.'.println
  )
