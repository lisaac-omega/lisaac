Header
  + name := Res_e
Inherit
  + parent_expr:Flat Expr
  
Private
  - stack_res:Flat Array Res_e
  
Public
  
  - type:Type <- ( not_yet_implemented; Type)
  
  + item:String_alias; // '0'..'9'
  
  - init s:String_alias :Res_e <- ( item := s; self)
  
  - new i:Int :Res_e <-
  (
    (stack_res.is_empty).if {
      String.tmp { tmp:String_buffer
        tmp.copy "ˬ0"
        0.to 9 do { j:Int
          tmp.put ('0' +# j) to 2
          stack_res.add_last (clone.init (tmp.to_string_alias))
        }
      }
    }
    stack_res.at i
  )
  
  - drw <-
  ( 
    //ret := PRE.drw item
  )
  
  - run <- ( not_yet_implemented; )
