Header
  + name := Tfn2
Inherit
  + parent_tmove:Flat Tmove
  
Public
  
  + exec:{(Real32,Real32); Real32}
  
  - init (x,y:Texp) with b:{(Real32,Real32); Real32} :Tfn2 <-
  (
    (val_x,val_y) := (x,y)
    exec := b
    self
  )
    
  - eval:Real32 <- exec.value (val_x.eval,val_y.eval)
  
  - append_in b:String_buffer <-
  (
    b += "FN2("
    val_x.append_in b
    b | ','
    val_y.append_in b
    b | ')'
  )
