Header
  + name := Arg
Inherit
  + parent_decl:Flat Decl
  + parent_tok_itm:Flat Tok_itm
  
Private
  - stk:Flat Array (Exact Arg)
  
Public
  + lst:Flat Array Local
  
  - is_self:Boolean <- (! lst.is_empty) && {lst.first.name_id = "self"}
  
  - type:Type <-
  ( + t:Type
    (upper = 0).if { t := first.type; } else {
      + ts:Array Tone
      + to:Tone
      ts := push_tone
      0.to upper do { i:Int
        to ?= lst.at i.type; ? {to != NULL}
        ts.add_last to
      }
      t := Tvec.new ts
      pop_tone
    }
    t    
  )
  
  - new:Self <-
  ( + r:Self; (stk.is_empty).if { r := clone; } else { r := stk.pop; }; r)
  
  - free <- ( lst.foreach { l:Local; l.free; }; lst.clear; stk.add_last self; )
  
  - new_parse t:Int <-
  (
    rd_arg (t | 100b)
  )
  
  - rd_arg op:Int <-
  //++ ARG          -> identifier ':' TYPE_RESULT
  //++               | '(' ARG_VEC ')'
  ( + mute:Boolean
    + l:Local
    
    mute := (op&10b) != 0
    (read_c '(').if {
      col (Look.symbol) sub 1
      rd_arg_vec op
      ((lst.is_empty) && {!mute}).if { err syntax msg "Incorrect argument definition."; }
      skip_spln
      (read_c ')').if {
        col (Look.symbol) sub 1
      } else { (!mute).if { err warning msg "Added ')'. (2)"; }; }
    } else {
      ((l := Local.parse_sp op) != NULL).if {        
        lst.add_last l;
        (l.last_argv != NULL).if { lst.add_last (l.last_argv) }
      }
    }
    (((lst.is_empty) || {lst.last.ttok = NULL}) && {mute}).if {
      sty.set_upper (Old sty.upper)
      pos_i := Old pos_i
    }
  )
  
  - rd_arg_vec op:Int <-
  //++ ARG0         -> identifier [ ':' TYPE ] { , identifier [ ':' TYPE ] }
  ( + lop,p:Int
    + i:Int
    + mute:Boolean
    + l,l2:Local
    + t:Ttok
    + c:Int
    mute := (op&10b) != 0
    lop := op
    {
      skip_spln      
      (read_idf).if {
        (last_str = "self").if {
          ((lop & 01b) = 00b).if { err semantic msg "`self' incorrect." }
          c := Look.keyword
        } else {
          c := Look.local
        }
        l := Local.new.set_name last_str.set_style f_ro;
        col c sub (last_str.count)
        fnt (Font.italic) sub (last_str.count)
        fnt (Font.roman) sub 0
        l.finalize 0 db (pos_i-last_str.count) de pos_i
        lst.add_last l
        lop := lop & 110b
        ((read_c ':') && {(pos_i > upper) || {at pos_i != '='}}).if {
          col (Look.symbol) sub 1
          t := Ttok.parse_sp (Ttok.tres)
          (read_c '^').if {
            p := pos_i.pt - 1
            col (Look.symbol) sub 1
            (read_idf).if {
              jmp 1 sub (pos_i - last_str.count - p + 1)
              col c sub (last_str.count)
              exp True sub (last_str.count)
              exp False sub 0
              l2 := Local.new.set_name last_str.set_style f_ro;              
            }
          }
          l.set_dd (pos_i-(pt_b.pt+l.db))
          (t != NULL).if {
            i := lst.upper
            {(i >= 0) && {lst.at i.ttok = NULL}}.while_do {
              lst.at i.set_ttok t
              i := i - 1
            }
            (l2 != NULL).if { lst.add_last l2 }
          }
        }
      } else {
        (!mute).if { err warning msg "Local needed."; }
      }
      (read_c ',').if {
        col (Look.symbol) sub 1
      }
    }.while_loop
    ((!mute) && {l != NULL} && {l.ttok = NULL}).if {
      err warning msg "Type needed."
    }
  )
  
  // DRAW
  
  - begin_draw <- ( ia := 0; )
  - ia:Int
  
  - sub_draw <-
  ( 
    ((!lst.is_empty) && {ia.in_range 0 to (lst.upper)} && {lst.at ia.now pos_i}).if {            
      lst.at ia.draw
      ia := ia + 1
    }
  )
  
