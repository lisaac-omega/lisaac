Header
  + name := Li_copy
/* Copy a @Flat structure. A source at 0 is the @NULL block. */
Inherit

  - parent_li_node:Li_node := Li_node

Public

  + target:Li_node
  + source:Li_node
  + size:Int

  - create t:Li_node from s:Li_node size n:Int :Self <-
  ( + result:Self
    result := clone
    result.make t from s size n
    result
  )

  - make t:Li_node from s:Li_node size n:Int <- ( target := t; source := s; size := n; )

  - eval fp:Int :Int <-
  ( + d,s,n:Int
    d := target.eval fp
    s := source.eval fp
    n := size
    (s = 0).if {
      `memset((void *)(@d),0,@n)`;
    } else {
      `memmove((void *)(@d),(void *)(@s),@n)`;
    }
    0
  )
