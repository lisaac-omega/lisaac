Header
  + name := Li_load64
/* Read a 64 bits word of memory. */
Inherit

  - parent_li_node:Li_node := Li_node

Public

  + receiver:Li_node
  + off:Int

  - create r:Li_node off o:Int :Self <-
  ( + result:Self
    result := clone
    result.make r off o
    result
  )

  - make r:Li_node off o:Int <- ( receiver := r; off := o; )

  - eval fp:Int :Int <-
  ( + a:Int
    a := receiver.eval fp + off
    `*(int64_t *)(@a)`:(Int)
  )
