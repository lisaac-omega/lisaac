Header
  + name := Li_local
/* Read the word of a local. */
Inherit

  - parent_li_node:Li_node := Li_node

Public

  + off:Int

  - create o:Int :Self <-
  ( + result:Self
    result := clone
    result.make o
    result
  )

  - make o:Int <- ( off := o; )

  - eval fp:Int :Int <-
  ( + a:Int
    a := fp + off
    `*(int64_t *)(@a)`:(Int)
  )
