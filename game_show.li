Header
  + name := Game_show
  
/*
  The games of the Lisaac Ω distribution, one after the other:
  Snake, Tetris, Solitaire, Arrow out, Connect four, Break,
  Minesweeper, Gems and Shooter.
  Each game is a complete program of a few hundred lines, written to be
  read: open it in elit to see how it works.

  To compile, in a terminal:
  $ cd lisaac
  $ lisaac game_show -q -boost
  $ ./game_show

  Created and maintained by Benoît Sonntag and Dominique Colnet.
  */
Insert
  
  - code_show:Code_show := Code_show
  
Public
  
  - main <-
  (
    show (
      "example/snake/snake.li", "background",
      "example/tetris/tetris.li", "background",
      "example/solitaire/solitaire.li", "background",
      "example/arrow_out/arrow_out.li", "background",
      "example/connect_four/connect_four.li", "background",
      "example/break/break.li", "background",
      "example/minesweeper/minesweeper.li", "background",
      "example/gems/gems.li", "background",
      "example/shooter/shooter.li", "background"
    )
  )
