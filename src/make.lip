Inherit

  + parent:String

Private
  
  + any:String
  
  + is_valid:Boolean

  //
  // Execute function.
  //

  - front_end <-
  (
    (input_file = "").if {
      input_file := "lisaac"
    }
    (input_file = "lisaac").if {
      any := "compiler"
    } else {
      any := "lidoc"
    }
    path "./*"
    (is_valid).if {
      boost
    }
    general_front_end
  )

  - back_end <-
  (
    general_back_end
    (is_valid).if {
      (any = "compiler").if {
        execute "cp lisaac.c ../bin/."
        execute "cp lisaac ../bin/."
      } else {
        execute "cp lidoc.c ../bin/."
        execute "cp lidoc ../bin/."
      }
    }
  )

Public
  
  - valid <-
  // Compile the Lisaac compiler with `-boost' option and
  // update your `/bin' compiler version.
  (
    is_valid := True
  )

