Header
  + name := Lip_value
Inherit

  + parent_lip_code:Flat Lip_code

Public

  + value:Lip_constant

  //
  // Creation.
  //

  - create p:Position with v:Lip_constant :Self <-
  ( + result:Self
    result := clone
    result.make p with v
    result
  )

  - make p:Position with v:Lip_constant <-
  (
    position := p
    value := v
  )

  //
  // Run.
  //

  - run_expr:Lip_constant <-
  (
    value.copy
  )
