Header
  + name := Lip_code
Inherit

  + parent_itm_object:Flat Itm_object

Public

  - list_parent:Array String_alias := Array String_alias .create_with_capacity 1

  - list_method:Array Lip_slot_code := Array Lip_slot_code .create_with_capacity 32

  - list_data:Hmap Lip_slot_data Key String_alias := new Hmap Lip_slot_data Key String_alias

  - stack:Array Lip_slot_data := Array Lip_slot_data .create_with_capacity 8  

  - get_data n:String_alias :Lip_slot_data <-
  ( + found:Boolean 
    + result:Lip_slot_data    
    (found, result) := list_data.search n       
    result
  )

  - get_method n:String_alias :Lip_slot_code <-
  ( + j:Int
    + result:Lip_slot_code

    j := list_method.lower
    {(j <= list_method.upper) && {list_method.at j.name != n}}.while_do {
      j := j + 1
    }
    (j <= list_method.upper).if {
      result := list_method.at j
    }
    result
  )

  - print_usage <-
  ( + slot:Lip_slot_code
    + is_ok:Boolean

    (list_method.lower).to (list_method.upper) do { j:Int
      slot := list_method.at j
      (slot.section = "Public").if {
        is_ok := True
        slot.print
      }
    }
    (is_ok).if_false {
      "\t Sorry, no option (see `make.lip').\n".print;
    }
  )

  - get_integer n:String_alias :Int <-
  ( + d:Lip_slot_data
    + int:Lip_integer
    + result:Int

    d := get_data n
    (d = NULL).if {
      "Warning: Slot `".print;
      n.print
      "' not found.\n".print
    } else {
      int ?= d.value
      (int = NULL).if {
        semantic_error (d.position,"Int type is needed.")
      }
      result := int.value
    }
    result
  )

  - get_boolean n:String_alias :Boolean <-
  ( + d:Lip_slot_data
    + bool:Lip_boolean
    + result:Boolean

    d := get_data n
    (d = NULL).if {
      "Warning: Slot `".print;
      n.print
      "' not found.\n".print
    } else {
      bool ?= d.value
      (bool = NULL).if {
        semantic_error (d.position,"Boolean type is needed.")
      }
      result := bool.value
    }
    result
  )

  - get_string n:String_alias :String_alias <-
  ( + d:Lip_slot_data
    + str:Lip_string
    + result:String_alias

    d := get_data n
    (d = NULL).if {
      "Warning: Lip slot `".print;
      n.print
      "' not found.\n".print
    } else {
      str ?= d.value
      (str = NULL).if {
        semantic_error (d.position,"STRING type is needed.")
      }
      result := str.value
    }
    result
  )

  - put_string v:String_alias to n:String_alias <-
  ( + d:Lip_slot_data
    + str:Lip_string

    d := get_data n
    (d = NULL).if {
      "Warning: Slot `".print;
      n.print
      "' not found.\n".print
    } else {
      str ?= d.value
      (str = NULL).if {
        semantic_error (d.position,"STRING type is needed.")
      }
      str.set_value v
    }
  )

  - put_boolean v:Boolean to n:String_alias <-
  ( + d:Lip_slot_data

    d := get_data n
    (d = NULL).if {
      "Warning: Slot `".print;
      n.print
      "' not found.\n".print
    } else {
      (d.set_value (Lip_boolean.get v)).if_false {
        semantic_error (d.position,"Boolean type is needed.")
      }
    }
  )

  //
  // Run.
  //

  - run <-
  (
    warning_error (position,"Unreachable code.(0)")
  )

  - run_expr:Lip_constant <-
  (
    semantic_error (position,"No expression result.")
    NULL
  )

  - call_front_end <-
  ( + s:Lip_slot_code
    // Executing @front_end:
    s := Lip_code.get_method "front_end"
    (s = NULL).if {
      "Slot `front_end' not found in *.lip file.\n".print;
      exit exit_failure_code
    }
    s.run_with NULL
  )

  - init_path_file order:Boolean <-
  ( + k,i:Int
    + p1,p2:String_alias

    (order).if {
      path_file.bubble_sort_with { (a,b:String_alias)
        + ii,ai,bi,up:Int
        + ac,bc:Char
        + result:Boolean
        ii := a.lower
        up := a.upper.min (b.upper)
        {(ii <= up) && {a.at ii = b.at ii}}.while_do { ii := ii + 1; }
        ai := bi := ii
        {(ai <= a.upper) && {(ac := a.at ai) != '/'}}.while_do { ai := ai + 1; }
        {(bi <= b.upper) && {(bc := b.at bi) != '/'}}.while_do { bi := bi + 1; }
        ((ac = '/') ^ (bc = '/')).if {          
          result := ac = '/'
        } else {
          result := a.at ii > b.at ii
        }
        result
      }
    } else {
      path_file.bubble_sort_with { (a,b:String_alias)
        b !< a
      }
    }
    k := path_file.upper
    path_begin := path_file.first.upper
    {k <= path_file.lower}.until_do {
      p1 := path_file.at k
      p2 := path_file.at (k-1)
      (p1 = p2).if {
        path_file.remove k
      } else {
        path_begin := path_begin.min (p1.upper)
        i := p1.lower
        {(i < path_begin) && {p1.at i = p2.at i}}.while_do {
          i := i + 1
        }
        path_begin := i
      }
      k := k - 1
    }
    path_begin := (path_begin - 1).max 0
  )
