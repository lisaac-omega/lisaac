Header
  + name := Lip_elit
/* Used by Elit.*/
Insert
  - parent_lisaac_common:Lisaac_common := Lisaac_common
  
Public
  
  - load in:String_alias do do:{(String_alias,String_alias);} <-
  (
    Lip_call.set_add_path do img True
    load_lip "make.lip"
    Lip_call.load_dir in img NULL is_rec False
    Lip_code.call_front_end
  )
