Header
  + name := Lip_slot_code
Inherit

  - parent_lip_code:Flat Lip_code

Public

  + section:String_alias

  + name:String_alias

  + argument:Lip_slot_data

  + code:Lip_code

  + comment:String_alias

  + comment_chapter:String_alias

  - set_comment c:String_alias <-
  (
    comment := c
  )

  - set_comment_chapter cmt:String_alias <-
  (
    comment_chapter := cmt
  )

  //
  // Creation.
  //

  - create p:Position section sec:String_alias
  name n:String_alias
  argument arg:Lip_slot_data
  code c:Lip_code :Lip_slot_code <-
  ( + result:Lip_slot_code

    result := get_method n
    (result != NULL).if {
      ((arg = NULL) ^ (result.argument = NULL)).if {
        semantic_error (result.position,"Incorrect redefinition.")
      }
    } else {
      result := clone
      result.make p section sec name n argument arg code c
    }
    result
  )

  - make p:Position section sec:String_alias
  name n:String_alias
  argument arg:Lip_slot_data
  code c:Lip_code <-
  (
    position := p
    section := sec
    name := n
    argument := arg
    code := c
    list_method.add_last self
  )

  //
  // Operation.
  //

  - run_with val:Lip_constant :Boolean <-
  ( + result:Boolean

    result := ! ((val = NULL) ^ (argument = NULL))
    (result).if {
      (argument != NULL).if {
        ? { val != NULL }
        result := argument.set_value val
        stack.add_last argument
      } else {
        stack.add_last NULL
      }
      (result).if {
        code.run
      }
      stack.remove_last
    }
    result
  )

  //
  // Print.
  //
  
  - last_chapter:String_alias
  
  - print <-
  (
    ((comment_chapter != NULL) && {last_chapter != comment_chapter}).if {            
      '\n'.print
      comment_chapter.print
      '\n'.print
    }
    last_chapter := comment_chapter
    
    "  -".print
    name.print
    (argument != NULL).if {
      " <".print
      argument.print
      ">".print
    }
    ":\n".print
    (comment != NULL).if {
      '\t'.print
      (comment.lower).to (comment.upper) do { i:Int
        comment.at i.print
        ((comment.at i = '\n') && {i < comment.upper}).if {
          '\t'.print
        }
      }
    } else {
      "\t Sorry, no comment (see `make.lip').\n".print;
    }
  )

