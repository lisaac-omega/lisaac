Header
  + name := Lip_string
Inherit

  + parent_lip_constant:Flat Lip_constant

Private

  - storage:Array Lip_string := Array Lip_string .create_with_capacity 10

Public

  + value:String_alias

  - set_value v:String_alias <-
  (
    value := v
  )

  //
  // Creation.
  //

  - get str:String_alias :Lip_string <-
  ( + result:Lip_string
    (storage.is_empty).if {
      result := clone
    } else {
      result := storage.last
      storage.remove_last
    }
    result.set_value str
    result
  )

  - free <-
  (
    storage.add_last self
  )

  //
  // Operation.
  //

  - name:String_alias <- lip_string

  - copy:Lip_constant <-
  (
    get value
  )

  - print <-
  (
    string_tmp.clear
    append_in string_tmp
    string_tmp.print
  )

  - append_in b:String_buffer <-
  ( + i:Int
    + car:Char

    i := value.lower
    {i <= value.upper}.while_do {
      car := value.at i
      (car = '\\').if {
        i := i + 1
        (i <= value.upper).if {
          car := value.at i
          (car)
          .when 'a'  then { b.add_last '\a'; }
          .when 'b'  then { b.add_last '\b'; }
          .when 'f'  then { b.add_last '\f'; }
          .when 'n'  then { b.add_last '\n'; }
          .when 'r'  then { b.add_last '\r'; }
          .when 't'  then { b.add_last '\t'; }
          .when 'v'  then { b.add_last '\v'; }
          .when '\\' then { b.add_last '\\'; }
          .when '?'  then { b.add_last '\?'; }
          .when '\'' then { b.add_last '\''; }
          .when '\"' then { b.add_last '\"'; }
        } else {
          b.add_last car
        }
      } else {
        b.add_last car
      }
      i := i + 1
    }
  )

Lip_constant

  - my_copy other:Self :Lip_constant <-
  (
    value := other.value
    self
  )

  - self:Self '=#'  other:Self :Lip_constant <-
  (
    other.free
    free
    Lip_boolean.get (value = other.value)
  )

  - self:Self '!=#' other:Self :Lip_constant <-
  (
    other.free
    free
    Lip_boolean.get (value != other.value)
  )

  - self:Self '+#'  other:Self :Lip_constant <-
  (
    string_tmp.copy value
    string_tmp.append (other.value)
    value := string_tmp.to_string_alias
    other.free
    self
  )
