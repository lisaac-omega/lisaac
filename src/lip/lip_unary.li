Header
  + name := Lip_unary
Inherit

  + parent_lip_code:Flat Lip_code

Public

  + value:Lip_code

  + operator:Char

  //
  // Creation.
  //

  - create p:Position operator op:Char with v:Lip_code :Self <-
  ( + result:Self
    result := clone
    result.make p operator op with v
    result
  )

  - make p:Position operator op:Char with v:Lip_code <-
  (
    position := p
    operator := op
    value := v
  )

  //
  // Run.
  //

  - run_expr:Lip_constant <-
  ( + result:Lip_constant

    result := value.run_expr
    (operator)
    .when '-' then { result := - result; }
    .when '!' then { result := ! result; }
    (result = NULL).if {
      semantic_error (position,"Incorrect type.")
    }
    result
  )
