Header
  + name := Lisaac
/* The lisaac compiler. */
Insert

  - parent_lisaac_common:Lisaac_common := Lisaac_common

Public

  - show_help <-
  (
    Common.command_line_header "Compiler".print
    begin_usage.print
    Lip_code.print_usage
  )

  - show_version <-
  (
    Common.command_line_header "Compiler".print
    Common.print_info
  )

Private

  - declare_context_from start:Int <-
  // Debug mode: the function of a base slot (from @start in @output) uses the context of
  // `main' (its traces), declared by its first `lisaac_push_first', which the optimizer may
  // have removed: then declared here.
  ( + name:String_alias
    name := context_main.intern_name
    string_tmp.copy "_____CONTEXT "
    string_tmp.append name
    ((output.substring_index (name, start) != -1) && {output.substring_index (string_tmp, start) = -1}).if {
      string_tmp.insert_string "  " to 0
      string_tmp.append ";\n"
      output.insert_string string_tmp to start
    }
  )

  - output_name     :String_alias
  - output_extension:String_alias

  - input_name:String_alias

  //
  // Command.
  //

  - begin_usage: String_alias :=
  "Usage:                                                          \n\
  \------                                                          \n\
  \  lisaac [<lip_file.lip>] [<input_file[.li]>] {<Options>}       \n\
  \                                                                \n\
  \  Note: without <lip_file> the nearest `make.lip' file is       \n\
  \        interpreted.                                            \n\
  \                                                                \n\
  \Options:                                                        \n\
  \--------                                                        \n"

  - display_usage <-
  (
    show_help
    exit exit_failure_code
  )

  //
  // Options.
  //

  - read_options <-
  ( + cmd:String_alias
    + j,i,k:Int
    + f:Pointer
    + lip_ok:Boolean
    + s:Lip_slot_code
    + t:String_alias
    + arg:Lip_constant
    + is_path_list:Boolean
    + hook_after_load_lip :{}
        
    hook_after_load_lip := {}

    // Default value.
    is_ansi := True
    // Read argument.
    j := 1
    {j > Command_args.upper}.until_do {
      cmd := Command_args.at j
      (cmd.at 0 = '-').if {        
        //
        // Lecture des options :
        //
        ((cmd.count >= 3) && {cmd.at 1 = '-'}).if {
          (cmd.at 2)
          .when 'v' then {
            verbose_level := 1
          }
          .when 'p' then {
            is_path_list := True
          }
          .when 'r' then {
            is_readable := True
          }
          .when 'g' then {
            is_readable := is_graph := True
          }
        } else {
          (lip_ok).if_false {            
            load_lip "make.lip"
            hook_after_load_lip.value
            lip_ok := True
          }
          string_tmp.copy cmd
          string_tmp.remove_first
          string_tmp.replace_all '-' with '_'
          s := Lip_code.get_method (string_tmp.to_string_alias)
          ((s = NULL) || {s.section != "Public"}).if {
            "ERROR: Option `".print;
            cmd.print
            "' not found.\n".print
            display_usage
          }
          (s.argument != NULL).if {
            j := j + 1
            (j > Command_args.upper).if {
              "ERROR: For option `".print;
              cmd.print
              "', argument needed.\n".print
              display_usage
            }
            cmd := Command_args.at j
            t := s.argument.value.name
            arg := NULL
            (t = lip_boolean).if {
              ((cmd = str_true) || {cmd = "true"}).if {
                arg := Lip_boolean.get True
              }.elseif {(cmd = str_false) || {cmd = "false"}} then {
                arg := Lip_boolean.get False
              }
            }.elseif {t = lip_int} then {
              (cmd.is_integer).if {
                arg := Lip_integer.get (cmd.to_int)
              }
            } else {
              arg := Lip_string.get (cmd.to_string_alias)
            }
            (arg = NULL).if {
              "ERROR: Incorrect type for `".print;
              cmd.print
              "' argument.\n".print
              display_usage
            }
          } else {
            arg := NULL
          }
          (s.run_with arg).if_false {
            "ERROR: Invalid argument.\n".print
            display_usage
          }
        }
      } else {
        //
        // Input name & self Directory.
        //
        (cmd.has_suffix ".lip").if {          
          // .lip
          (lip_ok).if {
            "ERROR: Put options after `".print;
            cmd.print
            "'.".print
            display_usage
          }
          load_lip cmd
          hook_after_load_lip.value
          lip_ok := True
        } else {
          // .li
          (input_name != NULL).if {
            display_usage
          }
          // Remove extension and replace '\'
          string_tmp.copy (Command_args.at j)
          string_tmp.replace_all '\\' with '/'
          k := last_index_str (string_tmp,'/')
          i := last_index_str (string_tmp,'.')
          ((i > string_tmp.lower) && {i > k}).if {
            string_tmp.remove_tail (string_tmp.upper-i+1)
          }
          input_name := string_tmp.to_string_alias
          hook_after_load_lip := {
            Lip_code.put_string input_name to "input_file"
            Lip_code.put_string input_name to "output_file"
          }
          // get dirname
          i := last_index_str (string_tmp,'/')
          (i < string_tmp.lower).if {
            string_tmp.copy "./"
          } else {
            string_tmp.remove_tail (string_tmp.upper-i)
          }
          input_path := string_tmp.to_string_alias
        }
      }
      j := j+1
    }
    (lip_ok).if_false {
      load_lip "make.lip" in input_path
      hook_after_load_lip.value
    }

    Lip_code.call_front_end

    (is_path_list).if {
      string_tmp.clear
      (path_file.lower).to (path_file.upper) do { n:Int
        string_tmp.append (path_file.at n)
        string_tmp.add_last '\n'
      }
      f := File_utils.open_write "current_path.txt"
      (f = NULL).if {
        Stderr.put_string "Error: File `current_path.txt' is not created !\n";
        exit exit_failure_code
      }
      File_utils.write f with string_tmp size (string_tmp.count)
      File_utils.close f
      exit 0
    }

    // Loading variable.
    input_name         := Lip_code.get_string  "input_file"
    output_name        := Lip_code.get_string  "output_file"
    output_extension   := Lip_code.get_string  "output_extension"
    debug_level_option := Lip_code.get_integer "debug_level"
    debug_with_code    := Lip_code.get_boolean "debug_with_code"
    is_all_warning     := Lip_code.get_boolean "is_all_warning"
    is_optimization    := Lip_code.get_boolean "is_optimization"
    inline_level       := Lip_code.get_integer "inline_level"
    is_statistic       := Lip_code.get_boolean "is_statistic"
    is_quiet           := Lip_code.get_boolean "is_quiet"
    is_library         := Lip_code.get_boolean "is_library"
    is_cop             := Lip_code.get_boolean "is_cop"
    is_cop_report      := Lip_code.get_boolean "is_cop_report"
    is_speed_push      := Lip_code.get_boolean "is_speed_push"
    (Lip_code.get_boolean "multicore").if { core_count := Lip_code.get_integer "core_count" }
    //
    ((input_name = NULL) || {input_name.is_empty}).if {
      "ERROR: `input_file' is empty.\n".print;
      display_usage
    }
    // Separate path (string_tmp) and file (string_tmp2)
    string_tmp.copy input_name
    string_tmp2.copy string_tmp
    i := last_index_str (string_tmp,'/')
    (i < string_tmp.lower).if {
      string_tmp.copy "./"
    } else {
      string_tmp.remove_tail (string_tmp.upper-i)
      string_tmp2.remove_head (i+1)
    }
    Lip_call.load_dir (string_tmp.to_string_alias) img NULL is_rec False
    //
    string_tmp.copy (path_file.last)
    i := last_index_str (string_tmp,'/')
    string_tmp.remove_tail (string_tmp.upper-i)
    input_path := string_tmp.to_string_alias
    input_name := string_tmp2.to_string_alias
    //
    ((output_name = NULL) || {output_name.is_empty}).if {
      (input_path = NULL).if {
        string_tmp.clear
      } else {
        string_tmp.copy input_path
      }
      string_tmp.append input_name
      output_name := string_tmp.to_string_alias
      Lip_code.put_string output_name to "output_file"
    }
    ((output_extension = NULL) || {output_extension.is_empty}).if {
      output_extension := ".c"
      Lip_code.put_string output_extension to "output_extension"
    }
    Lip_code.init_path_file False
  )

  - put_io_default buf:String_buffer <-
  // `print_char' and `die_with_code' of @System_io (their C name), called by the code below
  // (`Call on NULL', stack trace), are generated only if the program calls them: else, their
  // default definition (Windows, Unix, MacOS), as in @System_io.
  ( + has_print,has_die:Boolean
    + p:Profil
    (Profil_list.profil_list.lower).to (Profil_list.profil_list.upper) do { j:Int
      p := Profil_list.profil_list.at j
      // Generated as a C function (see @Profil.genere).
      ((p.link_count != 0) || {p.result_list.count != 0}).if {
        (p.name = "print_char").if { has_print := True; }
        (p.name = "die_with_code").if { has_die := True; }
      }
    }
    ((! has_print) || {! has_die}).if {
      buf.append "#if !defined(ARDUINO) && !defined(__ANDROID__)\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n"
      (has_print).if_false {
        buf.append "void print_char(char c) { fputc((int)c,stdout); }\n"
      }
      (has_die).if_false {
        buf.append "void die_with_code(int64_t code) { exit(code); }\n"
      }
      buf.append "#endif\n\n"
    }
  )

  - put_trace_code buf:String_buffer <-
  ( + proto:Prototype

    ((debug_level_option != 0) || {Call_null.is_necessary}).if {
      title "DEBUG MANAGER" in buf
      put_io_default buf
           
      buf.append
      "int print_string(char *str) \n\
      \{ \n\
      \  while (*str!=0) {\n\
      \    print_char(*str); \n\
      \    str++; \n\
      \  };\n\
      \  return(0);\n\
      \}\n\
      \\n"
    }

    (debug_level_option != 0).if {            
      buf.append "char *trace["
      Prototype.prototype_list.count.append_in buf
      buf.append "]={\n"
      (Prototype.prototype_list.lower).to (Prototype.prototype_list.upper-1) do { j:Int
        proto := Prototype.prototype_list.at j
        buf.append "  \""
        buf.append (proto.name)
        buf.append " ("
        proto.append_filename buf
        buf.append ")\",\n"
      }
      proto := Prototype.prototype_list.last
      buf.append "  \""
      buf.append (proto.name)
      buf.append " ("
      proto.append_filename buf
      buf.append ")\"\n};\n\n"

      //
      // Source Code.
      //

      (debug_with_code).if {
        + src:Array Position

        title "SOURCE LINE REFERENCE" in buf

        buf.append
        "struct __source {\n\
          \  uint32_t pos;\n\
          \  char *line;\n\
        \} __src["
          src := Push.source_line
          src.count.append_in buf
        buf.append "]={\n"
          (src.lower).to (src.upper) do { j:Int
            buf.append "  {"
              src.at j.code.append_in buf
              buf.append ",\""
              src.at j.extract_line_in buf
            buf.append "\"},\n"
          }
          buf.remove (buf.upper - 1)
        buf.append "};\n\n"
      }

      //
      // Signal manager.
      //
            
      if (is_ansi) then {
        buf.append
        "/* Unix Signal manager: */\n\
        \void interrupt_signal(int sig)  \n\
        \{                               \n\
          \  lisaac_stack_print(0);     \n\
          \  print_string(\"User interrupt.\\n\"); \n\
          \  die_with_code(1);                     \n\
        \}                                       \n\n"
      }

      //
      // Stack manager.
      //      
      
      (is_speed_push).if {
        buf.append
        "void _li_swap(long a,long b)                                      \n\
        \{ long i,tmp;                                                     \n\ 
        \  for (i=3;i<__li_mountain[1];i+=3) {                             \n\ 
        \    if (__li_mountain[i+2] == a*3) __li_mountain[i+2] = b*3; else \n\
        \    if (__li_mountain[i+2] == b*3) __li_mountain[i+2] = a*3;      \n\ 
        \  }                                                               \n\
        \  for (i=0;i<3;i++) {                                             \n\ 
        \    tmp = __li_mountain[a * 3 + i];                               \n\
        \    __li_mountain[a * 3 + i] = __li_mountain[b * 3 + i];          \n\
        \    __li_mountain[b * 3 + i] = tmp;                               \n\ 
        \  };                                                              \n\ 
        \};                                                                \n\
        \ \n\
        \void _li_quicksort(long low,long up)                              \n\
        \{ long i,j,pivot;                                                 \n\ 
        \  if (low < up) {                                                 \n\ 
        \    pivot = __li_mountain[low*3];                                 \n\
        \    i = low;                                                      \n\ 
        \    j = up + 1;                                                   \n\
        \    do {                                                          \n\ 
        \      do ++i; while ((__li_mountain[i*3] <= pivot) && (i <= up)); \n\
        \      do --j; while (__li_mountain[j*3] > pivot);                 \n\
        \      if (i < j) _li_swap(i,j);                                   \n\ 
        \    } while (i < j);                                              \n\ 
        \    _li_swap(low,j);                                              \n\
        \    _li_quicksort(low,j-1);                                       \n\
        \    _li_quicksort(j+1,up);                                        \n\ 
        \  };                                                              \n\ 
        \}                                                                 \n\
        \ \n\
        \void __li_fix_order_mountain()                           \n\
        \{ int j;                                                 \n\ 
        \  long prev,cur;                                         \n\
        \  prev = -1;                                             \n\
        \  for (j=0;j<__li_mountain[1];j+=3) {                    \n\ 
        \    cur = __li_mountain[j];                              \n\
        \    if (cur == prev) {                                   \n\ 
        \      __li_mountain[j] = __li_mountain[j-3]+1;           \n\ 
        \    } else {                                             \n\ 
        \      __li_mountain[j] = __li_mountain[j] << 16;         \n\ 
        \    }                                                    \n\
        \    prev = cur;                                          \n\ 
        \  }                                                      \n\ 
        \}                                                        \n\
        \ \n\
        \void __li_display_mountain()                 \n\
        \{ int i;                                     \n\ 
        \  for (i=3;i<__li_mountain[1];i+=3) {        \n\ 
        \    print_integer(i);                        \n\
        \    print_string(\": \");                    \n\
        \    print_integer_h(__li_mountain[i]);       \n\
        \    print_string(\", \");                    \n\
        \    print_integer_h(__li_mountain[i+1]);     \n\
        \    print_string(\", \");                    \n\
        \    print_integer(__li_mountain[i+2]);       \n\
        \    print_string(\"\\n\");                   \n\
        \  };                                         \n\
        \}                                            \n\ 
        \ \n\
        \void _li_display_stack(long top)        \n\
        \{ long j;                               \n\ 
        \  long *stack = NULL;                   \n\
        \  print_string(\"Stack:\");             \n\
        \  print_integer_h(top);                 \n\
        \  print_string(\"\\n\");                \n\
        \  for (j=0;j<20;j++) {                  \n\ 
        \    print_integer_h(stack[(top>>3)+j]); \n\
        \    print_string(\"\\n\");              \n\ 
        \  }                                     \n\
        \  print_string(\"- End -\\n\");         \n\ 
        \}                                       \n\
        \ \n\
        \/*long __li_get_top()                          \n\
        \{ long result;                               \n\
        \  asm(\"movq %%rsp,%0\": \"=r\" (result) : );\n\ 
        \  return result;                             \n\ 
        \}*/                                            \n\ 
        \ \n\
        \long tmp_rsp; \n\
        \long __li_get_back_index(long idx,long rsp_current)                                    \n\
        \{ long result,rip,i,/*beg,*/end;                                                       \n\ 
        \  long *stack = NULL;                                                                  \n\
        \  result = __li_mountain[idx+2];                                                       \n\ 
        \  if (result == -1) {                                                                  \n\         
        \    tmp_rsp = rsp_current;                                                             \n\
        \    result = 0;                                                                        \n\
        \    do {                                                                               \n\ 
        \      rip = stack[tmp_rsp >> 3];                                                       \n\
        \      if ((rip>(__li_mountain[3]>>16)) && (rip<(__li_mountain[0]>>16))) {              \n\ 
        \        i = 3;                                                                         \n\ 
        \        do {                                                                           \n\ 
        \          /*beg = __li_mountain[i]>>16;*/                                              \n\
        \          end = __li_mountain[i+1];                                                    \n\        
        \          do {                                                                         \n\ 
        \            i += 3;                                                                    \n\ 
        \          } while ((rip<end) && (rip>(__li_mountain[i]>>16)));                         \n\
        \          if (rip < end) {                                                             \n\ 
        \            result = i-3;                                                              \n\ 
        \          }                                                                            \n\ 
        \        } while ((result == 0) && (i < __li_mountain[1]));                             \n\ 
        \      }                                                                                \n\
        \      tmp_rsp += 8;                                                                    \n\           
        \    } while (result == 0);                                                             \n\           
        \  }                                                                                    \n\  
        \  return result;                                                                       \n\ 
        \}                                                                                      \n\ 
        \ \n\
        \void __li_sub_stack_print(long idx_mount,long up)            \n\
        \{ long idx_new,up_new,code,j;                                \n\ 
        \  if (idx_mount > 0) {                                       \n\ 
        \    idx_new = __li_get_back_index(idx_mount,up);             \n\  
        \    up_new = tmp_rsp;                                        \n\
        \    __li_sub_stack_print(idx_new,up_new);                    \n\
        \    code = __li_mountain[idx_mount+1];                       \n"
        (debug_with_code).if {
          buf.append
          "    print_string(\"Line #\");                             \n\
          \    print_integer(__src[code].pos >> 17);                 \n\
          \    print_string(\" Column #\");                          \n\
          \    print_integer((__src[code].pos >> 9) & 0xFF);         \n\
          \    print_string(\" in \");                               \n\
          \    print_string(trace[__src[code].pos & 0x1FF]);         \n\
          \    print_string(\".\\n\");                               \n\
          \    print_string(__src[code].line);                       \n\
          \    print_char('\\n');                                    \n\
          \    for (j=0;j < ((__src[code].pos >> 9) & 0xFF);j++) {   \n\
          \      if (__src[code].line[j]=='\\t') print_char('\\t');  \n\
          \      else print_char(' ');                               \n\
          \    };                                                    \n\
          \    print_char('^');                                      \n\
          \    print_char('\\n');                                    \n"
        } else {                                                        
          buf.append
          "    print_string(\"Line #\");                                \n\               
          \    print_integer(code >> 17);                               \n\
          \    print_string(\" Column #\");                             \n\
          \    print_integer((code >> 9) & 0xFF);                       \n\
          \    print_string(\" in \");                                  \n\
          \    print_string(trace[code & 0x1FF]);                       \n\
          \    print_string(\".\\n\");                                  \n"
        }
        buf.append
        "  };                                                         \n\ 
        \};                                                           \n\ 
        \ \n\ 
        \void lisaac_stack_print(long up)                             \n\  
        \{ long idx_mount,i;                                          \n\ 
        \  __li_fix_order_mountain();                                 \n\
        \  _li_quicksort(1,(__li_mountain[1]/3)-1);                   \n\
        \  print_string(\"\\n============== BOTTOM ==============\\n\"); \n\
        \  asm(\"movq %%rsp,%0\": \"=r\" (tmp_rsp) : );               \n\
        \  idx_mount = __li_get_back_index(0,tmp_rsp);                \n\
        \  for (i=0;i<up;i++)                                         \n\
        \    idx_mount = __li_get_back_index(idx_mount,tmp_rsp);      \n\
        \  __li_sub_stack_print(idx_mount,tmp_rsp);                   \n\
        \  print_string(\"================ TOP ===============\\n\"); \n\ 
        \}                                            \n\ /* { */
        \ \n"
      } else {
        /*
        buf.append
        "void lisaac_push_first(_____CONTEXT *path,uint64_t code)\n\
        \{ \n"
        (debug_level_option = 20).if {                                    
          buf.append
          "  _____CONTEXT *cur,loop;\n\
          \  cur = (_____CONTEXT *)top_context; \n\
          \  while ((cur != (void *)0) && (cur != path)) cur = cur->back; \n\
          \  if (cur == path) {\n\
          \    loop.back = (_____CONTEXT *)top_context;\n\                                
          \    loop.code = code; \n\
          \    lisaac_stack_print((long)&loop);\n\
          \    print_string(\"COMPILER: Debug context looping detected !\\n\");\n\
          \    die_with_code(1);\n\
          \  };\n"
        }
        buf.append
        "  path->back  = (_____CONTEXT *)top_context;\n\
        \  path->code  = code;\n\
        \  top_context = (uintptr_t)path;\n\                                         
        \} \n\      
        \  \n\
        \void lisaac_push(_____CONTEXT *path,uint64_t code)\n\
        \{ \n\
        \  path->code  = code;\n\                                         
        \  top_context = (uintptr_t)path;\n\                                         
        \} \n\
        \  \n\
        \  \n"*/
        buf.append
        "void lisaac_stack_print(long step)           \n\
        \{ _____CONTEXT *back,*next,*up;              \n\
        \  int j,c;	                              \n\                 
        \  up = (_____CONTEXT *)top_context;          \n\
        \  for (j=0;j<step;j++) up = up->back;        \n\
        \  next = (void *)0;                          \n\
        \  while (up != (void *)0) {                  \n\
        \    back = up -> back;                       \n\                 
        \    up -> back = next;                       \n\
        \    next = up;                               \n\
        \    up = back;                               \n\                 
        \  };                                         \n\            
        \  print_string(\"\\n============== BOTTOM ==============\\n\"); \n\
        \  while (next != (void *)0) {                \n"
        (debug_with_code).if {                                            
          buf.append
          "    print_string(\"Line #\");                           \n\
          \    print_integer(__src[next->code].pos >> 17);         \n\
          \    print_string(\" Column #\");                        \n\
          \    print_integer((__src[next->code].pos >> 9) & 0xFF); \n\
          \    print_string(\" in \");                             \n\
          \    print_string(trace[__src[next->code].pos & 0x1FF]); \n\
          \    print_string(\".\\n\");                             \n\
          \    print_string(__src[next->code].line);               \n\    
          \    print_char('\\n');                                  \n\
          \    j=c=0;                                                \n\
          \    while (c < ((__src[next->code].pos >> 9) & 0xFF)) {\n\
          \      if (__src[next->code].line[j]=='\\t') print_char('\\t');\n\ 
          \      else print_char(' ');\n\
          \      j++; c++; \n\
          \      while ((__src[next->code].line[j]&0xC0)==0x80) { j++; }; \n\
          \    };                                                  \n\
          \    print_char('^');                                    \n\
          \    print_char('\\n');                                  \n"
        } else {                                                           
          buf.append
          "    print_string(\"Line #\");                \n\
          \    print_integer(next->code >> 17);         \n\
          \    print_string(\" Column #\");             \n\
          \    print_integer((next->code >> 9) & 0xFF); \n\
          \    print_string(\" in \");                  \n\
          \    print_string(trace[next->code & 0x1FF]); \n\
          \    print_string(\".\\n\");                  \n"
        }
        buf.append
        "    next = next -> back;                     \n\               
        \  };                                         \n\                  
        \  print_string(\"================ TOP ===============\\n\"); \n\  
        \  top_context = 0;                   \n\                  
        \}                                            \n\ 
        \ \n"
      }
      buf.append
      "void print_integer(int64_t n)           \n\
      \{ int64_t val;                       \n\ 
      \  char car;                          \n\
      \  if (n<0) { print_char('-'); n=-n;};\n\
      \  car = (n % 10) + '0';              \n\
      \  val = n / 10;                      \n\
      \  if (val != 0) print_integer(val);  \n\
      \  print_char(car);                   \n\
      \} \n\n\
      \void print_integer_h_2(uint64_t n,int64_t l) \n\
      \{ uint64_t val,v,j;            \n\ 
      \  char car;                           \n\
      \  v = n & 0xF;                        \n\
      \  if (v < 10) car = v + '0'; else car = (v-10) + 'A'; \n\
      \  val = n >> 4;                       \n\
      \  if (val != 0) print_integer_h_2(val,l-1); else \n\
      \  for (j=0;j<l;j++) print_string(\"-\"); \n\
      \  print_char(car);                    \n\ 
      \} \n\
      \ \n\
      \void print_integer_h(uint64_t n)  \n\
      \{                                      \n\
      \  print_integer_h_2(n,15);             \n\
      \} \n\
      \ \n\n"
    }
  )

  - load_main_object <-
  ( + type_gen:Array Itm_type
    + itm_type_character:Itm_type
    + itm_type_n_a_character:Itm_type

    // NULL, VOID, CONTEXT
    Type_null.make_null
    Type_void.make_void
    Type_context.make_context
    Type_id.make_type_id; // Pas utile !
    // Other prototype.
    type_true    := Itm_type_style.get str_true  style 1.to_run.raw
    type_false   := Itm_type_style.get str_false style 1.to_run.raw
    type_boolean := Itm_type_style.get str_boolean style 1.to_run.raw
    type_integer := Itm_type_style.get str_int style 1.to_run.raw
    type_real    := Itm_type_style.get "Real" style 1.to_run.raw
    type_integer_32:=Itm_type_style.get str_int_32 style 1.to_run.raw
    type_uinteger_32:=Itm_type_style.get str_uint_32 style 1.to_run.raw
    type_string_alias:=Itm_type_simple.get str_string_alias.to_run.raw
    itm_type_character:=Itm_type_style.get "Char" style 1
    type_char := itm_type_character.to_run.raw
    type_block   := Itm_type_simple.get str_block.to_run.raw
    //
    type_pointer := Itm_type_simple.get "Pointer".to_run.raw
    type_utils   := Itm_type_simple.get "Utils" .to_run.raw
    // C_array Char
    type_gen  := Alias_array Itm_type .new
    type_gen.add_last itm_type_character
    type_gen  := Alias_array Itm_type .alias type_gen
    itm_type_n_a_character := Itm_type_generic.get str_n_a style 0 with type_gen
    type_n_a_char := itm_type_n_a_character.to_run.raw
    // C_array (C_array Char)
    // Input.
    string_tmp.copy input_name
    string_tmp.at 0 put (string_tmp.first.to_upper)
    type_input   := Itm_type_simple.get (string_tmp.to_string_alias).to_run.raw
    //
    (debug_level_option != 0).if {
      // Load for `print_char' and `die_with_code'
      Itm_type_simple.get "System_io".to_run
    }
    ? {type_input != NULL}
  )

  - print msg:String_alias stat n:Int for t:Int <-
  ( + pour_mil:Int

    (t != 0).if {
      Stderr.put_string msg
      pour_mil := `(int)((1000./ @t * @n))`:Int
      Stderr.put_integer (pour_mil/10)
      Stderr.put_character '.'
      Stderr.put_integer (pour_mil%10)
      Stderr.put_string "% ("
      Stderr.put_integer n
      Stderr.put_character '/'
      Stderr.put_integer t
      Stderr.put_string ")\n"
    }
  )

Public

  - tab:Array Int := Array Int .create 128

  //
  // Creation.
  //

  - main <-
  ( + file_output:Pointer
    + start:Int
    + alias_proto:Type
    + begin_time:Uint64
    + s:Lip_slot_code
    
    begin_time := Time.gettimeofday
    //
    // Load Environment.
    //
    read_options
    is_verbose.if {
      string_tmp.copy "\ninput  file: "
      string_tmp.append input_name
      string_tmp.append ".li\noutput file: "
      string_tmp.append output_name
      string_tmp.append output_extension
      string_tmp.append "\npath directory :\n"
      path_file.lower.to (path_file.upper) do { j:Int
        string_tmp.append "  "
        string_tmp.append (path_file.at j)
        string_tmp.add_last '\n'
      }
      string_tmp.print
    }

    //
    // Header C
    //
    output_decl.copy "/* C code generated by Lisaac compiler (www.lisaac.org) */\n\n"

    // Large file headers
    output_decl.append
    "#define _LARGE_FILE_API\n\
    \#define _LARGEFILE_SOURCE\n\
    \#define _LARGEFILE64_SOURCE\n"

    // The generated code needs `uint32_t', `uint64_t' and `uintptr_t'.
    output_decl.append "#include <stdint.h>\n"

    // ANSI argument command.
    (debug_level_option != 0).if {
      output_decl.append "#include <signal.h>\n"
    }
    output_decl.append "int print_string(char *str);\n"
    (core_count > 1).if {
      output_decl.append
      "extern int arg_count;\n\
      \extern char **arg_vector;\n"
    }
    
    (core_count > 1).if {
      core_count.times {
        output_list.add_last (String_buffer.create 4_000_000)
        output_list.last # "#include \"" # output_name # ".h\"\n"
      }
      output_glob # "#include \"" # output_name # ".h\"\n"
    } else {
      output_list.add_last (String_buffer.create 4_000_000)
    }
    output := output_list.first

    // External.
    title "INCLUDE" in output_decl    
    title "EXTERNAL" in output_glob
    
    //
    // Load prototype constant.
    //
    load_main_object

    // Compilation.
    type_input.prototype.depend
        
    // Type / Struct.
    title "TYPE" in output_decl
        
    output_decl.append
    "/* Generic Object */\n\
    \struct ___OBJ {\n\
    \  uint32_t __id;\n\
    \};\n\n"
                            
    title "GLOBAL" in output_glob
    output_glob.append
    "int arg_count;\n\
    \char **arg_vector;\n"
    
    ///////////////// SOURCE CODE /////////////////
    title "CODE" in output
    
    (is_cop).if {
      (debug_level_option != 0).if {
        // Debug: the cycles of synchronous messages are detected (see `li_deadlock_check').
        output_decl.append "#define LI_COP_DEBUG\n"
      }
      output_decl.append
      "#include <pthread.h>\n\
      \#include <stdlib.h>\n\
      \#include <string.h>\n\
      \#include <sched.h>\n\
      \#include <time.h>\n\
      \#include <unistd.h>\n\
      \\n\
      \/* COP: each clone of a `-' prototype is a universe, with its FIFO of messages and its base\n\
      \   (the `-' slots). The universes run on a pool of worker threads (one by core): a universe is\n\
      \   only a FIFO and a state, its messages run to their end (see `doc/tla/CopScheduler.tla'). */\n\
      \#if defined(__TINYC__)\n\
      \#define LI_BASE_TLS\n\
      \#else\n\
      \#define LI_BASE_TLS __thread\n\
      \#endif\n\
      \struct universe_base;\n\
      \extern LI_BASE_TLS struct universe_base *li_base;\n\
      \extern struct universe_base li_main_base;\n\
      \void li_init_base(void);\n\
      \struct universe_base *li_alloc_base(void);\n\
      \struct universe_base *li_new_base(void);\n\
      \void print_char(char car);\n\
      \void die_with_code(int64_t code);\n\
      \\n\
      \typedef struct lith_object_struct lith_object;\n\
      \typedef struct lith_msg_struct lith_msg;\n\
      \typedef struct li_pool_struct li_pool;\n\
      \typedef struct li_worker_struct li_worker;\n\
      \struct lith_msg_struct {\n\
      \  lith_msg *next;\n\
      \  void (*procedure)(lith_object *obj,lith_msg *msg); /* NULL: token of a synchronous message. */\n\
      \  int cls; /* Size class in the pool of the thread @pool (-1: malloc). */\n\
      \  li_pool *pool;\n\
      \};\n\
      \struct lith_object_struct {\n\
      \  uint64_t __id; /* Just for late binding. */\n\
      \  lith_msg *head; /* FIFO (Vyukov): read by the owner only... */\n\
      \  lith_msg *tail; /* ...appended by everybody (atomic exchange). */\n\
      \  int count; /* Atomic: the messages in the FIFO (with the ones being appended). */\n\
      \  lith_msg stub;\n\
      \  struct universe_base *base;\n\
      \  void (*init_object)(lith_object *u); /* Its fields, in its universe (after the base). */\n\
      \  int state; /* Atomic: LI_IDLE, LI_SCHED (in a run queue) or LI_RUN (owned by a thread). */\n\
      \  lith_object *lazy; /* In `li_lazy': opened idle, with its initialization in its FIFO. */\n\
      \#ifdef LI_COP_DEBUG\n\
      \  lith_object *waits; /* Atomic: the universe it waits for (synchronous message), or NULL. */\n\
      \#endif\n\
      \};\n\
      \struct generic_protocop {\n\
      \  lith_object thread;\n\
      \};\n\
      \typedef struct {\n\
      \  pthread_mutex_t mutex;\n\
      \  pthread_cond_t cond;\n\
      \} li_parker; /* Where a thread waits for a universe (one by thread, never freed). */\n\
      \typedef struct {\n\
      \  lith_msg tok; /* In the FIFO of @u: its turn. */\n\
      \  lith_object *u;\n\
      \  struct universe_base *base;\n\
      \  lith_object *current;\n\
      \  int granted; /* Atomic: the universe is given to the caller. */\n\
      \  li_parker *parker;\n\
      \} lith_sync;\n\
      \\n\
      \#define LI_IDLE  0\n\
      \#define LI_SCHED 1\n\
      \#define LI_RUN   2\n\
      \#define LI_BATCH 64 /* Messages of a universe before the next one (fairness). */\n\
      \#if defined(__x86_64__) || defined(__i386__)\n\
      \#define li_pause() __builtin_ia32_pause()\n\
      \#elif defined(__aarch64__)\n\
      \#define li_pause() __asm__ __volatile__(\"yield\" ::: \"memory\")\n\
      \#else\n\
      \#define li_pause() __asm__ __volatile__(\"\" ::: \"memory\")\n\
      \#endif\n\
      \#define LI_MAX_SPINNING 2 /* Workers looking for work by spinning (the others sleep). */\n\
      \\n\
      \static LI_BASE_TLS lith_object *li_current; /* NULL: the main universe. */\n\
      \\n\
      \/* Messages: a pool for each thread, without lock. The receiver gives a message back to the\n\
      \   pool of its sender (atomic stack @remote); the owner takes all the stack at once. */\n\
      \#define LI_MSG_CLASSES 8 /* Sizes: 32, 64, ..., 256 bytes. */\n\
      \struct li_pool_struct {\n\
      \  lith_msg *local[LI_MSG_CLASSES];\n\
      \  lith_msg *remote[LI_MSG_CLASSES];\n\
      \};\n\
      \static LI_BASE_TLS li_pool *li_my_pool;\n\
      \\n\
      \static lith_msg *li_msg_alloc(unsigned long sz)\n\
      \{ int c = (int)((sz + 31) >> 5) - 1;\n\
      \  lith_msg *m;\n\
      \  li_pool *p = li_my_pool;\n\
      \  if (c >= LI_MSG_CLASSES) {\n\
      \    m = (lith_msg *)malloc(sz);\n\
      \    m->cls = -1;\n\
      \    return m;\n\
      \  }\n\
      \  if (p == NULL) {\n\
      \    p = li_my_pool = (li_pool *)calloc(1,sizeof(li_pool));\n\
      \  }\n\
      \  m = p->local[c];\n\
      \  if (m == NULL) {\n\
      \    m = p->local[c] = __atomic_exchange_n(&p->remote[c],NULL,__ATOMIC_ACQUIRE);\n\
      \  }\n\
      \  if (m == NULL) {\n\
      \    m = (lith_msg *)malloc((unsigned long)(c + 1) << 5);\n\
      \    m->cls = c;\n\
      \    m->pool = p;\n\
      \  } else {\n\
      \    p->local[c] = m->next;\n\
      \  }\n\
      \  return m;\n\
      \}\n\
      \\n\
      \static void li_msg_free(lith_msg *m)\n\
      \{ li_pool *p = m->pool;\n\
      \  int c = m->cls;\n\
      \  if (c < 0) {\n\
      \    free(m);\n\
      \  } else if (p == li_my_pool) {\n\
      \    m->next = p->local[c];\n\
      \    p->local[c] = m;\n\
      \  } else {\n\
      \    m->next = __atomic_load_n(&p->remote[c],__ATOMIC_RELAXED);\n\
      \    while (!__atomic_compare_exchange_n(&p->remote[c],&m->next,m,1,__ATOMIC_RELEASE,__ATOMIC_RELAXED));\n\
      \  }\n\
      \}\n\
      \\n\
      \static void li_cop_error(const char *msg)\n\
      \{\n\
      \  while (*msg != 0) print_char(*(msg++));\n\
      \  die_with_code(1);\n\
      \}\n\
      \\n\
      \/* The FIFO of a universe (Vyukov's intrusive queue: several senders, one owner). */\n\
      \\n\
      \static void li_link(lith_object *u,lith_msg *m)\n\
      \{ lith_msg *prev;\n\
      \  __atomic_store_n(&m->next,NULL,__ATOMIC_RELAXED);\n\
      \  prev = __atomic_exchange_n(&u->tail,m,__ATOMIC_SEQ_CST);\n\
      \  __atomic_store_n(&prev->next,m,__ATOMIC_RELEASE);\n\
      \}\n\
      \\n\
      \static void li_push(lith_object *u,lith_msg *m)\n\
      \/* Counted before it is linked: a thread which sees the count waits for the link (LI_BUSY). */\n\
      \{\n\
      \  __atomic_add_fetch(&u->count,1,__ATOMIC_SEQ_CST);\n\
      \  li_link(u,m);\n\
      \}\n\
      \\n\
      \#define LI_BUSY ((lith_msg *)1) /* A sender is between its two steps: try again. */\n\
      \\n\
      \static lith_msg *li_pop(lith_object *u)\n\
      \/* By the owner of `u': the first message, NULL if the FIFO is empty, or LI_BUSY. */\n\
      \{ lith_msg *h = u->head;\n\
      \  lith_msg *next = __atomic_load_n(&h->next,__ATOMIC_ACQUIRE);\n\
      \  if (h == &u->stub) {\n\
      \    if (next == NULL) {\n\
      \      return (__atomic_load_n(&u->tail,__ATOMIC_SEQ_CST) == h) ? NULL : LI_BUSY;\n\
      \    }\n\
      \    u->head = h = next;\n\
      \    next = __atomic_load_n(&h->next,__ATOMIC_ACQUIRE);\n\
      \  }\n\
      \  if (next != NULL) {\n\
      \    u->head = next;\n\
      \    __atomic_sub_fetch(&u->count,1,__ATOMIC_SEQ_CST);\n\
      \    return h;\n\
      \  }\n\
      \  if (h != __atomic_load_n(&u->tail,__ATOMIC_SEQ_CST)) return LI_BUSY;\n\
      \  li_link(u,&u->stub);\n\
      \  next = __atomic_load_n(&h->next,__ATOMIC_ACQUIRE);\n\
      \  if (next != NULL) {\n\
      \    u->head = next;\n\
      \    __atomic_sub_fetch(&u->count,1,__ATOMIC_SEQ_CST);\n\
      \    return h;\n\
      \  }\n\
      \  return LI_BUSY;\n\
      \}\n\
      \\n\
      \static lith_msg *li_peek(lith_object *u)\n\
      \/* By the owner of `u': the first message, without taking it (NULL: empty, or being appended). */\n\
      \{ lith_msg *h = u->head;\n\
      \  if (h == &u->stub) h = __atomic_load_n(&h->next,__ATOMIC_ACQUIRE);\n\
      \  return h;\n\
      \}\n\
      \\n\
      \static int li_is_empty(lith_object *u)\n\
      \/* For any thread (`head' and `tail' do not tell it: the stub may be appended after a\n\
      \   message which is not taken yet). */\n\
      \{\n\
      \  return __atomic_load_n(&u->count,__ATOMIC_SEQ_CST) == 0;\n\
      \}\n\
      \\n\
      \/* The pool of workers: a run queue for each one (and `runnext': the universe which got a\n\
      \   message from the current one runs next on the same thread, without waking up another),\n\
      \   a global run queue for the other threads (main), and the stealing between workers. */\n\
      \\n\
      \struct li_worker_struct {\n\
      \  pthread_mutex_t mutex;\n\
      \  lith_object **buf;\n\
      \  int head,count,cap;\n\
      \  lith_object *runnext;\n\
      \  int id;\n\
      \  unsigned long ticks; /* Atomic: messages run (unchanged: busy with one long message). */\n\
      \  int wake; /* A worker to wake up, after `li_sched_mutex' (see `li_find_work'). */\n\
      \};\n\
      \\n\
      \#define LI_MAX_THREADS 1024\n\
      \\n\
      \static li_worker **li_workers;\n\
      \static int li_nworkers;      /* Workers which take work (one by core). */\n\
      \static int li_nthreads;      /* Threads of the pool (more when some are blocked). */\n\
      \static int li_blocked;       /* Atomic: workers blocked in a system call (a delay...). */\n\
      \static int li_idle;          /* Atomic: workers asleep. */\n\
      \static int li_spinning;      /* Atomic: workers looking for work. */\n\
      \static LI_BASE_TLS li_worker *li_me; /* NULL: not a worker (main). */\n\
      \static pthread_mutex_t li_sched_mutex = PTHREAD_MUTEX_INITIALIZER;\n\
      \static pthread_cond_t li_sched_cond = PTHREAD_COND_INITIALIZER;\n\
      \static pthread_cond_t li_end_cond = PTHREAD_COND_INITIALIZER;\n\
      \static li_worker li_global; /* For the threads which are not workers. */\n\
      \static pthread_once_t li_once = PTHREAD_ONCE_INIT;\n\
      \\n\
      \static int li_wq_push(li_worker *w,lith_object *u)\n\
      \/* The number of universes in the queue before (read with its lock). */\n\
      \{ int was;\n\
      \  pthread_mutex_lock(&w->mutex);\n\
      \  was = w->count;\n\
      \  if (w->count == w->cap) {\n\
      \    int i,cap = (w->cap == 0) ? 64 : 2 * w->cap;\n\
      \    lith_object **b = (lith_object **)malloc(cap * sizeof(lith_object *));\n\
      \    for (i = 0; i < w->count; i++) b[i] = w->buf[(w->head + i) % w->cap];\n\
      \    free(w->buf);\n\
      \    w->buf = b; w->head = 0; w->cap = cap;\n\
      \  }\n\
      \  w->buf[(w->head + w->count) % w->cap] = u;\n\
      \  __atomic_store_n(&w->count,w->count + 1,__ATOMIC_SEQ_CST);\n\
      \  pthread_mutex_unlock(&w->mutex);\n\
      \  return was;\n\
      \}\n\
      \\n\
      \static lith_object *li_wq_pop(li_worker *w);\n\
      \\n\
      \static lith_object *li_wq_take(li_worker *from,li_worker *to,int n)\n\
      \/* Takes up to @n universes of @from (one lock): the first is returned, the others go to the\n\
      \   queue of @to. */\n\
      \{ lith_object *batch[64];\n\
      \  int i,k = 0;\n\
      \  if (n > 64) n = 64;\n\
      \  pthread_mutex_lock(&from->mutex);\n\
      \  while ((k < n) && (from->count > 0)) {\n\
      \    batch[k++] = from->buf[from->head];\n\
      \    from->head = (from->head + 1) % from->cap;\n\
      \    __atomic_store_n(&from->count,from->count - 1,__ATOMIC_SEQ_CST);\n\
      \  }\n\
      \  pthread_mutex_unlock(&from->mutex);\n\
      \  for (i = 1; i < k; i++) li_wq_push(to,batch[i]);\n\
      \  return (k > 0) ? batch[0] : NULL;\n\
      \}\n\
      \\n\
      \static lith_object *li_wq_pop(li_worker *w)\n\
      \{ lith_object *u = NULL;\n\
      \  if (__atomic_load_n(&w->count,__ATOMIC_SEQ_CST) == 0) return NULL;\n\
      \  pthread_mutex_lock(&w->mutex);\n\
      \  if (w->count > 0) {\n\
      \    u = w->buf[w->head];\n\
      \    w->head = (w->head + 1) % w->cap;\n\
      \    __atomic_store_n(&w->count,w->count - 1,__ATOMIC_SEQ_CST);\n\
      \  }\n\
      \  pthread_mutex_unlock(&w->mutex);\n\
      \  return u;\n\
      \}\n\
      \\n\
      \#define LI_SURPLUS 8\n\
      \/* The universes which exchange small messages run better on the same thread (no transfer of\n\
      \   cache lines): a worker takes from another one only a large surplus, or when the other one\n\
      \   is busy with one long message (a computation). */\n\
      \\n\
      \static lith_object *li_wq_steal(li_worker *w,li_worker *thief,int all)\n\
      \/* Taken by another worker: only a surplus (LI_SURPLUS universes: half of them), unless @all\n\
      \   (the owner is busy with one long message): then any universe of its queue, or its\n\
      \   `runnext'. */\n\
      \{ lith_object *u = NULL;\n\
      \  int n = __atomic_load_n(&w->count,__ATOMIC_SEQ_CST);\n\
      \  if (n >= LI_SURPLUS) return li_wq_take(w,thief,n / 2);\n\
      \  if ((n >= 1) && all) return li_wq_pop(w);\n\
      \  if (all && (__atomic_load_n(&w->runnext,__ATOMIC_SEQ_CST) != NULL)) {\n\
      \    pthread_mutex_lock(&w->mutex);\n\
      \    u = __atomic_exchange_n(&w->runnext,NULL,__ATOMIC_SEQ_CST);\n\
      \    pthread_mutex_unlock(&w->mutex);\n\
      \  }\n\
      \  return u;\n\
      \}\n\
      \\n\
      \static void li_wake_one(void)\n\
      \{\n\
      \  if ((__atomic_load_n(&li_idle,__ATOMIC_SEQ_CST) > 0) && (__atomic_load_n(&li_spinning,__ATOMIC_SEQ_CST) == 0)) {\n\
      \    pthread_mutex_lock(&li_sched_mutex);\n\
      \    pthread_cond_signal(&li_sched_cond);\n\
      \    pthread_mutex_unlock(&li_sched_mutex);\n\
