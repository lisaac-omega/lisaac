      \    li_send_now(u,m);\n\
      \  }\n\
      \}\n\
      \\n\
      \void li_send_tail(lith_object *u,lith_msg *m,void (*proc)(lith_object *,lith_msg *))\n\
      \/* Asynchronous message, the last action of the message which runs (`li_tail_ok'): it waits\n\
      \   for the end of this message (see `li_run'). */\n\
      \{ if (li_tail_ok && (u != li_current)) {\n\
      \    m->procedure = proc;\n\
      \    li_tail_flush();\n\
      \    li_tail_u = u;\n\
      \    li_tail_m = m;\n\
      \  } else {\n\
      \    li_send(u,m,proc);\n\
      \  }\n\
      \}\n\
      \\n\
      \#ifdef LI_COP_DEBUG\n\
      \static void li_deadlock_check(lith_object *me,lith_object *u)\n\
      \/* Debug: `me' waits for `u'. If `u' waits for `me', through a chain of synchronous messages,\n\
      \   none of them can go on: a deadlock. Each one writes its link before it reads the chain, so\n\
      \   the last one which closes a cycle sees it. The main universe is never waited for. */\n\
      \{ lith_object *v = u;\n\
      \  if (me == NULL) return;\n\
      \  __atomic_store_n(&me->waits,u,__ATOMIC_SEQ_CST);\n\
      \  while (v != NULL) {\n\
      \    if (v == me) li_cop_error(\"COP Error: deadlock: cycle of synchronous messages!\\n\");\n\
      \    v = __atomic_load_n(&v->waits,__ATOMIC_SEQ_CST);\n\
      \  }\n\
      \}\n\
      \#endif\n\
      \\n\
      \void li_sync_begin(lith_sync *s,lith_object *u)\n\
      \/* Synchronous message: its token in the FIFO of `u', then the caller owns `u' and runs the\n\
      \   messages before its token (it helps), or waits until the owner gives `u' to it. */\n\
      \{ li_tail_flush();\n\
      \  s->base = li_base;\n\
      \  s->current = li_current;\n\
      \  if (u == li_current) {\n\
      \    /* Same universe: immediate. */\n\
      \    s->u = NULL;\n\
      \    return;\n\
      \  }\n\
      \  s->u = u;\n\
      \#ifdef LI_COP_DEBUG\n\
      \  li_deadlock_check(s->current,u);\n\
      \#endif\n\
      \  s->granted = 0;\n\
      \  s->tok.procedure = NULL;\n\
      \  if (li_is_empty(u) && li_try_own(u)) {\n\
      \    /* Fast path: an idle universe, without token. */\n\
      \  } else {\n\
      \    int r,spin = 0;\n\
      \    li_parker *p = s->parker = li_parker_of_thread();\n\
      \    li_push(u,&s->tok);\n\
      \    for (;;) {\n\
      \      if (li_try_own(u)) {\n\
      \        r = li_run(u,s);\n\
      \        if (r == LI_MINE) break;\n\
      \        if (r == LI_RELEASED) li_cop_error(\"COP Error: lost token!\\n\");\n\
      \        /* LI_GRANTED: another caller before; wait for our turn. */\n\
      \      }\n\
      \      if (__atomic_load_n(&s->granted,__ATOMIC_SEQ_CST)) break;\n\
      \      if (spin < 4000) {\n\
      \        spin++;\n\
      \        li_pause();\n\
      \      } else {\n\
      \        struct timespec t;\n\
      \        pthread_mutex_lock(&p->mutex);\n\
      \        if (!__atomic_load_n(&s->granted,__ATOMIC_SEQ_CST)) {\n\
      \          /* Woken up by the grant, or soon: the universe may be free again (to own it). */\n\
      \          clock_gettime(CLOCK_REALTIME,&t);\n\
      \          t.tv_nsec += 200000;\n\
      \          if (t.tv_nsec >= 1000000000) { t.tv_sec++; t.tv_nsec -= 1000000000; }\n\
      \          pthread_cond_timedwait(&p->cond,&p->mutex,&t);\n\
      \        }\n\
      \        pthread_mutex_unlock(&p->mutex);\n\
      \      }\n\
      \    }\n\
      \  }\n\
      \  li_base = u->base;\n\
      \  li_current = u;\n\
      \}\n\
      \\n\
      \void li_sync_end(lith_sync *s)\n\
      \{ lith_object *u = s->u;\n\
      \  if (u != NULL) {\n\
      \    li_base = s->base;\n\
      \    li_current = s->current;\n\
      \#ifdef LI_COP_DEBUG\n\
      \    if (s->current != NULL) __atomic_store_n(&s->current->waits,NULL,__ATOMIC_SEQ_CST);\n\
      \#endif\n\
      \    { lith_msg *m = li_peek(u);\n\
      \      if ((m != NULL) && (m->procedure == NULL)) {\n\
      \        /* The token of another caller is the next one: `u' goes to it at once (without a\n\
      \           release, a scheduling and a new owner which would give it again). */\n\
      \        m = li_pop(u);\n\
      \        if ((m != NULL) && (m != LI_BUSY)) {\n\
      \          li_grant((lith_sync *)m);\n\
      \          return;\n\
      \        }\n\
      \      }\n\
      \    }\n\
      \    li_release(u);\n\
      \  }\n\
      \}\n\
      \\n\
      \static int li_lazy_start(void)\n\
      \/* The universes opened lazily which never started (their initialization is still in their\n\
      \   FIFO) start now. The number of them. */\n\
      \{ lith_object *u = __atomic_exchange_n(&li_lazy,NULL,__ATOMIC_SEQ_CST);\n\
      \  int n = 0;\n\
      \  while (u != NULL) {\n\
      \    lith_object *next = u->lazy;\n\
      \    int e = LI_IDLE;\n\
      \    if (!li_is_empty(u) && __atomic_compare_exchange_n(&u->state,&e,LI_SCHED,0,__ATOMIC_SEQ_CST,__ATOMIC_SEQ_CST)) {\n\
      \      li_wq_push(&li_global,u);\n\
      \      n++;\n\
      \    }\n\
      \    u = next;\n\
      \  }\n\
      \  if (n > 0) li_wake_one();\n\
      \  return n;\n\
      \}\n\
      \\n\
      \void li_wait_all(void)\n\
      \/* End of the program: wait until all the workers are idle, without work; then the lazy\n\
      \   universes which never started start, and again. */\n\
      \{\n\
      \  pthread_once(&li_once,li_start_pool);\n\
      \  do {\n\
      \    pthread_mutex_lock(&li_sched_mutex);\n\
      \    while ((__atomic_load_n(&li_idle,__ATOMIC_SEQ_CST) + __atomic_load_n(&li_blocked,__ATOMIC_SEQ_CST) < __atomic_load_n(&li_nthreads,__ATOMIC_SEQ_CST)) ||\n\
      \           (__atomic_load_n(&li_blocked,__ATOMIC_SEQ_CST) > 0) || li_has_work()) {\n\
      \      pthread_cond_wait(&li_end_cond,&li_sched_mutex);\n\
      \    }\n\
      \    pthread_mutex_unlock(&li_sched_mutex);\n\
      \  } while (li_lazy_start() > 0);\n\
      \}\n\
      \\n\
      \void wait_all(void) { li_wait_all(); }\n\n"
    }
        
    // Source code.
    //title "SOURCE CODE" in output

    (is_library).if {
      output.append "int init(int argc,char **argv)\n"
    } else {
      output.append "int main(int argc,char **argv)\n"
    }
    output.append "{\n"    
    indent.append "  "

    profil_current := NULL
    list_main.genere_extern_result NULL

    (is_cop).if {
      // End of the program: when all the universes are idle.
      output.append "  li_wait_all();\n"
    }
    output.append "  return(0);\n"
    indent.remove_tail 2
    output.append indent
    output.append "}\n\n"

    (is_cop).if {
      // Initialization of a new universe base: one function for each slot (see
      // @Slot_data.init_lists_base), `li_init_base' calls all of them.
      (Slot_data.init_lists_base.lower).to (Slot_data.init_lists_base.upper) do { j:Int
        output # "void li_init_base_" # j # "(void)\n{\n"
        start := output.count
        indent.append "  "
        profil_current := NULL
        Escape.set_generating_base True
        Slot_data.init_lists_base.at j.genere_extern_result NULL
        Escape.set_generating_base False
        indent.remove_tail 2
        (debug_level_option != 0).if {
          declare_context_from start
        }
        output.append "}\n\n"
      }
      output.append "void li_init_base(void)\n{\n  LI_INIT_PROTOS;\n"
      (Slot_data.init_lists_base.lower).to (Slot_data.init_lists_base.upper) do { j:Int
        output # "  li_init_base_" # j # "();\n"
      }
      output.append "}\n\n"
      output.append "struct universe_base *li_alloc_base(void)\n\
      \{\n\
      \  return (struct universe_base *)calloc(1,sizeof(struct universe_base));\n\
      \}\n\n\
      \struct universe_base *li_new_base(void)\n\
      \// A new initialized base, which becomes the base of the current thread.\n\
      \{\n\
      \  li_base = li_alloc_base();\n\
      \  li_init_base();\n\
      \  return li_base;\n\
      \}\n\n"
    }
    
    (is_cop_report).if {
      // The COP messages (`-cop_report', see `make.lip').
      "COP messages:\n".print
    }
    
    Profil_list.genere

    Type.genere_all_struct
    
    // Debug source code.
    (debug_level_option != 0).if {
      title "DEBUG MANAGER" in output_decl
      (is_ansi).if {
        output_decl.append "void interrupt_signal(int sig);\n"
      }
      output_decl.append
      "void lisaac_stack_print(long);        \n\
      \void print_integer_h(uint64_t n);\n\
      \void print_integer(int64_t n);           \n"
      (is_speed_push).if {
        output_decl.append
        "long __li_get_ret(long current);    \n\
        \long __li_get_back(long current);   \n\        
        \extern long __li_mountain[];        \n"
      } else {
        /*
        output_decl.append
        "void lisaac_push_first(_____CONTEXT *path,uint64_t code); \n\
        \void lisaac_push(_____CONTEXT *path,uint64_t code);       \n"
        */        
        output_decl.append
        "#define lisaac_push_first(path, c) \\\n\
        \do { \\\n\
        \(path)->back = (_____CONTEXT *)top_context; \\\n\
        \(path)->code = (c); \\\n\
        \top_context = (uintptr_t)(path); \\\n\
        \} while (0)\n\n"
        output_decl.append
        "#define lisaac_push(path, c) \\\n\
        \do { \\\n\
        \(path)->code = (c); \\\n\
        \top_context = (uintptr_t)(path); \\\n\
        \} while (0)\n\n"
      }
    }
        
    // Just used in MEMORY.li (BSBS: A verifier si memory.li est vivant!!!)
    output_glob # "\nvoid *table_type[" # Type.id_counter_without_type # "];\n"
    
    ((Slot_data.data_hash_code_alias != NULL) && {Slot_data.data_hash_code_alias.require_count > 0}).if {
      output.append "void init_string_alias() {\n"
      alias_proto := NULL
      ((is_cop) && {Profil_slot.profil_add_alias != NULL}).if {
        alias_proto := Profil_slot.profil_add_alias.type_self.raw
        (alias_proto.prototype.style != '-').if {
          alias_proto := NULL
        }
      }
      (alias_proto != NULL).if {
        // COP: the table of the aliases is an active object, the literals go in its universe.
        output # "  lith_sync li_sync;\n  li_sync_begin(&li_sync,(lith_object *)(" # alias_proto.intern_name # "__));\n"
      }
      output.append (String_cst.output_init)
      (alias_proto != NULL).if {
        output.append "  li_sync_end(&li_sync);\n"
      }
      output.append "};\n"
    }
        
    // Trace code.
    put_trace_code output_glob
    
    (String_cst.output_count != 0).if {
      output_decl.append (String_cst.output_ext)
      output_glob.append (String_cst.output_str)      
    }
    
    // Function header.
    title "FUNCTION HEADER" in output_decl
    output := output_decl
    Profil_list.genere_handler
    ((Slot_data.data_hash_code_alias != NULL) && {Slot_data.data_hash_code_alias.require_count > 0}).if {
      output_decl # "void init_string_alias();\n#define INIT_STRING_ALIAS init_string_alias()\n"
    } else {
      output_decl # "#define INIT_STRING_ALIAS\n"
    }
    
    //
    // Saving File Output.
    //
    (output_list.count = 1).if {
      string_tmp |# output_name # output_extension
      file_output := File_utils.open_write string_tmp
      (file_output = NULL).if { Out # "Error: File " # string_tmp # " is not created !\n"; exit exit_failure_code }
      File_utils.write file_output with output_decl size (output_decl.count)
      File_utils.write file_output with output_glob size (output_glob.count)
      File_utils.write file_output with (output_list.first) size (output_list.first.count)
      File_utils.close file_output
    } else {
      // Decl
      string_tmp |# output_name # ".h"
      file_output := File_utils.open_write string_tmp
      (file_output = NULL).if { Out # "Error: File " # string_tmp # " is not created !\n"; exit exit_failure_code }
      File_utils.write file_output with output_decl size (output_decl.count)
      File_utils.close file_output
      // Glob
      string_tmp |# output_name # "_data" # output_extension
      file_output := File_utils.open_write string_tmp
      (file_output = NULL).if { Out # "Error: File " # string_tmp # " is not created !\n"; exit exit_failure_code }
      File_utils.write file_output with output_glob size (output_glob.count)
      File_utils.close file_output
      split_files.add_last (string_tmp.to_string_alias)
      // Code
      0.to (output_list.upper) do { i:Int
        string_tmp |# output_name # "_code" # i # output_extension
        file_output := File_utils.open_write string_tmp
        (file_output = NULL).if { Out # "Error: File " # string_tmp # " is not created !\n"; exit exit_failure_code }
        File_utils.write file_output with (output_list.at i) size (output_list.at i.count)
        File_utils.close file_output
        split_files.add_last (string_tmp.to_string_alias)
      }      
    }
    //
    //
    (is_all_warning).if {
      Prototype.prototype_dico.foreach_value { p:Prototype
          p.detect_slot_not_used
      }
    }
    
    //
    begin_time := print_time begin_time
    ((! is_quiet) && {Position.nb_warning != 0}).if {
      Out # " => " # Position.nb_warning # " warning(s).\n"
    }
    (is_statistic).if {
      //+ tmp,tmp2:Int
      Stderr.put_string "  Local counter        : "
      Stderr.put_integer (List.local_counter)
      Stderr.put_string "\n"
      Stderr.put_string "  Context counter      : "
      Stderr.put_integer (List.context_counter)
      Stderr.put_string "\n"
      print "  NULL call score      : " stat null_counter for late_binding_counter
      print "  Polymorphic call     : " stat polymorphic_counter for late_binding_counter
      print "  Call on Flat     : " stat late_binding_flat_counter for late_binding_counter
      print "  Call on self         : " stat late_binding_self_counter     for late_binding_counter
      //
      //print "  Recursivity function : "
      //
      (is_optimization).if {
        "  Invariant loop score : ".print; count_invariant.print; '\n'.print
      }
      // switch:
      "\nswitch          : ".print
      count_switch.print
      "\nswitch merging  : ".print
      count_switch_merging.print
      '\n'.print      
    }
    
    //
    // Execute finality command (front end).
    //
    // Executing `front_end':        
    s := Lip_code.get_method "back_end"
    if (s = NULL) then {
      "Warning: Slot `back_end' not found in *.lip file.\n".print;
    } else {
      s.run_with NULL
    }
    print_time begin_time
  )
  
  - print_time b:Uint64 :Uint64 <-
  ( + e:Uint64
    + t:Int
    (is_quiet).if_false {
      e := Time.gettimeofday
      Out # " => "
      t := ((e - b)/1_000_000).to_int
      (t >= 120).if {
        Out # (t/60) # " minutes, "
        t := t % 60
      }
      Out # t # " second(s).\n"
    }
    e
  )

