Header
  + name := Expr_xor
/*Xor Binary arithmetic expression.*/
Inherit

  + parent_expr_binary:Flat Expr_binary

Public

  + symbol:String_alias := "^"

  //
  // Execute.
  //

  - exec_conservator_left  left_cst :Int_cst :Expr <-
  //-- 0  ^ E -> E
  //-- -1 ^ E -> ~ E
  ( + result:Expr

    (left_cst.value = 0).if {
      result := right
      left_cst.remove
    }.elseif {left_cst.is_saturated} then {
      result := Expr_not.create position with right
      left_cst.remove
    }
    result
  )

  - exec_conservator_right right_cst:Int_cst :Expr <-
  //-- E ^ 0  -> E
  //-- E ^ -1 -> ~ E
  ( + result:Expr

    (right_cst.value = 0).if {
      result := left
      right_cst.remove
    }.elseif {right_cst.is_saturated} then {
      result := Expr_not.create position with left
      right_cst.remove
    }
    result
  )

  - exec left_cst:Int_cst and right_cst:Int_cst :Expr <-
  //-- C1 ^ C2 -> C3
  (
    left_cst.set_value (left_cst.value ^ right_cst.value)
    right_cst.remove
    left_cst
  )

  - exec:Expr <-
  //-- E ^ E -> 0
  ( + result:Expr

    (left ~= right).if {
      result := Int_cst.create position value 0 type static_type
      left .remove
      right.remove
    }
    result
  )
