Header
  + name := Expr_mod
/*Add Binary Expression.*/
Inherit

  + parent_expr_binary:Flat Expr_binary

Public

  + symbol:String_alias := "%"

  //
  // Execute.
  //

  - exec_conservator_right right_cst:Int_cst :Expr <-
  //-- E %   0 -> Error
  //-- E % 2^n -> E & (2^n -1)
  ( + result:Expr

    (right_cst.value = 0).if {
      warning_error (position,"Division by zero.")
    }.elseif {right_cst.to_power != -1} then {
      right_cst.set_value (right_cst.value - 1)
      result := Expr_and.create position with left and right_cst
    }
    result
  )

  - exec left_cst:Int_cst and right_cst:Int_cst :Expr <-
  //-- C1 % C2 -> C3
  (
    left_cst.set_value (left_cst.value % right_cst.value)
    right_cst.remove
    left_cst
  )

  - exec:Expr <-
  //-- E % E -> 0
  ( + result:Expr

    (left ~= right).if {
      result := Int_cst.create position value 0 type static_type
      left.remove
      right.remove
    }
    result
  )

  - exec_left  left_cst :Int_cst :Expr <-
  //-- 0 % E -> 0
  ( + result:Expr

    (left_cst.value = 0).if {
      result := left_cst
      right.remove
    }
    result
  )

  - exec_right right_cst:Int_cst :Expr <-
  //-- E %   1 -> 0
  //-- E %  -1 -> 0
  ( + result:Expr

    (right_cst.value = 1).if {
      right_cst.set_value 0
      left.remove
      result := right_cst
    }.elseif {right_cst.value = -1} then {
      right_cst.set_value 0
      result := right_cst
      left.remove
    }
    result
  )












