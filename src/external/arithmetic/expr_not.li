Header
  + name := Expr_not
/*Not unary arithmetic expression.*/
Inherit

  + parent_expr_unary:Flat Expr_unary

Public

  - symbol:Char <- '~'

  //
  // Execute.
  //

  - exec_conservator:Expr <-
  //-- ~ (~ E1 & ~ E2) -> E1 | E2
  //-- ~ (~ E1 | ~ E2) -> E1 & E2
  //-- ~ ~ E -> E
  ( + or:Expr_or
    + and:Expr_and
    + neg1,neg2:Expr_not
    + result:Expr

    and ?= right
    (and != NULL).if {
      neg1 ?= and.left
      neg2 ?= and.right
      ((neg1 != NULL) && {neg2 != NULL}).if {
        result := Expr_or.create position with (neg1.right) and (neg2.right)
      }
    } else {
      or ?= right
      (or != NULL).if {
        neg1 ?= or.left
        neg2 ?= or.right
        ((neg1 != NULL) && {neg2 != NULL}).if {
          result := Expr_and.create position with (neg1.right) and (neg2.right)
        }
      } else {
        neg1 ?= right
        (neg1 != NULL).if {
          result := neg1.right
        }
      }
    }
    result
  )

  - exec_right right_cst:Int_cst :Expr <-
  //-- ~ C1 -> C2
  ( + result:Expr
    (right_cst.is_signed).if {      
      right_cst.set_value (~ right_cst.value)
      result := right_cst
    }
    result
  )








