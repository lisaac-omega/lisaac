Header
  + name := Expr_neg
/*Negatif unary arithmetic expression.*/
Inherit

  + parent_expr_unary:Flat Expr_unary

Public

  - symbol:Char <- '-'

  //
  // Execute.
  //

  - exec_conservator:Expr <-
  //-- - - E -> E
  ( + sub:Expr_neg
    + result:Expr

    sub ?= right
    (sub != NULL).if {
      result := sub.right
    }
    result
  )

  - exec_right right_cst:Int_cst :Expr <-
  //-- - C1 -> C2
  ( + result:Expr
    (right_cst.is_signed).if {
      right_cst.set_value (- right_cst.value)
      result := right_cst
    }
    result
  )




