Header
  + name := Expr_add
/*Add Binary Expression.*/
Inherit

  + parent_expr_binary:Flat Expr_binary

Public

  + symbol:String_alias := "+"

  //
  // Execute.
  //

  - exec_conservator_left  left_cst :Int_cst :Expr <-
  //-- 0 + E -> E
  ( + result:Expr

    (left_cst.value = 0).if {
      result := right
      left_cst.remove
    }
    result
  )

  - exec_conservator_right right_cst:Int_cst :Expr <-
  //-- E + 0 -> E
  ( + result:Expr

    (right_cst.value = 0).if {
      result := left
      right_cst.remove
    }
    result
  )

  - exec left_cst:Int_cst and right_cst:Int_cst :Expr <-
  //-- C1 + C2 -> C3
  (
    left_cst.set_value (left_cst.value + right_cst.value)
    right_cst.remove
    left_cst
  )













