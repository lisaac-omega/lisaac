Header
  + name := Expr_or_logic
/*Or binary logical expression.*/
Inherit

  + parent_expr_binary_logic:Flat Expr_binary_logic

Public

  + symbol:String_alias := "|"

  //
  // Execute.
  //

  - exec_conservator_left  left_cst :Type :Expr <-
  //-- False | E -> E
  ( + result:Expr

    (left_cst = type_false).if {
      result := right
      left.remove
    }
    result
  )

  - exec_conservator_right right_cst:Type :Expr <-
  //-- E | False -> E
  ( + result:Expr

    (right_cst = type_false).if {
      result := left
      right.remove
    }
    result
  )

  - exec left_cst:Type and right_cst:Type :Expr <-
  //-- C1 | C2 -> C3
  ( + result:Expr

    (left_cst = type_true).if {
      result := left
      right.remove
    } else {
      result := right
      left.remove
    }
    result
  )

  - exec:Expr <-
  //-- (E1 > E2) | (E1 = E2) -> E1 >= E2 (a lot of possibilities, but see Int)
  //-- E | E -> E
  ( + result:Expr
    + sup:Expr_sup
    + eq:Expr_equal

    (left ~= right).if {
      result := left
      right.remove
    } else {
      sup ?= left
      eq  ?= right
      ((sup != NULL) && {eq != NULL}).if {
        ((sup.left ~= eq.left) && {sup.right ~= eq.right}).if {
          result := Expr_sup_eq.create position with (sup.left) and (sup.right)
          right.remove
        }
      }
    }
    result
  )

  - exec_left  left_cst :Type :Expr <-
  //-- True | E -> True
  ( + result:Expr

    (left_cst = type_true).if {
      result := left
      right.remove
    }
    result
  )

  - exec_right right_cst:Type :Expr <-
  //-- E | True -> True
  ( + result:Expr

    (right_cst = type_true).if {
      result := right
      left.remove
    }
    result
  )








