Header
  + name := Expr_not_logic
/*Unary not logical expression.*/
Inherit

  + parent_expr_unary_logic:Flat Expr_unary_logic

Public

  - symbol:Char <- '!'

  //
  // Execute.
  //

  - exec_conservator:Expr <-
  //-- ! (E1 == E2) -> E1 != E2   (see Int)
  //-- ! (E1 >= E2) -> E1 <  E2   (see Int)
  //-- ! (E1 >  E2) -> E1 <= E2   (see Int)
  //-- ! ! E -> E
  ( + eq:Expr_equal
    + sup_eq:Expr_sup_eq
    + sup:Expr_sup
    + not:Expr_not_logic
    + result:Expr

    not ?= right
    (not != NULL).if {
      result := not.right
    }.elseif {
      eq ?= right
      eq != NULL
    } then {
      result := Expr_not_equal.create position with (eq.left) and (eq.right)
    }.elseif {
      sup_eq ?= right
      sup_eq != NULL
    } then {
      result := Expr_inf.create position with (sup_eq.left) and (sup_eq.right)
    }.elseif {
      sup ?= right
      sup != NULL
    } then {
      result := Expr_inf_eq.create position with (sup.left) and (sup.right)
    }
    result
  )

  - exec_right right_cst:Type :Expr <-
  // ! True  -> False
  // ! False -> True
  ( + pro:Prototype_cst

    pro ?= right
    (right_cst = type_true).if {
      pro.make (pro.position) type (type_false.default)
    } else {
      pro.make (pro.position) type (type_true.default)
    }
    right
  )










