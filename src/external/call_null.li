Header
  + name := Call_null
/*Call on NULL*/
Inherit

  + parent_instr:Flat Instr

Public

  - my_copy:Self <- self

  - is_necessary:Boolean

  //
  // Remove
  //

  - remove; // Nothing.

  //
  // Execute
  //

  - execute:Instr <-
  (
    Push.break
    self
  )

  //
  // Genere.
  //

  - genere <-
  ( + code:String_alias
    (debug_level_option != 0).if {
      code :=
      "lisaac_stack_print(0); \
      \print_string(\"Call on NULL\\n\"); \
      \die_with_code(1)"
    } else {
      code :=
      "print_string(\"Call on NULL\\n\
      \(Do not use `-boost' option for print stack trace)\\n\"); \
      \die_with_code(1)"
    }
    output.append code
    is_necessary := True
  )

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.append "Call on NULL"
  )









