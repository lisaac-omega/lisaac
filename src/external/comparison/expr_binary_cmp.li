Header
  + name := Expr_binary_cmp
/*Binary comparison expression.*/
Inherit

  + parent_expr:Flat Expr

Public

  - is_invariant:Boolean <- left.is_invariant && {right.is_invariant}

  - is_pure:Boolean <- left.is_pure && {right.is_pure}

  - is_reading v:Variable :Boolean <- left.is_reading v || {right.is_reading v}

  + left:Expr

  + right:Expr

  - set_left l:Expr and_right r:Expr <-
  (
    left  := l
    right := r
  )

  - symbol:String_alias <-
  (
    abstract
    NULL
  )

  - static_type:Type_full <- type_boolean.default

  - get_type t:Types_tmp <-
  (
    t.add type_true
    t.add type_false
  )

  //
  // Creation.
  //

  - create p:Position with l:Expr and r:Expr :Self <-
  ( + result:Self


    ((symbol == "==") || {symbol == "!="}).if {
      (is_executing_pass).if_false {
        count_equal_live := count_equal_live + 1
      }
      count_equal_creat := count_equal_creat + 1
    }
    result := clone
    result.make p with l and r
    result
  )

  - make p:Position with l:Expr and r:Expr <-
  (
    position := p
    left     := l
    right    := r
  )

  - my_copy:Self <- Self.create position with (left.my_copy) and (right.my_copy)

  //
  // Comparaison.
  //

  - self:Self '~=' Right 60 other:Expr :Boolean <-
  ( + same:Self

    same ?= other
    (same != NULL) && {left ~= same.left} && {right ~= same.right}
  )

  //
  // Remove
  //

  - remove <-
  (
    left .remove
    right.remove

    ((symbol == "==") || {symbol == "!="}).if {
      count_equal_remov := count_equal_remov + 1
    }
  )

  - is_flat_with_null:Boolean <-
  // One side is @NULL and the other an expanded value (not a @Pointer, which may be
  // @NULL): never equal. On the left too: `s = 1' with @s known to be @NULL.
  ( + l,r:Prototype_cst
    + result:Boolean
    l ?= left
    r ?= right
    result := (r != NULL) && {r.static_type.raw = Type_null} && {left.static_type.is_flat} && {left.static_type.raw != type_pointer}
    (result).if_false {
      result := (l != NULL) && {l.static_type.raw = Type_null} && {right.static_type.is_flat} && {right.static_type.raw != type_pointer}
    }
    result
  )

  //
  // Execute
  //

  - execute_unlink:Instr <-
  ( + instr:Instr
    instr  := left.execute_unlink
    (instr != NULL).if {
      list_current.insert_before instr
    }

    ((symbol == "==") || {symbol == "!="}).if {
      count_equal_remov := count_equal_remov + 1
    }

    right.execute_unlink
  )

  - execute_link:Expr <-
  ( + result:Expr
    + old_seq:Uint32
    + left_cst,right_cst:Int_cst

    old_seq := seq_call_and_loop
    left  := left .execute_link
    right := right.execute_link
    //
    left_cst  ?= left
    right_cst ?= right
    // Conservator transformation.
    result := exec_conservator
    ((result = NULL) && {left_cst != NULL}).if {
      result := exec_conservator_left left_cst
    }
    ((result = NULL) && {right_cst != NULL}).if {
      result := exec_conservator_right right_cst
    }
    (
      (result = NULL) && {right_cst != NULL} && {left_cst  != NULL}
    ).if {
      result := exec left_cst and right_cst
    }
    ((result = NULL) && {old_seq = seq_call_and_loop}).if {
      // No conservator transformation.
      result := exec
      ((result = NULL) && {left_cst != NULL}).if {
        result := exec_left left_cst
      }
      ((result = NULL) && {right_cst != NULL}).if {
        result := exec_right right_cst
      }
    }
    //
    (result = NULL).if {
      result := self
    } else {
      result.set_position position
      new_execute_pass
    }

    result
  )

  - exec_conservator:Expr <- NULL
  - exec_conservator_left  left_cst :Int_cst :Expr <- NULL

  - is_size e:Expr :Boolean <-
  // @e is the size of a struct, maybe through a @Cast: never 0,
  // the compiler never generates an empty struct (see @Type.genere_struct).
  ( + so:Size_of
    + ca:Cast
    + t:Type
    + result:Boolean

    so ?= e
    ca ?= e
    (so != NULL).if {
      t := so.receiver.raw
      result := (t.type_c = NULL) && {t.prototype.name != str_n_a} && {t.prototype.name != str_n_a_v}
    }.elseif {ca != NULL} then {
      result := is_size (ca.value)
    }
    result
  )

  - is_non_zero_size e:Expr :Boolean <-
  // @e is a size (see @is_size), or a variable only written with sizes.
  ( + rd:Read
    + var:Variable
    + result:Boolean

    rd ?= e
    ((rd != NULL) && {rd.variable.require_first != NULL}).if {
      var := rd.variable
      result := is_size (var.require_first.value)
      ((result) && {var.require_list != NULL}).if {
        (var.require_list.lower).to (var.require_list.upper) do { j:Int
          result := result && {is_size (var.require_list.at j.value)}
        }
      }
    } else {
      result := is_size e
    }
    result
  )

  - exec_size left_cst:Int_cst with e:Expr is_equal eq:Boolean :Expr <-
  //-- 0 == sizeof(struct) -> False
  //-- 0 != sizeof(struct) -> True
  //-- 0 == E % 2^n -> 0 == (E & (2^n - 1)), and with != (true with a negative E too)
  ( + result:Expr
    + mod:Expr_mod
    + c:Int_cst

    (left_cst.value = 0).if {
      mod ?= e
      (is_non_zero_size e).if {
        (eq).if {
          result := Prototype_cst.create position type (type_false.default)
        } else {
          result := Prototype_cst.create position type (type_true.default)
        }
        left_cst.remove
        e.remove
      }.elseif {mod != NULL} then {
        c ?= mod.right
        ((c != NULL) && {c.value > 0} && {c.to_power != -1}).if {
          c.set_value (c.value - 1)
          result := Self.create position with left_cst and (Expr_and.create (mod.position) with (mod.left) and c)
        }
      }
    }
    result
  )
  - exec_conservator_right right_cst:Int_cst :Expr <- NULL

  - exec left_cst:Int_cst and right_cst:Int_cst :Expr <- NULL

  - exec:Expr <- NULL
  - exec_left  left_cst :Int_cst :Expr <- NULL
  - exec_right right_cst:Int_cst :Expr <- NULL

  //
  // Genere.
  //

  - genere <-
  (
    output.add_last '('
    (
      (left.static_type.raw = type_pointer) &&
      {is_integer (right.static_type.raw.name)}
    ).if {
      output.append "(uintptr_t)"
    }.elseif {! left.static_type.is_flat} then {
      output.append "(void *)"; // BSBS: A virer quand tu auras optim '=='
    }
    ((left.static_type.raw = Type_null) && {right.static_type.raw.is_block}).if {
      output.add_last '0'
    } else {
      (left.static_type.raw.is_block).if {
        output.append "(intptr_t)"
      }
      left.genere
      (left.static_type.raw.is_block).if {
        output.append ".__id"
      }
    }
    output.add_last ' '
    output.append symbol
    output.add_last ' '

    (
      (is_integer (left.static_type.raw.name)) &&
      {right.static_type.raw = type_pointer}
    ).if {
      output.append "(uintptr_t)"
    }.elseif {! right.static_type.is_flat} then {
      output.append "(void *)"; // BSBS: A virer quand tu auras optim '=='
    }
    ((right.static_type.raw = Type_null) && {left.static_type.raw.is_block}).if {
      output.add_last '0'
    } else {
      right.genere
      (right.static_type.raw.is_block).if {
        output.append ".__id"
      }
    }
    output.add_last ')'
  )
  
  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.add_last '('
    left.static_type.append_name_in buffer
    buffer.add_last ' '
    left.display buffer
    buffer.append symbol
    right.display buffer
    buffer.add_last ')'
  )









