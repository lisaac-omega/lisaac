Header
  + name := Size_of
/*Size of object*/
Inherit

  + parent_expr:Flat Expr

Public

  - is_invariant:Boolean <- True

  + receiver:Type_full

  - static_type:Type_full <- type_integer.default

  - get_type t:Types_tmp <-
  (
    t.add type_integer
  )

  //
  // Creation.
  //

  - create p:Position receiver e:Type_full :Self <-
  ( + result:Self

    result := clone
    result.make p receiver e
    result
  )

  - make p:Position receiver e:Type_full <-
  (
    position := p
    receiver := e
  )

  - my_copy:Self <- Self.create position receiver receiver
  // BSBS: Tu peux meme juste renvoyer self! Non ?

  //
  // Remove
  //

  - remove <-
  (
    // Nothing.
  )

  //
  // Execute
  //

  - execute_unlink:Instr <-
  (
    NULL
  )

  - execute_link:Expr <-
  (
    self
  )

  //
  // Genere.
  //

  - genere <-
  (
    output.append "sizeof("
    receiver.raw.put_flat_declaration output
    output.add_last ')'
  )

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.append "size_of("
    receiver.display buffer
    buffer.add_last ')'
  )









