Header
  + name := Build_label
Inherit
  
  - parent_any:Any := Any
  
Public
  
  - line:String_buffer := String_buffer.create 256
  
  - output_file:Pointer
  - input_file:Pointer
  
  - label_set:Hset String := 
  ( + result:Hset String
    result := Hset String.create
    result.fast_add "-1"
    result.fast_add "-2"
    result
  )

  - get str:String :String_alias <-
  ( + result:String_alias
    + tmp:String
    ? {str != NULL}
    ? {label_set != NULL}

    tmp := label_set.reference_at str
    (tmp = NULL).if {
      result := str.to_string_alias
      label_set.fast_add result
    } else {
      result ?= tmp
    }
    ? {result == str}
    result
  )
  
  - convert_dico:Hmap String_alias Key String_alias := new Hmap String_alias Key String_alias
  // One dictionary for One redondance
  
  - first_copy:String_alias
  // Key for a end redondance or NULL. (= label_back from first redondance)
  
  - mountain:Array String := Array String .create_with_capacity 16384
  
  - parse_line <-
  ( + idx:Int
    + label,label_back,new_label,pos:String_alias
    + is_inline:Boolean
    - fight_counter:Int
    - nline:Int
    - count_method,sub_count_method:Int
    - is_method:Boolean
    nline := nline + 1
    idx := line.first_substring_index "	.size"
    ((idx != 0) && {is_method}).if {
      string_tmp.copy "method_"
      count_method.append_in string_tmp
      string_tmp.append "_end:\n"
      line.append string_tmp
      //
      count_method := count_method + 1
      sub_count_method := 0
      is_method := False
    }
    (line.first_index_of '\"' != 0).if {
      idx := 0
    } else {
      idx := line.first_substring_index "@LI "
    }
    (idx != 0).if {      
      (line.at (idx+4) != 'm').if {
        // Position
        idx := idx + 4
        string_tmp.clear
        {line.at idx != ','}.while_do {
          string_tmp.add_last (line.at idx)
          idx := idx + 1
        }
        pos := get string_tmp
        // Label
        idx := idx + 1
        string_tmp.clear
        {line.at idx != ','}.while_do {
          string_tmp.add_last (line.at idx)
          idx := idx + 1
        }
        label ?= label_set.reference_at string_tmp
        (label = NULL).if {        
          label := get string_tmp
        } else {
          is_inline := True
        }
        // label_back
        idx := idx + 1
        string_tmp.clear
        {line.at idx != '\n'}.while_do {
          string_tmp.add_last (line.at idx)
          idx := idx + 1
        }
        label_back := get string_tmp
        //              
        (is_inline).if {
          //"Inline #".print; nline.print; '\n'.print
          // Begin inline:
          (convert_dico.is_empty).if {
            first_copy := label_back
          }
          // Current inline:
          // DCDC
          //new_label := convert_dico.fast_reference_at label
          new_label := convert_dico.reference_at label
          (new_label = NULL).if {            
            string_tmp.copy label
            string_tmp.add_last '_'
            fight_counter.append_in string_tmp
            fight_counter := fight_counter + 1
            new_label := get string_tmp
            convert_dico.at label add new_label
            label := new_label
          } else {
            label := new_label
          }
          // DCDC
          //new_label := convert_dico.fast_reference_at label_back
          new_label := convert_dico.reference_at label_back
          (new_label = NULL).if {
            ((label_back.first != '-') && {label_back != first_copy}).if {
              "error\n".print
            }
          } else {
            label_back := new_label
          }
          // End inline:
          ((first_copy = label_back) || {label_back.first = '-'}).if {
            convert_dico.clear
          }
        }
                
        line.copy label
        line.append ":\n"
      } else {
        string_tmp.copy "method_"
        count_method.append_in string_tmp
        string_tmp.add_last '_'
        sub_count_method.append_in string_tmp
        line.copy string_tmp
        line.append ":\n"
        string_tmp.append "-1"
        label := get string_tmp
        //
        string_tmp.copy "method_"
        count_method.append_in string_tmp
        string_tmp.append "_end"
        pos := get string_tmp
        label_back := "-3"
        is_method := True
        sub_count_method := sub_count_method + 1
      }
      //
      mountain.add_last label
      mountain.add_last pos
      mountain.add_last label_back
    }
  )
  
  - on n:String <-
  ( + j:Int
    "Build label...\n".print
    // Open
    input_file := File_utils.open_read n
    (input_file = NULL).if {
      Stderr.put_string "Error: File is not opened !\n"
      exit exit_failure_code
    }
    string_tmp.copy n
    string_tmp.remove_tail 2
    string_tmp.append "_label.s"
    output_file := File_utils.open_write string_tmp
    (output_file.is_null).if {
      Stderr.put_string "Error: File is not created !\n"
      exit exit_failure_code
    }
    // Read / Write
    {File_utils.read_line input_file in line}.while_do {
      parse_line
      File_utils.write output_file with line size (line.count)
    }
    //
    
    line.copy
    "        .section .data\n\
    \__li_mountain:\n\
    \# Header: <@fin,count table,-1>\n\
    \        .quad _fini,\t"
    (mountain.count+3).append_in line
    line.append ",\t-1\n\
    \# Table mountain: <@current,code position,backlink index>\n"
    //
    from (mountain.lower) to (mountain.upper) step 3 do { i:Int
      ((mountain.at (i+2).first = '-') && {mountain.at (i+2).last = '3'}).if {
        line.add_last '\n'
      }
      line.append "        .quad "
      line.append (mountain.at i)
      line.append ",\t"
      line.append (mountain.at (i+1))
      line.append ",\t"
      (mountain.at (i+2).first != '-').if {         
        j := 0
        {(j <= mountain.upper) && {mountain.at j !== mountain.at (i+2)}}.while_do { j := j+3; }
        (j+3).append_in line
      } else {
        line.append (mountain.at (i+2))
      }
      
      line.append "\t /* index:"
      ((i+3)/3).to_int.append_in line
      (mountain.at (i+2).first != '-').if {
        line.append " back:"
        line.append (mountain.at (i+2))
        line.append " "
        ((j+3) / 3).append_in line
      }
      line.append " */"
      
      line.add_last '\n'
    }
        
    File_utils.write output_file with line size (line.count)
           
    // Close
    File_utils.close input_file
    File_utils.close output_file
  )
