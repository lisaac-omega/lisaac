Header
  + name := Profil_list
/*Profil list manager.*/
Inherit

  + parent_any:Flat Any

Lisaac

  - profil_list:Array Profil := Array Profil .create_with_capacity 65536

  - life_limit:Int

  - life_limit_base:Int

  - current:Int

  - swap i1:Int with i2:Int <-
  (
    profil_list.at i2.set_life_index i1
    profil_list.at i1.set_life_index i2
    profil_list.swap i1 with i2
  )

  - clean <-
  (
    reduce_profil := profil_list.upper >= life_limit
    {profil_list.upper >= life_limit}.while_do {
      profil_list.last.remove
      profil_list.remove_last
    }
  )

Public

  - reduce_profil:Boolean := True

  - add p:Profil <-
  (
    (p.is_external).if {
      profil_list.add_first p
      life_limit_base := life_limit_base + 1
      p.set_life_index (profil_list.lower)
      (profil_list.lower+1).to (profil_list.upper) do { i:Int
        profil_list.at i.set_life_index i
      }
    } else {
      profil_list.add_last p
      p.set_life_index (profil_list.upper)
    }
  )

  - set_life p:Profil <-
  [
    -? { p.life_index != -1 }
    -? { profil_list.at (p.life_index) = p }
  ]
  ( + idx:Int
    
    ((p.life_index > profil_list.upper) || {profil_list.at (p.life_index) != p}).if {
      warning_error (p.position,"PROFIL_LIST.set_life")
      p.life_index.print; '\n'.print
    }
    
    idx := p.life_index
    (idx = life_limit).if {
      life_limit := life_limit + 1
    }.elseif {idx > life_limit} then {
      swap idx with life_limit
      life_limit := life_limit + 1
    }
  )
  [
    +? { profil_list.at (p.life_index) = p }
    +? { p.life_index < life_limit }
  ]

  - unset_life p:Profil <-
  [
    -? { p.life_index != -1 }
  ]
  ( + idx:Int

    idx := p.life_index
    (idx < life_limit).if {
      life_limit := life_limit - 1
      (idx < life_limit).if {
        (idx > current).if {
          swap idx with life_limit
        } else {
          swap idx with current
          swap current with life_limit
          current := current - 1
        }
      }
    }
  )

  - remove p:Profil <-
  [
    -? { p.life_index != -1 }
  ]
  ( + idx:Int

    unset_life p
    idx := p.life_index
    (idx != profil_list.upper).if {
      swap idx with (profil_list.upper)
    }
    profil_list.remove_last
    // Debug.
    ! {p.set_life_index (-1)}
  )

  - execute_pass_recursive <-
  (
    (profil_list.lower).to (profil_list.upper) do { i:Int
      profil_list.at i.reset_recursive
    }
    Variable.update
    life_limit := life_limit_base
    Profil.set_mode_recursive True
    profil_current := profil_slot := NULL
    list_current   := NULL
    Position.clean_context
    
    list_main.execute
    
    //
    current := profil_list.lower
    {current < life_limit}.while_do {
      profil_current := profil_list.at current
      (profil_current.is_external).if {        
        profil_current.execute inline_level_current
      }
      current := current + 1
    }
    //
    Profil.set_mode_recursive False
    //current := 0
    clean
    reduce_profil := True
  )

  - inline_level_current:Int := 3

  - execute_pass <-
  (
    Variable.update
    life_limit := life_limit_base
    profil_slot := NULL
    list_current   := NULL
    list_main.execute
    current := profil_list.lower
    {current < life_limit}.while_do {
      profil_current := profil_list.at current
      profil_current.execute inline_level_current
      current := current + 1
    }
    current := 0
    clean
    ((! reduce_profil) && {inline_level_current < inline_level}).if {
      inline_level_current := inline_level_current + 3
      new_execute_pass
    }
    (Type.is_alias_struct).if {
      Type.detect_alias
      Type_generic.detect_alias
    }
  )

  //
  // Genere.
  //

  - genere_handler <-
  (
    (profil_list.lower).to (profil_list.upper) do { j:Int
      profil_list.at j.genere_handler
    }
  )

  - genere <-
  ( 
    (profil_list.lower).to (profil_list.upper) do { j:Int      
      output_list.foreach { s:String_buffer; (s.upper < output.upper).if { output := s } }        
      profil_list.at j.genere
    }
  )
    
  //
  // Display.
  //

  - display <-
  (
    string_tmp.clear
    list_main.display string_tmp
    string_tmp.append "\n------ FUNCTIONS ------\n"
    (profil_list.upper).downto (profil_list.lower) do { j:Int
      profil_list.at j.display_all string_tmp
    }
    string_tmp.print
  )
