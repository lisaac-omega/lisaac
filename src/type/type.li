Header
  + name := Type
/*Type without style*/
Inherit
  + parent_any:Flat Any

  - parent_parameter_to_type:Flat Parameter_to_type
  
  - parent_types:Types := Types
  
Profil_list
  
  - is_alias_struct:Boolean := True

Private

  - dico_type:Hmap Type Key String_alias := new Hmap Type Key String_alias
  
Types  
  
  - index_max:Int
  
//  - type_list:ARRAY TYPE := ARRAY TYPE .create_with_capacity 256; // Linear representation of all types. (index corresponding)

Public
  
  //
  // Begin TYPES
  //
  
  /* Pas d'inpact...
  + types_with_null:TYPES_SET
  - set_types_with_null t:TYPES_SET <-
  (
    types_with_null := t
  )
  */
  
  - first_index:Int <- 0
  - count:Int <- 1
  - next_index i:Int :Int <- -1
  - first:Type <- self
  - at i:Int :Type <- self
  
  - types_append_in buf:String_buffer <-
  (
    append_name_in buf
    buf.add_last '('
    index.append_in buf
    buf.add_last ')'
  )
  
  //
  // End TYPES
  //
  
  - switch_global:Array Switch := Array Switch .create_with_capacity 256
  - add_switch_global sw:Switch <-
  (
    switch_global.add_last sw
  )

  + switch_list:Array Switch

  + id:Int := -1

  - add_switch_list sw:Switch <-
  (
    (switch_list = NULL).if {
      switch_list := Array Switch.create_with_capacity 16
    }
    switch_list.add_last sw
  )

  + param_count:Int

  - set_param n:Int <-
  (
    param_count := param_count.max n
  )

  + subtype_list:Hset Type

  + default:Type_full

  + size:Int
  
  - position:Position <- prototype.position

  - parameter_to_type p:Itm_type_parameter :Type_full <-
  (
    NULL
  )

  //
  //
  //

  + last_pass_binding:Int

  - is_late_binding:Boolean <- pass_count = last_pass_binding

  - set_late_binding <-
  (
    last_pass_binding := pass_count
  )

  //
  //
  //

  + itm_type:Itm_type_simple

  + prototype:Prototype
  
  - pattern_in :Itm_list <- prototype.pattern_in
  - pattern_out:Itm_list <- prototype.pattern_out

  - type_c:String_alias <- prototype.type_c

  + slot_run:Array Slot

  + index:Int

  + intern_name:String_alias

  - name:String_alias <- prototype.name

  - hash_code:Int <- intern_name.hash_code

  - key:String_alias <- prototype.filename

  //
  // Get.
  //

  - get (path:String_alias,itm_typ:Itm_type_simple) :Type_full <-
  ( + result:Type_full
    + base:Type
    + styl:Uint8
    + proto:Prototype
    + r:Type

    proto := load_prototype (path,itm_typ.name) generic_count 0
  //base := dico_type.reference_at (proto.filename)
    base := dico_type.search (proto.filename) raw
    (base = NULL).if {
      base := Type.clone
      
      //dico_type.fast_put base to (proto.filename)
      dico_type.at (proto.filename) put base 
      
      base.make itm_typ with proto
    }
    //
    styl := itm_typ.style
    (styl = 0).if {
      result := base.default
    } else {
      result := base.default + styl
    }

    r := result.the_parent_type
    result
  )
  
  - self:Self '==' Right 60 other:E :Boolean <- self = other
  
  //
  // Contract
  //

  - last_type_contract:Type

  - search_require n:String_alias :Itm_slot <-
  ( + j:Int
    + result:Itm_slot
    + typ:Type
    + ts:Itm_type_simple

    j := slot_run.lower
    {
      (j <= slot_run.upper) &&
      {slot_run.at j.id_section.is_inherit_or_insert} &&
      {result = NULL}
    }.while_do {
      ts  ?= slot_run.at j.result_type
      typ := ts.to_run_for self pos (slot_run.at j.position.prototype.filename).raw
    //result := typ.prototype.slot_list.reference_at n
      result := typ.prototype.slot_list.search n raw
      ((result = NULL) || {result.pattern_in = NULL}).if {
        result := typ.search_require n
      } else {
        last_type_contract := typ
      }
      j := j + 1
    }
    result
  )

  - search_ensure n:String_alias :Itm_slot <-
  ( + j:Int
    + result:Itm_slot
    + typ:Type
    + ts:Itm_type_simple

    j := slot_run.lower
    {
      (j <= slot_run.upper) &&
      {slot_run.at j.id_section.is_inherit_or_insert} &&
      {result = NULL}
    }.while_do {
      ts     ?= slot_run.at j.result_type
      typ    := ts.to_run_for self pos (slot_run.at j.position.prototype.filename).raw
    //result := typ.prototype.slot_list.reference_at n
      result := typ.prototype.slot_list.search n raw
      ((result = NULL) || {result.pattern_out = NULL}).if {
        result := typ.search_ensure n
      } else {
        last_type_contract := typ
      }
      j := j + 1
    }
    result
  )

  //
  // Searching.
  //

  - add_subtype t:Type <-
  ( + j:Int
    + it:Itm_type_mono

    (! subtype_list.fast_has t).if {
      subtype_list.fast_add t
      j := slot_run.lower
      {
        (j <= slot_run.upper) && {slot_run.at j.id_section.is_inherit_or_insert}
      }.while_do {
        (slot_run.at j.id_section.is_inherit).if {
          it ?= slot_run.at j.result_type
          it.to_run_for self pos (slot_run.at j.position.prototype.filename).raw.add_subtype t
        }
        j := j + 1
      }
    }
  )

  - get_slot n:String_alias :Slot <-
  // Static lookup algorithm.
  ( + result:Slot
    + j:Int
    + it:Itm_type_mono
    
    result := get_local_slot n
    (result = NULL).if {
      j := slot_run.lower
      {
        (j <= slot_run.upper) &&
        {slot_run.at j.id_section.is_inherit_or_insert} &&
        {result = NULL}
      }.while_do {        
        it ?= slot_run.at j.result_type
        result := it.to_run_for self pos (slot_run.at j.position.prototype.filename).get_slot n
        j := j + 1
      }
    }
    result
  )

  - get_local_slot n:String_alias :Slot <-
  ( + j:Int
    + itm_slot:Itm_slot
    + result:Slot

    j := slot_run.lower
    {(j <= slot_run.upper) && {slot_run.at j.name != n}}.while_do {
      j := j + 1
    }
    (j <= slot_run.upper).if {
      result := slot_run.at j
    } else {
      /*
      (n == "__init_page").if {
        "TYPE: get_slot_local : ".print
        prototype.filename.print; ' '.print; prototype.print
        '\n'.print
      }
      */
    //itm_slot := prototype.slot_list.reference_at n
      itm_slot := prototype.slot_list.search n raw
      (itm_slot != NULL).if {
        verify_itm_slot_parent itm_slot
        result := Slot.create itm_slot type self
        slot_run.add_last result
      }
    }
    result
  )
  
  - get_itm_slot n:String_alias :Itm_slot <-
  ( + result:Itm_slot
    + j:Int
    + it:Itm_type_mono
    
  //result := prototype.slot_list.reference_at n
    result := prototype.slot_list.search n raw
    ((result = NULL) && {slot_run != NULL}).if {
      j := slot_run.lower
      {
        (j <= slot_run.upper) &&
        {slot_run.at j.id_section.is_inherit_or_insert} &&
        {result = NULL}
      }.while_do {        
        it ?= slot_run.at j.result_type
        result := it.to_run_for self pos (slot_run.at j.position.prototype.filename).get_itm_slot n
        j := j + 1
      }
    }

    result
  )

  - get_path_slot n:String_alias :Slot <-
  ( + result,r:Slot
    + j:Int
    + it:Itm_type_mono
    + t:Type_full

    j := slot_run.lower
    {
      (result = NULL) &&
      {j <= slot_run.upper} && /* BSBS NE doit jamais arriv*/
      {slot_run.at j.id_section.is_inherit_or_insert} /* BSBS NE doit jamais arriv*/
    }.while_do {
      it ?= slot_run.at j.result_type
      t := it.to_run_for self pos (slot_run.at j.position.prototype.filename)
      result := t.get_slot n
      j := j + 1
    }
    (result != NULL).if {
      r := slot_run.at (j-1)
    } else {
      "TYPE : ".print
      print
      ':'.print
      n.print
      '\n'.print
      crash
    }
    r
  )
  
  - get_type_creation:Type <-
  (
    Type_creation(Type).create_type_creation self    
  )
  
  //
  // Import / Export
  //

  - last_cast_name:String_buffer := String_buffer.create 32

  - is_export_to t:Type_full :Boolean <-
  (
    is_cast t with "to_" on (prototype.export_list)
  )

  - is_import_to t:Type_full :Boolean <-
  (
    is_cast t with "from_" on (prototype.import_list)
  )

Private

  - is_cast t:Type_full with msg:String_alias on lst:Itm_type :Boolean <-
  ( + result:Boolean
    + j:Int

    (lst != NULL).if {
      j := lst.lower
      {(j <= lst.upper) && {! (lst.at j.to_run_for profil_slot pos (prototype.filename)== t)}}.while_do {
        j := j + 1
      }
      (j <= lst.upper).if {
        result := True
        last_cast_name.copy msg
        lst.at j.append_cast_name_in last_cast_name
      }
    }
    result
  )

Public

  //
  // Genere.
  //

  - genere_list:Array Type := Array Type .create_with_capacity 128
  - genere_list_global:Array Slot_data := Array Slot_data .create_with_capacity 256

  - add_genere_list <-
  (
    ((slot_run != NULL) && {(slot_run.is_empty) || {slot_run.first != NULL}}).if {
      (genere_list.fast_first_index_of self > genere_list.upper).if { // BSBS: a revoir !!
        genere_list.add_last self
      }
    }
  )

  - add_genere_global s:Slot_data <-
  (
    (genere_list_global.fast_first_index_of s > genere_list_global.upper).if { // BSBS: a revoir !!
      genere_list_global.add_last s
    }
  )

Public
/*
  - stat_global:ARRAY Int := ARRAY Int .create 128
  - stat_global_null:ARRAY Int := ARRAY Int .create 128
  - stat_slot:ARRAY Int := ARRAY Int .create 128
  - stat_slot_null:ARRAY Int := ARRAY Int .create 128
  */

  - genere_id_family <-
  ( + sw:Switch
    + case:Case
    + j,i:Int
    (switch_list != NULL).if {
      id := 0
      j := switch_list.lower
      {j <= switch_list.upper}.while_do {
        sw := switch_list.at j
        i := sw.list.lower
        {i <= sw.list.upper}.while_do {
          case := sw.list.at i
          ((case.id != self) && {case.id.id = id}).if {
            id := id + 1
            j := switch_list.lower - 1
            i := sw.list.upper
          }
          i := i + 1
        }
        j := j + 1
      }
    }
  )
  
  - genere_id <-
  ( 
    (genere_list.lower).to (genere_list.upper) do { j:Int
      genere_list.at j.genere_id_family
    }
  )
    
  - genere_all_struct <-
  ( + sd:Slot_data
    Type_null.genere_typedef
    genere_id
    (genere_list.lower).to (genere_list.upper) do { j:Int
      genere_list.at j.genere_typedef_struct
    }
    Type_null.genere_struct
    (genere_list.lower).to (genere_list.upper) do { j:Int
      genere_list.at j.genere_struct
    }
    (debug_level_option != 0).if {
      Type_context.genere_typedef
      Type_context.genere_struct
    }
    (genere_list_global.lower).to (genere_list_global.upper) do { j:Int
      // In global.
      /*
      + s:SLOT_DATA
      + idx:Int
      s := genere_list_global.at j
      (s.type.is_flat).if {
        stat_global.put (stat_global.at 0 + 1) to 0
      } else {
        //(s.type.raw.subtype_list != NULL).if {
        //  idx := s.type.raw.subtype_list.count; //s.type_set.count
        //} else {
          idx := s.type_set.count
        //}
        stat_global.put (stat_global.at idx + 1) to idx
        (s.type_set.last = TYPE_MARK).if {
          stat_global_null.put (stat_global_null.at idx + 1) to idx
        }
      }
      */
      sd := genere_list_global.at j
      (output_list.count > 1).if {
        output_decl # "extern "
        sd.genere output_decl
      }
      sd.genere output_glob
    }
  )

  - id_counter_with_type:Int    := 4
  - id_counter_without_type:Int := 0

  - slot_size:Array (Array Slot_data) :=
  ( + result:Array (Array Slot_data)

    result := Array (Array Slot_data) .create_with_capacity 5
    0.to 4 do { j:Int
      result.add_last (Array Slot_data .create_with_capacity 8)
    }
    result
  )

  + detect_recursivity_generation:Boolean

  //
  // Detect Alias.
  //

  + alias_slot:Slot_data

  - alias_type:Type <- alias_slot.type.raw

  - detect_alias <-
  (
    dico_type.foreach_value { t:Type
      t.detect_alias_struct
    }
  )

  - detect_alias_struct <-
  [
    -? {is_alias_struct}
  ]
  ( + slot:Slot
    + i,nb:Int
    + action:{Slot_data; }

    (! is_late_binding).if {
      ((alias_slot = NULL) && {slot_run != NULL}).if {

        action := { s:Slot_data
          ((s.ensure_count > 0) || {s.id_section.is_mapping}).if {
            (nb = 0).if {
              ((s.type.is_flat) && {s.type.raw.type_c = NULL}).if {
                alias_slot := s
              }
            } else {
              alias_slot := NULL
            }
            nb := nb + 1
          }
        }

        i := slot_run.lower
        {(i <= slot_run.upper) && {nb < 2}}.while_do {
          slot := slot_run.at i
          ((slot.style = '+') && {slot.lower_style = 0}).if {
            (slot.slot_data_list != NULL).if {
              (slot.slot_data_list.lower).to (slot.slot_data_list.upper) do { k:Int
                action.value (slot.slot_data_list.at k)
              }
            }
            action.value (slot.slot_data)
          }
          i := i + 1
        }
      }
      ((alias_slot != NULL) && {alias_slot.ensure_count = 0}).if {
        alias_slot := NULL
      }
    }
  )

  - genere_struct <-
  ( + slot_data:Slot_data
    + slot:Slot
    + tab:Array Slot_data
    + action:{Slot_data; }
    + tg:Type_generic

    ((slot_run.is_empty) || {slot_run.first != NULL}).if {
      (detect_recursivity_generation).if {
        string_tmp.copy "Compiler limit: Cyclic depending structure definition for "
        append_name_in string_tmp
        string_tmp.add_last '.'
        semantic_error (position,string_tmp)
      }
      detect_recursivity_generation := True

      // Depending.
      (slot_run.lower).to (slot_run.upper) do { j:Int
        slot := slot_run.at j

        ((slot.style = '+') && {slot.lower_style = 0}).if {
          action := { s:Slot_data
            (
              (
                (s.ensure_count > 0) || {s.id_section.is_mapping}
              ) && {s.type.raw != self} && {
                (s.type.raw.is_block) ||
                {is_far_flat (s.type)} ||
                {s.type.raw.type_c != NULL}
              }
            ).if {
              s.type.raw.genere_struct
            }
          }
          (slot.slot_data_list != NULL).if {
            (slot.slot_data_list.lower).to (slot.slot_data_list.upper) do { k:Int
              action.value (slot.slot_data_list.at k)
            }
          }
          action.value (slot.slot_data)
        }
      }
      // Sort slot.
      (slot_run.lower).to (slot_run.upper) do { j:Int
        slot := slot_run.at j
        (slot.style = '+').if {
          // In struct.
          (slot.lower_style = 0).if {
            action := { s:Slot_data
              (
                (s.id_section.is_mapping) || {s.ensure_count > 0}
              ).if {
                add_slot_struct s
              }
            }
            (slot.slot_data_list != NULL).if {
              (slot.slot_data_list.lower).to (slot.slot_data_list.upper) do { k:Int
                action.value (slot.slot_data_list.at k)
              }
            }
            action.value (slot.slot_data)
          }
          slot_data := slot.slot_id
          ((slot_data != NULL) && {slot_data.ensure_count > 0}).if {
            add_slot_struct slot_data
          }
        }
      }

      (
        (prototype.name = str_n_a) || {prototype.name = str_n_a_v}
      ).if {        
        tg ?= self
        tg.generic_list.first.raw.genere_struct
      } else {
        (type_c != NULL).if {
          0.to 4 do { j:Int
            tab := slot_size.at j
            // BSBS: A tester sont utilité !
            (! tab.is_empty).if {
              semantic_error (tab.first.position,"Slot is not possible with a type C")
            }
          }

          
          ((name = str_true) || {name = str_false}).if {
            output_decl.append "#define "
            output_decl.append intern_name
            output_decl.append "__ "
            output_decl.add_last ((name = str_true).to_char)
            output_decl.add_last '\n'
          } else {
            genere_typedef_type_c
            (is_late_binding).if {
              semantic_error (position,"Late binding is not possible with a type C")
            }
          }

        } else {
          output_decl.append "/* "
          output_decl.append intern_name
          output_decl.append " */\n"
          output_decl.append "#define __"
          output_decl.append intern_name
          output_decl.append "__ "
          (is_statistic).if {
            intern_name.print
            (is_late_binding).if {
              " with id:".print
              id.print
              //id_counter_with_type.print
            } else {
              " without id.".print
            }
            '\n'.print
          }
          string_tmp.clear
          (is_late_binding).if {            
            //id_counter_with_type.append_in output_decl
            id.append_in output_decl
            id_counter_with_type := id_counter_with_type + 1
            string_tmp.append "  int __id;\n"
            (prototype.style = '-').if {
              semantic_error (position,"Late binding on '-' prototype is not yet implemented.")
            }
            (prototype.is_mapping).if {
              semantic_error (prototype.position,
              "Late binding is not possible with `mapping' object.");
            }
          } else {
            id_counter_without_type.append_in output_decl
            id_counter_without_type := id_counter_without_type + 1
          }
          output_decl.add_last '\n'
          ((is_cop) && {prototype.style = '-'}).if {
            string_tmp.append "  lith_object thread;\n"
            (param_count != 0).if {
              1.to param_count do { n:Int
                string_tmp.append "  int param_"
                (n-1).append_in string_tmp
                string_tmp.append ";\n"
              }
            }
          }
          4.downto 0 do { j:Int
            tab := slot_size.at j
            (tab.lower).to (tab.upper) do { i:Int
              slot_data := tab.at i
              ((prototype.is_mapping) && {slot_data.type.is_flat_c}).if {
                string_tmp.append "  volatile "
              } else {
                string_tmp.append "  "
              }
              slot_data.genere string_tmp
            }
            tab.clear
          }

          (self = type_block).if {
            string_tmp.append "  void *self;\n"
          }

          (string_tmp.is_empty).if {
            string_tmp.append "  void *Nothing;\n"
          }
          
          (alias_slot = NULL).if {
            (prototype.is_mapping).if {
              output_decl.append "#pragma pack(push,1)\n"
            }
            output_decl.append "struct "
            output_decl.append intern_name
            output_decl.append "_struct {\n"
            output_decl.append string_tmp
            (prototype.is_mapping).if {
              output_decl.append "} __attribute__ ((packed));\n\
              \#pragma pack(pop)\n"
            } else {
              output_decl.append "};\n"
            }
          }
          // Prototype declaration.
          (output_list.count > 1).if {
            output_decl # "extern __" # intern_name # ' ' # intern_name # "_;\n"
          }
          output_decl # "#define " # intern_name # "__ (&" # intern_name # "_)\n"
          //
          output_glob # "__" # intern_name # ' ' # intern_name # '_'
          (is_late_binding).if {
            output_glob # "={__" # intern_name # "__}"
          }
          output_glob # ";\n"
        }
      }

      // Flag on:
      slot_run.force NULL to 0
    }
  )

  - genere_typedef_type_c <-
  ( + tg:Type_generic
    (
      (prototype.name = str_n_a) || {prototype.name = str_n_a_v}
    ).if {
      tg ?= self
      tg.generic_list.first.raw.genere_typedef_type_c
    } else {
      output_decl.append "typedef "
      output_decl.append type_c
      output_decl.append " __"
      output_decl.append intern_name
      output_decl.add_last ';'
      output_decl.add_last '\n'
      (
        (!parse_type_c "char") && {!parse_type_c "short"} && {!parse_type_c "int"} &&
        {!parse_type_c "long"} && {!parse_type_c "float"} && {!parse_type_c "double"} &&
        {!parse_type_c "void"}
      ).if {
        //
        output_glob.append "__"
        output_glob.append intern_name
        output_glob.add_last ' '
        output_glob.append intern_name
        output_glob.add_last '_'
        output_glob.append ";\n"
        //
        output_decl.append "#define "
        output_decl.append intern_name
        output_decl.append "__ (&"
        output_decl.append intern_name
        output_decl.append "_)\n"
        output_decl.append "#define __"
        output_decl.append intern_name
        output_decl.append "__ "
        id_counter_without_type.append_in output_decl
        id_counter_without_type := id_counter_without_type + 1
        output_decl.append "\n\n"
      }
    }
  )

  - genere_typedef_struct <-
  ( + tg:Type_generic
    + t:Type

    ((prototype.name = str_n_a) || {prototype.name = str_n_a_v}).if {
      tg ?= self
      tg.generic_list.first.raw.genere_typedef_struct
    }.elseif {type_c = NULL} then {
      output_decl.append "typedef "
      t := self
      {t.alias_slot = NULL}.until_do {
        t := t.alias_type
      }
      output_decl.append "struct "
      output_decl.append (t.intern_name)
      output_decl.append "_struct"
      output_decl.append " __"
      output_decl.append intern_name
      output_decl.add_last ';'
      (alias_slot != NULL).if {
        output_decl.append " /* ALIAS with "
        output_decl.append (alias_type.intern_name)
        output_decl.append " */"
      }
      output_decl.add_last '\n'
    }
  )

Private

  - add_slot_struct s:Slot_data <-
  (/*
    + idx:Int
    (s.type.is_flat).if {
      stat_slot.put (stat_slot.at 0 + 1) to 0
    } else {
      //(s.type.raw.subtype_list != NULL).if {
      //  idx := s.type.raw.subtype_list.count; //s.type_set.count
      //} else {
        idx := s.type_set.count
      //}
      stat_slot.put (stat_slot.at idx + 1) to idx
      (s.type_set.last = TYPE_MARK).if {
        stat_slot_null.put (stat_slot_null.at idx + 1) to idx
      }
    }
*/
    (prototype.is_mapping).if {
      (s.id_section.is_mapping).if {
        slot_size.first.add_last s
      } else {
        semantic_error (s.position,"Slot is not in `Mapping' section.");
      }
    } else {
      ((s.type.is_flat) && {! s.type.is_default_flat}).if {
        slot_size.at 4.add_last s
      } else {
        slot_size.at (s.type.size).add_last s
      }
    }
  )

Public

  //
  // Declaration generation.
  //

  - put_reference_declaration buffer:String_buffer <-
  (
    buffer.append "__"
    buffer.append intern_name
    add_genere_list
  )

  - put_reference_star_declaration buffer:String_buffer <-
  (
    (is_block).if_false { // BSBS: A mettre dans TYPE_BLOCK
        buffer.add_last '*'
    }
  )

  - put_flat_declaration buffer:String_buffer <-
  (
//    (type_c != NULL).if {
//      buffer.append type_c
//    } else {
      buffer.append "__"
      ((name = str_false) || {name = str_true}).if {
        buffer.append (type_boolean.intern_name)
      } else {
        buffer.append intern_name
      }
//    }
    add_genere_list
  )

  - put_generic_declaration buffer:String_buffer <-
  (
    (is_block).if { // BSBS: A mettre dans TYPE_BLOCK
      put_flat_declaration buffer
    } else {      
      buffer.append "void"
    }
  )

  //
  // Code source generation.
  //

  - put_id buffer:String_buffer <-
  (
    buffer.append "__"
    buffer.append intern_name
    buffer.append "__"
  )

  - put_access_id e:Expr <-
  // For switch.
  ( + t:Type

    t := e.static_type.raw
    (t = type_boolean).if {
      e.genere
    }.elseif {t = type_block} then {
      e.genere
      //output.append ".__id"
    } else {      
      output.append "((struct ___OBJ *)"
      e.genere
      output.append ")->__id"
      
    }
  )

  - put_value buffer:String_buffer <-
  (
    buffer.append intern_name
    buffer.append "__"
    add_genere_list
  )

  //
  // Display.
  //
  
  - append_contract_name_in buf:String_buffer <-
  ( + n:String_alias
    n := name
    (n.lower).to (n.upper) do { j:Int
      buf.add_last (n.at j.to_lower)
    }
  )
  
  - append_name_in buf:String_buffer <-
  (
    buf.append name
  )

  - print <-
  (
    string_tmp.clear
    append_name_in string_tmp
    string_tmp.print
  )

Public

  - is_block:Boolean := False

  - self:Self '~=' Right 60 other:Type :Boolean <- (self = other)

  - is_sub_type other:Type :Boolean <-
  ( + result:Boolean

    (self = other).if {
      result := True
    }.elseif {other.subtype_list != NULL} then {
      result := other.subtype_list.fast_has self
    }
    result
  )

  - is_sub_type_with_name n:String_alias :Boolean <-
  ( + result:Boolean
    + idx:Int
    + type_parent:Type
    + ts:Itm_type_simple

    (n = prototype.name).if {
      result := True
    } else {
      idx := slot_run.lower
      {
        (idx <= slot_run.upper) && {slot_run.at idx.id_section.is_inherit_or_insert} && {! result}
      }.while_do {
        (slot_run.at idx.id_section.is_inherit).if {
          ts ?= slot_run.at idx.result_type
          type_parent := ts.to_run_for self pos (slot_run.at idx.position.prototype.filename).raw
          result := type_parent.is_sub_type_with_name n
        }
        idx := idx + 1
      }
    }
    result
  )

Type

  - load_prototype (call_path:String_alias,n:String_alias)
  generic_count gen_count:Int :Prototype <-
  ( + j,idx_path,idx_name,idx_name_old,idx_path_old:Int
    + entry:Pointer
    + result:Prototype
    + path,found,cur_found:String_alias
    + cn,cp:Char
    + read_char:{}
    + stat,found_index,cur_index:Int
    + is_only:Boolean
    
    //call_path.print; ' '.print; n.print; '\n'.print

  //result := dico_name_to_prototype.reference_at n
    result := dico_name_to_prototype.search n raw
    (result = NULL).if {
      read_char := {
        cn := n.at idx_name
        (cn = '.').if {
          (
            (idx_name > n.lower+1) &&
            {n.at (idx_name-1) = '.'} &&
            {n.at (idx_name-2) = '.'}
          ).if {
            idx_name := idx_name - 2
            cn := '*'
          } else {
            cn := '/'
          }
        } else {
          cn := cn.to_lower
        }
      }
      j := path_file.lower
      is_only := True
      {(j > path_file.upper) || {stat = 2}}.until_do {
        path := path_file.at j
        cur_found := NULL
        idx_name := n.upper
        idx_path := path.upper-3; // ".li"
        {
          read_char.value
          cp := path.at idx_path
          idx_name := idx_name - 1
          idx_path := idx_path - 1
        }.do_while {
          (idx_name >= n.lower)    &&
          {idx_path >= path.lower} &&
          {cn = cp}
        }
        ((idx_name < n.lower) && {cn = cp}).if {
          ((idx_path < path.lower) || {path.at idx_path = '/'}).if {
            cur_found := path
          }
        }.elseif {(cn = '*') && {cp = '/'}} then {
          idx_name_old := idx_name+1
          idx_path_old := idx_path+1
          {(idx_name >= n.lower) && {idx_path >= path.lower}}.while_do {
            read_char.value
            cp := path.at idx_path
            (cn = cp).if {
              // Nothing.
            }.elseif {(cn = '*') && {cp = '/'}} then {
              idx_name_old := idx_name
              idx_path_old := idx_path
            } else {
              idx_name := idx_name_old
              idx_path := idx_path_old
              {
                idx_path := idx_path - 1
              }.do_while {(idx_path >= path.lower) && {path.at idx_path != '/'}}
              idx_path_old := idx_path
            }
            idx_name := idx_name - 1
            idx_path := idx_path - 1
          }
          (idx_name < n.lower).if {
            cur_found := path
          }
        }.elseif {stat = 1} then {
          stat := 2
        }
        (cur_found != NULL).if {
          cur_index := cur_found.first_diff call_path
          (stat = 0).if {
            stat := 1
            found := cur_found
            found_index := cur_index
          } else {
            is_only := False
            (cur_index > found_index).if {
              found := cur_found
              found_index := cur_index
            }
          }
        }
        j := j + 1
      }

      (stat = 0).if {
        string_tmp |# '`' # n # "' is not found. (0)\n"        
        Position.put_error semantic text string_tmp
        (list_current != NULL).if {
          list_current.position.put_position
        }
        Position.send_error
      } else {
      //result := Prototype.prototype_dico.reference_at found
        result := Prototype.prototype_dico.search found raw
        (result = NULL).if {
          entry := File_utils.open_read found
          (entry.is_not_null).if {
            // Load prototype.
            File_utils.close entry
            result := Prototype.create found name n generic_count gen_count
            Parser.go_on result
          } else {
            string_tmp.copy "Cannot open `";
            string_tmp.append found
            string_tmp.append "'."
            semantic_error (last_position,string_tmp)
          }
        }
        (is_only).if {
          dico_name_to_prototype.at n put result
        }
      }
    }
    (result.generic_count != gen_count).if {
      //crash
      Position.put_error semantic text "Incorrect genericity definition."
      result.position.put_position
      (last_position.code != 0).if {
        last_position.put_position
      } else {
        ? {crash; True}
      }
      Position.send_error
    }

    //result.filename.print; '\n'.print; '\n'.print

    result
  )

  - make itm_typ:Itm_type_simple with proto:Prototype <-
  ( + mask_bit:Uint8
    
    //type_list.add_last self
    index     := index_max; //type_list.upper
    index_max := index_max + 1
    //
    prototype   := proto
    intern_name := get_intern name type True
    itm_type    := itm_typ
    slot_run    := Array Slot.create_with_capacity 10; // BSBS: A voir.
    (prototype.type_style = "Flat").if { 
      // Flat.
      mask_bit := Type_full.flat_bit | Type_full.default_flat_bit
    }.elseif {prototype.type_style = "Exact"} then { 
      // Exact.
      mask_bit := Type_full.exact_bit | Type_full.default_exact_bit
    }
    default := Type_full.create self with mask_bit
    prototype.init_slot_for self
    //
    subtype_list := Hset Type.create
    subtype_list.fast_add Type_null
    add_subtype self
    // Size.
    (Pointer.object_size = 4).if {
      size := 2; // 32 bits
    } else {
      size := 3; // 64 bits
    }
    name
    .when str_int then {
      size := 3; // 64 bits
    }
    .when str_int_8 or str_uint_8 then {
      size := 0; // 8 bits
    }
    .when "Char" or str_boolean then {
      size := 0; // 8 bits
    }
    .when str_int_16 or str_uint_16 then {
      size := 1; // 16 bits
    }
    .when str_int_32 or str_uint_32 then {
      size := 2; // 32 bits
    }
    .when str_int_64 or str_uint_64 then {
      size := 3; // 64 bits
    }
  )

  - dico_name_to_prototype:Hmap Prototype Key String_alias := new Hmap Prototype Key String_alias

Type, Type_full

  + type_full_list:Array Type_full

  - get_with flg:Uint8 :Type_full <-
  ( + result:Type_full
    + i:Int

    (flg = default.flag).if {
      result := default
    } else {
      (type_full_list = NULL).if {
        type_full_list := Array Type_full.create_with_capacity 2
        result := Type_full.create self with flg
        type_full_list.add_last result
      } else {
        {(i <= type_full_list.upper) && {type_full_list.at i.flag != flg}}.while_do {
          i := i + 1
        }
        (i <= type_full_list.upper).if {
          result := type_full_list.at i
        } else {
          result := Type_full.create self with flg
          type_full_list.add_last result
        }
      }
    }
    result
  )

Private

  - is_far_flat t:Type_full :Boolean <-
  // BSBS: Met en non recurssif!!
  ( + tg:Type_generic
    + result:Boolean
    (t.is_flat).if {
      result := True
    }.elseif {(t.raw.prototype.name = str_n_a) || {t.raw.prototype.name = str_n_a_v}} then {
      tg ?= t.raw
      result := is_far_flat (tg.generic_list.first)
    }
    result
  )

Type,Prototype

  - verify_itm_slot_parent ref:Itm_slot <-
  ( + idx:Int
    + type_parent:Type
    + ts:Itm_type_simple
    + other:Itm_slot

    idx := slot_run.lower
    {
      (idx <= slot_run.upper) && {slot_run.at idx.id_section.is_inherit_or_insert}
    }.while_do {
      ts ?= slot_run.at idx.result_type
      type_parent := ts.to_run_for self pos (slot_run.at idx.position.prototype.filename).raw
    //other := type_parent.prototype.slot_list.reference_at (ref.name)
      other := type_parent.prototype.slot_list.search (ref.name) raw
      (other != NULL).if {
        ref.is_equal_profil other
      }
      type_parent.verify_itm_slot_parent ref
      idx := idx + 1
    }
  )

  - verify_cyclic_inheritance ref:Type <-
  ( + idx:Int
    + type_parent:Type
    + ts:Itm_type_simple
    + s:Slot

    idx := slot_run.lower
    {
      (idx <= slot_run.upper) && {slot_run.at idx.id_section.is_inherit_or_insert}
    }.while_do {
      s := slot_run.at idx
      ts ?= s.result_type
      type_parent := ts.to_run_for self pos (slot_run.at idx.position.prototype.filename).raw
      (type_parent = ref).if {
        semantic_error (s.position,"Static cyclic inheritance.")
      }
      type_parent.verify_cyclic_inheritance ref
      idx := idx + 1
    }
  )

Private

  - parse_type_c t:String :Boolean <-
  ( + idx,idx2:Int
    + result:Boolean
    idx := type_c.first_substring_index t
    (idx != -1).if {
      (
        (idx = 0) || {(!type_c.at (idx - 1).is_letter_or_digit) && {type_c.at (idx - 1) != '_'}}
      ).if {
        idx2 := idx + type_c.count
        result := (
          (idx2>type_c.upper) || {(!type_c.at idx2.is_letter_or_digit) && {type_c.at idx2 != '_'}}
        )
      }
    }
    result
  )
