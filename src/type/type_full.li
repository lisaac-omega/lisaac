Header
  + name := Type_full
/*Type with attribute flags.*/
Inherit

  - parent_any:Any := Any

Type, Type_full // Private after fuck bug

  + the_parent_type:Type; // BSBS: Passer en héritage + Insert mode.

Type, Type_full,Node_type

  - get_with flg:Uint8 :Type_full <- the_parent_type.get_with flg

Public
  
  - get_slot n:String_alias :Slot <- the_parent_type.get_slot n

  - get_itm_slot n:String_alias :Itm_slot <- the_parent_type.get_itm_slot n

  - hash_code:Int <- raw.name.hash_code

  - size:Int <- the_parent_type.size

  - prototype:Prototype <- the_parent_type.prototype

  - is_sub_type other:Type_full :Boolean <- the_parent_type.is_sub_type (other.raw)

  - slot_run:Array Slot <- the_parent_type.slot_run

  - is_late_binding:Boolean <- the_parent_type.is_late_binding

Type,Node_type

  + flag:Uint8
  // 7 6 5 4 3 2 1 0
  // | | | | | | | +- 0:Reference / 1:Flat
  // | | | | | | +--- 0:Reference / 1:Flat (by default)
  // | | | | | +----- 0:Normal    / 1:Exact
  // | | | | +------- 0:Normal    / 1:Exact (by default)
  // | | | +--------- 0:Normal    / 1:Temporary
  // | | +----------- 0:Normal    / 1:Old generic
  // | +------------- FREE
  // +--------------- 0:Normal    / 1:Escape
  
  //
  // Creation.
  //

  - create typ:Type with code:Uint8 :Self <-
  [
    -? {typ != NULL}
  ]
  ( + result:Self

    result := clone
    result.make typ with code
    result
  )

  - make typ:Type with code:Uint8 <-
  (
    the_parent_type := typ
    flag := code
    //? {is_flat -> (! is_exact)}
  )

Public

  - is_parameter_type:Boolean <- False
  
  - is_scalar:Boolean <-
  (
    is_flat && {raw.type_c != NULL}
  )
  
  - raw:Type <- the_parent_type

  //
  // Set.
  //

  - flat_bit         :Uint8 := 0000_0001b
  - default_flat_bit :Uint8 := 0000_0010b
  - exact_bit        :Uint8 := 0000_0100b
  - default_exact_bit:Uint8 := 0000_1000b
  - flat_ref_bit     :Uint8 := 0001_0000b
  - generic_bit      :Uint8 := 0010_0000b
  
  - escape_bit       :Uint8 := 1000_0000b

  // Access.

  - is_flat          :Boolean <- (flag & flat_bit         ) != 0
  - is_default_flat  :Boolean <- (flag & default_flat_bit ) != 0
  - is_exact         :Boolean <- (flag & exact_bit        ) != 0
  - is_default_exact :Boolean <- (flag & default_exact_bit) != 0
  - is_flat_ref      :Boolean <- (flag & flat_ref_bit     ) != 0
  - is_generic       :Boolean <- (flag & generic_bit      ) != 0

  - is_escape        :Boolean <- (flag & escape_bit       ) != 0

  - is_flat_c:Boolean <- (is_flat) && {raw.type_c != NULL}
  - is_flat_without_default:Boolean <- (is_default_flat) && {prototype.default_value = NULL}

  - self:Self '==' Right 60 other:E :Boolean <-
  ( + same:Type_full
    same ?= other
    (same != NULL) && {
      (self = same) || {(raw == same.raw) && {(raw.is_block) || {(flag & 01111b) = (same.flag & 01111b)}}}
    }
  )

  - append_name_in buffer:String_buffer <-
  (
    (is_exact).if {
      buffer.append "Exact "
    }
    (is_flat).if {
      buffer.append "Flat "
    }
    (is_escape).if {
      buffer.add_last '\\'
    }
    raw.append_name_in buffer
  //  buffer.append (raw.name)
  )
  
  - append_contract_name_in buffer:String_buffer <- 
  (
    raw.append_contract_name_in buffer
  )

  //
  // Operation.
  //

  - self:Self '+' other:Uint8 :Type_full <- get_with (flag | other)

  - self:Self '-' other:Uint8 :Type_full <- get_with (flag & ~other)

  - to_exact:Type_full <-
  ( + result:Type_full

    (is_flat).if {
      result := self
    } else {
      result := get_with (flag | exact_bit)
    }
    result
  )

  - to_no_exact:Type_full <-
  ( + result:Type_full

    (is_flat).if {
      result := self
    } else {
      result := get_with (flag & ~exact_bit)
    }
    result
  )

  //
  // Variable product.
  //

  - new_local p:Position
      name    n:String_alias
      style   s:Char
      result  r:Boolean         :Local <-
  (
    Local.create p name n style s type self result r
  )

  - new_local p:Position name n:String_alias style s:Char :Local <-
  (
    Local.create p name n style s type self
  )

  - get_temporary_expr p:Position :Expr <-
  ( + result:Expr

    (raw = Type_void).if {
      result := Prototype_cst.create p type (Type_void.default); //BSBS: Alias.
    } else {
      result := get_temporary p.read p
    }
    result
  )

  - get_temporary p:Position :Local <-
  (
    new_local p name "__tmp" style '+'
  )

  - get p:Position result n:Int :Local <-
  ( + intern:String_alias
    string_tmp.copy "Result"
    (n != 0).if {
      string_tmp.add_last '_'
      n.append_in string_tmp
    }
    intern := string_tmp.to_string_alias
    new_local p name intern style 'R'
  )

  //
  // Type Control.
  //

  //+----------+----------+----------+----------+
  //| A := B-->| Reference| Flat     | Exact    |
  //| V        | TYPE     | TYPE     | TYPE     |
  //+----------+----------+----------+----------+
  //| Reference| B.sub A  | False    | B.sub A  |
  //| TYPE     |          |          |          |
  //+----------+----------+----------+----------+
  //| Flat     | False    | A = B    | A = B    |
  //| TYPE     |          |          |          |
  //+----------+----------+----------+----------+
  //| Exact    | False    | False    | A = B    |
  //| TYPE     |Sauf NULL |          |          |
  //+----------+----------+----------+----------+
  - affect_with other:Type_full :Boolean <-
  ( + result:Boolean

    (other == self).if {
      result := True
    } else {
      (is_exact).if {
        // A: Exact.
        result := other.raw = Type_null
      }.elseif {is_flat} then {
        // A: Flat.
        result :=
        ((other.is_exact)    && {raw ~= other.raw      }) ||
        {(raw = type_boolean) && {other.is_sub_type self}} ||
        {(raw = type_pointer) && {other.raw = Type_null }}
      } else {
        // A: Reference.
        result :=
        (
          (! other.is_flat) ||
          { + tb:Type_block
            tb ?= raw
            (tb != NULL)
          }
        ) && {other.is_sub_type self}
      }
    }
    result
  )

  //
  // Import / Export manager.
  //

  - is_export_to t:Type_full :Boolean <- raw.is_export_to t

  - is_import_to t:Type_full :Boolean <- raw.is_import_to t

  //
  // Default value.
  //
  + recursivity_test:Boolean
  - default_value p:Position :Expr <-
  ( + result:Expr
    ((prototype != NULL) && {prototype.default_value != NULL}).if {
      // Prototype User definition.
      (recursivity_test).if {        
        Position.put_error semantic text "Recursivity without end (default used default, ...)."
        list_current.position.put_position
        prototype.default_value.position.put_position
        Position.send_error
      } else {
        recursivity_test := True
        result := prototype.default_value.to_run_expr        
        recursivity_test := False
      }
    } else {
      (is_flat).if {        
        result := Prototype_cst.create p type self
      } else {
        result := Prototype_cst.create p type (Type_null.default)
      }
    }

    result
  )

  //
  // Declaration generation.
  //

  - genere_declaration buffer:String_buffer <-
  (
    (is_flat).if {
      raw.put_flat_declaration buffer
    }.elseif {is_exact} then {
      raw.put_reference_declaration buffer
    } else {
      raw.put_generic_declaration buffer
    }
  )

  - genere_star_declaration buffer:String_buffer <-
  (
    ((! is_flat) || {is_flat_ref && {! is_default_flat} /* 14Mars */}).if {
      raw.put_reference_star_declaration buffer
    }
  )

  //
  // Generation code.
  //

  - genere_value buffer:String_buffer <-
  ( + tb:Profil_block
    (
      (is_flat) && {! is_flat_ref} && {! is_default_flat} &&
      {raw != type_true} && {raw != type_false} && {raw != Type_null} &&
      {tb ?= raw; tb = NULL}
    ).if {
      buffer.append "(*"
      raw.put_value buffer
      buffer.add_last ')'
    } else {
      raw.put_value buffer
    }
  )

  //
  // Display.
  //

  - display buf:String_buffer <-
  (
    (is_generic).if {
      buf.append "Generic "
    }
    append_name_in buf
  )

  - print <-
  (
    string_tmp.clear
    display string_tmp
    string_tmp.print
  )
  
  - display_full buffer:String_buffer <-
  ( 
    display buffer
    buffer.add_last ' '
    buffer.add_last '['
    (is_flat).if {
      buffer.add_last 'e'
    }
    (is_default_flat).if {
      buffer.add_last 'E'
    }
    (is_exact).if {
      buffer.add_last 's'
    }
    (is_default_exact).if {
      buffer.add_last 'S'
    }
    (is_generic).if {
      buffer.add_last 'G'
    }
    buffer.add_last ']'
  )
  
  - print_full <-
  (
    string_tmp.clear
    display_full string_tmp
    string_tmp.print
  )

