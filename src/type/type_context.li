Header
  + name := Type_context
/*Type Context for debug mode*/
Inherit

  + parent_type:Flat Type

Public

  - name:String_alias <- "___CONTEXT"

  - intern_name:String_alias <- name

  - type_c:String_alias <- "_____CONTEXT"

  //
  // Creation.
  //

  - make_context <-
  (
    dico_type.at name put self
    default := Type_full.create self with (Type_full.flat_bit)
  )

  - genere_typedef <-
  (
    // Nothing.
  )

  - genere_struct <-
  // The fields are volatile: only the handler of a stack overflow may read them
  // (@Signal), so gcc -O2 would remove their writes.
  (
    output_decl.append
    "/* ___CONTEXT */\n\
    \typedef struct ___CONTEXT_struct _____CONTEXT; \n\
    \struct ___CONTEXT_struct {\n\
    \  volatile uint64_t code; \n\
    \  _____CONTEXT * volatile back; \n\
    \};\n"
    (is_cop).if {
      // COP: one stack of contexts for each thread.
      output_decl.append "extern LI_BASE_TLS uintptr_t top_context; \n\n"
      output_glob.append "LI_BASE_TLS uintptr_t top_context; \n"
    } else {
      output_decl.append "extern uintptr_t top_context; \n\n"
      output_glob.append "uintptr_t top_context; \n"
    }
  )
