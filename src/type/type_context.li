Header
  + name := Type_context
/*Type Context for debug mode*/
Inherit

  + parent_type:Flat Type

Public

  - name:String_alias <- "___CONTEXT"

  - intern_name:String_alias <- name

  - type_c:String_alias <- "_____CONTEXT"

  //
  // Creation.
  //

  - make_context <-
  (
    dico_type.at name put self
    //slot_run := ARRAY SLOT .create_with_capacity 1; // BSBS: Plus utile !
    default := Type_full.create self with (Type_full.flat_bit)
  )

  - genere_typedef <-
  (
    // Nothing.
  )

  - genere_struct <-
  (
    output_decl.append
    "/* ___CONTEXT */\n\
    \typedef struct ___CONTEXT_struct _____CONTEXT; \n\
    \struct ___CONTEXT_struct {\n\
    \  uint64_t code; \n\
    \  _____CONTEXT *back; \n\
    \};\n\
    \extern uintptr_t top_context; \n\n"
    output_glob.append "uintptr_t top_context; \n"
  )
