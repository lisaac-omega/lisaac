Header
  + name := Type_block
/*Virtual type for Block manager*/
Inherit

  + parent_type:Flat Type

Private

  - dico:Array Type_block := Array Type_block .create_with_capacity 2048

Type_block //,PROFIL_BLOCK

  //
  // Creation.
  //

  - create a_list:Array Type_full result r_list:Array Type_full :Self <-
  ( + result:Self
    result := clone
    result.make a_list result r_list
    result
  )

  - make a_list:Array Type_full result r_list:Array Type_full <-
  (
    argument_list := a_list
    result_list   := r_list
    default := Type_full.create self with 0
  )

Public

  - set_late_binding <-
  (
    type_block.set_late_binding
  )

  - intern_name:String_alias <- type_block.intern_name

  - is_block:Boolean := True
  
  + itm_block:Itm_block
  + argument_list:Array Type_full
  + result_list:Array Type_full

  - get_expr_for p:Position :Expr <-
  ( + result:Expr
    + lst:Array Expr

    (result_list.count > 1).if {
      lst := Array Expr.create_with_capacity (result_list.count)
      (result_list.lower).to (result_list.upper) do { j:Int
        lst.add_last (result_list.at j.get_temporary_expr p)
      }
      result := Expr_multiple.create lst
    }.elseif {result_list.count = 1} then {
      result := result_list.first.get_temporary_expr p
    } else {
      result := Prototype_cst.create p type (Type_void.default)
    }
    result
  )

  - get t:Itm_type_block with p:Parameter_to_type :Type_full <-
  ( + a_list:Array Type_full
    + r_list:Array Type_full

    // Argument.
    a_list := Alias_array Type_full.new
    (t.type_argument != NULL).if {
      t.type_argument.to_run_in a_list for p pos (p.position.prototype.filename)
    }
    a_list := Alias_array Type_full.alias a_list
    // Result.
    r_list := Alias_array Type_full.new
    (t.type_result != NULL).if {
      t.type_result.to_run_in r_list for p pos (p.position.prototype.filename)
    }
    r_list := Alias_array Type_full.alias r_list
    //
    get_direct a_list result r_list.default
  )

  - get_direct a_list:Array Type_full result r_list:Array Type_full :Type_block <-
  ( + idx:Int
    + result:Type_block

    idx := dico.lower
    {
      (idx <= dico.upper) && {
        {dico.at idx.argument_list != a_list} ||
        {dico.at idx.result_list   != r_list}
      }
    }.while_do {
      idx := idx + 1
    }
    (idx <= dico.upper).if {
      result := dico.at idx
    } else {
      result := create a_list result r_list
      dico.add_last result
    }
    result
  )
  
  - self:Self '==' Right 60 other:E :Boolean <-
  ( + result:Boolean
    + o:Type_block
    + oo:Profil_block
    + i:Int
    oo ?= other
    (oo != NULL).if {
      o := oo.to_type_block
    } else {
      o ?= other
    }
    /*
    (o != NULL).if {
      string_tmp.clear
      append_name_in string_tmp
      string_tmp.append " <=> "
      o.append_name_in string_tmp
      string_tmp.add_last '\n'
      string_tmp.print
    };*/
    (
      (o != NULL) && 
      {argument_list.count = o.argument_list.count} && 
      {result_list.count = o.result_list.count}
    ).if {
      //"Test arg & result...\n".print
      result := True
      i := argument_list.lower
      {(result) && {i <= argument_list.upper}}.while_do {
        result := argument_list.at i == o.argument_list.at i
        /*
        (result).if_false {
          string_tmp.clear
          argument_list.at i.display string_tmp
          string_tmp.append " != "
          o.argument_list.at i.display string_tmp
          string_tmp.add_last '\n'
          string_tmp.print
        };*/
        i := i + 1
      }
      i := result_list.lower
      {(result) && {i <= result_list.upper}}.while_do {
        result := result_list.at i == o.result_list.at i
        /*
        (result).if_false {
          string_tmp.clear
          result_list.at i.display string_tmp
          string_tmp.append " != "
          o.result_list.at i.display string_tmp
          string_tmp.add_last '\n'
          string_tmp.print
        };*/
        i := i + 1
      }
    }
    //(result).if_true { "OK!!\n".print; }
    result    
  )
  
  - prototype:Prototype <- type_block.prototype

  - get_slot n:String_alias :Slot <-
  (
    type_block.get_slot n
  )

  - get_local_slot n:String_alias :Slot <-
  (
    type_block.get_local_slot n
  )

  - get_path_slot n:String_alias :Slot <-
  (
    type_block.get_path_slot n
  )

  - genere_struct <- type_block.genere_struct

  - get_type_creation:Type <-
  (
    Type_creation(Type_block).create_type_creation self
  )

  //
  // Code source generation.
  //

  - put_id buffer:String_buffer <- index.append_in buffer

  - put_access_id e:Expr <-
  (
    output.append "(int)"
    e.genere
  )

  - put_value buffer:String_buffer <-
  (
    buffer.append "(void *)"
    index.append_in buffer
  )

  - is_sub_type other:Type :Boolean <-
  ( + me:Type_block    
    me ?= other
    (me != NULL) && 
    {me.argument_list = argument_list} && 
    {me.result_list = result_list}
  )

  - is_sub_type_result other:Type_block :Boolean <-
  ( + result:Boolean
    + j:Int
    (result_list = other.result_list) || {
      (result_list != NULL) && {other.result_list != NULL} /* BSBS c'est jamais null*/ && 
      {result_list.count = other.result_list.count} && {
        result := True
        j := result_list.lower
        {(j <= result_list.upper) && {result}}.while_do {
          result := result_list.at j.is_sub_type (other.result_list.at j)
          j := j + 1
        }
        result
      }
    }
  )
  
  - is_invariant_type_arg other:Type_block :Boolean <-
  ( + result:Boolean
    + j:Int
    (argument_list = other.argument_list) || {      
      (argument_list.count = other.argument_list.count) && {
        result := True
        j := argument_list.lower
        {(j <= argument_list.upper) && {result}}.while_do {
          result := argument_list.at j == other.argument_list.at j
          j := j + 1
        }
        result
      }
    }
  )

  //
  // Display.
  //

  - append_name_in buf:String_buffer <-
  (
    buf.add_last '{'
    (argument_list.is_empty).if_false {
      (argument_list.count > 1).if {
        buf.add_last '('
        (argument_list.lower).to (argument_list.upper-1) do { j:Int
          argument_list.at j.display buf
          buf.add_last ','
        }
        argument_list.last.display buf
        buf.add_last ')'
      } else {
        argument_list.first.display buf
      }
      buf.add_last ';'
      buf.add_last ' '
    }
    (result_list.is_empty).if_false {
      (result_list.lower).to (result_list.upper-1) do { j:Int
        result_list.at j.display buf
        buf.add_last ','
      }
      result_list.last.display buf
    }
    buf.add_last '}'
    // Debug
    //buf.append "(TYPE_BLOCK)"
  )
  
