Prototype

  - get_slot_main:Slot <-
  ( + result:Slot
        
    result := type_input.get_slot "main"
    (result = NULL).if {
      semantic_error (position,"Entry point not found (slot `main' in `Section Public').")
    }
    (result.result_type != Itm_type_simple.type_void).if {
      semantic_error (result.position,"Unix mode: Not value return.")
    }
    (result.argument_count != 1).if {
      semantic_error (result.position,"Unix mode: Not argument list.")
    }
    result
  )
  
