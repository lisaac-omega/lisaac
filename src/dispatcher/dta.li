Header
  + name := Dta
/*Parent for all late binding*/
Inherit

  + parent_itm_object:Flat Itm_object

Public

  + result_expr:Expr

  + slot:Slot

  + self_arg:Expr

  //+ context:LOCAL
  
  //
  // Service
  //

  - remove <-
  (
    // Nothing.
  )

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.append "DTA"
    abstract
  )

Node_type, Dta

  - concrete_type:Type
  // Concrete type of the receiver during @product (copy of a data slot of type Self).

  - concrete_type_full:Type_full

  - product t:Type with e:Expr self type_self:Type_full :List <-
  ( + result:List

    (type_self = NULL).if {
      concrete_type := t
      concrete_type_full := t.default.to_exact
    } else {
      concrete_type := type_self.raw
      concrete_type_full := type_self
    }
    result := List.create (e.position)
    (t = Type_null).if {      
      Escape.on_null_call e
      result.add_last Call_null      
    } else {
      lookup t with e in result
    }
    result
  )

  - update_branch l:List self type_self:Type_full :Boolean <-
  [
    -? {type_self != NULL}
  ]
  ( + node:Node
    + result:Boolean

    node ?= l.first
    (node = NULL).if {
      result := True
    } else {

      node.update_link type_self
      node ?= l.second
      (node != NULL).if {
        node.update_link type_self
      }
    }
    result
  )

Node_style, Self

  - get_argument:Array Expr <-
  ( + result:Array Expr

    result := Array Expr .create_with_capacity 1
    result.add_last (self_arg.my_copy)
    result
  )

Dta

  - finalise typ:Type with (expr:Expr,s:Slot) in lst:List <-
  ( + node:Node_style

    node := Node_style.create (expr.my_copy,s) with self result result_expr
    lst.add_last node
  )

Private

  - lookup typ:Type with expr:Expr in lst:List <-
  ( + s:Slot
    + name:String_alias
    + node_style:Node_style
    + nt:Node_type
    + r:Expr

    name := slot.name
    s := typ.get_local_slot name
    (s = NULL).if {
      
      // Lookup parent.
      // First, evaluate the parent slot in the EXPR r
      // Then chain another NODE_TYPE to dispatch on r
      s := typ.get_path_slot name
      r := s.result_type.get_expr_for typ
      node_style := Node_style.create (expr.my_copy,s) with self result r
      lst.add_last node_style
      nt := Node_type.create r with self
      nt.set_self_type_parent concrete_type_full
      lst.add_last nt
    } else {
      // Direct call.
      s.is_equal_profil slot
      finalise typ with (expr,s) in lst
    }
    lst.add_last (Prototype_cst.create (expr.position) type (Type_void.default)); // BSBS: Alias.
  )
