Header
  + name := Node_type
/*Switch node for type*/
Inherit

  + parent_node:Flat Node

Public

  - result_expr:Expr <- data.result_expr

  + is_self:Boolean

  + self_type_parent:Type_full
  // Dispatch on a parent (see @Dta.lookup): concrete type of the first receiver,
  // used when the update has no type of self (data slot of type Self).

  - set_self_type_parent t:Type_full <- ( self_type_parent := t; )

  //
  // Creation.
  //

  - create e:Expr with d:Dta :Self <-
  // Create with back-link.
  [ -? {d.position != 0}; ]
  ( + result:Self

    result := clone
    result.make e with d
    result
  )

  - make e:Expr with d:Dta <-
  (
    expr := e
    data := d
    late_binding_counter := late_binding_counter + 1
    ((e.static_type.is_flat) || {e.static_type.raw = type_boolean}).if {
      late_binding_flat_counter := late_binding_flat_counter + 1
    } else {
      + myself:Read_local
      myself ?= e
      ((myself != NULL) && {myself.variable.name = "self"}).if { 
        late_binding_self_counter := late_binding_self_counter + 1
      }
    }
  )

  //
  // Just for ITM_EXPRESSION
  //

  - create_partial d:Dta :Self <-
  ( + result:Self

    result := clone
    result.make_partial d
    result
  )

  - make_partial d:Dta <-
  (
    data := d
  )

Public

  - my_copy:Self <-
  ( + result:Self

    result := Self.create (expr.my_copy) with data
    node_list.add_last result
    result
  )

  //
  // Execute.
  //

  - execute:Instr <-
  // Debug mode: a test of @NULL before a direct call (see @is_null_receiver).
  ( + result:Instr
    ((switch = NULL) && {first_code != NULL} && {is_null_receiver}).if {
      data.remove
      list_current.insert_before null_check
      result := first_code.execute
    } else {
      result := parent_node.execute
    }
    result
  )

  //
  // Update.
  //

  - update:Boolean <-
  (
    update_case self_type_parent & update_depth self_type_parent
  )

Node, Dta

  - update_link self_type:Type_full :Boolean <-
  (
    update_case self_type & update_depth self_type
  )

Private

  - update_case type_self:Type_full :Boolean <-
  ( + typ_f:Type_full
    + typ:Type
    + lst_typ:Types_tmp
    + list:Array Case
    + case:Case
    + result:Boolean
    + idx,idx2:Int

    typ_f := expr.static_type
    
    ((typ_f.is_flat || {typ_f.is_exact}) && {typ_f.raw != type_boolean}).if {
      (first_code = NULL).if {
        first_type := typ_f.raw
        first_code := data.product first_type with expr self type_self
      }
      result := True
    }.elseif {(typ_f.raw = type_boolean) && {count = 2}} then {
      result := True
    } else {
      ((typ_f.raw.is_block) || {typ_f.raw.subtype_list.count != count}).if {
        lst_typ := Types_tmp.new
        expr.get_type lst_typ

        (! lst_typ.is_empty).if {
          (lst_typ.count = 1).if {
            (first_code = NULL).if {
              idx := lst_typ.first_index
              first_type := lst_typ.at idx
              first_code := data.product first_type with expr self type_self
            }
          } else {
            (switch = NULL).if {
              switch := Switch.create self with expr size (lst_typ.count)
            }
            list := switch.list            
            (list.count != lst_typ.count).if {
              idx  := lst_typ.first_index
              idx2 := 0
              {idx != -1}.while_do {
                typ := lst_typ.at idx
                ((idx2 > list.upper) || {typ != list.at idx2.id}).if { 
                  add_stack_type typ
                  //
                  case := Case.create typ with (data.product typ with expr self type_self)
                  list.at idx2 add case
                  //
                  stack_type.remove_last
                }
                idx := lst_typ.next_index idx
                idx2 := idx2 + 1
              }
            }
          }
        }
        lst_typ.free
      } else {
      }
    }
    result
  )

  - is_null_receiver:Boolean <-
  // Debug mode: a direct call (receiver of an exact type, see @update_case) whose receiver may
  // be @NULL, as a field not yet written or set to @NULL (its possible types): without a test,
  // a crash, or a call removed. Not for a C array (@C_array: a C pointer, where @NULL is
  // allowed, as `realloc(NULL,...)'), a prototype mapped to a C type, a cast, a block.
  // The test is out of the code of the call: the analysis (as @Escape) sees the same code.
  ( + typ_f:Type_full
    + pro:Prototype
    + tg:Type_generic
    + dc:Dta_cast
    + db:Dta_block
    + lst:Types_tmp
    + idx:Int
    + result:Boolean
    (debug_level_option != 0).if {
      typ_f := expr.static_type
      pro := typ_f.raw.prototype
      tg ?= typ_f.raw
      dc ?= data
      db ?= data
      ((typ_f.is_exact) && {! typ_f.is_flat} && {typ_f.raw != type_boolean} && {pro != NULL} && {pro.type_c = NULL} && {(tg = NULL) || {tg.native_array_variable = NULL}} && {dc = NULL} && {db = NULL}).if {
        lst := Types_tmp.new
        expr.get_type lst
        idx := lst.first_index
        {(idx = -1) || {result}}.until_do {
          result := lst.at idx = Type_null
          idx := lst.next_index idx
        }
        lst.free
      }
    }
    result
  )

  - null_check:Instr <-
  // `Call on NULL' if the receiver is @NULL (as the @NULL case of a @Switch, see @Call_null);
  // ignored by @Escape (see @Escape.on_external).
  ( + acc:Array Expr
    acc := Array Expr .create_with_capacity 1
    acc.add_last expr
    External_c.create (expr.position) text "/* NULL check */ if ((void *)(@) == NULL) { lisaac_stack_print(0); print_string(\"Call on NULL\\n\"); die_with_code(1); }" access acc persistant True type (Type_void.default)
  )

  - update_depth self_type:Type_full :Boolean <-
  ( + result:Boolean
    + list:Array Case
    + new_type_self:Type_full

    (switch = NULL).if {
      (first_code != NULL).if {
        (self_type = NULL).if {
          new_type_self := expr.static_type
          ((! new_type_self.is_flat) || {new_type_self.raw = type_boolean}).if {
            new_type_self := first_type.default.to_exact
          }
        } else {
          new_type_self := self_type
        }

        add_stack_type first_type
        result := data.update_branch first_code self new_type_self
        stack_type.remove_last
      }
    } else {
      list := switch.list
      (list.lower).to (list.upper) do { j:Int
        (self_type = NULL).if {
          new_type_self := list.at j.id.default.to_exact
        } else {
          new_type_self := self_type
        }
        add_stack_type (list.at j.id)
        /*result := result &*/ data.update_branch (list.at j.code) self new_type_self
        stack_type.remove_last
      }
    }
    result
  )

Private

  - stack_type:Array Type := Array Type .create_with_capacity 16

  - add_stack_type t:Type <-
  (
    stack_type.add_last t
    ((stack_type.count > 1) && {stack_type.first = t}).if {
      string_tmp.copy "Cyclic inheritance : "
      (stack_type.lower).to (stack_type.upper) do { j:Int
        stack_type.at j.append_name_in string_tmp
        string_tmp.append ", "
      }
      string_tmp.append "..."
      semantic_error (data.position, string_tmp)
    }
  )
