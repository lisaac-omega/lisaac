Header
  + name := Prototype_cst
/*Prototype constant*/
Inherit

  + parent_constant:Flat Constant

Public

  //
  // Creation.
  //

  - create p:Position type t:Type_full :Self<-
  ( + result:Self
    ? {p.code != 0}
    ? {t != NULL}

    result := clone
    result.make p type t
    result
  )

  - make p:Position type t:Type_full <-
  (
    position    := p
    static_type := t; //.to_exact
  )

  + is_move:Boolean
  // `One': the `NULL' written in the source of a move (see @Itm_code.emit_move).

  + move_name:String_alias
  // The variable moved.

  - set_move n:String_alias <-
  (
    is_move := True
    move_name := n
  )

  - my_copy:Self <-
  ( + result:Self
    result := Self.create position type static_type
    (is_move).if {
      result.set_move move_name
    }
    result
  )

  //
  // Comparaison.
  //

  - self:Self '~=' Right 60 other:Expr :Boolean <-
  ( + p:Prototype_cst
    p ?= other
    (p != NULL) && {static_type = p.static_type}
  )

  //
  // Execute
  //

  - execute_link:Expr <-
  (
    Escape.on_move_constant self
    self
  )
  
  - to_run_contract msg:String_alias <-
  (
    // Nothing.
  )
  
  // Generation.
  
  - genere <-
  (
    static_type.genere_value output
  )

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    static_type.display buffer
    display_ref buffer
  )


