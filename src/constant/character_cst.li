Header
  + name := Character_cst
/*CHARACTERacter constant*/
Inherit

  + parent_constant:Flat Constant

Public

  //
  // Value.
  //

  + text:String_alias

  //
  // Creation.
  //

  - create p:Position char car:String_alias :Self<-
  ( + result:Self
    result := clone
    result.make p char car
    result
  )

  - make p:Position char car:String_alias <-
  (
    position := p
    text := car
    static_type := type_char.default
  )

  - my_copy:Self <- Self.create position char text

  //
  // Comparaison.
  //

  - self:Self '~=' Right 60 other:Expr :Boolean <-
  ( + s:Self
    s ?= other
    (s != NULL) && {text = s.text}
  )

  //
  // Generation.
  //

  - genere <-
  (
    output.add_last '\''
    output.append text
    output.add_last '\''
  )

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.add_last '\''
    buffer.append text
    buffer.add_last '\''
    display_ref buffer
  )





