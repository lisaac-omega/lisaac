Header
  + name := Slot_data
/*Slot with data style*/
Inherit

  + parent_variable:Flat Variable

  + parent_slot:Slot := Slot

Public
  
  - data_hash_code_alias:Slot_data
  
  // BUG COMPILO 0.11

  - id_section:Section_ <-
  ( + result:Section_

    (parent_slot != NULL).if {
      result := parent_slot.id_section
    } else {
      result := Section_.standard_private
    }
    result
  )

  - receiver_type:Type <-
  ( + result:Type

    (parent_slot != NULL).if {
      result := parent_slot.receiver_type
    } else {
      result := type_block
    }
    result
  )

  //

  - common_slot:Slot <- parent_slot

  //
  // Sequence optimizer
  //

  + last_write:Write
  + last_seq_index:Uint32
  + last_seq_or_and:Uint32
  + last_seq_call_and_loop:Uint32
  + last_seq_call_local_and_loop:Uint32

  + last_list_current:List
  + last_index:Int

  - is_invariant rec:Expr :Boolean <-
  (
    ((rec = NULL) || {rec.is_invariant}) &&
    {last_write != NULL} &&
    {loop_seq_call_and_loop = seq_call_and_loop} &&
    {last_seq_index <= loop_seq_index}
  )

  - reset_last_write w:Write <-
  (
    (last_write = w).if {
      last_write := NULL
    }
  )

  - set_read <-
  (
    last_index := -1
  )

  - get_last_index:Int <- last_index

  - set_write w:Write <-
  (
    /* A FAIRE
    (
      (! PROFIL.mode_recursive) &&
      {style = '-'} &&
      {last_write != NULL} &&
      {last_index < list_current.index} &&
      {last_sequence = sequence_global}
    ).if {
      ? {list_current.at last_index = last_write}
      list_current.put (last_write.value) to last_index
      unwrite last_write
      new_execute_pass
    }
    */
    last_write                  := w
    last_seq_index              := seq_index
    last_seq_or_and             := seq_or_and
    last_seq_call_and_loop      := seq_call_and_loop
    last_seq_call_local_and_loop:= seq_call_local_and_loop
    //
    last_list_current := list_current
    last_index        := list_current.index
  )

  - get_last_value rec:Expr :Expr <-
  ( + result:Expr
    + val:Expr
    + rd:Read
    + rd_loc:Read_local
    + wrt_slot:Write_slot
    + l:Local
    + g:Slot_data
    + is_rec_ok:Boolean
    + my_require_count:Int
    + pb:Profil_block
    + i:Instr

    ((! Profil.mode_recursive) && {loop_invariant = NULL} && {last_write != NULL}).if {

      my_require_count := require_count
      (rec != NULL).if {
        // Block exception.
        pb ?= rec.static_type.raw
        ((pb != NULL) && {require_list != NULL}).if {
          rd_loc ?= rec
          l      := rd_loc.local
          wrt_slot ?= require_first
          rd_loc ?= wrt_slot.receiver
          (rd_loc.local = l).if {
            my_require_count := 1
          } else {
            my_require_count := 0
          }
          (require_list.lower).to (require_list.upper) do { j:Int
            wrt_slot ?= require_list.at j
            rd_loc   ?= wrt_slot.receiver
            (rd_loc.local = l).if {
              my_require_count := my_require_count + 1
            }
          }
        }
      }

      (
        (
          (last_seq_call_and_loop = seq_call_and_loop) && {is_seq_list last_list_current}
        ) || {my_require_count = 1}
      ).if {
        // Receiver test.
        (rec = NULL).if {
          is_rec_ok := True
        }.elseif {rec.is_constant} then {
          wrt_slot ?= last_write
          is_rec_ok := rec ~= wrt_slot.receiver
        } else {
          rd ?= rec
          (rd != NULL).if {
            l ?= rd.variable
            g ?= rd.variable
            wrt_slot ?= last_write
            rd ?= wrt_slot.receiver
            is_rec_ok := (rd != NULL) && {
              (
                {l = rd.variable} && {is_seq_list last_list_current} && {
                  (
                    (l.last_seq != NULL) && {l.last_seq.last_write != NULL} &&
                    {l.last_seq.last_seq_index < last_seq_index} &&
                    {last_seq_call_local_and_loop = seq_call_local_and_loop}
                  ) || {l.require_count <= 1} || {l.style = ' '}
                }
              ) ||
              {
                {g = rd.variable} && {g.style = '-'} && {
                  (
                    (g.last_write != NULL) && {g.last_seq_index < last_seq_index} &&
                    {last_seq_call_and_loop = seq_call_and_loop} &&
                    {is_seq_list (g.last_list_current)}
                  ) || {g.require_count = 1}
                }
              }
            }
          }
        }
        (is_rec_ok).if {
          val := last_write.value
          rd  ?= val
          (rd = NULL).if {
            l := NULL
            g := NULL
          } else {
            l ?= rd.variable
            g ?= rd.variable
          }
          (
            ( // Constant propagation.
              val.is_constant
            ) ||
            { // Local propagation.
              (l != NULL) && {is_seq_list last_list_current} && {
                (
                  (l.last_seq != NULL) && {l.last_seq.last_write != NULL} &&
                  {l.last_seq.last_seq_index < last_seq_index} &&
                  {last_seq_call_local_and_loop = seq_call_local_and_loop}
                ) || {l.require_count <= 1} || {l.style = ' '}
              }
            } ||
            { // Global propagation.
              (g != NULL) && {g.style = '-'} && {
                (
                  (g.last_write != NULL) && {g.last_seq_index < last_seq_index} &&
                  {last_seq_call_and_loop = seq_call_and_loop} &&
                  {is_seq_list (g.last_list_current)}
                ) || {g.require_count = 1}
              }
            }
          ).if {
            (rec != NULL).if {
              rec.remove
            }
            result := val.my_copy
          }.elseif {
            // Propagation step by step.
            (last_seq_or_and = seq_or_and) && {ensure_count = 1} &&
            {list_current.index > list_current.lower} &&
            {list_current.at (list_current.index - 1) = last_write}
          } then {
            (rec != NULL).if {
              rec.remove
              wrt_slot ?= last_write
              wrt_slot.receiver.remove
            }
            unwrite last_write
            list_current.at (list_current.index - 1) put Nop
            result := val
          }.elseif {
            (rec != NULL) && {is_seq_list last_list_current} &&
            {my_require_count = 1} && {ensure_count = 1} &&
            {last_index.in_range (last_list_current.lower) to (last_list_current.upper)} &&
            {last_list_current.at last_index = last_write}
          } then {
            // Local conversion.
            l := type.get_temporary position
            i := l.write (last_write.position) value val
            last_list_current.at last_index put i
            result := l.read (rec.position)
            //
            rec.remove
            wrt_slot ?= last_write
            wrt_slot.receiver.remove
            unwrite last_write
          }
        }
      }
    }
    result
  )

  //
  // Constructeur.
  //

  - create b:Slot type_full t:Type_full :Self <-
  (
    create (b.position) name (b.name) style (b.style) base b type t
  )

  - create pos:Position name n:String_alias
  style s:Char base b:Slot type t:Type_full :Self <-
  ( + result:Self
    result := clone
    result.make pos name n style s base b type t
    result
  )
  
  - make pos:Position name n:String_alias style s:Char base b:Slot type t:Type_full <-
  ( + tmp:Types_tmp
    + typ_sim:Type
        
    parent_slot := b
    //
    position    := pos
    name        := n
    style       := s
    intern_name := get_intern name type False
    //
    (parent_slot != NULL).if {
      typ_sim := parent_slot.receiver_type
      (
        (data_hash_code_alias = NULL) && {typ_sim.itm_type != NULL} && 
        {typ_sim.itm_type.name = str_string_alias} && 
        {name = "hash_code"}
      ).if {        
        data_hash_code_alias := self
      }
    }
    //
    type := t
    (is_static).if {
      tmp := Types_tmp.new
      tmp.add (type.raw)
      type_set := tmp.to_types
    } else {
      type_set := Types_tmp.types_empty
    }
    ((type.raw.is_block) && {name != "__id"} && {name != "self"}).if {            
      list_variable_block.add_last self
    }
    ? {type != NULL}
  )

  //
  // Context
  //
  
  - init_list:List := List.create Position

  - init_lists_base:Array List := Array List .create_with_capacity 64
  // With `-cop': second translation of the initial values of the `-' slots, in the same order,
  // for the base of a new universe: one list (C function `li_init_base_<index>') for each
  // slot, so that a universe initializes only the slots its code can reach (see
  // @Escape.needed_base_inits).

  + base_init_index:Int := -1
  // Index of its list in @init_lists_base.

  - init_lists_always:Array Int := Array Int .create_with_capacity 16
  // The lists of @init_lists_base for the fields (`+') of the prototypes copied into the base:
  // needed by any universe (the clones of the prototype copy them).

  + self_type:Type_full
  // For a data slot of type Self: Self of this copy (see @Slot.slot_data_for).

  - set_self_type t:Type_full <- ( self_type := t; )
  
  + value_init:List

  + value_init_base:List

  + is_object_init:Boolean
  // With `-cop': a field of an active object, initialized in the universe of the object, at
  // its creation (see @Type.add_cop_init), not by `main'.

  - init <-
  ( + val,rec:Expr
    + wrt:Write
    /*
    string_tmp.copy "init : "
    string_tmp.append name
    warning_error (position,string_tmp)
    */
    ((value_init = NULL) && {(affect != '<') || {self = slot_id}}).if {
      (self = slot_id).if {     
        val := Prototype_cst.create position type type
        (style = '+').if {
          rec := Prototype_cst.create position type (receiver_type.default)
        }
        wrt := write position with rec value val
        wrt.set_proto_init
        init_list.add_first wrt
        value_init := List; // BSBS: Pas utile (Faire en sorte de faire un init unique!)
        ? {init_list.index = -1}
      } else {
        // Init with complex code.
        ((is_cop) && {style = '+'} && {receiver_type.prototype.style = '-'}).if {
          is_object_init := True
        }
        value_init := new_value_init
        ((is_cop) && {(style = '-') || {! is_object_init}}).if {
          // For a new universe: its `-' slots, and its copies of the changed prototypes (the
          // writes in the shared ones are not generated, see @Escape.is_skipped_write).
          value_init_base := new_value_init
        }
      }
    }
  )

  - new_value_init:List <-
  // Code of the initial value, ending with its write in this slot.
  ( + val,rec,rec_call:Expr
    + wrt:Write
    + old_list:List
    + rd:Itm_read_arg1
    + old_profil_current:Profil
    + old_profil_slot:Profil_slot
    + result:List

    old_list := list_current
    old_profil_current := profil_current
    old_profil_slot    := profil_slot
    profil_current := profil_slot := NULL
    ((self_type != NULL) && {value != NULL}).if {
      // The initial value is evaluated with the Self of the prototype, not of this copy.
      semantic_error (position,"Initial value is not yet possible for a data slot of type `Self' (one copy for each type).")
    }
    result := list_current := List.create position
    (value = NULL).if {
      val := type.default_value position
    } else {
      rd ?= value
      ((is_object_init) && {rd != NULL}).if {
        // `T.__init_x' (see @Itm_slot.default_value), in the universe of the new object: on
        // its `self', not a message to the prototype `T'.
        rec_call := External_c.create position text "li_current" access NULL persistant False type (receiver_type.default)
        val := rd.to_run NULL with_self (rec_call,True,False) args NULL
      }.elseif {(is_cop) && {rd != NULL} && {receiver_type.prototype.style = '-'}} then {
        // `T.__init_x' of an active type `T': a direct call, in the universe which is
        // initialized (a message to `T' would make a cycle between the initializations).
        rec_call := Prototype_cst.create position type (receiver_type.default)
        val := rd.to_run NULL with_self (rec_call,True,False) args NULL
      }.elseif {(rd != NULL) && {rd.arg = NULL}} then {
        rec_call := Prototype_cst.create position type (receiver_type.default)
        val := rd.to_run NULL with_self (rec_call,False,False) args NULL
      } else {
        val := value.to_run_expr; // ICI
      }
    }
    val := val.check_type type with position
    (is_object_init).if {
      // The object of the current universe (see @Type.add_cop_init).
      rec := External_c.create position text "li_current" access NULL persistant False type (receiver_type.default)
    }.elseif {style = '+'} then {
      rec := Prototype_cst.create position type (receiver_type.default)
    }
    (debug_level_option != 0).if {
      result.add_last (
        Push.create position context context_main first False
      )
    }
    wrt := write position with rec value val
    (is_zero val).if { wrt.set_quiet_generation; }
    wrt.set_proto_init
    result.add_last wrt

    list_current   := old_list
    profil_current := old_profil_current
    profil_slot    := old_profil_slot
    result
  )

  //
  // Execute.
  //

  - execute <-
  ( + lst:Array Slot
    + slot:Slot_data
    + s:Slot
    + val:List
    + old_list_current:List
    //- last_idx:Int
    + old_profil_current:Profil
    + old_profil_slot:Profil_slot
    //+ insert_index:Int

    ((value_init != NULL) && {value_init != List}).if {      
      val := value_init
      value_init := NULL
      // For a good order.
      (type.is_flat).if {
        lst := type.slot_run
        (lst != NULL).if {
          (lst.lower).to (lst.upper) do { j:Int
            s := lst.at j
            (s.style = '+').if {
              slot := s.slot_data_intern
              (slot != NULL).if {
                slot.execute
              }
              
              slot := s.slot_id
              (slot != NULL).if {
                slot.execute
              }
              
            }
          }
        }
      }
            
      old_list_current   := list_current
      old_profil_current := profil_current
      old_profil_slot    := profil_slot
      list_current   := NULL
      profil_current := NULL
      profil_slot    := NULL

      val.execute
      (is_object_init).if {
        receiver_type.add_cop_init val
      } else {
        ? {init_list.index = -1}
        init_list.add_last val
      }
      (value_init_base != NULL).if {
        val := value_init_base
        value_init_base := NULL
        Escape.set_init_ctx (init_lists_base.count, NULL)
        val.execute
        Escape.set_init_ctx (-1, NULL)
        (debug_level_option != 0).if {
          // Debug mode: its function has its own context, as `main'.
          val.add_first (Push.create position context context_main first True)
        }
        base_init_index := init_lists_base.count
        (style = '+').if {
          init_lists_always.add_last base_init_index
        }
        init_lists_base.add_last val
      }

      profil_slot    := old_profil_slot
      profil_current := old_profil_current
      list_current   := old_list_current
    }
  )

  //
  // Genere
  //

  - genere buf:String_buffer <-
  (    
    type.genere_declaration buf
    buf.add_last ' '
    type.genere_star_declaration buf
    buf.append intern_name
    buf.append ";\n"
  )

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.append intern_name
    buffer.add_last ' '
    buffer.add_last ':'
    type.display buffer
  )

  - display_all <-
  (
    string_tmp.clear
    display string_tmp
    string_tmp.print
  )

Variable

  - new_read p:Position with r:Expr :Read <-
  ( + result:Read
    (style = '-').if {
      ? {r = NULL}
      result := Read_global.create p with self
    } else {
      ? {r != NULL}
      result := Read_slot.create p with (r,self)
    }
    result
  )

  - new_write p:Position with r:Expr value v:Expr :Write <-
  ( + result:Write
    (style = '-').if {
      ? {r = NULL}
      result := Write_global.create p with v in self
    } else {
      ? {r != NULL}
      result := Write_slot.create p with v in (r,self)
    }
    result
  )

  - is_zero e:Expr :Boolean <-
  ( + pro:Prototype_cst
    + int:Int_cst
    (
      pro ?= e
      (pro != NULL) && {
        (pro.static_type.raw = Type_null) || {pro.static_type.raw = type_false}
      }
    ) || {
      int ?= e
      (int != NULL) && {int.value = 0}
    }
  )
