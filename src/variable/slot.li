Header
  + name := Slot
/*Parent for slot runnable*/
Inherit

  + parent_itm_slot:Itm_slot := Itm_slot

Public

  - common_slot:Slot <- self

  + slot_id:Slot_data

  + receiver_type:Type
  
  //
  // Creation.
  //

  - create s:Itm_slot type t:Type :Slot <-
  ( + result:Slot

    result := clone
    result.make s type t
  )

  - make s:Itm_slot type t:Type :Slot <-
  ( + result:Slot
    
    s.set_used
    parent_itm_slot := s
    receiver_type := t
    //
    (t != NULL).if { // '=' or '!=' case
      (affect = '<').if {
        // Code.
        result := slot_code_intern := Slot_code.create self with value
      } else {
        // Data
        create_slot_data
        result := slot_data_intern
      }
    }
    //
    result
  )

  //
  // Style.
  //

  - lower_style:Int <-
  ( + result:Int
    (slot_data_intern = NULL).if {
      result := 1
    }
    result
  )

  - upper_style:Int <-
  ( + result:Int
    (slot_code_intern != NULL).if {
      (slot_code_list != NULL).if {
        result := slot_code_list.upper + 2
      } else {
        result := 1
      }
    }
    result
  )

  - slot_data:Slot_data <-
  (
    (slot_data_intern = NULL).if {
      create_slot_data
      (slot_id = NULL).if {
        slot_id := Slot_data.create common_slot type_full (Type_id.get_index 1.default)
        slot_id.init
      }
    }
    slot_data_intern
  )

  - slot_code idx:Int :Slot_code <-
  ( + result:Slot_code

    (idx = 1).if {
      result := slot_code_intern
    } else {
      result := slot_code_list.at (idx-2)
    }
    result
  )

  - add_style v:Itm_code :Int <-
  ( + slot:Slot_code
    + result:Int

    slot := Slot_code.create common_slot with v
    (slot_code_intern = NULL).if {
      slot_code_intern := slot
      slot_id := Slot_data.create common_slot type_full (Type_id.get_index 0.default)
      slot_id.init
      result := 1
    } else {
      (slot_code_list = NULL).if {
        slot_code_list := Array Slot_code .create_with_capacity 1
      }
      slot_code_list.add_last slot
      (slot_id = NULL).if {
        slot_id := Slot_data.create common_slot type_full (Type_id.get_index 1.default)
        slot_id.init
      }
      result := slot_code_list.upper + 2
    }
    result
  )

  //
  // Display.
  //

  - display_all <-
  (
    (lower_style).to (upper_style) do { j:Int
      item_style j.display_all
    }
  )

Public

  + slot_data_intern:Slot_data; // Index 0
  + slot_code_intern:Slot_code; // Index 1

  + slot_code_list:Array Slot_code; // Index x+2
  + slot_data_list:Array Slot_data; // Vector data slot

  - create_slot_data <-
  ( + typ:Type_full
    + tm:Itm_type_multi

    tm ?= result_type
    (tm != NULL).if {
      slot_data_list := Array Slot_data .create_with_capacity (tm.count-1)
      (tm.lower).to (tm.upper-1) do { k:Int
        typ := to_run_type (tm.at k) for receiver_type
        slot_data_list.add_last (
          Slot_data.create common_slot type_full typ
        )
      }
      typ := to_run_type (tm.last) for receiver_type
    } else {
      typ := to_run_type result_type for receiver_type
    }
    slot_data_intern := Slot_data.create common_slot type_full typ
    (is_self_dependent).if {
      slot_data_intern.set_self_type (receiver_type.default.to_exact)
    }
    ((is_self_dependent) && {tm != NULL}).if {
      semantic_error (position,"Type `Self' is not yet possible in a vector data slot.")
    }
  )

  //
  // Data slot of type Self: one copy for each concrete type.
  //

  + is_self_dependent:Boolean
  // The type of the data slot contains Self.

  + self_copy_type:Array Type
  + self_copy_list:Array Slot_data
  // Copies of the data slot for the concrete types other than @receiver_type.

  - to_run_type it:Itm_type for t:Type :Type_full <-
  // Type of the data slot for the concrete type @t: Self := @t.
  ( + p:Self_to_type
    + ts:Itm_type_mono
    + result:Type_full

    ts ?= it
    p := Self_to_type.create receiver_type self (t.default.to_exact)
    result := ts.to_run_for p pos (position.prototype.filename)
    (p.is_self_used).if {
      is_self_dependent := True
    }
    result
  )

  - slot_data_for t:Type :Slot_data <-
  // Data slot for a receiver of concrete type @t.
  ( + idx:Int
    + result:Slot_data

    result := slot_data
    ((is_self_dependent) && {t != NULL} && {t != receiver_type}).if {
      (self_copy_type = NULL).if {
        self_copy_type := Array Type .create_with_capacity 4
        self_copy_list := Array Slot_data .create_with_capacity 4
      }
      idx := self_copy_type.fast_first_index_of t
      (idx <= self_copy_type.upper).if {
        result := self_copy_list.at idx
      } else {
        result := Slot_data.create common_slot type_full (to_run_type result_type for t)
        result.set_self_type (t.default.to_exact)
        self_copy_type.add_last t
        self_copy_list.add_last result
      }
    }
    result
  )
  
