Header
  + name := Local
/*Local slot*/
Inherit

  + parent_variable:Flat Variable

Public

  // BSBS: Doit pas etre utile.

  + is_result :Boolean := False
  
  + lpow:Local
  + pow:Int := 1
  - set_pow n:Int loc p:Local <- ( (pow,lpow) := (n,p) )
  
  - set_result r:Boolean <-
  (
    is_result := r
  )

  //
  // Copy alias manager.
  //

  - is_alias:Boolean

  - alias_on <-
  (
    is_alias := True
  )

  - alias_off <-
  (
    (list_alias.lower).to (list_alias.upper) do { j:Int
      list_alias.at j.set_my_alias NULL
    }
    list_alias.clear
    is_alias := False
  )

  - list_alias:Array Local := Array Local .create_with_capacity 64

  - get_alias:Local <-
  (
    (my_alias = NULL).if {
      my_alias := my_copy
      my_alias.set_type_set type_set
      list_alias.add_last self
    }
    my_alias
  )

  + my_alias:Local

  - set_my_alias new_loc:Local <-
  (
    my_alias := new_loc
  )

  + list_level:Int // Use generate with ALIASER_LOCAL

  - set_list_level lev:Int <-
  (
    list_level := lev
  )

  - write p:Position with r:Expr value val:Expr :Write <-
  ( + result:Write

    (my_alias != NULL).if {
      result := my_alias.write_direct p with NULL value val
    }.elseif {is_alias /*&& {list_level >= current_list_level}*/} then {
      result := get_alias.write_direct p with NULL value val
    } else {
      result := write_direct p with NULL value val
    }
    result
  )

  - read p:Position with r:Expr :Read <-
  ( + result:Read

    (my_alias != NULL).if {
      result := my_alias.read_direct p with NULL
    }.elseif {is_alias /*&& {list_level >= current_list_level}*/} then {
      //intern_name.print; "list_level=".print; list_level.print; '/'.print; current_list_level.println
      // Case : Argument function (see CALL_SLOT)
      result := get_alias.read_direct p with NULL
    } else {
      //? {! is_alias}
      result := read_direct p with NULL
    }
    result
  )

  //
  // Sequence optimizer
  //

  + last_seq:Local_seq

  - reset_last_write w:Write <-
  (
    ((last_seq != NULL) && {last_seq.last_write = w}).if {
      last_seq.set_last_write NULL
    }
  )

  - set_last_seq s:Local_seq <-
  (
    last_seq := s
  )

  - set_write w:Write <-
  (
    (last_seq = NULL).if {
      Local_seq.new self
      //"LOCAL:".print
      //intern_name.print; '\n'.print
    }
    (
      (! Profil.mode_recursive) &&
      {loop_invariant = NULL} &&
      {last_seq.last_write != NULL} &&
      {last_seq.last_index != -1} &&
      {last_seq.last_list_current = list_current} &&
      {last_seq.last_index < list_current.index}  &&
      {last_seq.last_seq_call_local_and_loop = seq_call_local_and_loop} &&
      {list_current.at (last_seq.last_index) = last_seq.last_write} // BSBS: Voir pourquoi pas tjrs le cas
    ).if {
      list_current.at (last_seq.last_index) put (last_seq.last_write.value)
      unwrite (last_seq.last_write)
      new_execute_pass
    }
    // Save context
    last_seq.set_seq w
  )

  - set_read <-
  (
    (last_seq != NULL).if {
      last_seq.set_last_index (-1)
    }
  )

  - get_last_index:Int <- last_seq.last_index

  - is_invariant:Boolean <-
  (
    (loop_seq_call_local_and_loop = seq_call_local_and_loop) &&
    {
      (
        (last_seq != NULL) && {last_seq.last_write != NULL} &&
        {last_seq.last_seq_index <= loop_seq_index}
      ) || {style = ' '}
    }
  )

  - get_last_value rec:Expr :Expr <-
  [
    ? {rec = NULL}
  ]
  ( + result:Expr
    + val:Expr
    + rd:Read
    + l:Local
    + g:Slot_data
    (
      (! Profil.mode_recursive) && {loop_invariant = NULL} &&
      {last_seq != NULL} && {last_seq.last_write != NULL}
    ).if {
      (
        (is_seq_list (last_seq.last_list_current)) &&
        {
          (last_seq.last_seq_call_local_and_loop = seq_call_local_and_loop) || {require_count = 1}
        }
      ).if {
        val := last_seq.last_write.value
        rd  ?= val
        (rd != NULL).if {
          l ?= rd.variable
          g ?= rd.variable
        }
        (
          ( // Constant propagation.
            val.is_constant
          ) || { // Local propagation.
            (l != NULL) && {
              (
                (l.last_seq != NULL) && {l.last_seq.last_write != NULL} &&
                {l.last_seq.last_seq_index < last_seq.last_seq_index} &&
                {last_seq.last_seq_call_local_and_loop = seq_call_local_and_loop}
              ) || {(l.require_count <= 1) && {l.style != 'R'}} || {l.style = ' '}
            }
          } || { // Global propagation.
            (g != NULL) && {g.style = '-'} && {
              (
                (g.last_write != NULL) && {g.last_seq_index < last_seq.last_seq_index} &&
                {last_seq.last_seq_call_and_loop = seq_call_and_loop} &&
                {is_seq_list (g.last_list_current)}
              ) || {g.require_count = 1}
            }
          }
        ).if {
          result := val.my_copy
        }.elseif {
          // Propagation step by step.
          (last_seq.last_seq_or_and = seq_or_and) &&
          {ensure_count = 1} && {list_current.index > list_current.lower} &&
          {list_current.at (list_current.index - 1) = last_seq.last_write}
        } then {
          unwrite (last_seq.last_write)
          last_seq.set_last_write NULL
          list_current.at (list_current.index - 1) put Nop
          result := val
        }
      }
    }
    result
  )

  - set_type_set t:Types <-
  (
    type_set := t
  )

  //
  //
  //

  - is_local:Boolean <- True

  //
  // Creation.
  //

  - create p:Position name n:String_alias
  style c:Char type t:Type_full result r:Boolean :Self<-
  ( + result:Self
    result := clone
    result.make p name n style c type t result r
    result
  )

  - create p:Position name n:String_alias
  style c:Char type t:Type_full :Self<-
  ( + result:Self
    result := clone
    result.make p name n style c type t result False
    result
  )

  - make p:Position name n:String_alias
  style c:Char type t:Type_full result r:Boolean <-
  ( + tmp:Types_tmp
    ? {p.code != 0}
    ? {t != NULL}
    
    //list_level := current_list_level
    
    position    := p
    name        := n
    is_result   := r
    intern_name := get_intern n type False
    //(name = "block").if { "LOCAL:".print; intern_name.println }

    ((t.is_flat) && {! t.is_flat_c}).if {
      type := t + Type_full.flat_ref_bit
    } else {
      type := t
    }
    style := c

    (is_static).if {
      tmp := Types_tmp.new
      tmp.add (t.raw)
      type_set := tmp.to_types
    } else {
      type_set := Types_tmp.types_empty
    }
  )

  - my_copy:Local <-
  ( + result:Local

    result := Local.create position name name style style type type
    result
  )

  //
  // Value.
  //

  - init <-
  ( + val:Expr
    + i:Instr
    + int:Int_cst

    val := type.default_value position
    (is_integer (type.raw.name)).if {
      int ?= val
      (int != NULL).if {
        int.cast_type type
      }
    } else {
      val := val.check_type type with position
    }
    i := write position value val
    list_current.add_last i
  )

  - set_intern_name n:String_alias <-
  (
    intern_name := n
  )

Variable

  - new_read p:Position with r:Expr :Read <-
  [ -? {r = NULL}; ]
  (
    Read_local.create p with self
  )

  - new_write p:Position with r:Expr value v:Expr :Write <-
  [ -? {r = NULL}; ]
  ( + result:Write
    result := Write_local.create p with v in self
    result
  )

  /*
  - new_access r:EXPR :ACCESS <-
  (
    ACCESS_LOCAL.create self
  )
  */



