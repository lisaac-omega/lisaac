Header
  + name := Named
/*Parent for all slot*/
Inherit

  + parent_itm_object:Flat Itm_object

Public

  //
  // Data.
  //

  + style:Char;  // '+': Clonable,
                      // '-': Shared.
                      // ' ': Argument
                      // 'R': Result
                      // 'T': Temporary
                      // 'C': Cast

  + name:String_alias
    
  - set_style s:Char <-
  (
    style := s
  )

  //
  // Hashable.
  //

  - hash_code: Int <- name.hash_code





