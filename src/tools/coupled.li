Header
  + name := Coupled(E)
/*Couple object*/
Inherit

  - parent_any:Any := Any

Public

  + first :E
  + second:E

  - create elt1:E and elt2:E :Self <-
  ( + result:Self

    result := clone
    result.make elt1 and elt2
    result
  )

  - make elt1:E and elt2:E <-
  (
    first  := elt1
    second := elt2
  )
