Header
  + name := Types_tmp
/*Aliser TYPE collection.*/
Inherit

  + parent_types_set:Flat Types_set

Insert

  - parent_recyclable:Recyclable := Recyclable

Private

  - bucket:Array (Exact Types_set) := Array (Exact Types_set).create_with_capacity 3000; // BSBS: A mettre dans TYPES_SET

  - bucket_hash:Array (Array (Exact Types_set)) := Array (Array (Exact Types_set)).create 4096
  // @bucket by hash code (see @to_types), to find a @Types_set without scanning all @bucket.

  + capacity:Int

  - merge_storage:C_array Type
  // Spare buffer of @union, swapped with @storage.

  - merge_capacity:Int

  - make_types_tmp <-
  (
    count := 0
    capacity := 128
    storage  := C_array Type .calloc_intern capacity
  )
  [ +? {is_empty}; ]

Public

  - print_all <-
  ( + t:Types
    
    (bucket.lower).to (bucket.upper) do { j:Int
      t := bucket.at j
      t.types_print
      '\n'.print
    }
  )

Public

  - types_empty:Types := Types_set

  //
  // Creation.
  //
  
  - init <- make_types_tmp

  - update t:Types :Types <-
  [
    -? { + tmp:Types_tmp; tmp ?= t; tmp = NULL}
  ]
  ( + result:Types

    ((t != NULL) && {t.count = count}).if {
      result := t
      free
    } else {
      result := to_types
    }
    result
  )

  - to_types:Types <-
  ( + result:Types
    + nw,t:Exact Types_set
    + lst:Array (Exact Types_set)
    + j,i,h:Int

    (is_empty).if {
      result := types_empty
    } else {
        
      (count = 1).if {
        result := first
      }/*.elseif {(count = 2) && {first = TYPE_NULL}} then {
        result := at 1.types_with_null
        (result = NULL).if {
          t := TYPES_SET.create self
          at 1.set_types_with_null t
          result := t
        }
      }*/ else {
        h := (count + first.index * 3 + at 1.index * 7 + at (count - 1).index * 13) & 4095
        lst := bucket_hash.at h
        (lst = NULL).if {
          lst := Array (Exact Types_set).create_with_capacity 4
          bucket_hash.at h put lst
        }
        j := lst.lower
        {(j <= lst.upper) && {result = NULL}}.while_do {
          t := lst.at j
          ((count = t.count) && {at 1 = t.at 1} && {first = t.first}).if {
            i := 2
            {(i < count) && {at i = t.at i}}.while_do { i := i + 1; }
            (i = count).if {
              result := t
            }
          }
          j := j + 1
        }
        (result = NULL).if {
          nw := Types_set.create self
          ? {nw != NULL}
          bucket.add_last nw
          lst.add_last nw
          result := nw
        }
      }
    }
    free
    result
  )

  - clear <-
  (
    count := 0
  )

  - free <-
  (
    clear
    parent_recyclable.free
  )

  //
  // Update list.
  //
  
  - remove i:Int <-
  ( 
    (i+1).to (count-1) do { j:Int
      storage.put (at j) to (j - 1)
    }
    count := count - 1
  )

  - add t:Type <-
  ( + idx:Int

    (is_empty).if {
      add_last t
    } else {
      idx := search t from 0 to count
      (idx = count).if {
        add_last t
      }.elseif {at idx != t} then {
        add t to idx
      }
    }
  )
  [ ? {order_test}; ]
    
  - union other:Types <-
  // Linear merge into @merge_storage, then the two buffers are swapped.
  // Same order as inserting each type of @other in place: @Types_set are shared by content.
  ( + i,j,n,new_count,new_capacity,t2idx:Int
    + t2:Type
    + out,src:C_array Type
    + set:Types_set

    // @other is a @Types_set or a single @Type: below, @src avoids a dispatch on @other by type.
    set ?= other
    (set = NULL).if {
      n := 1
    } else {
      n := set.count
      src := set.storage
    }
    (n = 0).if {
      // Nothing.
    }.elseif {is_empty} then {
      (n > capacity).if {
        storage := storage.realloc capacity with n
        capacity := n
      }
      (set = NULL).if {
        storage.at 0 put (other.first)
      } else {
        storage.copy_from src until (n - 1)
      }
      count := n
    }.elseif {n <= 4} then {
      // Few types: binary search and in place insertion.
      {j = n}.until_do {
        t2    := other.at j
        t2idx := t2.index
        i := lower_bound t2idx from i
        {(i < count) && {at i.index = t2idx} && {at i != t2}}.while_do {
          i := i + 1
        }
        ((i = count) || {at i != t2}).if {
          add t2 to i
        }
        i := i + 1
        j := j + 1
      }
    } else {
      // @n > 4: @other is a @Types_set.
      n := count + n
      (n > merge_capacity).if {
        new_capacity := n * 2
        (new_capacity < 128).if {
          new_capacity := 128
        }
        merge_storage := C_array Type .calloc_intern new_capacity
        merge_capacity := new_capacity
      }
      out := merge_storage
      {j = set.count}.until_do {
        t2    := src.at j
        t2idx := t2.index
        {(i < count) && {at i.index < t2idx}}.while_do {
          out.at new_count put (at i)
          new_count := new_count + 1
          i := i + 1
        }
        {(i < count) && {at i.index = t2idx} && {at i != t2}}.while_do {
          out.at new_count put (at i)
          new_count := new_count + 1
          i := i + 1
        }
        ((i < count) && {at i = t2}).if {
          i := i + 1
        }
        out.at new_count put t2
        new_count := new_count + 1
        j := j + 1
      }
      {i < count}.while_do {
        out.at new_count put (at i)
        new_count := new_count + 1
        i := i + 1
      }
      merge_storage  := storage
      storage        := out
      new_capacity   := capacity
      capacity       := merge_capacity
      merge_capacity := new_capacity
      count := new_count
    }
  )
  [ ? {order_test}; ]

Private
  
  - add_last t:Type <-
  ( + new_capacity:Int

    (count + 1 > capacity).if {
      new_capacity := capacity * 2
      storage := storage.realloc capacity with new_capacity
      capacity := new_capacity
    }
    count := count + 1
    storage.at (count - 1) put t
  )

  - add t:Type to index:Int <-
  ( + new_capacity:Int
    (index = count).if {
      add_last t
    } else {
      (count > capacity - 1 ).if {
        new_capacity := capacity * 2
        storage := storage.realloc capacity with new_capacity
        capacity := new_capacity
      }
      count := count + 1
      (count - 2).downto index do { i:Int
        storage.at (i + 1) put (at i)
      }
      storage.at index put t
    }
  )

  - lower_bound idx:Int from beg:Int :Int <-
  // First position from @beg whose type index is not lower than @idx.
  ( + low,high,middle:Int

    low  := beg
    high := count
    {low < high}.while_do {
      middle := (low + high) >> 1
      (at middle.index < idx).if {
        low := middle + 1
      } else {
        high := middle
      }
    }
    low
  )

  - search t:Type from beg:Int to end:Int :Int <-
  // Dichotomic research.
  ( + middle,result:Int

    ((end - beg) < 2).if {
      (t.index > at beg.index).if {
        result := end
      } else {
        result := beg
      }
    } else {
      middle := (beg + end) >> 1
     
      (t.index > at middle.index).if {
        result := search t from middle to end
      }.elseif {t.index < at middle.index} then {
        result := search t from beg to middle
      } else {
        {(middle > beg) && {at middle.index = t.index}}.while_do {
          middle := middle - 1
        }
        {(middle <= end) && {at middle != t}}.while_do {
          middle := middle + 1
        }
        result := middle
      }
    }
    result
  )

  - order_test:Boolean <-
  ( + j:Int

    {(j < count-1) && {at j.index <= at (j+1).index}}.while_do {
      j := j + 1
    }
    j >= count - 1
  )


  
