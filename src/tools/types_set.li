Header
  + name := Types_set
/*Aliser TYPE collection.*/
Inherit

  - parent_types:Types := Types

Types_set

  + storage:C_array Type
  
Public
  
  - first_index:Int <-
  ( + result:Int
    (count = 0).if {
      result := -1
    }
    result
  )
  
  + count:Int
  
  - next_index i:Int :Int <-
  ( + result:Int
    
    (i < count-1).if {
      result := i + 1
    } else {
      result := -1
    }
    result
  )
  
  - first:Type <-
  (
    at 0
  )
  
  - at i:Int :Type <-
  (    
    storage.at i
  )
  
  //
  // Display.
  //

  - types_append_in buf:String_buffer <-
  ( 
    (! is_empty).if {
      0.to (count - 2) do { j:Int
        at j.append_name_in buf
        buf.add_last '('
        at j.index.append_in buf
        buf.append ") x "
      }
      at (count-1).append_name_in buf
      buf.add_last '('
      at (count-1).index.append_in buf
      buf.add_last ')'
    } else {
      buf.append "<Vide>"
    }
  )

Types_tmp

  - create tab:Types_tmp :Exact Types_set <-
  ( + result:Self

    result := clone
    result.make tab
    result
  )

  - make tab:Types_tmp <-
  ( 
    count := tab.count
    storage := C_array Type .calloc_intern count
    storage.copy_from (tab.storage) until (count-1)
  )
