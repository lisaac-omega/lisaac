Header
  + name := Couple(E,F)
Inherit

  - parent_any:Any := Any

Public

  + first :E
  + second:F

  - create elt1:E and elt2:F :Self <-
  ( + result:Self

    result := clone
    result.make elt1 and elt2
    result
  )

  - make elt1:E and elt2:F <-
  (
    first  := elt1
    second := elt2
  )
