Header
  - name := Table
/*Display array manager.*/
Inherit

  - parent_clone:Clone := Clone

Private

  - table:Array2 String := Array2 String .create (10,10)

  - size:Array Int := Array Int .create_with_capacity 10

  - line:Int
  - column:Int

Public

  - new_table (l,c:Int) <-
  (
    table.make (l,c)
    line := column := 0
  )

  - add n:String <-
  (
    ? {n != NULL}

    table.put n to (line,column)
    (column = table.upper2).if {
      column := 0
      line   := line + 1
    } else {
      column := column + 1
    }
  )

  - append_in buffer:String_buffer <-
  ( + siz:Int
    + append_line,append_bar:Block

    // Size column.
    size.make (table.count2)
    0.to (table.upper1) do { l:Int
      0.to (table.upper2) do { c:Int
        siz := table.at (l,c).count
        (siz > size.at c).if {
          size.put siz to c
        }
      }
    }

    // Sub-code for one line.
    append_line :=
    { l:Int
      + n:String
      buffer.append "// "
      0.to (table.upper2) do { c:Int
        n := table.at (l,c)
        buffer.append "| "
        buffer.append n
        buffer.extend_multiple ' ' by (size.at c - n.count + 1)
      }
      buffer.append "|\n"
    }
    append_bar :=
    {
      buffer.append "// "
      0.to (table.upper2) do { c:Int
        buffer.add_last '+'
        buffer.extend_multiple '-' by (size.at c + 2)
      }
      buffer.append "+\n"
    }

    // Display Header.
    append_bar.value
    append_line.value 0
    append_bar.value
    // Display table.
    1.to (table.upper1) do { l:Int
      append_line.value l
    }
    // Display End.
    append_bar.value
  )
