Header
  + name := Slim_array E
/* BSBS: A mettre en Flat.*/
Insert

  - parent_clone:Clone := Clone

Private

  // Champs internes :
  // Capacité et compteur d'éléments présents
  + capacity:Int
  + counter:Int

  // Utilisé comme first et tableau
  + array:C_array E

  // MHMH :
  // Une capacité à 0 signifie que l'on utilise array comme stockage.

Public

  //
  // Informations :
  //

  // Borne inférieure :
  // MHMH : Version originale... en fonction ?? - lower:Int <- 0
  - lower:Int := 0

  // Borne supérieure :
  - upper:Int <- (counter - 1)

  // Nombre d'éléments :
  - count:Int <- (counter)

  // Test de vacuité :
  - is_empty:Boolean <- ( counter = 0 )

  //
  // Création/Initialisation :
  //
  
  - create_with_capacity n:Int :Self <-
  ( + result:Self
    result := clone
    result.make_with_capacity n
    result
  )
  
  - make_with_capacity n:Int <-
  (
    // Réinitialisation :
    capacity := 0
    counter := 0
    array := NULL

    // Allocation si nécessaire :
    (n > 1).if {
      array := C_array E .create n
      capacity := n
    }
  )

  //
  // Accès en lecture :
  //

  - first:E <-
  ( + return:E
    (capacity = 0).if {
      return := Cast (C_array E) To E.on array
    } else {
      return := array.at 0
    }
    return
  )

  - last:E <-
  ( + return:E

    (capacity = 0).if {
      return := Cast (C_array E) To E.on array
    } else {
      return := array.at upper
    }

    return
  )

  - at i:Int:E <-
  (
    + return:E

    (capacity = 0).if {
      return := Cast (C_array E) To E.on array
    } else {
      return := array.at i
    }

    return
  )

  //
  // Accès en lecture :
  //

  - at i:Int put e:E <-
  (
    (capacity = 0).if {
      array := Cast E To (C_array E).on e
    } else {
      array.at i put e
    }
  )

  - add_last e:E <-
  (
    (capacity = 0).if {
      (counter = 0).if {
        array := Cast E To (C_array E).on e
        counter := counter + 1
      } else {
        + tmp:E
        // Sauvegarde élément courant :
        tmp := Cast (C_array E) To E.on array
        // Création tableau :
        array := C_array E .create 4
        capacity := 4
        counter := 2
        // Restauration éléments :
        at 0 put tmp
        at 1 put e
      }
    } else {
      // Allocation de place supplémentaire si besoin :
      (counter = capacity).if {
        + new_cap:Int
        new_cap := capacity*2
        array := array.realloc capacity with new_cap
        capacity := new_cap
      }
      counter := counter+1
      at upper put e
    }
  )

  // MHMH : remplacé par utilisation de list
  // + first:E

