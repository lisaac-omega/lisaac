Header
  + name := Profil
/*Method with costumization*/
Insert
  
  + parent_lisaac_common:Flat Lisaac_common
  
Inherit


  - parent_parameter_to_type:Flat Parameter_to_type

Profil_list

  + life_index:Int

  - set_life_index idx:Int <-
  (
    life_index := idx
  )

Public
  
  - profil_add_alias:Profil
  - profil_hash_code_alias:Profil
  
  - arg_type_tmp:Array Expr
  - parameter_to_type p:Itm_type_parameter :Type_full <-
  ( + idx:Int
    + result:Type_full

    (p.name = str_self).if {
      // For self.
      result := type_self
    } else {
      // For Genericity.
      result := slot_code.receiver_type.parameter_to_type p
      (result = NULL).if {
        // For Type parametric.
        idx := slot_code.get_index_argument_type p
        (idx != - 1).if {
          result := arg_type_tmp.at idx.static_type + Type_full.generic_bit
        }
      }
    }
    result
  )

  - propagation_external <-
  (
    (external_present).if_false {
      external_present := True
      (set_back.lower).to (set_back.upper) do { j:Int
        set_back.at j.propagation_external
      }
    }
  )

Public

  //
  // Graph info.
  //

  - hash_code:Int <- name.hash_code

  + external_present:Boolean

  + set_call:Hmap Int Key Profil

  + set_back:Hset(Profil)

  - add_call p:Profil <-
  ( + found:Boolean ; + cnt:Int
    // DCDC petite optim:
    (found, cnt) := set_call.search p
    if found then {
      cnt := cnt + 1
    } else {
      cnt := 1
    }
    
    set_call.at p put cnt
    
    p.set_back.fast_add self
  )

  - alloc_profil_main <-
  (
    set_call := new Hmap Int Key Profil
    set_back := Hset Profil.create
    name := "main"
  )

  - set_external_present b:Boolean <-
  (
    external_present := b
  )

  //
  //
  //

  - slot:Slot <- abstract

  - is_interrupt:Boolean

  - is_external:Boolean

  + type_self:Type_full

  + argument_list:Array Local

  + result_list:Slim_array Local

  + code:List
  + context:Local

  + count_intern_call:Int

  + link_count:Int
  + cop_link_count:Int

  //
  // COP escape analysis (see @Escape), for the pass @esc_pass.
  //

  + esc_pass:Int
  + esc_leaks:Boolean
  // `self' escapes.
  + esc_returns_fresh:Boolean
  + esc_return_ok:Boolean
  + esc_self_calls:Array Profil
  + esc_self_writes:Array Escape_event
  // Writes in `self' (directly or by the calls on `self').
  + esc_arg_leaks:Array Int
  // Indexes of the arguments (not `self') which escape: the function keeps them.
  + esc_arg_not_fresh:Array Int
  // Indexes of the arguments not always given fresh (not escaped) by the callers.

  - esc_reset p:Int <-
  (
    esc_pass := p
    esc_leaks := False
    esc_returns_fresh := False
    esc_return_ok := False
    esc_self_calls := NULL
    esc_self_writes := NULL
    esc_arg_leaks := NULL
    esc_part_leaks := NULL
    esc_part_leak_index := NULL
    esc_arg_leaks_out := NULL
    esc_flow_targets := NULL
    esc_flow_sources := NULL
    esc_flow_types := NULL
    esc_arg_not_fresh := NULL
  )

  - esc_is_arg_not_fresh j:Int :Boolean <-
  (esc_arg_not_fresh != NULL) && {esc_arg_not_fresh.fast_first_index_of j <= esc_arg_not_fresh.upper}

  - esc_set_arg_not_fresh j:Int :Boolean <-
  ( + result:Boolean
    (esc_is_arg_not_fresh j).if_false {
      (esc_arg_not_fresh = NULL).if {
        esc_arg_not_fresh := Array Int .create_with_capacity 2
      }
      esc_arg_not_fresh.add_last j
      result := True
    }
    result
  )

  - esc_is_arg_leak j:Int :Boolean <-
  (esc_arg_leaks != NULL) && {esc_arg_leaks.fast_first_index_of j <= esc_arg_leaks.upper}

  - esc_add_arg_leak j:Int :Boolean <-
  ( + result:Boolean
    (esc_is_arg_leak j).if_false {
      (esc_arg_leaks = NULL).if {
        esc_arg_leaks := Array Int .create_with_capacity 2
      }
      esc_arg_leaks.add_last j
      result := True
    }
    result
  )

  + esc_part_leaks:Array Type_full
  + esc_part_leak_index:Array Int
  // Parts of the arguments (objects reached by their fields) kept by the function: the type of
  // the part, and the index of the argument (see @Escape.evaluate).

  - esc_add_part_leak j:Int type t:Type_full :Boolean <-
  ( + result:Boolean
    + i:Int
    (esc_part_leaks = NULL).if {
      esc_part_leaks := Array Type_full .create_with_capacity 2
      esc_part_leak_index := Array Int .create_with_capacity 2
    }
    i := esc_part_leaks.lower
    {(i <= esc_part_leaks.upper) && {(esc_part_leak_index.at i != j) || {esc_part_leaks.at i != t}}}.while_do {
      i := i + 1
    }
    (i > esc_part_leaks.upper).if {
      esc_part_leaks.add_last t
      esc_part_leak_index.add_last j
      result := True
    }
    result
  )

  + esc_flow_targets:Array Int
  + esc_flow_sources:Array Int
  + esc_flow_types:Array Type_full
  // What the function stores in its parameters (or their parts): in the parameter (target)
  // @esc_flow_targets.at i, a value of type @esc_flow_types.at i, from the parameter (source)
  // @esc_flow_sources.at i, or from elsewhere (-1). Index 0: `self' (see @Escape.evaluate).

  - esc_add_flow t:Int from s:Int type ty:Type_full :Boolean <-
  ( + result:Boolean
    + i:Int
    (esc_flow_targets = NULL).if {
      esc_flow_targets := Array Int .create_with_capacity 2
      esc_flow_sources := Array Int .create_with_capacity 2
      esc_flow_types := Array Type_full .create_with_capacity 2
    }
    i := esc_flow_targets.lower
    {(i <= esc_flow_targets.upper) && {(esc_flow_targets.at i != t) || {esc_flow_sources.at i != s} || {esc_flow_types.at i != ty}}}.while_do {
      i := i + 1
    }
    (i > esc_flow_targets.upper).if {
      esc_flow_targets.add_last t
      esc_flow_sources.add_last s
      esc_flow_types.add_last ty
      result := True
    }
    result
  )

  + esc_arg_leaks_out:Array Int
  // The arguments kept elsewhere than into the parameters (see @Escape.is_leak_out).

  - esc_is_arg_leak_out j:Int :Boolean <-
  (esc_arg_leaks_out != NULL) && {esc_arg_leaks_out.fast_first_index_of j <= esc_arg_leaks_out.upper}

  - esc_add_arg_leak_out j:Int :Boolean <-
  ( + result:Boolean
    (esc_is_arg_leak_out j).if_false {
      (esc_arg_leaks_out = NULL).if {
        esc_arg_leaks_out := Array Int .create_with_capacity 2
      }
      esc_arg_leaks_out.add_last j
      result := True
    }
    result
  )

  - esc_set_leaks <- ( esc_leaks := True; )
  - esc_set_returns_fresh b:Boolean <- ( esc_returns_fresh := b; )
  - esc_set_return_ok b:Boolean <- ( esc_return_ok := b; )

  - esc_add_self_call p:Profil <-
  (
    (esc_self_calls = NULL).if {
      esc_self_calls := Array Profil .create_with_capacity 2
    }
    (esc_self_calls.fast_first_index_of p > esc_self_calls.upper).if {
      esc_self_calls.add_last p
    }
  )

  - esc_add_self_write e:Escape_event :Boolean <-
  ( + result:Boolean
    (esc_self_writes = NULL).if {
      esc_self_writes := Array Escape_event .create_with_capacity 2
    }
    (esc_self_writes.fast_first_index_of e > esc_self_writes.upper).if {
      esc_self_writes.add_last e
      result := True
    }
    result
  )

  + name:String_alias

  - is_context_sensitive:Boolean <- abstract

  + stat:Int8 := -1
  // 00 : No recursive, No inlinable.
  // 01 : No recursive, Inlinable.
  // 10 : Recusive,     No tail.
  // 11 : Recusive,     Tail

  - reset_recursive <-
  (
    stat := -1
    count_intern_call := 0
  )

  - recursivity_bit:Int8 := 10b
  - inlining_bit:Int8    := 01b

  - is_not_tail_recursive:Boolean <- stat = 10b
  - is_inlinable:Boolean          <- stat = 01b
  - is_recursive:Boolean          <- (stat & recursivity_bit) != 0
  - is_no_inlinable:Boolean       <- (is_interrupt) || {is_external} || {self = profil_add_alias} || {self = profil_hash_code_alias}

  //

  - mode_recursive:Boolean

  - set_mode_recursive b:Boolean <-
  (
    mode_recursive := b
  )

  - set_life <-
  (
    Profil_list.set_life self
    (mode_recursive).if {      
      execute_recursive
    }
  )

  - link call:Call_slot <-
  (
    (call.cop_argument != NULL).if {
      cop_link_count := cop_link_count + 1
    } else {
      link_count := link_count + 1
    }
  )

  - unlink call:Call_slot <-
  (
    (call.cop_argument != NULL).if {
      cop_link_count := cop_link_count - 1
      ? {cop_link_count >= 0}
    } else {
      link_count := link_count - 1
      ? {link_count >= 0}
    }
  )

  - write_argument args:Array Expr :Array Write <-
  ( + loc:Local
    + val:Expr
    + wrt:Write
    + result:Array Write

    (args.count != argument_list.count).if {
      string_tmp.copy "Incorrect vector size. (Call #"
      args.count.append_in string_tmp
      string_tmp.append " / Def. #"
      argument_list.count.append_in string_tmp
      string_tmp.add_last ')'
      semantic_error (args.last.position,string_tmp)
    }

    result := Array Write .create_with_capacity (argument_list.count)
    (argument_list.lower).to (argument_list.upper) do { j:Int
      loc := argument_list.at j
      val := args.at j
      (loc != NULL).if {
        wrt := loc.write (val.position) value val
        result.add_last wrt
      } else {
        result.add_last NULL
        val.remove
      }
    }
    result
  )

  //
  // Comparaison.
  //

  - lookup n:String_alias :Local <-
  ( + j:Int
    + result:Local
        
    j := argument_list.lower
    {(j > argument_list.upper) || {argument_list.at j.name = n}}.until_do {
      j := j + 1
    }
    (j <= argument_list.upper).if {
      result := argument_list.at j
    }.elseif {result_list != NULL} then {
      j := result_list.lower
      {(j > result_list.upper) || {result_list.at j.name = n}}.until_do {
        j := j + 1
      }
      (j <= result_list.upper).if {
        result := result_list.at j
      }
    }

    result
  )

  //
  // Execute.
  //

  - remove_inline <-
  (
    Profil_list.remove self
  )

  - remove <-
  (
    code.remove
  )

  - search_and_convert_tail_recursive <-
  ( + switch:Switch
    + msg:Call_slot
    + lst:List
    + count_recur:Int

    (
      (! mode_recursive) && {is_not_tail_recursive} &&
      {! code.is_empty} && {result_list.is_empty}
    ).if {
      switch ?= code.last
      (switch != NULL).if {
        // Verification cases:
        (switch.list.lower).to (switch.list.upper) do { j:Int
          lst := switch.list.at j.code
          (lst.is_empty).if_false {
            msg ?= lst.last
            // A COP message (to another universe) is not a recursive call: never a loop.
            ((msg != NULL) && {msg.profil = self} && {msg.cop_argument = NULL} && {! msg.is_cop_sync}).if {
              count_recur := count_recur + 1
            }
          }
        }
        (count_recur = switch.list.count).if {
          semantic_error (slot.position,"Recursivity without end.")
        }
        ((count_intern_call - 1) = count_recur).if {
          ((link_count = count_intern_call) || {! is_context_sensitive}).if {
            new_execute_pass
            stat := 0
            convert_tail_recursive
          }
        }
      }
    }
  )

  - i_am_the_last i:Instr :Boolean <-
  (
    code.i_am_the_last i
  )

  - execute_recursive <-
  ( + old_list_current:List
    + old_profil_current:Profil

    (stat = -1).if {
      count_intern_call := count_intern_call + 1
      (count_intern_call = 1).if {
        old_list_current   := list_current
        old_profil_current := profil_current
        //
        profil_current := self
        execute 3
        //
        list_current   := old_list_current
        profil_current := old_profil_current
        ? {code != NULL}
        (count_intern_call = 1).if {
          stat := 0
        } else {
          stat := recursivity_bit
        }
      }
    }
  )

  - execute inline_lev:Int <-
  ( + old_seq_inline:Uint32

    list_current  := NULL
    old_seq_inline := seq_inline

    Call_slot.reset_count_context_sensitive

    seq_call_and_loop := seq_call_and_loop + 1

    search_and_convert_tail_recursive

    Escape.begin_profil self
    code ?= code.execute
    // Nettoyer les result ...
    (result_list != NULL).if {
        (result_list.lower).to (result_list.upper) do { i:Int
          ((result_list.at i != NULL) && {result_list.at i.ensure_count = 0}).if {
            result_list.at i put NULL
          }
        }
    }
    Local_seq.clear

    seq_call_and_loop := seq_call_and_loop + 1
    (
      (
        (
          (Call_slot.count_context_sensitive = 0) &&
          {! mode_recursive} && {stat = 0} &&
          {is_context_sensitive || {(seq_inline - old_seq_inline) <= inline_lev}}
        ) //|| {link_count = 1}
      ) /*&& {! is_interrupt} && {! is_external} &&
      {self != profil_add_alias} && {self != profil_hash_code_alias}*/
      
    ).if {
      stat := stat | inlining_bit
    }
    (
      (is_external) && {argument_list.first != NULL} && {argument_list.first.ensure_count = 0}
    ).if {
      argument_list.at 0 put NULL
    }
    Push.end_function
  )

  //
  // Genere.
  //

  - is_static:Boolean <- abstract

  - genere_handler <-
  (
    (link_count != 0).if {
      genere_handler_intern
      output.append ";\n"
    }
    ((cop_link_count != 0) && {result_list.count = 0}).if {
      genere_handler_cop
      output.append ";\n"
    }
  )

  - genere_handler_intern <-
  ( + ts:Type_full
    + v:Local
    + i_result:Int

    ((output_list.count = 1) && {is_static}).if {
      output.append "static "
    }

    // Result.
    {(i_result <= result_list.upper) && {result_list.at i_result = NULL}}.while_do {
      i_result := i_result + 1
    }
    (i_result <= result_list.upper).if {
      ts := result_list.at i_result.type
      ts.genere_declaration output
      ts.genere_star_declaration output
      output.add_last ' '
      i_result := i_result + 1
    } else {      
      output.append "void "
    }

    // Name.
    output.append name
    output.add_last '('

    // Arguments.
    (argument_list.lower).to (argument_list.upper) do { j:Int
      v := argument_list.at j
      (v != NULL).if {
        ? {(v.style = ' ') || {v.style = '!'}}
        genere v result False in output
        output.add_last ','
      }
    }

    // Results.
    {i_result <= result_list.upper}.while_do {
      {(i_result <= result_list.upper) && {result_list.at i_result = NULL}}.while_do {
        i_result := i_result + 1
      }
      (i_result <= result_list.upper).if {
        v := result_list.at i_result
        v.set_result True
        genere v result True in output
        output.add_last ','
        i_result := i_result + 1
      }
    }
    //    
    (output.last = ',').if {
      output.remove_last
    }
    output.add_last ')'
  )

  - foreach_cop_param action:{Local;} <-
  // Arguments of a COP slot, passed by its message (`self' excluded).
  ( + v:Local
    (argument_list.lower).to (argument_list.upper) do { j:Int
      v := argument_list.at j
      ((v != NULL) && {v.name != "self"}).if {
        action.value v
      }
    }
  )

  - append_cop_param n:Int in buffer:String_buffer <-
  // Field of the @n-th argument in the message of the COP slot (`struct msg_...').
  (
    buffer.add_last 'p'
    n.append_in buffer
  )

  - genere_cop_param_field buffer:String_buffer <-
  ( + np:Int
    foreach_cop_param { v:Local
      buffer.append "  "
      v.type.genere_declaration buffer
      buffer.add_last ' '
      v.type.genere_star_declaration buffer
      append_cop_param np in buffer
      buffer.append ";\n"
      np := np + 1
    }
  )

  - genere_handler_cop <-
  (
    output.append "void COP_"
    output.append name
    output.append "(lith_object *obj,lith_msg *msg)"
  )

  - genere <-
  ( + v:Local

    ((stat & recursivity_bit) != 0).if {
      counter_recursivity_function := counter_recursivity_function + 1
    }
    counter_function := counter_function + 1
    (is_speed_push).if {
      Push_speed.start_c_function name
    }
    //
    profil_current := self
    ((link_count != 0) || {result_list.count != 0}).if {
      // Version normal.
      output.add_last '\n'
      genere_handler_intern
      output.add_last '\n'
      add_comment output
      //
      output.append "{\n"
      indent.append "  "
      code.genere_extern_result result_list
      indent.remove_tail 2
      output.append indent
      output.append "}\n"
      ((is_cop) && {cop_link_count != 0} && {result_list.count = 0}).if {
        // COP link: the procedure of the message calls the normal version.
        genere_cop_procedure_begin
        output.append "  "
        output.append name
        output.add_last '('
        (argument_list.lower).to (argument_list.upper) do { j:Int
          v := argument_list.at j
          (v != NULL).if {
            (output.last != '(').if {
              output.add_last ','
            }
            output.append (v.intern_name)
          }
        }
        output.append ");\n}\n"
      }
    } else {
      (is_cop).if {
        // COP direct.
        mark_cop_tail code
        genere_cop_procedure_begin
        indent.append "  "
        code.genere_extern_result NULL
        indent.remove_tail 2
        output.append "}\n"
      }
    }
  )

  - mark_cop_tail lst:List <-
  // The asynchronous messages at the end of @lst, through its branches: in the procedure of a
  // message (COP direct: the function is called by messages only), the last action of the
  // message (see @Call_slot.is_cop_tail).
  ( + msg:Call_slot
    + switch:Switch
    + sub:List
    ((lst != NULL) && {! lst.is_empty}).if {
      msg ?= lst.last
      switch ?= lst.last
      sub ?= lst.last
      ((msg != NULL) && {msg.cop_argument != NULL}).if {
        msg.set_cop_tail
      }
      (switch != NULL).if {
        (switch.list.lower).to (switch.list.upper) do { j:Int
          mark_cop_tail (switch.list.at j.code)
        }
      }
      (sub != NULL).if {
        mark_cop_tail sub
      }
    }
  )

  - genere_cop_procedure_begin <-
  // Beginning of the procedure `COP_...' of an asynchronous message: its arguments read
  // in the message, then the message freed.
  ( + v:Local
    + np:Int

    output.add_last '\n'
    genere_handler_cop
    output.add_last '\n'
    add_comment output
    output.append "{\n"
    (argument_list.lower).to (argument_list.upper) do { j:Int
      v := argument_list.at j
      (v != NULL).if {
        output.append "  "
        genere v result False in output
        (v.name = "self").if {
          output.add_last '='
          put_cast_self output
          output.append "obj;\n"
        } else {
          output.append "=((struct msg_"
          output.append name
          output.append " *)msg)->"
          append_cop_param np in output
          output.append ";\n"
          np := np + 1
        }
      }
    }
    output.append "  li_msg_free(msg);\n"
    type_self.raw.add_cop_profil self
    (is_cop_report).if {
      "  ".print
      slot.receiver_type.name.print
      '.'.print
      slot.name.print
      '\n'.print
    }
  )

  - genere_cop_msg_struct buffer:String_buffer <-
  // Message of this COP slot: its arguments.
  (
    buffer.append "struct msg_"
    buffer.append name
    buffer.append " {\n  lith_msg h;\n"
    genere_cop_param_field buffer
    buffer.append "};\n"
  )

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.append (slot.name)
    append_type buffer
  )

  - display_all buffer:String_buffer <-
  (
    display buffer
    code.display buffer
    buffer.append "\n---------------------\n"
  )

  //
  // Statistic
  //

  - nb_func_arg:Array2 Int     := Array2 Int .create (8,8)
  - nb_arg_size_type:Array Int := Array Int .create 64

//  - list_cpa:HSET(STRING) := HSET(STRING).create

Private

  - put_cast_self buffer:String_buffer <-
  (
    buffer.add_last '('
    type_self.genere_declaration buffer
    buffer.add_last ' '
    type_self.genere_star_declaration buffer
    buffer.add_last ')'
  )

  - add_comment buffer:String_buffer <-
  (
    buffer.append "/* "
    append_type buffer
    ((stat & 10b) = 0).if {
      buffer.append "No recursive, "
    } else {
      buffer.append "Recursive, "
    }
    ((stat & 01b) = 0).if {
      buffer.append "No inlinable."
    } else {
      buffer.append "Inlinable."
    }
    (is_context_sensitive).if {
      buffer.append " CONTEXT!"
    } else {
      buffer.append " NO CONTEXT!"
    }
    buffer.append " */\n"
  )

  - append_type buffer:String_buffer <-
  ( + v:Variable
    + nb_arg,nb_arg_poly,tmp:Int
    //+ s:SLOT

    buffer.add_last '('
    (argument_list.lower).to (argument_list.upper) do { j:Int
      v := argument_list.at j
      (v != NULL).if {
        nb_arg := nb_arg + 1; // BSBS à mettre ds le if
        (is_statistic).if {

          (v.type_set.count > 1).if {
            nb_arg_poly := nb_arg_poly + 1
          }
          tmp := v.type_set.count
          (tmp > nb_arg_size_type.upper).if {
            nb_arg_size_type.force 1 to tmp
          } else {
            nb_arg_size_type.at tmp put (
              nb_arg_size_type.at tmp + 1
            )
          }
        }
        v.type.display buffer
        v.display_type buffer
        buffer.add_last ','
      }
    }
    (is_statistic).if {
      (
        (nb_arg      > nb_func_arg.upper1) || {nb_arg_poly > nb_func_arg.upper2}
      ).if {
        warning_error (position,"Too much arguments for a statistic.")
      } else {
        tmp := nb_func_arg.at (nb_arg,nb_arg_poly) + 1
        nb_func_arg.at (nb_arg,nb_arg_poly) put tmp
      }
    }
    (buffer.last = ',').if {
      buffer.remove_last
    }
    buffer.add_last ')'
    (result_list.is_empty).if {
      buffer.append " Void "
    } else {
      buffer.append " With result "
    }
  )

  - genere v:Local result is_res:Boolean in buffer:String_buffer <-
  ( + ts:Type_full

    ts := v.type

    ts.genere_declaration buffer
    buffer.add_last ' '
    ts.genere_star_declaration buffer
    (is_res).if {
      buffer.add_last '*'
    }
    buffer.append (v.intern_name)
  )

Profil, Lisaac

  - counter_function:Int
  - counter_recursivity_function:Int

Private

  - convert_tail_recursive <-
  ( + switch:Switch
    + msg_slot:Call_slot
    + body:List
    + loop:Loop
    + push:Push
    + new_code:List

    new_code := List.create (code.position)
    (debug_level_option != 0).if {
      push ?= code.first      
      new_code.add_last (push.my_copy)
      push.set_first False
    }

    loop := Loop.create position name name body code
    new_code.add_last loop

    // Extract Switch/body:
    switch ?= code.last
    (switch.list.lower).to (switch.list.upper) do { k:Int
      body := switch.list.at k.code
      (body.is_empty).if_false {
        msg_slot ?= body.last
        ((msg_slot != NULL) && {msg_slot.profil = self} && {msg_slot.cop_argument = NULL} && {! msg_slot.is_cop_sync}).if {
          link_count := link_count - 1
          msg_slot.argument_to_assignment body index (body.upper) alias False style '!'
          body.at (body.upper) put (Loop_end.create (msg_slot.position) loop loop)
        }
      }
    }
    count_intern_call := 1
    code := new_code
  )
