Header
  + name := Write_local
/*Write local*/
Inherit

  + parent_write:Flat Write

Public

  + local:Local

  - variable:Variable <- local

  //
  // Creation.
  //

  - create p:Position with val:Expr in l:Local :Self <-
  ( + result:Self
    ? {p.code != 0}
    result := clone
    result.make p with val in l
    result
  )

  - make p:Position with val:Expr in l:Local <-
  (
    position := p
    local    := l    
    value    := val
  )

  //
  // Execute.
  //

  - execute_access_unlink:Instr <- NULL

  - execute_access_link

  - execute_argument:Boolean <-
  // BSBS: Cette methode foireuse ne doit plus etre necessaire (utilise execute normal)
  ( + new_val:Instr
    + read:Read
    + result:Boolean

    ? { variable != NULL }
    ? { value    != NULL }

    read ?= value
    (ensure_count = 0).if {
      //
      // Supprime affectation.
      //      
      new_val := value.execute_unlink
      (new_val = NULL).if {
        result := True
      }.elseif {list_current.old_seq_or_and = seq_or_and} then {
        list_current.insert_before new_val
        result := True
      } else {
        value ?= new_val
      }
    } else {
      //
      // Execution normal.
      //
      execute_access_link
      value := value.execute_link
    }
    result
  )

  //
  // Genere
  //

  - genere <-
  ( + idf:String_alias
        
    idf := Aliaser_local.write self

    (quiet_generation).if_false {
      (local.is_result).if {
        output.add_last '*'
        output.append (local.intern_name)
      } else {
        output.append idf
      }
      //
      ((value.static_type.raw = Type_null) && {variable.type.raw.is_block}).if {
        output.append ".__id=0"
      } else {
        output.add_last '='
        genere_value
      }
    }
  )
  
  - genere_first_result <-
  ( + idf:String_alias

    idf := Aliaser_local.write self
    (local.is_result).if {
      output.add_last '*'
    }
    output.append idf
    //
    output.add_last '='
  )
  
  - genere_argument_result <-
  ( + idf:String_alias

    idf := Aliaser_local.write self
    output.add_last '&'
    output.append idf
  )





