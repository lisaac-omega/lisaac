Header
  + name := Cop_lock
/*COP in for data or function.*/
Inherit

  + parent_instr:Flat Instr

Public

  + data:Expr

  + is_static_read:Boolean
  // The read of a `-' parent slot (`Inherit', `Insert') of an active prototype, on the way to
  // a slot of the parent: resolved by the compiler, there is nothing to run in the universe
  // (see @execute).

  - set_static_read <-
  (
    is_static_read := True
  )

  //
  // Creation.
  //

  - create p:Position with dta:Expr :Self <-
  ( + result:Self

    result := clone
    result.make p with dta
    result
  )

  - make p:Position with dta:Expr <-
  (
    position := p
    data := dta
  )

  - my_copy:Self <-
  ( + result:Self
    result := create position with (data.my_copy)
    (is_static_read).if {
      result.set_static_read
    }
    result
  )

  - remove <-
  (
    data.remove
  )

  //
  // Execute.
  //

  - execute:Instr <-
  ( + unlock:Cop_unlock
    + result:Instr
    result := self
    (is_static_read).if {
      // An empty synchronous message for a parent slot resolved statically: removed with its
      // `Cop_unlock' (it waits for nothing the program needs).
      (list_current.index < list_current.upper).if {
        unlock ?= list_current.at (list_current.index + 1)
        (unlock != NULL).if {
          list_current.remove_index (list_current.index + 1)
          data.remove
          result := NULL
        }
      }
    }
    (result != NULL).if {
      // The base of the universe changes: no propagation of a `-' slot value across.
      seq_call_and_loop := seq_call_and_loop + 1
    }
    result
  )

  //
  // Generation.
  //
  
  - genere <-
  (
    output.append "// Synchronous message.\n"
    output.append indent
    output.append "{ lith_sync li_sync;\n"
    indent.append "  "
    output.append indent
    output.append "li_sync_begin(&li_sync,(lith_object *)("
    data.genere
    output.append "))"
  )

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.append "COP_LOCK("
    data.display buffer
    buffer.add_last ')'
  )

