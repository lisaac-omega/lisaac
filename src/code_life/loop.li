Header
  + name := Loop
/*Loop (call tail recursive).*/
Inherit

  + parent_instr:Flat Instr

Public

  + link_count:Int

  + body:List

  + name:String_alias

  - set_link <-
  (
    link_count := link_count + 1
  )

  - unset_link <-
  (
    link_count := link_count - 1
    ? {link_count >= 0}
  )

  //
  // Creation.
  //

  - create p:Position name lab:String_alias body lst:List :Self <-
  ( + result:Self
    result := clone
    result.make p name lab body lst
    result
  )

  - make p:Position name lab:String_alias body lst:List <-
  (
    position := p
    name := lab
    body := lst
  )

  - my_copy:Self <-
  ( + result:Self
    + new_body:List
    + switch:Switch
    + case:List
    + loop_end:Loop_end

    new_body := body.my_copy
    result :=  Exact Loop.create position name (get_intern name type False) body new_body
    //
    switch ?= new_body.last
    (switch.list.lower).to (switch.list.upper) do { k:Int
      case := switch.list.at k.code
      (! case.is_empty).if {
        loop_end ?= case.last
        (loop_end != NULL).if {
          ? {loop_end.loop = self}
          (loop_end.loop != self).if {
            semantic_error (position,"LOOP.my_copy BUG!!!")
          }
          loop_end := Loop_end.create (loop_end.position) loop result
          case.at (case.upper) put loop_end
        }
      }
    }

    (result.link_count != link_count).if {
      name.print
      " Origin:".print
      link_count.print
      " copy:".print
      result.link_count.print
      '\n'.print

      body.debug_display

      semantic_error (position,"LOOP: Bug in copy.")
    }

    ? {result.link_count = link_count}
    result
  )

  //
  // Generation.
  //

  - remove <-
  (
    body.remove
    ? {link_count = 0}
  )

  - execute:Instr <-
  ( + result:Instr
    + cur_seq_call_local_and_loop:Int
    + cur_seq_call_and_loop:Int

    (link_count = 0).if {
      result := body.execute
      new_execute_pass
    } else {
      cur_seq_call_local_and_loop :=
      seq_call_local_and_loop     := seq_call_local_and_loop + link_count
      //
      cur_seq_call_and_loop :=
      seq_call_and_loop     := seq_call_and_loop + link_count
      //
      seq_inline := seq_inline + 1
      //
      result := self
      body.execute_case
      (loop_invariant = self).if {
        loop_list := list_current
        loop_seq_index := Old seq_index
        //
        loop_seq_call_local_and_loop := cur_seq_call_local_and_loop
        loop_seq_call_and_loop       := cur_seq_call_and_loop
        //
        seq_call_local_and_loop := seq_call_local_and_loop + link_count
        seq_call_and_loop       := seq_call_and_loop + link_count
        body.execute_case
        loop_invariant := NULL
      }
    }
    result
  )

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.append name
    display_ref buffer
    buffer.append ":\n"
    buffer.append indent
    body.display buffer
  )

  //
  // Generation.
  //

  - genere <-
  (
    (! genere_while).if {

      current_list_level := current_list_level + link_count

      output.append name
      output.append ":\n"
      output.append indent
      body.genere
    }
  )
  
  - genere_while:Boolean <-
  ( + switch:Switch
    + lst_true,lst_false,lst:List
    + inverse:Boolean
    + result:Boolean

    (body.is_empty).if {
      semantic_error (position,"LOOP BUG: Body loop empty !")
    }
    switch ?= body.last
    (
      (switch != NULL) && {switch.list.count = 2} &&
      {switch.list.first.id = type_true } && {switch.list.second.id = type_false}
    ).if {
      lst_true  := switch.list.first.code
      lst_false := switch.list.second.code
      ((lst_true.is_empty) || {lst_false.is_empty}).if {
        (! lst_false.is_empty).if {
          inverse := True
          lst := lst_true
          lst_true := lst_false
          lst_false := lst
        }

        current_list_level := current_list_level + 1

        (body.count = 1).if {
          //
          // While (...) do {...}.
          //
          result := True
          inverse.if {
            output.append "while (!"
          } else {
            output.append "while ("
          }
          switch.expr.genere
          //
          output.append ") "
          lst_true.remove_last
          lst_true.genere
        }.elseif {lst_true.count = 1} then {
          //
          // Do {...} while (...).
          //
          result := True
          output.append "do "
          body.remove_last
          body.genere
          inverse.if {
            output.append " while (!"
          } else {
            output.append " while ("
          }
          //
          switch.expr.genere
          output.add_last ')'
        }

        current_list_level := current_list_level - 1

      }
    }
    result
  )
  

