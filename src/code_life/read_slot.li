Header
  + name := Read_slot
/* Read for slot */
Inherit

  + parent_read:Flat Read

Public

  - is_slot:Boolean <- True

  - is_invariant:Boolean <- slot.is_invariant receiver

  - is_pure:Boolean <- receiver.is_pure

  - is_reading v:Variable :Boolean <- receiver.is_reading v

  + slot:Slot_data

  + receiver:Expr

  - variable:Variable <- slot

  - get_last_value:Expr <- variable.get_last_value receiver

  - is_prefix_read:Boolean <-
  // @self reads the prefix parent (see @Type.prefix_slot) of a receiver reached by a pointer:
  // same address as the receiver.
  ( + rs:Read_slot
    + tf:Type_full
    + result:Boolean

    (slot = slot.receiver_type.prefix_slot).if {
      rs ?= receiver
      ((rs != NULL) && {rs.is_prefix_read}).if {
        result := True
      } else {
        tf := receiver.static_type
        result := (! tf.is_flat) || {(tf.is_flat_ref) && {! tf.is_default_flat}}
      }
    }
    result
  )

  - genere_prefix_pointer <-
  // Pointer of @self, with @is_prefix_read.
  ( + rs:Read_slot

    rs ?= receiver
    ((rs != NULL) && {rs.is_prefix_read}).if {
      rs.genere_prefix_pointer
    } else {
      receiver.genere
    }
  )

  //
  // Comparison.
  //

  - self:Self '~=' Right 60 other:Expr :Boolean <-
  ( + rd:Read_slot

    rd ?= other
    ((rd != NULL) && {slot = rd.slot} && {receiver ~= rd.receiver})
  )

Slot

  //
  // Creation.
  //

  - create p:Position with (r:Expr,s:Slot_data) :Self <-
  ( + result:Self

    result := clone
    result.make p with (r,s)
    result
  )

  - make p:Position with (r:Expr,s:Slot_data) <-
  (
    position := p
    receiver := r
    slot     := s
  )

Public

  - my_copy:Self <-
  ( + result:Self
    
    result ?= slot.read position with (receiver.my_copy)
    result
  )

  //
  // Executing pass.
  //

  - remove <-
  (
    receiver.remove
    parent_read.remove
  )

  - execute_access_unlink:Instr <-
  (
    slot.execute
    receiver.execute_unlink
  )

  - execute_access_link <-
  (
    slot.execute
    receiver := receiver.execute_link
  )

  //
  // Genere
  //

  - prefix_receiver:Read_slot <-
  ( + result:Read_slot
    result ?= receiver
    result
  )

  - is_prefix_receiver:Boolean <-
  // @receiver is a prefix parent: @slot is read with a cast to its type.
  (
    (slot.receiver_type.alias_slot = NULL) && {prefix_receiver != NULL} && {prefix_receiver.is_prefix_read}
  )

  - genere <-
  ( + tf,tf2:Type_full
    + t:Type
    + add_end:Boolean
    + ptr,ptr2:Boolean

    (slot.intern_name = "self").if {
      output.append "(("
      tf := slot.type
      tf.genere_declaration output
      output.add_last ' '
      tf.genere_star_declaration output
      output.add_last ')'
      receiver.genere
      output.append ".self)"
    }.elseif {is_prefix_receiver} then {
      // Through prefix parents: ((Parent *)receiver)->slot.
      output.append "(("
      t := slot.receiver_type
      t.put_reference_declaration output
      output.add_last ' '
      t.put_reference_star_declaration output
      output.add_last ')'
      prefix_receiver.genere_prefix_pointer
      output.append ")->"
      output.append (variable.intern_name)
    } else {      
      tf := receiver.static_type
      t  := slot.receiver_type
      (t.alias_slot != NULL).if {
        tf2 := slot.type
        ptr  := (! tf .is_flat) || {tf .is_flat_ref} //|| {tf .is_exact}
        ptr2 := (! tf2.is_flat) || {tf2.is_flat_ref} // || {tf2.is_exact}
        //output # "/*LA " # ptr # ptr2 # " */"
        (ptr != ptr2).if {
          add_end := True
          (ptr).if {
            output.append "(*("
          } else {
            output.append "(&("
          }
        }
      }
      (
        (tf.is_exact) || {tf.is_flat_ref} || {tf.is_flat}
      ).if {        
        receiver.genere
      } else {
        output.append "(("
        t.put_reference_declaration output
        output.add_last ' '
        t.put_reference_star_declaration output
        output.add_last ')'
        receiver.genere
        output.add_last ')'
      }
      (t.alias_slot = NULL).if {
        ((tf.is_flat) && /*14Mars*/ {(! tf.is_flat_ref) || {tf.is_default_flat}}).if {
          output.add_last '.'
        } else {
          output.append "->"
        }
        output.append (variable.intern_name)
      }.elseif {add_end} then {
        output.append "))"
      }
    }
  )
  
  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    receiver.display buffer
    buffer.append "->"
    parent_read.display buffer
  )

