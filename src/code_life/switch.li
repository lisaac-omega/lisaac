Header
  + name := Switch
/* Switch for late binding resolution 

   BSBS: Optim. : Détecter les switch identique l'un après l'autre
   pour les fusionner...
  */
Inherit

  + parent_instr:Flat Instr

Public
  
//  + count_my_switch_merge:Int
  
  - is_invariant:Boolean <-
  ( + result:Boolean
    + j:Int

    (expr.is_invariant).if {
      result := True
      j := list.lower
      {(j <= list.upper) && {result}}.while_do {
        result := list.at j.code.is_invariant
        j := j + 1
      }
    }
    result
  )

  + expr:Expr

  + list:Array Case

  - count:Int <- list.count

  - has_block:Boolean <-
  ( + j:Int
    + result:Boolean

    j := list.lower
    {(j <= list.upper) && {! result}}.while_do {
      result := list.at j.code.has_block
      j := j + 1
    }
    result
  )

  - first_access v:Local :Int <-
  // @list has a case for each possible type of @expr.
  ( + result,j:Int

    ((list.is_empty) || {expr.is_reading v}).if {
      result := 2
    } else {
      result := list.first.code.first_access v
      j := list.lower + 1
      {(j <= list.upper) && {result != 2}}.while_do {
        (list.at j.code.first_access v != result).if {
          result := 2
        }
        j := j + 1
      }
    }
    result
  )

  //
  // Creation.
  //

  - create n:Node with e:Expr size s:Int :Self <-
  [ -? {n.position != 0}; ]
  ( + result:Self

    result := clone
    result.make n with e size s
    result
  )

  - make n:Node with e:Expr size s:Int <-
  ( + first:Case

    position := n.position
    expr     := e
    list     := Array Case .create_with_capacity s
    (n.first_code != NULL).if {
      first := Case.create (n.first_type) with (n.first_code)
      list.add_last first
    }
  )

  //
  // Copy.
  //

  - set_expr e:Expr list l:Array Case <-
  (
    expr := e
    list := l
  )

  - my_copy:Self <-
  ( + result:Self
    + new_list:Array Case

    new_list := Array Case .create_with_capacity (list.count)
    (list.lower).to (list.upper) do { j:Int
      new_list.add_last (list.at j.my_copy)
    }

    result := clone
    result.set_expr (expr.my_copy) list new_list
    result
  )

  //
  // Remove.
  //

  - remove <-
  (
    (expr != NULL).if {
      expr.remove
    }
    (list.lower).to (list.upper) do { j:Int
      list.at j.remove
    }
  )

  //
  // Execute
  //

  - i_am_the_last i:Instr :Boolean <-
  ( + result:Boolean
    + j:Int

    j := list.lower
    {(j <= list.upper) && {!result}}.while_do {
      result := list.at j.code.i_am_the_last i
      j := j + 1
    }
    result
  )

  - execute:Instr <-
  ( + lst_typ:Types_tmp
    + result:Instr
    + typ:Type
    + wrt:Write
    + lst:List
    + tb:Profil_block
    + is_end:Boolean
    + count_empty,idx,idx2:Int

                      // Rappel toi du step=0 ds cortex

    // Jump threading before the execution of the cases: the moved code is executed
    // in this pass (else its profiles are not alive, see @Profil_list.set_life).
    ((merge_next_copy) || {thread_next}).if {
      new_execute_pass
    }

    // Update.
    lst_typ := Types_tmp.new
    // BSBS: optim a voir si necessaire ...
      expr.get_type lst_typ
    ? {lst_typ.count <= list.count}
    (lst_typ.count > list.count).if {
      "New type: ".print
      lst_typ.print_all
      "\nOld type: ".print
      string_tmp.clear
      list.lower.to (list.upper) do { j:Int
        list.at j.id.append_name_in string_tmp
        string_tmp.add_last ','
      }
      string_tmp.print
      '\n'.print
      syntax_error (expr.position,"*****SWITCH BUG********")
    }

    //
    // BSBS: Ajoute un pattern pour les elseif ...
    //
    idx := lst_typ.first_index
    idx2 := 0
    {idx != -1}.while_do {
      typ := lst_typ.at idx
      {typ = list.at idx2.id}.until_do {
        list.at idx2.remove
        list.remove idx2
      }
      (list.at idx2.code.is_empty).if {
        count_empty := count_empty + 1
      }
      idx := lst_typ.next_index idx
      idx2 := idx2 + 1
    }
    {lst_typ.count = list.count}.until_do {
      list.last.remove
      list.remove_last
    }
    lst_typ.free

    // Execute.
    (
      (list.count = 1) || {
        (list.count = 2) && {debug_level_option = 0} &&
        {list.first.id = Type_null} && {! list.first.code.is_empty} &&
        {
          wrt ?= list.first.code.first; // For ?= with NULL type.
          wrt = NULL
        }
      }
    ).if {
      result := expr.execute_unlink
      (result != NULL).if {
        list_current.insert_before result
      }
      tb ?= list.last.id
      (tb != NULL).if {
        tb.dec_id
      }
      result := list.last.code.execute
      is_end := True
    }.elseif {count_empty = list.count} then {
      result := expr.execute_unlink
      (list.lower).to (list.upper) do { j:Int
        list.at j.remove
      }
      is_end := True
    }
    //
    (! is_end).if {
      // Normal execution.
      (
        (expr.static_type.raw = type_boolean) &&
        {list.count = 2} && {list.first.code.is_empty}
      ).if {
        ? {! list.second.code.is_empty}
        expr := Expr_not_logic.create (expr.position) with expr
        lst := list.first.code
        list.first .set_code (list.second.code)
        list.second.set_code lst
      }
      expr := expr.execute_link

      Call_slot.reset_count_no_recursive
      Escape.branch_begin
      cond_depth := cond_depth + 1
      ((list.first.id = Type_null) && {list.count = 2}).if {
        Escape.branch_case
        list.first .code.execute_case
        Escape.branch_case_end
        Escape.branch_case
        list.second.code.execute_case
        Escape.branch_case_end
        ((list.second.id.is_block) && {debug_level_option != 0}).if {
          list.second.id.set_late_binding
        }
      } else {
        (list.lower).to (list.upper) do { j:Int
          Escape.branch_case
          list.at j.execute
          Escape.branch_case_end
        }
      }
      Escape.branch_end
      cond_depth := cond_depth - 1
      result := detect_logic_expr
      (result = NULL).if {
        result := self
      }
    }

    result
  )

  //
  // Jump threading (`elseif' chains).
  //

  - leaves:Array List := Array List .create_with_capacity 16

  - collect_leaves v:Local :Boolean <-
  // Each path of @self ends with a write of a constant in @v, a @Boolean (in a nested @Switch too):
  // the lists of these writes are added to @leaves.
  ( + j:Int
    + result:Boolean

    result := True
    j := list.lower
    {(j <= list.upper) && {result}}.while_do {
      result := collect_leaf (list.at j.code) of v
      j := j + 1
    }
    result
  )

  - collect_leaf l:List of v:Local :Boolean <-
  ( + wrt:Write_local
    + sw:Switch
    + result:Boolean

    (! l.is_empty).if {
      wrt ?= l.last
      sw  ?= l.last
      ((wrt != NULL) && {wrt.local = v} && {wrt.value.is_constant}).if {
        leaves.add_last l
        result := True
      }.elseif {sw != NULL} then {
        result := sw.collect_leaves v
      }
    }
    result
  )

  - next_instr:Instr <-
  // Instruction after @self in @list_current (NULL if none).
  ( + idx:Int
    + result:Instr

    idx := list_current.index
    ((idx >= list_current.lower) && {idx < list_current.upper} && {list_current.at idx = self}).if {
      result := list_current.at (idx + 1)
    }
    result
  )

  - merge_next_copy:Boolean <-
  // [@self; v := u], each path of @self ending with u := constant, and u is only read here:
  // the constants are written in v and v := u is removed.
  ( + wr,w:Write_local
    + rd:Read_local
    + u,v:Local
    + result:Boolean

    wr ?= next_instr
    (wr != NULL).if {
      rd ?= wr.value
      (rd != NULL).if {
        u := rd.local
        v := wr.local
        ((u != v) && {u.type = v.type} && {u.type.raw = type_boolean} && {u.ensure_count = 1} && {! u.is_result}).if {
          leaves.clear
          ((collect_leaves u) && {leaves.count = u.require_count}).if {
            (leaves.lower).to (leaves.upper) do { j:Int
              w ?= leaves.at j.last
              leaves.at j.at (leaves.at j.upper) put (v.write (w.position) value (w.value))
              u.unwrite w
            }
            wr.remove
            list_current.remove_index (list_current.index + 1)
            result := True
          }
        }
      }
    }
    result
  )

  - thread_next:Boolean <-
  // [@self; switch v ...], each path of @self ending with v := constant:
  // the case of the next switch for this constant is moved at the end of the path.
  ( + nxt:Switch
    + rd:Read_local
    + w:Write_local
    + t:Type
    + uses:Array Int
    + k,j:Int
    + code:List
    + not:Expr_not_logic
    + wc:Write_local
    + result:Boolean

    nxt ?= next_instr
    ((nxt != NULL) && {nxt.expr.is_pure}).if {
      rd  ?= nxt.expr
      not ?= nxt.expr
      ((rd = NULL) && {not != NULL}).if {
        // switch !v: True and False are swapped.
        rd ?= not.right
      }
      ((rd != NULL) && {rd.local.type.raw = type_boolean}).if {
        leaves.clear
        // A block not yet inlined is not moved (its context, see @Profil_block).
        ((collect_leaves (rd.local)) && {! nxt.has_block}).if {
          // Case of @nxt for each leaf, and number of uses of each case.
          result := True
          uses := Array Int .create (nxt.list.count)
          leaf_case.clear
          j := leaves.lower
          {(j <= leaves.upper) && {result}}.while_do {
            w ?= leaves.at j.last
            t := w.value.static_type.raw
            (not != NULL).if {
              (t = type_true).if {
                t := type_false
              }.elseif {t = type_false} then {
                t := type_true
              } else {
                t := NULL
              }
            }
            k := nxt.list.lower
            {(k <= nxt.list.upper) && {nxt.list.at k.id != t}}.while_do {
              k := k + 1
            }
            (k > nxt.list.upper).if {
              result := False
            } else {
              leaf_case.add_last k
              uses.at k put (uses.at k + 1)
            }
            j := j + 1
          }
          // A case copied in several paths must be empty or a write of a constant (as v := True).
          k := nxt.list.lower
          {(k <= nxt.list.upper) && {result}}.while_do {
            (uses.at k > 1).if {
              code := nxt.list.at k.code
              wc ?= code.first_or_null
              result := (code.is_empty) || {(code.count = 1) && {wc != NULL} && {wc.value.is_constant}}
            }
            k := k + 1
          }
          (result).if {
            (leaves.lower).to (leaves.upper) do { i:Int
              k := leaf_case.at i
              code := nxt.list.at k.code
              (uses.at k > 1).if {
                code := code.my_copy
                uses.at k put (uses.at k - 1)
              } else {
                uses.at k put (-1); // Moved.
              }
              (! code.is_empty).if {
                leaves.at i.add_last code
              }
            }
            (nxt.list.lower).to (nxt.list.upper) do { i:Int
              (uses.at i = 0).if {
                nxt.list.at i.code.remove
              }
            }
            nxt.expr.remove
            list_current.remove_index (list_current.index + 1)
          }
        }
      }
    }
    result
  )

  - leaf_case:Array Int := Array Int .create_with_capacity 16

  //
  // Genere.
  //

  - genere <-
  ( + lst:List
    + first_case:Int
    + typ_first:Type
    + typ_id:Type_id
    + wrt:Write
    + is_genered:Boolean
    + c1,c2:Case
    + lst_case:Array Case
    + cases:Array (Array Case)
    + switch_beg,same_base,idx_end:Int
    + is_same:Boolean
    + sw:Switch

    Type.add_switch_global self
    (list.lower).to (list.upper) do { j:Int
      list.at j.id.add_switch_list self
    }

    count_switch := count_switch + 1
    (
      (list.first.id = Type_null)  &&
      {debug_level_option = 0}     &&
      {! list.first.code.is_empty} && {
        wrt ?= list.first.code.first; // For ?= with NULL type.
        wrt = NULL
      }
    ).if {
      list.remove_first
    }
    typ_first := list.first.id
    typ_id ?= typ_first
    ((list.count <= 2) || {typ_first = Type_null}).if {
      output.append "if "
      par {
        //
        ((expr.static_type.raw.is_block) && {typ_first = Type_null}).if {
          expr.genere
          is_genered := True
          output.append ".__id==0"
        } else {
          typ_first.put_access_id expr
          is_genered := True
          (expr.static_type.raw != type_boolean).if {
            output.append "=="
            typ_first.put_id output
          } else {
            ? {typ_first.name = str_true}
          }
        }
      }
      output.append " "; // ") "
      //
      list.first.genere
      first_case := 1
      //
      (list.count = 2).if {
        lst := list.second.code
        sw  ?= lst.first_or_null
        ((lst.count = 1) && {sw != NULL}).if {
          // else if
          output.append " else "
          sw.genere
        }.elseif {! lst.is_empty} then {
          output.append " else "
          output.append "/* "
          output.append (list.second.id.name)
          output.append " */ "
          list.second.genere
        }
        first_case := 2
      }.elseif {list.count > 2} then {
        output.append " else {\n"
        indent.append "  "
        output.append indent
      }
    }
    (first_case <= list.upper).if {
      (is_genered).if {
        expr := expr.my_copy
      }
      cases := case_fusion first_case
      (cases.count = 2).if {
        (cases.first.count = 1).if {
          c1 := cases.first.first
          c2 := cases.second.first
        }.elseif {cases.second.count = 1} then {
          c1 := cases.second.first
          c2 := cases.first.first
        }
      }
      (c1 != NULL).if {
        output.append "if "
        par {
          c1.id.put_access_id expr
          output.append "=="
          c1.id.put_id output
        }
        output.append " "
        c1.genere
        output.append " else /* Other types */ "
        c2.genere
      } else {
        polymorphic_counter := polymorphic_counter + 1
        switch_beg := output.upper
        is_same := expr.is_pure
        same_base := same_beg.count
        output.append "switch "
        par {
          list.at first_case.id.put_access_id expr
        }
        output.append " {\n"
        (cases.lower).to (cases.upper) do { j:Int
          lst_case := cases.at j
          (! lst_case.first.code.is_empty).if {
            (j = cases.upper).if {
              output.append indent
              output.append "default: "
            } else {
              (lst_case.lower).to (lst_case.upper) do { i:Int
                output.append indent
                output.append "case "
                lst_case.at i.id.put_id output
                output.append ": \n"
              }
              output.remove_last
            }
            same_beg.add_last (output.upper)
            // Its end is reserved now: a switch nested in this case pushes its own pairs after.
            same_end.add_last (output.upper)
            idx_end := same_end.upper
            lst_case.first.genere
            same_end.at idx_end put (output.upper)
            output.append " break;\n"
          } else { // Debug...
            is_same := False
            (lst_case.lower).to (lst_case.upper) do { i:Int
              output.append indent
              output.append "case "
              lst_case.at i.id.put_id output
              output.append ": \n"
            }
            output.remove_last
            output.append " break;\n"
          }
        }
        // Debug...
        //  output.append indent
        //  output.append "default:\n"
        //  output.append indent
        //  output.append "lisaac_stack_print(0); \
        //  \print_string(\"Call on twilight zone!!!\\n\"); \
        //  \die_with_code(1);\n"

        output.append indent
        output.add_last '}'
        (is_same).if {
          keep_same_code switch_beg from same_base
        }
        // Nested switch: positions are a stack.
        {same_beg.count = same_base}.until_do {
          same_beg.remove_last
          same_end.remove_last
        }
      }
      free_list_cases cases
      (first_case != 0).if {
        output.add_last '\n'
        indent.remove_tail 2
        output.append indent
        output.add_last '}'
      }
    }
  )

  //
  // Display.
  //

  - display buffer:String_buffer <-
  ( + line:{Int; }

    line :=
    { j:Int
      + i:List
      buffer.append indent
      buffer.at (buffer.upper-1) put '+'
      buffer.at (buffer.upper)   put '-'
      buffer.append (list.at j.id.intern_name)
      buffer.append ":\n"
      buffer.append indent
      i := list.at j.code
      (i = NULL).if {
        buffer.append "<Empty>"
      } else {
        i.display buffer
      }
    }

    buffer.append "Switch "
    expr.display buffer
    buffer.add_last '\n'
    (list.count > 0).if {
      indent.append "| "
      0.to (list.upper - 1) do { j:Int
        line.value j
        buffer.add_last '\n'
      }
      indent.at (indent.upper-1) put ' '
      line.value (list.upper)
      indent.remove_tail 2
    }
  )

  - switch_new_pass:Boolean
  - reset_switch_new_pass <-
  (
    switch_new_pass := False
  )

Private

  - detect_logic_expr:Instr <-
  // Detection !, |, &, ||, && :
  ( + result:Instr
    + wr_true,wr_false:Write
    + rd:Read
    + rd_slot:Read_slot
    + val_true,val_false:Expr
    + a,b,c,d:Boolean

    (
      (expr.static_type.raw = type_boolean) && {list.count = 2} &&
      {list.first.code.count  = 1} && {list.second.code.count = 1}
    ).if {
      ((list.first.id != type_true) || {list.second.id != type_false}).if {
        list.first.id.intern_name.print;  ' '.print;
        list.second.id.intern_name.print; '\n'.print;
        syntax_error (position,"PB dans SWITCH.")
      }
      ? {list.first.id  = type_true }
      ? {list.second.id = type_false}

      wr_true  ?= list.first .code.first
      wr_false ?= list.second.code.first
      (
        (wr_true  != NULL) && {wr_false != NULL} &&
        {wr_true.static_type.raw = type_boolean} &&
        {wr_true.variable = wr_false.variable}
      ).if {
        val_true  := wr_true .value
        val_false := wr_false.value
        // BSBS: val_true.static_type = type_true ???
        (
          (a := val_true.is_constant) && {b := (val_true.static_type.raw = type_true)}
        ).if {
          // | or ||
          // A @Read_slot dereferences its receiver (unless @Flat), possibly @NULL when @expr is @True:
          // only the lazy || is safe.
          rd ?= val_false
          rd_slot ?= val_false
          ((rd != NULL) && {(rd_slot = NULL) || {rd_slot.receiver.static_type.is_flat}}).if {
            // |
            wr_true.remove
            val_false := Expr_or_logic.create position with expr and val_false
            wr_false.set_value val_false
            result := wr_false
            new_execute_pass
          }.elseif {(Call_slot.count_no_recursive = 0) || {modify_count = 0}} then {
            // ||
            wr_true.remove
            val_false := Expr_or_or_logic.create position with expr and val_false
            wr_false.set_value val_false
            result := wr_false
            switch_new_pass := True
          }
        }.elseif {
          (c := val_false.is_constant) && {d := (val_false.static_type.raw = type_false)}
        } then {
          // & or &&
          // A @Read_slot dereferences its receiver (unless @Flat), possibly @NULL when @expr is @False:
          // only the lazy && is safe.
          rd ?= val_true
          rd_slot ?= val_true
          ((rd != NULL) && {(rd_slot = NULL) || {rd_slot.receiver.static_type.is_flat}}).if {
            // &
            wr_false.remove
            val_true := Expr_and_logic.create position with expr and val_true
            wr_true.set_value val_true
            result := wr_true
            new_execute_pass
          }.elseif {(Call_slot.count_no_recursive = 0) || {modify_count = 0}} then {
            // &&
            wr_false.remove
            val_true := Expr_and_and_logic.create position with expr and val_true
            wr_true.set_value val_true
            result := wr_true
            switch_new_pass := True
          }
        }.elseif {
          (a) && {!b} && {c} && {!d}
        } then {
          // !
          wr_false.remove
          wr_true.set_value (Expr_not_logic.create position with expr)
          result := wr_true
          new_execute_pass
        }
      }
    }
    result
  )

  //
  // Case fusion manager.
  //

  - same_code:String_buffer := String_buffer.create 256

  - same_beg:Array Int := Array Int .create_with_capacity 16

  - same_end:Array Int := Array Int .create_with_capacity 16

  - keep_same_code beg:Int from base:Int <-
  // When each case of the switch generated (from @beg) has the same C code (same slot
  // at the same offset, see @Type.prefix_slot), the dispatch is replaced by this code.
  ( + is_same:Boolean
    + j,k,b,len:Int

    b   := same_beg.at base
    len := same_end.at base - b
    is_same := same_beg.count - base > 1
    j := base + 1
    {(j <= same_beg.upper) && {is_same}}.while_do {
      (same_end.at j - same_beg.at j != len).if {
        is_same := False
      } else {
        k := 1
        {(k <= len) && {is_same}}.while_do {
          is_same := output.at (b + k) = output.at (same_beg.at j + k)
          k := k + 1
        }
      }
      j := j + 1
    }
    (is_same).if {
      same_code.clear
      (b + 1).to (b + len) do { i:Int
        same_code.add_last (output.at i)
      }
      output.remove_tail (output.upper - beg)
      output.append same_code
    }
  )

  - store_list_cases:Array (Array (Array Case)) :=
  Array (Array (Array Case)).create_with_capacity 32

  - store_cases:Array (Array Case) :=
  Array (Array Case).create_with_capacity 32

  - new_cases:Array Case <-
  ( + result:Array Case
    (store_cases.is_empty).if {
      result := Array Case .create_with_capacity 32
    } else {
      result := store_cases.last
      store_cases.remove_last
    }
    result
  )

  - new_list_cases:Array(Array Case) <-
  ( + result:Array(Array Case)
    (store_list_cases.is_empty).if {
      result := Array(Array Case).create_with_capacity 32
    } else {
      result := store_list_cases.last
      store_list_cases.remove_last
    }
    result
  )

  - free_list_cases l:Array(Array Case) <-
  ( + lst:Array Case
    (l.lower).to (l.upper) do { i:Int
      lst := l.at i
      lst.clear
      store_cases.add_last lst
    }
    l.clear
    store_list_cases.add_last l
  )

  - case_fusion low:Int :Array(Array Case) <-
  ( + c1,c2:Case
    + lst:Array Case
    + j:Int
    + result:Array (Array Case)

    result := new_list_cases
    (low).to (list.upper) do { i:Int
      c1 := list.at i
      lst := NULL
      j := result.lower
      {(j <= result.upper) && {lst = NULL}}.while_do {
        c2 := result.at j.first
        (c1 ~= c2).if {
          lst := result.at j
          c1.code.remove
        }
        j := j + 1
      }
      (lst = NULL).if {
        lst := new_cases
        result.add_last lst
      }
      lst.add_last c1
    }
    result
  )
  
  // Parenthese manager
  
  - par b:{} <-
  ( + pos:Int
    output.add_last '('
    pos := output.upper
    b.value
    ((output.at (pos+1) = '(') && {output.last = ')'}).if {
      output.remove pos
    } else {
      output.add_last ')'
    }
  )
