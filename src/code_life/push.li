Header
  + name := Push
/*Push context for debug mode*/
Inherit

  + parent_instr:Flat Instr

Push,Lisaac

  - source_line:Array Position :=
  Array Position .create_with_capacity 32_000
  
  - my_clone:Self <- clone
  
Public
    
  + context:Local

  + is_first:Boolean
  
  + is_rm:Boolean
  - set_rm <- ( is_rm := True )

  - set_first f:Boolean <-
  (
    is_first := f
  )

  //
  // Creation.
  //

  - create pos:Position context v:Local first f:Boolean :Push <-
  ( + result:Push
        
    (is_speed_push).if {
      result := Push_speed.my_clone
    } else {
      result := Push_standard.my_clone
    }
    result.make pos context v first f
    result
  )

  - make pos:Position context v:Local first f:Boolean <-
  [
    ? {pos.code != 0}
    ? {v != NULL}
  ]
  (   
    position := pos
    context := v
    is_first := f
  )

  - my_copy:Self <-
  ( + result:Self
    + new_context:Local
    
    result := clone
    (Local.is_alias).if {
      new_context := context.get_alias
      new_context.set_ensure_count 1
      result.make position context new_context first is_first
    } else {
      result.make position context context first is_first
    }
    result
  )

  //
  // Execute.
  //

  - remove <-
  (
    // Nothing.
  )
  
  - stair:Flat Array Push
  
  - break <-
  (
    stair.clear
  )
  
  - end_function <-
  (
    {! stair.is_empty}.while_do { stair.pop.set_rm }
  )
  
  
  - execute:Instr <-
  ( + result:Instr
    + p:Push
    + i:Int
    (pass_count <= 1).if {
      result := self
    } else {
      (! is_rm).if {
        (! is_first).if {
          {(i <= stair.upper) && {stair.at i.context != context}}.while_do { i := i + 1 }
          ((i <= stair.upper) && {(p := stair.at i).is_first}).if {
            {stair.upper != i}.while_do { stair.pop.set_rm }
          }
        } else {
          p ?= list_current.next_item
          ((p != NULL) && {p.context = context}).if {
            position := p.position
            p.set_rm
          }
        }
        stair.add_last self
        result := self
      }
    }
    result
  )
  
  
  /*
  - execute:INSTR <-
  ( + result:INSTR
    + other:PUSH

    result := self
    other ?= list_current.next_item
    (other != NULL).if {
      (other.context = context).if {
        result := NULL
        (is_first).if {
          other.set_first True
        }
      }.elseif {(is_first) && {! other.is_first}} then {
        result := NULL
      }
    }
    result
  )
  */
  
  //
  // Genere
  //

  - genere <-
  ( 
    abstract
  )
    
  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.append "push("
    buffer.append (context.intern_name)
    buffer.add_last ')'
  )






