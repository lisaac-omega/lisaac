Header
  + name := Write
/*Write local, global or slot*/
Inherit

  + parent_instr:Flat Instr

Public

  //
  // Debug !!!!
  //

  + is_delete:Boolean

  + is_create:Boolean

  - set_delete <-
  (
    is_delete := True
  )

  - set_create <-
  (
    is_create := True
  )

  //
  // Fin debug !!!!
  //

  + quiet_generation:Boolean

  - set_quiet_generation <-
  (
    quiet_generation := True
  )

  - is_invariant:Boolean <- value.is_invariant

  - variable:Variable <-
  (
    abstract
    NULL
  )

  - static_type:Type_full <-
  (
    variable.type
  )

  + value:Expr

  - set_value new:Expr <-
  (
    value := new
  )

  - ensure_count:Int <- variable.ensure_count

  - get_type t:Types_tmp <-
  (
    (value != NULL).if {
      value.get_type t
    }
  )

  - my_copy:Self <-
  ( + new_val:Expr
    + result:Self

    new_val := value.my_copy
    result ?= variable.write position value new_val
    result
  )

  //
  // Execute.
  //

  - execute_access_unlink:Instr <-
  (
    abstract
    NULL
  )

  - execute_access_link <- abstract

  - execute:Instr <-
  ( + result:Instr
    + read:Read
    + val:Instr
    + slot:Slot_data
    + rd_loc:Read_local

    ? { variable != NULL }
    ? { value    != NULL }

    simplify_type variable
    //debug_display
    
    slot ?= variable
    rd_loc ?= value
    (
      ( // First case : No link.
        (ensure_count = 0) && 
        {(rd_loc = NULL) || {rd_loc.variable.style != 'R'}} && 
        {(slot = NULL)   || {! slot.id_section.is_mapping}}
      ) || { // Second case : a := a
        read ?= value
        (read != NULL) && {variable = read.variable} &&
        {(variable.is_local) || {variable.style = '-'}}        // BSBS: Ce cas dans rentrer dans set_write
      } || {
        (rd_loc != NULL) && {rd_loc.local.require_count = 0} && {rd_loc.local.ensure_count = 1} && {!variable.type.raw.is_block} && {
          /*
            "WRITE :".print
            variable.intern_name.print; " := ".print
            variable.type.print
            (variable.type.raw != NULL).if {
              variable.type.raw.is_block.print
            }
            variable.style.print
            rd_loc.local.intern_name.println
          */
          True
        }
      }          
    ).if {
      //
      // Supprime affectation.
      //      
      val := execute_access_unlink
      (val != NULL).if {
        list_current.insert_before val
      }
      variable.unwrite self
      result := value.execute_unlink
      new_execute_pass
    } else {
      //
      // Execution normal.
      //
      /*( // BSBS: Bug, mais de toute facon le gain n'est pas la... (entre +5 a +20)
      (loop_invariant != NULL) && {list_current = loop_invariant.body} &&
      {is_invariant} && {variable.get_last_index != -1}
      ).if {
      //old_loop_invariant := loop_invariant
      //loop_invariant := NULL
      //
      variable.reset_last_write self
      loop_list.insert_before self
      //
      //execute_access_link
      //value := value.execute_link
      //seq_index := seq_index + 1
      //
      //loop_invariant := old_loop_invariant
      result := NOP
      count_invariant := count_invariant + 1
      } else { */

        execute_access_link
        value := value.execute_link
        seq_index := seq_index + 1
        variable.set_write self
        result := self
      //}
    }
    result
  )

  - remove <-
  ( + l:Local
    l ?= variable
    ((l != NULL) && {l.my_alias != NULL}).if {
      // It's for generation code, with ALIAS_LOCAL and SWITCH fusion case.
      l.my_alias.unwrite self
    } else {
      variable.unwrite self
    }
    value.remove
  )

  // Genere
  
  - genere_value <-
  (
    (
      (static_type.is_flat_ref && {! static_type.is_default_flat} /*14Mars*/) && {! value.static_type.is_flat_ref}
    ).if {
      ? {value.static_type.is_flat}
      output.append "&("
      value.genere
      output.add_last ')'
    }.elseif {
      (static_type.is_flat) && {! static_type.is_flat_ref} &&
      {(! value.static_type.is_flat) || {value.static_type.is_flat_ref}} && 
      {! value.static_type.is_default_flat} && 
      {value.static_type.raw != Type_null} // For Pointer := NULL
    } then {
      output.append "*("
      value.genere
      output.add_last ')'
    } else {      
      ((variable.type.is_exact) && {! value.static_type.is_exact}).if {
        output.add_last '('
        variable.type.genere_declaration output
        output.add_last ' '
        variable.type.genere_star_declaration output
        output.add_last ')'
      }
      value.genere
    }
  )
  
  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    //crash
    buffer.append (variable.intern_name)

    buffer.add_last '['
    variable.type.append_name_in buffer
    buffer.add_last ']'

    buffer.append " :="
    //to_pointer.append_in buffer
    display_ref buffer
    buffer.add_last ' '

    (value = NULL).if {
      buffer.append "<NULL>"
    } else {
      value.display buffer
    }
  )

  - display_ref buffer:String_buffer <-
  (
    is_verbose.if {
      buffer.add_last '<'
      object_id.append_in buffer; // buffer.append (object_id.to_string_buffer)
      buffer.append "/E"
      ensure_count.append_in buffer
      buffer.add_last '>'
    }
  )

