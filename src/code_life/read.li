Header
  + name := Read
/* Read for local, global or slot */
Inherit

  + parent_expr:Flat Expr

Public

  - is_slot:Boolean <- False

  - variable:Variable <-
  (
    abstract
    NULL
  )

  - static_type:Type_full <-
  (
    variable.type
  )
  
  - ensure_count:Int <- variable.ensure_count

  - my_copy:Self <-
  ( + result:Self
    result ?= variable.read position
    result
  )

  //
  // Searching.
  //

  - get_type t:Types_tmp <-
  (
    variable.get_type t
  )

  - get_last_value:Expr <- variable.get_last_value NULL

  //
  // Executing pass.
  //

  - remove <-
  (
    variable.unread self
  )

  - is_require_constant:Constant <-
  ( + result:Constant
    + j:Int
    + val:Expr
    + req_list:Array Write
    //? { variable.require_first != NULL }
    /* BSBS: A REVOIR
    ((variable.require_first = NULL) && {!variable.type.is_flat}).if {
      variable.intern_name.print; '\n'.print
      "style [".print; variable.style.print; "]\n".print
      warning_error (position,"READ : Compiler BUG! (require_first = NULL) ")
      //list_current.debug_display
      //die_with_code 0
      //crash_with_message "BUG READ : require_first = NULL"
    }
    */
    (variable.require_first != NULL).if {
      val := variable.require_first.value
      (val.is_constant).if {
        result   ?= val
        req_list := variable.require_list
        (req_list != NULL).if {
          j := req_list.lower
          {(j > req_list.upper) || {result = NULL}}.until_do {
            val := req_list.at j.value
            ((! val.is_constant) || {result !~= val}).if {
              result := NULL
            }
            j := j + 1
          }
        }
      }
    }
    result
  )

  - execute_access_unlink:Instr <-
  (
    abstract
    NULL
  )

  - execute_access_link <- abstract

  - execute_unlink:Instr <-
  // Delete read
  (
    variable.unread self
    new_execute_pass
    execute_access_unlink
  )

  - execute_link:Expr <-
  ( + cst:Constant
    + rec:Instr
    + result:Expr
    + val:Expr
    + s:Slot_data
    + l:Local
    + wrt:Write
    //+ old_loop_invariant:LOOP

    simplify_type variable
    
    //
    s ?= variable    
    (
      (s = NULL) || {
        ((s.style != '+') || {! s.id_section.is_mapping}) &&
        {(! variable.type.is_flat) || {variable.type.is_default_flat}}
      }
    ).if {
      cst := is_require_constant;  // BSBS: Ce cas devrait rentrer dans get_last_value
      ((cst != NULL) && {variable.style != 'R'} && {! variable.type.is_flat_without_default}).if { 
        /*variable.type.prototype.is_complex_flat.if {
          Out # variable.intern_name # " " # variable.type.prototype.name # " Constant propa\n"
        };*/
        //
        // CONSTANT propagation.
        //
        variable.unread self
        rec := execute_access_unlink
        (rec != NULL).if {
          list_current.insert_before rec
        }
        result := cst.my_copy
        new_execute_pass
      }.elseif {
        ((val := get_last_value) != NULL) && {(! variable.type.is_flat_without_default) || {! val.is_constant}}
      } then {
        /*variable.type.prototype.is_complex_flat.if {
          Out # variable.intern_name # " " # variable.type.prototype.name # " Step by step propa\n"
        };*/
        //
        // VALUE_EXPR propagation, step by step.
        //
        result := val
        variable.unread self
        new_execute_pass
      }
    }/*
    }*/
    (result = NULL).if {
      //
      // Normal.
      //
      ((is_slot) && {loop_invariant != NULL} && {is_invariant}).if {
        //old_loop_invariant := loop_invariant
        //loop_invariant := NULL
        //
        l := static_type.get_temporary position
        wrt := l.write position value self
        loop_list.insert_before wrt
        result := l.read position
        //
        //wrt.execute
        //result := result.execute_link
        //
        //loop_invariant := old_loop_invariant
        count_invariant := count_invariant + 1
      } else {
        
        variable.set_read
        execute_access_link
        result := self
      }
    }
    l ?= variable
    ((l != NULL) && {l.type.raw.dynamic_type = Profil_block}).if {
      count_block_sensitive := count_block_sensitive + 1
    }
    result
  )

  // Display.

  - display_ref buffer:String_buffer <-
  ( + req_list:Array Write
    //is_verbose.if {
      buffer.add_last '<'
      //buffer.append (object_id.to_string_buffer)
      buffer.add_last 'R'
      (variable.require_first != NULL).if {
        variable.require_first.object_id.append_in buffer
        req_list := variable.require_list
        (req_list != NULL).if {
          (req_list.lower).to (req_list.upper) do { j:Int
            buffer.add_last ','
            req_list.at j.object_id.append_in buffer
          }
        }
      } else {
        buffer.add_last '*'
      }
      buffer.append "/E"
      variable.ensure_count.append_in buffer
      buffer.add_last '>'
    //}
  )

  - display buffer:String_buffer <-
  (
    buffer.append (variable.intern_name)
    buffer.add_last '['
    variable.type.append_name_in buffer
    buffer.add_last ']'
    display_ref buffer
  )










