Header
  + name := Cast
/* Cast type. */
Inherit

  + parent_expr:Flat Expr

Public

  - is_invariant:Boolean <- value.is_invariant

  + static_type:Type_full

  + value:Expr

  //
  // Creation.
  //

  - create t:Type_full value v:Expr :Self <-
  ( + result:Self

    result := clone
    result.make t value v
    result
  )

  - make t:Type_full value v:Expr <-
  (
    position    := v.position
    static_type := t
    value       := v
  )

  - my_copy:Self <-
  (
    create static_type value (value.my_copy)
  )

  //
  // Searching.
  //

  - get_type t:Types_tmp <-
  (
    t.add (static_type.raw)
  )

  //
  // Executing pass.
  //

  - remove <-
  (
    value.remove
  )

  - execute_unlink:Instr <-
  (
    value.execute_unlink
  )

  - execute_link:Expr <-
  ( + result:Expr
    + int:Int_cst
    + lst_typ:Types_tmp
    + other:Cast

    value  := value.execute_link
    result := self
    //
    ((is_integer (static_type.raw.name)) && {value.is_constant} &&
      {
        int ?= value;  
        int != NULL
      } 
    ).if {
      int.cast_type static_type
      result := value
      new_execute_pass
    }.elseif { 
      other ?= value
      (other != NULL) && {other.static_type = static_type}
    } then {
      result := value
      new_execute_pass
    } else {
      lst_typ := Types_tmp.new
      value.get_type lst_typ
      ((lst_typ.count = 1) && {lst_typ.first = static_type.raw}).if {
        result := value
        new_execute_pass
      }
      lst_typ.free
    }
    //
    result
  )

  //
  // Genere.
  //

  - genere <-
  (
    output.add_last '('
    output.add_last '('
    static_type.genere_declaration output
    output.add_last ' '
    static_type.genere_star_declaration output
    output.add_last ')'
    value.genere
    output.add_last ')'
  )
  
  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.add_last '('
    static_type.append_name_in buffer
    (static_type.is_flat).if_false {
      buffer.add_last '*'
    }
    buffer.add_last ')'
    value.display buffer
  )










