Header
  + name := Expr_multiple
/* Multiple expression manager 

  // BSBS: Utiliser ca une seule fois ! cela doit etre possible!
  */
Inherit

  - parent_expr:Expr := Expr

Public

  + expr_list:Array Expr

  - cardinality:Int <- expr_list.count

  - static_type:Type_full <-
  (
    expr_list.first.static_type
  )

  - get_type t:Types_tmp <-
  (
    crash_with_message "EXPR_MULTIPLE.get_type"
  )

  //
  // Creation
  //

  // BSBS: Optim : Il faut que ce soit alouer et free après !!!
  - create l:Array Expr :Self <-
  ( + result:Self
    result := clone
    result.make l
    result
  )

  - make l:Array Expr <-
  (
    expr_list := l
    position  := l.last.position
  )

  - my_copy:Self <-
  ( + new_lst:Array Expr

    new_lst := Array Expr .create_with_capacity (expr_list.count)
    (expr_list.lower).to (expr_list.upper) do { j:Int
      new_lst.add_last (expr_list.at j.my_copy)
    }
    Self.create new_lst
  )

  //
  // Remove.
  //

  - remove <-
  (
    (expr_list.lower).to (expr_list.upper) do { j:Int
      expr_list.at j.remove
    }
  )

  //
  // Execute.
  //

  - execute_unlink:Instr <-
  (
    (expr_list.lower).to (expr_list.upper) do { j:Int
      expr_list.at j.remove
    }
    NULL
  )

  - execute_link:Expr <-
  (
    list_current.debug_display
    crash_with_message "EXPR_MULTIPLE.execute_link"
    NULL
  )

  //
  // Contract Slot in/out, Section in/out, Prototype in/out
  //
  
  - to_run_contract msg:String_alias <-
  (
    expr_list.lower.to (expr_list.upper) do { j:Int
      expr_list.at j.to_run_contract msg
    }
  )

  //
  // Access facility.
  //

  - lower:Int <- expr_list.lower
  - upper:Int <- expr_list.upper

  - at i:Int :Expr <- expr_list.at i
  - last:Expr          <- expr_list.last
  - first:Expr         <- expr_list.first

  - count:Int <- expr_list.count

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.add_last '('
    (expr_list.lower).to (expr_list.upper - 1) do { j:Int
      expr_list.at j.display buffer
      buffer.add_last ','
    }
    expr_list.last.display buffer
    buffer.add_last ')'
  )
