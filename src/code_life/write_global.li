Header
  + name := Write_global
/*Write global*/
Inherit

  + parent_write:Flat Write

Public

  + global:Slot_data

  - variable:Variable <- global

  - first_access v:Local :Int <-
  ( + result:Int

    ((value = NULL) || {value.is_reading v}).if {
      result := 2
    }
    result
  )

  //
  // Creation.
  //

  - create p:Position with val:Expr in g:Slot_data :Self <-
  ( + result:Self
    ? {p.code != 0}
    result := clone
    result.make p with val in g
    result
  )

  - make p:Position with val:Expr in g:Slot_data <-
  (
    position := p
    value    := val
    global   := g
  )

  //
  // Execute.
  //

  - execute_access_unlink:Instr <-
  (
    Escape.on_global global
    global.execute
    NULL
  )

  - execute_access_link <-
  (
    Escape.on_global global
    global.execute
  )

  //
  // Genere
  //

  - genere <-
  (
    Type.add_genere_global global
    (quiet_generation).if_false {
      (is_cop).if {
        // Field of the universe base.
        output.append "li_base->"
      }
      output.append (global.intern_name)
      //
      ((value.static_type.raw = Type_null) && {variable.type.raw.is_block}).if {
        output.append ".__id=0"
      } else {
        output.add_last '='
        genere_value
      }
    }
  )
  




