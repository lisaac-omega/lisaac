Header
  + name := Nop
/* The nop instruction 

  // BSBS: il faurai voir si c'est encore utile... (attention à la phase recursive)
  */
Inherit

  + parent_instr:Flat Instr

Public

  - my_copy:Self <- self

  - first_access v:Local :Int <- 0

  //
  // Execute.
  //

  - remove <-
  (
    // Nothing.
  )

  - execute:Instr <- NULL

  //
  // Display.
  //

  - display buffer:String_buffer <-
  (
    buffer.append "nop"
  )






