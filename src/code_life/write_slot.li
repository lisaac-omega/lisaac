Header
  + name := Write_slot
/*Write slot*/
Inherit

  + parent_write:Flat Write

Public

  - is_invariant:Boolean <- receiver.is_invariant && {value.is_invariant}

  + slot:Slot_data

  - variable:Variable <- slot

  - first_access v:Local :Int <-
  ( + result:Int

    ((value = NULL) || {value.is_reading v} || {receiver.is_reading v}).if {
      result := 2
    }
    result
  )

  + receiver:Expr

  // Creation.
  
  - create p:Position with val:Expr in (r:Expr,s:Slot_data) :Self <-
  ( + result:Self
    ? {p.code != 0}
    result := clone
    result.make p with val in (r,s)
    result
  )

  - make p:Position with val:Expr in (r:Expr,s:Slot_data) <-
  (
    position := p
    value    := val
    receiver := r
    slot     := s
  )

  - my_copy:Self <-
  ( + new_val:Expr
    + result:Self

    new_val := value.my_copy
    result ?= variable.write position with (receiver.my_copy) value new_val
    (quiet_generation).if {
      result.set_quiet_generation
    }
    result
  )

  //
  // Execute.
  //

  - execute_access_unlink:Instr <-
  (
    slot.execute
    receiver.execute_unlink
  )

  - execute_access_link <-
  ( 
    slot.execute 
    receiver := receiver.execute_link
  )

  - remove <-
  (
    receiver.remove
    parent_write.remove
  )

  // Genere
  
  - prefix_receiver:Read_slot <-
  ( + result:Read_slot
    result ?= receiver
    result
  )

  - is_prefix_write:Boolean <-
  // The whole prefix parent of a late binding type is written: its @__id is the @__id of the receiver.
  (slot = slot.receiver_type.prefix_slot) && {slot.receiver_type.is_late_binding}

  - genere_receiver_pointer <-
  ( + tf:Type_full

    tf := receiver.static_type
    ((tf.is_flat) && {(! tf.is_flat_ref) || {tf.is_default_flat}}).if {
      output.append "&("
      receiver.genere
      output.add_last ')'
    } else {
      receiver.genere
    }
  )

  - genere <-
  ( + tf:Type_full
    + t:Type

    t := slot.receiver_type
    t.add_genere_list
    ((! quiet_generation) && {! Escape.is_skipped_write self}).if {
      // The `NULL' of a moved field (`One') is written in `-boost' too: the field may be read
      // after (compared to `NULL'), the two modes must agree (see @Write.is_move_null).
      (is_prefix_write).if {
        output.append "{uint32_t __li_id=((struct ___OBJ *)"
        genere_receiver_pointer
        output.append ")->__id; "
      }
      ((t.alias_slot = NULL) && {prefix_receiver != NULL} && {prefix_receiver.is_prefix_read}).if {
        // Through prefix parents: ((Parent *)receiver)->slot.
        output.append "(("
        t.put_reference_declaration output
        output.add_last ' '
        t.put_reference_star_declaration output
        output.add_last ')'
        prefix_receiver.genere_prefix_pointer
        output.append ")->"
        output.append (variable.intern_name)
      }.elseif {t.alias_slot = variable} then {
        tf := receiver.static_type
        ((tf.is_exact) || {tf.is_flat_ref}).if {
          output.append "(*"
          receiver.genere
          output.add_last ')'
        }.elseif {tf.is_flat} then {
          receiver.genere
        } else {
          output.append "*(("
          t := slot.receiver_type
          t.put_reference_declaration output
          output.add_last ' '
          t.put_reference_star_declaration output
          output.add_last ')'
          receiver.genere
          output.add_last ')'
        }
      } else {
        // Receiver.        
        tf := receiver.static_type
        // A flat receiver (even exact, as `Flat Array') is a structure: `.', as @Read_slot.
        (((tf.is_exact) && {! tf.is_flat}) || {(tf.is_flat_ref) && {!tf.is_default_flat} /* 14Mars */}).if {
          receiver.genere
          output.append "->"
        }.elseif {tf.is_flat} then {
          receiver.genere
          output.add_last '.'
        } else {
          output.append "(("
          t := slot.receiver_type
          t.put_reference_declaration output
          output.add_last ' '
          t.put_reference_star_declaration output
          output.add_last ')'
          receiver.genere
          output.append ")->"
        }
        //
        output.append (variable.intern_name)
      }
      //
      ((value.static_type.raw = Type_null) && {variable.type.raw.is_block}).if {
        output.append ".__id=0"
      } else {
        output.add_last '='
        genere_value
      }
      (is_prefix_write).if {
        output.append "; ((struct ___OBJ *)"
        genere_receiver_pointer
        output.append ")->__id=__li_id;}"
      }
    }
  )
  
  // Display.
  
  - display buffer:String_buffer <-
  (
    receiver.display buffer
    buffer.append "->"
    parent_write.display buffer
  )
