Header
  + name := Itm_type_style
/*Type with style*/
Inherit

  + parent_itm_type_simple:Flat Itm_type_simple

Private

  - dico_ts:Array Itm_type_style := Array Itm_type_style .create_with_capacity 32

  - create n:String_alias style s:Uint8 :Self <-
  ( + result:Self

    result := clone
    result.make n style s
    result
  )

  - make n:String_alias style s:Uint8 <-
  (
    name  := n
    style := s
  )

Public
    
  + style:Uint8
  
  - get n:String_alias style s:Uint8 :Self <-
  ( + result:Self
    + idx:Int

    idx := dico_ts.lower
    {
      (idx <= dico_ts.upper) && {
        (dico_ts.at idx.name  != n) ||
 {dico_ts.at idx.style != s} 
      }
    }.while_do {
      idx := idx + 1
    }
    (idx <= dico_ts.upper).if {
      result ?= dico_ts.at idx
    } else {
      result := create n style s
      dico_ts.add_last result
    }
    result
  )


