Header
  + name := Itm_character
/*CHARACTERacter constant*/
Inherit

  + parent_itm_constant:Flat Itm_constant

Public

  //
  // Data
  //

  + character:String_alias

  //
  // Creation
  //

  - create p:Position char n:String_alias :Self <-
  ( + result:Self
    result := clone
    result.make p char n
    result
  )

  - make p:Position char n:String_alias <-
  (
    position:=p
    character:=n
  )

  //
  // Runnable
  //

  - to_run_expr:Expr <-
  (
    Character_cst.create position char character
  )

  //
  // Display.
  //

  - append_in b:String_buffer <-
  (
    b.add_last '\''
    b.append character
    b.add_last '\''
  )
