Header
  + name := Itm_list
/*Instruction list*/
Inherit

  + parent_itm_code:Flat Itm_code

Public

  // BSBS: OPTIM : Dans 95% des cas, les list sont sans local (il faudrait spécialiser)
  // Mais pb avec le parser...

  //
  // Data
  //

  + local_list:Array Itm_local;  // `+'

  + static_list:Array Itm_local; // `-'

  + code:Array Itm_code

  + is_check_name:Boolean

  - is_check_local:Int

  //
  // Constructor
  //

  - create p:Position :Self <-
  ( + result:Self
    result := clone
    result.make p
    result
  )

  - make p:Position <-
  (
    position := p
  )

  //
  // Added
  //

  - set_local_list l:Array Itm_local <-
  (
    ? {! l.is_empty}
    local_list := l
  )

  - set_static_list l:Array Itm_local <-
  (
    ? {! l.is_empty}
    static_list := l
  )

  - set_code c:Array Itm_code <-
  (
    code := c
  )

Public

  - is_affect:Position <-
  ( + result,default:Position
    + j:Int
    + itm_r:Itm_result

    j := code.lower
    {(j < code.upper) && {result = default}}.while_do {
      itm_r ?= code.at j
      (itm_r != NULL).if {
        result := itm_r.is_affect
      } else {
        result := code.at j.position
      }
      j := j + 1
    }
    (result = default).if {
      result := code.last.is_affect
    }
    result
  )

  //
  // Runnable.
  //

  - to_run_expr:Expr <-
  // List intern.
  ( + i:Instr
    + var:Local
    + stack_top:Int
    + result_top:Int
    + result:Expr
    + nb_result:Int
    + lr:Array Expr
    
    //current_list_level := current_list_level + 1;
    stack_top  := stack_local .upper + 1
    result_top := stack_result.upper + 1

    // Push Local.
    (local_list != NULL).if {
      (local_list.lower).to (local_list.upper) do { j:Int
        var := local_list.at j.to_run
        stack_local.add_last var
        var.init
      }
    }
    (static_list != NULL).if {
      (static_list.lower).to (static_list.upper) do { j:Int
        var := static_list.at j.to_run_static
        stack_local.add_last var
      }
    }
    // Append code.
    (code.lower).to (code.upper) do { j:Int
      i := code.at j.to_run
      list_current.add_last i
    }
    // Compute result expr.
    nb_result := stack_result.upper - result_top + 1

    (nb_result = 0).if {
      result := Prototype_cst.create position type (Type_void.default); // BSBS: Alias.
    } else {
      (nb_result > 1).if {
        // Creation Vector.
        lr := Array Expr .create_with_capacity nb_result
        (result_top).to (stack_result.upper) do { j:Int
          lr.add_last (stack_result.at j.read position)
        }
        result := Expr_multiple.create lr
      } else {
        result := stack_result.last.read position
      }
    }
    // Pop local / Result.
    pop_stack_until stack_top
    stack_result.set_upper (result_top-1); // remove_since result_top
    ? {stack_result.upper = Old stack_result.upper}
    //
    //current_list_level := current_list_level - 1;
    result
  )

  //
  // Display.
  //

  - append_in b:String_buffer <-
  (
    (code.count = 1).if {
      b.add_last '('
      code.first.append_in b
      b.add_last ')'
    } else {
      b.append "(\n"
      (code.lower).to (code.upper) do { i:Int
        indent.append "  "
        code.at i.append_in b
        b.append ";\n"
      }
      indent.remove_tail 2
      b.append ")"
    }
  )

Itm_list, Itm_result

  - stack_result:Array Local := Array Local .create_with_capacity 16




