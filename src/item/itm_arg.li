Header
  + name := Itm_arg
/*One argument*/
Inherit

  + parent_itm_argument:Flat Itm_argument

Public

  + name:String_alias
  //+ pretty_name:String_alias

  + type:Itm_type

  - upper:Int := 0
  
  - is_self:Boolean <- name = "self"
  
  //
  // Creation.
  //

  - create p:Position name n:String_alias type t:Itm_type :Self <-
  ( + result:Self

    result := Self.clone
    result.make p name n type t
    result
  )

  - make p:Position name n:String_alias type t:Itm_type <-
  (
    position := p
    name     := n
    type     := t
  )

  //
  // Running.
  //

  - at idx:Int :Itm_type <-
  ( ? {idx = 0}
    type
  )

  - to_run_in arg_lst:Array Local for p:Parameter_to_type <-
  ( + t:Itm_type

    (name = "self").if { 
      t := Itm_type_simple.type_self
    } else {
      t := type
    }
        
    arg_lst.add_last (      
      Local.create position name name style ' ' type (t.to_run_for p pos (position.prototype.filename))
    )
    (verify).if {
      check_local_with_slot position name name
    }
    arg_count_tmp := arg_count_tmp + 1
  )

  - get_index_type p:Itm_type_parameter :Int <-
  ( + result:Int
    (type != p).if {
      result := 1
    }
    result
  )

  - check larg:Array Expr index idx:Int for p:Parameter_to_type :Int <-
  ( + new_expr:Expr

    new_expr := larg.at idx.check_type (type.to_run_for p pos (position.prototype.filename)) with position
    larg.at idx put new_expr
    idx + 1
  )

  //
  // Display.
  //

  - append_in buffer:String_buffer <-
  (
    buffer.append name
    buffer.add_last ':'
    type.append_in buffer
  )

  - shorter_in buf:String_buffer <-
  (
    (name = "self").if {
      put name to buf like "keyword"
    } else {
      put name to buf like "local"
    }
    buf.add_last ':'
    type.shorter_in buf
  )


