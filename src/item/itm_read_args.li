Header
  + name := Itm_read_args
/*Message with a lot of arguments*/
Inherit

  + parent_itm_read:Flat Itm_read

Public

  - is_affect:Position <-
  ( + result,default:Position
    + j:Int

    (args.first != NULL).if {
      result := args.first.position
    } else {
      j := args.lower + 1
      {(j <= args.upper) && {result = default}}.while_do {
        result := args.at j.is_affect
        j := j + 1
      }
    }
    result
  )

  //
  // Data
  //

  + args:Array Itm_code

  //
  // Constructor
  //

  - create p:Position name n:String_alias args arg:Array Itm_code :Self <-
  ( + result:Self
    result := clone
    result.make p name n args arg
    result
  )

  - make p:Position name n:String_alias args arg:Array Itm_code <-
  (
    position := p
    name := n
    args     := arg
  )

  //
  // Runnable
  //

  - to_run_expr:Expr <-
  ( + l_arg:Array Itm_code

    l_arg := Alias_array Itm_code .new
    (args.lower+1).to (args.upper) do { j:Int
      l_arg.add_last (args.at j)
    }
    to_run_with (args.first) args l_arg
  )








