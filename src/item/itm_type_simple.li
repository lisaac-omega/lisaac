Header
  + name := Itm_type_simple
/*Simple type*/
Inherit

  + parent_itm_type_mono:Flat Itm_type_mono

Itm_type_simple, Itm_type_self

  - dico:Hmap Itm_type_simple Key String_alias := new Hmap Itm_type_simple Key String_alias

Itm_type_simple

  - create n:String_alias :Self <-
  ( + result:Self

    result := clone
    result.make n
    result
  )

  - make n:String_alias <-
  (    
    name := n
    dico.at n put self
  )

Public

  - type_null:Itm_type_simple := Itm_type_simple.get str_null
  - type_void:Itm_type_simple := Itm_type_simple.get "VOID"
  - type_self:Itm_type_simple := Itm_type_parameter.create str_self
  - type_self_with_escape:Itm_type_simple := type_self; // BSBS A revoir...

  - hash_code:Int <- name.hash_code

  + name:String_alias

  - style:Uint8 <- 0

  - is_flat:Boolean <- (style & Type_full.flat_bit) != 0
  
  - is_exact:Boolean   <- (style & Type_full.exact_bit) != 0
  
  - is_escape:Boolean   <- (style & Type_full.escape_bit) != 0
  
  - get n:String_alias :Itm_type_simple <-
  [
    -? {n != NULL}
  ]
  ( + result:Itm_type_simple
  //result := dico.reference_at n
    result := dico.search n raw
    (result = NULL).if {
      result := create n
    }
    result
  )

  - to_run_for p:Parameter_to_type pos path:String_alias :Type_full <-
  ( + result:Type_full

    (self = type_null).if {
      result := Type_null.default
    }.elseif {self = type_void} then {
      result := Type_void.default
    } else {      
      result := Type.get (path,self)
    }
    result
  )
  
  - self:Self '==' Right 60 other:E :Boolean <-
  ( + o:Self
    
    o ?= other
    (o != NULL) && {self = o}
  )
  
  - append_in b:String_buffer <-
  (
    append_style_in b
    b.append name
  )
  
  - append_style_in buffer:String_buffer <-
  (
    (is_flat).if {
      buffer.append "Flat "
    }
    (is_exact).if {
      buffer.append "Exact "
    }
    (is_escape).if {
      buffer.add_last '\\'
    }
  )

  - shorter_in buf:String_buffer <-
  (
    (style != NULL).if {
      put style to buf like "keyword"
      buf.add_last ' '
    }
    put name to buf like "prototype"
  )

  //
  // Cast.
  //

  - append_cast_name_in buf:String_buffer <-
  (
    (name.lower).to (name.upper) do { j:Int
      buf.add_last (name.at j.to_lower)
    }
  )

