Header
  + name := Itm_external_type
/*External C with type result*/
Inherit

  + parent_itm_extern:Flat Itm_extern

Public

  //
  // Data
  //

  + type:Itm_type

  + type_list:Itm_type

  + is_persistant:Boolean

  //
  // Constructor
  //

  - create p:Position text n:String_alias persistant per:Boolean :Self <-
  ( + result:Self
    result := clone
    result.make p text n persistant per
    result
  )

  - make p:Position text n:String_alias persistant per:Boolean <-
  (
    position := p
    text     := n
    is_persistant := per
  )

  //
  // Added
  //

  - set_type t:Itm_type <-
  (
    type := t
  )

  - set_type_list t:Itm_type <-
  (
    type_list := t
  )

  //
  // Runnable
  //

  - to_run_expr:Expr <-
  ( + e:External_c
    + lt:Types_tmp
    + lst_acc:Array Expr
    + typ:Type
    + tmp:Variable
    + typ_mul:Itm_type_multi
    + typ_mon:Itm_type_mono

    lst_acc := get_access
    last_position := position
    e := External_c.create position text last_code
    access lst_acc persistant is_persistant type (type.to_run_for profil_slot pos (position.prototype.filename))

    (type_list != NULL).if {
      lt := Types_tmp.new
      typ_mul ?= type_list
      (typ_mul != NULL).if {
        (typ_mul.lower).to (typ_mul.upper) do { j:Int
          typ := typ_mul.at j.to_run_for profil_slot pos (position.prototype.filename).raw
          lt.add typ
        }
      } else {
        typ_mon ?= type_list
        typ := typ_mon.to_run_for profil_slot pos (position.prototype.filename).raw
        lt.add typ
      }
      e.set_living_type (lt.to_types)
    }
    // For argument.
    tmp := e.static_type.get_temporary position
    list_current.add_last (tmp.write position value e)
    tmp.read position
  )




