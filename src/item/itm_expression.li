Header
  + name := Itm_expression
/*operator list message*/
Inherit

  - parent_itm_code:Itm_code := Itm_code

Public

  - position:Position <- value_list.first.position

  //
  // Data
  //

  + value_list:Array Itm_code

  //
  // Constructor
  //

  - create v:Array Itm_code :Self <-
  ( + result:Self
    result := clone
    result.make v
    result
  )

  - make v:Array Itm_code <-
  (
    value_list    := v
  )

  //
  // Runnable.
  //

  - to_run_expr:Expr <-
  ( + max_pos,max_lev,idx,idx_post,idx_pre,low:Int
    + continue:Boolean
    + max_pri  :String_alias
    + left,right:Expr
    + instr:Instr
    + val_list:Array Instr
    + val:Expr
    + typ:Type
    + slo:Slot
    + nam,op_name:String_alias
    + site:Node
    + n_t:Node_type
    + ext:Expr_binary_cmp
    //+ loc:VARIABLE
    + l_arg:Array Expr
    + result:Expr
    + itm_op:Itm_operator
    + em:Expr_multiple

    val_list := Alias_array Instr.new
    // Search unary message.
    idx := -1
    low := value_list.lower
    {
      // Search first message.
      {
        idx := idx + 1
        itm_op ?= value_list.at idx
      }.do_while {(itm_op != NULL) && {idx != value_list.upper}}
      (itm_op != NULL).if {
        semantic_error (itm_op.position,"Operator postfix not found.")
      }
      val := value_list.at idx.to_run_expr
      typ := val.static_type.raw
      (typ = Type_void).if {
        semantic_error (val.position,"Expression type `Void'.");
      }
      // Post-fix.
      idx_post := idx + 1
      continue := True
      {(idx_post <= value_list.upper) && {continue}}.while_do {
        continue := False
        (idx_post != value_list.upper).if {
          itm_op ?= value_list.at (idx_post + 1)
        }
        ((idx_post = value_list.upper) || {itm_op != NULL}).if {
          itm_op ?= value_list.at idx_post
          slo := typ.get_slot (operator "__postfix" name (itm_op.name))
          (slo != NULL).if {
            site := Node.new_read (itm_op.position) slot slo receiver val self val intern False
            list_current.add_last site
            val := site.result_expr
            idx_post := idx_post + 1
            continue := True
          }
        }
      }
      // Pre-fix.
      idx_pre := idx - 1
      continue := True
      {(idx_pre >= low) && {continue}}.while_do {
        continue := False
        (idx_pre != low).if {
          itm_op ?= value_list.at (idx_pre - 1)
        }
        ((idx_pre = low) || {itm_op != NULL}).if {
          itm_op ?= value_list.at idx_pre
          slo := typ.get_slot (operator "__prefix" name (itm_op.name))
          (slo = NULL).if {
            error_slot (itm_op.position) name "prefix" operator (itm_op.name) in typ
          }
          site := Node.new_read (itm_op.position) slot slo receiver val self val intern False
          list_current.add_last site
          val := site.result_expr
          idx_pre := idx_pre - 1
          continue := True
        }
      }
      val_list.add_last val
      idx := idx_post
      (idx < value_list.upper).if {
        // Infix.
        typ := val.static_type.raw
        (typ = Type_void).if {
          semantic_error (val.position,"Expression type `Void'.");
        }
        itm_op ?= value_list.at idx
        op_name := itm_op.name
        (op_name = "=").if {
          instr := Expr_equal
        }.elseif {op_name = "!="} then {
          instr := Expr_not_equal
        } else {
          nam := operator "__infix" name op_name
          slo := typ.get_slot nam
          (slo = NULL).if {
            error_slot (itm_op.position) name "infix" operator op_name in typ
          }
          instr := Node.new_read_partial (itm_op.position) slot slo
        }
        val_list.add_last instr
      }
      low := idx_post + 1
    }.do_while {idx <= value_list.upper}

    {val_list.count = 1}.until_do {
      // Search max level.
      max_lev := -1
      from (val_list.lower+1) to (val_list.upper-1) step 2 do { j:Int
        site ?= val_list.at j
        (site = NULL).if {
          // '=' or '!='.
          (
            (50 > max_lev) || {(50 = max_lev) && {max_pri = "Right"}}
          ).if {
            max_lev := 50
            max_pri := "Right"
            max_pos := j
          }
        } else {
          // Other:
          slo := site.data.slot
          (
            (slo.priority > max_lev) ||
            {
              (slo.priority = max_lev) &&
              {slo.associativity = max_pri} &&
              {max_pri = "Right"}
            }
          ).if {
            max_lev := slo.priority
            max_pri := slo.associativity
            max_pos := j
          }
        }
      }

      n_t   ?= val_list.at max_pos
      left  ?= val_list.at (max_pos - 1)
      right ?= val_list.at (max_pos + 1)
      (n_t = NULL).if {
        // '=' or '!='.        
        ext ?= val_list.at max_pos
        //ext.set_left left and_right right
        (left,right) := cmp_verify (left.position) between (left,right)
        val := product_cmp (left,right) ext ext pos (left.position)
        //loc  := type_boolean.default.get_temporary (ext.position)
        //instr:= loc.write (ext.position) value ext
        //list_current.add_last instr
        //val := loc.read (instr.position)
      } else {
        // SW_READ.
        l_arg := Array Expr .create_with_capacity 2
        em ?= left
        (em = NULL).if {
          l_arg.add_last left
        } else {
          l_arg.append_collection (em.expr_list)
        }
        em ?= right
        (em = NULL).if {          
          l_arg.add_last right
        } else {
          l_arg.append_collection (em.expr_list)
        }        
        slo := left.static_type.raw.get_slot (n_t.data.slot.name)
        n_t.new_read_finalize (left.my_copy,slo) with l_arg
        list_current.add_last n_t
        val := n_t.result_expr
      }

      // Delete operator.
      val_list.remove max_pos
      val_list.remove max_pos
      //
      val_list.at (max_pos - 1) put val
    }

    result ?= val_list.first

    // Free Array Temporary.
    Alias_array Instr .free val_list

    result
  )

  //
  // Display.
  //

  - append_in b:String_buffer <-
  (
    (value_list.lower).to (value_list.upper) do { i:Int
      value_list.at i.append_in b
    }
  )

Private

  - error_slot p:Position name s:String_alias operator op:String_alias in t:Type <-
  (
    string_tmp.copy "Slot "
    string_tmp.append s
    string_tmp.append " '"
    string_tmp.append op
    string_tmp.append "' not found in "
    string_tmp.append (t.name)
    string_tmp.add_last '.'
    semantic_error (p,string_tmp)
  )




