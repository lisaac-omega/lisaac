Header
  + name := Itm_real
/*Real float constant*/
Inherit

  + parent_itm_constant:Flat Itm_constant

Public

  //
  // Data
  //

  + value:String_alias

  //
  // Constructor
  //
  - create p:Position value n:String_alias :Self <-
  ( + result:Self
    result := clone
    result.make p value n
    result
  )

  - make p:Position value n:String_alias <-
  (
    position:=p
    value:=n
  )

  //
  // Runnable
  //

  - to_run_expr:Expr <-
  (
    Real_cst.create position value value type (type_real64.default)
  )

  //
  // Display.
  //

  - append_in b:String_buffer <-
  (
    b.append value
  )

