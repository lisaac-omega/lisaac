Header
  + name := Itm_pattern
Inherit

  - parent_any:Any := Any

Public
  
  + pattern_in :Itm_list
  
  + pattern_out:Itm_list
  
  - set_pattern_in p:Itm_list <-
  (
    pattern_in := p
  )
  
  - set_pattern_out p:Itm_list <-
  (
    pattern_out := p
  )
  
  - append_pattern_in buf:String_buffer <-
  (
    (pattern_in != NULL).if {
      buf.append "In: "
      pattern_in.append_in buf
    }
    (pattern_out != NULL).if {      
      (pattern_in != NULL).if {
        buf.append ";\n"
        buf.append indent
      }
      buf.append "Out: "
      pattern_out.append_in buf
    }
  )
