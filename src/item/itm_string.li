  ( + i,result:Int
    i := string.lower
    {i <= string.upper}.while_do {
      (string.at i = '\\').if {
        i := i + 1
        (string.at i.is_digit).if {
          i := i + 1
          ((i < string.upper-1) && {string.at i.is_digit}).if {
            i := i + 2
          }
        }
      }
      result := result + 1
      i := i + 1
    }
    result
  )
  */




