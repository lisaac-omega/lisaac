Header
  + name := Itm_write
/*Parent for all write*/
Inherit

  + parent_itm_code:Flat Itm_code

Public

  //
  // Data
  //

  + assign:Itm_code

  + value:Itm_code

  - type:String_alias <-
  (
    abstract
    NULL
  )

  //
  // Constructor
  //

  - create p:Position assign n:Itm_code with v:Itm_code :Self <-
  [ -? {p != 0}; ]
  ( + result:Self
    result := clone
    result.make p assign n with v
    result
  )

  - make p:Position assign n:Itm_code with v:Itm_code <-
  (
    position := p
    assign   := n
    value    := v
  )

  //
  // Access.
  //

  - get_simple_name:String_alias <-
  ( + result:String_alias
    + without_arg:Itm_read

    without_arg ?= assign
    (without_arg != NULL).if {
      result := without_arg.name
    } else {
      semantic_error (position,"ITM_WRITE: Not yet implemented.")
    }
    result
  )

  //
  // Display.
  //

  - append_in b:String_buffer <-
  (
    assign.append_in b
    b.append type
    value.append_in b
  )

Private

  - check_one_field src:Itm_code to dst:String_alias <-
  // `One': a `One' field of another object (`o.f') is moved only into a `One' variable (else
  // `o' would keep it too).
  ( + r1:Itm_read_arg1
    + loc:Local
    + typ:Type
    + slot:Slot
    r1 ?= without_parentheses src
    ((r1 != NULL) && {r1.arg != NULL} && {read_name (r1.arg) != NULL} && {is_data_variable (read_name (r1.arg))} && {! is_one_variable dst}).if {
      loc := lookup (read_name (r1.arg))
      (loc != NULL).if {
        typ := loc.type.raw
        slot := typ.get_slot (r1.name)
        ((slot != NULL) && {slot.slot_data_intern != NULL} && {slot.slot_code_intern = NULL} && {slot.slot_data_for typ.type.is_one}).if {
          string_tmp.copy "COP: the `One' field `"
          string_tmp.append (r1.name)
          string_tmp.append "' of another object can be moved only into a `One' variable: `"
          string_tmp.append dst
          string_tmp.append "' is not `One'."
          semantic_error (position,string_tmp)
        }
      }
    }
  )

  - move_from src:Itm_code to dst:String_alias <-
  // COP, `One' type (only one reference): `a := b' moves `b' (see @Itm_code.emit_move).
  (
    ((read_name src != dst) && {is_one_variable dst}).if {
      check_one_source src to_one True
    }
  )

  - check_one v:Expr to t:Type_full name n:String_alias <-
  // A `One' object can be stored only in a `One' variable (else, a second reference).
  (
    ((v.static_type.is_one) && {! t.is_one}).if {
      string_tmp.copy "COP: a `One' object (only one reference) can be stored only in a `One' variable: `"
      string_tmp.append n
      string_tmp.append "' would be a second reference."
      semantic_error (position,string_tmp)
    }
  )

  - affect name:String_alias with v:Expr :Expr <-
  ( + loc:Local
    + result:Expr

    loc := lookup name
    (loc != NULL).if {
      result := affect_local loc with v
    } else {
      result := affect_slot name with v
    }
    result
  )

  - affect_local loc:Local with v:Expr :Expr <-
  ( + e:Instr
    + result:Expr
    + val:Expr

    (loc.style = '-').if {
      result := affect_slot (loc.intern_name) with v
    } else {
      (loc.style = ' ').if {
        Position.put_error semantic text "Argument assignment is not possible."
        loc.position.put_position
        position.put_position
        Position.send_error
      }
      val := v.check_type (loc.type) with position
      e := loc.write position value val
      list_current.add_last e
      result := loc.read position
    }
    result
  )

  - affect_slot name:String_alias with v:Expr :Expr <-
  ( + loc:Variable
    + slot:Slot
    + slot_dta:Slot_data
    + node:Node
    + result:Expr
    + rec:Expr
    + typ:Type
    + em:Expr_multiple
    + new_val:Expr
    + lst:Array Expr

    loc := lookup "self"
    rec := loc.read position
    //
    typ := rec.static_type.raw
    slot := typ.get_slot name
    (slot = NULL).if {
      string_tmp.copy "Slot `";
      string_tmp.append name
      string_tmp.append "' not found in static type "
      typ.append_name_in string_tmp
      string_tmp.add_last '.'
      semantic_error (position,string_tmp)
    }
    // Control type.
    em ?= v
    slot_dta := slot.slot_data_for typ
    (em != NULL).if {
      lst := em.expr_list
      (lst.lower).to (lst.upper - 1) do { j:Int
        new_val := (lst.at j).check_type (slot.slot_data_list.at j.type) with (slot.position)
        lst.at j put new_val
      }
      new_val := (lst.last).check_type (slot_dta.type) with (slot.position)
      lst.at (lst.upper) put new_val
      new_val := em
    } else {
      check_one v to (slot_dta.type) name name
      new_val := v.check_type (slot_dta.type) with (slot.position)
    }
    //
    node := Node.new_write position slot slot receiver rec value new_val
    list_current.add_last node
    result := node.result_expr
    result
  )

