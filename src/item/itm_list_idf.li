Header
  + name := Itm_list_idf
/*List identifier for assignment.*/
Inherit

  + parent_itm_code:Flat Itm_code

Public

  - is_affect:Position; // Nothing (it s good with 0).
  // BSBS: A quoi ca sert ca ??? 

  //
  // Data
  //

  + list_name:Array String_alias

  //
  // Constructor
  //

  - create p:Position with lst:Array String_alias :Self <-
  ( + result:Self
    result := clone
    result.make p with lst
    result
  )

  - make p:Position with lst:Array String_alias <-
  (
    position  := p
    list_name := lst
  )

  //
  // Runnable
  //

  - to_run_expr:Expr <-
  (
    semantic_error (position,"ITM_LIST_IDF.to_run_expr")
    NULL
  )

