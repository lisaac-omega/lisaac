Header
  + name := Itm_number
/*Int constant*/
Inherit

  + parent_itm_constant:Flat Itm_constant

Public

  //
  // Data
  //

  + value:Int64

  //
  // Constructor
  //
  - create p:Position value n:Int64 :Self <-
  ( + result:Self
    result := clone
    result.make p value n
    result
  )

  - make p:Position value n:Int64 <-
  (
    position:=p
    value:=n
  )

  //
  // Runnable
  //

  - to_run_expr:Expr <-
  (
    Int_cst.create position value value type (type_integer.default)
  )

  //
  // Display.
  //

  - append_in b:String_buffer <-
  (
    value.append_in b
  )


