Header
  + name := Itm_operator
/*operator list message*/
Inherit

  + parent_itm_code:Flat Itm_code

Public

  + name:String_alias

  //
  // Constructor
  //

  - create p:Position name n:String_alias :Self <-
  [
    -? {p.code != 0}
  ]
  ( + result:Self
    result := clone
    result.make p name n
    result
  )

  - make p:Position name n:String_alias <-
  (
    position := p
    name := n
  )

  //
  // Runnable.
  //

  - to_run_expr:Expr <-
  (
    crash_with_message "ITM_OPERATOR.to_run_expr"
    NULL
  )

  //
  // Display.
  //

  - append_in b:String_buffer <-
  (
    b.append name
  )


