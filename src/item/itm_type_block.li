Header
  + name := Itm_type_block
/*Type block definition*/
Inherit

  + parent_itm_type_mono:Flat Itm_type_mono

Itm_type_simple, Itm_type_self

  - dico:Array Itm_type_block := Array Itm_type_block .create_with_capacity 32

Private

  - create typ_arg:Itm_type and typ_res:Itm_type :Self <-
  ( + result:Self

    result := clone
    result.make typ_arg and typ_res
    result
  )

  - make typ_arg:Itm_type and typ_res:Itm_type <-
  (
    type_argument := typ_arg
    type_result   := typ_res
  )

Public

  + type_argument:Itm_type
  + type_result:Itm_type

  - get typ_arg:Itm_type and typ_res:Itm_type :Itm_type_block <-
  ( + result:Itm_type_block
    + idx:Int

    idx := dico.lower
    {
      (idx <= dico.upper) && {
        {dico.at idx.type_argument != typ_arg} ||
        {dico.at idx.type_result   != typ_res}
      }
    }.while_do {
      idx := idx + 1
    }
    (idx <= dico.upper).if {
      result := dico.at idx
    } else {
      result := create typ_arg and typ_res
      dico.add_last result
    }
    result
  )

  - to_run_for p:Parameter_to_type pos path:String_alias :Type_full <-
  (
    Type_block.get self with p
  )

  - hash_code:Int <-
  (
    '{'.to_int
  )

  - append_in b:String_buffer <-
  ( + typ_mul:Itm_type_multi
    b.add_last '{'
    (type_argument != NULL).if {
      type_argument.append_in b
      b.add_last ';'
      b.add_last ' '
    }
    (type_result != NULL).if {
      typ_mul ?= type_result
      (typ_mul = NULL).if {
        type_result.append_in b
      } else {
        typ_mul.display_raw b
      }
    }
    b.add_last '}'
  )
    
  //
  // Cast.
  //

  - append_cast_name_in buf:String_buffer <-
  (
    crash_with_message "ITM_TYPE_BLOCK.append_cast_name_in "
  )
