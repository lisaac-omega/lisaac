Header
  + name := Itm_result
/*Result value*/
Inherit

  - parent_itm_code:Itm_code := Itm_code

Public

  - is_affect:Position <- value.is_affect

  - position:Position <- value.position

  //
  // Data
  //

  + value:Itm_code

  //
  // Constructor
  //

  - create r:Itm_code :Self <-
  [
    -? {r != NULL}
    -? {r.position.code != 0}
  ]
  ( + result:Self

    result := clone
    result.make r
    result
  )

  - make r:Itm_code <-
  (
    value    := r
  )

  //
  // Runnable
  //

  - to_run:Instr <-
  ( + mul:Expr_multiple
    + val:Expr
    + result:Instr

    val := value.to_run_expr
    mul ?= val
    (mul != NULL).if {
      (mul.lower).to (mul.upper-1) do { j:Int
        result := to_run_intern (mul.at j)
        list_current.add_last result
      }
      result := to_run_intern (mul.last)
    } else {
      result := to_run_intern val
    }
    result
  )

  - to_run_expr:Expr <-
  (
    crash
    NULL
  )

  //
  // Display.
  //

  - append_in b:String_buffer <-
  (
    b.append "return("
    value.append_in b
    b.add_last ')'
  )

Private

  - to_run_intern val:Expr :Instr <-
  ( + var:Local
    + rd:Read_local
    var := val.static_type.get_temporary (val.position)
    rd ?= val
    (rd != NULL).if { var.set_pow (rd.local.pow) loc (rd.local.lpow) }
    Itm_list.stack_result.add_last var
    var.write (val.position) value val
  )

