Header
  + name := Itm_super
/*Super*/
Inherit

  + parent_itm_code:Flat Itm_code

Public
  
  //
  // Constructor
  //

  - create p:Position :Self <-
  ( + result:Self
    result := clone
    result.make p
    result
  )

  - make p:Position <-
  (
    position := p
  )

  //
  // Runnable
  //

  - to_run:Instr <-
  ( crash_with_message "ITM_SUPER.to_run"
    /*
    + contract:ITM_LIST
    + res:EXPR
    + slot_code:SLOT_CODE
    
    slot_code ?= profil_slot.slot
    contract := slot_code.previous_contract
    (contract != NULL).if {
      res := contract.to_run_expr
      res.to_run_contract "Section exit violated"
    };*/
    Nop
  )
  
  - to_run_expr:Expr <-
  ( 
    crash_with_message "ITM_SUPER.to_run_expr"
    NULL
  )

  //
  // Display.
  //

  - append_in buffer:String_buffer <-
  (
    buffer.add_last '.'
  )
