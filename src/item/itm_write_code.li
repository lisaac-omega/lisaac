Header
  + name := Itm_write_code
/*Assignment slot with new code*/
Inherit

  + parent_itm_write:Flat Itm_write

Public

  - type:String_alias <- "<-"

  //
  // Runnable
  //

  - to_run_expr:Expr <-
  ( + itm_read:Itm_read
    + loc:Local
    + rec:Expr
    + node:Node
    + result:Expr
    + typ:Type_full
    + slot:Slot
    + name:String_alias

    itm_read ?= assign
    name := itm_read.name
    ? {itm_read != NULL}
    loc := lookup "self"
    rec := loc.read position
    //
    typ  := rec.static_type
    slot := typ.get_slot name
    (slot = NULL).if {
      string_tmp.copy "Slot `";
      string_tmp.append name
      string_tmp.append "' not found in static type "
      typ.append_name_in string_tmp
      string_tmp.add_last '.'
      semantic_error (position,string_tmp)
    }
    //
    node := Node.new_write position slot slot receiver rec code value
    list_current.add_last node
    result := node.result_expr

    result
  )





